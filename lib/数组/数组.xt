// lib/数组.xt
// 玄铁标准库——数组高阶方法
// 纯玄铁实现，不依赖 C 运行时新函数

// 映射：对每个元素应用 变换 函数，返回由变换结果组成的新数组；不修改原数组。
//
// 参数 列表: 数组 — 输入数组，只读取不修改
// 参数 变换: 函数 — 接收一个元素并返回新元素，每个元素各调用一次
// 返回: 数组 — 新数组，长度与 列表 相同，第 i 项为 变换(列表[i])
函 映射(列表, 变换) {
    设 输出 = []
    遍历 项 于 列表 {
        输出.追加(变换(项))
    }
    返 输出
}

// 过滤：只保留 谓词 为真的元素，按原相对顺序组成新数组；不修改原数组。
//
// 参数 列表: 数组 — 输入数组，只读取不修改
// 参数 谓词: 函数 — 接收一个元素并返回真/假，返回真才保留该元素
// 返回: 数组 — 新数组，元素顺序与 列表 一致；无元素满足时为空数组
函 过滤(列表, 谓词) {
    设 输出 = []
    遍历 项 于 列表 {
        设 满足 = 谓词(项)
        若 满足 { 输出.追加(项) }
    }
    返 输出
}

// 归纳：从左到右把数组折叠成单个值，先以 初始 作为累计值，再逐个元素参与计算。
//
// 参数 列表: 数组 — 输入数组，只读取不修改
// 参数 初始: 任意 — 累计的起始值，也是空数组时的返回值
// 参数 归纳函: 函数 — 函数(累计, 元素) 返回新的累计值，调用次数等于数组长度
// 返回: 任意 — 最后一个元素处理完的累计值；列表为空时原样返回 初始
函 归纳(列表, 初始, 归纳函) {
    设 累计 = 初始
    遍历 项 于 列表 {
        累计 = 归纳函(累计, 项)
    }
    返 累计
}

// 查找：返回第一个使 谓词 为真的元素，命中即停止遍历；找不到返回 空。
//
// 参数 列表: 数组 — 输入数组，只读取不修改
// 参数 谓词: 函数 — 接收一个元素并返回真/假，首次为真即命中
// 返回: 任意 — 第一个命中的元素；无命中（含空数组）时为 空
函 查找(列表, 谓词) {
    遍历 项 于 列表 {
        若 谓词(项) { 返 项 }
    }
    返 空
}

// 每个?：判断是否所有元素都满足 谓词，遇到第一个不满足就立刻返回 假。
//
// 参数 列表: 数组 — 输入数组，只读取不修改
// 参数 谓词: 函数 — 接收一个元素并返回真/假
// 返回: 布尔 — 全部为真时返回 真；空数组也返回 真（空真）
函 每个?(列表, 谓词) {
    遍历 项 于 列表 {
        若 非 谓词(项) { 返 假 }
    }
    返 真
}

// 存在?：判断是否至少有一个元素满足 谓词，遇到第一个满足就立刻返回 真。
//
// 参数 列表: 数组 — 输入数组，只读取不修改
// 参数 谓词: 函数 — 接收一个元素并返回真/假
// 返回: 布尔 — 任一为真时返回 真；空数组返回 假
函 存在?(列表, 谓词) {
    遍历 项 于 列表 {
        若 谓词(项) { 返 真 }
    }
    返 假
}

// 排序：稳定归并排序（自底向上），按 比较函 的结果原地重排数组。
// 时间 O(n log n)（最好/平均/最坏一致），额外空间 O(n)。
// 比较函(a, b) 返回值 > 0 表示 a 应排在 b 之后（升序写 函(a, b) { 返 a - b }）；
// 返回 0 或负数表示 a 不晚于 b，两元素相等时保持原有相对顺序（稳定）。
// 注意：直接修改传入的数组并按同一对象返回，需要保留原数组请先自行复制。
//
// 参数 列表: 数组 — 待排序数组，函数内原地重排，返回后内容已改变
// 参数 比较函: 函数 — 接收两个元素并返回数值；返回值 > 0 表示第一个应排在第二个之后
// 返回: 数组 — 传入的同一个数组对象（已排好序），不是新数组
函 排序(列表, 比较函) {
    设 n = 列表.长度
    若 n < 2 { 返 列表 }
    // 缓冲数组：归并的辅助空间，长度与 列表 相同
    设 缓冲 = []
    设 填 = 0
    当 填 < n {
        缓冲.追加(列表[填])
        填 = 填 + 1
    }
    // 每趟把 源 中长度为 宽 的相邻段两两归并写入 目标，再交换两者角色
    设 源 = 列表
    设 目标 = 缓冲
    设 已交换 = 假
    设 宽 = 1
    当 宽 < n {
        设 左 = 0
        当 左 < n {
            设 中 = 左 + 宽
            若 中 > n { 中 = n }
            设 右 = 中 + 宽
            若 右 > n { 右 = n }
            设 读左 = 左
            设 读右 = 中
            设 写 = 左
            当 写 < 右 {
                // 取左段：左段未读完，且（右段已读完 或 比较函(左, 右) 未判定左应靠后）
                设 取左 = 假
                若 读左 < 中 {
                    若 读右 < 右 {
                        设 靠后 = 比较函(源[读左], 源[读右]) > 0
                        若 非 靠后 { 取左 = 真 }
                    } 否 {
                        取左 = 真
                    }
                }
                若 取左 {
                    目标[写] = 源[读左]
                    读左 = 读左 + 1
                } 否 {
                    目标[写] = 源[读右]
                    读右 = 读右 + 1
                }
                写 = 写 + 1
            }
            左 = 右
        }
        设 换 = 源
        源 = 目标
        目标 = 换
        已交换 = 非 已交换
        宽 = 宽 * 2
    }
    // 数据落在缓冲里（奇数趟）时抄回调用方的原数组，保证返回的是同一个对象
    若 已交换 {
        设 抄 = 0
        当 抄 < n {
            列表[抄] = 源[抄]
            抄 = 抄 + 1
        }
    }
    返 列表
}

// 排序依据：按 取键函 算出的数值键稳定排序，返回新数组；不修改原数组。
// 每个元素只调用一次 取键函；键相等的元素保持 列表 中的原相对顺序（稳定）。
// 时间 O(n log n)，额外空间 O(n)。
//
// 参数 列表: 数组 — 输入数组，只读取不修改
// 参数 取键函: 函数 — 接收一个元素并返回数值键（整数或小数），键值可比大小
// 返回: 数组 — 新数组，按 取键函 的结果升序排列；键相等时保持原顺序
函 排序依据(列表, 取键函) {
    设 对列表 = []
    遍历 项 于 列表 {
        对列表.追加([取键函(项), 项])
    }
    排序(对列表, 函(a, b) { 返 a[0] - b[0] })
    设 输出 = []
    遍历 对 于 对列表 {
        输出.追加(对[1])
    }
    返 输出
}

// 去重：按 == 判等去除重复元素，保留每个值第一次出现的位置；内部两两比较，O(n²)。
//
// 参数 列表: 数组 — 输入数组，只读取不修改
// 返回: 数组 — 新数组，元素相对顺序与首次出现顺序一致
函 去重(列表) {
    设 输出 = []
    遍历 项 于 列表 {
        设 已存在 = 假
        遍历 已有 于 输出 {
            若 已有 == 项 { 已存在 = 真 ; 断 }
        }
        若 非 已存在 { 输出.追加(项) }
    }
    返 输出
}

// 反转：返回元素顺序颠倒的新数组；不修改原数组。
//
// 参数 列表: 数组 — 输入数组，只读取不修改
// 返回: 数组 — 新数组，长度与 列表 相同，第 i 项为 列表[长度-1-i]
函 反转(列表) {
    设 输出 = []
    设 i = 列表.长度 - 1
    当 i >= 0 {
        输出.追加(列表[i])
        i = i - 1
    }
    返 输出
}
