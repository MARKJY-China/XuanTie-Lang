// ============================================================
// 高层封装 API（面向用户）
// ============================================================

// 创建原生窗口并初始化渲染上下文，随后把目标帧率设为 60。
// 内部启用 MSAA 4x（圆角、斜边的 GPU 级抗锯齿）与 HIGHDPI（高分屏 2x framebuffer）；全程序只应调用一次，重复调用会重建窗口。
//
// 参数 宽: 整 — 窗口宽（逻辑像素，须 > 0）
// 参数 高: 整 — 窗口高（逻辑像素，须 > 0）
// 参数 标题: 字符串 — 标题栏文字（UTF-8，可含中文）
// 返回: 无
公 函 初始化窗口(宽, 高, 标题) {
    XT_InitWindow(宽, 高, 标题)
    XT_SetTargetFPS(60)
}

// 销毁窗口与渲染上下文，程序退出前调用一次。
// 内部幂等：重复调用直接返回，不会二次释放渲染资源。
//
// 返回: 无
公 函 关闭窗口() {
    XT_CloseWindow()
}

// 主循环条件：点关闭按钮、按 ESC（未用 设ESC关闭 关闭时）或调用 请求关闭窗口 之后返回真。
//
// 返回: 布尔 — 真表示应退出主循环
公 函 窗口应关闭?() {
    返 XT_WindowShouldClose()
}

// 窗口是否已创建完成；须在 初始化窗口 之后调用。
//
// 返回: 布尔 — 真表示窗口可用
公 函 窗口就绪?() {
    返 XT_IsWindowReady()
}

// 设定主循环帧率上限，用于降低空转占用并稳定帧时间；主循环每帧仍要调用 结束绘图 才会真正按此节奏跑。
//
// 参数 fps: 整 — 每秒帧数上限，常用 30/60/120；≤0 表示不限制
// 返回: 无
公 函 设置目标帧率(fps) {
    XT_SetTargetFPS(fps)
}

// 最近一秒内的实际渲染帧数（每秒刷新一次）。
//
// 返回: 整 — 帧率
公 函 取帧率() {
    返 XT_GetFPS()
}

// 上一帧的实际耗时，用于按时间步长驱动动画（大致为 1 ÷ 帧率）。
//
// 返回: 小数 — 秒
公 函 取帧时间() {
    返 XT_GetFrameTime()
}

// 运行时修改标题栏文字，支持 Unicode 中文（Windows 走宽字符 API）。须在 初始化窗口 之后调用。
//
// 参数 标题: 字符串 — 新标题（UTF-8）
// 返回: 无
公 函 设置窗口标题(标题) {
    XT_SetWindowTitle(标题)
}

// 开启/关闭用鼠标拖拽窗口边框改变尺寸；运行时可随时切换。Windows 下同时增删最大化按钮样式。
//
// 参数 开: 布尔 — 真=允许调整大小
// 返回: 无
公 函 设窗口可调整(开) {
    若 开 { XT_SetWindowResizable(1) } 否 { XT_SetWindowResizable(0) }
}

// 去掉系统标题栏与边框（无边框模式），运行时可切换。
// 无边框后拖动与关闭都要自己做：拖动用 拖拽窗口，关闭用 请求关闭窗口。
//
// 参数 开: 布尔 — 真=无边框
// 返回: 无
公 函 设窗口无边框(开) {
    若 开 { XT_SetWindowUndecorated(1) } 否 { XT_SetWindowUndecorated(0) }
}

// 全屏/窗口化切换；目标状态与当前一致时不做动作，退出全屏回到原来的尺寸与位置。
//
// 参数 开: 布尔 — 真=全屏
// 返回: 无
公 函 设窗口全屏(开) {
    若 开 { XT_SetWindowFullscreen(1) } 否 { XT_SetWindowFullscreen(0) }
}

// 当前是否处于全屏状态。
//
// 返回: 布尔 — 真=全屏
公 函 窗口全屏?() {
    返 XT_IsWindowFullscreen()
}

// 运行时修改窗口客户区尺寸（逻辑像素）；绘制坐标系随之变化，取屏幕宽/取屏幕高 立即反映新尺寸。
//
// 参数 宽: 整 — 宽（逻辑像素，须 > 0）
// 参数 高: 整 — 高（逻辑像素，须 > 0）
// 返回: 无
公 函 设窗口尺寸(宽, 高) {
    XT_SetWindowSize(宽, 高)
}

// 设置 ESC 是否请求关窗（默认开）。全屏游戏等场景关闭它可避免误触退出；关闭后须另留退出路径。
// 实现上修改 raylib 的退出键：真=KEY_ESCAPE，假=不设退出键。
//
// 参数 开: 布尔 — 真=按 ESC 请求关窗
// 返回: 无
公 函 设ESC关闭(开) {
    若 开 { XT_SetEscExit(1) } 否 { XT_SetEscExit(0) }
}

// 开始新一帧：此后到 结束绘图 之间的绘制调用才会被提交到屏幕；每帧成对调用。
//
// 返回: 无
公 函 开始绘图() {
    XT_BeginDrawing()
}

// 提交并呈现本帧（交换前后缓冲），内部顺带泵一次输入事件；每帧调用一次。
//
// 返回: 无
公 函 结束绘图() {
    XT_EndDrawing()
}

// 只泵输入事件、不交换缓冲，用于“按需重绘”的空闲轮询周期。
// 正常渲染帧由 结束绘图 内部自动泵事件，手写主循环无需调用本函数。
//
// 返回: 无
公 函 轮询事件() {
    XT_PollInputEvents()
}

// 切换系统光标样式，取值见 鼠标默认/鼠标箭头/鼠标I形/鼠标十字/鼠标手型；桥内记忆当前值，同值重复调用不做动作。
//
// 参数 样式: 整 — 光标枚举值 0–4（0=默认、1=箭头、2=I 形、3=十字、4=手型）
// 返回: 无
公 函 设鼠标样式(样式) {
    XT_SetMouseCursor(样式)
}

// ---- 窗口控制三件套(无边框自绘标题栏用) ----
// 把窗口最小化到任务栏；用 还原窗口 恢复。
//
// 返回: 无
公 函 最小化窗口() { XT_WindowMinimize() }

// 把窗口最大化（Windows 下对齐屏幕工作区、保留任务栏，不是全屏）。
// 最大化前的窗口矩形由桥内保存，供 还原窗口 恢复；Windows 下的最大化状态由桥内跟踪。
//
// 返回: 无
公 函 最大化窗口() { XT_WindowMaximize() }

// 从最小化/最大化恢复为普通窗口；Windows 下还原到最大化前记录的矩形。
//
// 返回: 无
公 函 还原窗口() { XT_WindowRestore() }

// 当前是否处于最大化状态（自绘标题栏据此切换最大化/还原图标）。
// Windows 下该状态由 最大化窗口/还原窗口 维护，经系统标题栏最大化不会改变它。
//
// 返回: 布尔 — 真=已最大化
公 函 窗口最大化了?() { 返 XT_WindowIsMaximized() == 1 }

// 请求优雅关闭：不直接销毁上下文，而是让主循环下一轮 窗口应关闭? 返回真，由正常路径退出。
// Windows 下投递 WM_CLOSE，其它平台置“请求关闭”标志。
//
// 返回: 无
公 函 请求关闭窗口() { XT_WindowClose() }

// 无边框窗口的标题栏拖动：在自绘标题栏的鼠标按下回调里调用一次。
// Windows 下进入模态拖拽循环，松开左键才返回，手感与原生标题栏一致；其它平台为空操作。
//
// 返回: 无
公 函 拖拽窗口() { XT_WindowDrag() }

// 用 RGBA 颜色填满整帧背景，通常作为 开始绘图 之后的第一步。
// 坐标为逻辑像素；alpha 通道决定清屏色透明度，通常传 255。
//
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 清背景(r, g, b, a) {
    XT_ClearBackground(r, g, b, a)
}

// 在 (x, y) 画一个像素点。
//
// 参数 x: 整 — X 坐标（逻辑像素）
// 参数 y: 整 — Y 坐标（逻辑像素）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘像素(x, y, r, g, b, a) {
    XT_DrawPixel(x, y, r, g, b, a)
}

// 在两点之间画 1 像素宽的线段。
//
// 参数 x1: 整 — 起点 X（逻辑像素）
// 参数 y1: 整 — 起点 Y
// 参数 x2: 整 — 终点 X
// 参数 y2: 整 — 终点 Y
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘直线(x1, y1, x2, y2, r, g, b, a) {
    XT_DrawLine(x1, y1, x2, y2, r, g, b, a)
}

// 以 (x, y) 为左上角画实心矩形；宽或高 ≤0 时不可见。
//
// 参数 x: 整 — 左上角 X（逻辑像素）
// 参数 y: 整 — 左上角 Y
// 参数 宽: 整 — 宽度（像素）
// 参数 高: 整 — 高度（像素）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘矩形(x, y, 宽, 高, r, g, b, a) {
    XT_DrawRectangle(x, y, 宽, 高, r, g, b, a)
}

// 画 1 像素宽的矩形边框（线宽固定，不能指定）。
//
// 参数 x: 整 — 左上角 X（逻辑像素）
// 参数 y: 整 — 左上角 Y
// 参数 宽: 整 — 宽度（像素）
// 参数 高: 整 — 高度（像素）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘矩形线(x, y, 宽, 高, r, g, b, a) {
    XT_DrawRectangleLines(x, y, 宽, 高, r, g, b, a)
}

// 实心圆角矩形：圆角百分 0–100 映射为圆角半径占短边的比例（0=直角，100=胶囊），超界按 0/100 钳制。
//
// 参数 x: 小数 — 左上角 X（逻辑像素）
// 参数 y: 小数 — 左上角 Y
// 参数 宽: 小数 — 宽度（像素）
// 参数 高: 小数 — 高度（像素）
// 参数 圆角百分: 整 — 圆角程度 0–100
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘圆角矩形(x, y, 宽, 高, 圆角百分, r, g, b, a) {
    XT_DrawRectangleRounded(x, y, 宽, 高, 圆角百分, r, g, b, a)
}

// 圆角矩形描边；圆角语义同 绘圆角矩形，线宽单位像素。
//
// 参数 x: 小数 — 左上角 X（逻辑像素）
// 参数 y: 小数 — 左上角 Y
// 参数 宽: 小数 — 宽度（像素）
// 参数 高: 小数 — 高度（像素）
// 参数 圆角百分: 整 — 圆角程度 0–100
// 参数 线宽: 小数 — 描边宽度（像素，<1 按 1 处理）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘圆角矩形线(x, y, 宽, 高, 圆角百分, 线宽, r, g, b, a) {
    XT_DrawRectangleRoundedLines(x, y, 宽, 高, 圆角百分, 线宽, r, g, b, a)
}

// 以 (cx, cy) 为圆心画实心圆。
//
// 参数 cx: 整 — 圆心 X（逻辑像素）
// 参数 cy: 整 — 圆心 Y
// 参数 半径: 小数 — 半径（像素，> 0）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘圆(cx, cy, 半径, r, g, b, a) {
    XT_DrawCircle(cx, cy, 半径, r, g, b, a)
}

// 以 (cx, cy) 为圆心画 1 像素宽的圆周线。
//
// 参数 cx: 整 — 圆心 X（逻辑像素）
// 参数 cy: 整 — 圆心 Y
// 参数 半径: 小数 — 半径（像素，> 0）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘圆线(cx, cy, 半径, r, g, b, a) {
    XT_DrawCircleLines(cx, cy, 半径, r, g, b, a)
}

// 以 (cx, cy) 为中心画实心椭圆，横纵半径可分别指定。
//
// 参数 cx: 整 — 中心 X（逻辑像素）
// 参数 cy: 整 — 中心 Y
// 参数 水平半径: 小数 — X 方向半径（像素）
// 参数 垂直半径: 小数 — Y 方向半径（像素）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘椭圆(cx, cy, 水平半径, 垂直半径, r, g, b, a) {
    XT_DrawEllipse(cx, cy, 水平半径, 垂直半径, r, g, b, a)
}

// 按三个顶点画实心三角形；三点共线时无可见面积。
//
// 参数 x1: 小数 — 顶点 1 X（逻辑像素）
// 参数 y1: 小数 — 顶点 1 Y
// 参数 x2: 小数 — 顶点 2 X
// 参数 y2: 小数 — 顶点 2 Y
// 参数 x3: 小数 — 顶点 3 X
// 参数 y3: 小数 — 顶点 3 Y
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘三角(x1, y1, x2, y2, x3, y3, r, g, b, a) {
    XT_DrawTriangle(x1, y1, x2, y2, x3, y3, r, g, b, a)
}

// 以 (cx, cy) 为中心画正多边形（实心），边数与旋转角可指定。
//
// 参数 cx: 小数 — 中心 X（逻辑像素）
// 参数 cy: 小数 — 中心 Y
// 参数 边数: 整 — 顶点数（≥3）
// 参数 半径: 小数 — 外接圆半径（像素）
// 参数 旋转角: 小数 — 旋转角（度）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘多边形(cx, cy, 边数, 半径, 旋转角, r, g, b, a) {
    XT_DrawPoly(cx, cy, 边数, 半径, 旋转角, r, g, b, a)
}

// 绘制文字
// issue #72:开箱可读——文本含非 ASCII(如中文)且从未成功取过自动字体时,
// 首次经 加载系统字体 通路懒加载系统 CJK 字体并缓存(幂等);
// 纯 ASCII 仍走 raylib 默认字体(零视觉变化);系统字体取不到时回退原行为(不崩)。
设 _自动字体句柄 = 0
设 _自动字体试过 = 假

函 _自动字体(字号) {
    若 _自动字体试过 { 返 _自动字体句柄 }
    _自动字体试过 = 真
    _自动字体句柄 = XT_FontGDI_Create("", 字号)
    返 _自动字体句柄
}

函 _含非ASCII(文本) {
    设 i = 0
    当 i < 文本.字节数 {
        若 文本.字节(i) >= 128 { 返 真 }
        i = i + 1
    }
    返 假
}

// 绘制一行 UTF-8 文字，坐标为文本左上角。
// 首次遇到非 ASCII 文本时自动懒加载系统 CJK 字体并缓存句柄（失败只尝试一次）；纯 ASCII 走 raylib 默认字体。系统字体取不到时回退默认字体，非 ASCII 字符可能显示为占位符。
//
// 参数 文本: 字符串 — 要绘制的内容（UTF-8，单行）
// 参数 x: 整 — 左上角 X（逻辑像素）
// 参数 y: 整 — 左上角 Y（逻辑像素）
// 参数 字号: 整 — 像素高度，须 > 0
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘文字(文本, x, y, 字号, r, g, b, a) {
    若 _含非ASCII(文本) {
        设 _句 = _自动字体(字号)
        若 _句 != 0 {
            绘字体文字(_句, 文本, x, y, 字号, 0, r, g, b, a)
            返 空
        }
    }
    XT_DrawText(文本, x, y, 字号, r, g, b, a)
}

// 测量 绘文字 渲染该文本的像素宽度；非 ASCII 文本走同一自动字体，量得宽度与实际绘制一致。
//
// 参数 文本: 字符串 — 要测量的内容（UTF-8）
// 参数 字号: 整 — 像素高度，须 > 0
// 返回: 整 — 文本宽度（逻辑像素）
公 函 量文字(文本, 字号) {
    若 _含非ASCII(文本) {
        设 _句 = _自动字体(字号)
        若 _句 != 0 { 返 量字体文字(_句, 文本, 字号, 0) }
    }
    返 XT_MeasureText(文本, 字号)
}

// 在 (x, y) 用 raylib 默认字体绘制当前帧率数字（形如 60 FPS）。
//
// 参数 x: 整 — 左上角 X（逻辑像素）
// 参数 y: 整 — 左上角 Y（逻辑像素）
// 返回: 无
公 函 绘帧率(x, y) {
    XT_DrawFPS(x, y)
}

// 从 ttf/otf/ttc 文件加载字体（ttc 取第 1 个 face，CFF 变体无法解码时加载失败）。
// 烘焙码点含 ASCII、CJK 统一汉字基本区与常用中西文标点；字体池上限 8 个，句柄为 1 起整数。
//
// 参数 文件: 字符串 — 字体文件路径（UTF-8，支持中文路径）
// 参数 字号: 整 — 基准字号（像素，须 > 0）
// 返回: 整 — 字体句柄（1–8），0=失败
公 函 加载字体(文件, 字号) {
    返 XT_LoadFont(文件, 字号)
}

// 按系统字体名取字体，不必自带字体文件；所得句柄同样适用于 绘字体文字/量字体文字/释字体。
// Windows 走 GDI 系统光栅化（句柄为 100+）；macOS/Linux 把字体名映射到系统字体文件后经 raylib 载入。名字未命中时回退系统 CJK 默认字体，全部取不到才返回 0。
//
// 参数 字体名: 字符串 — 系统字体名或字体文件路径，如“微软雅黑”“宋体”“Consolas”“苹方”
// 参数 字号: 整 — 基准字号（像素，须 > 0）
// 返回: 整 — 字体句柄（Windows 为 100+，其它平台为 1–8），0=失败
公 函 加载系统字体(字体名, 字号) {
    返 XT_FontGDI_Create(字体名, 字号)
}

// 把当前帧缓冲导出为 PNG 文件。
// 必须在 开始绘图 与 结束绘图 之间调用：结束绘图 会交换前后缓冲，之后再读只能拿到空帧。
//
// 参数 路径: 字符串 — 输出 PNG 路径（相对路径按工作目录解析，绝对路径原样使用）
// 返回: 无
公 函 截图(路径) {
    XT_SaveScreenshot(路径)
}

// 设置裁剪矩形：此后绘制只在该区域内生效，直到 裁剪结束。
// 须成对使用，且不要跨帧遗留裁剪状态（否则整帧被裁）。
//
// 参数 x: 整 — 裁剪区左上角 X（逻辑像素）
// 参数 y: 整 — 裁剪区左上角 Y
// 参数 宽: 整 — 裁剪区宽度（像素）
// 参数 高: 整 — 裁剪区高度（像素）
// 返回: 无
公 函 裁剪开始(x, y, 宽, 高) {
    XT_BeginScissor(x, y, 宽, 高)
}
// 解除最近一次 裁剪开始 设置的裁剪区域；与 裁剪开始 成对使用。
//
// 返回: 无
公 函 裁剪结束() {
    XT_EndScissor()
}

// 把 Unicode 码点转成单字符字符串，配合 获字符 组装文本输入（中文 IME 上屏字符同样适用）。
//
// 参数 码点: 整 — Unicode 码点（如 0x4E2D 为“中”）
// 返回: 字符串 — 单字符 UTF-8 串；负数或大于 0x10FFFF 时返回 U+FFFD 替换字符
公 函 字自码点(码点) {
    返 xt_string_from_codepoint(码点)
}

// 读取系统剪贴板中的文本（输入框 Ctrl+V 用）。
//
// 返回: 字符串 — 剪贴板文本；无文本内容时为空串
公 函 取剪贴板() {
    返 XT_GetClipboard()
}
// 把文本写入系统剪贴板（输入框 Ctrl+C 用）。
//
// 参数 文本: 字符串 — 要写入的内容（UTF-8）
// 返回: 无
公 函 设剪贴板(文本) {
    XT_SetClipboard(文本)
}

// 设置 IME 候选窗定位点，让候选窗跟随输入光标而不是停在屏幕左上。
// Windows 下经 ImmSetCompositionWindow 生效，其它平台为空操作；候选窗实际落在定位点下方约 26px（IME 为内联组合预留的行高），需要精确对齐时由调用方补偿。
//
// 参数 x: 整 — 定位点 X（像素）
// 参数 y: 整 — 定位点 Y（像素）
// 返回: 无
公 函 设输入法位置(x, y) {
    XT_SetIMEPos(x, y)
}

// 安装 IME 内联组合钩子：拦 WM_IME_COMPOSITION 记录组合中的拼音串，使拼音可直接显示在输入框内。
// 窗口初始化后调用一次即可（幂等，重复调用返回已安装）；结果字符上屏路径不变（仍走 获字符）。
//
// 返回: 整 — 1=安装成功或已安装，0=失败（非 Windows 或窗口未就绪）
公 函 安装输入法钩子() {
    返 XT_IME_Hook()
}
// 取当前输入法组合中的拼音串，供输入框自绘内联组合。
//
// 返回: 字符串 — 组合串（UTF-8）；无组合或非 Windows 时为空串
公 函 取组合串() {
    返 XT_IME_GetComp()
}

// 启用/禁用窗口的 IME 上下文：禁用后组合与候选窗整体不再产生（无输入框焦点时的正确行为），禁用瞬间进行中的组合被丢弃。
// UI 库按焦点每帧自动调用，手写主循环一般无需调用。
//
// 参数 开: 布尔 — 真=允许输入法组合
// 返回: 无
公 函 设输入法启用(开) {
    若 开 { XT_IME_Enable(1) } 否 { XT_IME_Enable(0) }
}

// 加载字体时只烘焙参考文本用到的字符（另加 ASCII），纹理更小、覆盖范围可预期。
// 适合界面文案固定的场景；字号或文案变化后需重新加载。
//
// 参数 文件: 字符串 — 字体文件路径（UTF-8）
// 参数 字号: 整 — 基准字号（像素，须 > 0）
// 参数 参考文本: 字符串 — 需要覆盖的字符集合；其中的每个字符都会被烘焙
// 返回: 整 — 字体句柄（1–8），0=失败
公 函 加载字体精准(文件, 字号, 参考文本) {
    返 XT_LoadFontEx(文件, 字号, 参考文本)
}

// 释放字体占用的字形纹理与句柄（按句柄区间自动分派文件字体与 Windows GDI 字体）。
// 传入 0 或无效句柄为空操作；raylib 默认字体不会被卸载。
//
// 参数 字体句柄: 整 — 1–8（文件字体）或 100+（Windows GDI 字体）
// 返回: 无
公 函 释字体(字体句柄) {
    XT_UnloadFont(字体句柄)
}

// 用指定字体绘制一行 UTF-8 文字（支持中文），可额外指定字距。
// 须在 开始绘图/结束绘图 之间调用，且字体句柄有效（0 时不做任何绘制）。
//
// 参数 字体句柄: 整 — 加载字体/加载系统字体 的返回值
// 参数 文本: 字符串 — 要绘制的内容（UTF-8，单行）
// 参数 x: 整 — 左上角 X（逻辑像素）
// 参数 y: 整 — 左上角 Y（逻辑像素）
// 参数 字号: 整 — 像素高度，须 > 0
// 参数 间距: 整 — 相邻字符的额外间距（像素，0=字体默认）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘字体文字(字体句柄, 文本, x, y, 字号, 间距, r, g, b, a) {
    XT_DrawTextEx(字体句柄, 文本, x, y, 字号, 间距, r, g, b, a)
}

// 测量指定字体渲染该文本的像素宽度，用于控件尺寸与居中排版。
//
// 参数 字体句柄: 整 — 加载字体/加载系统字体 的返回值
// 参数 文本: 字符串 — 要测量的内容（UTF-8）
// 参数 字号: 整 — 像素高度，须 > 0
// 参数 间距: 整 — 相邻字符的额外间距（像素，0=字体默认）
// 返回: 整 — 文本宽度（像素，四舍五入）；句柄无效返回 0
公 函 量字体文字(字体句柄, 文本, 字号, 间距) {
    返 XT_MeasureTextEx(字体句柄, 文本, 字号, 间距)
}

// 从图片文件加载 GPU 纹理，解码格式由扩展名决定（png/jpg 等，支持中文路径）。
// 2x 高分屏会自动优先尝试“文件名@2x.扩展名”变体，缺失则回退原图。纹理池上限 32，句柄为 1 起整数。
//
// 参数 文件: 字符串 — 图片路径（UTF-8）
// 返回: 整 — 纹理句柄（1–32），0=失败（文件缺失、解码失败或池满）
公 函 加载纹理(文件) {
    返 XT_LoadTexture(文件)
}

// 释放纹理占用的 GPU 资源；无效句柄为空操作。
//
// 参数 纹理句柄: 整 — 加载纹理/加载SVG纹理/生成渐变纹理 的返回值
// 返回: 无
公 函 释纹理(纹理句柄) {
    XT_UnloadTexture(纹理句柄)
}

// 按原始尺寸在 (x, y) 绘制纹理，可乘颜色调制。
//
// 参数 纹理句柄: 整 — 有效纹理句柄（0 时不绘制）
// 参数 x: 整 — 左上角 X（逻辑像素）
// 参数 y: 整 — 左上角 Y（逻辑像素）
// 参数 tr: 整 — 颜色调制 R 通道 0–255（255=保留原色）
// 参数 tg: 整 — 颜色调制 G 通道 0–255
// 参数 tb: 整 — 颜色调制 B 通道 0–255
// 参数 ta: 整 — 整体透明度 0–255（255=不透明）
// 返回: 无
公 函 绘纹理(纹理句柄, x, y, tr, tg, tb, ta) {
    XT_DrawTexture(纹理句柄, x, y, tr, tg, tb, ta)
}

// 以纹理左上角为锚点绘制，支持旋转与整体缩放（旋转围绕该锚点）。
// 需要把纹理拉伸到任意矩形时用 绘纹理区。
//
// 参数 纹理句柄: 整 — 有效纹理句柄（0 时不绘制）
// 参数 x: 小数 — 锚点 X（逻辑像素）
// 参数 y: 小数 — 锚点 Y（逻辑像素）
// 参数 旋转角: 小数 — 旋转角（度）
// 参数 缩放: 小数 — 缩放倍率（1=原尺寸，2=两倍）
// 参数 tr: 整 — 颜色调制 R 通道 0–255（255=保留原色）
// 参数 tg: 整 — 颜色调制 G 通道 0–255
// 参数 tb: 整 — 颜色调制 B 通道 0–255
// 参数 ta: 整 — 整体透明度 0–255（255=不透明）
// 返回: 无
公 函 绘纹理Ex(纹理句柄, x, y, 旋转角, 缩放, tr, tg, tb, ta) {
    XT_DrawTextureEx(纹理句柄, x, y, 旋转角, 缩放, tr, tg, tb, ta)
}

// 查询纹理的像素宽度（图标布局与等比缩放用）。
//
// 参数 纹理句柄: 整 — 有效纹理句柄
// 返回: 整 — 宽度（像素）；无效句柄返回 0
公 函 量纹理宽(纹理句柄) {
    返 XT_TextureW(纹理句柄)
}
// 查询纹理的像素高度（图标布局与等比缩放用）。
//
// 参数 纹理句柄: 整 — 有效纹理句柄
// 返回: 整 — 高度（像素）；无效句柄返回 0
公 函 量纹理高(纹理句柄) {
    返 XT_TextureH(纹理句柄)
}

// 把整张纹理缩放到指定 宽×高 矩形内绘制（图标适配等非整数倍缩放场景）。
//
// 参数 纹理句柄: 整 — 有效纹理句柄（0 时不绘制）
// 参数 x: 整 — 目标矩形左上角 X（逻辑像素）
// 参数 y: 整 — 目标矩形左上角 Y
// 参数 宽: 整 — 目标宽度（像素）
// 参数 高: 整 — 目标高度（像素）
// 参数 tr: 整 — 颜色调制 R 通道 0–255（255=保留原色）
// 参数 tg: 整 — 颜色调制 G 通道 0–255
// 参数 tb: 整 — 颜色调制 B 通道 0–255
// 参数 ta: 整 — 整体透明度 0–255（255=不透明）
// 返回: 无
公 函 绘纹理区(纹理句柄, x, y, 宽, 高, tr, tg, tb, ta) {
    XT_DrawTextureQuad(纹理句柄, x, y, 宽, 高, tr, tg, tb, ta)
}

// 加载 SVG 并光栅化为纹理；宽/高 ≤0 时取 SVG 固有尺寸，否则等比缩放适配进 宽×高。
// 与 加载纹理 一致：文件缺失、SVG 解析失败、光栅化失败、纹理池满，一律返回 0；成功返回 1–32 的句柄。
//
// 参数 文件: 字符串 — SVG 文件路径（UTF-8）
// 参数 宽: 整 — 目标宽（像素，≤0=取 SVG 固有宽）
// 参数 高: 整 — 目标高（像素，≤0=取 SVG 固有高）
// 返回: 整 — 纹理句柄（1–32）；0=失败（池满 / 文件缺失 / 解析或光栅化失败）
公 函 加载SVG纹理(文件, 宽, 高) {
    返 XT_LoadTextureSVG(文件, 宽, 高)
}

// 生成双色线性渐变 + 圆角 + 边缘羽化的纹理；色 1 与色 2 相同时即圆角羽化纯色块。
// 桥内带 8 槽参数缓存，同参数重复调用直接复用、不重复生成；纹理池满时淘汰最旧的缓存项。生成结果用 释纹理 释放会与缓存冲突，通常不必手动释放。
//
// 参数 宽: 整 — 纹理宽（像素，须 > 0）
// 参数 高: 整 — 纹理高（像素，须 > 0）
// 参数 r1: 整 — 渐变起点红色分量 0–255
// 参数 g1: 整 — 渐变起点绿色分量 0–255
// 参数 b1: 整 — 渐变起点蓝色分量 0–255
// 参数 a1: 整 — 渐变起点不透明度 0–255
// 参数 r2: 整 — 渐变终点红色分量 0–255
// 参数 g2: 整 — 渐变终点绿色分量 0–255
// 参数 b2: 整 — 渐变终点蓝色分量 0–255
// 参数 a2: 整 — 渐变终点不透明度 0–255
// 参数 方向: 整 — 渐变方向：0=横向（左→右）、1=竖向（上→下）
// 参数 圆角: 整 — 圆角半径（像素，0=直角；负值按 0）
// 参数 羽化: 整 — 边缘过渡宽度（像素，<1 按 1；1=仅抗锯齿）
// 返回: 整 — 纹理句柄（1–32），0=失败（尺寸非法、池满或内存不足）
公 函 生成渐变纹理(宽, 高, r1, g1, b1, a1, r2, g2, b2, a2, 方向, 圆角, 羽化) {
    返 XT_GenGradientTexture(宽, 高, r1, g1, b1, a1, r2, g2, b2, a2, 方向, 圆角, 羽化)
}

// ---- 千分定点绘制(坐标 ×1000 定点整数,桥内转 float 亚像素渲染;微交互/动画用)----
// 千分定点版实心矩形：坐标与尺寸以 ×1000 的整数传入（如 12.5 逻辑像素传 12500），桥内除以 1000 转浮点，得到亚像素级平滑边缘。
//
// 参数 x千: 整 — 左上角 X ×1000（逻辑像素）
// 参数 y千: 整 — 左上角 Y ×1000
// 参数 宽千: 整 — 宽度 ×1000（像素）
// 参数 高千: 整 — 高度 ×1000（像素）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘矩形精(x千, y千, 宽千, 高千, r, g, b, a) {
    XT_DrawRectFP(x千, y千, 宽千, 高千, r, g, b, a)
}
// 千分定点版矩形描边：坐标为 ×1000 整数，线宽按像素单独给出（不乘 1000）。
//
// 参数 x千: 整 — 左上角 X ×1000（逻辑像素）
// 参数 y千: 整 — 左上角 Y ×1000
// 参数 宽千: 整 — 宽度 ×1000（像素）
// 参数 高千: 整 — 高度 ×1000（像素）
// 参数 线宽: 小数 — 描边宽度（像素，<1 按 1 处理）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘矩形线精(x千, y千, 宽千, 高千, 线宽, r, g, b, a) {
    XT_DrawRectLinesFP(x千, y千, 宽千, 高千, 线宽, r, g, b, a)
}
// 千分定点版实心圆角矩形；圆角百分语义同 绘圆角矩形（0–100，超界钳制）。
//
// 参数 x千: 整 — 左上角 X ×1000（逻辑像素）
// 参数 y千: 整 — 左上角 Y ×1000
// 参数 宽千: 整 — 宽度 ×1000（像素）
// 参数 高千: 整 — 高度 ×1000（像素）
// 参数 圆角百分: 整 — 圆角程度 0–100
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘圆角矩形精(x千, y千, 宽千, 高千, 圆角百分, r, g, b, a) {
    XT_DrawRoundedRectFP(x千, y千, 宽千, 高千, 圆角百分, r, g, b, a)
}
// 千分定点版圆角矩形描边；圆角百分 0–100，线宽按像素单独给出。
//
// 参数 x千: 整 — 左上角 X ×1000（逻辑像素）
// 参数 y千: 整 — 左上角 Y ×1000
// 参数 宽千: 整 — 宽度 ×1000（像素）
// 参数 高千: 整 — 高度 ×1000（像素）
// 参数 圆角百分: 整 — 圆角程度 0–100
// 参数 线宽: 小数 — 描边宽度（像素，<1 按 1 处理）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘圆角矩形线精(x千, y千, 宽千, 高千, 圆角百分, 线宽, r, g, b, a) {
    XT_DrawRoundedRectLinesFP(x千, y千, 宽千, 高千, 圆角百分, 线宽, r, g, b, a)
}
// 千分定点版 绘纹理区：位置与尺寸均为 ×1000 整数，用于图标平滑缩放与移动动画。
//
// 参数 纹理句柄: 整 — 有效纹理句柄（0 时不绘制）
// 参数 x千: 整 — 目标矩形左上角 X ×1000（逻辑像素）
// 参数 y千: 整 — 目标矩形左上角 Y ×1000
// 参数 宽千: 整 — 目标宽度 ×1000（像素）
// 参数 高千: 整 — 目标高度 ×1000（像素）
// 参数 tr: 整 — 颜色调制 R 通道 0–255（255=保留原色）
// 参数 tg: 整 — 颜色调制 G 通道 0–255
// 参数 tb: 整 — 颜色调制 B 通道 0–255
// 参数 ta: 整 — 整体透明度 0–255（255=不透明）
// 返回: 无
公 函 绘纹理区精(纹理句柄, x千, y千, 宽千, 高千, tr, tg, tb, ta) {
    XT_DrawTextureQuadFP(纹理句柄, x千, y千, 宽千, 高千, tr, tg, tb, ta)
}
// 千分定点版 绘字体文字：位置为 ×1000 整数坐标，另可整体缩放（缩放千）。
// Windows GDI 字体走字形图集 GPU 缩放（不重新光栅化）；其它字体按 字号 × 缩放 渲染。
//
// 参数 字体句柄: 整 — 加载字体/加载系统字体 的返回值
// 参数 文本: 字符串 — 要绘制的内容（UTF-8，单行）
// 参数 x千: 整 — 左上角 X ×1000（逻辑像素）
// 参数 y千: 整 — 左上角 Y ×1000
// 参数 缩放千: 整 — 整体缩放 ×1000（1000=原倍）
// 参数 字号: 整 — 基准像素高度，须 > 0
// 参数 间距: 整 — 相邻字符的额外间距（像素，0=字体默认）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘字体文字精(字体句柄, 文本, x千, y千, 缩放千, 字号, 间距, r, g, b, a) {
    XT_DrawTextExFP(字体句柄, 文本, x千, y千, 缩放千, 字号, 间距, r, g, b, a)
}

// 查询某个键当前是否处于按下状态（每帧查询，按住期间恒真）。
//
// 参数 键码: 整 — raylib 键码，见 键A/键空格/键ESC/键左Shift 等常量
// 返回: 布尔 — 真=按住
公 函 键按下?(键码) {
    返 XT_IsKeyDown(键码)
}

// 查询某个键是否在本帧刚被按下（单次触发，按住不会反复为真）。
//
// 参数 键码: 整 — raylib 键码
// 返回: 布尔 — 真=本帧新按下
公 函 键刚按下?(键码) {
    返 XT_IsKeyPressed(键码)
}

// 取本帧新按下的键码（队列式，每帧可多次调用逐个取出）。
//
// 返回: 整 — 键码；0=本帧已无新按键
公 函 取按键() {
    返 XT_GetKeyPressed()
}

// 取本帧输入的 Unicode 码点（文本输入框地基，中文 IME 上屏字符也能收到，但不带候选框跟随）。
// 返回 0 表示队列已空，调用方每帧循环取到 0 为止；码点转字符串用 字自码点。
//
// 返回: 整 — Unicode 码点；0=队列空
公 函 获字符() {
    返 XT_GetCharPressed()
}

// 查询某个鼠标按钮当前是否处于按下状态。
//
// 参数 按钮: 整 — 按钮码：0=左、1=右、2=中（见 鼠左键/鼠右键/鼠中键）
// 返回: 布尔 — 真=按住
公 函 鼠标按下?(按钮) {
    返 XT_IsMouseButtonDown(按钮)
}

// 查询某个鼠标按钮是否在本帧刚被按下（单次触发）。
//
// 参数 按钮: 整 — 按钮码：0=左、1=右、2=中
// 返回: 布尔 — 真=本帧新按下
公 函 鼠标刚按下?(按钮) {
    返 XT_IsMouseButtonPressed(按钮)
}

// 鼠标指针的 X 坐标，与绘制坐标同为逻辑像素。
//
// 返回: 整 — X 坐标（逻辑像素）
公 函 鼠X() {
    返 XT_GetMouseX()
}

// 鼠标指针的 Y 坐标，与绘制坐标同为逻辑像素。
//
// 返回: 整 — Y 坐标（逻辑像素）
公 函 鼠Y() {
    返 XT_GetMouseY()
}

// 取本帧滚轮增量：正=向上滚，负=向下滚，0=未滚动。
//
// 返回: 整 — 滚动档数（整型，小数增量被截断）
公 函 取鼠标滚轮() {
    返 XT_GetMouseWheelMove()
}

// 取 [min, max] 闭区间内的随机整数，两端都可能取到。
//
// 参数 min: 整 — 下限（含）
// 参数 max: 整 — 上限（含）
// 返回: 整 — 随机整数
公 函 取随机数(min, max) {
    返 XT_GetRandomValue(min, max)
}

// 程序启动至今的秒数，单调递增，可用于计时与动画相位。
//
// 返回: 小数 — 秒
公 函 取运行时间() {
    返 XT_GetTime()
}

// 休眠指定秒数（系统级休眠，不占 CPU；≤0 立即返回）。
// 休眠期间不泵窗口事件，长时间暂停会表现为窗口无响应；需要持续刷新时改用主循环计时。
//
// 参数 秒数: 小数 — 秒（可为小数）
// 返回: 无
公 函 暂停(秒数) {
    XT_WaitTime(秒数)
}

// 逻辑画布宽度，即绘制坐标空间；HIGHDPI 下数值不变（如 800），物理像素请看 取渲染宽。
//
// 返回: 整 — 宽（逻辑像素）
公 函 取屏幕宽() {
    返 XT_GetScreenWidth()
}

// 逻辑画布高度，即绘制坐标空间；物理像素请看 取渲染高。
//
// 返回: 整 — 高（逻辑像素）
公 函 取屏幕高() {
    返 XT_GetScreenHeight()
}

// framebuffer 的物理像素宽度（HIGHDPI 2x 屏为逻辑宽 × 缩放比）。
//
// 返回: 整 — 宽（物理像素）
公 函 取渲染宽() {
    返 XT_GetRenderWidth()
}

// framebuffer 的物理像素高度（HIGHDPI 2x 屏为逻辑高 × 缩放比）。
//
// 返回: 整 — 高（物理像素）
公 函 取渲染高() {
    返 XT_GetRenderHeight()
}

// 物理像素与逻辑单位之比：2x 屏为 2.0，100% 屏为 1.0。窗口未就绪时返回 1.0。
//
// 返回: 小数 — 缩放比
公 函 取缩放系数() {
    返 XT_GetWindowScale()
}

// 逻辑单位 → 物理像素（逻辑值 × 缩放系数，换算在桥内完成）。
//
// 参数 逻辑值: 小数 — 逻辑坐标或尺寸
// 返回: 小数 — 对应的物理像素值
公 函 转像素(逻辑值) {
    返 XT_ScaleToPixel(逻辑值)
}

// 物理像素 → 逻辑单位（像素值 ÷ 缩放系数）；截图工具量出的像素坐标用它反算回绘制坐标。
//
// 参数 像素值: 小数 — 物理像素坐标或尺寸
// 返回: 小数 — 对应的逻辑值
公 函 转逻辑(像素值) {
    返 XT_ScaleToLogical(像素值)
}

// ============================================================
// 音频
// ============================================================

// 初始化音频设备；在任何音频 API（加载音效、合成音效、加载音乐流 等）之前调用一次。
//
// 返回: 无
公 函 初始化音频() {
    XT_InitAudioDevice()
}

// 关闭音频设备并停止全部播放；程序退出前调用。
//
// 返回: 无
公 函 关闭音频() {
    XT_CloseAudioDevice()
}

// 把整段音频解码进内存（wav/ogg/mp3 等，通常用于数秒内的短音效）；音效池上限 32，句柄为 1 起整数。
//
// 参数 文件: 字符串 — 音频文件路径（UTF-8）
// 返回: 整 — 音效句柄（1–32），0=失败（文件缺失、解码失败或池满）
公 函 加载音效(文件) {
    返 XT_LoadSound(文件)
}

// 触发一次音效播放（可叠加触发、不阻塞主循环）；句柄无效时不做动作。
//
// 参数 音效句柄: 整 — 加载音效/合成音效 的返回值
// 返回: 无
公 函 播音效(音效句柄) {
    XT_PlaySound(音效句柄)
}

// 释放音效占用的内存（合成音效的 PCM 缓冲一并释放）；无效句柄为空操作。
//
// 参数 音效句柄: 整 — 加载音效/合成音效 的返回值
// 返回: 无
公 函 释音效(音效句柄) {
    XT_UnloadSound(音效句柄)
}

// 零资产合成正弦波音效：桥内生成 PCM，不需要 wav 文件；10ms 淡入淡出避免首尾咔哒。
// 非法入参自动钳制：频率 ≤0 → 440Hz，时长 ≤0 → 120ms，>10000ms 截到 10 秒。
//
// 参数 频率: 整 — 音高（赫兹）
// 参数 毫秒: 整 — 时长（毫秒）
// 返回: 整 — 音效句柄（播放/释放同 播音效/释音效），0=失败
公 函 合成音效(频率, 毫秒) {
    返 XT_SynthSound(频率, 毫秒)
}

// 波形名 → 波形码(0=正弦 1=三角 2=锯齿 3=方波 4=白噪)
函 波形码(名) {
    设 码 = 0
    若 名 == "三角" { 码 = 1 }
    抑 名 == "锯齿" { 码 = 2 }
    抑 名 == "方波" { 码 = 3 }
    抑 名 == "白噪" { 码 = 4 }
    返 码
}

// 音调名 → 赫兹(十二平均律,A4=440Hz)。支持 C/C#/D/D#/E/F/F#/G/G#/A/A#/B 与 b 降号,
// 如 "C5"=523.25、"C#5"=554.37、"Db5" 同 C#5;未知音名回退 440Hz。
函 音调转赫兹(音调) {
    设 首 = 音调.截取(0, 1)
    设 半音 = 0
    // 注:玄铁 匹配 语句不支持字符串模式,音调名用 若/抑 链判定
    若 首 == "C" { 半音 = 0 }
    抑 首 == "D" { 半音 = 2 }
    抑 首 == "E" { 半音 = 4 }
    抑 首 == "F" { 半音 = 5 }
    抑 首 == "G" { 半音 = 7 }
    抑 首 == "A" { 半音 = 9 }
    抑 首 == "B" { 半音 = 11 }
    否 { 返 440 }
    设 长度 = 音调.字节数
    设 偏移 = 1
    设 变音 = 0
    若 长度 > 1 {
        设 次 = 音调.截取(1, 2)
        若 次 == "#" {
            变音 = 1
            偏移 = 2
        }
        若 次 == "b" {
            变音 = -1
            偏移 = 2
        }
    }
    设 八度 = 4
    若 长度 > 偏移 {
        设 八度转 = 整(音调.截取(偏移, 长度))
        若 八度转.成功 { 八度 = 八度转.值 }
    }
    设 序号 = (八度 + 1) * 12 + 半音 + 变音
    返 440 * 数学.幂(2, (序号 - 69.0) / 12)
}

// 零资产多振荡器合成器：波形叠加 + 音量包络 + EQ + 延迟 + 混响，另可走“扫频”带通分支。
// 选项表必填，传 {} 即默认单振荡器（等价 合成音效）。选项键：
//
// - 音调：音调名如 "C5"/"C#5"/"Db5"（十二平均律），给定时覆盖 频率（频率可传 0 占位）
// - 波形："正弦"/"三角"/"锯齿"/"方波"/"白噪"（默认 "正弦"）——单振荡器快捷写法
// - 音量：0–1（默认 0.35）——单振荡器快捷写法
// - 振荡器：列表，每项 { "波形", "音量", "频率比" }，最多 4 个；频率比 1=同频、2=高八度、0.5=低八度；音量省略时自动均分
// - 包络：{ "起音", "衰减", "延持电平", "释音" }（毫秒 / 0–1，默认 10ms 淡入淡出）
// - EQ：{ "低音", "中音", "高音" }（分贝，默认 0=直通）
// - 延迟：{ "时间", "反馈", "混合" }（毫秒 / 0–1 / 0–1，默认关）
// - 混响：{ "房间大小", "湿干比" }（0–1 / 0–1，默认关）
// - 扫频：{ "起始频率", "终止频率", "共振", "方向" }（方向取 "升"/"降"/"往复"/"随机"）——走带通扫频分支，其余合成参数不参与
//
// 包络、EQ、延迟、混响作用于多振荡器混合后的整体；返回句柄的播放与释放同 播音效/释音效。
//
// 参数 频率: 整 — 音高（赫兹；给 音调 时可传 0）
// 参数 毫秒: 整 — 时长（毫秒）
// 参数 选项: 字典 — 合成参数表（见上；必填，传 {} 用默认）
// 返回: 整 — 音效句柄，0=失败
公 函 合成器(频率, 毫秒, 选项) {
    设 实际频率 = 频率
    设 振荡器数 = 1
    设 槽1波形 = 0
    设 槽1音量 = 0
    设 槽1频率比 = 1
    设 槽2波形 = 0
    设 槽2音量 = 0
    设 槽2频率比 = 1
    设 槽3波形 = 0
    设 槽3音量 = 0
    设 槽3频率比 = 1
    设 槽4波形 = 0
    设 槽4音量 = 0
    设 槽4频率比 = 1
    设 起音 = 0
    设 衰减 = 0
    设 延持电平 = 1
    设 释音 = 0
    设 低音 = 0
    设 中音 = 0
    设 高音 = 0
    设 延迟时间 = 0
    设 延迟反馈 = 0
    设 延迟混合 = 0
    设 房间大小 = 0
    设 湿干比 = 0
    若 选项 != 空 {
        若 选项.含?("音调") { 实际频率 = 音调转赫兹(选项["音调"]) }
        若 选项.含?("波形") { 槽1波形 = 波形码(选项["波形"]) }
        若 选项.含?("音量") { 槽1音量 = 选项["音量"] }
        若 选项.含?("振荡器") {
            设 列 = 选项["振荡器"]
            若 列 != 空 {
                设 槽 = 0
                遍历 项 于 列 {
                    槽 = 槽 + 1
                    设 个波形 = 0
                    设 个音量 = 0
                    设 个频率比 = 1
                    若 项 != 空 {
                        若 项.含?("波形") { 个波形 = 波形码(项["波形"]) }
                        若 项.含?("音量") { 个音量 = 项["音量"] }
                        若 项.含?("频率比") { 个频率比 = 项["频率比"] }
                    }
                    若 槽 == 1 {
                        槽1波形 = 个波形
                        槽1音量 = 个音量
                        槽1频率比 = 个频率比
                    } 抑 槽 == 2 {
                        槽2波形 = 个波形
                        槽2音量 = 个音量
                        槽2频率比 = 个频率比
                    } 抑 槽 == 3 {
                        槽3波形 = 个波形
                        槽3音量 = 个音量
                        槽3频率比 = 个频率比
                    } 否 {
                        槽4波形 = 个波形
                        槽4音量 = 个音量
                        槽4频率比 = 个频率比
                    }
                }
                振荡器数 = 槽
            }
        }
        若 选项.含?("包络") {
            设 包 = 选项["包络"]
            若 包 != 空 {
                若 包.含?("起音") { 起音 = 包["起音"] }
                若 包.含?("衰减") { 衰减 = 包["衰减"] }
                若 包.含?("延持电平") { 延持电平 = 包["延持电平"] }
                若 包.含?("释音") { 释音 = 包["释音"] }
            }
        }
        若 选项.含?("EQ") {
            设 均衡 = 选项["EQ"]
            若 均衡 != 空 {
                若 均衡.含?("低音") { 低音 = 均衡["低音"] }
                若 均衡.含?("中音") { 中音 = 均衡["中音"] }
                若 均衡.含?("高音") { 高音 = 均衡["高音"] }
            }
        }
        若 选项.含?("延迟") {
            设 延 = 选项["延迟"]
            若 延 != 空 {
                若 延.含?("时间") { 延迟时间 = 延["时间"] }
                若 延.含?("反馈") { 延迟反馈 = 延["反馈"] }
                若 延.含?("混合") { 延迟混合 = 延["混合"] }
            }
        }
        若 选项.含?("混响") {
            设 混 = 选项["混响"]
            若 混 != 空 {
                若 混.含?("房间大小") { 房间大小 = 混["房间大小"] }
                若 混.含?("湿干比") { 湿干比 = 混["湿干比"] }
            }
        }
        若 选项.含?("扫频") {
            设 扫 = 选项["扫频"]
            若 扫 != 空 {
                设 扫起始 = 250
                设 扫终止 = 2500
                设 扫共振 = 0.8
                设 扫方向 = 2
                若 扫.含?("起始频率") { 扫起始 = 扫["起始频率"] }
                若 扫.含?("终止频率") { 扫终止 = 扫["终止频率"] }
                若 扫.含?("共振") { 扫共振 = 扫["共振"] }
                若 扫.含?("方向") {
                    若 扫["方向"] == "升" { 扫方向 = 0 }
                    抑 扫["方向"] == "降" { 扫方向 = 1 }
                    抑 扫["方向"] == "往复" { 扫方向 = 2 }
                    抑 扫["方向"] == "随机" { 扫方向 = 3 }
                }
                返 XT_SynthSoundSweep(实际频率, 毫秒, 槽1波形, 槽1音量, 扫起始, 扫终止, 扫共振, 扫方向)
            }
        }
    }
    返 XT_SynthSoundMulti(实际频率, 毫秒, 振荡器数,
                          槽1波形, 槽1音量, 槽1频率比, 槽2波形, 槽2音量, 槽2频率比,
                          槽3波形, 槽3音量, 槽3频率比, 槽4波形, 槽4音量, 槽4频率比,
                          起音, 衰减, 延持电平, 释音, 低音, 中音, 高音,
                          延迟时间, 延迟反馈, 延迟混合, 房间大小, 湿干比)
}

// 以流式解码方式打开音频文件，适合长背景音乐（边解码边播，不整段占内存）；音乐池上限 32，句柄为 1 起整数。
//
// 参数 文件: 字符串 — 音频文件路径（UTF-8）
// 返回: 整 — 音乐句柄（1–32），0=失败
公 函 加载音乐流(文件) {
    返 XT_LoadMusicStream(文件)
}

// 开始或继续播放音乐流。
//
// 参数 音乐句柄: 整 — 加载音乐流 的返回值
// 返回: 无
公 函 播音乐流(音乐句柄) {
    XT_PlayMusicStream(音乐句柄)
}

// 每帧调用一次，解码并填充下一段缓冲；不调用会导致断续或无声。
//
// 参数 音乐句柄: 整 — 加载音乐流 的返回值
// 返回: 无
公 函 更新音乐流(音乐句柄) {
    XT_UpdateMusicStream(音乐句柄)
}

// 停止播放并回到开头（可再次调用 播音乐流）。
//
// 参数 音乐句柄: 整 — 加载音乐流 的返回值
// 返回: 无
公 函 停音乐流(音乐句柄) {
    XT_StopMusicStream(音乐句柄)
}

// 关闭流并释放资源；无效句柄为空操作。
//
// 参数 音乐句柄: 整 — 加载音乐流 的返回值
// 返回: 无
公 函 释音乐流(音乐句柄) {
    XT_UnloadMusicStream(音乐句柄)
}

// ============================================================
// 3D(v1.3.0,高层封装)
// ============================================================

// 设置 3D 相机：从眼位看向注视点，透视投影，up 固定为 (0,1,0)；每帧调用即可实现跟随。
// 坐标约定与 raylib 一致：Y 轴向上、右手系；模型均以世界坐标给出。
//
// 参数 眼x: 小数 — 相机位置 X（世界坐标）
// 参数 眼y: 小数 — 相机位置 Y
// 参数 眼z: 小数 — 相机位置 Z
// 参数 靶x: 小数 — 注视点 X
// 参数 靶y: 小数 — 注视点 Y
// 参数 靶z: 小数 — 注视点 Z
// 参数 视场: 小数 — 垂直视场角（度）
// 返回: 无
公 函 设置相机3D(眼x, 眼y, 眼z, 靶x, 靶y, 靶z, 视场) {
    XT_Camera3D_Set(眼x, 眼y, 眼z, 靶x, 靶y, 靶z, 视场)
}

// 进入 3D 绘制：须与 退出3D 成对，且位于 开始绘图/结束绘图 之间。
//
// 返回: 无
公 函 进入3D() { XT_BeginMode3D() }

// 退出 3D 绘制、恢复 2D 坐标系；HUD 等 2D 内容在 退出3D 之后绘制。
//
// 返回: 无
公 函 退出3D() { XT_EndMode3D() }

// 以 (x, y, z) 为中心绘制实心立方体（世界坐标，Y 轴向上）。
//
// 参数 x: 小数 — 中心 X
// 参数 y: 小数 — 中心 Y
// 参数 z: 小数 — 中心 Z
// 参数 宽: 小数 — X 轴边长
// 参数 高: 小数 — Y 轴边长
// 参数 深: 小数 — Z 轴边长
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘立方体(x, y, z, 宽, 高, 深, r, g, b, a) {
    XT_DrawCube3D(x, y, z, 宽, 高, 深, r, g, b, a)
}

// 以 (x, y, z) 为中心绘制立方体线框。
//
// 参数 x: 小数 — 中心 X
// 参数 y: 小数 — 中心 Y
// 参数 z: 小数 — 中心 Z
// 参数 宽: 小数 — X 轴边长
// 参数 高: 小数 — Y 轴边长
// 参数 深: 小数 — Z 轴边长
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘立方体线(x, y, z, 宽, 高, 深, r, g, b, a) {
    XT_DrawCubeWires3D(x, y, z, 宽, 高, 深, r, g, b, a)
}

// 以 (x, y, z) 为球心绘制实心球。
//
// 参数 x: 小数 — 球心 X
// 参数 y: 小数 — 球心 Y
// 参数 z: 小数 — 球心 Z
// 参数 半径: 小数 — 半径（世界单位）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘球体(x, y, z, 半径, r, g, b, a) {
    XT_DrawSphere3D(x, y, z, 半径, r, g, b, a)
}

// 以 (x, y, z) 为球心绘制球体线框（经纬线）。
//
// 参数 x: 小数 — 球心 X
// 参数 y: 小数 — 球心 Y
// 参数 z: 小数 — 球心 Z
// 参数 半径: 小数 — 半径（世界单位）
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘球体线(x, y, z, 半径, r, g, b, a) {
    XT_DrawSphereWires3D(x, y, z, 半径, r, g, b, a)
}

// 以原点为中心在 XZ 平面绘制地面网格，常用作 3D 场景参照。
//
// 参数 格数: 整 — 每轴格数（slices）
// 参数 间距: 小数 — 每格边长（世界单位）
// 返回: 无
公 函 绘地面网格(格数, 间距) { XT_DrawGrid3D(格数, 间距) }

// 在世界坐标两点之间绘制 3D 直线。
//
// 参数 x1: 小数 — 起点 X
// 参数 y1: 小数 — 起点 Y
// 参数 z1: 小数 — 起点 Z
// 参数 x2: 小数 — 终点 X
// 参数 y2: 小数 — 终点 Y
// 参数 z2: 小数 — 终点 Z
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘直线3D(x1, y1, z1, x2, y2, z2, r, g, b, a) {
    XT_DrawLine3D(x1, y1, z1, x2, y2, z2, r, g, b, a)
}

// 绘制一个 3D 点（raylib DrawPoint3D 实际输出为长度为零的小线段，屏幕上极小）。
// 需要明显可见的标记时改用 绘球体（小半径）或 绘直线3D。
//
// 参数 x: 小数 — 点 X
// 参数 y: 小数 — 点 Y
// 参数 z: 小数 — 点 Z
// 参数 r: 整 — 红色分量 0–255
// 参数 g: 整 — 绿色分量 0–255
// 参数 b: 整 — 蓝色分量 0–255
// 参数 a: 整 — 不透明度 0–255（255=完全不透明）
// 返回: 无
公 函 绘点3D(x, y, z, r, g, b, a) { XT_DrawPoint3D(x, y, z, r, g, b, a) }

// ---- 矩阵栈(3D 内平移/旋转图元;推弹成对) ----
// 压入当前 3D 变换矩阵；须与 弹矩阵 成对，且位于 进入3D 之内。
//
// 返回: 无
公 函 推矩阵() { XT_PushMatrix3D() }
// 弹出最近压入的 3D 变换矩阵，恢复压入时的变换。
//
// 返回: 无
公 函 弹矩阵() { XT_PopMatrix3D() }

// 在当前 3D 变换矩阵上叠加平移（世界单位），影响其后的 3D 绘制。
//
// 参数 x: 小数 — X 方向位移
// 参数 y: 小数 — Y 方向位移
// 参数 z: 小数 — Z 方向位移
// 返回: 无
公 函 平移3D(x, y, z) { XT_Translate3D(x, y, z) }

// 绕任意方向轴旋转当前 3D 变换矩阵，影响其后的 3D 绘制。
//
// 参数 角度: 小数 — 旋转角（度）
// 参数 轴x: 小数 — 旋转轴方向 X 分量
// 参数 轴y: 小数 — 旋转轴方向 Y 分量
// 参数 轴z: 小数 — 旋转轴方向 Z 分量
// 返回: 无
公 函 旋转3D(角度, 轴x, 轴y, 轴z) { XT_Rotate3D(角度, 轴x, 轴y, 轴z) }

// ============================================================
// 常用颜色常量（RGBA）
// ============================================================

// 纯白 RGBA（255,255,255,255）。颜色常量是字典，按分量取用，如 白["r"]。
公 常 白 = {"r": 255, "g": 255, "b": 255, "a": 255}
// 纯黑 RGBA（0,0,0,255）。
公 常 黑 = {"r": 0, "g": 0, "b": 0, "a": 255}
// 纯红 RGBA（255,0,0,255）。
公 常 红 = {"r": 255, "g": 0, "b": 0, "a": 255}
// 纯绿 RGBA（0,255,0,255）。
公 常 绿 = {"r": 0, "g": 255, "b": 0, "a": 255}
// 纯蓝 RGBA（0,0,255,255）。
公 常 蓝 = {"r": 0, "g": 0, "b": 255, "a": 255}
// 黄色 RGBA（255,255,0,255）。
公 常 黄 = {"r": 255, "g": 255, "b": 0, "a": 255}
// 青色 RGBA（0,255,255,255）。
公 常 青 = {"r": 0, "g": 255, "b": 255, "a": 255}
// 品红/紫 RGBA（255,0,255,255）。
公 常 紫 = {"r": 255, "g": 0, "b": 255, "a": 255}
// 橙色 RGBA（255,165,0,255）。
公 常 橙 = {"r": 255, "g": 165, "b": 0, "a": 255}
// 中灰 RGBA（128,128,128,255）。
公 常 灰 = {"r": 128, "g": 128, "b": 128, "a": 255}
// 深灰 RGBA（64,64,64,255）。
公 常 深灰 = {"r": 64, "g": 64, "b": 64, "a": 255}
// 浅灰 RGBA（200,200,200,255）。
公 常 浅灰 = {"r": 200, "g": 200, "b": 200, "a": 255}
// 全透明黑 RGBA（0,0,0,0）。
公 常 透明 = {"r": 0, "g": 0, "b": 0, "a": 0}

// ============================================================
// 键盘常用常量
// ============================================================
// → 方向键键码 262。
公 常 键右 = 262
// ← 方向键键码 263。
公 常 键左 = 263
// ↓ 方向键键码 264。
公 常 键下 = 264
// ↑ 方向键键码 265。
公 常 键上 = 265
// 空格键键码 32（0x20）。
公 常 键空格 = 32
// Esc 键键码 256；配合 设ESC关闭 控制是否据此退出。
公 常 键ESC = 256
// 回车键键码 257。
公 常 键回车 = 257
// 退格键键码 259（删除前一个字符）。
公 常 键退格 = 259
// 字母 A 键码 65（大写 ASCII）。
公 常 键A = 65
// 字母 B 键码 66。
公 常 键B = 66
// 字母 C 键码 67。
公 常 键C = 67
// 字母 E 键码 69。
公 常 键E = 69
// 字母 W 键码 87。
公 常 键W = 87
// 字母 S 键码 83。
公 常 键S = 83
// 字母 D 键码 68。
公 常 键D = 68
// 字母 R 键码 82。
公 常 键R = 82
// 字母 F 键码 70。
公 常 键F = 70
// 左 Shift 修饰键码 340（右 Shift 另见 键右Shift）。
公 常 键左Shift = 340
// 右 Shift 修饰键码 344。
公 常 键右Shift = 344
// 左 Ctrl 修饰键码 341（右 Ctrl 用 键右Ctrl）。
公 常 键Ctrl = 341
// 右 Ctrl 修饰键码 345。
公 常 键右Ctrl = 345
// 左 Alt 修饰键码 342。
公 常 键左Alt = 342
// 右 Alt 修饰键码 346。
公 常 键右Alt = 346
// 左 ⌘ / Win 修饰键码 343（GLFW 风格 Super 键）。
公 常 键左命令 = 343
// 右 ⌘ / Win 修饰键码 347。
公 常 键右命令 = 347
// 字母 V 键码 86（配合 Ctrl 做粘贴）。
公 常 键V = 86
// 字母 X 键码 88（配合 Ctrl 做剪切）。
公 常 键X = 88

// 鼠标左键按钮码 0，供 鼠标按下?/鼠标刚按下? 使用。
公 常 鼠左键 = 0
// 鼠标右键按钮码 1。
公 常 鼠右键 = 1
// 鼠标中键（滚轮键）按钮码 2。
公 常 鼠中键 = 2

// 系统默认光标，供 设鼠标样式 使用（枚举 0）。
公 常 鼠标默认 = 0
// 箭头光标（枚举 1）。
公 常 鼠标箭头 = 1
// I 形文本光标（枚举 2），输入框悬浮时用。
公 常 鼠标I形 = 2
// 十字光标（枚举 3），绘图/准星用。
公 常 鼠标十字 = 3
// 手型光标（枚举 4），可点击元素用。
公 常 鼠标手型 = 4
