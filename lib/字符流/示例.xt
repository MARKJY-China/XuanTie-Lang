// 示例.xt — 字符流最小示例：进原始模式，把每个键/鼠标事件原样显示，回车或 Ctrl+C 退出
//
// 编译运行（在本目录执行；xtc 指玄铁自举编译器，如仓库根的 build/xtc_s4.exe，
// 缺省按宿主平台/架构自动选目标，不要写死 -pt/-jg）：
//   Linux/macOS：xtc 铁 示例.xt -sc charstream_example && ./charstream_example
//   Windows    ：xtc 铁 示例.xt -sc charstream_example.exe && charstream_example.exe
// 产物名请用 ASCII：Windows 的 gcc/ld 走窄字符路径，中文产物名会打不开。
//
// 事件类型齐全地过一遍：方向键/滚轮/点击/普通键/心跳静默/孤 ESC/退出键。

引 "./字符流.xt" 予 流

设 轮询 = 流.进原始模式()
设 转义 = 流.取转义()
设 运行 = 真
当 运行 {
    设 事件 = 流.取事件()
    设 类型 = 事件["类型"]
    若 类型 == "断" {
        运行 = 假
    }
    若 类型 == "键" {
        若 事件["码"] == 13 或 事件["码"] == 3 {
            运行 = 假
        }
    }
    若 类型 == "键" 或 类型 == "鼠标" {
        设 描述 = ""
        若 类型 == "键" {
            描述 = "类型=键 码=" & 字(事件["码"]) & "   (回车/Ctrl+C 退出)"
        } 否 {
            描述 = "类型=鼠标 按钮=" & 字(事件["按钮"]) & " 列=" & 字(事件["列"]) & " 行=" & 字(事件["行"]) & " 动作=" & 事件["动作"] & "   (回车/Ctrl+C 退出)"
        }
        示(转义 & "[2J" & 转义 & "[H" & "字符流示例 — 轮询模式=" & (若 轮询 { "开(空闲心跳可用)" } 否 { "关(阻塞回退)" }) & "\r\n" & 描述 & 转义 & "[K")
    }
    // "无"=心跳：什么都不做，这就是空闲刷新的节拍来源
}
流.恢复终端()
