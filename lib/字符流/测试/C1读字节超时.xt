// C1读字节超时.xt —— 契约 C1 的验证程序（由 测试/C1读字节超时.py 在 Unix pty 中运行）
//
// 契约 C1（正式文档见 GUIDE/关键字/文件.md「句柄.读字节」；测试见 测试/C1读字节超时.py）：
//   在带读超时的终端上（VTIME 超时、无数据可读），句柄.读字节(n) 必须返回
//   「成功且空串」——即 结果.成功 == 真 且 结果.值 == ""，**不是失败**。
//
// 为什么这条语义是硬契约：只判 .成功 的代码会把每次空闲超时当成"句柄错误"，于是
// 空读句柄永不关闭，stdio 会话留下粘性 EOF，后续输入整段吞掉（真机实撞）。
//
// 运行前提（由驱动脚本保证，不要手动直接跑）：
//   1. 进程有控制终端，/dev/tty 可打开；
//   2. stdin 终端已设 raw + VMIN=0 / VTIME=1（每 0.1s 超时一次），且驱动方不发送任何输入字节。
//
// 断言策略：每轮新开句柄再读——与库内「空读即弃」策略一致，3 轮都必须是成功且空串。
// 输出：成功打印 C1_PASS 并退 0；失败打印 C1_FAIL ... 并以非 0 退出。

设 序号 = 1
设 通过 = 真
当 序号 <= 3 {
    设 开 = 文件.打开("/dev/tty", "读")
    若 非 开.成功 {
        示("C1_FAIL 第" & 字(序号) & "轮打不开 /dev/tty：" & 开.错误)
        通过 = 假
        序号 = 4
    } 否 {
        设 h = 开.值
        设 读 = h.读字节(1)
        若 非 读.成功 {
            示("C1_FAIL 第" & 字(序号) & "轮读超时返回失败：" & 读.错误)
            通过 = 假
        } 否 {
            若 读.值 != "" {
                示("C1_FAIL 第" & 字(序号) & "轮读超时返回了数据：" & 读.值)
                通过 = 假
            }
        }
        h.关闭()
        序号 = 序号 + 1
    }
}
若 通过 {
    示("C1_PASS 连续3轮超时读均返回 成功且空串")
    终 0
}
示("C1_FAIL 契约不成立")
终 1
