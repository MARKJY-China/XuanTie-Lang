// 结构.xt — 玄铁数据结构库 v1.0.1
// 纯玄铁实现：栈、队列、双端队列、链表、二叉堆、二叉搜索树、集合、LRU 缓存。
//
// 用法:
//   引 "结构" 予 S
//   设 栈 = 造 S.栈()
//   栈.压入(1) ; 栈.压入(2)
//   示(栈.取出().值)                 // 2
//
//   设 堆 = 造 S.二叉堆(函(a, b) { 返 a - b })   // 比较结果 < 0 者优先（此处为最小堆）
//   堆.压入(3) ; 堆.压入(1) ; 示(堆.取出().值)   // 1
//
// 约定:
//   * 每个容器都是 `型`，用 `造 <别名>.<类型名>(...)` 实例化（如 `造 S.栈()`）；构造参数写在各 `造` 的注释里。
//   * 空容器上的 取出/出队/查看 一律返回 `结果`（失败容器 + 中文原因），不静默返回空值。
//   * 集合的键依赖字典键，元素须为 整/字/布尔 这类可作键的值；数组、字典作元素会报运行时错误。
//   * 复杂度写在每个方法注释里；链表/LRU 的部分操作是 O(n)，不要当 O(1) 用。

// ── 栈 ──

// 栈（后进先出）。底层是动态数组，压入/取出/查看均为 O(1)。
型 栈 {
    设 项

    // 造：创建一个空栈。
    函 造() {
        此.项 = []
    }

    // 压入：把值放到栈顶。
    //
    // 参数 值: 任意 — 要压入的值
    // 返回: 空 — 无返回值
    函 压入(值) {
        此.项.追加(值)
    }

    // 取出：取走并返回栈顶值。
    //
    // 返回: 结果 — 成功时 .值 为栈顶值；栈空时 失败("栈为空: 取出")
    函 取出() {
        若 此.项.长度 == 0 { 返 失败("栈为空: 取出") }
        设 值 = 此.项[此.项.长度 - 1]
        此.项.删(此.项.长度 - 1)
        返 成功(值)
    }

    // 查看：只看栈顶值，不取出。
    //
    // 返回: 结果 — 成功时 .值 为栈顶值；栈空时 失败("栈为空: 查看")
    函 查看() {
        若 此.项.长度 == 0 { 返 失败("栈为空: 查看") }
        返 成功(此.项[此.项.长度 - 1])
    }

    // 大小：当前元素个数，O(1)。
    //
    // 返回: 整 — 元素个数
    函 大小() {
        返 此.项.长度
    }

    // 空?：是否为空栈，O(1)。
    //
    // 返回: 布尔 — 无元素为 真
    函 空?() {
        返 此.项.长度 == 0
    }

    // 清空：丢弃全部元素，O(1)（旧数组交给 ARC 回收）。
    //
    // 返回: 空 — 无返回值
    函 清空() {
        此.项 = []
    }

    // 到数组：按**栈底到栈顶**顺序返回副本。
    //
    // 返回: 数组 — 新数组；修改它不影响栈
    函 到数组() {
        设 出 = []
        遍历 值 于 此.项 { 出.追加(值) }
        返 出
    }
}

// ── 队列 ──

// 队列（先进先出）。底层是数组 + 头下标，入队 O(1)、出队摊销 O(1)。
型 队列 {
    设 数据
    设 头

    // 造：创建一个空队列。
    函 造() {
        此.数据 = []
        此.头 = 0
    }

    // 入队：把值放到队尾，O(1)。
    //
    // 参数 值: 任意 — 要入队的值
    // 返回: 空 — 无返回值
    函 入队(值) {
        此.数据.追加(值)
    }

    // 出队：取走并返回队头值，摊还 O(1)（积累的已出队前缀会在需要时压缩）。
    //
    // 返回: 结果 — 成功时 .值 为队头值；队空时 失败("队列为空: 出队")
    函 出队() {
        若 此.头 >= 此.数据.长度 { 返 失败("队列为空: 出队") }
        设 值 = 此.数据[此.头]
        此.头 = 此.头 + 1
        若 此.头 > 64 且 此.头 * 2 > 此.数据.长度 { 此.压缩() }
        返 成功(值)
    }

    // 查看头：只看队头值，不出队，O(1)。
    //
    // 返回: 结果 — 成功时 .值 为队头值；队空时 失败("队列为空: 查看头")
    函 查看头() {
        若 此.头 >= 此.数据.长度 { 返 失败("队列为空: 查看头") }
        返 成功(此.数据[此.头])
    }

    // 大小：队列中尚未出队的元素个数，O(1)。
    //
    // 返回: 整 — 元素个数
    函 大小() {
        返 此.数据.长度 - 此.头
    }

    // 空?：队列是否为空，O(1)。
    //
    // 返回: 布尔 — 无元素为 真
    函 空?() {
        返 此.头 >= 此.数据.长度
    }

    // 清空：丢弃全部元素，O(1)。
    //
    // 返回: 空 — 无返回值
    函 清空() {
        此.数据 = []
        此.头 = 0
    }

    // 到数组：按**队头到队尾**顺序返回副本，O(n)。
    //
    // 返回: 数组 — 新数组；修改它不影响队列
    函 到数组() {
        设 出 = []
        设 i = 此.头
        当 i < 此.数据.长度 {
            出.追加(此.数据[i])
            i = i + 1
        }
        返 出
    }

    // 压缩：把未出队元素搬到新数组，丢弃已出队前缀。内部方法，供 出队 自动调用。
    函 压缩() {
        设 新 = []
        设 i = 此.头
        当 i < 此.数据.长度 {
            新.追加(此.数据[i])
            i = i + 1
        }
        此.数据 = 新
        此.头 = 0
    }
}

// ── 双端队列 ──

// 双端队列：两端都能进出。尾端操作 O(1)；头端插入/删除是 O(n)。
型 双端队列 {
    设 数据

    // 造：创建一个空双端队列。
    函 造() {
        此.数据 = []
    }

    // 头入：把值放到队头，O(n)。
    //
    // 参数 值: 任意 — 要放入的值
    // 返回: 空 — 无返回值
    函 头入(值) {
        此.数据.插(0, 值)
    }

    // 尾入：把值放到队尾，O(1)。
    //
    // 参数 值: 任意 — 要放入的值
    // 返回: 空 — 无返回值
    函 尾入(值) {
        此.数据.追加(值)
    }

    // 头出：取走队头值，O(n)（数组删首元素需搬移）。
    //
    // 返回: 结果 — 成功时 .值 为队头值；空时 失败("双端队列为空: 头出")
    函 头出() {
        若 此.数据.长度 == 0 { 返 失败("双端队列为空: 头出") }
        设 值 = 此.数据[0]
        此.数据.删(0)
        返 成功(值)
    }

    // 尾出：取走队尾值，O(1)。
    //
    // 返回: 结果 — 成功时 .值 为队尾值；空时 失败("双端队列为空: 尾出")
    函 尾出() {
        若 此.数据.长度 == 0 { 返 失败("双端队列为空: 尾出") }
        设 值 = 此.数据[此.数据.长度 - 1]
        此.数据.删(此.数据.长度 - 1)
        返 成功(值)
    }

    // 查看头：只读队头值，O(1)。
    //
    // 返回: 结果 — 成功时 .值 为队头值；空时 失败("双端队列为空: 查看头")
    函 查看头() {
        若 此.数据.长度 == 0 { 返 失败("双端队列为空: 查看头") }
        返 成功(此.数据[0])
    }

    // 查看尾：只读队尾值，O(1)。
    //
    // 返回: 结果 — 成功时 .值 为队尾值；空时 失败("双端队列为空: 查看尾")
    函 查看尾() {
        若 此.数据.长度 == 0 { 返 失败("双端队列为空: 查看尾") }
        返 成功(此.数据[此.数据.长度 - 1])
    }

    // 大小：元素个数，O(1)。
    //
    // 返回: 整 — 元素个数
    函 大小() {
        返 此.数据.长度
    }

    // 空?：是否为空，O(1)。
    //
    // 返回: 布尔 — 无元素为 真
    函 空?() {
        返 此.数据.长度 == 0
    }

    // 清空：丢弃全部元素，O(1)。
    //
    // 返回: 空 — 无返回值
    函 清空() {
        此.数据 = []
    }

    // 到数组：按队头到队尾顺序返回副本，O(n)。
    //
    // 返回: 数组 — 新数组；修改它不影响双端队列
    函 到数组() {
        设 出 = []
        遍历 值 于 此.数据 { 出.追加(值) }
        返 出
    }
}

// ── 链表 ──

// 单向链表：头插/尾插 O(1)（维护尾指针），按值删除/查找 O(n)。
// 节点用字典表示（{"值": 值, "下": 下一节点}），不额外引入节点类型。
型 链表 {
    设 头
    设 尾
    设 数

    // 造：创建一个空链表。
    函 造() {
        此.头 = 空
        此.尾 = 空
        此.数 = 0
    }

    // 头插：把值插到链表头部，O(1)。
    //
    // 参数 值: 任意 — 要插入的值
    // 返回: 空 — 无返回值
    函 头插(值) {
        设 新 = {"值": 值, "下": 此.头}
        此.头 = 新
        若 此.尾 == 空 { 此.尾 = 新 }
        此.数 = 此.数 + 1
    }

    // 尾插：把值插到链表尾部，O(1)。
    //
    // 参数 值: 任意 — 要插入的值
    // 返回: 空 — 无返回值
    函 尾插(值) {
        设 新 = {"值": 值, "下": 空}
        若 此.尾 == 空 {
            此.头 = 新
            此.尾 = 新
        } 否 {
            此.尾["下"] = 新
            此.尾 = 新
        }
        此.数 = 此.数 + 1
    }

    // 移出：删除第一个等于 值 的节点（== 判等），O(n)。
    //
    // 参数 值: 任意 — 要删除的值
    // 返回: 布尔 — 删到了 真；链表中没有该值 假
    函 移出(值) {
        设 前 = 空
        设 游 = 此.头
        当 游 != 空 {
            若 游["值"] == 值 {
                若 前 == 空 { 此.头 = 游["下"] } 否 { 前["下"] = 游["下"] }
                若 游 == 此.尾 { 此.尾 = 前 }
                此.数 = 此.数 - 1
                返 真
            }
            前 = 游
            游 = 游["下"]
        }
        返 假
    }

    // 查找：找第一个等于 值 的节点，O(n)。
    //
    // 参数 值: 任意 — 要查找的值
    // 返回: 结果 — 成功时 .值 为该节点的值；找不到 失败("链表中没有该值")
    函 查找(值) {
        设 游 = 此.头
        当 游 != 空 {
            若 游["值"] == 值 { 返 成功(游["值"]) }
            游 = 游["下"]
        }
        返 失败("链表中没有该值")
    }

    // 大小：节点个数，O(1)。
    //
    // 返回: 整 — 节点个数
    函 大小() {
        返 此.数
    }

    // 空?：是否为空链表，O(1)。
    //
    // 返回: 布尔 — 无节点为 真
    函 空?() {
        返 此.头 == 空
    }

    // 到数组：按头到尾顺序返回副本，O(n)。
    //
    // 返回: 数组 — 新数组；修改它不影响链表
    函 到数组() {
        设 出 = []
        设 游 = 此.头
        当 游 != 空 {
            出.追加(游["值"])
            游 = 游["下"]
        }
        返 出
    }

    // 反转：原地颠倒节点顺序，O(n)；反转后 头/尾 同步交换。
    //
    // 返回: 空 — 无返回值
    函 反转() {
        设 前 = 空
        设 游 = 此.头
        此.尾 = 此.头
        当 游 != 空 {
            设 下个 = 游["下"]
            游["下"] = 前
            前 = 游
            游 = 下个
        }
        此.头 = 前
    }

    // 清空：丢弃全部节点，O(1)。
    //
    // 返回: 空 — 无返回值
    函 清空() {
        此.头 = 空
        此.尾 = 空
        此.数 = 0
    }
}

// ── 二叉堆 ──

// 二叉堆（默认按 比较函 决定优先级）。压入/取出 O(log n)，查看顶 O(1)。
// 用 造 二叉堆(比较函) 实例化：比较函(a, b) 返回 <0 表示 a 优先（如 函(a,b){返 a-b} 是最小堆）。
型 二叉堆 {
    设 数据
    设 比较

    // 造：创建空堆。
    //
    // 参数 比较函: 函数 — 接收两个元素，返回负数表示第一个更优先
    函 造(比较函) {
        此.数据 = []
        此.比较 = 比较函
    }

    // 压入：插入一个元素并上浮，O(log n)。
    //
    // 参数 值: 任意 — 要插入的元素
    // 返回: 空 — 无返回值
    函 压入(值) {
        此.数据.追加(值)
        此.上浮(此.数据.长度 - 1)
    }

    // 取出：取走并返回优先级最高（比较函 最小）的元素，O(log n)。
    //
    // 返回: 结果 — 成功时 .值 为堆顶元素；堆空时 失败("堆为空: 取出")
    函 取出() {
        若 此.数据.长度 == 0 { 返 失败("堆为空: 取出") }
        设 顶 = 此.数据[0]
        设 末 = 此.数据[此.数据.长度 - 1]
        此.数据.删(此.数据.长度 - 1)
        若 此.数据.长度 > 0 {
            此.数据[0] = 末
            此.下沉(0)
        }
        返 成功(顶)
    }

    // 查看顶：只看优先级最高的元素，O(1)。
    //
    // 返回: 结果 — 成功时 .值 为堆顶元素；堆空时 失败("堆为空: 查看顶")
    函 查看顶() {
        若 此.数据.长度 == 0 { 返 失败("堆为空: 查看顶") }
        返 成功(此.数据[0])
    }

    // 大小：元素个数，O(1)。
    //
    // 返回: 整 — 元素个数
    函 大小() {
        返 此.数据.长度
    }

    // 空?：是否为空堆，O(1)。
    //
    // 返回: 布尔 — 无元素为 真
    函 空?() {
        返 此.数据.长度 == 0
    }

    // 到数组：返回内部堆序数组的副本（**不是**有序数组），O(n)。
    //
    // 返回: 数组 — 新数组；要排序结果请连续调用 取出
    函 到数组() {
        设 出 = []
        遍历 值 于 此.数据 { 出.追加(值) }
        返 出
    }

    // 上浮：内部方法，把下标 i 的元素向上调整到合适位置。
    函 上浮(i) {
        设 比 = 此.比较
        当 i > 0 {
            设 父 = (i - 1) / 2
            设 子值 = 此.数据[i]
            设 父值 = 此.数据[父]
            若 比(子值, 父值) < 0 {
                设 临 = 子值
                此.数据[i] = 父值
                此.数据[父] = 临
                i = 父
            } 否 {
                断
            }
        }
    }

    // 下沉：内部方法，把下标 i 的元素向下调整到合适位置。
    函 下沉(i) {
        设 n = 此.数据.长度
        设 比 = 此.比较
        当 真 {
            设 左 = i * 2 + 1
            设 右 = i * 2 + 2
            设 小 = i
            若 左 < n {
                设 左值 = 此.数据[左]
                设 小值 = 此.数据[小]
                若 比(左值, 小值) < 0 { 小 = 左 }
            }
            若 右 < n {
                设 右值 = 此.数据[右]
                设 小值2 = 此.数据[小]
                若 比(右值, 小值2) < 0 { 小 = 右 }
            }
            若 小 == i { 断 }
            设 临 = 此.数据[i]
            此.数据[i] = 此.数据[小]
            此.数据[小] = 临
            i = 小
        }
    }
}

// ── 二叉搜索树 ──

// 二叉搜索树：插入/查找/有? 平均 O(log n)，最坏 O(n)（插入顺序有序时退化）。
// 节点用字典表示（{"键": 键, "左": 左子树, "右": 右子树}），不额外引入节点类型。
// 用 造 二叉搜索树(比较函) 实例化：比较函(a,b) <0 表示 a 在左。
// 本实现不支持删除节点；值为比较函意义上的键（重复键只保留一个）。
型 二叉搜索树 {
    设 根节点
    设 数
    设 比较

    // 造：创建空树。
    //
    // 参数 比较函: 函数 — 接收两个键，返回负数表示第一个应排在左侧
    函 造(比较函) {
        此.根节点 = 空
        此.数 = 0
        此.比较 = 比较函
    }

    // 加入：把键插入树中；已存在相等键时不重复插入，O(高)。
    //
    // 参数 值: 任意 — 要插入的键值
    // 返回: 空 — 无返回值
    函 加入(值) {
        此.根节点 = 此.插节点(此.根节点, 值)
    }

    // 查找：按键查找并返回该键，O(高)。
    //
    // 参数 值: 任意 — 要查找的键值
    // 返回: 结果 — 成功时 .值 为命中的键；未命中 失败("二叉搜索树中没有该键")
    函 查找(值) {
        设 游 = 此.根节点
        设 比 = 此.比较
        当 游 != 空 {
            设 游键 = 游["键"]
            设 差 = 比(值, 游键)
            若 差 == 0 { 返 成功(游键) }
            若 差 < 0 { 游 = 游["左"] } 否 { 游 = 游["右"] }
        }
        返 失败("二叉搜索树中没有该键")
    }

    // 有?：判断键是否在树中，O(高)。
    //
    // 参数 值: 任意 — 要判断的键值
    // 返回: 布尔 — 存在为 真
    函 有?(值) {
        设 游 = 此.根节点
        设 比 = 此.比较
        当 游 != 空 {
            设 游键 = 游["键"]
            设 差 = 比(值, 游键)
            若 差 == 0 { 返 真 }
            若 差 < 0 { 游 = 游["左"] } 否 { 游 = 游["右"] }
        }
        返 假
    }

    // 中序：按比较函升序返回全部键，O(n)。
    //
    // 返回: 数组 — 新数组，已按比较函排序
    函 中序() {
        设 出 = []
        此.中序填(此.根节点, 出)
        返 出
    }

    // 最小：返回最小的键，O(高)。
    //
    // 返回: 结果 — 成功时 .值 为最小键；空树 失败("二叉搜索树为空: 最小")
    函 最小() {
        若 此.根节点 == 空 { 返 失败("二叉搜索树为空: 最小") }
        设 游 = 此.根节点
        当 游["左"] != 空 { 游 = 游["左"] }
        返 成功(游["键"])
    }

    // 最大：返回最大的键，O(高)。
    //
    // 返回: 结果 — 成功时 .值 为最大键；空树 失败("二叉搜索树为空: 最大")
    函 最大() {
        若 此.根节点 == 空 { 返 失败("二叉搜索树为空: 最大") }
        设 游 = 此.根节点
        当 游["右"] != 空 { 游 = 游["右"] }
        返 成功(游["键"])
    }

    // 高度：树的层数（空树为 0，只有根为 1），O(n)。
    //
    // 返回: 整 — 层数
    函 高度() {
        返 此.高(此.根节点)
    }

    // 大小：结点个数，O(1)。
    //
    // 返回: 整 — 结点个数（重复插入只算一个）
    函 大小() {
        返 此.数
    }

    // 空?：是否为空树，O(1)。
    //
    // 返回: 布尔 — 无结点为 真
    函 空?() {
        返 此.根节点 == 空
    }

    // 清空：丢弃整棵树，O(1)。
    //
    // 返回: 空 — 无返回值
    函 清空() {
        此.根节点 = 空
        此.数 = 0
    }

    // 插节点：内部递归方法，返回插好后的子树根。
    函 插节点(节, 值) {
        若 节 == 空 {
            此.数 = 此.数 + 1
            返 {"键": 值, "左": 空, "右": 空}
        }
        设 节键 = 节["键"]
        设 比 = 此.比较
        设 差 = 比(值, 节键)
        若 差 < 0 { 节["左"] = 此.插节点(节["左"], 值) }
        抑 差 > 0 { 节["右"] = 此.插节点(节["右"], 值) }
        返 节
    }

    // 中序填：内部方法，按中序把键填进数组。
    函 中序填(节, 出) {
        若 节 == 空 { 返 空 }
        此.中序填(节["左"], 出)
        出.追加(节["键"])
        此.中序填(节["右"], 出)
        返 空
    }

    // 高：内部方法，求子树层数。
    函 高(节) {
        若 节 == 空 { 返 0 }
        设 左高 = 此.高(节["左"])
        设 右高 = 此.高(节["右"])
        若 左高 > 右高 { 返 左高 + 1 }
        返 右高 + 1
    }
}

// ── 集合 ──

// 集合：基于字典实现，加入/删除/有? 摊还 O(1)。
// 元素必须是可作字典键的值（整/字/布尔）；数组、字典作元素会报运行时错误。
型 集合 {
    设 表

    // 造：创建空集合。
    函 造() {
        此.表 = {}
    }

    // 加入：把元素放进集合（已存在时无副作用），摊还 O(1)。
    //
    // 参数 值: 任意 — 要加入的元素
    // 返回: 空 — 无返回值
    函 加入(值) {
        此.表[值] = 真
    }

    // 移出：移除元素，摊还 O(1)。
    //
    // 参数 值: 任意 — 要删除的元素
    // 返回: 布尔 — 原有并已删除为 真；原本不在 假
    函 移出(值) {
        若 此.表.含?(值) {
            此.表.删(值)
            返 真
        }
        返 假
    }

    // 有?：元素是否在集合中，摊还 O(1)。
    //
    // 参数 值: 任意 — 要判断的元素
    // 返回: 布尔 — 在集合中为 真
    函 有?(值) {
        返 此.表.含?(值)
    }

    // 大小：元素个数，O(1)。
    //
    // 返回: 整 — 元素个数
    函 大小() {
        返 此.表.长度
    }

    // 空?：是否为空集合，O(1)。
    //
    // 返回: 布尔 — 无元素为 真
    函 空?() {
        返 此.表.长度 == 0
    }

    // 清空：移除全部元素，O(1)。
    //
    // 返回: 空 — 无返回值
    函 清空() {
        此.表 = {}
    }

    // 到数组：元素顺序不保证（哈希序），O(n)。
    //
    // 返回: 数组 — 新数组
    函 到数组() {
        返 此.表.键集
    }

    // 并：返回两个集合的并集元素（**数组**，去重，顺序不保证），O(n)。
    // 返回数组便于直接遍历/判长度；需要集合结果请逐个 加入 到新集合。
    //
    // 参数 其它: 集合 — 另一个集合同类实例
    // 返回: 数组 — 并集元素数组
    函 并(其它) {
        设 出 = []
        设 见 = {}
        遍历 值 于 此.到数组() {
            若 非 见.含?(值) { 见[值] = 真 ; 出.追加(值) }
        }
        遍历 值 于 其它.到数组() {
            若 非 见.含?(值) { 见[值] = 真 ; 出.追加(值) }
        }
        返 出
    }

    // 交：返回交集元素（**数组**，顺序不保证），O(n)。
    //
    // 参数 其它: 集合 — 另一个集合同类实例
    // 返回: 数组 — 交集元素数组
    函 交(其它) {
        设 出 = []
        遍历 值 于 此.到数组() {
            若 其它.有?(值) { 出.追加(值) }
        }
        返 出
    }

    // 差：返回在当前集合但不在 其它 中的元素（**数组**，顺序不保证），O(n)。
    //
    // 参数 其它: 集合 — 另一个集合同类实例
    // 返回: 数组 — 差集元素数组
    函 差(其它) {
        设 出 = []
        遍历 值 于 此.到数组() {
            若 非 其它.有?(值) { 出.追加(值) }
        }
        返 出
    }

    // 子集?：判断当前集合是否被 其它 包含，O(n)。
    //
    // 参数 其它: 集合 — 另一个集合同类实例
    // 返回: 布尔 — 当前集合的每个元素都在 其它 中为 真（空集合是任何集合的子集）
    函 子集?(其它) {
        遍历 值 于 此.到数组() {
            若 非 其它.有?(值) { 返 假 }
        }
        返 真
    }
}

// ── LRU 缓存 ──

// LRU（最近最少使用）缓存：容量固定，超容量时淘汰最久未使用的键。
// 底层是"键序数组 + 字典"：取值/存值 O(n)（移动键到数组末尾需重排），命中率高但容量别开太大。
型 LRU缓存 {
    设 容量
    设 键序
    设 表

    // 造：创建指定容量的空缓存。
    //
    // 参数 容量: 整 — 最多缓存多少个键；<=0 时按 1 处理
    函 造(容量参) {
        此.容量 = 容量参
        若 此.容量 <= 0 { 此.容量 = 1 }
        此.键序 = []
        此.表 = {}
    }

    // 取：读取键对应的值；命中时把该键移到最近使用端，O(n)。
    //
    // 参数 键名: 任意 — 可作字典键的键
    // 返回: 结果 — 成功时 .值 为缓存值；未命中 失败("LRU 缓存未命中")
    函 取(键名) {
        若 非 此.表.含?(键名) { 返 失败("LRU 缓存未命中") }
        此.提(键名)
        返 成功(此.表[键名])
    }

    // 放：写入键值；已存在则更新并移到最近使用端；超容量则淘汰最久未使用的键，O(n)。
    //
    // 参数 键名: 任意 — 可作字典键的键
    // 参数 值: 任意 — 要缓存的值
    // 返回: 空 — 无返回值
    函 放(键名, 值) {
        若 此.表.含?(键名) {
            此.表[键名] = 值
            此.提(键名)
            返 空
        }
        此.表[键名] = 值
        此.键序.追加(键名)
        当 此.键序.长度 > 此.容量 {
            设 旧 = 此.键序[0]
            此.键序.删(0)
            此.表.删(旧)
        }
        返 空
    }

    // 移出：移除键，O(n)。
    //
    // 参数 键名: 任意 — 要移除的键
    // 返回: 布尔 — 原有并已移除为 真；原本不在 假
    函 移出(键名) {
        若 非 此.表.含?(键名) { 返 假 }
        此.表.删(键名)
        设 i = 0
        当 i < 此.键序.长度 {
            若 此.键序[i] == 键名 {
                此.键序.删(i)
                断
            }
            i = i + 1
        }
        返 真
    }

    // 有?：键是否在缓存中（不影响使用顺序），O(1)。
    //
    // 参数 键名: 任意 — 要判断的键
    // 返回: 布尔 — 在缓存中为 真
    函 有?(键名) {
        返 此.表.含?(键名)
    }

    // 大小：当前缓存键数，O(1)。
    //
    // 返回: 整 — 键数
    函 大小() {
        返 此.表.长度
    }

    // 容量：创建时的最大容量，O(1)。
    //
    // 返回: 整 — 容量
    函 取容量() {
        返 此.容量
    }

    // 键列表：按"最久未使用 → 最近使用"顺序返回键副本，O(n)。
    //
    // 返回: 数组 — 新数组
    函 键列表() {
        设 出 = []
        遍历 键 于 此.键序 { 出.追加(键) }
        返 出
    }

    // 清空：丢弃全部缓存项，O(1)。
    //
    // 返回: 空 — 无返回值
    函 清空() {
        此.键序 = []
        此.表 = {}
    }

    // 提：内部方法，把键移到键序数组末尾（最近使用端）。
    函 提(键名) {
        设 i = 0
        当 i < 此.键序.长度 {
            若 此.键序[i] == 键名 {
                此.键序.删(i)
                断
            }
            i = i + 1
        }
        此.键序.追加(键名)
    }
}



