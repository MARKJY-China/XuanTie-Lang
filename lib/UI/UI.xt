// UI.xt — 玄铁声明式 UI 框架 v1.1
// FlexBox 布局引擎 + 基础控件集 + 响应式状态管理
// 依赖: lib/渲染 (raylib-based)
//
// 用法:
//   引 "UI" 予 UI
//   引 "渲染" 予 R
//
//   // 创建响应式状态
//   设 状态 = UI.造状态({"计数":0, "标题":"Hello"})
//
//   // 构建界面
//   设 界面 = UI.列([UI.文本(UI.态取(状态, "标题")), UI.按钮("+1")])
//
//   // 应用框架（自动渲染循环）
//   UI.应用(状态, 函(s) { 返 UI.列([...]) }, {"宽":800, "高":600})

引 "渲染" 予 R

外 函 xt_self_path(): 字
外 函 xt_env_get(名: 字): 字

// ============================================================
// 常量
// ============================================================
公 常 横向 = "横向"
公 常 纵向 = "纵向"
公 常 对齐始 = "始"
公 常 对齐中 = "中"
公 常 对齐末 = "末"
公 常 对齐间 = "间"
公 常 对齐均 = "均"
公 常 对齐均等 = "均等"
公 常 叉始 = "叉始"
公 常 叉中 = "叉中"
公 常 叉末 = "叉末"
公 常 叉撑 = "叉撑"

// ============================================================
// 辅助: 四边距
// ============================================================
公 函 四边(上, 右, 下, 左) {
    设 边 = {}
    边["上"] = 上 ; 边["右"] = 右 ; 边["下"] = 下 ; 边["左"] = 左
    返 边
}
公 函 全边(值) {
    返 四边(值, 值, 值, 值)
}

// ============================================================
// 色板
// ============================================================
公 函 色(r, g, b, a) {
    若 a == 空 { a = 255 }
    设 c = {} ; c["r"] = r ; c["g"] = g ; c["b"] = b ; c["a"] = a
    返 c
}

// 两位十六进制字符 → 0-255
函 _hex2(双字符) {
    设 v = 0
    设 i = 0
    当 i < 双字符.字节数 {
        设 c = 双字符.截取(i, i + 1)
        设 d = 0
        若 c == "0" { d = 0 } 抑 c == "1" { d = 1 } 抑 c == "2" { d = 2 }
        抑 c == "3" { d = 3 } 抑 c == "4" { d = 4 } 抑 c == "5" { d = 5 }
        抑 c == "6" { d = 6 } 抑 c == "7" { d = 7 } 抑 c == "8" { d = 8 }
        抑 c == "9" { d = 9 } 抑 c == "a" 或 c == "A" { d = 10 }
        抑 c == "b" 或 c == "B" { d = 11 } 抑 c == "c" 或 c == "C" { d = 12 }
        抑 c == "d" 或 c == "D" { d = 13 } 抑 c == "e" 或 c == "E" { d = 14 }
        抑 c == "f" 或 c == "F" { d = 15 }
        v = v * 16 + d
        i = i + 1
    }
    返 v
}

// 十六进制颜色:"#RRGGBB" / "RRGGBB" / "#RRGGBBAA"(# 前缀可选,8位末两码为透明度)
// 例: 色16("#3B82F6")  色16("FF0000")  色16("#3B82F680")
// 非法输入(长度不足/含非hex字符)返回品红(255,0,255)——图形界面惯例的错误示警色
公 函 色16(文本) {
    设 s = 文本
    若 s.截取(0, 1) == "#" { s = s.截取(1, s.字节数) }
    若 s.字节数 < 6 { 返 色(255, 0, 255, 255) }
    设 r = _hex2(s.截取(0, 2))
    设 g = _hex2(s.截取(2, 4))
    设 b = _hex2(s.截取(4, 6))
    设 a = 255
    若 s.字节数 >= 8 { a = _hex2(s.截取(6, 8)) }
    返 色(r, g, b, a)
}

公 常 色彩 = {}
色彩["白"] = 色(255, 255, 255, 255)
色彩["黑"] = 色(0, 0, 0, 255)
色彩["红"] = 色(255, 80, 80, 255)
色彩["绿"] = 色(80, 220, 80, 255)
色彩["蓝"] = 色(80, 120, 255, 255)
色彩["黄"] = 色(255, 220, 60, 255)
色彩["灰"] = 色(140, 140, 140, 255)
色彩["深灰"] = 色(50, 50, 50, 255)
色彩["浅灰"] = 色(220, 220, 220, 255)
色彩["透明"] = 色(0, 0, 0, 0)
色彩["主题"] = 色(70, 130, 220, 255)
色彩["强调"] = 色(255, 140, 40, 255)

// ============================================================
// 核心: 控件节点工厂
// ============================================================
函 造节点(类型) {
    设 n = {}
    n["_类型"] = 类型
    n["_子"] = []
    n["_宽"] = 0 ; n["_高"] = 0
    n["_弹"] = 0 ; n["_缩"] = 1
    n["_主轴对齐"] = 对齐始
    n["_叉轴对齐"] = 叉撑
    n["_间距"] = 0
    n["_内边距"] = 全边(0)
    n["_外边距"] = 全边(0)
    n["_布x"] = 0 ; n["_布y"] = 0 ; n["_布w"] = 0 ; n["_布h"] = 0
    n["_x"] = 0 ; n["_y"] = 0
    n["_文本"] = ""
    n["_字号"] = 16
    n["_字色"] = 色彩["白"]
    n["_底色"] = 色彩["透明"]
    n["_圆角"] = 0
    n["_边框色"] = 色彩["透明"]
    n["_边框宽"] = 0
    n["_悬底色"] = 色彩["透明"]
    n["_按底色"] = 色彩["透明"]
    n["_悬字色"] = 色彩["透明"]
    n["_按字色"] = 色彩["透明"]
    n["_禁底色"] = 色彩["透明"]
    n["_禁字色"] = 色彩["透明"]
    n["_禁用"] = 假
    // 通用外观(v1.2.0):阴影/渐变/羽化/字距(各组件共用,输入栏首批接入)
    n["_影色"] = 色彩["透明"]
    n["_影糊"] = 8
    n["_影x"] = 0
    n["_影y"] = 2
    n["_底色2"] = 色彩["透明"]
    n["_渐变向"] = "竖"
    n["_羽化"] = 1
    n["_字距"] = 1
    n["_触发"] = "点击"
    n["_连发间隔"] = 50
    n["_首按延迟"] = 0
    n["_待击"] = 假
    n["_按住起"] = 0
    n["_点击"] = 空
    n["_悬浮"] = 假
    n["_按下"] = 假
    n["_可视"] = 真
    返 n
}

// ============================================================
// 控件构造函数
// ============================================================
公 函 行(子列表, 选项) {
    设 节点 = 造节点("行")
    节点["_子"] = 子列表
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 列(子列表, 选项) {
    设 节点 = 造节点("列")
    节点["_子"] = 子列表
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 叠(子列表, 选项) {
    设 节点 = 造节点("叠")
    节点["_子"] = 子列表
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

// 绝对布局容器:子节点按选项 {"x":..,"y":..} 直接摆放(相对容器左上角),跳过 flex 计算
公 函 绝对(子列表, 选项) {
    设 节点 = 造节点("绝对")
    节点["_子"] = 子列表
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 文本(内容, 选项) {
    设 节点 = 造节点("文本")
    节点["_文本"] = 内容
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 矩形(选项) {
    设 节点 = 造节点("矩形")
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 按钮(标签, 选项) {
    设 节点 = 造节点("按钮")
    节点["_文本"] = 标签
    节点["_底色"] = 色彩["主题"]
    // 默认三态主题(v0.19.0 美化):圆角8px + 悬浮明显亮 + 按下明显暗;选项可覆盖
    // 注:鼠标桥接返回 1/0 整数,_左键按住 已归一为布尔(且 对整数1判假,实测按下态曾因此失效)
    节点["_圆角"] = 8
    节点["_悬底色"] = 色(115, 175, 250, 255)
    节点["_按底色"] = 色(40, 90, 170, 255)
    节点["_禁底色"] = 色(90, 90, 95, 255)
    节点["_禁字色"] = 色(150, 150, 150, 255)
    节点["_内边距"] = 全边(8)
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

// 输入栏(文本输入框,v1.1.0 起):值经 状态[键] 读写;光标/偏移/焦点存全局 _输入栏态。
// 选项:占位/占位色/字号/字距/宽/高/底色/底色2/渐变向/羽化/阴影/字色/框色/边框宽/焦框色/焦框宽/圆角/内边距/只读/提交(回车回调)
//      左图标/右图标(图片路径,png/jpg/svg)/图标尺寸(0=自动)/图标距/图标色/右图标点击
// 交互:点击获焦(并按点击处定位光标)、字符输入(含中文 IME 上屏)、退格、左右方向键、回车提交、ESC/点外失焦
公 函 输入栏(状态, 键, 选项) {
    设 节点 = 造节点("输入栏")
    节点["_状态"] = 状态
    节点["_栏键"] = 键
    节点["_占位"] = ""
    节点["_宽"] = 240
    节点["_底色"] = 色(28, 32, 40, 255)
    节点["_字色"] = 色(230, 232, 238, 255)
    节点["_框色"] = 色(88, 94, 106, 255)
    节点["_焦框色"] = 色(96, 160, 255, 255)
    节点["_边框宽"] = 1
    节点["_圆角"] = 6
    节点["_内边距"] = 全边(8)
    节点["_只读"] = 假
    节点["_提交"] = 空
    节点["_占位色"] = 色(120, 124, 132, 255)
    节点["_焦框宽"] = 2
    节点["_左图标"] = ""
    节点["_右图标"] = ""
    节点["_图标尺寸"] = 0
    节点["_图标距"] = 6
    节点["_图标色"] = 色彩["白"]
    节点["_右图标点击"] = 空
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 空白(选项) {
    设 节点 = 造节点("空白")
    节点["_弹"] = 1
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 弹性(弹值, 选项) {
    设 节点 = 造节点("空白")
    节点["_弹"] = 弹值
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

// ============================================================
// 辅助: 合并选项
// ============================================================
// 边距容错:允许裸数字(自动转 全边),也接受 四边/全边 字典。
// 裸数字直接存进节点会在布局期对整数做字典索引,现在会被索引守卫拦下报错
函 转边距(值) {
    若 值 == 空 { 返 全边(0) }
    匹配 值 {
        是 字典 -> { 返 值 }
        _ -> { 返 全边(值) }
    }
}

函 合选项(节点, 选项) {
    若 选项.含?("宽") { 节点["_宽"] = 选项["宽"] }
    若 选项.含?("高") { 节点["_高"] = 选项["高"] }
    若 选项.含?("x") { 节点["_x"] = 选项["x"] }
    若 选项.含?("y") { 节点["_y"] = 选项["y"] }
    若 选项.含?("弹性") { 节点["_弹"] = 选项["弹性"] }
    若 选项.含?("主轴对齐") { 节点["_主轴对齐"] = 选项["主轴对齐"] }
    若 选项.含?("叉轴对齐") { 节点["_叉轴对齐"] = 选项["叉轴对齐"] }
    若 选项.含?("间距") { 节点["_间距"] = 选项["间距"] }
    若 选项.含?("内边距") { 节点["_内边距"] = 转边距(选项["内边距"]) }
    若 选项.含?("外边距") { 节点["_外边距"] = 转边距(选项["外边距"]) }
    若 选项.含?("字号") { 节点["_字号"] = 选项["字号"] }
    若 选项.含?("字色") { 节点["_字色"] = 选项["字色"] }
    若 选项.含?("颜色") { 节点["_字色"] = 选项["颜色"] }
    若 选项.含?("底色") { 节点["_底色"] = 选项["底色"] }
    若 选项.含?("圆角") { 节点["_圆角"] = 选项["圆角"] }
    若 选项.含?("边框色") { 节点["_边框色"] = 选项["边框色"] }
    若 选项.含?("边框宽") { 节点["_边框宽"] = 选项["边框宽"] }
    若 选项.含?("悬底色") { 节点["_悬底色"] = 选项["悬底色"] }
    若 选项.含?("按底色") { 节点["_按底色"] = 选项["按底色"] }
    若 选项.含?("悬字色") { 节点["_悬字色"] = 选项["悬字色"] }
    若 选项.含?("按字色") { 节点["_按字色"] = 选项["按字色"] }
    若 选项.含?("禁底色") { 节点["_禁底色"] = 选项["禁底色"] }
    若 选项.含?("禁字色") { 节点["_禁字色"] = 选项["禁字色"] }
    若 选项.含?("禁用") { 节点["_禁用"] = 选项["禁用"] }
    若 选项.含?("触发") { 节点["_触发"] = 选项["触发"] }
    若 选项.含?("连发间隔") { 节点["_连发间隔"] = 选项["连发间隔"] }
    若 选项.含?("首按延迟") { 节点["_首按延迟"] = 选项["首按延迟"] }
    若 选项.含?("点击") { 节点["_点击"] = 选项["点击"] }
    若 选项.含?("可视") { 节点["_可视"] = 选项["可视"] }
    // 输入栏专用
    若 选项.含?("占位") { 节点["_占位"] = 选项["占位"] }
    若 选项.含?("只读") { 节点["_只读"] = 选项["只读"] }
    若 选项.含?("提交") { 节点["_提交"] = 选项["提交"] }
    若 选项.含?("焦框色") { 节点["_焦框色"] = 选项["焦框色"] }
    若 选项.含?("占位色") { 节点["_占位色"] = 选项["占位色"] }
    若 选项.含?("框色") { 节点["_框色"] = 选项["框色"] }
    若 选项.含?("焦框宽") { 节点["_焦框宽"] = 选项["焦框宽"] }
    若 选项.含?("左图标") { 节点["_左图标"] = 选项["左图标"] }
    若 选项.含?("右图标") { 节点["_右图标"] = 选项["右图标"] }
    若 选项.含?("图标尺寸") { 节点["_图标尺寸"] = 选项["图标尺寸"] }
    若 选项.含?("图标距") { 节点["_图标距"] = 选项["图标距"] }
    若 选项.含?("图标色") { 节点["_图标色"] = 选项["图标色"] }
    若 选项.含?("右图标点击") { 节点["_右图标点击"] = 选项["右图标点击"] }
    // 通用外观(v1.2.0)
    若 选项.含?("字距") { 节点["_字距"] = 选项["字距"] }
    若 选项.含?("底色2") { 节点["_底色2"] = 选项["底色2"] }
    若 选项.含?("渐变向") { 节点["_渐变向"] = 选项["渐变向"] }
    若 选项.含?("羽化") { 节点["_羽化"] = 选项["羽化"] }
    若 选项.含?("阴影") {
        设 _影项 = 选项["阴影"]
        若 _影项.含?("颜色") { 节点["_影色"] = _影项["颜色"] }
        若 _影项.含?("模糊") { 节点["_影糊"] = _影项["模糊"] }
        若 _影项.含?("x") { 节点["_影x"] = _影项["x"] }
        若 _影项.含?("y") { 节点["_影y"] = _影项["y"] }
    }
}

// ============================================================
// 布局: 测量叶节点固有尺寸
// ============================================================
// 文本宽度测量:有字体用字体精确测量(需窗口已初始化,应用/刷新流程满足);
// 无字体退回启发式估算(纯算术,可在无窗口环境使用)
函 量文本宽(文本, 字号) {
    若 _字体 != 0 { 返 R.量字体文字(_字体, 文本, 字号, 1) }
    设 估 = 文本.字节数 * 字号 * 3
    若 估 < 字号 * 2 { 估 = 字号 * 2 }
    返 估
}

函 量固有(节点) {
    设 类型 = 节点["_类型"]
    若 类型 == "文本" {
        设 文本宽 = 量文本宽(节点["_文本"], 节点["_字号"])
        若 文本宽 < 节点["_字号"] * 2 { 文本宽 = 节点["_字号"] * 2 }
        设 文本高 = 节点["_字号"] * 7 / 5
        返 [文本宽, 文本高]
    }
    若 类型 == "矩形" 或 类型 == "按钮" {
        设 bw = 节点["_宽"] ; 设 bh = 节点["_高"]
        若 类型 == "按钮" {
            若 bw == 0 {
                bw = 量文本宽(节点["_文本"], 节点["_字号"]) + 节点["_内边距"]["左"] + 节点["_内边距"]["右"] + 节点["_字号"]
            }
            若 bh == 0 {
                bh = 节点["_字号"] * 7 / 5 + 节点["_内边距"]["上"] + 节点["_内边距"]["下"] + 节点["_字号"] / 2
            }
        }
        返 [bw, bh]
    }
    若 类型 == "输入栏" {
        设 iw = 节点["_宽"]
        若 iw == 0 { iw = 240 }
        设 ih = 节点["_高"]
        若 ih == 0 { ih = 节点["_字号"] * 7 / 5 + 节点["_内边距"]["上"] + 节点["_内边距"]["下"] + 4 }
        返 [iw, ih]
    }
    // 容器固有尺寸:递归量子项(行=主轴求和/叉轴取最,列反之,叠=子项最大外包,绝对=坐标+尺寸外包)
    若 类型 == "行" 或 类型 == "列" 或 类型 == "叠" 或 类型 == "绝对" {
        设 内 = 节点["_内边距"]
        设 主和 = 0 ; 设 叉最 = 0 ; 设 外包宽 = 0 ; 设 外包高 = 0 ; 设 可见数 = 0
        遍历 子 于 节点["_子"] {
            若 非 子["_可视"] { 续 }
            可见数 = 可见数 + 1
            设 固 = 量固有(子)
            设 子宽 = 固[0] ; 设 子高 = 固[1]
            若 子["_宽"] > 0 { 子宽 = 子["_宽"] }
            若 子["_高"] > 0 { 子高 = 子["_高"] }
            若 类型 == "绝对" {
                若 子["_x"] + 子宽 > 外包宽 { 外包宽 = 子["_x"] + 子宽 }
                若 子["_y"] + 子高 > 外包高 { 外包高 = 子["_y"] + 子高 }
            } 抑 类型 == "叠" {
                若 子宽 > 外包宽 { 外包宽 = 子宽 }
                若 子高 > 外包高 { 外包高 = 子高 }
            } 否 {
                设 主 = 子高 ; 设 叉 = 子宽
                若 类型 == "行" { 主 = 子宽 ; 叉 = 子高 }
                主和 = 主和 + 主
                若 叉 > 叉最 { 叉最 = 叉 }
            }
        }
        设 w = 外包宽 ; 设 h = 外包高
        若 类型 == "行" 或 类型 == "列" {
            若 可见数 > 1 { 主和 = 主和 + 节点["_间距"] * (可见数 - 1) }
            若 类型 == "行" { w = 主和 ; h = 叉最 } 否 { w = 叉最 ; h = 主和 }
        }
        w = w + 内["左"] + 内["右"]
        h = h + 内["上"] + 内["下"]
        若 节点["_宽"] > 0 { w = 节点["_宽"] }
        若 节点["_高"] > 0 { h = 节点["_高"] }
        返 [w, h]
    }
    返 [节点["_宽"], 节点["_高"]]
}

// ============================================================
// FlexBox 布局引擎
// ============================================================
公 函 计算布局(节点, x, y, 可用宽, 可用高) {
    若 非 节点["_可视"] { 返 空 }

    设 边距 = 节点["_外边距"]
    设 mx = 边距["左"] ; 设 my = 边距["上"]
    节点["_布x"] = x + mx
    节点["_布y"] = y + my

    设 内容宽 = 可用宽 - 边距["左"] - 边距["右"]
    设 内容高 = 可用高 - 边距["上"] - 边距["下"]

    若 节点["_子"].长度 == 0 {
        设 固有 = 量固有(节点)
        节点["_布w"] = 固有[0] ; 节点["_布h"] = 固有[1]
        若 节点["_宽"] > 0 { 节点["_布w"] = 节点["_宽"] }
        若 节点["_高"] > 0 { 节点["_布h"] = 节点["_高"] }
        返 空
    }

    设 内距 = 节点["_内边距"]
    设 px = 内距["左"] ; 设 py = 内距["上"]
    设 子可用宽 = 内容宽 - 内距["左"] - 内距["右"]
    设 子可用高 = 内容高 - 内距["上"] - 内距["下"]
    若 子可用宽 < 0 { 子可用宽 = 0 }
    若 子可用高 < 0 { 子可用高 = 0 }

    设 类型 = 节点["_类型"]
    若 类型 == "叠" {
        布叠(节点, px, py, 子可用宽, 子可用高)
    } 抑 类型 == "绝对" {
        布绝对(节点, px, py, 子可用宽, 子可用高)
    } 抑 类型 == "行" {
        布主轴(节点, px, py, 子可用宽, 子可用高, 真)
    } 否 {
        布主轴(节点, px, py, 子可用宽, 子可用高, 假)
    }
}

// 绝对布局:子节点按 _x/_y 直摆(相对容器内容区左上),宽高取选项或固有
函 布绝对(节点, px, py, 可用宽, 可用高) {
    遍历 子 于 节点["_子"] {
        若 非 子["_可视"] { 续 }
        设 固有 = 量固有(子)
        设 子宽 = 固有[0] ; 设 子高 = 固有[1]
        若 子["_宽"] > 0 { 子宽 = 子["_宽"] }
        若 子["_高"] > 0 { 子高 = 子["_高"] }
        计算布局(子, 节点["_布x"] + px + 子["_x"], 节点["_布y"] + py + 子["_y"], 子宽, 子高)
    }
    设 内距 = 节点["_内边距"]
    节点["_布w"] = 可用宽 + 内距["左"] + 内距["右"]
    节点["_布h"] = 可用高 + 内距["上"] + 内距["下"]
    若 节点["_宽"] > 0 { 节点["_布w"] = 节点["_宽"] }
    若 节点["_高"] > 0 { 节点["_布h"] = 节点["_高"] }
}

函 布主轴(节点, 始X, 始Y, 可用宽, 可用高, 是横向) {
    设 子列表 = 节点["_子"]
    设 间距 = 节点["_间距"]
    设 总弹 = 0 ; 设 定长总和 = 0 ; 设 可见子 = []

    遍历 子 于 子列表 {
        若 非 子["_可视"] { 续 }
        可见子.追加(子)
        设 子边距 = 子["_外边距"]
        设 固有 = 量固有(子)
        若 是横向 {
            设 子首选 = 固有[0]
            若 子["_宽"] > 0 { 子首选 = 子["_宽"] }
            定长总和 = 定长总和 + 子首选 + 子边距["左"] + 子边距["右"]
        } 否 {
            设 子首选 = 固有[1]
            若 子["_高"] > 0 { 子首选 = 子["_高"] }
            定长总和 = 定长总和 + 子首选 + 子边距["上"] + 子边距["下"]
        }
        总弹 = 总弹 + 子["_弹"]
    }

    若 可见子.长度 == 0 {
        设 内距 = 节点["_内边距"]
        节点["_布w"] = 可用宽 + 内距["左"] + 内距["右"]
        节点["_布h"] = 可用高 + 内距["上"] + 内距["下"]
        若 节点["_宽"] > 0 { 节点["_布w"] = 节点["_宽"] }
        若 节点["_高"] > 0 { 节点["_布h"] = 节点["_高"] }
        返 空
    }

    设 间距总和 = 间距 * (可见子.长度 - 1)
    定长总和 = 定长总和 + 间距总和

    设 主轴空间 = 0
    若 是横向 { 主轴空间 = 可用宽 } 否 { 主轴空间 = 可用高 }
    设 剩余空间 = 主轴空间 - 定长总和
    若 剩余空间 < 0 { 剩余空间 = 0 }

    设 对齐偏移 = 0 ; 设 间隙额外 = 0
    设 对齐方式 = 节点["_主轴对齐"]

    若 对齐方式 == 对齐中 { 对齐偏移 = 剩余空间 / 2 }
    抑 对齐方式 == 对齐末 { 对齐偏移 = 剩余空间 }
    抑 对齐方式 == 对齐间 {
        若 可见子.长度 > 1 { 间隙额外 = 剩余空间 / (可见子.长度 - 1) }
    }
    抑 对齐方式 == 对齐均 {
        间隙额外 = 剩余空间 / 可见子.长度
        对齐偏移 = 间隙额外 / 2
    }
    抑 对齐方式 == 对齐均等 {
        设 段数 = 可见子.长度 + 1
        间隙额外 = 剩余空间 / 段数
        对齐偏移 = 间隙额外
    }

    设 叉空间 = 0
    若 是横向 { 叉空间 = 可用高 } 否 { 叉空间 = 可用宽 }

    设 主轴位置 = 0
    若 是横向 { 主轴位置 = 始X + 对齐偏移 } 否 { 主轴位置 = 始Y + 对齐偏移 }

    设 主轴总长 = 0 ; 设 叉轴最大 = 0

    遍历 子 于 可见子 {
        设 子边 = 子["_外边距"]
        设 子外边距主前 = 子边["左"] ; 设 子外边距主后 = 子边["右"]
        设 子外边距叉前 = 子边["上"] ; 设 子外边距叉后 = 子边["下"]
        若 非 是横向 {
            子外边距主前 = 子边["上"] ; 子外边距主后 = 子边["下"]
            子外边距叉前 = 子边["左"] ; 子外边距叉后 = 子边["右"]
        }

        主轴位置 = 主轴位置 + 子外边距主前

        设 子固有 = 量固有(子)
        设 子主轴尺寸 = 0
        若 是横向 {
            子主轴尺寸 = 子固有[0]
            若 子["_宽"] > 0 { 子主轴尺寸 = 子["_宽"] }
        } 否 {
            子主轴尺寸 = 子固有[1]
            若 子["_高"] > 0 { 子主轴尺寸 = 子["_高"] }
        }

        若 总弹 > 0 且 子["_弹"] > 0 {
            设 弹空间 = (剩余空间 * 子["_弹"]) / 总弹
            子主轴尺寸 = 子主轴尺寸 + 弹空间
        }

        设 子叉轴尺寸 = 0
        若 是横向 {
            子叉轴尺寸 = 子固有[1]
            若 子["_高"] > 0 { 子叉轴尺寸 = 子["_高"] }
        } 否 {
            子叉轴尺寸 = 子固有[0]
            若 子["_宽"] > 0 { 子叉轴尺寸 = 子["_宽"] }
        }
        若 子["_叉轴对齐"] == 叉撑 或 节点["_叉轴对齐"] == 叉撑 {
            设 撑后 = 叉空间 - 子外边距叉前 - 子外边距叉后
            若 撑后 > 子叉轴尺寸 { 子叉轴尺寸 = 撑后 }
            若 子叉轴尺寸 < 0 { 子叉轴尺寸 = 0 }
        }

        设 叉位置 = 0
        设 叉对齐 = 子["_叉轴对齐"]
        若 叉对齐 == 叉撑 { 叉对齐 = 节点["_叉轴对齐"] }
        若 叉对齐 == 叉中 { 叉位置 = (叉空间 - 子叉轴尺寸) / 2 }
        抑 叉对齐 == 叉末 { 叉位置 = 叉空间 - 子叉轴尺寸 }
        叉位置 = 叉位置 + 子外边距叉前

        若 是横向 {
            计算布局(子, 节点["_布x"] + 始X + 主轴位置, 节点["_布y"] + 始Y + 叉位置, 子主轴尺寸, 子叉轴尺寸)
            主轴总长 = 主轴总长 + 子外边距主前 + 子主轴尺寸 + 子外边距主后
            设 叉总 = 子外边距叉前 + 子叉轴尺寸 + 子外边距叉后
            若 叉总 > 叉轴最大 { 叉轴最大 = 叉总 }
        } 否 {
            计算布局(子, 节点["_布x"] + 始X + 叉位置, 节点["_布y"] + 始Y + 主轴位置, 子叉轴尺寸, 子主轴尺寸)
            主轴总长 = 主轴总长 + 子外边距主前 + 子主轴尺寸 + 子外边距主后
            设 叉总 = 子外边距叉前 + 子叉轴尺寸 + 子外边距叉后
            若 叉总 > 叉轴最大 { 叉轴最大 = 叉总 }
        }

        主轴位置 = 主轴位置 + 子主轴尺寸 + 子外边距主后 + 间距 + 间隙额外
    }

    主轴总长 = 主轴总长 + 间距总和
    设 内距 = 节点["_内边距"]

    若 是横向 {
        节点["_布w"] = 主轴总长 + 内距["左"] + 内距["右"]
        节点["_布h"] = 叉轴最大 + 内距["上"] + 内距["下"]
        若 节点["_宽"] > 0 { 节点["_布w"] = 节点["_宽"] }
        若 节点["_高"] > 0 { 节点["_布h"] = 节点["_高"] }
    } 否 {
        节点["_布w"] = 叉轴最大 + 内距["左"] + 内距["右"]
        节点["_布h"] = 主轴总长 + 内距["上"] + 内距["下"]
        若 节点["_宽"] > 0 { 节点["_布w"] = 节点["_宽"] }
        若 节点["_高"] > 0 { 节点["_布h"] = 节点["_高"] }
    }
}

函 布叠(节点, px, py, 可用宽, 可用高) {
    遍历 子 于 节点["_子"] {
        若 非 子["_可视"] { 续 }
        设 子宽 = 可用宽 ; 设 子高 = 可用高
        若 子["_宽"] > 0 { 子宽 = 子["_宽"] }
        若 子["_高"] > 0 { 子高 = 子["_高"] }
        计算布局(子, 节点["_布x"] + px, 节点["_布y"] + py, 子宽, 子高)
    }
    设 内距 = 节点["_内边距"]
    节点["_布w"] = 可用宽 + 内距["左"] + 内距["右"]
    节点["_布h"] = 可用高 + 内距["上"] + 内距["下"]
    若 节点["_宽"] > 0 { 节点["_布w"] = 节点["_宽"] }
    若 节点["_高"] > 0 { 节点["_布h"] = 节点["_高"] }
}

// ============================================================
// 渲染
// ============================================================
// 圆角像素→raylib 圆角百分比(0-100,相对 min(宽,高)/2 半径)
函 _圆角百分(节点) {
    设 角 = 节点["_圆角"]
    若 角 <= 0 { 返 0 }
    设 w = 节点["_布w"] ; 设 h = 节点["_布h"]
    设 m = w
    若 h < m { m = h }
    若 m <= 0 { 返 0 }
    设 pct = 角 * 200 / m
    若 pct > 100 { pct = 100 }
    返 pct
}

// 左键持续按住状态(按压态联动;由 应用/刷新 帧循环在处理悬浮前更新)
设 _左键按住 = 假
// 上一帧的按住状态(按下沿/松开沿检测用)
设 _左键上帧 = 假
// 按压源记录(跨帧记忆):声明式树每帧重建,节点上的 _待击/_按住起 活不过一帧——
// 改为全局按压键(节点身份串:坐标+宽+文本),按下沿记录、松开沿比对
设 _按压键 = ""
设 _按住起 = 0
设 _按住末次 = 0
设 _已连发 = 假

公 函 渲染(节点) {
    若 非 节点["_可视"] { 返 空 }

    设 x = 节点["_布x"] ; 设 y = 节点["_布y"]
    设 w = 节点["_布w"] ; 设 h = 节点["_布h"]
    设 景 = 节点["_底色"]

    // 阴影(v1.2.0):在背景之下,从外到内逐圈 1px 外扩圆角矩形,alpha 线性收敛。
    // 影色.a==0 即关闭(默认)。各组件通用,输入栏首批接入。
    设 影 = 节点["_影色"]
    若 影["a"] > 0 且 节点["_影糊"] > 0 且 w > 0 且 h > 0 {
        设 _糊 = 节点["_影糊"]
        设 _rp0 = _圆角百分(节点)
        设 _ri = _糊
        当 _ri >= 1 {
            设 _环a = 影["a"] * (_糊 - _ri + 1) / _糊
            若 _rp0 > 0 {
                R.绘圆角矩形(x + 节点["_影x"] - _ri, y + 节点["_影y"] - _ri, w + _ri * 2, h + _ri * 2, _rp0, 影["r"], 影["g"], 影["b"], _环a)
            } 否 {
                R.绘矩形(x + 节点["_影x"] - _ri, y + 节点["_影y"] - _ri, w + _ri * 2, h + _ri * 2, 影["r"], 影["g"], 影["b"], _环a)
            }
            _ri = _ri - 1
        }
    }

    // 背景:设了 底色2(渐变)或 羽化>1 时走渐变纹理路径(生成器自带圆角 SDF 与羽化);
    // 仅羽化不设渐变时,两色同底色 = 圆角羽化纯色块。否则经典纯色路径。
    设 底2 = 节点["_底色2"]
    若 (底2["a"] > 0 或 节点["_羽化"] > 1) 且 (景["a"] > 0 或 底2["a"] > 0) 且 w > 0 且 h > 0 {
        设 _c2 = 底2
        若 _c2["a"] == 0 { _c2 = 景 }
        设 _向 = 1
        若 节点["_渐变向"] == "横" { _向 = 0 }
        设 _gt = R.生成渐变纹理(w, h, 景["r"], 景["g"], 景["b"], 景["a"], _c2["r"], _c2["g"], _c2["b"], _c2["a"], _向, 节点["_圆角"], 节点["_羽化"])
        若 _gt > 0 { R.绘纹理区(_gt, x, y, w, h, 255, 255, 255, 255) }
    } 抑 景["a"] > 0 {
        设 _rp = _圆角百分(节点)
        若 _rp > 0 {
            R.绘圆角矩形(x, y, w, h, _rp, 景["r"], 景["g"], 景["b"], 景["a"])
        } 否 {
            R.绘矩形(x, y, w, h, 景["r"], 景["g"], 景["b"], 景["a"])
        }
    }

    设 框色 = 节点["_边框色"] ; 设 框宽 = 节点["_边框宽"]
    若 框宽 > 0 且 框色["a"] > 0 {
        设 _rp2 = _圆角百分(节点)
        若 _rp2 > 0 {
            R.绘圆角矩形线(x, y, w, h, _rp2, 框宽, 框色["r"], 框色["g"], 框色["b"], 框色["a"])
        } 否 {
            R.绘矩形线(x, y, w, h, 框色["r"], 框色["g"], 框色["b"], 框色["a"])
        }
    }

    设 类型 = 节点["_类型"]
    设 字色 = 节点["_字色"]

    若 类型 == "文本" {
        若 _字体 != 0 {
            R.绘字体文字(_字体, 节点["_文本"], x, y, 节点["_字号"], 1, 字色["r"], 字色["g"], 字色["b"], 字色["a"])
        } 否 {
            R.绘文字(节点["_文本"], x, y, 节点["_字号"], 字色["r"], 字色["g"], 字色["b"], 字色["a"])
        }
    }
    抑 类型 == "输入栏" {
        设 _bk = 节点["_栏键"]
        // 栏态惰性注册(节点每帧重建,状态/选项每帧经此汇入全局表)
        若 非 _输入栏态.含?(_bk) {
            _输入栏态[_bk] = _造栏态(节点)
        }
        设 _栏 = _输入栏态[_bk]
        _栏["状态"] = 节点["_状态"]
        _栏["只读"] = 节点["_只读"]
        _栏["提交"] = 节点["_提交"]
        设 _焦 = (_焦点栏 == _bk)
        // 边框:聚焦画 焦框色/焦框宽;非聚焦画 框色/边框宽(默认边框,v1.2.0 修复 框色 从未生效)
        设 _边色 = 节点["_框色"]
        设 _边宽 = 节点["_边框宽"]
        若 _焦 {
            _边色 = 节点["_焦框色"]
            _边宽 = 节点["_焦框宽"]
        }
        若 _边宽 > 0 且 _边色["a"] > 0 {
            设 _rp3 = _圆角百分(节点)
            若 _rp3 > 0 {
                R.绘圆角矩形线(x, y, w, h, _rp3, _边宽, _边色["r"], _边色["g"], _边色["b"], _边色["a"])
            } 否 {
                R.绘矩形线(x, y, w, h, _边色["r"], _边色["g"], _边色["b"], _边色["a"])
            }
        }
        设 内左 = 节点["_内边距"]["左"]
        设 内上 = 节点["_内边距"]["上"]
        设 内右 = 节点["_内边距"]["右"]
        // 图标(v1.2.0):左/右图标按 路径@尺寸 缓存纹理,垂直居中;文本区相应内缩
        设 图寸 = 节点["_图标尺寸"]
        若 图寸 <= 0 { 图寸 = h - 内上 - 节点["_内边距"]["下"] }
        若 图寸 < 8 { 图寸 = 8 }
        设 左纹 = 0
        设 右纹 = 0
        若 节点["_左图标"] != "" { 左纹 = _取图标纹理(节点["_左图标"], 图寸) }
        若 节点["_右图标"] != "" { 右纹 = _取图标纹理(节点["_右图标"], 图寸) }
        设 文左 = 内左
        设 文右 = 内右
        若 左纹 > 0 { 文左 = 文左 + 图寸 + 节点["_图标距"] }
        若 右纹 > 0 { 文右 = 文右 + 图寸 + 节点["_图标距"] }
        设 图y = y + (h - 图寸) / 2
        设 图色 = 节点["_图标色"]
        若 左纹 > 0 { R.绘纹理区(左纹, x + 内左, 图y, 图寸, 图寸, 图色["r"], 图色["g"], 图色["b"], 图色["a"]) }
        若 右纹 > 0 { R.绘纹理区(右纹, x + w - 内右 - 图寸, 图y, 图寸, 图寸, 图色["r"], 图色["g"], 图色["b"], 图色["a"]) }
        设 真值 = 态取(节点["_状态"], _bk)
        若 真值 == 空 { 真值 = "" }
        设 显示值 = 真值
        设 字色用 = 节点["_字色"]
        若 真值 == "" 且 节点["_占位"] != "" {
            显示值 = 节点["_占位"]
            字色用 = 节点["_占位色"]
        }
        设 距 = 节点["_字距"]
        // 光标位置(字符索引)与横向偏移(保持光标可见)
        若 _栏["光标"] < 0 { _栏["光标"] = 真值.字符数 }
        若 _栏["光标"] > 真值.字符数 { _栏["光标"] = 真值.字符数 }
        设 光标x = 0
        若 _字体 != 0 {
            设 前缀 = 真值.截取(0, _栏["光标"])
            光标x = R.量字体文字(_字体, 前缀, 节点["_字号"], 距)
        }
        设 内宽 = w - 文左 - 文右
        若 光标x - _栏["偏移"] > 内宽 - 6 { _栏["偏移"] = 光标x - 内宽 + 6 }
        若 光标x < _栏["偏移"] { _栏["偏移"] = 光标x }
        若 _栏["偏移"] < 0 { _栏["偏移"] = 0 }
        // 文本与光标(裁剪到文本区:左右图标区不进入,长文本滚动永不遮图标)
        R.裁剪开始(x + 文左, y + 2, w - 文左 - 文右, h - 4)
        // 选区高亮(焦点且有选区时,画在文本之下)
        设 _se = _栏选区(_栏)
        若 _焦 且 _se[0] >= 0 且 _字体 != 0 {
            设 _前宽 = R.量字体文字(_字体, 真值.截取(0, _se[0]), 节点["_字号"], 距)
            设 _选宽 = R.量字体文字(_字体, 真值.截取(_se[0], _se[1]), 节点["_字号"], 距)
            R.绘矩形(x + 文左 + _前宽 - _栏["偏移"], y + 内上, _选宽, 节点["_字号"] * 7 / 5, 70, 130, 230, 110)
        }
        // IME 内联组合:组合中拼音串插到光标处显示(下划线样式),上屏后由 获字符 进真值
        设 组合 = ""
        若 _焦 { 组合 = R.取组合串() }
        设 组合前宽 = 0
        设 组合宽 = 0
        若 组合 != "" {
            设 _前 = 真值.截取(0, _栏["光标"])
            显示值 = _前 & 组合 & 真值.截取(_栏["光标"], 真值.字符数)
            若 _字体 != 0 {
                组合前宽 = R.量字体文字(_字体, _前, 节点["_字号"], 距)
                组合宽 = R.量字体文字(_字体, 组合, 节点["_字号"], 距)
            }
        }
        设 字y = y + (h - 节点["_字号"] * 7 / 5) / 2
        若 _字体 != 0 {
            R.绘字体文字(_字体, 显示值, x + 文左 - _栏["偏移"], 字y, 节点["_字号"], 距, 字色用["r"], 字色用["g"], 字色用["b"], 字色用["a"])
        } 否 {
            R.绘文字(显示值, x + 文左 - _栏["偏移"], 字y, 节点["_字号"], 字色用["r"], 字色用["g"], 字色用["b"], 字色用["a"])
        }
        // 组合串下划线
        若 组合 != "" 且 _字体 != 0 {
            R.绘矩形(x + 文左 + 组合前宽 - _栏["偏移"], y + 内上 + 节点["_字号"] * 7 / 5 - 2, 组合宽, 2, 字色用["r"], 字色用["g"], 字色用["b"], 字色用["a"])
        }
        若 _焦 且 (时.毫秒() / 500) % 2 == 0 {
            设 光显x = 光标x
            若 组合 != "" { 光显x = 组合前宽 + 组合宽 }   // 组合中光标在组合串尾
            设 cx = x + 文左 + 光显x - _栏["偏移"]
            R.绘矩形(cx, y + 内上, 2, 节点["_字号"] * 7 / 5, 节点["_字色"]["r"], 节点["_字色"]["g"], 节点["_字色"]["b"], 节点["_字色"]["a"])
        }
        R.裁剪结束()
        // IME 候选框跟随光标:CFS_POINT 下候选窗落在给定点下方约 26px(被抑制组合窗的预留行高),
        // 故落点上移 26px 补偿,使候选窗顶边贴栏底。
        若 _焦 {
            R.设输入法位置(x + 文左 + 光标x - _栏["偏移"], y + h - 26)
        }
    }
    抑 类型 == "按钮" {
        设 bg = 景
        若 节点["_悬浮"] 且 节点["_悬底色"]["a"] > 0 { bg = 节点["_悬底色"] }
        若 节点["_按下"] 且 节点["_按底色"]["a"] > 0 { bg = 节点["_按底色"] }
        若 节点["_禁用"] 且 节点["_禁底色"]["a"] > 0 { bg = 节点["_禁底色"] }
        设 _rpb = _圆角百分(节点)
        若 _rpb > 0 {
            R.绘圆角矩形(x, y, w, h, _rpb, bg["r"], bg["g"], bg["b"], bg["a"])
        } 否 {
            R.绘矩形(x, y, w, h, bg["r"], bg["g"], bg["b"], bg["a"])
        }
        设 内距 = 节点["_内边距"]
        设 文本宽 = 量文本宽(节点["_文本"], 节点["_字号"])
        设 tx = x + (w - 文本宽) / 2 + 内距["左"]
        设 ty = y + 内距["上"]
        // 文字三态:按下>悬浮>常态(默认透明=不覆盖,沿用常态字色)
        设 字色选 = 字色
        若 节点["_悬浮"] 且 节点["_悬字色"]["a"] > 0 { 字色选 = 节点["_悬字色"] }
        若 节点["_按下"] 且 节点["_按字色"]["a"] > 0 { 字色选 = 节点["_按字色"] }
        若 节点["_禁用"] 且 节点["_禁字色"]["a"] > 0 { 字色选 = 节点["_禁字色"] }
        若 _字体 != 0 {
            R.绘字体文字(_字体, 节点["_文本"], tx, ty, 节点["_字号"], 1, 字色选["r"], 字色选["g"], 字色选["b"], 字色选["a"])
        } 否 {
            R.绘文字(节点["_文本"], tx, ty, 节点["_字号"], 字色选["r"], 字色选["g"], 字色选["b"], 字色选["a"])
        }
    }
    抑 类型 == "矩形" {
        R.绘矩形(x, y, w, h, 字色["r"], 字色["g"], 字色["b"], 字色["a"])
    }
    抑 类型 == "行" 或 类型 == "列" 或 类型 == "叠" 或 类型 == "绝对" {
        遍历 子 于 节点["_子"] { 渲染(子) }
    }
}

// ============================================================
// 输入事件
// ============================================================
公 函 处理悬浮(节点, 鼠x, 鼠y) {
    若 非 节点["_可视"] { 返 假 }
    设 在内部 = 鼠x >= 节点["_布x"] 且 鼠x < 节点["_布x"] + 节点["_布w"]
                且 鼠y >= 节点["_布y"] 且 鼠y < 节点["_布y"] + 节点["_布h"]
    若 节点["_禁用"] {
        // 禁用态不吃任何交互(悬浮/按下恒假)
        节点["_悬浮"] = 假
        节点["_按下"] = 假
    } 否 {
        节点["_悬浮"] = 在内部
        节点["_按下"] = 在内部 且 _左键按住
    }
    若 节点["_子"].长度 > 0 {
        遍历 子 于 节点["_子"] { 处理悬浮(子, 鼠x, 鼠y) }
    }
    返 在内部
}

公 函 处理点击(节点, 鼠x, 鼠y) {
    若 节点["_可视"] == 假 { 返 空 }
    设 在内部 = 鼠x >= 节点["_布x"] 且 鼠x < 节点["_布x"] + 节点["_布w"]
                且 鼠y >= 节点["_布y"] 且 鼠y < 节点["_布y"] + 节点["_布h"]

    // 输入栏:获焦/光标定位/框选(优先于 _点击 分派)
    若 节点["_类型"] == "输入栏" {
        设 _按下沿b = _左键按住 且 非 _左键上帧
        若 _按下沿b 且 在内部 {
            设 _bk2 = 节点["_栏键"]
            _焦点栏 = _bk2
            若 非 _输入栏态.含?(_bk2) {
                _输入栏态[_bk2] = _造栏态(节点)
            }
            设 _栏2 = _输入栏态[_bk2]
            _栏2["状态"] = 节点["_状态"]
            // 右图标点击区(v1.2.0):命中则仅触发回调(如"一键清空"),不挪光标不进框选
            若 节点["_右图标"] != "" 且 节点["_右图标点击"] != 空 {
                设 _图寸c = 节点["_图标尺寸"]
                若 _图寸c <= 0 { _图寸c = 节点["_布h"] - 节点["_内边距"]["上"] - 节点["_内边距"]["下"] }
                若 _图寸c < 8 { _图寸c = 8 }
                若 鼠x >= 节点["_布x"] + 节点["_布w"] - 节点["_内边距"]["右"] - _图寸c {
                    节点["_右图标点击"]()
                    返 节点
                }
            }
            _栏定位光标(节点, _栏2, 鼠x)
            // 框选起点:锚点=当前光标,进入框选态
            _栏2["选锚"] = _栏2["光标"]
            _栏2["_框选"] = 真
            返 节点
        }
        // 框选拖动(左键按住;允许拖出栏外,按 x 收敛)
        设 _bk3 = 节点["_栏键"]
        若 _输入栏态.含?(_bk3) {
            设 _栏3 = _输入栏态[_bk3]
            若 _栏3["_框选"] {
                若 _左键按住 {
                    _栏定位光标(节点, _栏3, 鼠x)
                } 否 {
                    _栏3["_框选"] = 假
                    // 松开后锚点==光标 = 空选区,清掉
                    若 _栏3["选锚"] == _栏3["光标"] { _栏3["选锚"] = -1 }
                }
            }
        }
    }

    // 先递归子节点(倒序,上层优先)
    设 k = 节点["_子"].长度 - 1
    当 k >= 0 {
        设 点中 = 处理点击(节点["_子"][k], 鼠x, 鼠y)
        若 点中 != 空 { 返 点中 }
        k = k - 1
    }

    若 节点["_点击"] != 空 且 非 节点["_禁用"] {
        设 模式 = 节点["_触发"]
        设 按下沿 = _左键按住 且 非 _左键上帧
        设 松开沿 = (非 _左键按住) 且 _左键上帧
        // 节点身份串(跨帧识别:树每帧重建,靠坐标+宽+文本认回同一个按钮)
        设 身份 = 节点["_布x"] & "," & 节点["_布y"] & "," & 节点["_布w"] & "," & 节点["_文本"]
        若 模式 == "按下" {
            // 按下即发(旧「点击」行为)
            若 按下沿 且 在内部 { 节点["_点击"]()  返 节点 }
        } 抑 模式 == "按住" {
            // 按住连发:默认按下即发;设了「首按延迟」则按住超过该时长才开始按「连发间隔」连发
            若 按下沿 且 在内部 {
                _按压键 = 身份
                _按住起 = 时.毫秒()
                _按住末次 = 时.毫秒()
                若 节点["_首按延迟"] == 0 { 节点["_点击"]() }
            }
            若 _按压键 == 身份 且 _左键按住 且 在内部 {
                设 现 = 时.毫秒()
                若 现 - _按住起 >= 节点["_首按延迟"] 且 现 - _按住末次 >= 节点["_连发间隔"] {
                    节点["_点击"]()
                    _按住末次 = 现
                }
            }
            若 松开沿 或 非 _左键按住 {
                若 _按压键 == 身份 { _按压键 = "" }
            }
        } 否 {
            // 点击(默认,语义修正):按下在内部记录按压源,松开也在内部才触发;
            // 设了「首按延迟」则按住超时时进入连发(此时松开不再补单击)——单击/长按连发两用按钮
            若 按下沿 且 在内部 {
                _按压键 = 身份
                _按住起 = 时.毫秒()
                _按住末次 = 时.毫秒()
                _已连发 = 假
            }
            若 节点["_首按延迟"] > 0 且 _按压键 == 身份 且 _左键按住 且 在内部 {
                设 现长 = 时.毫秒()
                若 现长 - _按住起 >= 节点["_首按延迟"] 且 现长 - _按住末次 >= 节点["_连发间隔"] {
                    节点["_点击"]()
                    _按住末次 = 现长
                    _已连发 = 真
                }
            }
            若 松开沿 {
                若 _按压键 == 身份 且 在内部 且 非 _已连发 { 节点["_点击"]() }
                若 _按压键 == 身份 { _按压键 = "" }
            }
        }
    }
    返 空
}

// ---- 输入栏辅助 ----

// 图标纹理缓存(v1.2.0):路径@尺寸 → 纹理句柄。随进程生命周期不卸载(图标通常常驻 UI);
// .svg 走 nanosvg 光栅化,其余扩展名走 raylib 位图解码(png/jpg/bmp/gif 等)
设 _图标缓存 = {}
函 _取图标纹理(路径, 尺寸) {
    设 键 = 路径 & "@" & 尺寸
    若 _图标缓存.含?(键) { 返 _图标缓存[键] }
    设 纹 = 0
    设 _尾 = ""
    若 路径.字符数 > 4 { _尾 = 路径.截取(路径.字符数 - 4, 路径.字符数) }
    若 _尾 == ".svg" {
        纹 = R.加载SVG纹理(路径, 尺寸, 尺寸)
    } 否 {
        纹 = R.加载纹理(路径)
    }
    若 纹 > 0 { _图标缓存[键] = 纹 }
    返 纹
}

// 栏态工厂(两处注册点统一走这里,防字段漏初始化)
函 _造栏态(节点) {
    返 {"状态": 节点["_状态"], "光标": -1, "偏移": 0, "只读": 节点["_只读"], "提交": 节点["_提交"],
        "选锚": -1, "_发键": 0, "_发起": 0, "_发末": 0, "_框选": 假}
}

// 按鼠标 x 反推最近字符插入位(逐字符中点判定;获焦点击与框选拖动复用)
函 _栏定位光标(节点, 栏, 鼠x) {
    设 _v = 态取(节点["_状态"], 节点["_栏键"])
    若 _v == 空 { _v = "" }
    // 文本区左缘:左图标存在时内缩 图标尺寸+图标距(与绘制侧一致)
    设 _文左 = 节点["_内边距"]["左"]
    若 节点["_左图标"] != "" {
        设 _图寸p = 节点["_图标尺寸"]
        若 _图寸p <= 0 { _图寸p = 节点["_布h"] - 节点["_内边距"]["上"] - 节点["_内边距"]["下"] }
        若 _图寸p < 8 { _图寸p = 8 }
        _文左 = _文左 + _图寸p + 节点["_图标距"]
    }
    设 _距 = 节点["_字距"]
    设 _目x = 鼠x - (节点["_布x"] + _文左) + 栏["偏移"]
    设 _ci = 0
    若 _字体 != 0 {
        当 _ci < _v.字符数 {
            设 _w1 = R.量字体文字(_字体, _v.截取(0, _ci), 节点["_字号"], _距)
            设 _w2 = R.量字体文字(_字体, _v.截取(0, _ci + 1), 节点["_字号"], _距)
            若 _目x <= (_w1 + _w2) / 2 { 断 }
            _ci = _ci + 1
        }
    } 否 {
        _ci = _v.字符数
    }
    栏["光标"] = _ci
}

// 当前选区 → [小端, 大端];无选区返 [-1, -1]
函 _栏选区(栏) {
    设 锚 = 栏["选锚"]
    设 光 = 栏["光标"]
    若 锚 < 0 或 锚 == 光 { 返 [-1, -1] }
    若 锚 < 光 { 返 [锚, 光] }
    返 [光, 锚]
}

// 删除选区文本(有选区时);返 是否有选区被删
函 _栏删选区(状态, 键, 栏) {
    设 se = _栏选区(栏)
    若 se[0] < 0 { 返 假 }
    设 值 = 态取(状态, 键)
    若 值 == 空 { 值 = "" }
    态设(状态, 键, 值.截取(0, se[0]) & 值.截取(se[1], 值.字符数))
    栏["光标"] = se[0]
    栏["选锚"] = -1
    返 真
}

// 按键连发判定:按下沿立即触发一次,按住超 首延 后按 间隔 连发(方向键/退格复用)
函 _连发判定(栏, 键码, 首延, 间隔) {
    若 R.键刚按下?(键码) {
        栏["_发键"] = 键码
        栏["_发起"] = 时.毫秒()
        栏["_发末"] = 时.毫秒()
        返 真
    }
    若 栏["_发键"] == 键码 且 R.键按下?(键码) {
        设 现 = 时.毫秒()
        若 现 - 栏["_发起"] >= 首延 且 现 - 栏["_发末"] >= 间隔 {
            栏["_发末"] = 现
            返 真
        }
    }
    若 非 R.键按下?(键码) 且 栏["_发键"] == 键码 { 栏["_发键"] = 0 }
    返 假
}

// 键盘输入处理(每帧于 处理点击 后调用):焦点输入栏的字符输入/编辑/方向/组合键
公 函 处理键盘() {
    若 _焦点栏 == "" { 返 空 }
    若 非 _输入栏态.含?(_焦点栏) { _焦点栏 = "" ; 返 空 }
    设 _栏 = _输入栏态[_焦点栏]
    设 状态 = _栏["状态"]
    设 _可写 = 非 _栏["只读"]
    设 _Ctrl = R.键按下?(R.键Ctrl) 或 R.键按下?(R.键右Ctrl)

    // 值读取小闭(态取 空→"")
    // —— Ctrl 组合键 ——
    若 _Ctrl {
        // Ctrl+A 全选
        若 R.键刚按下?(R.键A) {
            设 值 = 态取(状态, _焦点栏)
            若 值 == 空 { 值 = "" }
            _栏["选锚"] = 0
            _栏["光标"] = 值.字符数
        }
        // Ctrl+C 复制选区
        若 R.键刚按下?(R.键C) {
            设 se = _栏选区(_栏)
            若 se[0] >= 0 {
                设 值 = 态取(状态, _焦点栏)
                若 值 == 空 { 值 = "" }
                R.设剪贴板(值.截取(se[0], se[1]))
            }
        }
        // Ctrl+X 剪切(可写时)
        若 _可写 且 R.键刚按下?(R.键X) {
            设 se = _栏选区(_栏)
            若 se[0] >= 0 {
                设 值 = 态取(状态, _焦点栏)
                若 值 == 空 { 值 = "" }
                R.设剪贴板(值.截取(se[0], se[1]))
                _栏删选区(状态, _焦点栏, _栏)
            }
        }
        // Ctrl+V 粘贴(去换行;单行栏惯例)
        若 _可写 且 R.键刚按下?(R.键V) {
            设 贴 = R.取剪贴板()
            若 贴 == 空 { 贴 = "" }
            贴 = 贴.替换("\r\n", "").替换("\n", "").替换("\r", "")
            若 贴 != "" {
                _栏删选区(状态, _焦点栏, _栏)
                设 值 = 态取(状态, _焦点栏)
                若 值 == 空 { 值 = "" }
                设 光 = _栏["光标"]
                若 光 < 0 { 光 = 值.字符数 }
                态设(状态, _焦点栏, 值.截取(0, 光) & 贴 & 值.截取(光, 值.字符数))
                _栏["光标"] = 光 + 贴.字符数
            }
        }
    }

    // —— 字符输入(有选区先删选区;中文 IME 上屏字符经 获字符 拿到)——
    设 cp = R.获字符()
    当 cp != 0 {
        若 _可写 {
            _栏删选区(状态, _焦点栏, _栏)
            设 值 = 态取(状态, _焦点栏)
            若 值 == 空 { 值 = "" }
            设 光 = _栏["光标"]
            若 光 < 0 { 光 = 值.字符数 }
            态设(状态, _焦点栏, 值.截取(0, 光) & R.字自码点(cp) & 值.截取(光, 值.字符数))
            _栏["光标"] = 光 + 1
        }
        cp = R.获字符()
    }

    // —— 退格(按住连发;有选区删选区,否则删光标前一逻辑字符)——
    若 _可写 且 _连发判定(_栏, R.键退格, 400, 40) {
        若 非 _栏删选区(状态, _焦点栏, _栏) {
            设 光 = _栏["光标"]
            设 值 = 态取(状态, _焦点栏)
            若 值 == 空 { 值 = "" }
            若 光 > 0 且 值.字符数 > 0 {
                态设(状态, _焦点栏, 值.截取(0, 光 - 1) & 值.截取(光, 值.字符数))
                _栏["光标"] = 光 - 1
            }
        }
    }

    // —— 左右方向键(按住连发;有选区时收敛到选区端并清选区)——
    若 _连发判定(_栏, R.键左, 400, 40) {
        设 se = _栏选区(_栏)
        若 se[0] >= 0 {
            _栏["光标"] = se[0]
            _栏["选锚"] = -1
        } 否 {
            若 _栏["光标"] > 0 { _栏["光标"] = _栏["光标"] - 1 }
        }
    }
    若 _连发判定(_栏, R.键右, 400, 40) {
        设 值 = 态取(状态, _焦点栏)
        若 值 == 空 { 值 = "" }
        设 se = _栏选区(_栏)
        若 se[0] >= 0 {
            _栏["光标"] = se[1]
            _栏["选锚"] = -1
        } 否 {
            若 _栏["光标"] < 值.字符数 { _栏["光标"] = _栏["光标"] + 1 }
        }
    }
    // 上=光标到首,下=光标到尾
    若 R.键刚按下?(R.键上) {
        _栏["光标"] = 0
        _栏["选锚"] = -1
    }
    若 R.键刚按下?(R.键下) {
        设 值 = 态取(状态, _焦点栏)
        若 值 == 空 { 值 = "" }
        _栏["光标"] = 值.字符数
        _栏["选锚"] = -1
    }
    // 回车提交
    若 R.键刚按下?(R.键回车) {
        若 _栏["提交"] != 空 {
            设 值 = 态取(状态, _焦点栏)
            若 值 == 空 { 值 = "" }
            _栏["提交"](值)
        }
    }
    // ESC 失焦(并清选区)
    若 R.键刚按下?(R.键ESC) {
        _栏["选锚"] = -1
        _焦点栏 = ""
    }
}

// ============================================================
// 响应式状态系统 — View = f(State)
// ============================================================
// 全局渲染上下文栈（支持嵌套组件）
设 _渲染栈 = []

// 输入栏全局状态(节点每帧重建,控件内部状态不能存节点):
// 键 → {"状态":状态容器引用, "光标":整, "偏移":整, "只读":布尔, "提交":回调或空}
设 _输入栏态 = {}
// 当前焦点输入栏的键("";无焦点)
设 _焦点栏 = ""

// 当前字体句柄（0 = raylib 默认字体，不支持中文）
// 由 应用/手动设字体 设置，渲染() 的文本与按钮绘制据此选择 绘字体文字/绘文字
设 _字体 = 0

// 设置全局字体（返回旧句柄）。路径为运行时相对/绝对 TTF 路径，字库字号越大越清晰(默认32)
// 注意:必须在窗口初始化之后调用(raylib 加载字形纹理需要 GL 上下文);
// 字体在程序退出前应通过 释字体 释放;应用() 会自动管理
公 函 设字体(路径, 字库字号) {
    设 旧 = _字体
    若 路径 == 空 或 路径 == "" {
        _字体 = 0
    } 否 {
        设 库号 = 32
        若 字库字号 != 空 { 库号 = 字库字号 }
        _字体 = R.加载字体(路径, 库号)
    }
    返 旧
}

// ============================================================
// 默认字体(内置鸿蒙字体:零配置中文显示,v0.19.0 起)
// ============================================================
设 _字体已尝试 = 假

// 取环境变量值(走 runtime 宽字符 API,免 cmd 子进程——cmd echo 会闪黑色终端窗口且慢)
函 _环境值(名) {
    返 xt_env_get(名)
}

// 按候选路径查找内置鸿蒙字体,返回命中路径或 ""
函 _找默认字体() {
    设 名 = "HarmonyOS_Sans_SC_Regular.ttf"
    设 候选 = []
    // ① 铁铺已安装 UI 包内
    设 home = _环境值("TIEPM_HOME")
    若 home != "" {
        候选.追加(home & "\\已安装\\UI\\assets\\" & 名)
    } 否 {
        设 up = _环境值("USERPROFILE")
        若 up != "" { 候选.追加(up & "\\.tiepm\\已安装\\UI\\assets\\" & 名) }
    }
    // ①.5 XUANTIE_HOME(安装器写入的用户环境变量 → 安装目录\lib\UI\assets)
    设 xh = _环境值("XUANTIE_HOME")
    若 xh != "" { 候选.追加(xh & "\\lib\\UI\\assets\\" & 名) }
    // ② 程序自身目录(exeDir\assets,发行包布局)
    设 自径 = xt_self_path()
    若 自径 != "" {
        设 i = 自径.字节数 - 1
        当 i >= 0 {
            设 c = 自径.截取(i, i + 1)
            若 c == "\\" 或 c == "/" {
                候选.追加(自径.截取(0, i + 1) & "assets\\" & 名)
                断
            }
            i = i - 1
        }
    }
    // ③ CWD 常见布局(项目根/子目录/仓库 lib)
    候选.追加("assets\\" & 名)
    候选.追加("..\\assets\\" & 名)
    候选.追加("lib\\UI\\assets\\" & 名)
    遍历 p 于 候选 {
        若 文件.存在?(p) { 返 p }
    }
    返 ""
}

// 确保默认字体已加载(窗口初始化后调用;用户显式 设字体/选项字体 优先,不覆盖)
// 优先 GDI 系统字体(微软雅黑:系统级光栅化视觉效果,按需栅格化,无需 ttf 文件);
// 失败回退内置鸿蒙 ttf;全未命中则回退 raylib 默认字体并提示一次(不中断)
公 函 确保默认字体() {
    若 _字体 != 0 或 _字体已尝试 { 返 空 }
    _字体已尝试 = 真
    // GDI 系统字体优先(v1.0.0 起):系统字体引擎光栅化,中文显示与系统应用同质感
    设 _gh = R.加载系统字体("微软雅黑", 32)
    若 _gh != 0 { _字体 = _gh ; 返 空 }
    设 路径 = _找默认字体()
    若 路径 != "" {
        _字体 = R.加载字体(路径, 32)
    }
    若 _字体 == 0 {
        示("[UI] 提示: 未找到内置鸿蒙字体,中文将显示为方块;请 tiepm install UI 或将 assets 放到程序旁")
    }
}

// 创建响应式状态容器
公 函 造状态(初始数据) {
    设 容器 = {}
    容器["_值"] = 初始数据
    容器["_监听"] = {}
    容器["_脏"] = 假
    容器["_依赖"] = {}
    返 容器
}

// 读取状态（渲染期内自动追踪依赖）
公 函 态取(状态, 键) {
    若 状态 == 空 { 返 空 }
    若 _渲染栈.长度 > 0 {
        设 上下文 = _渲染栈[_渲染栈.长度 - 1]
        上下文["_依赖"][键] = 真
    }
    若 状态["_值"].含?(键) { 返 状态["_值"][键] }
    返 空
}

// 设置状态（变化时通知订阅者）
公 函 态设(状态, 键, 新值) {
    若 状态 == 空 { 返 空 }
    设 旧值 = 空
    若 状态["_值"].含?(键) { 旧值 = 状态["_值"][键] }
    若 旧值 == 新值 { 返 空 }
    状态["_值"][键] = 新值
    若 状态["_监听"].含?(键) {
        遍历 cb 于 状态["_监听"][键] {
            若 cb != 空 { cb() }
        }
    }
    状态["_脏"] = 真
}

// 订阅状态变化
公 函 态观(状态, 键, 回调) {
    若 状态 == 空 { 返 空 }
    若 非 状态["_监听"].含?(键) { 状态["_监听"][键] = [] }
    状态["_监听"][键].追加(回调)
}

// 批量设置
公 函 态设批(状态, 变更表) {
    若 状态 == 空 { 返 空 }
    遍历 键 于 变更表 { 态设(状态, 键, 变更表[键]) }
}

// 状态快照（不追踪依赖）
公 函 态快照(状态) {
    若 状态 == 空 { 返 {} }
    返 状态["_值"]
}

// 检查是否脏
公 函 态脏?(状态) {
    若 状态 == 空 { 返 假 }
    返 状态["_脏"]
}

// 标记脏
公 函 标脏(状态) {
    若 状态 == 空 { 返 空 }
    状态["_脏"] = 真
}

// 获取依赖键列表
公 函 态依赖(状态) {
    若 状态 == 空 { 返 [] }
    设 键列表 = []
    遍历 键 于 状态["_依赖"] { 键列表.追加(键) }
    返 键列表
}

// 清除所有订阅
公 函 态清除(状态) {
    若 状态 == 空 { 返 空 }
    状态["_监听"] = {} ; 状态["_依赖"] = {} ; 状态["_脏"] = 假
}

// 进入渲染上下文
函 _进上下文(状态) {
    设 上下文 = {}
    上下文["_依赖"] = {}
    _渲染栈.追加(上下文)
    状态["_依赖"] = {}
    状态["_脏"] = 假
    返 上下文
}

// 退出渲染上下文
函 _退上下文() {
    若 _渲染栈.长度 > 0 {
        设 新栈 = []
        设 i = 0
        当 i < _渲染栈.长度 - 1 {
            新栈.追加(_渲染栈[i])
            i = i + 1
        }
        _渲染栈 = 新栈
    }
}

// 应用框架：状态变化时自动重绘
// 构建函(状态) → 返回控件树根节点
// 选项: {"宽":800, "高":600, "标题":"App"}
公 函 应用(状态, 构建函, 选项) {
    若 状态 == 空 或 构建函 == 空 { 返 空 }

    设 宽 = 800 ; 设 高 = 600 ; 设 标题 = "XuanTie App"
    若 选项 != 空 {
        若 选项.含?("宽") { 宽 = 选项["宽"] }
        若 选项.含?("高") { 高 = 选项["高"] }
        若 选项.含?("标题") { 标题 = 选项["标题"] }
    }

    // 字体:选项["字体"] 传 TTF 路径即启用中文字体(自动加载/卸载);
    // 选项["字库字号"] 可指定栅格化字号(默认32,越大越清晰、纹理越大)
    R.初始化窗口(宽, 高, 标题)
    R.安装输入法钩子()   // IME 内联组合:拼音串直接显示在输入栏内(幂等)

    // 先出一帧背景:字体栅格化(内置2万汉字形)需1~2秒,避免窗口纯白无响应感
    R.开始绘图()
    R.清背景(40, 40, 50, 255)
    R.结束绘图()

    若 选项 != 空 且 选项.含?("字体") {
        设 字库号 = 32
        若 选项.含?("字库字号") { 字库号 = 选项["字库字号"] }
        _字体 = R.加载字体(选项["字体"], 字库号)
    } 否 {
        // 用户未指定字体:自动加载内置鸿蒙字体(零配置中文显示)
        确保默认字体()
    }

    当 非 R.窗口应关闭?() {
        设 鼠x = R.鼠X() ; 设 鼠y = R.鼠Y()
        设 左键 = R.鼠标刚按下?(0)
        _左键按住 = R.鼠标按下?(0) == 1

        _进上下文(状态)
        设 根节点 = 构建函(状态)
        _退上下文()

        R.开始绘图()
        R.清背景(40, 40, 50, 255)

        计算布局(根节点, 0, 0, 宽, 高)
        处理悬浮(根节点, 鼠x, 鼠y)
        // 处理点击改每帧调用(点击/按住模式需检测松开沿与持续时长)
        设 _按下沿m = _左键按住 且 非 _左键上帧
        设 _点中m = 处理点击(根节点, 鼠x, 鼠y)
        // 输入栏焦点:点中空白或非输入栏控件即失焦
        若 _按下沿m {
            若 _点中m == 空 { _焦点栏 = "" }
            否 { 若 _点中m["_类型"] != "输入栏" { _焦点栏 = "" } }
        }
        处理键盘()
        _左键上帧 = _左键按住
        渲染(根节点)

        R.结束绘图()
    }

    R.关闭窗口()

    // 卸载应用期加载的字体,恢复默认字体
    若 _字体 != 0 {
        R.释字体(_字体)
        _字体 = 0
    }
}

// 手动刷新（嵌入自定义渲染循环）
公 函 刷新(状态, 构建函, x, y, 宽, 高) {
    若 状态 == 空 { 返 空 }

    // 手动模式同样享受默认字体(首次调用时幂等尝试;窗口需已由调用方初始化)
    确保默认字体()
    R.安装输入法钩子()   // IME 内联组合(幂等)

    _进上下文(状态)
    设 根节点 = 构建函(状态)
    _退上下文()

    计算布局(根节点, x, y, 宽, 高)

    设 鼠x = R.鼠X() ; 设 鼠y = R.鼠Y()
    _左键按住 = R.鼠标按下?(0) == 1
    处理悬浮(根节点, 鼠x, 鼠y)
    设 _按下沿r = _左键按住 且 非 _左键上帧
    设 _点中r = 处理点击(根节点, 鼠x, 鼠y)
    若 _按下沿r {
        若 _点中r == 空 { _焦点栏 = "" }
        否 { 若 _点中r["_类型"] != "输入栏" { _焦点栏 = "" } }
    }
    处理键盘()
    _左键上帧 = _左键按住

    渲染(根节点)
    返 根节点
}
