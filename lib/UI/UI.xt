// UI.xt — 玄铁声明式 UI 框架 v1.1
// FlexBox 布局引擎 + 基础控件集 + 响应式状态管理
// 依赖: lib/渲染 (raylib-based)
//
// 用法:
//   引 "UI" 予 UI
//   引 "渲染" 予 R
//
//   // 创建响应式状态
//   设 状态 = UI.造状态({"计数":0, "标题":"Hello"})
//
//   // 构建界面
//   设 界面 = UI.列([UI.文本(UI.态取(状态, "标题")), UI.按钮("+1")])
//
//   // 应用框架（自动渲染循环）
//   UI.应用(状态, 函(s) { 返 UI.列([...]) }, {"宽":800, "高":600})

引 "渲染" 予 R

外 函 xt_self_path(): 字
外 函 xt_env_get(名: 字): 字

// ============================================================
// 常量
// ============================================================
公 常 横向 = "横向"
公 常 纵向 = "纵向"
公 常 对齐始 = "始"
公 常 对齐中 = "中"
公 常 对齐末 = "末"
公 常 对齐间 = "间"
公 常 对齐均 = "均"
公 常 对齐均等 = "均等"
公 常 叉始 = "叉始"
公 常 叉中 = "叉中"
公 常 叉末 = "叉末"
公 常 叉撑 = "叉撑"

// ============================================================
// 辅助: 四边距
// ============================================================
公 函 四边(上, 右, 下, 左) {
    设 边 = {}
    边["上"] = 上 ; 边["右"] = 右 ; 边["下"] = 下 ; 边["左"] = 左
    返 边
}
公 函 全边(值) {
    返 四边(值, 值, 值, 值)
}

// ============================================================
// 色板
// ============================================================
公 函 色(r, g, b, a) {
    若 a == 空 { a = 255 }
    设 c = {} ; c["r"] = r ; c["g"] = g ; c["b"] = b ; c["a"] = a
    返 c
}

// 两位十六进制字符 → 0-255
函 _hex2(双字符) {
    设 v = 0
    设 i = 0
    当 i < 双字符.字节数 {
        设 c = 双字符.截取(i, i + 1)
        设 d = 0
        若 c == "0" { d = 0 } 抑 c == "1" { d = 1 } 抑 c == "2" { d = 2 }
        抑 c == "3" { d = 3 } 抑 c == "4" { d = 4 } 抑 c == "5" { d = 5 }
        抑 c == "6" { d = 6 } 抑 c == "7" { d = 7 } 抑 c == "8" { d = 8 }
        抑 c == "9" { d = 9 } 抑 c == "a" 或 c == "A" { d = 10 }
        抑 c == "b" 或 c == "B" { d = 11 } 抑 c == "c" 或 c == "C" { d = 12 }
        抑 c == "d" 或 c == "D" { d = 13 } 抑 c == "e" 或 c == "E" { d = 14 }
        抑 c == "f" 或 c == "F" { d = 15 }
        v = v * 16 + d
        i = i + 1
    }
    返 v
}

// 十六进制颜色:"#RRGGBB" / "RRGGBB" / "#RRGGBBAA"(# 前缀可选,8位末两码为透明度)
// 例: 色16("#3B82F6")  色16("FF0000")  色16("#3B82F680")
// 非法输入(长度不足/含非hex字符)返回品红(255,0,255)——图形界面惯例的错误示警色
公 函 色16(文本) {
    设 s = 文本
    若 s.截取(0, 1) == "#" { s = s.截取(1, s.字节数) }
    若 s.字节数 < 6 { 返 色(255, 0, 255, 255) }
    设 r = _hex2(s.截取(0, 2))
    设 g = _hex2(s.截取(2, 4))
    设 b = _hex2(s.截取(4, 6))
    设 a = 255
    若 s.字节数 >= 8 { a = _hex2(s.截取(6, 8)) }
    返 色(r, g, b, a)
}

公 常 色彩 = {}
色彩["白"] = 色(255, 255, 255, 255)
色彩["黑"] = 色(0, 0, 0, 255)
色彩["红"] = 色(255, 80, 80, 255)
色彩["绿"] = 色(80, 220, 80, 255)
色彩["蓝"] = 色(80, 120, 255, 255)
色彩["黄"] = 色(255, 220, 60, 255)
色彩["灰"] = 色(140, 140, 140, 255)
色彩["深灰"] = 色(50, 50, 50, 255)
色彩["浅灰"] = 色(220, 220, 220, 255)
色彩["透明"] = 色(0, 0, 0, 0)
色彩["主题"] = 色(70, 130, 220, 255)
色彩["强调"] = 色(255, 140, 40, 255)

// ============================================================
// 核心: 控件节点工厂
// ============================================================
函 造节点(类型) {
    设 n = {}
    n["_类型"] = 类型
    n["_子"] = []
    n["_宽"] = 0 ; n["_高"] = 0
    n["_弹"] = 0 ; n["_缩"] = 1
    n["_主轴对齐"] = 对齐始
    n["_叉轴对齐"] = 叉撑
    n["_间距"] = 0
    n["_内边距"] = 全边(0)
    n["_外边距"] = 全边(0)
    n["_布x"] = 0 ; n["_布y"] = 0 ; n["_布w"] = 0 ; n["_布h"] = 0
    n["_文本"] = ""
    n["_字号"] = 16
    n["_字色"] = 色彩["白"]
    n["_底色"] = 色彩["透明"]
    n["_圆角"] = 0
    n["_边框色"] = 色彩["透明"]
    n["_边框宽"] = 0
    n["_悬底色"] = 色彩["透明"]
    n["_按底色"] = 色彩["透明"]
    n["_悬字色"] = 色彩["透明"]
    n["_按字色"] = 色彩["透明"]
    n["_禁底色"] = 色彩["透明"]
    n["_禁字色"] = 色彩["透明"]
    n["_禁用"] = 假
    n["_触发"] = "点击"
    n["_连发间隔"] = 50
    n["_首按延迟"] = 0
    n["_待击"] = 假
    n["_按住起"] = 0
    n["_点击"] = 空
    n["_悬浮"] = 假
    n["_按下"] = 假
    n["_可视"] = 真
    返 n
}

// ============================================================
// 控件构造函数
// ============================================================
公 函 行(子列表, 选项) {
    设 节点 = 造节点("行")
    节点["_子"] = 子列表
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 列(子列表, 选项) {
    设 节点 = 造节点("列")
    节点["_子"] = 子列表
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 叠(子列表, 选项) {
    设 节点 = 造节点("叠")
    节点["_子"] = 子列表
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 文本(内容, 选项) {
    设 节点 = 造节点("文本")
    节点["_文本"] = 内容
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 矩形(选项) {
    设 节点 = 造节点("矩形")
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 按钮(标签, 选项) {
    设 节点 = 造节点("按钮")
    节点["_文本"] = 标签
    节点["_底色"] = 色彩["主题"]
    // 默认三态主题(v0.19.0 美化):圆角8px + 悬浮明显亮 + 按下明显暗;选项可覆盖
    // 注:鼠标桥接返回 1/0 整数,_左键按住 已归一为布尔(且 对整数1判假,实测按下态曾因此失效)
    节点["_圆角"] = 8
    节点["_悬底色"] = 色(115, 175, 250, 255)
    节点["_按底色"] = 色(40, 90, 170, 255)
    节点["_禁底色"] = 色(90, 90, 95, 255)
    节点["_禁字色"] = 色(150, 150, 150, 255)
    节点["_内边距"] = 全边(8)
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 空白(选项) {
    设 节点 = 造节点("空白")
    节点["_弹"] = 1
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 弹性(弹值, 选项) {
    设 节点 = 造节点("空白")
    节点["_弹"] = 弹值
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

// ============================================================
// 辅助: 合并选项
// ============================================================
// 边距容错:允许裸数字(自动转 全边),也接受 四边/全边 字典。
// 裸数字直接存进节点会在布局期对整数做字典索引,现在会被索引守卫拦下报错
函 转边距(值) {
    若 值 == 空 { 返 全边(0) }
    匹配 值 {
        是 字典 -> { 返 值 }
        _ -> { 返 全边(值) }
    }
}

函 合选项(节点, 选项) {
    若 选项.含?("宽") { 节点["_宽"] = 选项["宽"] }
    若 选项.含?("高") { 节点["_高"] = 选项["高"] }
    若 选项.含?("弹性") { 节点["_弹"] = 选项["弹性"] }
    若 选项.含?("主轴对齐") { 节点["_主轴对齐"] = 选项["主轴对齐"] }
    若 选项.含?("叉轴对齐") { 节点["_叉轴对齐"] = 选项["叉轴对齐"] }
    若 选项.含?("间距") { 节点["_间距"] = 选项["间距"] }
    若 选项.含?("内边距") { 节点["_内边距"] = 转边距(选项["内边距"]) }
    若 选项.含?("外边距") { 节点["_外边距"] = 转边距(选项["外边距"]) }
    若 选项.含?("字号") { 节点["_字号"] = 选项["字号"] }
    若 选项.含?("字色") { 节点["_字色"] = 选项["字色"] }
    若 选项.含?("颜色") { 节点["_字色"] = 选项["颜色"] }
    若 选项.含?("底色") { 节点["_底色"] = 选项["底色"] }
    若 选项.含?("圆角") { 节点["_圆角"] = 选项["圆角"] }
    若 选项.含?("边框色") { 节点["_边框色"] = 选项["边框色"] }
    若 选项.含?("边框宽") { 节点["_边框宽"] = 选项["边框宽"] }
    若 选项.含?("悬底色") { 节点["_悬底色"] = 选项["悬底色"] }
    若 选项.含?("按底色") { 节点["_按底色"] = 选项["按底色"] }
    若 选项.含?("悬字色") { 节点["_悬字色"] = 选项["悬字色"] }
    若 选项.含?("按字色") { 节点["_按字色"] = 选项["按字色"] }
    若 选项.含?("禁底色") { 节点["_禁底色"] = 选项["禁底色"] }
    若 选项.含?("禁字色") { 节点["_禁字色"] = 选项["禁字色"] }
    若 选项.含?("禁用") { 节点["_禁用"] = 选项["禁用"] }
    若 选项.含?("触发") { 节点["_触发"] = 选项["触发"] }
    若 选项.含?("连发间隔") { 节点["_连发间隔"] = 选项["连发间隔"] }
    若 选项.含?("首按延迟") { 节点["_首按延迟"] = 选项["首按延迟"] }
    若 选项.含?("点击") { 节点["_点击"] = 选项["点击"] }
    若 选项.含?("可视") { 节点["_可视"] = 选项["可视"] }
}

// ============================================================
// 布局: 测量叶节点固有尺寸
// ============================================================
// 文本宽度测量:有字体用字体精确测量(需窗口已初始化,应用/刷新流程满足);
// 无字体退回启发式估算(纯算术,可在无窗口环境使用)
函 量文本宽(文本, 字号) {
    若 _字体 != 0 { 返 R.量字体文字(_字体, 文本, 字号, 1) }
    设 估 = 文本.字节数 * 字号 * 3
    若 估 < 字号 * 2 { 估 = 字号 * 2 }
    返 估
}

函 量固有(节点) {
    设 类型 = 节点["_类型"]
    若 类型 == "文本" {
        设 文本宽 = 量文本宽(节点["_文本"], 节点["_字号"])
        若 文本宽 < 节点["_字号"] * 2 { 文本宽 = 节点["_字号"] * 2 }
        设 文本高 = 节点["_字号"] * 7 / 5
        返 [文本宽, 文本高]
    }
    若 类型 == "矩形" 或 类型 == "按钮" {
        设 bw = 节点["_宽"] ; 设 bh = 节点["_高"]
        若 类型 == "按钮" {
            若 bw == 0 {
                bw = 量文本宽(节点["_文本"], 节点["_字号"]) + 节点["_内边距"]["左"] + 节点["_内边距"]["右"] + 节点["_字号"]
            }
            若 bh == 0 {
                bh = 节点["_字号"] * 7 / 5 + 节点["_内边距"]["上"] + 节点["_内边距"]["下"] + 节点["_字号"] / 2
            }
        }
        返 [bw, bh]
    }
    返 [节点["_宽"], 节点["_高"]]
}

// ============================================================
// FlexBox 布局引擎
// ============================================================
公 函 计算布局(节点, x, y, 可用宽, 可用高) {
    若 非 节点["_可视"] { 返 空 }

    设 边距 = 节点["_外边距"]
    设 mx = 边距["左"] ; 设 my = 边距["上"]
    节点["_布x"] = x + mx
    节点["_布y"] = y + my

    设 内容宽 = 可用宽 - 边距["左"] - 边距["右"]
    设 内容高 = 可用高 - 边距["上"] - 边距["下"]

    若 节点["_子"].长度 == 0 {
        设 固有 = 量固有(节点)
        节点["_布w"] = 固有[0] ; 节点["_布h"] = 固有[1]
        若 节点["_宽"] > 0 { 节点["_布w"] = 节点["_宽"] }
        若 节点["_高"] > 0 { 节点["_布h"] = 节点["_高"] }
        返 空
    }

    设 内距 = 节点["_内边距"]
    设 px = 内距["左"] ; 设 py = 内距["上"]
    设 子可用宽 = 内容宽 - 内距["左"] - 内距["右"]
    设 子可用高 = 内容高 - 内距["上"] - 内距["下"]
    若 子可用宽 < 0 { 子可用宽 = 0 }
    若 子可用高 < 0 { 子可用高 = 0 }

    设 类型 = 节点["_类型"]
    若 类型 == "叠" {
        布叠(节点, px, py, 子可用宽, 子可用高)
    } 抑 类型 == "行" {
        布主轴(节点, px, py, 子可用宽, 子可用高, 真)
    } 否 {
        布主轴(节点, px, py, 子可用宽, 子可用高, 假)
    }
}

函 布主轴(节点, 始X, 始Y, 可用宽, 可用高, 是横向) {
    设 子列表 = 节点["_子"]
    设 间距 = 节点["_间距"]
    设 总弹 = 0 ; 设 定长总和 = 0 ; 设 可见子 = []

    遍历 子 于 子列表 {
        若 非 子["_可视"] { 续 }
        可见子.追加(子)
        设 子边距 = 子["_外边距"]
        设 固有 = 量固有(子)
        若 是横向 {
            设 子首选 = 固有[0]
            若 子["_宽"] > 0 { 子首选 = 子["_宽"] }
            定长总和 = 定长总和 + 子首选 + 子边距["左"] + 子边距["右"]
        } 否 {
            设 子首选 = 固有[1]
            若 子["_高"] > 0 { 子首选 = 子["_高"] }
            定长总和 = 定长总和 + 子首选 + 子边距["上"] + 子边距["下"]
        }
        总弹 = 总弹 + 子["_弹"]
    }

    若 可见子.长度 == 0 {
        设 内距 = 节点["_内边距"]
        节点["_布w"] = 可用宽 + 内距["左"] + 内距["右"]
        节点["_布h"] = 可用高 + 内距["上"] + 内距["下"]
        若 节点["_宽"] > 0 { 节点["_布w"] = 节点["_宽"] }
        若 节点["_高"] > 0 { 节点["_布h"] = 节点["_高"] }
        返 空
    }

    设 间距总和 = 间距 * (可见子.长度 - 1)
    定长总和 = 定长总和 + 间距总和

    设 主轴空间 = 0
    若 是横向 { 主轴空间 = 可用宽 } 否 { 主轴空间 = 可用高 }
    设 剩余空间 = 主轴空间 - 定长总和
    若 剩余空间 < 0 { 剩余空间 = 0 }

    设 对齐偏移 = 0 ; 设 间隙额外 = 0
    设 对齐方式 = 节点["_主轴对齐"]

    若 对齐方式 == 对齐中 { 对齐偏移 = 剩余空间 / 2 }
    抑 对齐方式 == 对齐末 { 对齐偏移 = 剩余空间 }
    抑 对齐方式 == 对齐间 {
        若 可见子.长度 > 1 { 间隙额外 = 剩余空间 / (可见子.长度 - 1) }
    }
    抑 对齐方式 == 对齐均 {
        间隙额外 = 剩余空间 / 可见子.长度
        对齐偏移 = 间隙额外 / 2
    }
    抑 对齐方式 == 对齐均等 {
        设 段数 = 可见子.长度 + 1
        间隙额外 = 剩余空间 / 段数
        对齐偏移 = 间隙额外
    }

    设 叉空间 = 0
    若 是横向 { 叉空间 = 可用高 } 否 { 叉空间 = 可用宽 }

    设 主轴位置 = 0
    若 是横向 { 主轴位置 = 始X + 对齐偏移 } 否 { 主轴位置 = 始Y + 对齐偏移 }

    设 主轴总长 = 0 ; 设 叉轴最大 = 0

    遍历 子 于 可见子 {
        设 子边 = 子["_外边距"]
        设 子外边距主前 = 子边["左"] ; 设 子外边距主后 = 子边["右"]
        设 子外边距叉前 = 子边["上"] ; 设 子外边距叉后 = 子边["下"]
        若 非 是横向 {
            子外边距主前 = 子边["上"] ; 子外边距主后 = 子边["下"]
            子外边距叉前 = 子边["左"] ; 子外边距叉后 = 子边["右"]
        }

        主轴位置 = 主轴位置 + 子外边距主前

        设 子固有 = 量固有(子)
        设 子主轴尺寸 = 0
        若 是横向 {
            子主轴尺寸 = 子固有[0]
            若 子["_宽"] > 0 { 子主轴尺寸 = 子["_宽"] }
        } 否 {
            子主轴尺寸 = 子固有[1]
            若 子["_高"] > 0 { 子主轴尺寸 = 子["_高"] }
        }

        若 总弹 > 0 且 子["_弹"] > 0 {
            设 弹空间 = (剩余空间 * 子["_弹"]) / 总弹
            子主轴尺寸 = 子主轴尺寸 + 弹空间
        }

        设 子叉轴尺寸 = 0
        若 是横向 {
            子叉轴尺寸 = 子固有[1]
            若 子["_高"] > 0 { 子叉轴尺寸 = 子["_高"] }
        } 否 {
            子叉轴尺寸 = 子固有[0]
            若 子["_宽"] > 0 { 子叉轴尺寸 = 子["_宽"] }
        }
        若 子["_叉轴对齐"] == 叉撑 或 节点["_叉轴对齐"] == 叉撑 {
            设 撑后 = 叉空间 - 子外边距叉前 - 子外边距叉后
            若 撑后 > 子叉轴尺寸 { 子叉轴尺寸 = 撑后 }
            若 子叉轴尺寸 < 0 { 子叉轴尺寸 = 0 }
        }

        设 叉位置 = 0
        设 叉对齐 = 子["_叉轴对齐"]
        若 叉对齐 == 叉撑 { 叉对齐 = 节点["_叉轴对齐"] }
        若 叉对齐 == 叉中 { 叉位置 = (叉空间 - 子叉轴尺寸) / 2 }
        抑 叉对齐 == 叉末 { 叉位置 = 叉空间 - 子叉轴尺寸 }
        叉位置 = 叉位置 + 子外边距叉前

        若 是横向 {
            计算布局(子, 节点["_布x"] + 始X + 主轴位置, 节点["_布y"] + 始Y + 叉位置, 子主轴尺寸, 子叉轴尺寸)
            主轴总长 = 主轴总长 + 子外边距主前 + 子主轴尺寸 + 子外边距主后
            设 叉总 = 子外边距叉前 + 子叉轴尺寸 + 子外边距叉后
            若 叉总 > 叉轴最大 { 叉轴最大 = 叉总 }
        } 否 {
            计算布局(子, 节点["_布x"] + 始X + 叉位置, 节点["_布y"] + 始Y + 主轴位置, 子叉轴尺寸, 子主轴尺寸)
            主轴总长 = 主轴总长 + 子外边距主前 + 子主轴尺寸 + 子外边距主后
            设 叉总 = 子外边距叉前 + 子叉轴尺寸 + 子外边距叉后
            若 叉总 > 叉轴最大 { 叉轴最大 = 叉总 }
        }

        主轴位置 = 主轴位置 + 子主轴尺寸 + 子外边距主后 + 间距 + 间隙额外
    }

    主轴总长 = 主轴总长 + 间距总和
    设 内距 = 节点["_内边距"]

    若 是横向 {
        节点["_布w"] = 主轴总长 + 内距["左"] + 内距["右"]
        节点["_布h"] = 叉轴最大 + 内距["上"] + 内距["下"]
        若 节点["_宽"] > 0 { 节点["_布w"] = 节点["_宽"] }
        若 节点["_高"] > 0 { 节点["_布h"] = 节点["_高"] }
    } 否 {
        节点["_布w"] = 叉轴最大 + 内距["左"] + 内距["右"]
        节点["_布h"] = 主轴总长 + 内距["上"] + 内距["下"]
        若 节点["_宽"] > 0 { 节点["_布w"] = 节点["_宽"] }
        若 节点["_高"] > 0 { 节点["_布h"] = 节点["_高"] }
    }
}

函 布叠(节点, px, py, 可用宽, 可用高) {
    遍历 子 于 节点["_子"] {
        若 非 子["_可视"] { 续 }
        设 子宽 = 可用宽 ; 设 子高 = 可用高
        若 子["_宽"] > 0 { 子宽 = 子["_宽"] }
        若 子["_高"] > 0 { 子高 = 子["_高"] }
        计算布局(子, 节点["_布x"] + px, 节点["_布y"] + py, 子宽, 子高)
    }
    设 内距 = 节点["_内边距"]
    节点["_布w"] = 可用宽 + 内距["左"] + 内距["右"]
    节点["_布h"] = 可用高 + 内距["上"] + 内距["下"]
    若 节点["_宽"] > 0 { 节点["_布w"] = 节点["_宽"] }
    若 节点["_高"] > 0 { 节点["_布h"] = 节点["_高"] }
}

// ============================================================
// 渲染
// ============================================================
// 圆角像素→raylib 圆角百分比(0-100,相对 min(宽,高)/2 半径)
函 _圆角百分(节点) {
    设 角 = 节点["_圆角"]
    若 角 <= 0 { 返 0 }
    设 w = 节点["_布w"] ; 设 h = 节点["_布h"]
    设 m = w
    若 h < m { m = h }
    若 m <= 0 { 返 0 }
    设 pct = 角 * 200 / m
    若 pct > 100 { pct = 100 }
    返 pct
}

// 左键持续按住状态(按压态联动;由 应用/刷新 帧循环在处理悬浮前更新)
设 _左键按住 = 假
// 上一帧的按住状态(按下沿/松开沿检测用)
设 _左键上帧 = 假
// 按压源记录(跨帧记忆):声明式树每帧重建,节点上的 _待击/_按住起 活不过一帧——
// 改为全局按压键(节点身份串:坐标+宽+文本),按下沿记录、松开沿比对
设 _按压键 = ""
设 _按住起 = 0
设 _按住末次 = 0
设 _已连发 = 假

公 函 渲染(节点) {
    若 非 节点["_可视"] { 返 空 }

    设 x = 节点["_布x"] ; 设 y = 节点["_布y"]
    设 w = 节点["_布w"] ; 设 h = 节点["_布h"]
    设 景 = 节点["_底色"]

    若 景["a"] > 0 {
        设 _rp = _圆角百分(节点)
        若 _rp > 0 {
            R.绘圆角矩形(x, y, w, h, _rp, 景["r"], 景["g"], 景["b"], 景["a"])
        } 否 {
            R.绘矩形(x, y, w, h, 景["r"], 景["g"], 景["b"], 景["a"])
        }
    }

    设 框色 = 节点["_边框色"] ; 设 框宽 = 节点["_边框宽"]
    若 框宽 > 0 且 框色["a"] > 0 {
        设 _rp2 = _圆角百分(节点)
        若 _rp2 > 0 {
            R.绘圆角矩形线(x, y, w, h, _rp2, 框宽, 框色["r"], 框色["g"], 框色["b"], 框色["a"])
        } 否 {
            R.绘矩形线(x, y, w, h, 框色["r"], 框色["g"], 框色["b"], 框色["a"])
        }
    }

    设 类型 = 节点["_类型"]
    设 字色 = 节点["_字色"]

    若 类型 == "文本" {
        若 _字体 != 0 {
            R.绘字体文字(_字体, 节点["_文本"], x, y, 节点["_字号"], 1, 字色["r"], 字色["g"], 字色["b"], 字色["a"])
        } 否 {
            R.绘文字(节点["_文本"], x, y, 节点["_字号"], 字色["r"], 字色["g"], 字色["b"], 字色["a"])
        }
    }
    抑 类型 == "按钮" {
        设 bg = 景
        若 节点["_悬浮"] 且 节点["_悬底色"]["a"] > 0 { bg = 节点["_悬底色"] }
        若 节点["_按下"] 且 节点["_按底色"]["a"] > 0 { bg = 节点["_按底色"] }
        若 节点["_禁用"] 且 节点["_禁底色"]["a"] > 0 { bg = 节点["_禁底色"] }
        设 _rpb = _圆角百分(节点)
        若 _rpb > 0 {
            R.绘圆角矩形(x, y, w, h, _rpb, bg["r"], bg["g"], bg["b"], bg["a"])
        } 否 {
            R.绘矩形(x, y, w, h, bg["r"], bg["g"], bg["b"], bg["a"])
        }
        设 内距 = 节点["_内边距"]
        设 文本宽 = 量文本宽(节点["_文本"], 节点["_字号"])
        设 tx = x + (w - 文本宽) / 2 + 内距["左"]
        设 ty = y + 内距["上"]
        // 文字三态:按下>悬浮>常态(默认透明=不覆盖,沿用常态字色)
        设 字色选 = 字色
        若 节点["_悬浮"] 且 节点["_悬字色"]["a"] > 0 { 字色选 = 节点["_悬字色"] }
        若 节点["_按下"] 且 节点["_按字色"]["a"] > 0 { 字色选 = 节点["_按字色"] }
        若 节点["_禁用"] 且 节点["_禁字色"]["a"] > 0 { 字色选 = 节点["_禁字色"] }
        若 _字体 != 0 {
            R.绘字体文字(_字体, 节点["_文本"], tx, ty, 节点["_字号"], 1, 字色选["r"], 字色选["g"], 字色选["b"], 字色选["a"])
        } 否 {
            R.绘文字(节点["_文本"], tx, ty, 节点["_字号"], 字色选["r"], 字色选["g"], 字色选["b"], 字色选["a"])
        }
    }
    抑 类型 == "矩形" {
        R.绘矩形(x, y, w, h, 字色["r"], 字色["g"], 字色["b"], 字色["a"])
    }
    抑 类型 == "行" 或 类型 == "列" 或 类型 == "叠" {
        遍历 子 于 节点["_子"] { 渲染(子) }
    }
}

// ============================================================
// 输入事件
// ============================================================
公 函 处理悬浮(节点, 鼠x, 鼠y) {
    若 非 节点["_可视"] { 返 假 }
    设 在内部 = 鼠x >= 节点["_布x"] 且 鼠x < 节点["_布x"] + 节点["_布w"]
                且 鼠y >= 节点["_布y"] 且 鼠y < 节点["_布y"] + 节点["_布h"]
    若 节点["_禁用"] {
        // 禁用态不吃任何交互(悬浮/按下恒假)
        节点["_悬浮"] = 假
        节点["_按下"] = 假
    } 否 {
        节点["_悬浮"] = 在内部
        节点["_按下"] = 在内部 且 _左键按住
    }
    若 节点["_子"].长度 > 0 {
        遍历 子 于 节点["_子"] { 处理悬浮(子, 鼠x, 鼠y) }
    }
    返 在内部
}

公 函 处理点击(节点, 鼠x, 鼠y) {
    若 非 节点["_可视"] { 返 空 }
    设 在内部 = 鼠x >= 节点["_布x"] 且 鼠x < 节点["_布x"] + 节点["_布w"]
                且 鼠y >= 节点["_布y"] 且 鼠y < 节点["_布y"] + 节点["_布h"]

    // 先递归子节点(倒序,上层优先)
    设 k = 节点["_子"].长度 - 1
    当 k >= 0 {
        设 点中 = 处理点击(节点["_子"][k], 鼠x, 鼠y)
        若 点中 != 空 { 返 点中 }
        k = k - 1
    }

    若 节点["_点击"] != 空 且 非 节点["_禁用"] {
        设 模式 = 节点["_触发"]
        设 按下沿 = _左键按住 且 非 _左键上帧
        设 松开沿 = (非 _左键按住) 且 _左键上帧
        // 节点身份串(跨帧识别:树每帧重建,靠坐标+宽+文本认回同一个按钮)
        设 身份 = 节点["_布x"] & "," & 节点["_布y"] & "," & 节点["_布w"] & "," & 节点["_文本"]
        若 模式 == "按下" {
            // 按下即发(旧「点击」行为)
            若 按下沿 且 在内部 { 节点["_点击"]()  返 节点 }
        } 抑 模式 == "按住" {
            // 按住连发:默认按下即发;设了「首按延迟」则按住超过该时长才开始按「连发间隔」连发
            若 按下沿 且 在内部 {
                _按压键 = 身份
                _按住起 = 时.毫秒()
                _按住末次 = 时.毫秒()
                若 节点["_首按延迟"] == 0 { 节点["_点击"]() }
            }
            若 _按压键 == 身份 且 _左键按住 且 在内部 {
                设 现 = 时.毫秒()
                若 现 - _按住起 >= 节点["_首按延迟"] 且 现 - _按住末次 >= 节点["_连发间隔"] {
                    节点["_点击"]()
                    _按住末次 = 现
                }
            }
            若 松开沿 或 非 _左键按住 {
                若 _按压键 == 身份 { _按压键 = "" }
            }
        } 否 {
            // 点击(默认,语义修正):按下在内部记录按压源,松开也在内部才触发;
            // 设了「首按延迟」则按住超时时进入连发(此时松开不再补单击)——单击/长按连发两用按钮
            若 按下沿 且 在内部 {
                _按压键 = 身份
                _按住起 = 时.毫秒()
                _按住末次 = 时.毫秒()
                _已连发 = 假
            }
            若 节点["_首按延迟"] > 0 且 _按压键 == 身份 且 _左键按住 且 在内部 {
                设 现长 = 时.毫秒()
                若 现长 - _按住起 >= 节点["_首按延迟"] 且 现长 - _按住末次 >= 节点["_连发间隔"] {
                    节点["_点击"]()
                    _按住末次 = 现长
                    _已连发 = 真
                }
            }
            若 松开沿 {
                若 _按压键 == 身份 且 在内部 且 非 _已连发 { 节点["_点击"]() }
                若 _按压键 == 身份 { _按压键 = "" }
            }
        }
    }
    返 空
}

// ============================================================
// 响应式状态系统 — View = f(State)
// ============================================================
// 全局渲染上下文栈（支持嵌套组件）
设 _渲染栈 = []

// 当前字体句柄（0 = raylib 默认字体，不支持中文）
// 由 应用/手动设字体 设置，渲染() 的文本与按钮绘制据此选择 绘字体文字/绘文字
设 _字体 = 0

// 设置全局字体（返回旧句柄）。路径为运行时相对/绝对 TTF 路径，字库字号越大越清晰(默认32)
// 注意:必须在窗口初始化之后调用(raylib 加载字形纹理需要 GL 上下文);
// 字体在程序退出前应通过 释字体 释放;应用() 会自动管理
公 函 设字体(路径, 字库字号) {
    设 旧 = _字体
    若 路径 == 空 或 路径 == "" {
        _字体 = 0
    } 否 {
        设 库号 = 32
        若 字库字号 != 空 { 库号 = 字库字号 }
        _字体 = R.加载字体(路径, 库号)
    }
    返 旧
}

// ============================================================
// 默认字体(内置鸿蒙字体:零配置中文显示,v0.19.0 起)
// ============================================================
设 _字体已尝试 = 假

// 取环境变量值(走 runtime 宽字符 API,免 cmd 子进程——cmd echo 会闪黑色终端窗口且慢)
函 _环境值(名) {
    返 xt_env_get(名)
}

// 按候选路径查找内置鸿蒙字体,返回命中路径或 ""
函 _找默认字体() {
    设 名 = "HarmonyOS_Sans_SC_Regular.ttf"
    设 候选 = []
    // ① 铁铺已安装 UI 包内
    设 home = _环境值("TIEPM_HOME")
    若 home != "" {
        候选.追加(home & "\\已安装\\UI\\assets\\" & 名)
    } 否 {
        设 up = _环境值("USERPROFILE")
        若 up != "" { 候选.追加(up & "\\.tiepm\\已安装\\UI\\assets\\" & 名) }
    }
    // ② 程序自身目录(exeDir\assets,发行包布局)
    设 自径 = xt_self_path()
    若 自径 != "" {
        设 i = 自径.字节数 - 1
        当 i >= 0 {
            设 c = 自径.截取(i, i + 1)
            若 c == "\\" 或 c == "/" {
                候选.追加(自径.截取(0, i + 1) & "assets\\" & 名)
                断
            }
            i = i - 1
        }
    }
    // ③ CWD 常见布局(项目根/子目录/仓库 lib)
    候选.追加("assets\\" & 名)
    候选.追加("..\\assets\\" & 名)
    候选.追加("lib\\UI\\assets\\" & 名)
    遍历 p 于 候选 {
        若 文件.存在?(p) { 返 p }
    }
    返 ""
}

// 确保默认字体已加载(窗口初始化后调用;用户显式 设字体/选项字体 优先,不覆盖)
// 全未命中则回退 raylib 默认字体并提示一次(不中断)
公 函 确保默认字体() {
    若 _字体 != 0 或 _字体已尝试 { 返 空 }
    _字体已尝试 = 真
    设 路径 = _找默认字体()
    若 路径 != "" {
        _字体 = R.加载字体(路径, 32)
    }
    若 _字体 == 0 {
        示("[UI] 提示: 未找到内置鸿蒙字体,中文将显示为方块;请 tiepm install UI 或将 assets 放到程序旁")
    }
}

// 创建响应式状态容器
公 函 造状态(初始数据) {
    设 容器 = {}
    容器["_值"] = 初始数据
    容器["_监听"] = {}
    容器["_脏"] = 假
    容器["_依赖"] = {}
    返 容器
}

// 读取状态（渲染期内自动追踪依赖）
公 函 态取(状态, 键) {
    若 状态 == 空 { 返 空 }
    若 _渲染栈.长度 > 0 {
        设 上下文 = _渲染栈[_渲染栈.长度 - 1]
        上下文["_依赖"][键] = 真
    }
    若 状态["_值"].含?(键) { 返 状态["_值"][键] }
    返 空
}

// 设置状态（变化时通知订阅者）
公 函 态设(状态, 键, 新值) {
    若 状态 == 空 { 返 空 }
    设 旧值 = 空
    若 状态["_值"].含?(键) { 旧值 = 状态["_值"][键] }
    若 旧值 == 新值 { 返 空 }
    状态["_值"][键] = 新值
    若 状态["_监听"].含?(键) {
        遍历 cb 于 状态["_监听"][键] {
            若 cb != 空 { cb() }
        }
    }
    状态["_脏"] = 真
}

// 订阅状态变化
公 函 态观(状态, 键, 回调) {
    若 状态 == 空 { 返 空 }
    若 非 状态["_监听"].含?(键) { 状态["_监听"][键] = [] }
    状态["_监听"][键].追加(回调)
}

// 批量设置
公 函 态设批(状态, 变更表) {
    若 状态 == 空 { 返 空 }
    遍历 键 于 变更表 { 态设(状态, 键, 变更表[键]) }
}

// 状态快照（不追踪依赖）
公 函 态快照(状态) {
    若 状态 == 空 { 返 {} }
    返 状态["_值"]
}

// 检查是否脏
公 函 态脏?(状态) {
    若 状态 == 空 { 返 假 }
    返 状态["_脏"]
}

// 标记脏
公 函 标脏(状态) {
    若 状态 == 空 { 返 空 }
    状态["_脏"] = 真
}

// 获取依赖键列表
公 函 态依赖(状态) {
    若 状态 == 空 { 返 [] }
    设 键列表 = []
    遍历 键 于 状态["_依赖"] { 键列表.追加(键) }
    返 键列表
}

// 清除所有订阅
公 函 态清除(状态) {
    若 状态 == 空 { 返 空 }
    状态["_监听"] = {} ; 状态["_依赖"] = {} ; 状态["_脏"] = 假
}

// 进入渲染上下文
函 _进上下文(状态) {
    设 上下文 = {}
    上下文["_依赖"] = {}
    _渲染栈.追加(上下文)
    状态["_依赖"] = {}
    状态["_脏"] = 假
    返 上下文
}

// 退出渲染上下文
函 _退上下文() {
    若 _渲染栈.长度 > 0 {
        设 新栈 = []
        设 i = 0
        当 i < _渲染栈.长度 - 1 {
            新栈.追加(_渲染栈[i])
            i = i + 1
        }
        _渲染栈 = 新栈
    }
}

// 应用框架：状态变化时自动重绘
// 构建函(状态) → 返回控件树根节点
// 选项: {"宽":800, "高":600, "标题":"App"}
公 函 应用(状态, 构建函, 选项) {
    若 状态 == 空 或 构建函 == 空 { 返 空 }

    设 宽 = 800 ; 设 高 = 600 ; 设 标题 = "XuanTie App"
    若 选项 != 空 {
        若 选项.含?("宽") { 宽 = 选项["宽"] }
        若 选项.含?("高") { 高 = 选项["高"] }
        若 选项.含?("标题") { 标题 = 选项["标题"] }
    }

    // 字体:选项["字体"] 传 TTF 路径即启用中文字体(自动加载/卸载);
    // 选项["字库字号"] 可指定栅格化字号(默认32,越大越清晰、纹理越大)
    R.初始化窗口(宽, 高, 标题)

    // 先出一帧背景:字体栅格化(内置2万汉字形)需1~2秒,避免窗口纯白无响应感
    R.开始绘图()
    R.清背景(40, 40, 50, 255)
    R.结束绘图()

    若 选项 != 空 且 选项.含?("字体") {
        设 字库号 = 32
        若 选项.含?("字库字号") { 字库号 = 选项["字库字号"] }
        _字体 = R.加载字体(选项["字体"], 字库号)
    } 否 {
        // 用户未指定字体:自动加载内置鸿蒙字体(零配置中文显示)
        确保默认字体()
    }

    当 非 R.窗口应关闭() {
        设 鼠x = R.鼠X() ; 设 鼠y = R.鼠Y()
        设 左键 = R.鼠刚按?(0)
        _左键按住 = R.鼠按下?(0) == 1

        _进上下文(状态)
        设 根节点 = 构建函(状态)
        _退上下文()

        R.开始绘图()
        R.清背景(40, 40, 50, 255)

        计算布局(根节点, 0, 0, 宽, 高)
        处理悬浮(根节点, 鼠x, 鼠y)
        // 处理点击改每帧调用(点击/按住模式需检测松开沿与持续时长)
        处理点击(根节点, 鼠x, 鼠y)
        _左键上帧 = _左键按住
        渲染(根节点)

        R.结束绘图()
    }

    R.关闭窗口()

    // 卸载应用期加载的字体,恢复默认字体
    若 _字体 != 0 {
        R.释字体(_字体)
        _字体 = 0
    }
}

// 手动刷新（嵌入自定义渲染循环）
公 函 刷新(状态, 构建函, x, y, 宽, 高) {
    若 状态 == 空 { 返 空 }

    // 手动模式同样享受默认字体(首次调用时幂等尝试;窗口需已由调用方初始化)
    确保默认字体()

    _进上下文(状态)
    设 根节点 = 构建函(状态)
    _退上下文()

    计算布局(根节点, x, y, 宽, 高)

    设 鼠x = R.鼠X() ; 设 鼠y = R.鼠Y()
    _左键按住 = R.鼠按下?(0) == 1
    处理悬浮(根节点, 鼠x, 鼠y)
    处理点击(根节点, 鼠x, 鼠y)
    _左键上帧 = _左键按住

    渲染(根节点)
    返 根节点
}
