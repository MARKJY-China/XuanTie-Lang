// UI.xt — 玄铁声明式 UI 框架 v1.5.1
// FlexBox 布局引擎 + 基础控件集 + 响应式状态管理
// 依赖: lib/渲染 (raylib-based)
//
// 用法:
//   引 "UI" 予 UI
//   引 "渲染" 予 R
//
//   // 创建响应式状态
//   设 状态 = UI.造状态({"计数":0, "标题":"Hello"})
//
//   // 构建界面
//   设 界面 = UI.列([UI.文本(UI.态取(状态, "标题")), UI.按钮("+1")])
//
//   // 应用框架（自动渲染循环）
//   UI.应用(状态, 函(s) { 返 UI.列([...]) }, {"宽":800, "高":600})

引 "渲染" 予 R

外 函 xt_self_path(): 字
外 函 xt_env_get(名: 字): 字
// 非阻塞单步泵:驱动 fiber 跑一拍(主线程进 UI 主循环后 scheduler_run 永不被调用,
// 不泵 fiber 会整体饿死);每个轮询周期/帧调用,已在驱动时自动空返
外 函 xt_scheduler_step(): 空

// ============================================================
// 常量
// ============================================================
公 常 横向 = "横向"
公 常 纵向 = "纵向"
公 常 对齐始 = "始"
公 常 对齐中 = "中"
公 常 对齐末 = "末"
公 常 对齐间 = "间"
公 常 对齐均 = "均"
公 常 对齐均等 = "均等"
公 常 叉始 = "叉始"
公 常 叉中 = "叉中"
公 常 叉末 = "叉末"
公 常 叉撑 = "叉撑"

// ============================================================
// 辅助: 四边距
// ============================================================
公 函 四边(上, 右, 下, 左) {
    设 边 = {}
    边["上"] = 上 ; 边["右"] = 右 ; 边["下"] = 下 ; 边["左"] = 左
    返 边
}
公 函 全边(值) {
    返 四边(值, 值, 值, 值)
}

// ============================================================
// 色板
// ============================================================
公 函 色(r, g, b, a) {
    若 a == 空 { a = 255 }
    设 c = {} ; c["r"] = r ; c["g"] = g ; c["b"] = b ; c["a"] = a
    返 c
}

// 两位十六进制字符 → 0-255
函 _hex2(双字符) {
    设 v = 0
    设 i = 0
    当 i < 双字符.字节数 {
        设 c = 双字符.截取(i, i + 1)
        设 d = 0
        若 c == "0" { d = 0 } 抑 c == "1" { d = 1 } 抑 c == "2" { d = 2 }
        抑 c == "3" { d = 3 } 抑 c == "4" { d = 4 } 抑 c == "5" { d = 5 }
        抑 c == "6" { d = 6 } 抑 c == "7" { d = 7 } 抑 c == "8" { d = 8 }
        抑 c == "9" { d = 9 } 抑 c == "a" 或 c == "A" { d = 10 }
        抑 c == "b" 或 c == "B" { d = 11 } 抑 c == "c" 或 c == "C" { d = 12 }
        抑 c == "d" 或 c == "D" { d = 13 } 抑 c == "e" 或 c == "E" { d = 14 }
        抑 c == "f" 或 c == "F" { d = 15 }
        v = v * 16 + d
        i = i + 1
    }
    返 v
}

// 十六进制颜色:"#RRGGBB" / "RRGGBB" / "#RRGGBBAA"(# 前缀可选,8位末两码为透明度)
// 例: 色16("#3B82F6")  色16("FF0000")  色16("#3B82F680")
// 非法输入(长度不足/含非hex字符)返回品红(255,0,255)——图形界面惯例的错误示警色
公 函 色16(文本) {
    设 s = 文本
    若 s.截取(0, 1) == "#" { s = s.截取(1, s.字节数) }
    若 s.字节数 < 6 { 返 色(255, 0, 255, 255) }
    设 r = _hex2(s.截取(0, 2))
    设 g = _hex2(s.截取(2, 4))
    设 b = _hex2(s.截取(4, 6))
    设 a = 255
    若 s.字节数 >= 8 { a = _hex2(s.截取(6, 8)) }
    返 色(r, g, b, a)
}

公 常 色彩 = {}
色彩["白"] = 色(255, 255, 255, 255)
色彩["黑"] = 色(0, 0, 0, 255)
色彩["红"] = 色(255, 80, 80, 255)
色彩["绿"] = 色(80, 220, 80, 255)
色彩["蓝"] = 色(80, 120, 255, 255)
色彩["黄"] = 色(255, 220, 60, 255)
色彩["灰"] = 色(140, 140, 140, 255)
色彩["深灰"] = 色(50, 50, 50, 255)
色彩["浅灰"] = 色(220, 220, 220, 255)
色彩["透明"] = 色(0, 0, 0, 0)
色彩["主题"] = 色(70, 130, 220, 255)
色彩["强调"] = 色(255, 140, 40, 255)

// ============================================================
// 组件动画(贝塞尔缓动,声明式)
// ============================================================
// 用法:
//   UI.造动画("面板x", {"时长": 300, "曲线": "丝滑"})   // 注册(幂等;可反复调改配置)
//   UI.矩形({"x": UI.动值("面板x", 目标x), ...})        // 目标值变化当帧起,从当前值平滑补间
// 数值与颜色(r/g/b/a 字典)皆可动画;键全局唯一(建议带模块前缀,如 "设置.x")。

// 缓动曲线预设(cubic-bezier 控制点,定点整数 ×10000);官方组件内建动效一律用「丝滑」
// 实现选型:定点整数而非浮点——60fps 下像素/通道本就是离散量,定点零依赖且全程确定性。
公 常 曲线 = {}
曲线["线性"] = [0, 0, 10000, 10000]
曲线["丝滑"] = [4200, 0, 5800, 10000]
曲线["缓入"] = [4200, 0, 10000, 10000]
曲线["缓出"] = [0, 0, 5800, 10000]
曲线["回弹"] = [3400, 15600, 6400, 10000]

设 _动画态 = {}
设 _动S = 10000   // 定点比例尺
// 内建动效的组件身份计数(每帧渲染前重置;按遍历序编号,树形稳定则身份稳定)
设 _动画序 = 0

// ---- 滚动容器状态(侧表;身份=布局遍历序,每帧布局前重置) ----
设 _滚动态 = {}
设 _滚序 = 0

// 帧号(双挂守卫用):每个帧循环入口 +1;节点布局时盖戳,同帧二次布局即双挂
设 _帧号 = 0

// ---- 按需重绘(帧级) ----
// _轮增量:滚轮累计——轮询周期逐次读入,帧处理统一消费(防跨周期丢滚轮/重复消费)
// _首帧毕:首帧强制全量;_上鼠x/_上鼠y/_上左键:输入快照(增量即脏)
设 _轮增量 = 0
设 _首帧毕 = 假
// 上一周期是否画了帧(单泵纪律用:画了帧→本周期帧首不补泵,防双泵清队列)
设 _上帧画了 = 假
设 _上鼠x = -1 ; 设 _上鼠y = -1
设 _上左键 = 假
函 _滚态取(键) {
    若 非 _滚动态.含?(键) {
        _滚动态[键] = {"目标": 0, "滚动量": 0, "内容高": 0, "视高": 0, "拖动中": 假, "拖动起y": 0, "拖动起目标": 0}
    }
    返 _滚动态[键]
}

// 定点乘:a、b 均为 ×_动S 定点数,返 (a×b)/_动S(值域 ≤ 2 倍尺,i64 不出界)
函 _动乘(a, b) {
    返 a * b / _动S
}

// cubic-bezier 求值(定点):预设曲线 x 对 u 单调,二分法 20 次迭代解 u 使 x(u)=t,返 y(u);
// 回弹曲线 y 可达 1.56 倍尺(过冲即弹性),合法
函 _贝兹(cx1, cy1, cx2, cy2, t) {
    设 lo = 0
    设 hi = _动S
    设 u = t
    设 i = 0
    当 i < 20 {
        设 减 = _动S - u
        设 x = 3 * _动乘(_动乘(减, 减), _动乘(u, cx1)) + 3 * _动乘(_动乘(减, u), _动乘(u, cx2)) + _动乘(_动乘(u, u), u)
        若 x < t { lo = u } 否 { hi = u }
        u = (lo + hi) / 2
        i = i + 1
    }
    设 减u = _动S - u
    返 3 * _动乘(_动乘(减u, 减u), _动乘(u, cy1)) + 3 * _动乘(_动乘(减u, u), _动乘(u, cy2)) + _动乘(_动乘(u, u), u)
}

函 _值相等(a, b) {
    设 a字 = 假
    设 b字 = 假
    匹配 a { 是 字典 -> { a字 = 真 }  _ -> { a字 = 假 } }
    匹配 b { 是 字典 -> { b字 = 真 }  _ -> { b字 = 假 } }
    若 a字 且 b字 {
        返 a["r"] == b["r"] 且 a["g"] == b["g"] 且 a["b"] == b["b"] 且 a["a"] == b["a"]
    }
    若 a字 或 b字 { 返 假 }
    返 a == b
}

// 通道插值(带符号安全的四舍五入)
函 _插值通道(起, 目, 映) {
    设 积 = (目 - 起) * 映
    若 积 >= 0 { 返 起 + (积 + _动S / 2) / _动S }
    返 起 + (积 - _动S / 2) / _动S
}

函 _插值(起, 目, 映) {
    设 目字 = 假
    匹配 目 { 是 字典 -> { 目字 = 真 }  _ -> { 目字 = 假 } }
    若 目字 {
        返 {"r": _插值通道(起["r"], 目["r"], 映), "g": _插值通道(起["g"], 目["g"], 映),
            "b": _插值通道(起["b"], 目["b"], 映), "a": _插值通道(起["a"], 目["a"], 映)}
    }
    返 _插值通道(起, 目, 映)
}

函 _动显值(项) {
    设 时长 = 项["时长"]
    若 时长 <= 0 { 返 项["目标"] }
    设 进度 = (时.毫秒() - 项["起时"]) * _动S / 时长
    若 进度 >= _动S { 返 项["目标"] }
    若 进度 <= 0 { 返 项["起值"] }
    设 名 = 项["曲线"]
    设 c = 曲线["丝滑"]
    若 曲线.含?(名) { c = 曲线[名] }
    设 映 = _贝兹(c[0], c[1], c[2], c[3], 进度)
    返 _插值(项["起值"], 项["目标"], 映)
}

公 函 造动画(键, 选项) {
    若 非 _动画态.含?(键) {
        _动画态[键] = {"时长": 250, "曲线": "丝滑", "有值": 假, "起值": 0, "目标": 0, "起时": 0}
    }
    设 项 = _动画态[键]
    若 选项 != 空 {
        若 选项.含?("时长") { 项["时长"] = 选项["时长"] }
        若 选项.含?("曲线") { 项["曲线"] = 选项["曲线"] }
    }
}

// 每帧调用:目标值未变 → 返回当前插值;目标值变了 → 从当前显示值起播到新目标。
// 首帧不播(直接钉在目标);时长=0 即关闭动画(立即到位)
公 函 动值(键, 目标) {
    若 非 _动画态.含?(键) { 造动画(键, 空) }
    设 项 = _动画态[键]
    若 非 项["有值"] {
        项["有值"] = 真
        项["起值"] = 目标
        项["目标"] = 目标
        项["起时"] = 时.毫秒()
        返 目标
    }
    若 非 _值相等(项["目标"], 目标) {
        项["起值"] = _动显值(项)
        项["目标"] = 目标
        项["起时"] = 时.毫秒()
    }
    返 _动显值(项)
}

// 有进行中的补间(按钮微交互/滚动丝滑/用户 动值)则为脏——按需重绘的脏源之一
函 _动画活跃?() {
    遍历 键 于 _动画态 {
        设 项 = _动画态[键]
        若 项["有值"] 且 项["时长"] > 0 且 时.毫秒() - 项["起时"] < 项["时长"] { 返 真 }
    }
    返 假
}

// ============================================================
// 核心: 控件节点工厂
// ============================================================
函 造节点(类型) {
    设 n = {}
    n["_类型"] = 类型
    n["_子"] = []
    n["_宽"] = 0 ; n["_高"] = 0
    n["_弹"] = 0 ; n["_缩"] = 1
    n["_主轴对齐"] = 对齐始
    n["_叉轴对齐"] = 叉撑
    n["_间距"] = 0
    n["_内边距"] = 全边(0)
    n["_外边距"] = 全边(0)
    n["_布x"] = 0 ; n["_布y"] = 0 ; n["_布w"] = 0 ; n["_布h"] = 0
    n["_布帧"] = -1
    n["_x"] = 0 ; n["_y"] = 0
    n["_文本"] = ""
    n["_字号"] = 16
    n["_字色"] = 色彩["白"]
    n["_底色"] = 色彩["透明"]
    n["_圆角"] = 0
    n["_边框色"] = 色彩["透明"]
    n["_边框宽"] = 0
    n["_悬底色"] = 色彩["透明"]
    n["_按底色"] = 色彩["透明"]
    n["_悬字色"] = 色彩["透明"]
    n["_按字色"] = 色彩["透明"]
    n["_禁底色"] = 色彩["透明"]
    n["_禁字色"] = 色彩["透明"]
    // 状态边色(按钮等:悬浮/按下/禁用时的边框色)
    n["_悬边色"] = 色彩["透明"]
    n["_按边色"] = 色彩["透明"]
    n["_禁边色"] = 色彩["透明"]
    // 按钮微交互:悬浮上浮像素(0=关)/按下缩放百分(100=关,松开回弹)
    n["_悬浮上浮"] = 2
    n["_按下缩放"] = 95
    n["_禁用"] = 假
    n["_行号"] = 真
    // 通用状态覆写(v1.5.0):悬浮/按下/禁用 子字典原样保留,消费点经 _态键布/_态键渲 解析;
    // _有覆=带覆写(布局期悬浮身份登记只盯这些节点)
    n["_悬覆"] = {}
    n["_按覆"] = {}
    n["_禁覆"] = {}
    n["_有覆"] = 假
    n["_不透明度"] = 100
    n["_源"] = ""
    n["_图标色"] = 色彩["白"]
    // 裁剪:容器级子树裁剪(超出节点边界即裁,视口外不响应交互)
    n["_裁剪"] = 假
    // 平移(像素,可负):渲染与命中间步偏移,不影响兄弟布局(CSS transform 语义;动值 可驱动)
    n["_平移x"] = 0
    n["_平移y"] = 0
    // 锚点(Godot 风):{"左":比,"上":比,"右":比,"下":比}(0~1,可缺省),偏={"左":px,...} 像素偏移;
    // 空=不启用(走父容器常规排布)。双锚=拉伸,单锚=定点+固有/选项尺寸(前向/后向/居中按比值)
    n["_锚"] = 空
    n["_偏"] = 空
    // 通用外观(v1.2.0):阴影/渐变/羽化/字距(各组件共用,输入栏首批接入)
    n["_影色"] = 色彩["透明"]
    n["_影糊"] = 8
    n["_影x"] = 0
    n["_影y"] = 2
    n["_底色2"] = 色彩["透明"]
    n["_渐变向"] = "竖"
    n["_羽化"] = 1
    n["_字距"] = 1
    n["_触发"] = "点击"
    n["_连发间隔"] = 50
    n["_首按延迟"] = 0
    n["_待击"] = 假
    n["_按住起"] = 0
    n["_点击"] = 空
    n["_悬浮"] = 假
    n["_按下"] = 假
    n["_可视"] = 真
    返 n
}

// ============================================================
// 控件构造函数
// ============================================================
公 函 行(子列表, 选项) {
    设 节点 = 造节点("行")
    节点["_子"] = 子列表
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 列(子列表, 选项) {
    设 节点 = 造节点("列")
    节点["_子"] = 子列表
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 叠(子列表, 选项) {
    设 节点 = 造节点("叠")
    节点["_子"] = 子列表
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

// 绝对布局容器:子节点按选项 {"x":..,"y":..} 直接摆放(相对容器左上角),跳过 flex 计算
公 函 绝对(子列表, 选项) {
    设 节点 = 造节点("绝对")
    节点["_子"] = 子列表
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

// 滚动容器:子节点按列排布,内容超高时滚轮滚动/滚动条拖拽(丝滑补间),可视区裁剪
// 选项:高(视口高,不设则吃布局可用高)/滚动条(默认真,不溢出自动隐藏)/条宽/轨道色/拇指色/拇指拖色 + 通用键
公 函 滚动容器(子列表, 选项) {
    设 节点 = 造节点("滚动容器")
    节点["_子"] = 子列表
    节点["_滚动条"] = 真
    节点["_条宽"] = 6
    节点["_轨道色"] = 色(255, 255, 255, 16)
    节点["_拇指色"] = 色(255, 255, 255, 90)
    节点["_拇指拖色"] = 色(255, 255, 255, 150)
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 文本(内容, 选项) {
    设 节点 = 造节点("文本")
    节点["_文本"] = 内容
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 矩形(选项) {
    设 节点 = 造节点("矩形")
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

// 图片:显示一张图片(png/jpg/bmp/gif/svg);固有尺寸取纹理原尺寸
// 选项:宽/高(默认纹理原尺寸)/图标色(tint)/不透明度/点击(点了就能按) + 状态覆写(悬/按/禁可换 源/宽高/色) + 通用键
公 函 图片(源, 选项) {
    设 节点 = 造节点("图片")
    节点["_源"] = 源
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 按钮(标签, 选项) {
    设 节点 = 造节点("按钮")
    节点["_文本"] = 标签
    节点["_底色"] = 色彩["主题"]
    // 默认三态主题(v0.19.0 美化):圆角8px + 悬浮明显亮 + 按下明显暗;选项可覆盖
    // 注:鼠标桥接返回 1/0 整数,_左键按住 已归一为布尔(且 对整数1判假,实测按下态曾因此失效)
    节点["_圆角"] = 8
    节点["_悬底色"] = 色(115, 175, 250, 255)
    节点["_按底色"] = 色(40, 90, 170, 255)
    节点["_禁底色"] = 色(90, 90, 95, 255)
    节点["_禁字色"] = 色(150, 150, 150, 255)
    节点["_内边距"] = 全边(8)
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

// 输入栏(文本输入框,v1.1.0 起):值经 状态[键] 读写;光标/偏移/焦点存全局 _输入栏态。
// 选项:占位/占位色/字号/字距/宽/高/底色/底色2/渐变向/羽化/阴影/字色/框色/边框宽/焦框色/焦框宽/圆角/内边距/只读/提交(回车回调)
//      左图标/右图标(图片路径,png/jpg/svg)/图标尺寸(0=自动)/图标距/图标色/右图标点击
// 交互:点击获焦(并按点击处定位光标)、字符输入(含中文 IME 上屏)、退格、左右方向键、回车提交、ESC/点外失焦
公 函 输入栏(状态, 键, 选项) {
    设 节点 = 造节点("输入栏")
    节点["_状态"] = 状态
    节点["_栏键"] = 键
    节点["_占位"] = ""
    节点["_宽"] = 240
    节点["_底色"] = 色(28, 32, 40, 255)
    节点["_字色"] = 色(230, 232, 238, 255)
    节点["_框色"] = 色(88, 94, 106, 255)
    节点["_焦框色"] = 色(96, 160, 255, 255)
    节点["_边框宽"] = 1
    节点["_圆角"] = 6
    节点["_内边距"] = 全边(8)
    节点["_只读"] = 假
    节点["_提交"] = 空
    节点["_占位色"] = 色(120, 124, 132, 255)
    节点["_焦框宽"] = 2
    节点["_左图标"] = ""
    节点["_右图标"] = ""
    节点["_图标尺寸"] = 0
    节点["_图标距"] = 6
    节点["_图标色"] = 色彩["白"]
    节点["_右图标点击"] = 空
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

// 多行编辑(多行文本编辑器,铸造厂 CodeEdit 地基):值经 状态[键] 读写(整段字符串,\n 分行);
// 光标/选区/滚动偏移存全局 _编辑态(栏键索引)。
// 选项:占位/占位色/字号/字距/宽/高/底色/框色/边框宽/焦框色/焦框宽/圆角/内边距/只读/行号(默认真) + 通用键
// 交互:点击获焦定位光标、拖动框选、字符输入(含 IME 内联组合)、退格/方向键(按住连发)、
//      回车换行、Tab 插 4 空格、Home/End 行首行尾、Ctrl+A/C/X/V(保留换行)、滚轮/滚动条、ESC/点外失焦
公 函 多行编辑(状态, 键, 选项) {
    设 节点 = 造节点("多行编辑")
    节点["_状态"] = 状态
    节点["_栏键"] = 键
    节点["_占位"] = ""
    节点["_宽"] = 420
    节点["_底色"] = 色(24, 27, 34, 255)
    节点["_字色"] = 色(220, 224, 232, 255)
    节点["_框色"] = 色(88, 94, 106, 255)
    节点["_焦框色"] = 色(96, 160, 255, 255)
    节点["_边框宽"] = 1
    节点["_圆角"] = 6
    节点["_内边距"] = 全边(8)
    节点["_只读"] = 假
    节点["_行号"] = 真
    节点["_占位色"] = 色(120, 124, 132, 255)
    节点["_焦框宽"] = 2
    // 语法高亮:高亮 = "玄铁" 开启;高亮色 可按类覆写调色板
    节点["_高亮"] = ""
    节点["_高亮色"] = {
        "关键字": 色(86, 156, 214, 255),
        "字符串": 色(206, 145, 120, 255),
        "注释": 色(106, 153, 85, 255),
        "数字": 色(181, 206, 168, 255)
    }
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 空白(选项) {
    设 节点 = 造节点("空白")
    节点["_弹"] = 1
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

公 函 弹性(弹值, 选项) {
    设 节点 = 造节点("空白")
    节点["_弹"] = 弹值
    若 选项 != 空 { 合选项(节点, 选项) }
    返 节点
}

// ============================================================
// 辅助: 合并选项
// ============================================================
// 边距容错:允许裸数字(自动转 全边),也接受 四边/全边 字典。
// 裸数字直接存进节点会在布局期对整数做字典索引,现在会被索引守卫拦下报错
函 转边距(值) {
    若 值 == 空 { 返 全边(0) }
    匹配 值 {
        是 字典 -> { 返 值 }
        _ -> { 返 全边(值) }
    }
}

// 状态子字典展开:{"底色":X,"字色":Y,"边色":Z} + 前缀(悬/按/禁) → 平面键(_悬底色 等)
函 _展开状态(节点, 前缀, 表) {
    若 表.含?("底色") { 节点["_" & 前缀 & "底色"] = 表["底色"] }
    若 表.含?("字色") { 节点["_" & 前缀 & "字色"] = 表["字色"] }
    若 表.含?("边色") { 节点["_" & 前缀 & "边色"] = 表["边色"] }
}

函 合选项(节点, 选项) {
    若 选项.含?("宽") { 节点["_宽"] = 选项["宽"] }
    若 选项.含?("高") { 节点["_高"] = 选项["高"] }
    若 选项.含?("x") { 节点["_x"] = 选项["x"] }
    若 选项.含?("y") { 节点["_y"] = 选项["y"] }
    若 选项.含?("弹性") { 节点["_弹"] = 选项["弹性"] }
    若 选项.含?("主轴对齐") { 节点["_主轴对齐"] = 选项["主轴对齐"] }
    若 选项.含?("叉轴对齐") { 节点["_叉轴对齐"] = 选项["叉轴对齐"] }
    若 选项.含?("间距") { 节点["_间距"] = 选项["间距"] }
    若 选项.含?("内边距") { 节点["_内边距"] = 转边距(选项["内边距"]) }
    若 选项.含?("外边距") { 节点["_外边距"] = 转边距(选项["外边距"]) }
    若 选项.含?("字号") { 节点["_字号"] = 选项["字号"] }
    若 选项.含?("字色") { 节点["_字色"] = 选项["字色"] }
    若 选项.含?("颜色") { 节点["_字色"] = 选项["颜色"] }
    若 选项.含?("底色") { 节点["_底色"] = 选项["底色"] }
    若 选项.含?("圆角") { 节点["_圆角"] = 选项["圆角"] }
    若 选项.含?("边框色") { 节点["_边框色"] = 选项["边框色"] }
    若 选项.含?("边框宽") { 节点["_边框宽"] = 选项["边框宽"] }
    若 选项.含?("悬底色") { 节点["_悬底色"] = 选项["悬底色"] }
    若 选项.含?("按底色") { 节点["_按底色"] = 选项["按底色"] }
    若 选项.含?("悬字色") { 节点["_悬字色"] = 选项["悬字色"] }
    若 选项.含?("按字色") { 节点["_按字色"] = 选项["按字色"] }
    若 选项.含?("禁底色") { 节点["_禁底色"] = 选项["禁底色"] }
    若 选项.含?("禁字色") { 节点["_禁字色"] = 选项["禁字色"] }
    若 选项.含?("悬边色") { 节点["_悬边色"] = 选项["悬边色"] }
    若 选项.含?("按边色") { 节点["_按边色"] = 选项["按边色"] }
    若 选项.含?("禁边色") { 节点["_禁边色"] = 选项["禁边色"] }
    若 选项.含?("悬浮上浮") { 节点["_悬浮上浮"] = 选项["悬浮上浮"] }
    若 选项.含?("按下缩放") { 节点["_按下缩放"] = 选项["按下缩放"] }
    // 状态子字典:悬浮/按下/禁用 一键装一状态的覆写;颜色三态仍展开到平面键(兼容),
    // 原字典同步存 _X覆——v1.5.0 起任意键(宽/高/源/不透明度/图标色…)皆可经解析器覆写
    若 选项.含?("悬浮") { _展开状态(节点, "悬", 选项["悬浮"]) ; 节点["_悬覆"] = 选项["悬浮"] ; 节点["_有覆"] = 真 }
    若 选项.含?("按下") { _展开状态(节点, "按", 选项["按下"]) ; 节点["_按覆"] = 选项["按下"] ; 节点["_有覆"] = 真 }
    // 禁用 双形态:布尔=纯禁用开关;字典=禁用态覆写(存入 _禁覆 并隐含禁用)。
    // 展开/存覆仅对字典形态(bool 进 _展开状态 会对布尔调 含? 崩溃,已实测)
    若 选项.含?("禁用") 且 选项["禁用"] 是 字典 {
        _展开状态(节点, "禁", 选项["禁用"])
        节点["_禁覆"] = 选项["禁用"]
        节点["_有覆"] = 真
    }
    若 选项.含?("禁用") { 节点["_禁用"] = 选项["禁用"] }
    若 选项.含?("不透明度") { 节点["_不透明度"] = 选项["不透明度"] }
    若 选项.含?("裁剪") { 节点["_裁剪"] = 选项["裁剪"] }
    若 选项.含?("平移x") { 节点["_平移x"] = 选项["平移x"] }
    若 选项.含?("平移y") { 节点["_平移y"] = 选项["平移y"] }
    若 选项.含?("锚") { 节点["_锚"] = 选项["锚"] }
    若 选项.含?("偏") { 节点["_偏"] = 选项["偏"] }
    若 选项.含?("滚动条") { 节点["_滚动条"] = 选项["滚动条"] }
    // 滚动条样式(滚动容器专用):条宽像素/轨道色/拇指色/拇指拖色(拖拽中的拇指色)
    若 选项.含?("条宽") { 节点["_条宽"] = 选项["条宽"] }
    若 选项.含?("轨道色") { 节点["_轨道色"] = 选项["轨道色"] }
    若 选项.含?("拇指色") { 节点["_拇指色"] = 选项["拇指色"] }
    若 选项.含?("拇指拖色") { 节点["_拇指拖色"] = 选项["拇指拖色"] }
    若 选项.含?("触发") { 节点["_触发"] = 选项["触发"] }
    若 选项.含?("连发间隔") { 节点["_连发间隔"] = 选项["连发间隔"] }
    若 选项.含?("首按延迟") { 节点["_首按延迟"] = 选项["首按延迟"] }
    若 选项.含?("点击") { 节点["_点击"] = 选项["点击"] }
    若 选项.含?("可视") { 节点["_可视"] = 选项["可视"] }
    // 输入栏专用
    若 选项.含?("占位") { 节点["_占位"] = 选项["占位"] }
    若 选项.含?("只读") { 节点["_只读"] = 选项["只读"] }
    若 选项.含?("提交") { 节点["_提交"] = 选项["提交"] }
    若 选项.含?("焦框色") { 节点["_焦框色"] = 选项["焦框色"] }
    若 选项.含?("占位色") { 节点["_占位色"] = 选项["占位色"] }
    若 选项.含?("行号") { 节点["_行号"] = 选项["行号"] }
    若 选项.含?("高亮") { 节点["_高亮"] = 选项["高亮"] }
    若 选项.含?("高亮色") {
        设 _uc = 选项["高亮色"]
        若 _uc.含?("关键字") { 节点["_高亮色"]["关键字"] = _uc["关键字"] }
        若 _uc.含?("字符串") { 节点["_高亮色"]["字符串"] = _uc["字符串"] }
        若 _uc.含?("注释") { 节点["_高亮色"]["注释"] = _uc["注释"] }
        若 _uc.含?("数字") { 节点["_高亮色"]["数字"] = _uc["数字"] }
    }
    若 选项.含?("框色") { 节点["_框色"] = 选项["框色"] }
    若 选项.含?("焦框宽") { 节点["_焦框宽"] = 选项["焦框宽"] }
    若 选项.含?("左图标") { 节点["_左图标"] = 选项["左图标"] }
    若 选项.含?("右图标") { 节点["_右图标"] = 选项["右图标"] }
    若 选项.含?("图标尺寸") { 节点["_图标尺寸"] = 选项["图标尺寸"] }
    若 选项.含?("图标距") { 节点["_图标距"] = 选项["图标距"] }
    若 选项.含?("图标色") { 节点["_图标色"] = 选项["图标色"] }
    若 选项.含?("右图标点击") { 节点["_右图标点击"] = 选项["右图标点击"] }
    // 通用外观(v1.2.0)
    若 选项.含?("字距") { 节点["_字距"] = 选项["字距"] }
    若 选项.含?("底色2") { 节点["_底色2"] = 选项["底色2"] }
    若 选项.含?("渐变向") { 节点["_渐变向"] = 选项["渐变向"] }
    若 选项.含?("羽化") { 节点["_羽化"] = 选项["羽化"] }
    若 选项.含?("阴影") {
        设 _影项 = 选项["阴影"]
        若 _影项.含?("颜色") { 节点["_影色"] = _影项["颜色"] }
        若 _影项.含?("模糊") { 节点["_影糊"] = _影项["模糊"] }
        若 _影项.含?("x") { 节点["_影x"] = _影项["x"] }
        若 _影项.含?("y") { 节点["_影y"] = _影项["y"] }
    }
}

// ============================================================
// 布局: 测量叶节点固有尺寸
// ============================================================
// 文本宽度测量:有字体用字体精确测量(需窗口已初始化,应用/刷新流程满足);
// 无字体退回启发式估算(纯算术,可在无窗口环境使用)
函 量文本宽(文本, 字号) {
    若 _字体 != 0 { 返 R.量字体文字(_字体, 文本, 字号, 1) }
    设 估 = 文本.字节数 * 字号 * 3
    若 估 < 字号 * 2 { 估 = 字号 * 2 }
    返 估
}

函 量固有(节点) {
    设 类型 = 节点["_类型"]
    若 类型 == "文本" {
        设 文本宽 = 量文本宽(节点["_文本"], 节点["_字号"])
        若 文本宽 < 节点["_字号"] * 2 { 文本宽 = 节点["_字号"] * 2 }
        设 文本高 = 节点["_字号"] * 7 / 5
        返 [文本宽, 文本高]
    }
    若 类型 == "矩形" 或 类型 == "按钮" {
        设 bw = _态键布(节点, "宽") ; 设 bh = _态键布(节点, "高")
        若 类型 == "按钮" {
            若 bw == 0 {
                bw = 量文本宽(节点["_文本"], 节点["_字号"]) + 节点["_内边距"]["左"] + 节点["_内边距"]["右"] + 节点["_字号"]
            }
            若 bh == 0 {
                bh = 节点["_字号"] * 7 / 5 + 节点["_内边距"]["上"] + 节点["_内边距"]["下"] + 节点["_字号"] / 2
            }
        }
        返 [bw, bh]
    }
    若 类型 == "输入栏" {
        设 iw = _态键布(节点, "宽")
        若 iw == 0 { iw = 240 }
        设 ih = _态键布(节点, "高")
        若 ih == 0 { ih = 节点["_字号"] * 7 / 5 + 节点["_内边距"]["上"] + 节点["_内边距"]["下"] + 4 }
        返 [iw, ih]
    }
    若 类型 == "多行编辑" {
        设 ew = _态键布(节点, "宽")
        若 ew == 0 { ew = 420 }
        设 eh = _态键布(节点, "高")
        若 eh == 0 { eh = _编行高(节点) * 8 + 节点["_内边距"]["上"] + 节点["_内边距"]["下"] }
        返 [ew, eh]
    }
    // 图片:固有尺寸取纹理原尺寸(经图标缓存懒加载);纹理缺失退回 0(由 宽/高 选项兜底)
    若 类型 == "图片" {
        设 pw = _态键布(节点, "宽") ; 设 ph = _态键布(节点, "高")
        若 pw > 0 且 ph > 0 { 返 [pw, ph] }
        设 _纹g = _取图标纹理(_态键布(节点, "源"), 0)
        若 _纹g > 0 {
            若 pw == 0 { pw = R.量纹理宽(_纹g) }
            若 ph == 0 { ph = R.量纹理高(_纹g) }
        }
        返 [pw, ph]
    }
    // 容器固有尺寸:递归量子项(行=主轴求和/叉轴取最,列反之,叠=子项最大外包,绝对=坐标+尺寸外包)
    若 类型 == "行" 或 类型 == "列" 或 类型 == "叠" 或 类型 == "绝对" 或 类型 == "滚动容器" {
        设 内 = 节点["_内边距"]
        设 主和 = 0 ; 设 叉最 = 0 ; 设 外包宽 = 0 ; 设 外包高 = 0 ; 设 可见数 = 0
        遍历 子 于 节点["_子"] {
            若 非 子["_可视"] { 续 }
            可见数 = 可见数 + 1
            设 固 = 量固有(子)
            设 子宽 = 固[0] ; 设 子高 = 固[1]
            设 _子宽b = _态键布(子, "宽") ; 设 _子高b = _态键布(子, "高")
            若 _子宽b > 0 { 子宽 = _子宽b }
            若 _子高b > 0 { 子高 = _子高b }
            若 类型 == "绝对" {
                若 子["_x"] + 子宽 > 外包宽 { 外包宽 = 子["_x"] + 子宽 }
                若 子["_y"] + 子高 > 外包高 { 外包高 = 子["_y"] + 子高 }
            } 抑 类型 == "叠" {
                若 子宽 > 外包宽 { 外包宽 = 子宽 }
                若 子高 > 外包高 { 外包高 = 子高 }
            } 否 {
                设 主 = 子高 ; 设 叉 = 子宽
                若 类型 == "行" { 主 = 子宽 ; 叉 = 子高 }
                主和 = 主和 + 主
                若 叉 > 叉最 { 叉最 = 叉 }
            }
        }
        设 w = 外包宽 ; 设 h = 外包高
        若 类型 == "行" 或 类型 == "列" 或 类型 == "滚动容器" {
            若 可见数 > 1 { 主和 = 主和 + 节点["_间距"] * (可见数 - 1) }
            若 类型 == "行" { w = 主和 ; h = 叉最 } 否 { w = 叉最 ; h = 主和 }
        }
        w = w + 内["左"] + 内["右"]
        h = h + 内["上"] + 内["下"]
        设 _容宽b = _态键布(节点, "宽") ; 设 _容高b = _态键布(节点, "高")
        若 _容宽b > 0 { w = _容宽b }
        若 _容高b > 0 { h = _容高b }
        返 [w, h]
    }
    返 [_态键布(节点, "宽"), _态键布(节点, "高")]
}

// ============================================================
// FlexBox 布局引擎
// ============================================================
// ============================================================
// 锚点布局(Godot 风):槽位内按比例+像素偏移定矩形
// ============================================================
// 偏取值:偏字典缺侧/整体缺省均按 0
函 _偏取(偏, 侧) {
    若 偏 == 空 { 返 0 }
    若 偏.含?(侧) { 返 偏[侧] }
    返 0
}

// 单锚定位:比例 <0.5 前向长(起点=锚点),>0.5 后向长(终点=锚点),=0.5 居中
函 _锚向起点(p, 尺寸, 比) {
    若 比 < 0.5 { 返 p }
    若 比 > 0.5 { 返 p - 尺寸 }
    返 p - 尺寸 / 2
}

// 锚定矩形:在父容器给出的槽位(x,y,可用宽,可用高)内按 锚/偏 计算 _布x/_布y/_布w/_布h。
// 逐轴规则:双锚=槽位按比例拉伸;单锚=锚点定点+固有/选项尺寸(前向/后向/居中);无锚=槽位左上+固有/选项尺寸。
// 外边距不适用(锚/偏已含定位语义);平移仍叠加(动值 可驱动锚定面板的滑入滑出)。
函 _锚定矩形(节点, x, y, 可用宽, 可用高) {
    设 锚 = 节点["_锚"]
    设 偏 = 节点["_偏"]
    // 固有尺寸(选项 宽/高 优先,同叶节点规)——单锚/无锚轴要用
    设 固有 = 量固有(节点)
    设 固w = 固有[0] ; 设 固h = 固有[1]
    若 _态键布(节点, "宽") > 0 { 固w = _态键布(节点, "宽") }
    若 _态键布(节点, "高") > 0 { 固h = _态键布(节点, "高") }
    // X 轴
    设 有左 = 锚.含?("左") ; 设 有右 = 锚.含?("右")
    若 有左 且 有右 {
        节点["_布x"] = x + 可用宽 * 锚["左"] + _偏取(偏, "左")
        节点["_布w"] = 可用宽 * (锚["右"] - 锚["左"]) + _偏取(偏, "右") - _偏取(偏, "左")
    } 抑 有左 {
        节点["_布x"] = _锚向起点(x + 可用宽 * 锚["左"] + _偏取(偏, "左"), 固w, 锚["左"])
        节点["_布w"] = 固w
    } 抑 有右 {
        节点["_布x"] = _锚向起点(x + 可用宽 * 锚["右"] + _偏取(偏, "右"), 固w, 锚["右"])
        节点["_布w"] = 固w
    } 否 {
        节点["_布x"] = x
        节点["_布w"] = 固w
    }
    // Y 轴
    设 有上 = 锚.含?("上") ; 设 有下 = 锚.含?("下")
    若 有上 且 有下 {
        节点["_布y"] = y + 可用高 * 锚["上"] + _偏取(偏, "上")
        节点["_布h"] = 可用高 * (锚["下"] - 锚["上"]) + _偏取(偏, "下") - _偏取(偏, "上")
    } 抑 有上 {
        节点["_布y"] = _锚向起点(y + 可用高 * 锚["上"] + _偏取(偏, "上"), 固h, 锚["上"])
        节点["_布h"] = 固h
    } 抑 有下 {
        节点["_布y"] = _锚向起点(y + 可用高 * 锚["下"] + _偏取(偏, "下"), 固h, 锚["下"])
        节点["_布h"] = 固h
    } 否 {
        节点["_布y"] = y
        节点["_布h"] = 固h
    }
    // 平移叠加 + 尺寸下限
    节点["_布x"] = 节点["_布x"] + _态键布(节点, "平移x")
    节点["_布y"] = 节点["_布y"] + _态键布(节点, "平移y")
    若 节点["_布w"] < 0 { 节点["_布w"] = 0 }
    若 节点["_布h"] < 0 { 节点["_布h"] = 0 }
}

公 函 计算布局(节点, x, y, 可用宽, 可用高) {
    若 非 节点["_可视"] { 返 空 }

    // 双挂守卫:同一节点实例一帧只允许布局一次——坐标只有一份,二次布局会被后挂载点覆盖,
    // 先挂载点内的该实例全部不可见(灵异现象:空容器却有滚动条)。宁报错不静默。
    若 节点["_布帧"] == _帧号 {
        示("UI 错误:检测到节点双挂——同一节点实例在一帧内被布局了两次(类型=" & 节点["_类型"] & ", 文本「" & 节点["_文本"] & "」)。正解:在构建函数内每帧现场调用构造函数;复用结构请抽成函数,每次调用返回新实例。")
        终 1
    }
    节点["_布帧"] = _帧号

    设 边距 = 节点["_外边距"]
    设 mx = 边距["左"] ; 设 my = 边距["上"]
    设 内容宽 = 可用宽 - 边距["左"] - 边距["右"]
    设 内容高 = 可用高 - 边距["上"] - 边距["下"]

    // 锚点分流:锚/偏 定矩形(外边距不适用);子树在锚定矩形内容区照常布局
    若 节点["_锚"] != 空 {
        _锚定矩形(节点, x, y, 可用宽, 可用高)
        内容宽 = 节点["_布w"]
        内容高 = 节点["_布h"]
    } 否 {
        // 平移经解析器(可状态覆写/动值驱动):加在自身坐标上,子树/命中/身份串随之同源偏移
        节点["_布x"] = x + mx + _态键布(节点, "平移x")
        节点["_布y"] = y + my + _态键布(节点, "平移y")
    }

    若 节点["_子"].长度 == 0 {
        若 节点["_锚"] == 空 {
            设 固有 = 量固有(节点)
            节点["_布w"] = 固有[0] ; 节点["_布h"] = 固有[1]
            若 _态键布(节点, "宽") > 0 { 节点["_布w"] = _态键布(节点, "宽") }
            若 _态键布(节点, "高") > 0 { 节点["_布h"] = _态键布(节点, "高") }
        }
        返 空
    }

    设 内距 = 节点["_内边距"]
    设 px = 内距["左"] ; 设 py = 内距["上"]
    设 子可用宽 = 内容宽 - 内距["左"] - 内距["右"]
    设 子可用高 = 内容高 - 内距["上"] - 内距["下"]
    若 子可用宽 < 0 { 子可用宽 = 0 }
    若 子可用高 < 0 { 子可用高 = 0 }

    设 类型 = 节点["_类型"]
    若 类型 == "叠" {
        布叠(节点, px, py, 子可用宽, 子可用高)
    } 抑 类型 == "绝对" {
        布绝对(节点, px, py, 子可用宽, 子可用高)
    } 抑 类型 == "滚动容器" {
        布滚动(节点, px, py, 子可用宽, 子可用高)
    } 抑 类型 == "行" {
        布主轴(节点, px, py, 子可用宽, 子可用高, 真)
    } 否 {
        布主轴(节点, px, py, 子可用宽, 子可用高, 假)
    }
}

// 绝对布局:子节点按 _x/_y 直摆(相对容器内容区左上),宽高取选项或固有
函 布绝对(节点, px, py, 可用宽, 可用高) {
    遍历 子 于 节点["_子"] {
        若 非 子["_可视"] { 续 }
        设 固有 = 量固有(子)
        设 子宽 = 固有[0] ; 设 子高 = 固有[1]
        若 _态键布(子, "宽") > 0 { 子宽 = _态键布(子, "宽") }
        若 _态键布(子, "高") > 0 { 子高 = _态键布(子, "高") }
        计算布局(子, 节点["_布x"] + px + 子["_x"], 节点["_布y"] + py + 子["_y"], 子宽, 子高)
    }
    设 内距 = 节点["_内边距"]
    节点["_布w"] = 可用宽 + 内距["左"] + 内距["右"]
    节点["_布h"] = 可用高 + 内距["上"] + 内距["下"]
    若 _态键布(节点, "宽") > 0 { 节点["_布w"] = _态键布(节点, "宽") }
    若 _态键布(节点, "高") > 0 { 节点["_布h"] = _态键布(节点, "高") }
}

// 滚动容器布局:子节点按列排布,y 起点减当前动画滚动量(内容随滚动平移,渲染层裁剪可视区)
函 布滚动(节点, px, py, 可用宽, 可用高) {
    设 _序 = _滚序
    节点["_滚序"] = _序
    _滚序 = _滚序 + 1
    设 _键 = "滚#" & _序
    设 _态 = _滚态取(_键)

    // 视口高:选项高优先,否则吃布局可用高,再否则 200 兜底
    设 视高 = 可用高
    若 _态键布(节点, "高") > 0 { 视高 = _态键布(节点, "高") - 节点["_内边距"]["上"] - 节点["_内边距"]["下"] }
    若 视高 <= 0 { 视高 = 200 }

    设 内距 = 节点["_内边距"]
    // 前置测内容高:子项高度与宽度无关(框架无文本回绕),间距只计 n-1 段。
    // 据此判定溢出——不溢出时滚动条不占位、不显示、目标量恒夹到 0(空容器同样无滚动条)
    设 内容高 = 内距["上"] + 内距["下"]
    设 可见数 = 0
    遍历 子 于 节点["_子"] {
        若 非 子["_可视"] { 续 }
        设 固有h = 量固有(子)
        设 子高h = 固有h[1]
        若 _态键布(子, "高") > 0 { 子高h = _态键布(子, "高") }
        若 可见数 > 0 { 内容高 = 内容高 + 节点["_间距"] }
        内容高 = 内容高 + 子高h
        可见数 = 可见数 + 1
    }
    设 溢出 = 内容高 > 视高
    _态["内容高"] = 内容高
    _态["视高"] = 视高

    // 目标滚动量按本帧内容高夹取
    设 目标 = _态["目标"]
    设 最大 = 内容高 - 视高
    若 最大 < 0 { 最大 = 0 }
    若 目标 > 最大 { 目标 = 最大 }
    若 目标 < 0 { 目标 = 0 }
    _态["目标"] = 目标
    // 拖拽时钉死跟随(时长0),松手恢复丝滑
    设 _滚量键 = "滚量#" & _序
    若 非 _动画态.含?(_滚量键) { 造动画(_滚量键, {"时长": 160, "曲线": "丝滑"}) }
    若 _态["拖动中"] { 造动画(_滚量键, {"时长": 0}) } 否 { 造动画(_滚量键, {"时长": 160}) }
    设 滚动量 = 动值(_滚量键, 目标)
    _态["滚动量"] = 滚动量

    // 滚动条占位:仅溢出且启用时,内容给滚动条让位(条宽 + 4px 间隙)
    设 条占 = 0
    若 节点["_滚动条"] 且 溢出 { 条占 = 节点["_条宽"] + 4 }
    设 cy = 节点["_布y"] + py - 滚动量
    遍历 子 于 节点["_子"] {
        若 非 子["_可视"] { 续 }
        设 固有 = 量固有(子)
        设 子宽 = 固有[0] ; 设 子高 = 固有[1]
        若 _态键布(子, "宽") > 0 { 子宽 = _态键布(子, "宽") }
        若 _态键布(子, "高") > 0 { 子高 = _态键布(子, "高") }
        设 满宽 = 可用宽 - 条占
        若 满宽 < 0 { 满宽 = 0 }
        若 子宽 > 满宽 或 子宽 <= 0 { 子宽 = 满宽 }
        计算布局(子, 节点["_布x"] + px, cy, 子宽, 子高)
        cy = cy + 子高 + 节点["_间距"]
    }

    节点["_布w"] = 可用宽 + 内距["左"] + 内距["右"]
    若 _态键布(节点, "宽") > 0 { 节点["_布w"] = _态键布(节点, "宽") }
    节点["_布h"] = 视高 + 内距["上"] + 内距["下"]
    若 _态键布(节点, "高") > 0 { 节点["_布h"] = _态键布(节点, "高") }
}

函 布主轴(节点, 始X, 始Y, 可用宽, 可用高, 是横向) {
    设 子列表 = 节点["_子"]
    设 间距 = 节点["_间距"]
    设 总弹 = 0 ; 设 定长总和 = 0 ; 设 可见子 = []

    遍历 子 于 子列表 {
        若 非 子["_可视"] { 续 }
        可见子.追加(子)
        设 子边距 = 子["_外边距"]
        设 固有 = 量固有(子)
        若 是横向 {
            设 子首选 = 固有[0]
            若 _态键布(子, "宽") > 0 { 子首选 = _态键布(子, "宽") }
            定长总和 = 定长总和 + 子首选 + 子边距["左"] + 子边距["右"]
        } 否 {
            设 子首选 = 固有[1]
            若 _态键布(子, "高") > 0 { 子首选 = _态键布(子, "高") }
            定长总和 = 定长总和 + 子首选 + 子边距["上"] + 子边距["下"]
        }
        总弹 = 总弹 + 子["_弹"]
    }

    若 可见子.长度 == 0 {
        设 内距 = 节点["_内边距"]
        节点["_布w"] = 可用宽 + 内距["左"] + 内距["右"]
        节点["_布h"] = 可用高 + 内距["上"] + 内距["下"]
        若 _态键布(节点, "宽") > 0 { 节点["_布w"] = _态键布(节点, "宽") }
        若 _态键布(节点, "高") > 0 { 节点["_布h"] = _态键布(节点, "高") }
        返 空
    }

    设 间距总和 = 间距 * (可见子.长度 - 1)
    定长总和 = 定长总和 + 间距总和

    设 主轴空间 = 0
    若 是横向 { 主轴空间 = 可用宽 } 否 { 主轴空间 = 可用高 }
    设 剩余空间 = 主轴空间 - 定长总和
    若 剩余空间 < 0 { 剩余空间 = 0 }

    设 对齐偏移 = 0 ; 设 间隙额外 = 0
    设 对齐方式 = 节点["_主轴对齐"]

    若 对齐方式 == 对齐中 { 对齐偏移 = 剩余空间 / 2 }
    抑 对齐方式 == 对齐末 { 对齐偏移 = 剩余空间 }
    抑 对齐方式 == 对齐间 {
        若 可见子.长度 > 1 { 间隙额外 = 剩余空间 / (可见子.长度 - 1) }
    }
    抑 对齐方式 == 对齐均 {
        间隙额外 = 剩余空间 / 可见子.长度
        对齐偏移 = 间隙额外 / 2
    }
    抑 对齐方式 == 对齐均等 {
        设 段数 = 可见子.长度 + 1
        间隙额外 = 剩余空间 / 段数
        对齐偏移 = 间隙额外
    }

    设 叉空间 = 0
    若 是横向 { 叉空间 = 可用高 } 否 { 叉空间 = 可用宽 }

    设 主轴位置 = 0
    若 是横向 { 主轴位置 = 始X + 对齐偏移 } 否 { 主轴位置 = 始Y + 对齐偏移 }

    设 主轴总长 = 0 ; 设 叉轴最大 = 0

    遍历 子 于 可见子 {
        设 子边 = 子["_外边距"]
        设 子外边距主前 = 子边["左"] ; 设 子外边距主后 = 子边["右"]
        设 子外边距叉前 = 子边["上"] ; 设 子外边距叉后 = 子边["下"]
        若 非 是横向 {
            子外边距主前 = 子边["上"] ; 子外边距主后 = 子边["下"]
            子外边距叉前 = 子边["左"] ; 子外边距叉后 = 子边["右"]
        }

        主轴位置 = 主轴位置 + 子外边距主前

        设 子固有 = 量固有(子)
        设 子主轴尺寸 = 0
        若 是横向 {
            子主轴尺寸 = 子固有[0]
            若 _态键布(子, "宽") > 0 { 子主轴尺寸 = _态键布(子, "宽") }
        } 否 {
            子主轴尺寸 = 子固有[1]
            若 _态键布(子, "高") > 0 { 子主轴尺寸 = _态键布(子, "高") }
        }

        若 总弹 > 0 且 子["_弹"] > 0 {
            设 弹空间 = (剩余空间 * 子["_弹"]) / 总弹
            子主轴尺寸 = 子主轴尺寸 + 弹空间
        }

        设 子叉轴尺寸 = 0
        若 是横向 {
            子叉轴尺寸 = 子固有[1]
            若 _态键布(子, "高") > 0 { 子叉轴尺寸 = _态键布(子, "高") }
        } 否 {
            子叉轴尺寸 = 子固有[0]
            若 _态键布(子, "宽") > 0 { 子叉轴尺寸 = _态键布(子, "宽") }
        }
        若 子["_叉轴对齐"] == 叉撑 或 节点["_叉轴对齐"] == 叉撑 {
            设 撑后 = 叉空间 - 子外边距叉前 - 子外边距叉后
            若 撑后 > 子叉轴尺寸 { 子叉轴尺寸 = 撑后 }
            若 子叉轴尺寸 < 0 { 子叉轴尺寸 = 0 }
        }

        设 叉位置 = 0
        设 叉对齐 = 子["_叉轴对齐"]
        若 叉对齐 == 叉撑 { 叉对齐 = 节点["_叉轴对齐"] }
        若 叉对齐 == 叉中 { 叉位置 = (叉空间 - 子叉轴尺寸) / 2 }
        抑 叉对齐 == 叉末 { 叉位置 = 叉空间 - 子叉轴尺寸 }
        叉位置 = 叉位置 + 子外边距叉前

        若 是横向 {
            计算布局(子, 节点["_布x"] + 始X + 主轴位置, 节点["_布y"] + 始Y + 叉位置, 子主轴尺寸, 子叉轴尺寸)
            主轴总长 = 主轴总长 + 子外边距主前 + 子主轴尺寸 + 子外边距主后
            设 叉总 = 子外边距叉前 + 子叉轴尺寸 + 子外边距叉后
            若 叉总 > 叉轴最大 { 叉轴最大 = 叉总 }
        } 否 {
            计算布局(子, 节点["_布x"] + 始X + 叉位置, 节点["_布y"] + 始Y + 主轴位置, 子叉轴尺寸, 子主轴尺寸)
            主轴总长 = 主轴总长 + 子外边距主前 + 子主轴尺寸 + 子外边距主后
            设 叉总 = 子外边距叉前 + 子叉轴尺寸 + 子外边距叉后
            若 叉总 > 叉轴最大 { 叉轴最大 = 叉总 }
        }

        主轴位置 = 主轴位置 + 子主轴尺寸 + 子外边距主后 + 间距 + 间隙额外
    }

    主轴总长 = 主轴总长 + 间距总和
    设 内距 = 节点["_内边距"]

    若 是横向 {
        节点["_布w"] = 主轴总长 + 内距["左"] + 内距["右"]
        节点["_布h"] = 叉轴最大 + 内距["上"] + 内距["下"]
        若 _态键布(节点, "宽") > 0 { 节点["_布w"] = _态键布(节点, "宽") }
        若 _态键布(节点, "高") > 0 { 节点["_布h"] = _态键布(节点, "高") }
    } 否 {
        节点["_布w"] = 叉轴最大 + 内距["左"] + 内距["右"]
        节点["_布h"] = 主轴总长 + 内距["上"] + 内距["下"]
        若 _态键布(节点, "宽") > 0 { 节点["_布w"] = _态键布(节点, "宽") }
        若 _态键布(节点, "高") > 0 { 节点["_布h"] = _态键布(节点, "高") }
    }
}

函 布叠(节点, px, py, 可用宽, 可用高) {
    遍历 子 于 节点["_子"] {
        若 非 子["_可视"] { 续 }
        设 子宽 = 可用宽 ; 设 子高 = 可用高
        // 锚定子不占固有/选项尺寸槽:锚/偏 自带完整定位语义,槽位必须给满内容区(IDE 壳四区锚定的根基)
        若 子["_锚"] == 空 {
            若 _态键布(子, "宽") > 0 { 子宽 = _态键布(子, "宽") }
            若 _态键布(子, "高") > 0 { 子高 = _态键布(子, "高") }
        }
        计算布局(子, 节点["_布x"] + px, 节点["_布y"] + py, 子宽, 子高)
    }
    设 内距 = 节点["_内边距"]
    节点["_布w"] = 可用宽 + 内距["左"] + 内距["右"]
    节点["_布h"] = 可用高 + 内距["上"] + 内距["下"]
    若 _态键布(节点, "宽") > 0 { 节点["_布w"] = _态键布(节点, "宽") }
    若 _态键布(节点, "高") > 0 { 节点["_布h"] = _态键布(节点, "高") }
}

// ============================================================
// 渲染
// ============================================================
// 圆角像素→raylib 圆角百分比(0-100,相对 min(宽,高)/2 半径)
函 _圆角百分(节点) {
    设 角 = 节点["_圆角"]
    若 角 <= 0 { 返 0 }
    设 w = 节点["_布w"] ; 设 h = 节点["_布h"]
    设 m = w
    若 h < m { m = h }
    若 m <= 0 { 返 0 }
    设 pct = 角 * 200 / m
    若 pct > 100 { pct = 100 }
    返 pct
}

// 左键持续按住状态(按压态联动;由 应用/刷新 帧循环在处理悬浮前更新)
设 _左键按住 = 假
// 上一帧的按住状态(按下沿/松开沿检测用)
设 _左键上帧 = 假
// 按压源记录(跨帧记忆):声明式树每帧重建,节点上的 _待击/_按住起 活不过一帧——
// 改为全局按压键(节点身份串:坐标+宽+文本),按下沿记录、松开沿比对
设 _按压键 = ""
设 _按住起 = 0
设 _按住末次 = 0
设 _已连发 = 假
// 本帧是否有输入栏被悬浮(帧循环在处理悬浮前清零;据此把鼠标样式切为 I 形)
设 _悬栏 = 假
// 上一帧被悬浮且带状态覆写的节点身份(布局期 悬浮 覆写判定用;处理悬浮 时登记,最深覆盖)
设 _悬身份 = ""
// 渲染不透明度乘区(千分比,1000=不透;渲染递归期间父子连乘,命中侧按自身键门控)
设 _透当 = 1000

// 节点身份串(跨帧识别:树每帧重建,靠坐标+宽+文本认回同一控件)
函 _身份(节点) {
    返 节点["_布x"] & "," & 节点["_布y"] & "," & 节点["_布w"] & "," & 节点["_文本"]
}

// 状态覆写解析(布局期):禁用 > 按下(按压源身份) > 悬浮(上一帧悬浮身份) > 基底。
// 布局跑在 处理悬浮 前,悬/按态只能用上一帧身份比对,布局稳定的界面无感
函 _态键布(节点, 键) {
    若 节点["_禁用"] 且 节点["_禁覆"].含?(键) { 返 节点["_禁覆"][键] }
    若 节点["_按覆"].含?(键) 且 _按压键 == _身份(节点) { 返 节点["_按覆"][键] }
    若 节点["_悬覆"].含?(键) 且 _悬身份 == _身份(节点) { 返 节点["_悬覆"][键] }
    返 节点["_" & 键]
}

// 状态覆写解析(渲染期):用本帧新鲜 悬浮/按下 态,无滞后
函 _态键渲(节点, 键) {
    若 节点["_禁用"] 且 节点["_禁覆"].含?(键) { 返 节点["_禁覆"][键] }
    若 节点["_按下"] 且 节点["_按覆"].含?(键) { 返 节点["_按覆"][键] }
    若 节点["_悬浮"] 且 节点["_悬覆"].含?(键) { 返 节点["_悬覆"][键] }
    返 节点["_" & 键]
}

// 颜色 alpha 按当前不透明度乘区折算(渲染各绘制调用点统一走这里)
函 _A(a) {
    若 _透当 >= 1000 { 返 a }
    返 a * _透当 / 1000
}

公 函 渲染(节点) {
    若 非 节点["_可视"] { 返 空 }

    // 不透明度乘区(v1.5.0):本节点解析值乘入(父子连乘),函数出口恢复
    设 _透存 = _透当
    _透当 = _透当 * _态键渲(节点, "不透明度") / 100

    设 x = 节点["_布x"] ; 设 y = 节点["_布y"]
    设 w = 节点["_布w"] ; 设 h = 节点["_布h"]
    设 景 = 节点["_底色"]
    设 影 = 节点["_影色"]
    设 影糊 = 节点["_影糊"]
    设 影x = 节点["_影x"]
    设 影y = 节点["_影y"]
    设 框色 = 节点["_边框色"]

    // ---- 按钮微交互(悬浮上浮+影强渐增;按下缩小、松开回弹) ----
    // 千分定点几何:整数坐标画 2~3px 行程动画只剩几档台阶,×1000 定点交给 GPU 亚像素插值才丝滑。
    // 只调视觉几何,不改布局量(命中仍按布局矩形);首帧钉住不播
    设 _钮序 = 0
    设 _钮缩 = 100
    设 _bxk = 0
    设 _byk = 0
    设 _bwk = 0
    设 _bhk = 0
    若 节点["_类型"] == "按钮" {
        _动画序 = _动画序 + 1
        _钮序 = _动画序
        设 _悬目 = 0
        若 节点["_悬浮"] { _悬目 = 1000 }
        设 _按目 = 0
        若 节点["_按下"] { _按目 = 1000 }
        设 _悬键 = "钮悬#" & _钮序
        若 非 _动画态.含?(_悬键) { 造动画(_悬键, {"时长": 150, "曲线": "丝滑"}) }
        设 _悬量 = 动值(_悬键, _悬目)
        设 _按键 = "钮按#" & _钮序
        若 非 _动画态.含?(_按键) { 造动画(_按键, {"时长": 220, "曲线": "回弹"}) }
        // 方向分曲线:按下快收(90ms 缓出),松开回弹(220ms 过冲)
        若 _按目 > 0 { 造动画(_按键, {"时长": 90, "曲线": "缓出"}) } 否 { 造动画(_按键, {"时长": 220, "曲线": "回弹"}) }
        设 _按量 = 动值(_按键, _按目)
        // 千分比缩放(100000=100%),绕中心 + 上浮(负 y),全部千分定点
        设 _缩千 = 100000 - (100000 - 节点["_按下缩放"] * 1000) * _按量 / 1000
        _钮缩 = _缩千 / 1000
        _bwk = w * _缩千 / 100
        _bhk = h * _缩千 / 100
        _bxk = x * 1000 + (w * 1000 - _bwk) / 2
        _byk = y * 1000 + (h * 1000 - _bhk) / 2 - 节点["_悬浮上浮"] * _悬量
        // 阴影沿用整数几何(软影边缘,1px 台阶不可见)
        设 _nw = _bwk / 1000
        设 _nh = _bhk / 1000
        x = x + (w - _nw) / 2
        y = y + (h - _nh) / 2 - 节点["_悬浮上浮"] * _悬量 / 1000
        w = _nw
        h = _nh
        // 悬浮阴影:未显式设阴影时,悬浮开启并递增强度(立体感)
        若 影["a"] == 0 且 _悬量 > 0 {
            影 = 色(0, 0, 0, _悬量 * 45 / 1000)
            影糊 = 8
            影x = 0
            影y = 3
        }
        // 状态边色(悬/按/禁,丝滑过渡)
        设 _边目 = 节点["_边框色"]
        若 节点["_悬浮"] 且 节点["_悬边色"]["a"] > 0 { _边目 = 节点["_悬边色"] }
        若 节点["_按下"] 且 节点["_按边色"]["a"] > 0 { _边目 = 节点["_按边色"] }
        若 节点["_禁用"] 且 节点["_禁边色"]["a"] > 0 { _边目 = 节点["_禁边色"] }
        设 _钮边键 = "钮边#" & _钮序
        若 非 _动画态.含?(_钮边键) { 造动画(_钮边键, {"时长": 120, "曲线": "丝滑"}) }
        框色 = 动值(_钮边键, _边目)
    }

    // 阴影:在背景之下,从外到内逐圈 1px 外扩圆角矩形,alpha 线性收敛。
    // 影色.a==0 即关闭(默认)。各组件通用,输入栏首批接入。
    影 = 色(影["r"], 影["g"], 影["b"], _A(影["a"]))
    若 影["a"] > 0 且 影糊 > 0 且 w > 0 且 h > 0 {
        设 _糊 = 影糊
        设 _rp0 = _圆角百分(节点)
        设 _ri = _糊
        当 _ri >= 1 {
            设 _环a = 影["a"] * (_糊 - _ri + 1) / _糊
            若 _rp0 > 0 {
                R.绘圆角矩形(x + 影x - _ri, y + 影y - _ri, w + _ri * 2, h + _ri * 2, _rp0, 影["r"], 影["g"], 影["b"], _环a)
            } 否 {
                R.绘矩形(x + 影x - _ri, y + 影y - _ri, w + _ri * 2, h + _ri * 2, 影["r"], 影["g"], 影["b"], _环a)
            }
            _ri = _ri - 1
        }
    }

    // 背景:设了 底色2(渐变)或 羽化>1 时走渐变纹理路径(生成器自带圆角 SDF 与羽化);
    // 仅羽化不设渐变时,两色同底色 = 圆角羽化纯色块。否则经典纯色路径。
    // 按钮不在此画:按钮分支用千分定点自绘(微交互亚像素),防整数/浮点双画错位
    设 底2 = 节点["_底色2"]
    若 节点["_类型"] != "按钮" {
    若 (底2["a"] > 0 或 节点["_羽化"] > 1) 且 (景["a"] > 0 或 底2["a"] > 0) 且 w > 0 且 h > 0 {
        设 _c2 = 底2
        若 _c2["a"] == 0 { _c2 = 景 }
        设 _向 = 1
        若 节点["_渐变向"] == "横" { _向 = 0 }
        设 _gt = R.生成渐变纹理(w, h, 景["r"], 景["g"], 景["b"], 景["a"], _c2["r"], _c2["g"], _c2["b"], _c2["a"], _向, 节点["_圆角"], 节点["_羽化"])
        // 渐变内容随纹理烘焙,不透明度改由绘制 tint 乘入(免重建纹理)
        若 _gt > 0 { R.绘纹理区(_gt, x, y, w, h, 255, 255, 255, _A(255)) }
    } 抑 景["a"] > 0 {
        设 _rp = _圆角百分(节点)
        若 _rp > 0 {
            R.绘圆角矩形(x, y, w, h, _rp, 景["r"], 景["g"], 景["b"], _A(景["a"]))
        } 否 {
            R.绘矩形(x, y, w, h, 景["r"], 景["g"], 景["b"], _A(景["a"]))
        }
    }
    }

    设 框宽 = 节点["_边框宽"]
    框色 = 色(框色["r"], 框色["g"], 框色["b"], _A(框色["a"]))
    若 框宽 > 0 且 框色["a"] > 0 且 节点["_类型"] != "按钮" {
        设 _rp2 = _圆角百分(节点)
        若 _rp2 > 0 {
            R.绘圆角矩形线(x, y, w, h, _rp2, 框宽, 框色["r"], 框色["g"], 框色["b"], 框色["a"])
        } 否 {
            R.绘矩形线(x, y, w, h, 框色["r"], 框色["g"], 框色["b"], 框色["a"])
        }
    }

    设 类型 = 节点["_类型"]
    设 字色 = 节点["_字色"]
    字色 = 色(字色["r"], 字色["g"], 字色["b"], _A(字色["a"]))

    若 类型 == "文本" {
        若 _字体 != 0 {
            R.绘字体文字(_字体, 节点["_文本"], x, y, 节点["_字号"], 1, 字色["r"], 字色["g"], 字色["b"], 字色["a"])
        } 否 {
            R.绘文字(节点["_文本"], x, y, 节点["_字号"], 字色["r"], 字色["g"], 字色["b"], 字色["a"])
        }
    }
    抑 类型 == "输入栏" {
        设 _bk = 节点["_栏键"]
        // 栏态惰性注册(节点每帧重建,状态/选项每帧经此汇入全局表)
        若 非 _输入栏态.含?(_bk) {
            _输入栏态[_bk] = _造栏态(节点)
        }
        设 _栏 = _输入栏态[_bk]
        _栏["状态"] = 节点["_状态"]
        _栏["只读"] = 节点["_只读"]
        _栏["提交"] = 节点["_提交"]
        设 _焦 = (_焦点栏 == _bk)
        // 边框:聚焦画 焦框色/焦框宽;非聚焦画 框色/边框宽(默认边框,v1.2.0 修复 框色 从未生效)
        设 _边色 = 节点["_框色"]
        设 _边宽 = 节点["_边框宽"]
        若 _焦 {
            _边色 = 节点["_焦框色"]
            _边宽 = 节点["_焦框宽"]
        }
        // 聚焦边框色丝滑过渡(栏键身份天然稳定;首帧钉住不播)
        设 _框动键 = "栏框#" & _bk
        若 非 _动画态.含?(_框动键) { 造动画(_框动键, {"时长": 150, "曲线": "丝滑"}) }
        _边色 = 动值(_框动键, _边色)
        _边色 = 色(_边色["r"], _边色["g"], _边色["b"], _A(_边色["a"]))
        若 _边宽 > 0 且 _边色["a"] > 0 {
            设 _rp3 = _圆角百分(节点)
            若 _rp3 > 0 {
                R.绘圆角矩形线(x, y, w, h, _rp3, _边宽, _边色["r"], _边色["g"], _边色["b"], _边色["a"])
            } 否 {
                R.绘矩形线(x, y, w, h, _边色["r"], _边色["g"], _边色["b"], _边色["a"])
            }
        }
        设 内左 = 节点["_内边距"]["左"]
        设 内上 = 节点["_内边距"]["上"]
        设 内右 = 节点["_内边距"]["右"]
        // 图标(v1.2.0):左/右图标按 路径@尺寸 缓存纹理,垂直居中;文本区相应内缩
        设 图寸 = 节点["_图标尺寸"]
        若 图寸 <= 0 { 图寸 = h - 内上 - 节点["_内边距"]["下"] }
        若 图寸 < 8 { 图寸 = 8 }
        设 左纹 = 0
        设 右纹 = 0
        若 节点["_左图标"] != "" { 左纹 = _取图标纹理(节点["_左图标"], 图寸) }
        若 节点["_右图标"] != "" { 右纹 = _取图标纹理(节点["_右图标"], 图寸) }
        设 文左 = 内左
        设 文右 = 内右
        若 左纹 > 0 { 文左 = 文左 + 图寸 + 节点["_图标距"] }
        若 右纹 > 0 { 文右 = 文右 + 图寸 + 节点["_图标距"] }
        设 图y = y + (h - 图寸) / 2
        设 图色 = 节点["_图标色"]
        图色 = 色(图色["r"], 图色["g"], 图色["b"], _A(图色["a"]))
        若 左纹 > 0 { R.绘纹理区(左纹, x + 内左, 图y, 图寸, 图寸, 图色["r"], 图色["g"], 图色["b"], 图色["a"]) }
        若 右纹 > 0 { R.绘纹理区(右纹, x + w - 内右 - 图寸, 图y, 图寸, 图寸, 图色["r"], 图色["g"], 图色["b"], 图色["a"]) }
        设 真值 = 态取(节点["_状态"], _bk)
        若 真值 == 空 { 真值 = "" }
        设 显示值 = 真值
        设 字色用 = 节点["_字色"]
        若 真值 == "" 且 节点["_占位"] != "" {
            显示值 = 节点["_占位"]
            字色用 = 节点["_占位色"]
        }
        字色用 = 色(字色用["r"], 字色用["g"], 字色用["b"], _A(字色用["a"]))
        设 距 = 节点["_字距"]
        // 光标位置(字符索引)与横向偏移(保持光标可见)
        若 _栏["光标"] < 0 { _栏["光标"] = 真值.字符数 }
        若 _栏["光标"] > 真值.字符数 { _栏["光标"] = 真值.字符数 }
        设 光标x = 0
        若 _字体 != 0 {
            设 前缀 = 真值.截取(0, _栏["光标"])
            光标x = R.量字体文字(_字体, 前缀, 节点["_字号"], 距)
        }
        设 内宽 = w - 文左 - 文右
        若 光标x - _栏["偏移"] > 内宽 - 6 { _栏["偏移"] = 光标x - 内宽 + 6 }
        若 光标x < _栏["偏移"] { _栏["偏移"] = 光标x }
        若 _栏["偏移"] < 0 { _栏["偏移"] = 0 }
        // 文本与光标(裁剪到文本区:左右图标区不进入,长文本滚动永不遮图标)
        R.裁剪开始(x + 文左, y + 2, w - 文左 - 文右, h - 4)
        // 选区高亮(焦点且有选区时,画在文本之下)
        设 _se = _栏选区(_栏)
        若 _焦 且 _se[0] >= 0 且 _字体 != 0 {
            设 _前宽 = R.量字体文字(_字体, 真值.截取(0, _se[0]), 节点["_字号"], 距)
            设 _选宽 = R.量字体文字(_字体, 真值.截取(_se[0], _se[1]), 节点["_字号"], 距)
            R.绘矩形(x + 文左 + _前宽 - _栏["偏移"], y + 内上, _选宽, 节点["_字号"] * 7 / 5, 70, 130, 230, _A(110))
        }
        // IME 内联组合:组合中拼音串插到光标处显示(下划线样式),上屏后由 获字符 进真值
        设 组合 = ""
        若 _焦 { 组合 = R.取组合串() }
        设 组合前宽 = 0
        设 组合宽 = 0
        若 组合 != "" {
            设 _前 = 真值.截取(0, _栏["光标"])
            显示值 = _前 & 组合 & 真值.截取(_栏["光标"], 真值.字符数)
            若 _字体 != 0 {
                组合前宽 = R.量字体文字(_字体, _前, 节点["_字号"], 距)
                组合宽 = R.量字体文字(_字体, 组合, 节点["_字号"], 距)
            }
        }
        设 字y = y + (h - 节点["_字号"] * 7 / 5) / 2
        若 _字体 != 0 {
            R.绘字体文字(_字体, 显示值, x + 文左 - _栏["偏移"], 字y, 节点["_字号"], 距, 字色用["r"], 字色用["g"], 字色用["b"], 字色用["a"])
        } 否 {
            R.绘文字(显示值, x + 文左 - _栏["偏移"], 字y, 节点["_字号"], 字色用["r"], 字色用["g"], 字色用["b"], 字色用["a"])
        }
        // 组合串下划线
        若 组合 != "" 且 _字体 != 0 {
            R.绘矩形(x + 文左 + 组合前宽 - _栏["偏移"], y + 内上 + 节点["_字号"] * 7 / 5 - 2, 组合宽, 2, 字色用["r"], 字色用["g"], 字色用["b"], 字色用["a"])
        }
        若 _焦 且 (时.毫秒() / 500) % 2 == 0 {
            设 光显x = 光标x
            若 组合 != "" { 光显x = 组合前宽 + 组合宽 }   // 组合中光标在组合串尾
            设 cx = x + 文左 + 光显x - _栏["偏移"]
            R.绘矩形(cx, y + 内上, 2, 节点["_字号"] * 7 / 5, 字色["r"], 字色["g"], 字色["b"], 字色["a"])
        }
        R.裁剪结束()
        // IME 候选框跟随光标:CFS_POINT 下候选窗落在给定点下方约 26px(被抑制组合窗的预留行高),
        // 故落点上移 26px 补偿,使候选窗顶边贴栏底。
        若 _焦 {
            R.设输入法位置(x + 文左 + 光标x - _栏["偏移"], y + h - 26)
        }
    }
    抑 类型 == "多行编辑" {
        设 t = _编态取(节点)
        设 值 = 态取(t["状态"], 节点["_栏键"])
        若 值 == 空 { 值 = "" }
        设 _焦 = (_焦点编 == 节点["_栏键"])
        若 t["光标"] < 0 { t["光标"] = 值.字符数 }
        若 t["光标"] > 值.字符数 { t["光标"] = 值.字符数 }
        // 边框:聚焦画 焦框色/焦框宽;非聚焦画 框色/边框宽(与输入栏同规)
        设 _边色 = 节点["_框色"]
        设 _边宽 = 节点["_边框宽"]
        若 _焦 {
            _边色 = 节点["_焦框色"]
            _边宽 = 节点["_焦框宽"]
        }
        设 _框动键e = "编框#" & 节点["_栏键"]
        若 非 _动画态.含?(_框动键e) { 造动画(_框动键e, {"时长": 150, "曲线": "丝滑"}) }
        _边色 = 动值(_框动键e, _边色)
        _边色 = 色(_边色["r"], _边色["g"], _边色["b"], _A(_边色["a"]))
        若 _边宽 > 0 且 _边色["a"] > 0 {
            设 _rp4 = _圆角百分(节点)
            若 _rp4 > 0 {
                R.绘圆角矩形线(x, y, w, h, _rp4, _边宽, _边色["r"], _边色["g"], _边色["b"], _边色["a"])
            } 否 {
                R.绘矩形线(x, y, w, h, _边色["r"], _边色["g"], _边色["b"], _边色["a"])
            }
        }
        设 内左 = 节点["_内边距"]["左"]
        设 内上 = 节点["_内边距"]["上"]
        设 内右 = 节点["_内边距"]["右"]
        设 内下 = 节点["_内边距"]["下"]
        设 行高 = _编行高(节点)
        设 行集 = _编行集(值)
        // 高亮缓存:值变即整文重分词(缓存驻 _编辑态,渲染期零分词开销);值每次编辑都换串,比较即失效检测
        若 节点["_高亮"] != "" 且 t["_亮源"] != 值 {
            t["_亮行"] = _亮全文(值)
            t["_亮源"] = 值
        }
        设 文左x = x + _编槽宽(节点)
        设 视高 = h - 内上 - 内下
        // 滚动偏移夹取
        设 内容高 = 行集.长度 * 行高
        设 最大偏 = 内容高 - 视高
        若 最大偏 < 0 { 最大偏 = 0 }
        若 t["滚偏"] > 最大偏 { t["滚偏"] = 最大偏 }
        若 t["滚偏"] < 0 { t["滚偏"] = 0 }
        // IME 内联组合(光标行内插入显示,下划线样式)
        设 组合 = ""
        若 _焦 { 组合 = R.取组合串() }
        设 光标rc = _编索引转行列(值, t["光标"])
        // 文本与选区(裁剪到可视区)
        R.裁剪开始(x + 内左, y + 2, w - 内左 - 内右, h - 4)
        设 se = _编选区(t)
        设 i = 0
        当 i < 行集.长度 {
            设 行y = y + 内上 + i * 行高 - t["滚偏"]
            若 行y + 行高 >= y 且 行y <= y + h {
                设 行串 = 行集[i]
                // 选区高亮(焦 且 有选区;逐行求交,文本之下)
                若 _焦 且 se[0] >= 0 {
                    设 行起 = _编行列转索引(值, i, 0)
                    设 行止 = 行起 + 行串.字符数
                    设 交起 = se[0] ; 设 交止 = se[1]
                    若 交起 < 行起 { 交起 = 行起 }
                    若 交止 > 行止 { 交止 = 行止 }
                    若 交起 < 交止 或 (se[1] > 行止 且 行止 > 行起) {
                        设 段起 = 交起 - 行起 ; 设 段止 = 交止 - 行起
                        若 se[1] > 行止 { 段止 = 行串.字符数 }
                        设 sx1 = 文左x + 量文本宽(行串.截取(0, 段起), 节点["_字号"])
                        设 sx2 = 文左x + 量文本宽(行串.截取(0, 段止), 节点["_字号"])
                        // 整行被包进选区(跨行中部)时铺满到行尾
                        若 se[0] <= 行起 且 se[1] > 行止 { sx2 = 文左x + 量文本宽(行串, 节点["_字号"]) }
                        R.绘矩形(sx1, 行y, sx2 - sx1, 行高, 70, 130, 230, _A(110))
                    }
                }
                // 行号(右对齐行号槽)
                若 节点["_行号"] {
                    设 号串 = 字(i + 1)
                    设 号宽 = 量文本宽(号串, 节点["_字号"])
                    R.绘文字(号串, 文左x - 号宽 - 节点["_字号"] / 2, 行y, 节点["_字号"], 110, 116, 128, _A(255))
                }
                // 文本(光标行且有组合时拼接组合串;组合行暂走纯文本通路,上屏后恢复高亮)
                设 显串 = 行串
                若 组合 != "" 且 i == 光标rc[0] {
                    显串 = 行串.截取(0, 光标rc[1]) & 组合 & 行串.截取(光标rc[1], 行串.字符数)
                }
                设 _画了 = 假
                若 节点["_高亮"] != "" 且 _字体 != 0 且 显串 == 行串 {
                    // 语法高亮:逐段着色,量字体文字 累积推进(raylib 无跨字形 kerning,与整行绘制等宽)
                    设 _段集 = t["_亮行"][i]
                    设 _sx = 文左x
                    遍历 _段 于 _段集 {
                        设 _段文 = 行串.截取(_段[0], _段[1])
                        若 _段文 != "" {
                            设 _段r = 字色["r"] ; 设 _段g = 字色["g"] ; 设 _段b = 字色["b"] ; 设 _段a = 字色["a"]
                            若 _段[2] != "普通" {
                                设 _段色 = 节点["_高亮色"][_段[2]]
                                _段r = _段色["r"] ; _段g = _段色["g"] ; _段b = _段色["b"] ; _段a = _A(_段色["a"])
                            }
                            R.绘字体文字(_字体, _段文, _sx, 行y, 节点["_字号"], 节点["_字距"], _段r, _段g, _段b, _段a)
                            _sx = _sx + R.量字体文字(_字体, _段文, 节点["_字号"], 节点["_字距"])
                        }
                    }
                    _画了 = 真
                }
                若 非 _画了 {
                    若 _字体 != 0 {
                        R.绘字体文字(_字体, 显串, 文左x, 行y, 节点["_字号"], 节点["_字距"], 字色["r"], 字色["g"], 字色["b"], 字色["a"])
                    } 否 {
                        R.绘文字(显串, 文左x, 行y, 节点["_字号"], 字色["r"], 字色["g"], 字色["b"], 字色["a"])
                    }
                }
                // 组合串下划线
                若 组合 != "" 且 i == 光标rc[0] 且 _字体 != 0 {
                    设 组前宽 = R.量字体文字(_字体, 行串.截取(0, 光标rc[1]), 节点["_字号"], 节点["_字距"])
                    设 组宽 = R.量字体文字(_字体, 组合, 节点["_字号"], 节点["_字距"])
                    R.绘矩形(文左x + 组前宽, 行y + 行高 - 2, 组宽, 2, 字色["r"], 字色["g"], 字色["b"], 字色["a"])
                }
            }
            i = i + 1
        }
        // 占位(空值时;与正文同走 _字体 通路——raylib 默认字体无中文字形,直接 绘文字 会显示 ???)
        若 值 == "" 且 节点["_占位"] != "" 且 组合 == "" {
            若 _字体 != 0 {
                R.绘字体文字(_字体, 节点["_占位"], 文左x, y + 内上, 节点["_字号"], 节点["_字距"], 节点["_占位色"]["r"], 节点["_占位色"]["g"], 节点["_占位色"]["b"], _A(节点["_占位色"]["a"]))
            } 否 {
                R.绘文字(节点["_占位"], 文左x, y + 内上, 节点["_字号"], 节点["_占位色"]["r"], 节点["_占位色"]["g"], 节点["_占位色"]["b"], _A(节点["_占位色"]["a"]))
            }
        }
        // 光标(焦 且 闪烁节拍;组合中光标在组合串尾)
        设 光显x = 0
        设 光标行串 = 行集[光标rc[0]]
        若 组合 != "" {
            光显x = 文左x + 量文本宽(光标行串.截取(0, 光标rc[1]), 节点["_字号"]) + 量文本宽(组合, 节点["_字号"])
        } 否 {
            光显x = 文左x + 量文本宽(光标行串.截取(0, 光标rc[1]), 节点["_字号"])
        }
        设 光y = y + 内上 + 光标rc[0] * 行高 - t["滚偏"]
        若 _焦 且 (时.毫秒() / 500) % 2 == 0 {
            R.绘矩形(光显x, 光y, 2, 行高, 节点["_字色"]["r"], 节点["_字色"]["g"], 节点["_字色"]["b"], _A(节点["_字色"]["a"]))
        }
        R.裁剪结束()
        // 滚动条(内容超视高才显示;样式与滚动容器一致)
        若 内容高 > 视高 {
            设 _拇高5 = 视高 * 视高 / 内容高
            若 _拇高5 < 24 { _拇高5 = 24 }
            设 _可滚5 = 内容高 - 视高
            设 _拇y5 = y + 内上
            若 _可滚5 > 0 { _拇y5 = _拇y5 + t["滚偏"] * (视高 - _拇高5) / _可滚5 }
            设 _条x5 = x + w - 内右 - 8
            R.绘圆角矩形(_条x5, y + 内上, 6, 视高, 100, 255, 255, 255, _A(16))
            设 _拇色5 = 90
            若 t["_拖条"] { _拇色5 = 140 }
            R.绘圆角矩形(_条x5, _拇y5, 6, _拇高5, 100, 255, 255, 255, _A(_拇色5))
        }
        // IME 候选框跟随光标(落点上移 26px 补偿,贴光标行底)
        若 _焦 {
            R.设输入法位置(光显x, 光y + 行高 - 26)
        }
    }
    抑 类型 == "按钮" {
        设 bg = 景
        若 节点["_悬浮"] 且 节点["_悬底色"]["a"] > 0 { bg = 节点["_悬底色"] }
        若 节点["_按下"] 且 节点["_按底色"]["a"] > 0 { bg = 节点["_按底色"] }
        若 节点["_禁用"] 且 节点["_禁底色"]["a"] > 0 { bg = 节点["_禁底色"] }
        // 内建缓动:底色/字色随状态切换丝滑过渡(_钮序 由前奏微交互块分配)
        设 _钮键 = "钮#" & _钮序
        若 非 _动画态.含?(_钮键) { 造动画(_钮键, {"时长": 120, "曲线": "丝滑"}) }
        bg = 动值(_钮键, bg)
        // 渐变判定必须在透明度包裹之前:包裹后的 bg 与原始 景 永不相等会误判走纯色
        设 _静态底 = _值相等(bg, 景)
        bg = 色(bg["r"], bg["g"], bg["b"], _A(bg["a"]))
        设 _rpb = _圆角百分(节点)
        // 背景(千分定点亚像素):静态且有渐变第二色时走渐变纹理,否则纯色圆角矩形
        若 节点["_底色2"]["a"] > 0 且 _静态底 {
            设 _向b = 1
            若 节点["_渐变向"] == "横" { _向b = 0 }
            设 _gtb = R.生成渐变纹理(w, h, 景["r"], 景["g"], 景["b"], 景["a"],
                节点["_底色2"]["r"], 节点["_底色2"]["g"], 节点["_底色2"]["b"], 节点["_底色2"]["a"],
                _向b, 节点["_圆角"], 节点["_羽化"])
            // 渐变随纹理烘焙,不透明度改由绘制 tint 乘入
            若 _gtb > 0 { R.绘纹理区精(_gtb, _bxk, _byk, _bwk, _bhk, 255, 255, 255, _A(255)) }
        } 否 {
            若 _rpb > 0 {
                R.绘圆角矩形精(_bxk, _byk, _bwk, _bhk, _rpb, bg["r"], bg["g"], bg["b"], bg["a"])
            } 否 {
                R.绘矩形精(_bxk, _byk, _bwk, _bhk, bg["r"], bg["g"], bg["b"], bg["a"])
            }
        }
        // 边框(状态边色已在微交互块丝滑过渡;前奏为按钮跳过,这里千分定点自绘)
        若 框宽 > 0 且 框色["a"] > 0 {
            若 _rpb > 0 {
                R.绘圆角矩形线精(_bxk, _byk, _bwk, _bhk, _rpb, 框宽, 框色["r"], 框色["g"], 框色["b"], 框色["a"])
            } 否 {
                R.绘矩形线精(_bxk, _byk, _bwk, _bhk, 框宽, 框色["r"], 框色["g"], 框色["b"], 框色["a"])
            }
        }
        设 内距 = 节点["_内边距"]
        // 文字随按钮 GPU 缩放(图集双线性拉伸;不换字号重光栅化——重光栅化 hinting 变化会"变形")
        设 _文缩千 = _钮缩 * 10
        设 文本宽千 = 量文本宽(节点["_文本"], 节点["_字号"]) * _文缩千
        // 文字坐标像素对齐(半像素位置会被双线性重采样成虚边;框体保持千分定点平滑,文字贴整像素保锐利)
        设 tx千 = (_bxk + (_bwk - 文本宽千) / 2 + 内距["左"] * 1000 + 500) / 1000 * 1000
        设 ty千 = (_byk + 内距["上"] * 1000 + 500) / 1000 * 1000
        // 文字三态:按下>悬浮>常态(默认透明=不覆盖,沿用常态字色)
        设 字色选 = 字色
        若 节点["_悬浮"] 且 节点["_悬字色"]["a"] > 0 { 字色选 = 节点["_悬字色"] }
        若 节点["_按下"] 且 节点["_按字色"]["a"] > 0 { 字色选 = 节点["_按字色"] }
        若 节点["_禁用"] 且 节点["_禁字色"]["a"] > 0 { 字色选 = 节点["_禁字色"] }
        设 _钮字键 = "钮字#" & _钮序
        若 非 _动画态.含?(_钮字键) { 造动画(_钮字键, {"时长": 120, "曲线": "丝滑"}) }
        字色选 = 动值(_钮字键, 字色选)
        字色选 = 色(字色选["r"], 字色选["g"], 字色选["b"], _A(字色选["a"]))
        若 _字体 != 0 {
            R.绘字体文字精(_字体, 节点["_文本"], tx千, ty千, _文缩千, 节点["_字号"], 1, 字色选["r"], 字色选["g"], 字色选["b"], 字色选["a"])
        } 否 {
            R.绘文字(节点["_文本"], tx千 / 1000, ty千 / 1000, 节点["_字号"], 字色选["r"], 字色选["g"], 字色选["b"], 字色选["a"])
        }
    }
    抑 类型 == "矩形" {
        // 底色未设(透明)时才用 字色 填充(历史行为兼容);设了底色由前奏绘制,此分支跳过
        若 节点["_底色"]["a"] == 0 {
            R.绘矩形(x, y, w, h, 字色["r"], 字色["g"], 字色["b"], 字色["a"])
        }
    }
    抑 类型 == "滚动容器" {
        // 可视区裁剪:子节点布局时已被滚动量平移,超出的部分由裁剪截掉
        R.裁剪开始(x, y, w, h)
        遍历 子 于 节点["_子"] { 渲染(子) }
        R.裁剪结束()
        // 滚动条:内容超高才显示;轨道淡底 + 圆角拇指
        设 _态v = _滚态取("滚#" & 节点["_滚序"])
        若 节点["_滚动条"] 且 _态v["内容高"] > _态v["视高"] {
            设 _视 = _态v["视高"]
            设 _内 = _态v["内容高"]
            设 _拇高 = _视 * _视 / _内
            若 _拇高 < 24 { _拇高 = 24 }
            设 _可滚 = _内 - _视
            设 _拇y = y + 节点["_内边距"]["上"]
            若 _可滚 > 0 { _拇y = _拇y + _态v["滚动量"] * (_视 - _拇高) / _可滚 }
            设 _条宽v = 节点["_条宽"]
            设 _条x = x + w - 节点["_内边距"]["右"] - _条宽v - 2
            设 _轨色 = 节点["_轨道色"]
            _轨色 = 色(_轨色["r"], _轨色["g"], _轨色["b"], _A(_轨色["a"]))
            R.绘圆角矩形(_条x, y + 节点["_内边距"]["上"], _条宽v, _视, 100, _轨色["r"], _轨色["g"], _轨色["b"], _轨色["a"])
            设 _拇色 = 节点["_拇指色"]
            若 _态v["拖动中"] { _拇色 = 节点["_拇指拖色"] }
            _拇色 = 色(_拇色["r"], _拇色["g"], _拇色["b"], _A(_拇色["a"]))
            R.绘圆角矩形(_条x, _拇y, _条宽v, _拇高, 100, _拇色["r"], _拇色["g"], _拇色["b"], _拇色["a"])
        }
    }
    抑 类型 == "图片" {
        // 源/图标色皆可状态覆写(悬/按/禁各一图一色);SVG 按最大边光栅化保清晰
        设 _源r = _态键渲(节点, "源")
        若 _源r != "" 且 w > 0 且 h > 0 {
            设 _寸r = w
            若 h > w { _寸r = h }
            设 _纹r = _取图标纹理(_源r, _寸r)
            若 _纹r > 0 {
                设 _图色r = _态键渲(节点, "图标色")
                _图色r = 色(_图色r["r"], _图色r["g"], _图色r["b"], _A(_图色r["a"]))
                R.绘纹理区(_纹r, x, y, w, h, _图色r["r"], _图色r["g"], _图色r["b"], _图色r["a"])
            }
        }
    }
    抑 类型 == "行" 或 类型 == "列" 或 类型 == "叠" 或 类型 == "绝对" {
        // 裁剪选项:子树超出节点边界即裁(收起动画/抽屉遮边用),视口外命中由悬浮/点击侧剔除
        若 节点["_裁剪"] {
            R.裁剪开始(x, y, w, h)
            遍历 子 于 节点["_子"] { 渲染(子) }
            R.裁剪结束()
        } 否 {
            遍历 子 于 节点["_子"] { 渲染(子) }
        }
    }
    _透当 = _透存
}

// ============================================================
// 输入事件
// ============================================================
公 函 处理悬浮(节点, 鼠x, 鼠y) {
    若 非 节点["_可视"] { 返 假 }
    // 全透明(不透明度0)子树不吃命中——渲染侧整树不可见,交互侧同步跳过
    若 _态键布(节点, "不透明度") <= 0 { 节点["_悬浮"] = 假 ; 节点["_按下"] = 假 ; 返 假 }
    设 在内部 = 鼠x >= 节点["_布x"] 且 鼠x < 节点["_布x"] + 节点["_布w"]
                且 鼠y >= 节点["_布y"] 且 鼠y < 节点["_布y"] + 节点["_布h"]
    // 滚动容器:悬浮时吃滚轮(一格 40px,目标量由布局帧丝滑补间)
    // 滚轮读 _轮增量:帧循环/轮询周期统一汇入,此处只消费不直读(防跨周期丢滚轮)
    若 节点["_类型"] == "滚动容器" 且 在内部 {
        设 _轮 = _轮增量
        若 _轮 != 0 {
            设 _态w = _滚态取("滚#" & 节点["_滚序"])
            _态w["目标"] = _态w["目标"] - _轮 * 40
        }
    }
    // 多行编辑:悬浮时吃滚轮(直接调滚动偏移,一格 40px)
    若 节点["_类型"] == "多行编辑" 且 在内部 {
        设 _轮e = _轮增量
        若 _轮e != 0 {
            设 _te = _编态取(节点)
            _te["滚偏"] = _te["滚偏"] - _轮e * 40
        }
    }
    若 节点["_禁用"] {
        // 禁用态不吃任何交互(悬浮/按下恒假)
        节点["_悬浮"] = 假
        节点["_按下"] = 假
    } 否 {
        节点["_悬浮"] = 在内部
        // 按下态跟随按压源:只有"按压起始在本控件"才显示(按住左键扫过不亮);
        // 身份串与 处理点击 一致,_按压键 只在按压沿登记给可点击节点
        节点["_按下"] = 在内部 且 _左键按住 且 _按压键 == _身份(节点)
    }
    // 输入栏/多行编辑悬浮登记:鼠标样式切 I 形(帧循环统一应用;禁用不算)
    若 (节点["_类型"] == "输入栏" 或 节点["_类型"] == "多行编辑") 且 在内部 且 非 节点["_禁用"] { _悬栏 = 真 }
    // 布局期状态覆写用的悬浮身份登记(带覆写节点才登记;递归倒序,最深覆盖)
    若 在内部 且 节点["_有覆"] { _悬身份 = _身份(节点) }
    若 节点["_子"].长度 > 0 {
        // 滚动容器/裁剪容器视口外:子树一律按"鼠标在屏外"处理,界外子节点不得有悬浮/按下态
        若 (节点["_类型"] == "滚动容器" 或 节点["_裁剪"]) 且 非 在内部 {
            遍历 子 于 节点["_子"] { 处理悬浮(子, -99999, -99999) }
        } 否 {
            遍历 子 于 节点["_子"] { 处理悬浮(子, 鼠x, 鼠y) }
        }
    }
    返 在内部
}

公 函 处理点击(节点, 鼠x, 鼠y) {
    若 节点["_可视"] == 假 { 返 空 }
    // 全透明(不透明度0)子树不吃命中
    若 _态键布(节点, "不透明度") <= 0 { 返 空 }
    设 在内部 = 鼠x >= 节点["_布x"] 且 鼠x < 节点["_布x"] + 节点["_布w"]
                且 鼠y >= 节点["_布y"] 且 鼠y < 节点["_布y"] + 节点["_布h"]

    // 输入栏:获焦/光标定位/框选(优先于 _点击 分派)
    若 节点["_类型"] == "输入栏" {
        设 _按下沿b = _左键按住 且 非 _左键上帧
        若 _按下沿b 且 在内部 {
            设 _bk2 = 节点["_栏键"]
            _焦点栏 = _bk2
            若 非 _输入栏态.含?(_bk2) {
                _输入栏态[_bk2] = _造栏态(节点)
            }
            设 _栏2 = _输入栏态[_bk2]
            _栏2["状态"] = 节点["_状态"]
            // 右图标点击区(v1.2.0):命中则仅触发回调(如"一键清空"),不挪光标不进框选
            若 节点["_右图标"] != "" 且 节点["_右图标点击"] != 空 {
                设 _图寸c = 节点["_图标尺寸"]
                若 _图寸c <= 0 { _图寸c = 节点["_布h"] - 节点["_内边距"]["上"] - 节点["_内边距"]["下"] }
                若 _图寸c < 8 { _图寸c = 8 }
                若 鼠x >= 节点["_布x"] + 节点["_布w"] - 节点["_内边距"]["右"] - _图寸c {
                    节点["_右图标点击"]()
                    返 节点
                }
            }
            _栏定位光标(节点, _栏2, 鼠x)
            // 框选起点:锚点=当前光标,进入框选态
            _栏2["选锚"] = _栏2["光标"]
            _栏2["_框选"] = 真
            返 节点
        }
        // 框选拖动(左键按住;允许拖出栏外,按 x 收敛)
        设 _bk3 = 节点["_栏键"]
        若 _输入栏态.含?(_bk3) {
            设 _栏3 = _输入栏态[_bk3]
            若 _栏3["_框选"] {
                若 _左键按住 {
                    _栏定位光标(节点, _栏3, 鼠x)
                } 否 {
                    _栏3["_框选"] = 假
                    // 松开后锚点==光标 = 空选区,清掉
                    若 _栏3["选锚"] == _栏3["光标"] { _栏3["选锚"] = -1 }
                }
            }
        }
    }

    // 多行编辑:获焦/定位/框选/滚动条拖拽(优先于 _点击 分派)
    若 节点["_类型"] == "多行编辑" {
        设 t = _编态取(节点)
        设 _按下沿e = _左键按住 且 非 _左键上帧
        设 行高e = _编行高(节点)
        设 视高e = 节点["_布h"] - 节点["_内边距"]["上"] - 节点["_内边距"]["下"]
        设 值e = 态取(t["状态"], 节点["_栏键"])
        若 值e == 空 { 值e = "" }
        设 内容高e = _编行集(值e).长度 * 行高e
        若 _按下沿e 且 在内部 {
            _焦点编 = 节点["_栏键"]
            _焦点栏 = ""   // 与输入栏焦点互斥
            // 滚动条拇指命中(内容超视高时;上下各让 4px 手福音量)
            若 内容高e > 视高e {
                设 _拇高c = 视高e * 视高e / 内容高e
                若 _拇高c < 24 { _拇高c = 24 }
                设 _可滚c = 内容高e - 视高e
                设 _拇顶c = 节点["_布y"] + 节点["_内边距"]["上"]
                若 _可滚c > 0 { _拇顶c = _拇顶c + t["滚偏"] * (视高e - _拇高c) / _可滚c }
                设 _条区x = 节点["_布x"] + 节点["_布w"] - 节点["_内边距"]["右"] - 14
                若 鼠x >= _条区x 且 鼠y >= _拇顶c - 4 且 鼠y < _拇顶c + _拇高c + 4 {
                    t["_拖条"] = 真
                    t["_拖起y"] = 鼠y
                    t["_拖起偏"] = t["滚偏"]
                    返 节点
                }
            }
            t["光标"] = _编定位(节点, t, 鼠x, 鼠y)
            t["选锚"] = t["光标"]
            t["_框选"] = 真
            返 节点
        }
        // 滚动条拖拽中
        若 t["_拖条"] {
            若 _左键按住 {
                设 _行程c = 视高e - 视高e * 视高e / 内容高e
                若 视高e * 视高e / 内容高e < 24 { _行程c = 视高e - 24 }
                若 _行程c > 0 且 内容高e > 视高e {
                    t["滚偏"] = t["_拖起偏"] + (鼠y - t["_拖起y"]) * (内容高e - 视高e) / _行程c
                }
            } 否 {
                t["_拖条"] = 假
            }
            返 节点
        }
        // 框选拖动(左键按住;允许拖出边界,按坐标收敛)
        若 t["_框选"] {
            若 _左键按住 {
                t["光标"] = _编定位(节点, t, 鼠x, 鼠y)
            } 否 {
                t["_框选"] = 假
                若 t["选锚"] == t["光标"] { t["选锚"] = -1 }
            }
            返 节点
        }
    }

    // 滚动容器:滚动条拖拽 + 视口外不下发(滚出视口的子节点不应响应)
    若 节点["_类型"] == "滚动容器" {
        设 _态d = _滚态取("滚#" & 节点["_滚序"])
        设 _按下沿d = _左键按住 且 非 _左键上帧
        若 _按下沿d 且 在内部 且 节点["_滚动条"] 且 _态d["内容高"] > _态d["视高"] {
            // 只有按住拇指才进入拖拽(对齐渲染:条右缘距内右边距 2px,上下各让 4px 手福音量)
            设 _视t = _态d["视高"]
            设 _内t = _态d["内容高"]
            设 _拇高t = _视t * _视t / _内t
            若 _拇高t < 24 { _拇高t = 24 }
            设 _可滚t = _内t - _视t
            设 _拇顶 = 节点["_布y"] + 节点["_内边距"]["上"]
            若 _可滚t > 0 { _拇顶 = _拇顶 + _态d["滚动量"] * (_视t - _拇高t) / _可滚t }
            设 _条区x = 节点["_布x"] + 节点["_布w"] - 节点["_内边距"]["右"] - 节点["_条宽"] - 6
            若 鼠x >= _条区x 且 鼠y >= _拇顶 - 4 且 鼠y < _拇顶 + _拇高t + 4 {
                _态d["拖动中"] = 真
                _态d["拖动起y"] = 鼠y
                _态d["拖动起目标"] = _态d["目标"]
                返 节点
            }
        }
        若 _态d["拖动中"] {
            若 _左键按住 {
                设 _视d = _态d["视高"]
                设 _内d = _态d["内容高"]
                设 _拇高d = _视d * _视d / _内d
                若 _拇高d < 24 { _拇高d = 24 }
                设 _可滚d = _内d - _视d
                设 _行程d = _视d - _拇高d
                若 _行程d > 0 且 _可滚d > 0 {
                    _态d["目标"] = _态d["拖动起目标"] + (鼠y - _态d["拖动起y"]) * _可滚d / _行程d
                }
            } 否 {
                _态d["拖动中"] = 假
            }
            返 节点
        }
        // 视口外不下发子节点
        若 非 在内部 { 返 空 }
    }

    // 裁剪容器:视口外不下发(与滚动容器同规则)
    若 节点["_裁剪"] 且 非 在内部 { 返 空 }

    // 先递归子节点(倒序,上层优先)
    设 k = 节点["_子"].长度 - 1
    当 k >= 0 {
        设 点中 = 处理点击(节点["_子"][k], 鼠x, 鼠y)
        若 点中 != 空 { 返 点中 }
        k = k - 1
    }

    若 节点["_点击"] != 空 且 非 节点["_禁用"] {
        设 模式 = 节点["_触发"]
        设 按下沿 = _左键按住 且 非 _左键上帧
        设 松开沿 = (非 _左键按住) 且 _左键上帧
        // 节点身份串(跨帧识别:树每帧重建,靠坐标+宽+文本认回同一个按钮)
        设 身份 = _身份(节点)
        若 模式 == "按下" {
            // 按下即发(旧「点击」行为);按压源也要登记/出清,否则该模式的按下态永不亮或残留
            若 按下沿 且 在内部 {
                _按压键 = 身份
                节点["_点击"]()
                返 节点
            }
            若 松开沿 或 非 _左键按住 {
                若 _按压键 == 身份 { _按压键 = "" }
            }
        } 抑 模式 == "按住" {
            // 按住连发:默认按下即发;设了「首按延迟」则按住超过该时长才开始按「连发间隔」连发
            若 按下沿 且 在内部 {
                _按压键 = 身份
                _按住起 = 时.毫秒()
                _按住末次 = 时.毫秒()
                若 节点["_首按延迟"] == 0 { 节点["_点击"]() }
            }
            若 _按压键 == 身份 且 _左键按住 且 在内部 {
                设 现 = 时.毫秒()
                若 现 - _按住起 >= 节点["_首按延迟"] 且 现 - _按住末次 >= 节点["_连发间隔"] {
                    节点["_点击"]()
                    _按住末次 = 现
                }
            }
            若 松开沿 或 非 _左键按住 {
                若 _按压键 == 身份 { _按压键 = "" }
            }
        } 否 {
            // 点击(默认,语义修正):按下在内部记录按压源,松开也在内部才触发;
            // 设了「首按延迟」则按住超时时进入连发(此时松开不再补单击)——单击/长按连发两用按钮
            若 按下沿 且 在内部 {
                _按压键 = 身份
                _按住起 = 时.毫秒()
                _按住末次 = 时.毫秒()
                _已连发 = 假
            }
            若 节点["_首按延迟"] > 0 且 _按压键 == 身份 且 _左键按住 且 在内部 {
                设 现长 = 时.毫秒()
                若 现长 - _按住起 >= 节点["_首按延迟"] 且 现长 - _按住末次 >= 节点["_连发间隔"] {
                    节点["_点击"]()
                    _按住末次 = 现长
                    _已连发 = 真
                }
            }
            若 松开沿 {
                若 _按压键 == 身份 且 在内部 且 非 _已连发 { 节点["_点击"]() }
                若 _按压键 == 身份 { _按压键 = "" }
            }
        }
    }
    返 空
}

// ---- 输入栏辅助 ----

// 图标纹理缓存(v1.2.0):路径@尺寸 → 纹理句柄。随进程生命周期不卸载(图标通常常驻 UI);
// .svg 走 nanosvg 光栅化,其余扩展名走 raylib 位图解码(png/jpg/bmp/gif 等)
设 _图标缓存 = {}
函 _取图标纹理(路径, 尺寸) {
    设 键 = 路径 & "@" & 尺寸
    若 _图标缓存.含?(键) { 返 _图标缓存[键] }
    设 纹 = 0
    设 _尾 = ""
    若 路径.字符数 > 4 { _尾 = 路径.截取(路径.字符数 - 4, 路径.字符数) }
    若 _尾 == ".svg" {
        纹 = R.加载SVG纹理(路径, 尺寸, 尺寸)
    } 否 {
        纹 = R.加载纹理(路径)
    }
    若 纹 > 0 { _图标缓存[键] = 纹 }
    返 纹
}

// 栏态工厂(两处注册点统一走这里,防字段漏初始化)
函 _造栏态(节点) {
    返 {"状态": 节点["_状态"], "光标": -1, "偏移": 0, "只读": 节点["_只读"], "提交": 节点["_提交"],
        "选锚": -1, "_发键": 0, "_发起": 0, "_发末": 0, "_框选": 假}
}

// 按鼠标 x 反推最近字符插入位(逐字符中点判定;获焦点击与框选拖动复用)
函 _栏定位光标(节点, 栏, 鼠x) {
    设 _v = 态取(节点["_状态"], 节点["_栏键"])
    若 _v == 空 { _v = "" }
    // 文本区左缘:左图标存在时内缩 图标尺寸+图标距(与绘制侧一致)
    设 _文左 = 节点["_内边距"]["左"]
    若 节点["_左图标"] != "" {
        设 _图寸p = 节点["_图标尺寸"]
        若 _图寸p <= 0 { _图寸p = 节点["_布h"] - 节点["_内边距"]["上"] - 节点["_内边距"]["下"] }
        若 _图寸p < 8 { _图寸p = 8 }
        _文左 = _文左 + _图寸p + 节点["_图标距"]
    }
    设 _距 = 节点["_字距"]
    设 _目x = 鼠x - (节点["_布x"] + _文左) + 栏["偏移"]
    设 _ci = 0
    若 _字体 != 0 {
        当 _ci < _v.字符数 {
            设 _w1 = R.量字体文字(_字体, _v.截取(0, _ci), 节点["_字号"], _距)
            设 _w2 = R.量字体文字(_字体, _v.截取(0, _ci + 1), 节点["_字号"], _距)
            若 _目x <= (_w1 + _w2) / 2 { 断 }
            _ci = _ci + 1
        }
    } 否 {
        _ci = _v.字符数
    }
    栏["光标"] = _ci
}

// 当前选区 → [小端, 大端];无选区返 [-1, -1]
函 _栏选区(栏) {
    设 锚 = 栏["选锚"]
    设 光 = 栏["光标"]
    若 锚 < 0 或 锚 == 光 { 返 [-1, -1] }
    若 锚 < 光 { 返 [锚, 光] }
    返 [光, 锚]
}

// 删除选区文本(有选区时);返 是否有选区被删
函 _栏删选区(状态, 键, 栏) {
    设 se = _栏选区(栏)
    若 se[0] < 0 { 返 假 }
    设 值 = 态取(状态, 键)
    若 值 == 空 { 值 = "" }
    态设(状态, 键, 值.截取(0, se[0]) & 值.截取(se[1], 值.字符数))
    栏["光标"] = se[0]
    栏["选锚"] = -1
    返 真
}

// 按键连发判定:按下沿立即触发一次,按住超 首延 后按 间隔 连发(方向键/退格复用)
函 _连发判定(栏, 键码, 首延, 间隔) {
    若 R.键刚按下?(键码) {
        栏["_发键"] = 键码
        栏["_发起"] = 时.毫秒()
        栏["_发末"] = 时.毫秒()
        返 真
    }
    若 栏["_发键"] == 键码 且 R.键按下?(键码) {
        设 现 = 时.毫秒()
        若 现 - 栏["_发起"] >= 首延 且 现 - 栏["_发末"] >= 间隔 {
            栏["_发末"] = 现
            返 真
        }
    }
    若 非 R.键按下?(键码) 且 栏["_发键"] == 键码 { 栏["_发键"] = 0 }
    返 假
}

// ---- 多行编辑器(铸造厂 CodeEdit 地基) ----
设 _编辑态 = {}
设 _焦点编 = ""

// 栏态惰性注册(节点每帧重建,状态/只读每帧经渲染分支汇入)
函 _编态取(节点) {
    设 k = 节点["_栏键"]
    若 非 _编辑态.含?(k) {
        _编辑态[k] = {"状态": 节点["_状态"], "光标": -1, "选锚": -1, "滚偏": 0, "只读": 节点["_只读"],
                      "_框选": 假, "_拖条": 假, "_拖起y": 0, "_拖起偏": 0, "_发键": 0, "_发起": 0, "_发末": 0,
                      "_亮源": 空, "_亮行": []}
    }
    设 t = _编辑态[k]
    t["状态"] = 节点["_状态"]
    t["只读"] = 节点["_只读"]
    返 t
}

函 _编行高(节点) { 返 节点["_字号"] * 7 / 5 }

// 行号槽宽(含左内边距;关行号时即左内边距)
函 _编槽宽(节点) {
    若 非 节点["_行号"] { 返 节点["_内边距"]["左"] }
    返 节点["_内边距"]["左"] + 节点["_字号"] * 3
}

// 文本 → 行数组(空串视作一行;逻辑字符索引,与 输入栏 同一套)
函 _编行集(值) {
    若 值 == "" { 返 [""] }
    返 值.分割("\n")
}

// 索引 → [行, 列](夹取到文本范围)
函 _编索引转行列(值, 索引) {
    设 n = 值.字符数
    若 索引 > n { 索引 = n }
    若 索引 < 0 { 索引 = 0 }
    设 行 = 0 ; 设 列 = 0 ; 设 i = 0
    当 i < 索引 {
        若 值.截取(i, i + 1) == "\n" { 行 = 行 + 1 ; 列 = 0 } 否 { 列 = 列 + 1 }
        i = i + 1
    }
    返 [行, 列]
}

// [行, 列] → 索引(行列各自夹取)
函 _编行列转索引(值, 行, 列) {
    设 行集 = _编行集(值)
    若 行 < 0 { 行 = 0 }
    若 行 > 行集.长度 - 1 { 行 = 行集.长度 - 1 }
    设 行串 = 行集[行]
    若 列 > 行串.字符数 { 列 = 行串.字符数 }
    若 列 < 0 { 列 = 0 }
    设 基 = 0 ; 设 i = 0
    当 i < 行 {
        基 = 基 + 行集[i].字符数 + 1
        i = i + 1
    }
    返 基 + 列
}

// 上下方向键:保持列、跨行夹取
函 _编上下移(值, 光标, 方向) {
    设 rc = _编索引转行列(值, 光标)
    设 行集 = _编行集(值)
    设 行 = rc[0] + 方向
    若 行 < 0 { 行 = 0 }
    若 行 > 行集.长度 - 1 { 行 = 行集.长度 - 1 }
    设 列 = rc[1]
    若 列 > 行集[行].字符数 { 列 = 行集[行].字符数 }
    返 _编行列转索引(值, 行, 列)
}

// 鼠标点 → 最近字符索引(按行高定行、按前缀宽定列,半字符取整)
函 _编定位(节点, t, 鼠x, 鼠y) {
    设 值 = 态取(t["状态"], 节点["_栏键"])
    若 值 == 空 { 值 = "" }
    设 行集 = _编行集(值)
    设 行高 = _编行高(节点)
    设 行i = (鼠y - 节点["_布y"] - 节点["_内边距"]["上"] + t["滚偏"]) / 行高
    若 行i < 0 { 行i = 0 }
    若 行i > 行集.长度 - 1 { 行i = 行集.长度 - 1 }
    设 行串 = 行集[行i]
    设 文左 = 节点["_布x"] + _编槽宽(节点)
    设 列 = 0
    若 鼠x > 文左 {
        列 = 行串.字符数
        设 c = 0
        当 c < 行串.字符数 {
            设 半 = 量文本宽(行串.截取(c, c + 1), 节点["_字号"])
            设 前 = 量文本宽(行串.截取(0, c), 节点["_字号"])
            若 文左 + 前 + 半 / 2 > 鼠x { 列 = c ; 断 }
            c = c + 1
        }
    }
    返 _编行列转索引(值, 行i, 列)
}

// 删除选区(有选区则删并收拢光标;无则不动。返 是否删了)
函 _编删选区(状态, 键, t) {
    若 t["选锚"] < 0 或 t["选锚"] == t["光标"] { t["选锚"] = -1 ; 返 假 }
    设 值 = 态取(状态, 键)
    若 值 == 空 { 值 = "" }
    设 lo = t["选锚"] ; 设 hi = t["光标"]
    若 lo > hi { 设 tmp = lo ; lo = hi ; hi = tmp }
    态设(状态, 键, 值.截取(0, lo) & 值.截取(hi, 值.字符数))
    t["光标"] = lo
    t["选锚"] = -1
    返 真
}

// 选区 → [起, 止](有序;无选区返 [-1,-1])
函 _编选区(t) {
    若 t["选锚"] < 0 或 t["选锚"] == t["光标"] { 返 [-1, -1] }
    设 lo = t["选锚"] ; 设 hi = t["光标"]
    若 lo > hi { 设 tmp = lo ; lo = hi ; hi = tmp }
    返 [lo, hi]
}

// ---- 语法高亮:玄铁分词器(CodeEdit 地基) ----
// 段 = [起, 止, 类](行内字符索引,左闭右开;类 ∈ 普通/关键字/字符串/注释/数字)。
// 分词对单行进行,行间只携带"多行串状态"(""/\"\"\"/\'\'\')——玄铁无块注释,无其他跨行词法。
// 字符分类照抄 xuantie_compiler/词法.xt 的字节序比较惯用法:ASCII 显式判,多字节字符整体算标识。

设 _亮关键字集 = {
    "设": 真, "常": 真, "函": 真, "型": 真, "口": 真, "外": 真, "弱": 真, "造": 真,
    "承": 真, "覆": 真, "若": 真, "抑": 真, "否": 真, "当": 真, "循": 真, "遍历": 真,
    "于": 真, "断": 真, "续": 真, "终": 真, "示": 真, "返": 真, "真": 真, "假": 真,
    "空": 真, "且": 真, "或": 真, "非": 真, "是": 真, "公": 真, "私": 真, "护": 真,
    "整": 真, "字": 真, "布尔": 真, "小数": 真, "数组": 真, "字典": 真, "结果": 真,
    "匹配": 真, "引": 真, "予": 真, "化": 真, "解": 真, "异步": 真, "等待": 真,
    "并行": 真, "尝试": 真, "捕捉": 真, "字节": 真, "任务": 真, "道": 真, "选": 真,
    "求": 真, "听": 真, "连": 真, "执": 真, "输": 真, "位与": 真, "位或": 真,
    "异或": 真, "左移": 真, "右移": 真, "取反": 真, "接着": 真, "成功": 真,
    "失败": 真, "测试": 真, "此": 真
}

函 _亮是数字(c) { 返 c >= "0" 且 c <= "9" }

// 标识符字符:字母/数字/下划线/一切多字节字符(排除空白与 ASCII 标点)
函 _亮是标识(c) {
    若 c == "_" { 返 真 }
    若 c >= "a" 且 c <= "z" { 返 真 }
    若 c >= "A" 且 c <= "Z" { 返 真 }
    若 _亮是数字(c) { 返 真 }
    若 c == " " 或 c == "\t" { 返 假 }
    设 标 = "=<>+-*/%!&|^~?:.,;()[]{}\"'`@#$\\"
    设 k = 0
    当 k < 标.字符数 {
        若 c == 标.截取(k, k + 1) { 返 假 }
        k = k + 1
    }
    返 真
}

// 追加段(相邻同类自动合并,保持段集最少)
函 _亮追加(段集, 起, 止, 类) {
    若 止 <= 起 { 返 空 }
    设 m = 段集.长度
    若 m > 0 {
        若 段集[m - 1][2] == 类 且 段集[m - 1][1] == 起 {
            段集[m - 1][1] = 止
            返 空
        }
    }
    段集.追加([起, 止, 类])
}

// 单行分词:返 [段集, 新多行串状态](状态 = "" 常态 / "\"\"\"" 或 "'''" 在三引号串中)
函 _亮分词行(行串, 状态) {
    设 段集 = []
    设 n = 行串.字符数
    设 i = 0
    // 开局已在多行串中:吃到本行闭合三连或行尾
    若 状态 != "" {
        设 闭 = 状态
        设 j = 0
        设 找着 = 假
        当 j + 3 <= n {
            若 行串.截取(j, j + 3) == 闭 { 找着 = 真 ; j = j + 3 ; 断 }
            j = j + 1
        }
        若 找着 {
            _亮追加(段集, 0, j, "字符串")
            i = j
            状态 = ""
        } 否 {
            _亮追加(段集, 0, n, "字符串")
            返 [段集, 状态]
        }
    }
    当 i < n {
        设 c = 行串.截取(i, i + 1)
        // 行注释:吃到行尾,收工
        若 c == "/" 且 i + 1 < n 且 行串.截取(i + 1, i + 2) == "/" {
            _亮追加(段集, i, n, "注释")
            i = n
            断
        }
        // 三引号多行串(同行可闭合,否则带状态收工)
        若 (c == "\"" 或 c == "'") 且 i + 3 <= n 且 行串.截取(i + 1, i + 2) == c 且 行串.截取(i + 2, i + 3) == c {
            设 闭3 = c & c & c
            设 j3 = i + 3
            设 找着3 = 假
            当 j3 + 3 <= n {
                若 行串.截取(j3, j3 + 3) == 闭3 { 找着3 = 真 ; j3 = j3 + 3 ; 断 }
                j3 = j3 + 1
            }
            若 找着3 {
                _亮追加(段集, i, j3, "字符串")
                i = j3
            } 否 {
                _亮追加(段集, i, n, "字符串")
                状态 = 闭3
                i = n
                断
            }
        }
        // 单行串(反斜杠转义跳过下一字符;未闭合吃到行尾)
        抑 c == "\"" 或 c == "'" {
            设 q = c
            设 j2 = i + 1
            当 j2 < n {
                设 c2 = 行串.截取(j2, j2 + 1)
                若 c2 == "\\" { j2 = j2 + 2 ; 续 }
                若 c2 == q { j2 = j2 + 1 ; 断 }
                j2 = j2 + 1
            }
            若 j2 > n { j2 = n }
            _亮追加(段集, i, j2, "字符串")
            i = j2
        }
        // 数字(十进制/小数/0x 十六进制)
        抑 _亮是数字(c) {
            设 jn = i
            若 c == "0" 且 i + 1 < n 且 (行串.截取(i + 1, i + 2) == "x" 或 行串.截取(i + 1, i + 2) == "X") {
                jn = i + 2
                当 jn < n {
                    设 ch = 行串.截取(jn, jn + 1)
                    若 _亮是数字(ch) 或 (ch >= "a" 且 ch <= "f") 或 (ch >= "A" 且 ch <= "F") { jn = jn + 1 } 否 { 断 }
                }
            } 否 {
                当 jn < n 且 _亮是数字(行串.截取(jn, jn + 1)) { jn = jn + 1 }
                若 jn + 1 < n 且 行串.截取(jn, jn + 1) == "." 且 _亮是数字(行串.截取(jn + 1, jn + 2)) {
                    jn = jn + 2
                    当 jn < n 且 _亮是数字(行串.截取(jn, jn + 1)) { jn = jn + 1 }
                }
            }
            _亮追加(段集, i, jn, "数字")
            i = jn
        }
        // 标识/关键字(最长 munch 后查关键字集)
        抑 _亮是标识(c) {
            设 ji = i
            当 ji < n 且 _亮是标识(行串.截取(ji, ji + 1)) { ji = ji + 1 }
            若 _亮关键字集.含?(行串.截取(i, ji)) {
                _亮追加(段集, i, ji, "关键字")
            } 否 {
                _亮追加(段集, i, ji, "普通")
            }
            i = ji
        }
        // 其余(空白/标点):逐字符普通段,_亮追加 自动合并
        否 {
            _亮追加(段集, i, i + 1, "普通")
            i = i + 1
        }
    }
    返 [段集, 状态]
}

// 全文分词(行间只带多行串状态) → 每行一份段集
函 _亮全文(值) {
    设 行集 = _编行集(值)
    设 全段 = []
    设 _亮状态 = ""
    遍历 行 于 行集 {
        设 r = _亮分词行(行, _亮状态)
        全段.追加(r[0])
        _亮状态 = r[1]
    }
    返 全段
}

// 多行键盘处理(每帧于 处理点击 后调用,焦点多行编辑器时):字符/编辑/方向/组合键
函 _处理键盘多行() {
    若 非 _编辑态.含?(_焦点编) { _焦点编 = "" ; 返 空 }
    设 t = _编辑态[_焦点编]
    设 _多状态 = t["状态"]
    设 键 = _焦点编
    设 _可写 = 非 t["只读"]
    设 _Ctrl = R.键按下?(R.键Ctrl) 或 R.键按下?(R.键右Ctrl)

    // —— Ctrl 组合键 ——
    若 _Ctrl {
        // Ctrl+A 全选
        若 R.键刚按下?(R.键A) {
            设 值a = 态取(_多状态, 键)
            若 值a == 空 { 值a = "" }
            t["选锚"] = 0
            t["光标"] = 值a.字符数
        }
        // Ctrl+C 复制选区
        若 R.键刚按下?(R.键C) {
            设 se = _编选区(t)
            若 se[0] >= 0 {
                设 值c = 态取(_多状态, 键)
                R.设剪贴板(值c.截取(se[0], se[1]))
            }
        }
        // Ctrl+X 剪切(可写时)
        若 _可写 且 R.键刚按下?(R.键X) {
            设 se2 = _编选区(t)
            若 se2[0] >= 0 {
                设 值x = 态取(_多状态, 键)
                R.设剪贴板(值x.截取(se2[0], se2[1]))
                _编删选区(_多状态, 键, t)
            }
        }
        // Ctrl+V 粘贴(多行:保留换行,与输入栏去换行语义有别)
        若 _可写 且 R.键刚按下?(R.键V) {
            设 贴 = R.取剪贴板()
            若 贴 == 空 { 贴 = "" }
            贴 = 贴.替换("\r\n", "\n").替换("\r", "\n")
            若 贴 != "" {
                _编删选区(_多状态, 键, t)
                设 值v = 态取(_多状态, 键)
                若 值v == 空 { 值v = "" }
                设 c = t["光标"]
                若 c < 0 { c = 值v.字符数 }
                态设(_多状态, 键, 值v.截取(0, c) & 贴 & 值v.截取(c, 值v.字符数))
                t["光标"] = c + 贴.字符数
            }
        }
    }

    // —— 字符输入(有选区先删选区;中文 IME 上屏字符经 获字符 拿到)——
    设 cp = R.获字符()
    当 cp != 0 {
        若 _可写 {
            _编删选区(_多状态, 键, t)
            设 值 = 态取(_多状态, 键)
            若 值 == 空 { 值 = "" }
            设 c = t["光标"]
            若 c < 0 { c = 值.字符数 }
            态设(_多状态, 键, 值.截取(0, c) & R.字自码点(cp) & 值.截取(c, 值.字符数))
            t["光标"] = c + 1
        }
        cp = R.获字符()
    }

    // —— 退格(按住连发;有选区删选区,否则删光标前一逻辑字符)——
    若 _可写 且 _连发判定(t, R.键退格, 400, 40) {
        若 非 _编删选区(_多状态, 键, t) {
            设 值 = 态取(_多状态, 键)
            若 值 == 空 { 值 = "" }
            设 c = t["光标"]
            若 c > 0 且 值.字符数 > 0 {
                态设(_多状态, 键, 值.截取(0, c - 1) & 值.截取(c, 值.字符数))
                t["光标"] = c - 1
            }
        }
    }

    // —— 回车换行(按住连发)——
    若 _可写 且 _连发判定(t, R.键回车, 400, 40) {
        _编删选区(_多状态, 键, t)
        设 值 = 态取(_多状态, 键)
        若 值 == 空 { 值 = "" }
        设 c = t["光标"]
        若 c < 0 { c = 值.字符数 }
        态设(_多状态, 键, 值.截取(0, c) & "\n" & 值.截取(c, 值.字符数))
        t["光标"] = c + 1
    }

    // —— Tab 插 4 空格(raylib KEY_TAB=258)——
    若 _可写 且 R.键刚按下?(258) {
        _编删选区(_多状态, 键, t)
        设 值 = 态取(_多状态, 键)
        若 值 == 空 { 值 = "" }
        设 c = t["光标"]
        若 c < 0 { c = 值.字符数 }
        态设(_多状态, 键, 值.截取(0, c) & "    " & 值.截取(c, 值.字符数))
        t["光标"] = c + 4
    }

    // —— 左右方向(有选区先收拢到选区边缘)——
    若 _连发判定(t, R.键左, 400, 40) {
        设 se = _编选区(t)
        若 se[0] >= 0 { t["光标"] = se[0] ; t["选锚"] = -1 }
        否 { 若 t["光标"] > 0 { t["光标"] = t["光标"] - 1 } }
    }
    若 _连发判定(t, R.键右, 400, 40) {
        设 se = _编选区(t)
        若 se[0] >= 0 { t["光标"] = se[1] ; t["选锚"] = -1 }
        否 {
            设 值 = 态取(_多状态, 键)
            若 值 == 空 { 值 = "" }
            若 t["光标"] < 值.字符数 { t["光标"] = t["光标"] + 1 }
        }
    }
    // —— 上下方向(保持列跨行)——
    若 _连发判定(t, R.键上, 400, 40) {
        设 值 = 态取(_多状态, 键)
        若 值 == 空 { 值 = "" }
        t["光标"] = _编上下移(值, t["光标"], -1)
        t["选锚"] = -1
    }
    若 _连发判定(t, R.键下, 400, 40) {
        设 值 = 态取(_多状态, 键)
        若 值 == 空 { 值 = "" }
        t["光标"] = _编上下移(值, t["光标"], 1)
        t["选锚"] = -1
    }
    // —— Home/End 行首/行尾(raylib 268/269)——
    若 R.键刚按下?(268) {
        设 值 = 态取(_多状态, 键)
        若 值 == 空 { 值 = "" }
        设 rc = _编索引转行列(值, t["光标"])
        t["光标"] = _编行列转索引(值, rc[0], 0)
        t["选锚"] = -1
    }
    若 R.键刚按下?(269) {
        设 值 = 态取(_多状态, 键)
        若 值 == 空 { 值 = "" }
        设 行集 = _编行集(值)
        设 rc = _编索引转行列(值, t["光标"])
        t["光标"] = _编行列转索引(值, rc[0], 行集[rc[0]].字符数)
        t["选锚"] = -1
    }
    // —— ESC 失焦 ——
    若 R.键刚按下?(R.键ESC) { _焦点编 = "" }
}

// 键盘输入处理(每帧于 处理点击 后调用):焦点输入栏/多行编辑器的字符输入/编辑/方向/组合键
公 函 处理键盘() {
    若 _焦点编 != "" { _处理键盘多行() ; 返 空 }
    若 _焦点栏 == "" { 返 空 }
    若 非 _输入栏态.含?(_焦点栏) { _焦点栏 = "" ; 返 空 }
    设 _栏 = _输入栏态[_焦点栏]
    设 _栏状态 = _栏["状态"]
    设 _可写 = 非 _栏["只读"]
    设 _Ctrl = R.键按下?(R.键Ctrl) 或 R.键按下?(R.键右Ctrl)

    // 值读取小闭(态取 空→"")
    // —— Ctrl 组合键 ——
    若 _Ctrl {
        // Ctrl+A 全选
        若 R.键刚按下?(R.键A) {
            设 值 = 态取(_栏状态, _焦点栏)
            若 值 == 空 { 值 = "" }
            _栏["选锚"] = 0
            _栏["光标"] = 值.字符数
        }
        // Ctrl+C 复制选区
        若 R.键刚按下?(R.键C) {
            设 se = _栏选区(_栏)
            若 se[0] >= 0 {
                设 值 = 态取(_栏状态, _焦点栏)
                若 值 == 空 { 值 = "" }
                R.设剪贴板(值.截取(se[0], se[1]))
            }
        }
        // Ctrl+X 剪切(可写时)
        若 _可写 且 R.键刚按下?(R.键X) {
            设 se = _栏选区(_栏)
            若 se[0] >= 0 {
                设 值 = 态取(_栏状态, _焦点栏)
                若 值 == 空 { 值 = "" }
                R.设剪贴板(值.截取(se[0], se[1]))
                _栏删选区(_栏状态, _焦点栏, _栏)
            }
        }
        // Ctrl+V 粘贴(去换行;单行栏惯例)
        若 _可写 且 R.键刚按下?(R.键V) {
            设 贴 = R.取剪贴板()
            若 贴 == 空 { 贴 = "" }
            贴 = 贴.替换("\r\n", "").替换("\n", "").替换("\r", "")
            若 贴 != "" {
                _栏删选区(_栏状态, _焦点栏, _栏)
                设 值 = 态取(_栏状态, _焦点栏)
                若 值 == 空 { 值 = "" }
                设 光 = _栏["光标"]
                若 光 < 0 { 光 = 值.字符数 }
                态设(_栏状态, _焦点栏, 值.截取(0, 光) & 贴 & 值.截取(光, 值.字符数))
                _栏["光标"] = 光 + 贴.字符数
            }
        }
    }

    // —— 字符输入(有选区先删选区;中文 IME 上屏字符经 获字符 拿到)——
    设 cp = R.获字符()
    当 cp != 0 {
        若 _可写 {
            _栏删选区(_栏状态, _焦点栏, _栏)
            设 值 = 态取(_栏状态, _焦点栏)
            若 值 == 空 { 值 = "" }
            设 光 = _栏["光标"]
            若 光 < 0 { 光 = 值.字符数 }
            态设(_栏状态, _焦点栏, 值.截取(0, 光) & R.字自码点(cp) & 值.截取(光, 值.字符数))
            _栏["光标"] = 光 + 1
        }
        cp = R.获字符()
    }

    // —— 退格(按住连发;有选区删选区,否则删光标前一逻辑字符)——
    若 _可写 且 _连发判定(_栏, R.键退格, 400, 40) {
        若 非 _栏删选区(_栏状态, _焦点栏, _栏) {
            设 光 = _栏["光标"]
            设 值 = 态取(_栏状态, _焦点栏)
            若 值 == 空 { 值 = "" }
            若 光 > 0 且 值.字符数 > 0 {
                态设(_栏状态, _焦点栏, 值.截取(0, 光 - 1) & 值.截取(光, 值.字符数))
                _栏["光标"] = 光 - 1
            }
        }
    }

    // —— 左右方向键(按住连发;有选区时收敛到选区端并清选区)——
    若 _连发判定(_栏, R.键左, 400, 40) {
        设 se = _栏选区(_栏)
        若 se[0] >= 0 {
            _栏["光标"] = se[0]
            _栏["选锚"] = -1
        } 否 {
            若 _栏["光标"] > 0 { _栏["光标"] = _栏["光标"] - 1 }
        }
    }
    若 _连发判定(_栏, R.键右, 400, 40) {
        设 值 = 态取(_栏状态, _焦点栏)
        若 值 == 空 { 值 = "" }
        设 se = _栏选区(_栏)
        若 se[0] >= 0 {
            _栏["光标"] = se[1]
            _栏["选锚"] = -1
        } 否 {
            若 _栏["光标"] < 值.字符数 { _栏["光标"] = _栏["光标"] + 1 }
        }
    }
    // 上=光标到首,下=光标到尾
    若 R.键刚按下?(R.键上) {
        _栏["光标"] = 0
        _栏["选锚"] = -1
    }
    若 R.键刚按下?(R.键下) {
        设 值 = 态取(_栏状态, _焦点栏)
        若 值 == 空 { 值 = "" }
        _栏["光标"] = 值.字符数
        _栏["选锚"] = -1
    }
    // 回车提交
    若 R.键刚按下?(R.键回车) {
        若 _栏["提交"] != 空 {
            设 值 = 态取(_栏状态, _焦点栏)
            若 值 == 空 { 值 = "" }
            _栏["提交"](值)
        }
    }
    // ESC 失焦(并清选区)
    若 R.键刚按下?(R.键ESC) {
        _栏["选锚"] = -1
        _焦点栏 = ""
    }
}

// ============================================================
// 响应式状态系统 — View = f(State)
// ============================================================
// 全局渲染上下文栈（支持嵌套组件）
设 _渲染栈 = []

// 输入栏全局状态(节点每帧重建,控件内部状态不能存节点):
// 键 → {"状态":状态容器引用, "光标":整, "偏移":整, "只读":布尔, "提交":回调或空}
设 _输入栏态 = {}
// 当前焦点输入栏的键("";无焦点)
设 _焦点栏 = ""

// 当前字体句柄（0 = raylib 默认字体，不支持中文）
// 由 应用/手动设字体 设置，渲染() 的文本与按钮绘制据此选择 绘字体文字/绘文字
设 _字体 = 0

// 设置全局字体（返回旧句柄）。路径为运行时相对/绝对 TTF 路径，字库字号越大越清晰(默认32)
// 注意:必须在窗口初始化之后调用(raylib 加载字形纹理需要 GL 上下文);
// 字体在程序退出前应通过 释字体 释放;应用() 会自动管理
公 函 设字体(路径, 字库字号) {
    设 旧 = _字体
    若 路径 == 空 或 路径 == "" {
        _字体 = 0
    } 否 {
        设 库号 = 32
        若 字库字号 != 空 { 库号 = 字库字号 }
        _字体 = R.加载字体(路径, 库号)
    }
    返 旧
}

// ============================================================
// 默认字体(内置鸿蒙字体:零配置中文显示,v0.19.0 起)
// ============================================================
设 _字体已尝试 = 假

// 取环境变量值(走 runtime 宽字符 API,免 cmd 子进程——cmd echo 会闪黑色终端窗口且慢)
函 _环境值(名) {
    返 xt_env_get(名)
}

// 按候选路径查找内置鸿蒙字体,返回命中路径或 ""
函 _找默认字体() {
    设 名 = "HarmonyOS_Sans_SC_Regular.ttf"
    设 候选 = []
    // ① 铁铺已安装 UI 包内
    设 home = _环境值("TIEPM_HOME")
    若 home != "" {
        候选.追加(home & "\\已安装\\UI\\assets\\" & 名)
    } 否 {
        设 up = _环境值("USERPROFILE")
        若 up != "" { 候选.追加(up & "\\.tiepm\\已安装\\UI\\assets\\" & 名) }
    }
    // ①.5 XUANTIE_HOME(安装器写入的用户环境变量 → 安装目录\lib\UI\assets)
    设 xh = _环境值("XUANTIE_HOME")
    若 xh != "" { 候选.追加(xh & "\\lib\\UI\\assets\\" & 名) }
    // ② 程序自身目录(exeDir\assets,发行包布局)
    设 自径 = xt_self_path()
    若 自径 != "" {
        设 i = 自径.字节数 - 1
        当 i >= 0 {
            设 c = 自径.截取(i, i + 1)
            若 c == "\\" 或 c == "/" {
                候选.追加(自径.截取(0, i + 1) & "assets\\" & 名)
                断
            }
            i = i - 1
        }
    }
    // ③ CWD 常见布局(项目根/子目录/仓库 lib)
    候选.追加("assets\\" & 名)
    候选.追加("..\\assets\\" & 名)
    候选.追加("lib\\UI\\assets\\" & 名)
    遍历 p 于 候选 {
        若 文件.存在?(p) { 返 p }
    }
    返 ""
}

// 确保默认字体已加载(窗口初始化后调用;用户显式 设字体/选项字体 优先,不覆盖)
// 优先 GDI 系统字体(微软雅黑:系统级光栅化视觉效果,按需栅格化,无需 ttf 文件);
// 失败回退内置鸿蒙 ttf;全未命中则回退 raylib 默认字体并提示一次(不中断)
公 函 确保默认字体() {
    若 _字体 != 0 或 _字体已尝试 { 返 空 }
    _字体已尝试 = 真
    // GDI 系统字体优先(v1.0.0 起):系统字体引擎光栅化,中文显示与系统应用同质感
    设 _gh = R.加载系统字体("微软雅黑", 32)
    若 _gh != 0 { _字体 = _gh ; 返 空 }
    设 路径 = _找默认字体()
    若 路径 != "" {
        _字体 = R.加载字体(路径, 32)
    }
    若 _字体 == 0 {
        示("[UI] 提示: 未找到内置鸿蒙字体,中文将显示为方块;请 tiepm install UI 或将 assets 放到程序旁")
    }
}

// 创建响应式状态容器
公 函 造状态(初始数据) {
    设 容器 = {}
    容器["_值"] = 初始数据
    容器["_监听"] = {}
    容器["_脏"] = 假
    容器["_依赖"] = {}
    返 容器
}

// 读取状态（渲染期内自动追踪依赖）
公 函 态取(状态, 键) {
    若 状态 == 空 { 返 空 }
    若 _渲染栈.长度 > 0 {
        设 上下文 = _渲染栈[_渲染栈.长度 - 1]
        上下文["_依赖"][键] = 真
    }
    若 状态["_值"].含?(键) { 返 状态["_值"][键] }
    返 空
}

// 设置状态（变化时通知订阅者）
公 函 态设(状态, 键, 新值) {
    若 状态 == 空 { 返 空 }
    设 旧值 = 空
    若 状态["_值"].含?(键) { 旧值 = 状态["_值"][键] }
    若 旧值 == 新值 { 返 空 }
    状态["_值"][键] = 新值
    若 状态["_监听"].含?(键) {
        遍历 cb 于 状态["_监听"][键] {
            若 cb != 空 { cb() }
        }
    }
    状态["_脏"] = 真
}

// 订阅状态变化
公 函 态观(状态, 键, 回调) {
    若 状态 == 空 { 返 空 }
    若 非 状态["_监听"].含?(键) { 状态["_监听"][键] = [] }
    状态["_监听"][键].追加(回调)
}

// 批量设置
公 函 态设批(状态, 变更表) {
    若 状态 == 空 { 返 空 }
    遍历 键 于 变更表 { 态设(状态, 键, 变更表[键]) }
}

// 状态快照（不追踪依赖）
公 函 态快照(状态) {
    若 状态 == 空 { 返 {} }
    返 状态["_值"]
}

// 检查是否脏
公 函 态脏?(状态) {
    若 状态 == 空 { 返 假 }
    返 状态["_脏"]
}

// 标记脏
公 函 标脏(状态) {
    若 状态 == 空 { 返 空 }
    状态["_脏"] = 真
}

// 获取依赖键列表
公 函 态依赖(状态) {
    若 状态 == 空 { 返 [] }
    设 键列表 = []
    遍历 键 于 状态["_依赖"] { 键列表.追加(键) }
    返 键列表
}

// 清除所有订阅
公 函 态清除(状态) {
    若 状态 == 空 { 返 空 }
    状态["_监听"] = {} ; 状态["_依赖"] = {} ; 状态["_脏"] = 假
}

// 进入渲染上下文
函 _进上下文(状态) {
    设 上下文 = {}
    上下文["_依赖"] = {}
    _渲染栈.追加(上下文)
    状态["_依赖"] = {}
    状态["_脏"] = 假
    返 上下文
}

// 退出渲染上下文
函 _退上下文() {
    若 _渲染栈.长度 > 0 {
        设 新栈 = []
        设 i = 0
        当 i < _渲染栈.长度 - 1 {
            新栈.追加(_渲染栈[i])
            i = i + 1
        }
        _渲染栈 = 新栈
    }
}

// 应用框架：状态变化时自动重绘
// 构建函(状态) → 返回控件树根节点
// 选项: {"宽":800, "高":600, "标题":"App", "字体":"路径.ttf", "字库字号":32, "按需重绘":真,
//        "背景": 色(40,40,50,255), "可调整": 假, "全屏": 假, "无边框": 假}
// 按需重绘:默认开——无脏源(状态/输入/动画/输入栏聚焦)时泵事件空转不画帧,空闲近零占用;
// 设为 假 回到纯 60fps 全量渲染循环(排查重绘问题时的对照逃生门)
// 背景:整窗清底色(默认深灰 40,40,50);可调整:真 时窗口允许拖拽调大小(默认固定)
// 全屏:真 时进入全屏并按真实屏幕尺寸布局(否则内容只占左上角 宽x高);
// 无边框:真 时去掉标题栏与边框(同时失去系统最小化/关闭按钮,需自行提供退出途径)
公 函 应用(状态, 构建函, 选项) {
    若 状态 == 空 或 构建函 == 空 { 返 空 }

    设 宽 = 800 ; 设 高 = 600 ; 设 标题 = "XuanTie App"
    设 按需 = 真
    设 背景 = 色(40, 40, 50, 255)
    设 可调整 = 假
    设 全屏 = 假
    设 无边框 = 假
    若 选项 != 空 {
        若 选项.含?("宽") { 宽 = 选项["宽"] }
        若 选项.含?("高") { 高 = 选项["高"] }
        若 选项.含?("标题") { 标题 = 选项["标题"] }
        若 选项.含?("按需重绘") { 按需 = 选项["按需重绘"] }
        若 选项.含?("背景") { 背景 = 选项["背景"] }
        若 选项.含?("可调整") { 可调整 = 选项["可调整"] }
        若 选项.含?("全屏") { 全屏 = 选项["全屏"] }
        若 选项.含?("无边框") { 无边框 = 选项["无边框"] }
    }

    // 字体:选项["字体"] 传 TTF 路径即启用中文字体(自动加载/卸载);
    // 选项["字库字号"] 可指定栅格化字号(默认32,越大越清晰、纹理越大)
    R.初始化窗口(宽, 高, 标题)
    若 可调整 { R.设窗口可调整(真) }
    若 无边框 { R.设窗口无边框(真) }
    若 全屏 {
        R.设窗口全屏(真)
        // 全屏后按真实屏幕尺寸布局(否则内容只占左上角 宽x高)
        宽 = R.取屏幕宽()
        高 = R.取屏幕高()
    }
    R.安装输入法钩子()   // IME 内联组合:拼音串直接显示在输入栏内(幂等)

    // 先出一帧背景:字体栅格化(内置2万汉字形)需1~2秒,避免窗口纯白无响应感
    R.开始绘图()
    R.清背景(背景["r"], 背景["g"], 背景["b"], 背景["a"])
    R.结束绘图()

    若 选项 != 空 且 选项.含?("字体") {
        设 字库号 = 32
        若 选项.含?("字库字号") { 字库号 = 选项["字库字号"] }
        _字体 = R.加载字体(选项["字体"], 字库号)
    } 否 {
        // 用户未指定字体:自动加载内置鸿蒙字体(零配置中文显示)
        确保默认字体()
    }

    // 窗口尺寸快照(脏源:尺寸变化即重排;取屏幕宽/高为帧缓冲客户区尺寸)
    设 _窗宽 = R.取屏幕宽() ; 设 _窗高 = R.取屏幕高()

    当 非 R.窗口应关闭?() {
        // 按需重绘:无脏源则泵事件+短睡空转(约 125Hz 轮询),界面静止不耗帧
        若 按需 {
            // 单泵纪律:PollInputEvents 每次调用都清空字符/键队列(raylib rcore 实证)。
            // 脏帧一律只走 结束绘图 的经典泵(与裸 60fps 循环同构);仅当上一周期是空闲周期
            // (没画帧)时,本周期帧首才补泵探新世界——否则上一泵注册的字符/键边沿会在帧体
            // 读取之前被帧首泵清掉(实测:UI 循环里约 99% 按键丢失,IME 上屏同因)
            若 非 _上帧画了 {
                R.轮询事件()
            }
            xt_scheduler_step()
            设 _mx = R.鼠X() ; 设 _my = R.鼠Y()
            设 _左 = R.鼠标按下?(0) == 1
            _轮增量 = _轮增量 + R.取鼠标滚轮()
            // 脏源清单:首帧/状态标脏/鼠标位移/左键变化/滚轮/按住中(连发与拖拽要持续帧)/
            // 动画活跃(微交互·滚动丝滑·用户动值)/文本类聚焦(输入栏·多行编辑:打字·光标闪烁·IME 组合)/窗口尺寸变化
            设 _帧脏 = 非 _首帧毕
            若 态脏?(状态) { _帧脏 = 真 }
            若 _mx != _上鼠x 或 _my != _上鼠y 或 _左 != _上左键 { _帧脏 = 真 }
            若 _轮增量 != 0 { _帧脏 = 真 }
            若 _左 { _帧脏 = 真 }
            若 _动画活跃?() { _帧脏 = 真 }
            若 _焦点栏 != "" 或 _焦点编 != "" { _帧脏 = 真 }
            // 窗口尺寸变化也算脏:拖拽调大小期间逐帧按当前尺寸重排重绘
            设 _sw = R.取屏幕宽() ; 设 _sh = R.取屏幕高()
            若 _sw != _窗宽 或 _sh != _窗高 {
                _帧脏 = 真
                宽 = _sw ; 高 = _sh
                _窗宽 = _sw ; _窗高 = _sh
            }
            若 非 _帧脏 {
                _上帧画了 = 假
                时.睡(8)
                续
            }
            _上鼠x = _mx ; _上鼠y = _my ; _上左键 = _左
        } 否 {
            _轮增量 = R.取鼠标滚轮()
            xt_scheduler_step()
            // 纯循环同样按当前窗口尺寸布局(拖拽调大小逐帧重排)
            设 _sw2 = R.取屏幕宽() ; 设 _sh2 = R.取屏幕高()
            若 _sw2 != _窗宽 或 _sh2 != _窗高 {
                宽 = _sw2 ; 高 = _sh2
                _窗宽 = _sw2 ; _窗高 = _sh2
            }
        }
        设 鼠x = R.鼠X() ; 设 鼠y = R.鼠Y()
        设 左键 = R.鼠标刚按下?(0)
        _左键按住 = R.鼠标按下?(0) == 1

        _进上下文(状态)
        设 根节点 = 构建函(状态)
        _退上下文()

        R.开始绘图()
        R.清背景(背景["r"], 背景["g"], 背景["b"], 背景["a"])

        _滚序 = 0
        _帧号 = _帧号 + 1
        计算布局(根节点, 0, 0, 宽, 高)
        _悬栏 = 假
        _悬身份 = ""
        处理悬浮(根节点, 鼠x, 鼠y)
        若 _悬栏 { R.设鼠标样式(R.鼠标I形) } 否 { R.设鼠标样式(R.鼠标箭头) }
        // 处理点击改每帧调用(点击/按住模式需检测松开沿与持续时长)
        设 _按下沿m = _左键按住 且 非 _左键上帧
        设 _点中m = 处理点击(根节点, 鼠x, 鼠y)
        // 输入栏焦点:点中空白或非输入栏控件即失焦
        若 _按下沿m {
            若 _点中m == 空 { _焦点栏 = "" ; _焦点编 = "" }
            否 {
                若 _点中m["_类型"] != "输入栏" { _焦点栏 = "" }
                若 _点中m["_类型"] != "多行编辑" { _焦点编 = "" }
            }
        }
        // IME 跟随焦点:无文本类焦点(输入栏/多行编辑)即禁用组合与候选窗
        R.设输入法启用(_焦点栏 != "" 或 _焦点编 != "")
        处理键盘()
        _左键上帧 = _左键按住
        _动画序 = 0
        渲染(根节点)

        R.结束绘图()
        _轮增量 = 0
        _首帧毕 = 真
        _上帧画了 = 真
    }

    R.关闭窗口()

    // 卸载应用期加载的字体,恢复默认字体
    若 _字体 != 0 {
        R.释字体(_字体)
        _字体 = 0
    }
}

// 手动刷新（嵌入自定义渲染循环）
公 函 刷新(状态, 构建函, x, y, 宽, 高) {
    若 状态 == 空 { 返 空 }

    // 手动模式同样享受默认字体(首次调用时幂等尝试;窗口需已由调用方初始化)
    确保默认字体()
    R.安装输入法钩子()   // IME 内联组合(幂等)

    _进上下文(状态)
    设 根节点 = 构建函(状态)
    _退上下文()

    _滚序 = 0
    _帧号 = _帧号 + 1
    计算布局(根节点, x, y, 宽, 高)

    设 鼠x = R.鼠X() ; 设 鼠y = R.鼠Y()
    _左键按住 = R.鼠标按下?(0) == 1
    _轮增量 = R.取鼠标滚轮()
    xt_scheduler_step()
    _悬栏 = 假
    _悬身份 = ""
    处理悬浮(根节点, 鼠x, 鼠y)
    若 _悬栏 { R.设鼠标样式(R.鼠标I形) } 否 { R.设鼠标样式(R.鼠标箭头) }
    设 _按下沿r = _左键按住 且 非 _左键上帧
    设 _点中r = 处理点击(根节点, 鼠x, 鼠y)
    若 _按下沿r {
        若 _点中r == 空 { _焦点栏 = "" ; _焦点编 = "" }
        否 {
            若 _点中r["_类型"] != "输入栏" { _焦点栏 = "" }
            若 _点中r["_类型"] != "多行编辑" { _焦点编 = "" }
        }
    }
    // IME 跟随焦点:无文本类焦点(输入栏/多行编辑)即禁用组合与候选窗
    R.设输入法启用(_焦点栏 != "" 或 _焦点编 != "")
    处理键盘()
    _左键上帧 = _左键按住

    _动画序 = 0
    渲染(根节点)
    返 根节点
}
