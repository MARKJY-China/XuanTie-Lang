// 文本.xt — 玄铁文本扩展库 v1.0.1
// 纯玄铁实现，不依赖 C 运行时新函数；不修改传入值，全部返回新值。
//
// 用法:
//   引 "文本" 予 T
//   示(T.填充左("玄铁", 6, "—"))          // ————玄铁
//   示(T.到蛇形("userName"))              // user_name
//   示(T.模板("你好，{名字}", {"名字": "玄铁"}))   // 你好，玄铁
//
// 约定:
//   * 所有宽度/长度一律按**字符**计（"玄铁" 是 2 个字符，不是 6 字节）。
//   * 本库面向文本，不做 UTF-8 字节层处理；二进制请走 字节 集。
//   * 空分隔符、空子串、负宽度等边界不会抛错，按各函数注释里写明的规则返回。

// 判断单字符是否为空白：ASCII 空格/制表/换行/回车，以及全角空格 U+3000。
函 _是空白(单字) {
    若 单字 == " " { 返 真 }
    若 单字 == "\t" { 返 真 }
    若 单字 == "\n" { 返 真 }
    若 单字 == "\r" { 返 真 }
    若 单字 == "　" { 返 真 }
    返 假
}

// 判断单字符是否为 ASCII 大写字母。
函 _是大写(单字) {
    若 单字.字节数 != 1 { 返 假 }
    设 码 = 单字.字节(0)
    返 码 >= 65 且 码 <= 90
}

// 判断单字符是否为 ASCII 小写字母。
函 _是小写(单字) {
    若 单字.字节数 != 1 { 返 假 }
    设 码 = 单字.字节(0)
    返 码 >= 97 且 码 <= 122
}

// 判断单字符是否为 ASCII 数字。
函 _是数字(单字) {
    若 单字.字节数 != 1 { 返 假 }
    设 码 = 单字.字节(0)
    返 码 >= 48 且 码 <= 57
}

// 判断单字符是否为词分隔符：下划线、中划线、空白。
函 _是分隔(单字) {
    若 单字 == "_" { 返 真 }
    若 单字 == "-" { 返 真 }
    返 _是空白(单字)
}

// 生成由 单字 重复到指定字符数 的填充串；填充为空串时按单个空格处理。
函 _填充串(单字, 字符数) {
    设 填 = 单字
    若 填 == "" { 填 = " " }
    若 字符数 <= 0 { 返 "" }
    设 出 = 填.重复(字符数 / 填.字符数 + 1)
    返 出.截取(0, 字符数)
}

// 填充左：在左侧补够字符宽度，使总字符数达到 宽度；已够宽时原样返回。
//
// 参数 文本: 字 — 待填充文本，可为空串
// 参数 宽度: 整 — 目标**字符**数；<= 当前字符数时不填充
// 参数 填充: 字 — 填充串，可为多字符（按字符重复拼接后截断）；空串等同单个空格
// 返回: 字 — 新文本；不修改 文本
公 函 填充左(文本, 宽度, 填充) {
    设 差 = 宽度 - 文本.字符数
    若 差 <= 0 { 返 文本 }
    返 _填充串(填充, 差) & 文本
}

// 填充右：在右侧补够字符宽度，使总字符数达到 宽度；已够宽时原样返回。
//
// 参数 文本: 字 — 待填充文本，可为空串
// 参数 宽度: 整 — 目标**字符**数；<= 当前字符数时不填充
// 参数 填充: 字 — 填充串，可为多字符；空串等同单个空格
// 返回: 字 — 新文本；不修改 文本
公 函 填充右(文本, 宽度, 填充) {
    设 差 = 宽度 - 文本.字符数
    若 差 <= 0 { 返 文本 }
    返 文本 & _填充串(填充, 差)
}

// 居中：两侧补足字符宽度，缺口为奇数时右侧多一个字符。
//
// 参数 文本: 字 — 待居中文本，可为空串
// 参数 宽度: 整 — 目标**字符**数；<= 当前字符数时原样返回
// 参数 填充: 字 — 填充串，可为多字符；空串等同单个空格
// 返回: 字 — 新文本；不修改 文本
公 函 居中(文本, 宽度, 填充) {
    设 差 = 宽度 - 文本.字符数
    若 差 <= 0 { 返 文本 }
    设 左 = 差 / 2
    设 右 = 差 - 左
    返 _填充串(填充, 左) & 文本 & _填充串(填充, 右)
}

// 截断：超过 最大 字符数时截掉尾部并补上 省略号；未超长原样返回。
//
// 参数 文本: 字 — 待截断文本
// 参数 最大: 整 — 结果允许的最大**字符**数（含省略号）；<= 0 返回空串
// 参数 省略号: 字 — 超长时追加的尾巴，如 "…" 或 "..."；省略号自身不短于 最大 时只返回省略号的前 最大 个字符
// 返回: 字 — 新文本；不修改 文本
公 函 截断(文本, 最大, 省略号) {
    若 最大 <= 0 { 返 "" }
    若 文本.字符数 <= 最大 { 返 文本 }
    若 省略号.字符数 >= 最大 { 返 省略号.截取(0, 最大) }
    返 文本.截取(0, 最大 - 省略号.字符数) & 省略号
}

// 计数：统计 子串 在 文本 中**不重叠**出现的次数。
//
// 参数 文本: 字 — 待搜索文本
// 参数 子串: 字 — 要计数的子串；空串直接返回 0（不视为无限次出现）
// 返回: 整 — 出现次数；无出现为 0
公 函 计数(文本, 子串) {
    若 子串 == "" { 返 0 }
    设 次 = 0
    设 位 = 文本.寻找(子串, 0)
    当 位 >= 0 {
        次 = 次 + 1
        位 = 文本.寻找(子串, 位 + 子串.字符数)
    }
    返 次
}

// 行数：按 "\n" 切分后的行段数。
//
// 参数 文本: 字 — 待统计文本
// 返回: 整 — 空串返回 0；否则返回 分割("\n") 的段数（"a\n" 是 2 段：末尾空行也算一行）
公 函 行数(文本) {
    若 文本 == "" { 返 0 }
    返 文本.分割("\n").长度
}

// 取行：按 "\n" 切分，并去掉每行末尾的 "\r"（兼容 CRLF 文本）。
//
// 参数 文本: 字 — 待切分文本
// 返回: 数组 — 行数组；空串得到 [""]（1 行），与 行数 对空串返回 0 的约定不同，注意区分
公 函 取行(文本) {
    设 行们 = 文本.分割("\n")
    设 出 = []
    遍历 行 于 行们 {
        设 本行 = 行
        若 本行.以结尾("\r") { 本行 = 本行.截取(0, 本行.字符数 - 1) }
        出.追加(本行)
    }
    返 出
}

// 词数：按空白（空格/制表/换行/回车/全角空格）切分后的词数，连续空白算一次。
//
// 参数 文本: 字 — 待统计文本
// 返回: 整 — 词数；全空白或空串返回 0
公 函 词数(文本) {
    设 数 = 0
    设 在词中 = 假
    遍历 单字 于 文本 {
        若 _是空白(单字) {
            在词中 = 假
        } 否 {
            若 非 在词中 { 数 = 数 + 1 ; 在词中 = 真 }
        }
    }
    返 数
}

// 去前缀：若 文本 以 前缀 开头，去掉开头这一次出现；否则原样返回。
//
// 参数 文本: 字 — 待处理文本
// 参数 前缀: 字 — 要剥掉的前缀；空串不做任何事
// 返回: 字 — 新文本；不修改 文本
公 函 去前缀(文本, 前缀) {
    若 前缀 != "" 且 文本.以开头(前缀) {
        返 文本.截取(前缀.字符数, 文本.字符数)
    }
    返 文本
}

// 去后缀：若 文本 以 后缀 结尾，去掉末尾这一次出现；否则原样返回。
//
// 参数 文本: 字 — 待处理文本
// 参数 后缀: 字 — 要剥掉的后缀；空串不做任何事
// 返回: 字 — 新文本；不修改 文本
公 函 去后缀(文本, 后缀) {
    若 后缀 != "" 且 文本.以结尾(后缀) {
        返 文本.截取(0, 文本.字符数 - 后缀.字符数)
    }
    返 文本
}

// 切分首：在**第一个**分隔符处切成两段。
//
// 参数 文本: 字 — 待切分文本
// 参数 分隔符: 字 — 分隔串；空串或找不到时返回 [文本, ""]
// 返回: 数组 — 长度为 2 的数组 [前段, 后段]；后段可为空串
公 函 切分首(文本, 分隔符) {
    若 分隔符 == "" { 返 [文本, ""] }
    设 位 = 文本.寻找(分隔符, 0)
    若 位 < 0 { 返 [文本, ""] }
    返 [文本.截取(0, 位), 文本.截取(位 + 分隔符.字符数, 文本.字符数)]
}

// 切分尾：在**最后一个**分隔符处切成两段。
//
// 参数 文本: 字 — 待切分文本
// 参数 分隔符: 字 — 分隔串；空串或找不到时返回 ["", 文本]
// 返回: 数组 — 长度为 2 的数组 [前段, 后段]；前段可为空串
公 函 切分尾(文本, 分隔符) {
    若 分隔符 == "" { 返 ["", 文本] }
    设 位 = 文本.倒找(分隔符)
    若 位 < 0 { 返 ["", 文本] }
    返 [文本.截取(0, 位), 文本.截取(位 + 分隔符.字符数, 文本.字符数)]
}

// 首字大写：只把第一个字符转 ASCII 大写，其余字符保持不变。
//
// 参数 文本: 字 — 待处理文本；空串原样返回
// 返回: 字 — 新文本；首字符不是 ASCII 小写字母时内容不变
公 函 首字大写(文本) {
    若 文本.字符数 == 0 { 返 文本 }
    返 文本.截取(0, 1).到大写() & 文本.截取(1, 文本.字符数)
}

// 首字小写：只把第一个字符转 ASCII 小写，其余字符保持不变。
//
// 参数 文本: 字 — 待处理文本；空串原样返回
// 返回: 字 — 新文本；首字符不是 ASCII 大写字母时内容不变
公 函 首字小写(文本) {
    若 文本.字符数 == 0 { 返 文本 }
    返 文本.截取(0, 1).到小写() & 文本.截取(1, 文本.字符数)
}

// 到驼峰：按 `_`、`-`、空白切词，首词全小写，后续词首字母大写其余小写。
//
// 参数 文本: 字 — 待转换文本，如 "user_name"、"user-name"、"user name"
// 返回: 字 — 驼峰串，如 "userName"；不做大小写边界拆分（"HTTPServer" 只降首字母得 "hTTPServer"）
公 函 到驼峰(文本) {
    设 词们 = _切词(文本)
    设 出 = ""
    设 序 = 0
    遍历 词 于 词们 {
        设 件 = 词.到小写()
        若 序 > 0 { 件 = 首字大写(件) }
        出 = 出 & 件
        序 = 序 + 1
    }
    返 出
}

// 到蛇形：大驼峰/小驼峰/中划线/空格统一转小写下划线形式。
//
// 参数 文本: 字 — 待转换文本，如 "userName"、"HTTPServer"、"user-id"
// 返回: 字 — 蛇形串，如 "user_name"、"user_id"；连续大写按整体小写处理（"HTTPServer" → "httpserver"）
公 函 到蛇形(文本) {
    返 _到连字符(文本, "_")
}

// 到中划线：大驼峰/小驼峰/下划线/空格统一转小写中划线形式。
//
// 参数 文本: 字 — 待转换文本，如 "userName"、"user_name"
// 返回: 字 — 中划线串，如 "user-name"；连续分隔符折叠为一个
公 函 到中划线(文本) {
    返 _到连字符(文本, "-")
}

// 到标题：按空白切词，每个词首字母大写其余小写，用单个空格连接。
//
// 参数 文本: 字 — 待转换文本，如 "hello WORLD"
// 返回: 字 — 标题形式，如 "Hello World"；全空白返回空串
公 函 到标题(文本) {
    设 词们 = _切词(文本)
    设 出 = ""
    设 序 = 0
    遍历 词 于 词们 {
        若 序 > 0 { 出 = 出 & " " }
        出 = 出 & 首字大写(词.到小写())
        序 = 序 + 1
    }
    返 出
}

// 反转：按字符（不是字节）颠倒顺序。
//
// 参数 文本: 字 — 待反转文本
// 返回: 字 — 新文本；中文/emoji 不会被切坏
公 函 反转(文本) {
    设 出 = ""
    设 i = 文本.字符数 - 1
    当 i >= 0 {
        出 = 出 & 文本.截取(i, i + 1)
        i = i - 1
    }
    返 出
}

// 字符数组：把文本按字符拆成数组，每个元素是长度为 1 的字符串。
//
// 参数 文本: 字 — 待拆分文本
// 返回: 数组 — 字符数组；空串得到空数组
公 函 字符数组(文本) {
    设 出 = []
    遍历 单字 于 文本 {
        出.追加(单字)
    }
    返 出
}

// 去全部空白：删除所有空白字符（含全角空格），不只是首尾。
//
// 参数 文本: 字 — 待处理文本
// 返回: 字 — 新文本
公 函 去全部空白(文本) {
    设 出 = ""
    遍历 单字 于 文本 {
        若 非 _是空白(单字) { 出 = 出 & 单字 }
    }
    返 出
}

// 压缩空白：把连续空白折叠成单个半角空格，并去掉首尾空白。
//
// 参数 文本: 字 — 待处理文本
// 返回: 字 — 新文本；全空白返回空串
公 函 压缩空白(文本) {
    设 出 = ""
    设 待连 = 假
    遍历 单字 于 文本 {
        若 _是空白(单字) {
            若 出 != "" { 待连 = 真 }
        } 否 {
            若 待连 { 出 = 出 & " " ; 待连 = 假 }
            出 = 出 & 单字
        }
    }
    返 出
}

// 缩进：给每一行（含空行、含最后一行）加上前缀。
//
// 参数 文本: 字 — 待缩进文本
// 参数 前缀: 字 — 每行前缀，如 "    " 或 "  "
// 返回: 字 — 新文本；通过 "\n" → "\n前缀" 替换实现，末尾换行后也会补前缀
公 函 缩进(文本, 前缀) {
    若 前缀 == "" { 返 文本 }
    返 前缀 & 文本.替换("\n", "\n" & 前缀)
}

// 去缩进：按行去掉公共前导**半角空格**数（空行与全空白行不参与计算）。
//
// 参数 文本: 字 — 待处理文本
// 返回: 字 — 新文本；公共缩进为 0 时原样返回；制表符不参与缩进计算
公 函 去缩进(文本) {
    设 行们 = 文本.分割("\n")
    设 最少 = -1
    遍历 行 于 行们 {
        若 _是空白行(行) { 续 }
        设 前导 = _前导空格数(行)
        若 最少 < 0 或 前导 < 最少 { 最少 = 前导 }
    }
    若 最少 <= 0 { 返 文本 }
    设 出 = ""
    设 序 = 0
    遍历 行 于 行们 {
        设 本行 = 行
        设 去 = 最少
        若 去 > _前导空格数(本行) { 去 = _前导空格数(本行) }
        若 序 > 0 { 出 = 出 & "\n" }
        出 = 出 & 本行.截取(去, 本行.字符数)
        序 = 序 + 1
    }
    返 出
}

// 模板：把 `{键}` 占位替换为字典里对应键的值；`{{` 与 `}}` 转义为字面花括号。
//
// 参数 模板串: 字 — 含占位符的模板，如 "你好，{名字}"
// 参数 典: 字典 — 键为占位名（字符串），值须可用 字() 转文本（整/小数/字/布尔）
// 返回: 字 — 替换结果；字典里没有的键保留原样 `{键}`，未闭合的 `{` 原样保留
公 函 模板(模板串, 典) {
    设 出 = ""
    设 i = 0
    设 n = 模板串.字符数
    当 i < n {
        设 单字 = 模板串.截取(i, i + 1)
        若 单字 == "{" {
            若 i + 1 < n 且 模板串.截取(i + 1, i + 2) == "{" {
                出 = 出 & "{"
                i = i + 2
                续
            }
            设 闭 = 模板串.寻找("}", i + 1)
            若 闭 < 0 {
                出 = 出 & 单字
                i = i + 1
                续
            }
            设 键名 = 模板串.截取(i + 1, 闭)
            若 典.含?(键名) {
                出 = 出 & 字(典[键名])
            } 否 {
                出 = 出 & 模板串.截取(i, 闭 + 1)
            }
            i = 闭 + 1
            续
        }
        若 单字 == "}" {
            若 i + 1 < n 且 模板串.截取(i + 1, i + 2) == "}" {
                出 = 出 & "}"
                i = i + 2
                续
            }
            出 = 出 & 单字
            i = i + 1
            续
        }
        出 = 出 & 单字
        i = i + 1
    }
    返 出
}

// 空白?：判断文本是否为空或全由空白组成。
//
// 参数 文本: 字 — 待判定文本
// 返回: 布尔 — 空串或全空白为 真；含任一非空白字符为 假
公 函 空白?(文本) {
    遍历 单字 于 文本 {
        若 非 _是空白(单字) { 返 假 }
    }
    返 真
}

// 数字?：判断文本能否被 整() 或 小数() 严格解析为数字。
//
// 参数 文本: 字 — 待判定文本，如 "42"、"-3.5"
// 返回: 布尔 — 可解析为 真；空串、带单位、科学计数法（小数 不接受）等为 假
公 函 数字?(文本) {
    若 文本 == "" { 返 假 }
    若 整(文本).成功 { 返 真 }
    若 小数(文本).成功 { 返 真 }
    返 假
}

// 回文?：判断按字符正读与反读是否相同。
//
// 参数 文本: 字 — 待判定文本；区分大小写，不忽略空白与标点
// 返回: 布尔 — 回文为 真；空串与单字符为 真
公 函 回文?(文本) {
    设 左 = 0
    设 右 = 文本.字符数 - 1
    当 左 < 右 {
        若 文本.截取(左, 左 + 1) != 文本.截取(右, 右 + 1) { 返 假 }
        左 = 左 + 1
        右 = 右 - 1
    }
    返 真
}

// 包含任一?：判断语料中是否出现候选数组里的任一项。
//
// 参数 语料: 字 — 被搜索文本
// 参数 候选: 数组 — 待查找的字符串数组；空数组返回 假；空串候选会命中任何语料
// 返回: 布尔 — 任一命中为 真
公 函 包含任一?(语料, 候选) {
    遍历 项 于 候选 {
        若 语料.包含?(项) { 返 真 }
    }
    返 假
}

// ── 内部辅助 ──

// 按分隔符切词并丢弃空词（用于命名风格与标题转换）。
函 _切词(文本) {
    设 出 = []
    设 当前 = ""
    遍历 单字 于 文本 {
        若 _是分隔(单字) {
            若 当前 != "" { 出.追加(当前) ; 当前 = "" }
        } 否 {
            当前 = 当前 & 单字
        }
    }
    若 当前 != "" { 出.追加(当前) }
    返 出
}

// 驼峰边界转连字符：大写字母前插分隔符，连续分隔符折叠，结果全小写。
函 _到连字符(文本, 分隔) {
    设 出 = ""
    设 前 = ""
    遍历 单字 于 文本 {
        若 _是分隔(单字) {
            若 出 != "" 且 非 出.以结尾(分隔) { 出 = 出 & 分隔 }
        } 抑 _是大写(单字) {
            设 需断 = 出 != "" 且 非 出.以结尾(分隔) 且 (_是小写(前) 或 _是数字(前))
            若 需断 { 出 = 出 & 分隔 }
            出 = 出 & 单字.到小写()
        } 否 {
            出 = 出 & 单字.到小写()
        }
        前 = 单字
    }
    若 出.以结尾(分隔) { 出 = 出.截取(0, 出.字符数 - 1) }
    返 出
}

// 一行是否全为空白（空行也算）。
函 _是空白行(行) {
    遍历 单字 于 行 {
        若 非 _是空白(单字) { 返 假 }
    }
    返 真
}

// 一行开头连续半角空格的数量。
函 _前导空格数(行) {
    设 数 = 0
    设 i = 0
    当 i < 行.字符数 {
        若 行.截取(i, i + 1) != " " { 断 }
        数 = 数 + 1
        i = i + 1
    }
    返 数
}
