// SQLite.xt — 玄铁 SQLite 数据库库 v1.0.0
// 基于 SQLite3(amalgamation,包内置 sqlite3.o 与 SQLite桥.o,经 tiepm.toml [原生] 对象链接)
//
// 用法:
//   引 "SQLite" 予 数据库
//   设 开 = 数据库.打开(":memory:")
//   若 非 开.成功 { 示("打开失败: " & 开.错误) ; 终 1 }
//   设 库 = 开.值
//   数据库.执行(库, "CREATE TABLE 用户 (id INTEGER PRIMARY KEY, 名 TEXT, 分 REAL)")
//   数据库.执行带参(库, "INSERT INTO 用户 (名, 分) VALUES (?, ?)", ["玄铁", 98.5])
//   设 查 = 数据库.查询(库, "SELECT id, 名, 分 FROM 用户")
//   若 查.成功 {
//       遍历 行 于 查.值 { 示(行["名"] & " = " & 字(行["分"])) }
//   }
//   数据库.关闭(库)
//
// 事务:
//   数据库.开始事务(库)
//   ... 若干 执行/执行带参 ...
//   数据库.提交事务(库)   // 或 数据库.回滚事务(库)
//
// 约定:
//   - 打开/执行/查询/关闭 全部返回 结果 容器(.成功/.值/.错误),失败不炸程序
//   - 连接句柄是 ARC 管理对象,不显式关闭也会在回收时自动关闭(sqlite3_close_v2)
//   - 参数绑定占位符用 ?(位置从 1 起);参数数组元素类型:整/小数/字/字节/布尔/空
//   - 查询列值映射:INTEGER→整,FLOAT→小数,TEXT→字,BLOB→字节,NULL→空

外 函 xt_sqlite_open(路径: 字): 整
外 函 xt_sqlite_close(句柄: 整): 整
外 函 xt_sqlite_errmsg(句柄: 整): 字
外 函 xt_sqlite_exec(句柄: 整, 语句: 字): 整
外 函 xt_sqlite_exec_p(句柄: 整, 语句: 字, 参数: 数组): 整
外 函 xt_sqlite_query(句柄: 整, 语句: 字): 整
外 函 xt_sqlite_query_p(句柄: 整, 语句: 字, 参数: 数组): 整

// 打开数据库 → 结果<句柄>;路径 ":memory:" 为内存库
函 打开(路径) {
    返 xt_sqlite_open(路径)
}

// 关闭连接(幂等) → 结果
函 关闭(库) {
    返 xt_sqlite_close(库)
}

// 取最近错误消息 → 字
函 错误消息(库) {
    返 xt_sqlite_errmsg(库)
}

// 执行非查询语句 → 结果<整:影响行数>
函 执行(库, 语句) {
    返 xt_sqlite_exec(库, 语句)
}

// 带参执行(防注入,占位符 ?) → 结果<整:影响行数>
函 执行带参(库, 语句, 参数) {
    返 xt_sqlite_exec_p(库, 语句, 参数)
}

// 查询 → 结果<数组<字典>>(每行一个字典:列名 → 值)
函 查询(库, 语句) {
    返 xt_sqlite_query(库, 语句)
}

// 带参查询 → 结果<数组<字典>>
函 查询带参(库, 语句, 参数) {
    返 xt_sqlite_query_p(库, 语句, 参数)
}

// 事务三件套(BEGIN IMMEDIATE:写锁立即获取,免嵌套歧义)
函 开始事务(库) {
    返 xt_sqlite_exec(库, "BEGIN IMMEDIATE")
}
函 提交事务(库) {
    返 xt_sqlite_exec(库, "COMMIT")
}
函 回滚事务(库) {
    返 xt_sqlite_exec(库, "ROLLBACK")
}
