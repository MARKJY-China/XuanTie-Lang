// SQLite.xt — 玄铁 SQLite 数据库库 v1.0.0
// 基于 SQLite3(amalgamation,包内置 sqlite3.o 与 SQLite桥.o,经 tiepm.toml [原生] 对象链接)
//
// 用法:
//   引 "SQLite" 予 数据库
//   设 开 = 数据库.打开(":memory:")
//   若 非 开.成功 { 示("打开失败: " & 开.错误) ; 终 1 }
//   设 库 = 开.值
//   数据库.执行(库, "CREATE TABLE 用户 (id INTEGER PRIMARY KEY, 名 TEXT, 分 REAL)")
//   数据库.执行带参(库, "INSERT INTO 用户 (名, 分) VALUES (?, ?)", ["玄铁", 98.5])
//   设 查 = 数据库.查询(库, "SELECT id, 名, 分 FROM 用户")
//   若 查.成功 {
//       遍历 行 于 查.值 { 示(行["名"] & " = " & 字(行["分"])) }
//   }
//   数据库.关闭(库)
//
// 事务:
//   数据库.开始事务(库)
//   ... 若干 执行/执行带参 ...
//   数据库.提交事务(库)   // 或 数据库.回滚事务(库)
//
// 约定:
//   - 打开/执行/查询/关闭 全部返回 结果 容器(.成功/.值/.错误),失败不炸程序
//   - 连接句柄是 ARC 管理对象,不显式关闭也会在回收时自动关闭(sqlite3_close_v2)
//   - 参数绑定占位符用 ?(位置从 1 起);参数数组元素类型:整/小数/字/字节/布尔/空
//   - 查询列值映射:INTEGER→整,FLOAT→小数,TEXT→字,BLOB→字节,NULL→空

外 函 xt_sqlite_open(路径: 字): 整
外 函 xt_sqlite_close(句柄: 整): 整
外 函 xt_sqlite_errmsg(句柄: 整): 字
外 函 xt_sqlite_exec(句柄: 整, 语句: 字): 整
外 函 xt_sqlite_exec_p(句柄: 整, 语句: 字, 参数: 数组): 整
外 函 xt_sqlite_query(句柄: 整, 语句: 字): 整
外 函 xt_sqlite_query_p(句柄: 整, 语句: 字, 参数: 数组): 整

// 打开：按路径打开 SQLite 数据库连接，成功时把连接句柄放在 .值 里交出。
//
// 参数 路径: 字符串 — 数据库文件路径；":memory:" 为进程内内存库，路径非字符串时返回失败
// 返回: 结果 — 成功时 .值 为连接句柄（其余函数都收它）；失败时 .成功 为 假、.错误 为失败原因（SQLite 错误文本，如打不开文件、路径非字符串），不抛错
函 打开(路径) {
    返 xt_sqlite_open(路径)
}

// 关闭：关闭连接，幂等——重复关闭不报错；句柄是 ARC 对象，不显式关闭也会在回收时自动关闭。
//
// 参数 库: 任意 — 连接句柄（打开 成功时的 .值）；传句柄以外的值返回失败
// 返回: 结果 — 成功时 .值 为 真；失败时 .成功 为 假、.错误 为 "不是数据库句柄"
函 关闭(库) {
    返 xt_sqlite_close(库)
}

// 错误消息：读取该连接最近一次失败留下的 SQLite 错误文本，只读，不重置错误状态。
//
// 参数 库: 任意 — 连接句柄
// 返回: 字符串 — 最近一次错误消息；句柄无效或已关闭时返回 "句柄无效或已关闭"（本函数返回裸字符串，不是 结果 容器）
函 错误消息(库) {
    返 xt_sqlite_errmsg(库)
}

// 执行：执行一条不带参数的 SQL，建表、增删改、事务语句都可用；失败不抛错，返回结果容器。
//
// 参数 库: 任意 — 连接句柄
// 参数 语句: 字符串 — 要执行的 SQL；多条语句可用分号分隔一次执行，非字符串返回失败
// 返回: 结果 — 成功时 .值 为受影响行数（整，仅 INSERT/UPDATE/DELETE 有意义）；失败时 .成功 为 假、.错误 为 SQLite 错误消息
函 执行(库, 语句) {
    返 xt_sqlite_exec(库, 语句)
}

// 执行带参：用 ? 占位符绑定参数后执行 SQL，用户输入走绑定、不拼字符串，可防 SQL 注入。
// 绑定个数：参数多于占位符时绑定失败；少于时剩余占位符按 SQL NULL 绑定。
//
// 参数 库: 任意 — 连接句柄
// 参数 语句: 字符串 — 含 ? 占位符的 SQL，占位符按出现顺序从 1 编号
// 参数 参数: 数组 — 按占位符顺序排列的值，元素类型限 整/小数/字符串/布尔/空/字节，其中 布尔 存为 1/0
// 返回: 结果 — 成功时 .值 为受影响行数（整）；失败时 .成功 为 假、.错误 为错误消息（语法错误、参数类型不支持、参数绑定失败）
函 执行带参(库, 语句, 参数) {
    返 xt_sqlite_exec_p(库, 语句, 参数)
}

// 查询：执行 SQL 并一次性取回全部结果行，不留游标。
//
// 参数 库: 任意 — 连接句柄
// 参数 语句: 字符串 — 通常是 SELECT；语法错误或表不存在时返回失败，非 SELECT 语句执行成功但结果为空数组（写操作请用 执行）
// 返回: 结果 — 成功时 .值 为数组，每行一个字典（键为列名，列值映射 INTEGER→整、REAL→小数、TEXT→字符串、BLOB→字节、NULL→空）；无结果行为空数组；失败时 .错误 为 SQLite 错误消息
函 查询(库, 语句) {
    返 xt_sqlite_query(库, 语句)
}

// 查询带参：用 ? 占位符绑定参数后查询，用户输入走绑定、不拼字符串，可防 SQL 注入。
//
// 参数 库: 任意 — 连接句柄
// 参数 语句: 字符串 — 含 ? 占位符的 SELECT，占位符按出现顺序从 1 编号
// 参数 参数: 数组 — 按占位符顺序排列的值，元素类型限 整/小数/字符串/布尔/空/字节
// 返回: 结果 — 成功时 .值 为数组<字典>（列名 → 值），无结果行为空数组；失败时 .成功 为 假、.错误 为错误消息
函 查询带参(库, 语句, 参数) {
    返 xt_sqlite_query_p(库, 语句, 参数)
}

// 开始事务：执行 BEGIN IMMEDIATE，立即拿写锁（不等第一条写语句），多个连接并发时能尽早暴露锁冲突。
// 写锁被占用时最多等约 5 秒（打开时设 busy_timeout=5000），仍拿不到就返回失败；已在事务中再调用也返回失败，不会嵌套。
//
// 参数 库: 任意 — 连接句柄
// 返回: 结果 — 成功时 .成功 为 真；失败时 .成功 为 假、.错误 为 SQLite 错误消息（如 "cannot start a transaction within a transaction"）
函 开始事务(库) {
    返 xt_sqlite_exec(库, "BEGIN IMMEDIATE")
}
// 提交事务：执行 COMMIT，把 开始事务 之后的写入一次性落盘并结束事务。
//
// 参数 库: 任意 — 连接句柄
// 返回: 结果 — 成功时 .成功 为 真；没有活动事务时失败，.错误 为 "cannot commit - no transaction is active"
函 提交事务(库) {
    返 xt_sqlite_exec(库, "COMMIT")
}
// 回滚事务：执行 ROLLBACK，撤销 开始事务 之后的全部写入并结束事务。
//
// 参数 库: 任意 — 连接句柄
// 返回: 结果 — 成功时 .成功 为 真；没有活动事务时失败，.错误 为 "cannot rollback - no transaction is active"
函 回滚事务(库) {
    返 xt_sqlite_exec(库, "ROLLBACK")
}
