// lib/HTTP/HTTP.xt — HTTP/1.1 服务端库(纯玄铁实现,基于 听/连)
// 用法:引 "HTTP" 予 HTTP → HTTP.服务(端口, 处理函)            仅本机(默认安全)
//                        → HTTP.服务绑定(端口, 处理函, "0.0.0.0")  显式对外
//   处理函收 请求字典 {"方法","路径","查询","头","体"},返 响应字典 {"状态码","头","体"}(均可缺省)
// 语义:每连接一请求一响应(Connection: close,不支持 keep-alive)

// 按首个冒号切键值(值里可再含冒号,如时间戳/URL)
函 _首冒切(行) {
    设 冒 = 行.分割(":")
    设 键 = 冒[0]
    设 值 = ""
    若 冒.长度 > 1 {
        值 = 冒[1]
        设 i = 2
        当 i < 冒.长度 {
            值 = 值 & ":" & 冒[i]
            i = i + 1
        }
    }
    当 值.字节数 > 0 且 值.截取(0, 1) == " " { 值 = 值.截取(1, 值.字节数) }
    返 [键, 值]
}

// 读完整请求:循环读直到头部完整且 body 按 Content-Length 收齐
函 _服务读全部(流) {
    设 数据 = ""
    设 轮 = 0
    当 轮 < 100 {
        设 块 = 流.读(65536)
        若 块 != 空 { 数据 = 数据 & 块 }
        若 数据.包含?("\r\n\r\n") {
            设 段 = 数据.分割("\r\n\r\n")
            设 头部 = 段[0]
            设 内容长 = 0
            设 行们 = 头部.分割("\r\n")
            遍历 行 于 行们 {
                若 行.包含?("ontent-Length") {
                    设 kv = _首冒切(行)
                    设 转 = 整(kv[1])
                    若 转.成功 { 内容长 = 转.值 }
                }
            }
            设 现有 = 0
            若 段.长度 > 1 { 现有 = 段[1].字节数 }
            若 现有 >= 内容长 { 返 数据 }
        }
        轮 = 轮 + 1
    }
    返 数据
}

函 _服务解析(原文) {
    设 段 = 原文.分割("\r\n\r\n")
    设 头部 = 段[0]
    设 体 = ""
    若 段.长度 > 1 { 体 = 段[1] }
    设 行们 = 头部.分割("\r\n")
    设 请求 = {"方法": "", "路径": "/", "查询": "", "头": {}, "体": 体}
    若 行们.长度 == 0 { 返 请求 }
    设 首行 = 行们[0].分割(" ")
    若 首行.长度 > 0 { 请求["方法"] = 首行[0] }
    若 首行.长度 > 1 {
        设 目标 = 首行[1]
        设 问 = 目标.分割("?")
        请求["路径"] = 问[0]
        若 问.长度 > 1 { 请求["查询"] = 问[1] }
    }
    设 i = 1
    当 i < 行们.长度 {
        设 kv = _首冒切(行们[i])
        若 kv[0] != "" 且 kv[1] != "" { 请求["头"][kv[0]] = kv[1] }
        i = i + 1
    }
    返 请求
}

函 _状态文(码) {
    若 码 == 200 { 返 "OK" }
    若 码 == 201 { 返 "Created" }
    若 码 == 204 { 返 "No Content" }
    若 码 == 301 { 返 "Moved Permanently" }
    若 码 == 302 { 返 "Found" }
    若 码 == 400 { 返 "Bad Request" }
    若 码 == 404 { 返 "Not Found" }
    若 码 == 500 { 返 "Internal Server Error" }
    返 "Status"
}

函 _服务组装(响应) {
    设 码 = 200
    若 响应.含?("状态码") { 码 = 响应["状态码"] }
    设 体 = ""
    若 响应.含?("体") { 体 = 响应["体"] }
    设 文 = "HTTP/1.1 " & 码 & " " & _状态文(码) & "\r\n"
    若 响应.含?("头") {
        遍历 键 于 响应["头"] {
            文 = 文 & 键 & ": " & 响应["头"][键] & "\r\n"
        }
    }
    文 = 文 & "Content-Length: " & 体.字节数 & "\r\nConnection: close\r\n\r\n" & 体
    返 文
}

// 服务：启动 HTTP/1.1 监听并立即返回，不阻塞调用线程；每个连接在运行时分配的独立线程中处理。
// 只绑回环 127.0.0.1，仅本机可访问——这是刻意的安全默认，要对外提供服务请改用 服务绑定。
//
// 请求字典 {"方法","路径","查询","头","体"}：前三个是字符串（路径 与 查询 为未解码原文），头 是字典，体 是字符串。
// 响应字典 {"状态码","头","体"}：三键均可缺省（默认 200、无额外头、空体）；组装时固定追加 Content-Length（按字节计）与 Connection: close。
//
// 参数 端口: 整 — 监听端口，如 8080
// 参数 处理函: 函数 — 接收请求字典、须返回响应字典；返回 空 或非字典会在组装响应时报运行时错误
// 返回: 结果 — 成功时 .成功 为 真、.值 为 真，服务已在后台监听；失败时 .成功 为 假、.错误 为含地址与端口的错误消息（端口被占、地址不可用），不抛错
公 函 服务(端口, 处理函) {
    返 服务绑定(端口, 处理函, "127.0.0.1")
}

// 服务绑定：与 服务 行为一致，但由调用方显式指定监听地址，可对外或只绑某块网卡。
//
// 请求字典 {"方法","路径","查询","头","体"} 与 响应字典 {"状态码","头","体"} 的约定同 服务。
//
// 参数 端口: 整 — 监听端口，如 8080
// 参数 处理函: 函数 — 接收请求字典、须返回响应字典；返回 空 或非字典会在组装响应时报运行时错误
// 参数 绑定地址: 字符串 — 监听地址，IPv4 字面量或主机名："0.0.0.0" 对外、"127.0.0.1" 仅本机、空串等同回环；传非字符串直接返回失败
// 返回: 结果 — 成功时 .成功 为 真、.值 为 真；失败时 .错误 为错误消息（含地址与端口），不抛错
公 函 服务绑定(端口, 处理函, 绑定地址) {
    返 听(端口, 函(流) {
        设 原文 = _服务读全部(流)
        若 原文 == 空 或 原文 == "" { 流.关() ; 返 空 }
        设 请求 = _服务解析(原文)
        设 响应 = 处理函(请求)
        流.写(_服务组装(响应))
        流.关()
    }, 绑定地址)
}

// ============================================================
// 客户端流式请求(HTTPS/TLS + chunked 解码 + 增量读)
// ============================================================
// 原生桥:包内 HTTP流桥.o,由编译器经 tiepm.toml [原生] 对象 并入链接。
// TLS 走系统通道:Windows=Schannel、macOS=SecureTransport;Linux 无系统 TLS 通道,
// https 会明确失败(http 明文仍可用)。响应体按 chunked / Content-Length / 关闭即结束
// 三种情形解码,SSE 事件流可直接按行消费。
外 函 xt_http_stream_open(网址: 整, 选项: 整): 整
外 函 xt_http_stream_status(句柄: 整): 整
外 函 xt_http_stream_readline(句柄: 整, 超时: 整): 整
外 函 xt_http_stream_read(句柄: 整, 最多: 整, 超时: 整): 整
外 函 xt_http_stream_header(句柄: 整, 名: 整): 整
外 函 xt_http_stream_eof(句柄: 整): 整
外 函 xt_http_stream_close(句柄: 整): 整

// 流打开：发起 HTTP/1.1 请求并立即返回流句柄，不等待响应体。
//
// 选项与 求(url, 选项) 一致：{"方法","头","体"}；"头" 是字典，逐键写请求头。
// 参数 网址: 字符串 — 完整 http/https 地址（含协议）
// 参数 选项: 字典 — {"方法","头","体"}，均可缺省
// 返回: 结果 — 成功时 .值 为流句柄（传给 流读行/流读块/流头/流状态码/流关）；
//       失败时 .错误 为原因（网址非法、连接失败、TLS 握手失败等）。
// 注意: 返回时响应头已读完（含 1xx 中间响应跳过），body 尚未读取。
公 函 流打开(网址, 选项) {
    返 xt_http_stream_open(网址, 选项)
}

// 流状态码：HTTP 状态码；句柄无效返回 -1。
//
// 参数 句柄: 任意 — 流打开 成功时的 .值
// 返回: 整 — 状态码；句柄无效时 -1
公 函 流状态码(句柄) {
    返 xt_http_stream_status(句柄)
}

// 流读行：读一行（去掉行尾 \r\n）。SSE 的空行是「成功 + 空串」，不是 EOF。
//
// 参数 句柄: 任意 — 流打开 成功时的 .值
// 参数 超时毫秒: 整 — <0 永久等待；0 不等待；>0 最多等这么久
// 返回: 结果 — 成功时 .值 为行；失败时 .错误 为 "EOF"（流正常结束）、"超时" 或读取错误
公 函 流读行(句柄, 超时毫秒) {
    返 xt_http_stream_readline(句柄, 超时毫秒)
}

// 流读块：读最多 N 字节；语义与 流读行 相同，但按字节返回而不是按行。
//
// 参数 句柄: 任意 — 流打开 成功时的 .值
// 参数 最多字节: 整 — 本次最多返回的字节数
// 参数 超时毫秒: 整 — <0 永久等待；0 不等待；>0 最多等这么久
// 返回: 结果 — 成功时 .值 为字节串；失败时 .错误 为 "EOF"、"暂无数据"（超时且无数据）或读取错误
公 函 流读块(句柄, 最多字节, 超时毫秒) {
    返 xt_http_stream_read(句柄, 最多字节, 超时毫秒)
}

// 流头：查询响应头（名不区分大小写）；未找到返回空串。
//
// 参数 句柄: 任意 — 流打开 成功时的 .值
// 参数 名: 字符串 — 响应头名，如 "content-type"、"transfer-encoding"
// 返回: 字符串 — 头值（已去首尾空白）；未找到为空串
公 函 流头(句柄, 名) {
    返 xt_http_stream_header(句柄, 名)
}

// 流结束?：响应体是否已读到 EOF。
//
// 参数 句柄: 任意 — 流打开 成功时的 .值
// 返回: 布尔 — 已结束为真
公 函 流结束?(句柄) {
    返 xt_http_stream_eof(句柄)
}

// 流关：显式关闭连接（幂等）。句柄对象被 ARC 回收时也会自动关闭。
//
// 参数 句柄: 任意 — 流打开 成功时的 .值
// 返回: 结果 — 关闭成功为真；句柄无效或类型不符时为失败结果
公 函 流关(句柄) {
    返 xt_http_stream_close(句柄)
}
