// lib/HTTP/HTTP.xt — HTTP/1.1 服务端库(纯玄铁实现,基于 听/连)
// 用法:引 "HTTP" 予 HTTP → HTTP.服务(端口, 处理函)
//   处理函收 请求字典 {"方法","路径","查询","头","体"},返 响应字典 {"状态码","头","体"}(均可缺省)
// 语义:每连接一请求一响应(Connection: close,不支持 keep-alive)
// 语义:每连接一请求一响应(Connection: close,不支持 keep-alive)

// 按首个冒号切键值(值里可再含冒号,如时间戳/URL)
函 _首冒切(行) {
    设 冒 = 行.分割(":")
    设 键 = 冒[0]
    设 值 = ""
    若 冒.长度 > 1 {
        值 = 冒[1]
        设 i = 2
        当 i < 冒.长度 {
            值 = 值 & ":" & 冒[i]
            i = i + 1
        }
    }
    当 值.字节数 > 0 且 值.截取(0, 1) == " " { 值 = 值.截取(1, 值.字节数) }
    返 [键, 值]
}

// 读完整请求:循环读直到头部完整且 body 按 Content-Length 收齐
函 _服务读全部(流) {
    设 数据 = ""
    设 轮 = 0
    当 轮 < 100 {
        设 块 = 流.读(65536)
        若 块 != 空 { 数据 = 数据 & 块 }
        若 数据.包含?("\r\n\r\n") {
            设 段 = 数据.分割("\r\n\r\n")
            设 头部 = 段[0]
            设 内容长 = 0
            设 行们 = 头部.分割("\r\n")
            遍历 行 于 行们 {
                若 行.包含?("ontent-Length") {
                    设 kv = _首冒切(行)
                    设 转 = 整(kv[1])
                    若 转.成功 { 内容长 = 转.值 }
                }
            }
            设 现有 = 0
            若 段.长度 > 1 { 现有 = 段[1].字节数 }
            若 现有 >= 内容长 { 返 数据 }
        }
        轮 = 轮 + 1
    }
    返 数据
}

函 _服务解析(原文) {
    设 段 = 原文.分割("\r\n\r\n")
    设 头部 = 段[0]
    设 体 = ""
    若 段.长度 > 1 { 体 = 段[1] }
    设 行们 = 头部.分割("\r\n")
    设 请求 = {"方法": "", "路径": "/", "查询": "", "头": {}, "体": 体}
    若 行们.长度 == 0 { 返 请求 }
    设 首行 = 行们[0].分割(" ")
    若 首行.长度 > 0 { 请求["方法"] = 首行[0] }
    若 首行.长度 > 1 {
        设 目标 = 首行[1]
        设 问 = 目标.分割("?")
        请求["路径"] = 问[0]
        若 问.长度 > 1 { 请求["查询"] = 问[1] }
    }
    设 i = 1
    当 i < 行们.长度 {
        设 kv = _首冒切(行们[i])
        若 kv[0] != "" 且 kv[1] != "" { 请求["头"][kv[0]] = kv[1] }
        i = i + 1
    }
    返 请求
}

函 _状态文(码) {
    若 码 == 200 { 返 "OK" }
    若 码 == 201 { 返 "Created" }
    若 码 == 204 { 返 "No Content" }
    若 码 == 301 { 返 "Moved Permanently" }
    若 码 == 302 { 返 "Found" }
    若 码 == 400 { 返 "Bad Request" }
    若 码 == 404 { 返 "Not Found" }
    若 码 == 500 { 返 "Internal Server Error" }
    返 "Status"
}

函 _服务组装(响应) {
    设 码 = 200
    若 响应.含?("状态码") { 码 = 响应["状态码"] }
    设 体 = ""
    若 响应.含?("体") { 体 = 响应["体"] }
    设 文 = "HTTP/1.1 " & 码 & " " & _状态文(码) & "\r\n"
    若 响应.含?("头") {
        遍历 键 于 响应["头"] {
            文 = 文 & 键 & ": " & 响应["头"][键] & "\r\n"
        }
    }
    文 = 文 & "Content-Length: " & 体.字节数 & "\r\nConnection: close\r\n\r\n" & 体
    返 文
}

// 服务(端口, 处理函):启动 HTTP 监听(立即返回,连接在各自线程处理)
公 函 服务(端口, 处理函) {
    听(端口, 函(流) {
        设 原文 = _服务读全部(流)
        若 原文 == 空 或 原文 == "" { 流.关() ; 返 空 }
        设 请求 = _服务解析(原文)
        设 响应 = 处理函(请求)
        流.写(_服务组装(响应))
        流.关()
    })
}
