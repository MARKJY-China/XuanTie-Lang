// 路径.xt — 玄铁路径处理库 v1.0.1
// 纯玄铁实现：只做字符串层的路径运算，不碰文件系统（读写/尺寸仍用 文件 内建）。
//
// 用法:
//   引 "路径" 予 P
//   示(P.拼接("src", "main.xt"))        // src\main.xt (Windows)
//   示(P.规范化("a/./b/../c"))          // a\c
//   示(P.换扩展名("a/b.txt", "md"))     // a\b.md
//   示(P.相对("C:/项目/库/文本.xt", "C:/项目/示例"))   // ..\库\文本.xt
//
// 平台:
//   分隔符由运行平台决定（windows 用 "\"，其余用 "/"），所有函数同时接受 "/" 与 "\" 作为输入。
//   不支持 UNC 语义（"\\server\share" 按普通段处理），需要时请先自行拆分。

外 函 xt_cwd(): 字
外 函 xt_get_temp_path(): 字
外 函 xt_env_get(名: 字): 字

// 判断单字符是否路径分隔符（"/" 或 "\"）。
函 _是斜(单字) {
    若 单字 == "/" { 返 真 }
    若 单字 == "\\" { 返 真 }
    返 假
}

// 判断单字符是否为 ASCII 字母。
函 _是字母(单字) {
    若 单字.字节数 != 1 { 返 假 }
    设 码 = 单字.字节(0)
    若 码 >= 65 且 码 <= 90 { 返 真 }
    若 码 >= 97 且 码 <= 122 { 返 真 }
    返 假
}

// 判断单字符是否为 ASCII 数字。
函 _是数字(单字) {
    若 单字.字节数 != 1 { 返 假 }
    设 码 = 单字.字节(0)
    返 码 >= 48 且 码 <= 57
}

// 按平台返回路径分隔符。
//
// 返回: 字 — Windows 为 "\"，Linux/macOS 为 "/"
公 函 分隔符() {
    若 系统.操作系统类别() == "windows" { 返 "\\" }
    返 "/"
}

// 把路径里的分隔符全部换成平台分隔符。
//
// 参数 路径: 字 — 任意混用 "/" 与 "\" 的路径
// 返回: 字 — 新路径；不改动其他字符
公 函 规范化分隔符(路径) {
    设 分 = 分隔符()
    设 出 = ""
    遍历 单字 于 路径 {
        若 _是斜(单字) { 出 = 出 & 分 } 否 { 出 = 出 & 单字 }
    }
    返 出
}

// 把路径里的分隔符全部换成 "/"（用于写跨平台配置、URL、归档清单）。
//
// 参数 路径: 字 — 任意混用 "/" 与 "\" 的路径
// 返回: 字 — 全为 "/" 的新路径
公 函 转斜杠(路径) {
    设 出 = ""
    遍历 单字 于 路径 {
        若 _是斜(单字) { 出 = 出 & "/" } 否 { 出 = 出 & 单字 }
    }
    返 出
}

// 把路径里的分隔符全部换成 "\"（仅用于 Windows 原生工具链的输入）。
//
// 参数 路径: 字 — 任意混用 "/" 与 "\" 的路径
// 返回: 字 — 全为 "\" 的新路径
公 函 转反斜杠(路径) {
    设 出 = ""
    遍历 单字 于 路径 {
        若 _是斜(单字) { 出 = 出 & "\\" } 否 { 出 = 出 & 单字 }
    }
    返 出
}

// 拼接：把子路径接到基路径后，按需补一个分隔符，不产生重复分隔符。
//
// 参数 基: 字 — 基路径，可为空串
// 参数 子: 字 — 子路径；为空串时原样返回基；以分隔符或盘符开头时视为绝对路径直接返回子
// 返回: 字 — 新路径；不做规范化（"."/".." 保留，请再调 规范化）
公 函 拼接(基, 子) {
    若 基 == "" { 返 子 }
    若 子 == "" { 返 基 }
    若 _是绝对路径(子) { 返 子 }
    设 基尾 = 基.截取(基.字符数 - 1, 基.字符数)
    若 _是斜(基尾) { 返 基 & 子 }
    返 基 & 分隔符() & 子
}

// 连接：把段数组从左到右依次拼接（空串段被忽略）。
//
// 参数 段们: 数组 — 字符串数组，如 ["C:/项目", "src", "main.xt"]
// 返回: 字 — 拼接结果；空数组返回 ""；任一段为绝对路径时从该段重新起算
公 函 连接(段们) {
    设 出 = ""
    遍历 段 于 段们 {
        若 段 == "" { 续 }
        若 _是绝对路径(段) { 出 = 段 } 否 { 出 = 拼接(出, 段) }
    }
    返 出
}

// 绝对?：判断路径是否为绝对路径（盘符或根分隔符开头）。
//
// 参数 路径: 字 — 待判定路径
// 返回: 布尔 — "C:\x"、"/x"、"\\x" 为 真；"x"、".\x"、"" 为 假
公 函 绝对?(路径) {
    返 _是绝对路径(路径)
}

// 根：取路径的根部分（盘符或根分隔符）。
//
// 参数 路径: 字 — 待分析路径
// 返回: 字 — "C:"、"C:\"、本机根分隔符或 ""（相对路径无根）；分隔符按平台
公 函 根(路径) {
    若 路径 == "" { 返 "" }
    设 首 = 路径.截取(0, 1)
    若 路径.字符数 >= 2 {
        设 次 = 路径.截取(1, 2)
        若 次 == ":" 且 _是字母(首) {
            若 路径.字符数 >= 3 且 _是斜(路径.截取(2, 3)) {
                返 首 & ":" & 分隔符()
            }
            返 首 & ":"
        }
    }
    若 _是斜(首) { 返 分隔符() }
    返 ""
}

// 目录：取路径的父目录部分（最后一个分隔符之前）。
//
// 参数 路径: 字 — 待分析路径
// 返回: 字 — 父目录；无分隔符（只有文件名）返回 ""；根下面的项返回根本身（Windows 为 "\"、POSIX 为 "/"）
公 函 目录(路径) {
    若 路径 == "" { 返 "" }
    设 尾斜 = 假
    若 _是斜(路径.截取(路径.字符数 - 1, 路径.字符数)) { 尾斜 = 真 }
    设 位 = -1
    设 i = 路径.字符数 - 1
    当 i >= 0 {
        若 _是斜(路径.截取(i, i + 1)) { 位 = i ; 断 }
        i = i - 1
    }
    若 位 < 0 { 返 "" }
    若 位 == 0 { 返 分隔符() }
    设 前 = 路径.截取(0, 位)
    若 前 == "" { 返 分隔符() }
    若 前.字符数 == 2 且 前.截取(1, 2) == ":" { 返 前 & 分隔符() }
    返 前
}

// 文件名：取路径最后一段（含扩展名）。
//
// 参数 路径: 字 — 待分析路径
// 返回: 字 — 文件名；路径以分隔符结尾时返回 ""
公 函 文件名(路径) {
    若 路径 == "" { 返 "" }
    设 位 = -1
    设 i = 路径.字符数 - 1
    当 i >= 0 {
        若 _是斜(路径.截取(i, i + 1)) { 位 = i ; 断 }
        i = i - 1
    }
    若 位 < 0 { 返 路径 }
    返 路径.截取(位 + 1, 路径.字符数)
}

// 扩展名：取文件名的扩展名（含前导点）。
//
// 参数 路径: 字 — 待分析路径
// 返回: 字 — 如 ".txt"；无扩展名、"a."、"仅一个点"、隐藏文件 ".gitignore" 均返回 ""
公 函 扩展名(路径) {
    设 名 = 文件名(路径)
    设 位 = 名.倒找(".")
    若 位 <= 0 { 返 "" }
    若 位 == 名.字符数 - 1 { 返 "" }
    返 名.截取(位, 名.字符数)
}

// 主名：取文件名的去扩展名部分。
//
// 参数 路径: 字 — 待分析路径
// 返回: 字 — 如 "a/b.tar.gz" 得到 "b.tar"；无扩展名时等于 文件名
公 函 主名(路径) {
    设 名 = 文件名(路径)
    设 扩 = 扩展名(路径)
    若 扩 == "" { 返 名 }
    返 名.截取(0, 名.字符数 - 扩.字符数)
}

// 去扩展名：去掉整条路径末尾的扩展名，目录部分不动。
//
// 参数 路径: 字 — 待处理路径
// 返回: 字 — 新路径；无扩展名时原样返回
公 函 去扩展名(路径) {
    设 扩 = 扩展名(路径)
    若 扩 == "" { 返 路径 }
    返 路径.截取(0, 路径.字符数 - 扩.字符数)
}

// 换扩展名：替换路径末尾的扩展名。
//
// 参数 路径: 字 — 待处理路径
// 参数 新扩展: 字 — 新扩展名，可带或不带前导点（"md" 与 ".md" 等价）；空串等同 去扩展名
// 返回: 字 — 新路径；路径目录部分不变
公 函 换扩展名(路径, 新扩展) {
    设 基 = 去扩展名(路径)
    设 扩 = 新扩展
    若 扩 == "" { 返 基 }
    若 扩.截取(0, 1) != "." { 扩 = "." & 扩 }
    返 基 & 扩
}

// 规范化：折叠 "."、".." 与重复分隔符，统一分隔符，去掉末尾多余分隔符。
//
// 参数 路径: 字 — 待规范化路径
// 返回: 字 — 规范化路径；相对路径前导 ".." 会保留；空串返回 ""；无内容的相对路径返回 "."
公 函 规范化(路径) {
    若 路径 == "" { 返 "" }
    设 根部 = 根(路径)
    设 体 = 路径
    若 根部 != "" { 体 = 路径.截取(根部.字符数, 路径.字符数) }
    体 = 体.替换("\\", "/")
    设 段们 = 体.分割("/")
    设 栈 = []
    遍历 段 于 段们 {
        若 段 == "" { 续 }
        若 段 == "." { 续 }
        若 段 == ".." {
            若 栈.长度 > 0 且 栈[栈.长度 - 1] != ".." {
                栈.删(栈.长度 - 1)
            } 抑 根部 == "" {
                栈.追加("..")
            }
            续
        }
        栈.追加(段)
    }
    设 分 = 分隔符()
    设 出 = 根部
    设 序 = 0
    遍历 段 于 栈 {
        若 序 > 0 且 非 出.以结尾(分) { 出 = 出 & 分 }
        若 序 == 0 且 出 != "" 且 非 出.以结尾(分) { 出 = 出 & 分 }
        出 = 出 & 段
        序 = 序 + 1
    }
    若 出 == "" { 返 "." }
    返 出
}

// 绝对：把相对路径转成基于当前工作目录的绝对路径。
//
// 参数 路径: 字 — 可为相对或绝对
// 返回: 字 — 绝对路径；已是绝对路径时返回规范化结果
公 函 绝对(路径) {
    若 _是绝对路径(路径) { 返 规范化(路径) }
    若 路径 == "" { 返 规范化(xt_cwd()) }
    返 规范化(拼接(xt_cwd(), 路径))
}

// 相对：以 基准目录 为起点表示 目标。
//
// 参数 目标: 字 — 待表示路径
// 参数 基准: 字 — 基准**目录**（若指向文件请先取 目录）
// 返回: 字 — 相对路径；两者根不同（如跨盘）时返回规范化后的目标；完全相同时返回 "."
公 函 相对(目标, 基准) {
    设 规目 = 规范化(目标)
    设 规基 = 规范化(基准)
    设 拆目 = _拆根段(规目)
    设 拆基 = _拆根段(规基)
    若 拆目[0] != 拆基[0] { 返 规目 }
    设 目段 = 拆目[1]
    设 基段 = 拆基[1]
    设 同 = 0
    当 同 < 目段.长度 且 同 < 基段.长度 且 目段[同] == 基段[同] {
        同 = 同 + 1
    }
    设 出 = []
    设 i = 同
    当 i < 基段.长度 {
        出.追加("..")
        i = i + 1
    }
    i = 同
    当 i < 目段.长度 {
        出.追加(目段[i])
        i = i + 1
    }
    若 出.长度 == 0 { 返 "." }
    设 分 = 分隔符()
    设 拼 = ""
    设 序 = 0
    遍历 段 于 出 {
        若 序 > 0 { 拼 = 拼 & 分 }
        拼 = 拼 & 段
        序 = 序 + 1
    }
    若 拼 == "" { 返 "." }
    返 拼
}

// 拆分：把路径拆成根、目录、文件名、主名、扩展名五部分。
//
// 参数 路径: 字 — 待拆分路径
// 返回: 字典 — {"根","目录","文件名","主名","扩展名"} 五个字符串键
公 函 拆分(路径) {
    返 {"根": 根(路径), "目录": 目录(路径), "文件名": 文件名(路径),
          "主名": 主名(路径), "扩展名": 扩展名(路径)}
}

// 临时目录：返回系统临时目录路径。
//
// 返回: 字 — 如 "C:\Users\...\Temp"、" /tmp"；不带末尾分隔符
公 函 临时目录() {
    设 原 = xt_get_temp_path()
    若 原.字符数 > 3 且 _是斜(原.截取(原.字符数 - 1, 原.字符数)) {
        返 原.截取(0, 原.字符数 - 1)
    }
    返 原
}

// 家目录：返回当前用户主目录路径。
//
// 返回: 字 — Windows 取 USERPROFILE，其余取 HOME；两者都缺失时返回空串
公 函 家目录() {
    设 目 = xt_env_get("USERPROFILE")
    若 目 == "" { 目 = xt_env_get("HOME") }
    返 目
}

// 非法字符：列出文件名里不允许出现的字符（按当前平台规则）。
//
// 参数 名: 字 — 待检查的文件名（可含扩展名，不要含目录）
// 返回: 数组 — 命中的非法字符数组；无非法字符时为空数组
公 函 非法字符(名) {
    设 出 = []
    遍历 单字 于 名 {
        设 码 = 单字.字节(0)
        若 单字.字节数 == 1 且 码 < 32 { 出.追加(单字) ; 续 }
        若 _是斜(单字) { 出.追加(单字) ; 续 }
        若 单字 == ":" { 出.追加(单字) ; 续 }
        若 单字 == "*" { 出.追加(单字) ; 续 }
        若 单字 == "?" { 出.追加(单字) ; 续 }
        若 单字 == "\"" { 出.追加(单字) ; 续 }
        若 单字 == "<" { 出.追加(单字) ; 续 }
        若 单字 == ">" { 出.追加(单字) ; 续 }
        若 单字 == "|" { 出.追加(单字) ; 续 }
    }
    返 出
}

// 合法名?：判断字符串能否作为文件名（不含目录部分）。
//
// 参数 名: 字 — 待检查文件名
// 返回: 布尔 — 非空、无非法字符、不是 "."/".."、不以空格或点结尾、且不属 Windows 保留设备名
公 函 合法名?(名) {
    若 名 == "" { 返 假 }
    若 名 == "." 或 名 == ".." { 返 假 }
    若 非法字符(名).长度 > 0 { 返 假 }
    若 名.以结尾(" ") 或 名.以结尾(".") { 返 假 }
    设 主 = 主名(名)
    设 大 = 主.到大写()
    若 大 == "CON" 或 大 == "PRN" 或 大 == "AUX" 或 大 == "NUL" { 返 假 }
    若 _是保留设备(大) { 返 假 }
    返 真
}

// 同名?：按路径规范化规则判断两个路径是否指向同一项。
//
// 参数 甲: 字 — 路径一
// 参数 乙: 字 — 路径二
// 返回: 布尔 — 规范化后相等为 真；Windows 上大小写不敏感，其余平台区分大小写
公 函 同名?(甲, 乙) {
    设 规甲 = 规范化(甲)
    设 规乙 = 规范化(乙)
    若 系统.操作系统类别() == "windows" {
        返 规甲.到小写() == 规乙.到小写()
    }
    返 规甲 == 规乙
}

// ── 内部辅助 ──

// 是否绝对路径（盘符或首字符为分隔符）。
函 _是绝对路径(路径) {
    若 路径 == "" { 返 假 }
    若 _是斜(路径.截取(0, 1)) { 返 真 }
    若 路径.字符数 >= 2 {
        设 次 = 路径.截取(1, 2)
        若 次 == ":" 且 _是字母(路径.截取(0, 1)) { 返 真 }
    }
    返 假
}

// 拆成 [根, 段数组]；分隔符统一按 "/" 或 "\" 切。
函 _拆根段(路径) {
    设 根部 = 根(路径)
    设 体 = 路径
    若 根部 != "" { 体 = 路径.截取(根部.字符数, 路径.字符数) }
    设 段们 = []
    设 当前 = ""
    遍历 单字 于 体 {
        若 _是斜(单字) {
            若 当前 != "" { 段们.追加(当前) ; 当前 = "" }
        } 否 {
            当前 = 当前 & 单字
        }
    }
    若 当前 != "" { 段们.追加(当前) }
    返 [根部, 段们]
}

// 是否为 Windows 保留设备名（COM1-9 / LPT1-9）。
函 _是保留设备(大写主名) {
    若 大写主名.字符数 != 4 { 返 假 }
    设 前3 = 大写主名.截取(0, 3)
    若 前3 != "COM" 且 前3 != "LPT" { 返 假 }
    设 号 = 大写主名.截取(3, 4)
    若 _是数字(号) 且 号 != "0" { 返 真 }
    返 假
}
