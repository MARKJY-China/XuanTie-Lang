// Test 82 — 数学库矩阵(全断言)
示("=== Test 82: 数学库矩阵 ===")
若 数学.绝对值(0 - 7) == 7 { 示("PASS: 绝对值") } 否 { 示("FAIL: 绝对值") }
若 数学.最大值(3, 9) == 9 { 示("PASS: 最大值") } 否 { 示("FAIL: 最大值") }
若 数学.最小值(3, 9) == 3 { 示("PASS: 最小值") } 否 { 示("FAIL: 最小值") }
若 数学.幂(2, 10) == 1024 { 示("PASS: 幂") } 否 { 示("FAIL: 幂") }
若 数学.平方根(16) == 4 { 示("PASS: 平方根") } 否 { 示("FAIL: 平方根") }
若 数学.取整(3.7) == 3 { 示("PASS: 取整") } 否 { 示("FAIL: 取整") }
若 数学.进一(3.2) == 4 { 示("PASS: 进一") } 否 { 示("FAIL: 进一") }
若 数学.四舍五入(3.5) == 4 { 示("PASS: 四舍五入") } 否 { 示("FAIL: 四舍五入") }
示("=== Test 82 完成 ===")
