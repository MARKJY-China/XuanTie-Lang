// Test/209_硬错误可捕获.xt
// issue #113:运行时硬错误必须能被 尝试/捕捉 接住,不能直接退出进程;且 尝试 支持表达式形态。
// 覆盖:
//   ① issue 原例:{"x":1}["不存在"] 得到 空 → 空.长度 的成员硬错误进捕捉块;
//   ② 嵌套成员链;③ 索引非对象;④ 方法缺失;⑤ 成员未知;⑥ 含? 接收者守卫;⑦ 负索引;
//   ⑧ 尝试 表达式形态(正常/异常两条路径取值);
//   ⑨ 嵌套尝试 + 捕捉块内再抛冒到外层;⑩ 函数内/闭包内 尝试;
//   ⑪ 无 尝试 的同款硬错误仍是硬退出(自执行子进程断言 exit 1 + 定位前缀)。
// 捕捉消息内嵌「[文件:行:列] 」定位(#110),并含成员/方法名。
外 函 xt_get_args(): 数组
外 函 xt_self_path(): 字

示("--- 209_硬错误可捕获 开始 ---")

设 参 = xt_get_args()
设 是子进程 = 假
遍历 _a 于 参 {
    若 字(_a) == "--child" { 是子进程 = 真 }
}
若 是子进程 {
    设 无 = {"x": 1}["不存在"]
    示(无.长度)
    示("FAIL 209-11: 无 尝试 的硬错误未退出")
    终 0
}

// ① issue #113 原例
设 捕1 = 假
尝试 {
    设 无 = {"x": 1}["不存在"]
    示(无.长度)
    示("FAIL 209-1: 成员硬错误未触发")
} 捕捉 (e) {
    捕1 = 真
    设 消息1 = 字(e["消息"])
    若 非 消息1.包含?("长度") { 示("FAIL 209-1: 消息缺成员名 -> " & 消息1) }
    若 非 消息1.包含?(".xt:") { 示("FAIL 209-1: 消息缺 文件:行:列 -> " & 消息1) }
}
若 捕1 { 示("PASS 209-1: issue 原例成员硬错误已捕获(含成员名与位置)") } 否 { 示("FAIL 209-1: 未进捕捉块") }

// ② 嵌套成员链:字典→数组→字典→空 的链式成员访问
设 捕2 = 假
尝试 {
    设 容器 = {"内层": [{"值": 空}]}
    示(容器["内层"][0]["值"].长度)
} 捕捉 (e) {
    捕2 = 真
    若 非 字(e["消息"]).包含?("长度") { 示("FAIL 209-2: 消息缺成员名 -> " & 字(e["消息"])) }
}
若 捕2 { 示("PASS 209-2: 嵌套成员链硬错误已捕获") } 否 { 示("FAIL 209-2: 未进捕捉块") }

// ③ 索引非对象:空 值上做 []
设 捕3 = 假
尝试 {
    设 空值 = 空
    示(空值[0])
} 捕捉 (e) {
    捕3 = 真
    若 非 字(e["消息"]).包含?("索引访问") { 示("FAIL 209-3: 消息文案异常 -> " & 字(e["消息"])) }
}
若 捕3 { 示("PASS 209-3: 索引非对象硬错误已捕获") } 否 { 示("FAIL 209-3: 未进捕捉块") }

// ④ 方法缺失:动态分派查无此方法
设 捕4 = 假
尝试 {
    设 字典值 = {"x": 1}
    字典值.不存在()
} 捕捉 (e) {
    捕4 = 真
    若 非 字(e["消息"]).包含?("不存在") { 示("FAIL 209-4: 消息缺方法名 -> " & 字(e["消息"])) }
}
若 捕4 { 示("PASS 209-4: 方法缺失硬错误已捕获(含方法名)") } 否 { 示("FAIL 209-4: 未进捕捉块") }

// ⑤ 成员未知:字符串对象上的未知成员
设 捕5 = 假
尝试 {
    设 文本 = "abc"
    示(文本.不存在的成员)
} 捕捉 (e) {
    捕5 = 真
    若 非 字(e["消息"]).包含?("不存在的成员") { 示("FAIL 209-5: 消息缺成员名 -> " & 字(e["消息"])) }
}
若 捕5 { 示("PASS 209-5: 成员未知硬错误已捕获(含成员名)") } 否 { 示("FAIL 209-5: 未进捕捉块") }

// ⑥ 成员接收者守卫(含? 的对象守卫路径):空 上调用 含?
设 捕6 = 假
尝试 {
    设 空值2 = 解("null")
    示(空值2.含?("x"))
} 捕捉 (e) {
    捕6 = 真
    若 非 字(e["消息"]).包含?("含?") { 示("FAIL 209-6: 消息缺成员名 -> " & 字(e["消息"])) }
}
若 捕6 { 示("PASS 209-6: 含? 接收者守卫硬错误已捕获") } 否 { 示("FAIL 209-6: 未进捕捉块") }

// ⑦ 负索引:runtime 内 raise,尝试块内语句级轮询截走
设 捕7 = 假
尝试 {
    设 数组值 = [10, 20]
    设 取负 = 数组值[-1]
    示("FAIL 209-7: 负索引未触发")
} 捕捉 (e) {
    捕7 = 真
    若 非 字(e["消息"]).包含?("索引不能为负") { 示("FAIL 209-7: 消息文案异常 -> " & 字(e["消息"])) }
}
若 捕7 { 示("PASS 209-7: 负索引硬错误已捕获") } 否 { 示("FAIL 209-7: 未进捕捉块") }

// ⑧ 尝试 表达式形态:正常路径与异常路径都取到值
设 正常值 = 尝试 {
    设 x = 40
    x + 2
} 捕捉 (e) {
    0
}
若 正常值 == 42 { 示("PASS 209-8a: 尝试表达式正常路径取值") } 否 { 示("FAIL 209-8a: 取值错误 -> " & 字(正常值)) }

设 异常值 = 尝试 {
    设 无3 = {"x": 1}["不存在"]
    无3.长度
} 捕捉 (e) {
    7
}
若 异常值 == 7 { 示("PASS 209-8b: 尝试表达式异常路径取值") } 否 { 示("FAIL 209-8b: 取值错误 -> " & 字(异常值)) }

// 块尾不是表达式语句时,表达式值为 空(约定行为)
设 空值结果 = 尝试 {
    设 y = 1
    设 z = 2
} 捕捉 {
    9
}
若 空值结果 == 空 { 示("PASS 209-8c: 块尾非表达式时值为 空") } 否 { 示("FAIL 209-8c: 应为 空 -> " & 字(空值结果)) }

// ⑨ 嵌套尝试:内层捕获;捕捉块内再抛则冒到外层
设 内捕 = 假
设 外捕 = 假
尝试 {
    尝试 {
        设 无4 = {"x": 1}["不存在"]
        示(无4.长度)
    } 捕捉 {
        内捕 = 真
        设 无5 = {"x": 1}["不存在"]
        示(无5.长度)
    }
} 捕捉 (e) {
    外捕 = 真
    若 非 字(e["消息"]).包含?("长度") { 示("FAIL 209-9: 外层消息缺成员名 -> " & 字(e["消息"])) }
}
若 内捕 { 示("PASS 209-9a: 内层捕获") } 否 { 示("FAIL 209-9a: 内层未捕获") }
若 外捕 { 示("PASS 209-9b: 捕捉块内再抛冒到外层") } 否 { 示("FAIL 209-9b: 未冒到外层") }

// ⑩ 函数内 / 闭包内 尝试(独立 LLVM 函数的作用域,不得被外层捕捉栈污染)
函 捕手(): 整 {
    尝试 {
        设 无6 = {"x": 1}["不存在"]
        返 无6.长度
    } 捕捉 {
        返 99
    }
    返 -1
}
若 捕手() == 99 { 示("PASS 209-10a: 函数内捕获") } 否 { 示("FAIL 209-10a: 函数内未捕获 -> " & 字(捕手())) }

设 闭包捕 = 函() {
    尝试 {
        设 无7 = {"x": 1}["不存在"]
        返 无7.长度
    } 捕捉 {
        返 77
    }
}
若 闭包捕() == 77 { 示("PASS 209-10b: 闭包内捕获") } 否 { 示("FAIL 209-10b: 闭包内未捕获 -> " & 字(闭包捕())) }

// ⑪ 无 尝试 的同款硬错误仍是硬退出(子进程,exit 1 + 定位前缀)
设 子 = 执("\"" & xt_self_path() & "\" --child")
若 子.成功 { 示("FAIL 209-11a: 无 尝试 的硬错误未退出") }
抑 非 子.错误.包含?("退出码: 1") { 示("FAIL 209-11b: 退出码异常 -> " & 子.错误) }
抑 非 子.错误.包含?("运行时错误 [") { 示("FAIL 209-11c: 缺定位前缀 -> " & 子.错误) }
抑 非 子.错误.包含?("对非对象值") { 示("FAIL 209-11d: 缺诊断文案 -> " & 子.错误) }
否 { 示("PASS 209-11: 无 尝试 仍硬退出(exit 1 + 定位前缀)") }

示("--- 209_硬错误可捕获 结束 ---")
