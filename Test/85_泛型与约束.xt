// Test 85 — 泛型与约束(全断言)
示("=== Test 85: 泛型与约束 ===")
型 盒子<T> {
    设 内容: T
    函 造(初始内容: T) { 此.内容 = 初始内容 }
    函 获取() : T { 返 此.内容 }
}
设 _整盒 = 造 盒子<整>(123)
若 _整盒.获取() == 123 { 示("PASS: 泛型整盒") } 否 { 示("FAIL: 泛型整盒") }
设 _字盒 = 造 盒子<字>("玄铁")
若 _字盒.获取() == "玄铁" { 示("PASS: 泛型字盒") } 否 { 示("FAIL: 泛型字盒") }
函 首元<T>(列: T) {
    返 列[0]
}
设 _首 = 首元([9, 8, 7])
若 _首 == 9 { 示("PASS: 泛型函数") } 否 { 示("FAIL: 泛型函数") }
示("=== Test 85 完成 ===")
