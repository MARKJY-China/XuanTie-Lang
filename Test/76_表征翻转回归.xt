// Test 76 — 循环表征翻转回归(S1 根治的防护测试)
// 覆盖:函数/方法内循环中「再赋值不同表征值」的各类形态
// 历史背景:此类写法曾被 GSC 误编译(2x+1 双重打标),致结果错误乃至堆损坏

示("=== Test 76: 循环表征翻转回归 ===")

设 段 = [10, 20, 30, 40]

// 1. 普通函数内,列表索引算术再赋值
函 翻A() {
    设 acc = 0
    设 i = 0
    当 i < 4 {
        设 增量 = 段[i] - 1
        acc = acc + 增量 + 1
        i = i + 1
    }
    返 acc
}
若 翻A() == 100 { 示("PASS: 函数内索引算术翻转") } 否 { 示("FAIL: 函数内索引算术翻转") }

// 2. 型方法内同形态
型 翻机 {
    函 跑(此) {
        设 acc = 0
        设 i = 0
        当 i < 4 {
            设 增量 = 段[i] - 1
            acc = acc + 增量 + 1
            i = i + 1
        }
        返 acc
    }
}
设 _翻机 = 造 翻机()
若 _翻机.跑() == 100 { 示("PASS: 型方法内翻转") } 否 { 示("FAIL: 型方法内翻转") }

// 3. 嵌套循环内的翻转
函 翻B() {
    设 总 = 0
    设 i = 0
    当 i < 3 {
        设 j = 0
        当 j < 3 {
            设 值 = 段[j] - 9
            总 = 总 + 值
            j = j + 1
        }
        i = i + 1
      }
    返 总
}
// 每轮内层: (10-9)+(20-9)+(30-9)=33, 三轮=99
若 翻B() == 99 { 示("PASS: 嵌套循环翻转") } 否 { 示("FAIL: 嵌套循环翻转") }

// 4. 遍历循环中的翻转
函 翻C() {
    设 总 = 0
    遍历 v 于 段 {
        设 修 = v - 1
        总 = 总 + 修 + 1
    }
    返 总
}
若 翻C() == 100 { 示("PASS: 遍历循环翻转") } 否 { 示("FAIL: 遍历循环翻转") }

// 5. 字符串/对象与数字交替赋值(表征在 i64 间保持一致,不应翻转误编)
函 翻D() {
    设 x = 0
    设 i = 0
    当 i < 3 {
        x = 段[i] + i
        i = i + 1
    }
    返 x
}
// 末轮: 段[2]+2 = 32
若 翻D() == 32 { 示("PASS: 混合赋值") } 否 { 示("FAIL: 混合赋值") }

示("=== Test 76 完成 ===")
