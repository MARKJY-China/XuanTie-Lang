// Test/178_文本库.xt
// 文本扩展库（lib/文本/文本.xt）：填充/截断/计数/切分/命名风格/缩进/模板/判定
引 "../lib/文本/文本.xt" 予 T

设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

// 填充与居中
断言("填充左", T.填充左("玄铁", 6, "—") == "————玄铁")
断言("填充左多字符", T.填充左("a", 5, "xy") == "xyxya")
断言("填充左不截", T.填充左("abcdef", 3, " ") == "abcdef")
断言("填充右", T.填充右("ab", 5, ".") == "ab...")
断言("填充右空填充", T.填充右("a", 3, "") == "a  ")
断言("居中", T.居中("ab", 6, "-") == "--ab--")
断言("居中奇数右多", T.居中("ab", 5, "-") == "-ab--")

// 截断
断言("截断超长", T.截断("玄铁编程语言", 5, "…") == "玄铁编程…")
断言("截断不超", T.截断("abc", 5, "…") == "abc")
断言("截断零宽", T.截断("abc", 0, "…") == "")
断言("截断省略号更长", T.截断("abc", 2, "...") == "..")

// 计数与行
断言("计数", T.计数("a,b,,c,,", ",") == 5)
断言("计数不重叠", T.计数("aaaa", "aa") == 2)
断言("计数空子串", T.计数("abc", "") == 0)
断言("行数", T.行数("a\nb\n") == 3)
断言("行数空", T.行数("") == 0)
断言("取行CRLF", 化(T.取行("a\r\nb")) == "[\"a\", \"b\"]")
断言("取行空串", T.取行("").长度 == 1)
断言("词数", T.词数("  a  b\tc　d ") == 4)
断言("词数全空白", T.词数(" \t　") == 0)

// 前缀后缀与切分
断言("去前缀命中", T.去前缀("http://x", "http://") == "x")
断言("去前缀不命中", T.去前缀("x", "http://") == "x")
断言("去前缀空串", T.去前缀("x", "") == "x")
断言("去后缀命中", T.去后缀("a.txt", ".txt") == "a")
断言("去后缀不命中", T.去后缀("a.txt", ".md") == "a.txt")
断言("切分首", 化(T.切分首("a=b=c", "=")) == "[\"a\", \"b=c\"]")
断言("切分首无分隔", 化(T.切分首("abc", "=")) == "[\"abc\", \"\"]")
断言("切分首空分隔", 化(T.切分首("abc", "")) == "[\"abc\", \"\"]")
断言("切分尾", 化(T.切分尾("a=b=c", "=")) == "[\"a=b\", \"c\"]")
断言("切分尾无分隔", 化(T.切分尾("abc", "=")) == "[\"\", \"abc\"]")

// 命名风格
断言("首字大写", T.首字大写("hello") == "Hello")
断言("首字大写中文不动", T.首字大写("玄铁") == "玄铁")
断言("首字小写", T.首字小写("Hello") == "hello")
断言("首字大写空串", T.首字大写("") == "")
断言("到驼峰", T.到驼峰("user_name-x") == "userNameX")
断言("到驼峰单段", T.到驼峰("UserName") == "username")
断言("到驼峰全大写", T.到驼峰("user_name") == "userName")
断言("到蛇形", T.到蛇形("userName") == "user_name")
断言("到蛇形连续大写", T.到蛇形("HTTPServer") == "httpserver")
断言("到蛇形已是蛇形", T.到蛇形("user_id") == "user_id")
断言("到中划线", T.到中划线("userName") == "user-name")
断言("到标题", T.到标题("hello WORLD") == "Hello World")
断言("到标题全空白", T.到标题("   ") == "")

// 变换
断言("反转中文", T.反转("玄铁abc") == "cba铁玄")
断言("反转空串", T.反转("") == "")
断言("字符数组", 化(T.字符数组("玄a")) == "[\"玄\", \"a\"]")
断言("字符数组空", T.字符数组("").长度 == 0)
断言("去全部空白", T.去全部空白(" a b　c ") == "abc")
断言("压缩空白", T.压缩空白("  a   b  ") == "a b")
断言("压缩空白全空白", T.压缩空白("   ") == "")
断言("缩进", 化(T.缩进("a\nb", ">")) == "\">a\\n>b\"")
断言("去缩进", T.去缩进("  a\n  b\n    c") == "a\nb\n  c")
断言("去缩进无公共缩进", T.去缩进("a\nb") == "a\nb")

// 模板
断言("模板替换", T.模板("你好，{名字}！", {"名字": "玄铁"}) == "你好，玄铁！")
断言("模板未知键", T.模板("{缺}", {}) == "{缺}")
断言("模板转义", T.模板("{{x}}", {}) == "{x}")
断言("模板未闭合", T.模板("a{b", {}) == "a{b")
断言("模板数字值", T.模板("{n}", {"n": 42}) == "42")

// 判定
断言("空白?真", T.空白?(" \t　"))
断言("空白?假", 非 T.空白?("a"))
断言("数字?整", T.数字?("-42"))
断言("数字?小数", T.数字?("3.5"))
断言("数字?非数", 非 T.数字?("3x"))
断言("数字?空", 非 T.数字?(""))
断言("回文?中文", T.回文?("上海自来水来自海上"))
断言("回文?假", 非 T.回文?("玄铁"))
断言("包含任一?命中", T.包含任一?("玄铁语言", ["石头", "语言"]))
断言("包含任一?空候选", 非 T.包含任一?("玄铁", []))

若 失败数 == 0 { 示("文本库 全绿") } 否 { 示("文本库 失败数: " & 字(失败数)) }
