// Test/147_解编码错误输入守卫.xt
// 覆盖 URL解码/字节到字符串 的静态错误守卫(自执行双子进程模式,经命令行参数区分身份):
//   --child=urlbad    : URL解码("%ZZ")            → 期望 exit 1 + 提示含「非法转义」
//   --child=urltail   : URL解码("%E7")(转义不成完整 UTF-8) → 期望 exit 1 + 提示含「不是合法 UTF-8」
//   --child=bytesbad  : 字节到字符串(0xFF 非法 UTF-8) → 期望 exit 1 + 提示含「不是合法 UTF-8」
//   --child=bytesin   : 字节到字符串(字符串输入)      → 期望 exit 1 + 提示含「收到非字节输入」
// 设计纪律:身份判定用命令行参数(无状态、零残留,同 Test/122;历史标记文件握手曾致误判)

外 函 xt_get_args(): 数组
外 函 xt_self_path(): 字

示("--- 147_解编码错误输入守卫 开始 ---")

设 参 = xt_get_args()
设 身份 = ""
遍历 _a 于 参 {
    若 字(_a).包含?("--child=") { 身份 = 字(_a) }
}

若 身份 != "" {
    // ---- 子进程身份:触发守卫(内置会 exit(1),正常不会往下走) ----
    若 身份 == "--child=urlbad" {
        示("[子] " & URL解码("%ZZ"))
    } 抑 身份 == "--child=urltail" {
        示("[子] " & URL解码("%E7"))
    } 抑 身份 == "--child=bytesbad" {
        设 b = 字节(16)
        b.追加(255)
        示("[子] " & 字节到字符串(b))
    } 否 {
        示("[子] " & 字节到字符串("玄铁"))
    }
    示("[子] FAIL: 守卫未触发(内置应 exit 1)")
    终 0
}

// ---- 父进程身份:逐项断言子进程退出码与提示 ----
设 项表 = [
    ["--child=urlbad",   "非法转义"],
    ["--child=urltail",  "不是合法 UTF-8"],
    ["--child=bytesbad", "不是合法 UTF-8"],
    ["--child=bytesin",  "收到非字节输入"]
]
遍历 项 于 项表 {
    设 e = 执("\"" & xt_self_path() & "\" " & 项[0])
    若 e.成功 {
        示("FAIL[" & 项[0] & "]: 子进程退出码 0(守卫应 exit 1)")
    } 抑 (e.错误.包含?("退出码: 1") 且 e.错误.包含?(项[1])) {
        示("PASS[" & 项[0] & "]: 守卫触发(退出码 1 + 提示含「" & 项[1] & "」)")
    } 否 {
        示("FAIL[" & 项[0] & "]: 未含预期提示 → " & e.错误)
    }
}

示("--- 147_解编码错误输入守卫 结束 ---")
