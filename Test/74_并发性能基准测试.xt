// Test/74_并发性能基准测试.xt v2.1
// 分离测量：创建开销、纯调度切换、实际吞吐、可扩展性

示("╔══════════════════════════════╗")
示("║ 玄铁 并发性能基准 v2.1    ║")
示("║ 无栈状态机 架构性能分析   ║")
示("╚══════════════════════════════╝")
示("")

// ================================================================
// 基准1: 纯创建开销 — malloc + fiber 注册
// ================================================================
示("── [1] 创建开销 ──")

设 B1N = 300
设 b1start = 时.微秒()
设 b1tasks = []
设 b1i = 0
当 b1i < B1N {
    b1tasks.追加(异步 { 0 })
    b1i = b1i + 1
}
设 b1created = 时.微秒()
遍历 bt1 于 b1tasks { 等待(bt1) }
设 b1end = 时.微秒()

示("  创建 " & B1N & " 个 N=0:  " & (b1created - b1start) & " us  (" & ((b1created - b1start) / B1N) & " us/个)")
示("  创建+运行+等待:        " & (b1end - b1start) & " us  (" & ((b1end - b1start) / B1N) & " us/个)")

// ================================================================
// 基准2: 纯调度切换 — 单个 fiber 内 N 次 suspend/resume
// ================================================================
示("── [2] 纯调度切换 (suspend/resume) ──")

设 B2N = 100
设 b2inners = []
设 b2j = 0
当 b2j < B2N {
    b2inners.追加(异步 { 0 })
    b2j = b2j + 1
}
遍历 btx 于 b2inners { 等待(btx) }

设 b2start = 时.微秒()
设 b2outer = 异步 {
    遍历 bt2 于 b2inners { 等待(bt2) }
}
等待(b2outer)
设 b2end = 时.微秒()

设 b2total = b2end - b2start
示("  " & B2N & " 次 suspend/resume:  " & b2total & " us")
设 b2s_per = 1
若 b2total > 0 { b2s_per = b2total / B2N }
若 b2s_per < 1 {
    示("  单次切换:               <1 us")
    示("  切换速率:               >1M 次/秒")
} 否 {
    示("  单次切换:               " & b2s_per & " us")
    示("  切换速率:               " & (1000000 / b2s_per) & " 次/秒")
}

// ================================================================
// 基准3: fiber 生命周期 — 创建->调度->完成 全链路
// ================================================================
示("── [3] fiber 全生命周期 ──")

设 B3N = 200
设 b3start = 时.微秒()
设 b3tasks = []
设 b3k = 0
当 b3k < B3N {
    b3tasks.追加(异步 { 1 })
    b3k = b3k + 1
}
遍历 bt3 于 b3tasks { 等待(bt3) }
设 b3end = 时.微秒()

设 b3total = b3end - b3start
示("  " & B3N & " 个 fiber 全链路:  " & b3total & " us")
设 b3per = 1
若 b3total > 0 { b3per = b3total / B3N }
若 b3per < 1 {
    示("  单 fiber 全链路:         <1 us")
    示("  吞吐:                    >1M fiber/秒")
} 否 {
    示("  单 fiber 全链路:         " & b3per & " us")
    示("  吞吐:                    " & (1000000 / b3per) & " fiber/秒")
}

// ================================================================
// 基准4: 深度嵌套 — 多层等待的 switch 跳转成本
// ================================================================
示("── [4] 深度嵌套切换 ──")

设 B4N = 100
设 b4start = 时.微秒()
设 b4k = 0
当 b4k < B4N {
    设 b4inner = 异步 { 0 }
    设 b4outer = 异步 { 等待(b4inner) }
    等待(b4outer)
    b4k = b4k + 1
}
设 b4end = 时.微秒()

设 b4total = b4end - b4start
设 b4per = 1
若 b4total > 0 { b4per = b4total / B4N }
示("  " & B4N & " 次嵌套等待:  " & b4total & " us")
示("  单次:                    " & b4per & " us")

// ================================================================
// 基准5: 批量并发 — N 个 fiber 在调度器内排队运行
// ================================================================
示("── [5] 批量并发吞吐 ──")

设 B5N = 200
设 b5inners = []
设 b5m = 0
当 b5m < B5N {
    b5inners.追加(异步 { 时.睡(1) })
    b5m = b5m + 1
}

设 b5start = 时.毫秒()
设 b5outer = 异步 {
    遍历 bt5 于 b5inners { 等待(bt5) }
}
等待(b5outer)
设 b5end = 时.毫秒()

设 b5total = b5end - b5start
若 b5total < 1 { b5total = 1 }
示("  " & B5N & " 并发 fiber (各 1ms): " & b5total & " ms")
示("  等效吞吐:                 " & (B5N * 1000 / b5total) & " fiber/秒")

// ================================================================
// 基准6: 可扩展性 — 极限 fiber 数
// ================================================================
示("── [6] 可扩展性极限 ──")

设 b6limit = 500
设 b6ok = 0
设 b6fail = 0

设 b6inners = []
设 b6n = 0
当 b6n < b6limit {
    设 b6t = 异步 { 时.睡(10) }
    若 b6t != 空 {
        b6inners.追加(b6t)
        b6ok = b6ok + 1
    } 否 {
        b6fail = b6fail + 1
        断
    }
    b6n = b6n + 1
}

设 b6outer = 异步 {
    遍历 bt6 于 b6inners { 等待(bt6) }
}
等待(b6outer)
示("  成功: " & b6ok & " / " & b6limit & "  失败: " & b6fail)

// ================================================================
// 汇总
// ================================================================
示("")
示("╔═══════════════════════════════════════╗")
示("║              汇总                    ║")
示("╠═══════════════════════════════════════╣")

设 b1c_avg = (b1created - b1start) / B1N
示("║ 创建开销:     " & b1c_avg & " us/fiber                  ║")

若 b2s_per < 1 {
    示("║ 切换延迟:     <1 us/switch              ║")
    示("║ 单切换/秒:    >1M                    ║")
} 否 {
    示("║ 切换延迟:     " & b2s_per & " us/switch              ║")
    示("║ 单切换/秒:    " & (1000000 / b2s_per) & "                    ║")
}

若 b3per < 1 {
    示("║ 全链路:       <1 us/fiber                  ║")
    示("║ fiber/秒:     >1M                    ║")
} 否 {
    示("║ 全链路:       " & b3per & " us/fiber                  ║")
    示("║ fiber/秒:     " & (1000000 / b3per) & "                    ║")
}

示("║ 极限 fiber:   " & b6ok & "                        ║")
示("╚═══════════════════════════════════════╝")
