// Test/217_小数数组无检查访问.xt
// 显式 unsafe 接口:调用方保证下标在界内且接收者是 小数数组。
示("--- 217_小数数组无检查访问 开始 ---")

设 实: 小数数组 = []
设 i: 整 = 0
当 i < 8 {
    实.追加(i)
    i = i + 1
}
设 总: 小数 = 0.0
i = 0
当 i < 8 {
    总 = 总 + 实.无检查取(i)
    i = i + 1
}
示("总=#{总}")
实.无检查设(3, 9.5)
示("三=#{实.无检查取(3)}")
示("--- 217_小数数组无检查访问 结束 ---")
