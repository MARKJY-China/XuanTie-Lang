// Test/208_运行时错误定位.xt
// issue #110:运行时错误诊断必须带源码位置,格式「运行时错误 [文件:行:列]: ...」。
// 覆盖:成员缺失 / 索引非对象 / 方法缺失 / 注解参数类型 四类硬错误的定位前缀,
//       用自执行子进程逐一断言(子进程 stderr 经 执() 的 .错误 取回;退出码须为 1)。
// 基线末尾:本进程直接触发一次无 尝试 的成员硬错误 → exit 1,
//           stderr 精确钉死「运行时错误 [<ROOT>\Test\208_运行时错误定位.xt:行:列]: ...」。
外 函 xt_get_args(): 数组
外 函 xt_self_path(): 字

示("--- 208_运行时错误定位 开始 ---")

设 参 = xt_get_args()
设 是子进程 = 假
设 场景 = ""
遍历 _a 于 参 {
    若 字(_a) == "--child" { 是子进程 = 真 }
    若 字(_a) == "member" { 场景 = "member" }
    若 字(_a) == "index" { 场景 = "index" }
    若 字(_a) == "method" { 场景 = "method" }
    若 字(_a) == "param" { 场景 = "param" }
}

// ---- 子进程身份:触发指定硬错误(exit(1),不返回) ----
若 是子进程 {
    若 场景 == "member" {
        设 无 = {"x": 1}["不存在"]
        示(无.长度)
    } 抑 场景 == "index" {
        设 数 = 1
        示(数[0])
    } 抑 场景 == "method" {
        设 字典值 = {"x": 1}
        字典值.不存在()
    } 否 {
        函 严格(值: 整): 整 { 返 值 * 2 }
        示(严格("文本"))
    }
    示("FAIL 208: 子进程硬错误未触发退出")
    终 0
}

// ---- 父进程身份:逐场景重启自身,断言 退出码/定位前缀/诊断文案 ----
// 返回 0=全部符合;1=未退出;2=退出码不对;3=缺定位前缀;4=缺诊断文案
函 查子(场景, 片段): 整 {
    设 子 = 执("\"" & xt_self_path() & "\" --child " & 场景)
    若 子.成功 { 返 1 }
    若 非 子.错误.包含?("退出码: 1") { 返 2 }
    若 非 子.错误.包含?("运行时错误 [") { 返 3 }
    若 非 子.错误.包含?(片段) { 返 4 }
    返 0
}

设 码1 = 查子("member", "对非对象值(整数/布尔/空)访问成员 '长度'")
若 码1 == 0 { 示("PASS 208-1: 成员缺失硬错误带 文件:行:列 + 成员名") } 否 { 示("FAIL 208-1: 子进程断言码 " & 字(码1)) }

设 码2 = 查子("index", "对非对象值(整数/布尔/空)进行索引访问")
若 码2 == 0 { 示("PASS 208-2: 索引非对象硬错误带 文件:行:列") } 否 { 示("FAIL 208-2: 子进程断言码 " & 字(码2)) }

设 码3 = 查子("method", "调用了对象不存在的方法: '不存在'")
若 码3 == 0 { 示("PASS 208-3: 方法缺失硬错误带 文件:行:列 + 方法名") } 否 { 示("FAIL 208-3: 子进程断言码 " & 字(码3)) }

设 码4 = 查子("param", "参数类型不匹配——形参注解为 '整'")
若 码4 == 0 { 示("PASS 208-4: 参数类型硬错误带位置(函数定义处)") } 否 { 示("FAIL 208-4: 子进程断言码 " & 字(码4)) }

// ---- 本进程直接触发一次无 尝试 的成员硬错误(基线钉死精确位置格式与 exit 1) ----
示("--- 触发无 尝试 的成员硬错误(预期退出码 1) ---")
设 无值 = {"x": 1}["不存在"]
示(无值.长度)
示("FAIL 208: 硬错误未退出")
