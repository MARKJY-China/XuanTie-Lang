// Test/201_数组排序升级.xt
// 覆盖 lib/数组/数组.xt 的 排序（稳定归并 O(n log n)，原地语义、返回同一数组对象）
// 与 排序依据（按数值键稳定排序，返回新数组）。
// 判定：PASS/FAIL 标记 + 确定性输出（可作回归 golden）；比较次数上界钉死 O(n log n)，
// 冒泡在同等规模下比较次数为 n*(n-1)/2（1500 元素约 112 万次），两者相差两个数量级。

引 "../lib/数组/数组.xt" 予 A

示("--- 201 数组排序升级 开始 ---")

// 1. 边界：空数组 / 单元素 / 两元素
设 空列 = []
设 空列回 = A.排序(空列, 函(a, b) { 返 a - b })
若 空列回.长度 == 0 { 示("PASS: 空数组") } 否 { 示("FAIL: 空数组") }

设 单 = [7]
A.排序(单, 函(a, b) { 返 a - b })
若 单.长度 == 1 且 单[0] == 7 { 示("PASS: 单元素") } 否 { 示("FAIL: 单元素") }

设 双 = [2, 1]
A.排序(双, 函(a, b) { 返 a - b })
若 双[0] == 1 且 双[1] == 2 { 示("PASS: 两元素") } 否 { 示("FAIL: 两元素") }

// 2. 原地语义：返回的必须是传入的同一个数组对象（改返回值会被原数组看到）
设 原 = [3, 1, 2]
设 回 = A.排序(原, 函(a, b) { 返 a - b })
回[0] = 99
若 原[0] == 99 { 示("PASS: 返回同一数组对象（原地）") } 否 { 示("FAIL: 返回的不是同一对象") }
原[0] = 1
若 原[0] == 1 且 原[1] == 2 且 原[2] == 3 { 示("PASS: 升序结果") } 否 { 示("FAIL: 升序结果错误") }

// 3. 重复元素 / 负数 / 已排序 / 逆序
设 重复 = [3, 1, 3, 2, 1, 3]
A.排序(重复, 函(a, b) { 返 a - b })
若 重复[0] == 1 且 重复[1] == 1 且 重复[2] == 2 且 重复[3] == 3 且 重复[4] == 3 且 重复[5] == 3 {
    示("PASS: 重复元素")
} 否 {
    示("FAIL: 重复元素")
}

设 负 = [0, -5, 3, -1, 2, -5]
A.排序(负, 函(a, b) { 返 a - b })
若 负[0] == -5 且 负[1] == -5 且 负[2] == -1 且 负[3] == 0 且 负[4] == 2 且 负[5] == 3 {
    示("PASS: 负数")
} 否 {
    示("FAIL: 负数")
}

设 已序 = [1, 2, 3, 4, 5]
A.排序(已序, 函(a, b) { 返 a - b })
若 已序[0] == 1 且 已序[4] == 5 { 示("PASS: 已排序输入") } 否 { 示("FAIL: 已排序输入") }

设 逆序 = [5, 4, 3, 2, 1]
A.排序(逆序, 函(a, b) { 返 a - b })
若 逆序[0] == 1 且 逆序[4] == 5 { 示("PASS: 逆序输入") } 否 { 示("FAIL: 逆序输入") }

// 4. 稳定性：按 [键, 名字] 的键排序，键相等的元素必须保持原有相对顺序
设 二元组 = [[2, "a"], [1, "b"], [2, "c"], [1, "d"], [2, "e"]]
A.排序(二元组, 函(a, b) { 返 a[0] - b[0] })
示("稳定序: #{二元组[0][1]}#{二元组[1][1]}#{二元组[2][1]}#{二元组[3][1]}#{二元组[4][1]}")
若 二元组[0][1] == "b" 且 二元组[1][1] == "d" 且 二元组[2][1] == "a" 且 二元组[3][1] == "c" 且 二元组[4][1] == "e" {
    示("PASS: 稳定排序")
} 否 {
    示("FAIL: 稳定排序被破坏")
}

// 5. 自定义比较函：降序
设 降 = [3, 1, 4, 1, 5]
A.排序(降, 函(a, b) { 返 b - a })
示("降序: #{降[0]},#{降[1]},#{降[2]},#{降[3]},#{降[4]}")
若 降[0] == 5 且 降[1] == 4 且 降[2] == 3 且 降[3] == 1 且 降[4] == 1 {
    示("PASS: 自定义比较函（降序）")
} 否 {
    示("FAIL: 自定义比较函（降序）")
}

// 6. 随机 1500 元素：确定性 LCG 生成，验证有序且元素多重集不变（长度/和/平方和）
设 种子 = 20261120
设 随机 = []
设 生成 = 0
当 生成 < 1500 {
    种子 = (种子 * 1103515245 + 12345) % 2147483648
    随机.追加(种子 % 4001 - 2000)
    生成 = 生成 + 1
}
设 期望和 = 0
设 期望平方和 = 0
遍历 值 于 随机 {
    期望和 = 期望和 + 值
    期望平方和 = 期望平方和 + 值 * 值
}
A.排序(随机, 函(a, b) { 返 a - b })
设 有序 = 真
设 实际和 = 0
设 实际平方和 = 0
设 下标 = 0
当 下标 < 随机.长度 {
    若 下标 > 0 {
        若 随机[下标] < 随机[下标 - 1] { 有序 = 假 }
    }
    实际和 = 实际和 + 随机[下标]
    实际平方和 = 实际平方和 + 随机[下标] * 随机[下标]
    下标 = 下标 + 1
}
示("随机1500: 长度=#{随机.长度} 和=#{实际和}")
若 有序 且 随机.长度 == 1500 且 实际和 == 期望和 且 实际平方和 == 期望平方和 {
    示("PASS: 随机1500 有序且元素一致")
} 否 {
    示("FAIL: 随机1500 结果错误 有序=#{有序} 和=#{实际和}/#{期望和} 平方和=#{实际平方和}/#{期望平方和}")
}

// 7. 复杂度门禁：1500 元素比较次数必须远小于冒泡的 n*(n-1)/2=1124250 次
设 次数 = [0]
设 计数比 = 函(a, b) {
    次数[0] = 次数[0] + 1
    返 a - b
}
设 计数数据 = []
设 计数生成 = 0
设 计数种子 = 777
当 计数生成 < 1500 {
    计数种子 = (计数种子 * 1103515245 + 12345) % 2147483648
    计数数据.追加(计数种子 % 1000)
    计数生成 = 计数生成 + 1
}
A.排序(计数数据, 计数比)
示("1500元素比较次数: #{次数[0]}")
若 次数[0] <= 37500 { 示("PASS: 比较次数符合 O(n log n)") } 否 { 示("FAIL: 比较次数过多，疑似退化为 O(n²)") }

// 8. 排序依据：按数值键升序，返回新数组且不修改原数组
设 依据源 = [3, 1, 2]
设 依据果 = A.排序依据(依据源, 函(x) { 返 x })
若 依据源[0] == 3 且 依据源[1] == 1 且 依据源[2] == 2 {
    示("PASS: 排序依据不修改原数组")
} 否 {
    示("FAIL: 排序依据修改了原数组")
}
若 依据果[0] == 1 且 依据果[1] == 2 且 依据果[2] == 3 {
    示("PASS: 排序依据升序")
} 否 {
    示("FAIL: 排序依据升序错误")
}
依据果[0] = 99
若 依据源[0] == 3 { 示("PASS: 排序依据返回新数组") } 否 { 示("FAIL: 排序依据返回的不是新数组") }

// 9. 排序依据稳定性：按 [键, 名字] 的键排序，键相等保持原顺序
设 依据组 = [[2, "a"], [1, "b"], [2, "c"], [1, "d"], [2, "e"]]
设 依据组果 = A.排序依据(依据组, 函(对) { 返 对[0] })
示("依据稳定序: #{依据组果[0][1]}#{依据组果[1][1]}#{依据组果[2][1]}#{依据组果[3][1]}#{依据组果[4][1]}")
若 依据组果[0][1] == "b" 且 依据组果[1][1] == "d" 且 依据组果[2][1] == "a" 且 依据组果[3][1] == "c" 且 依据组果[4][1] == "e" {
    示("PASS: 排序依据稳定")
} 否 {
    示("FAIL: 排序依据稳定性被破坏")
}

// 10. 排序依据：空数组 / 小数与负数键 / 每个元素只取键一次
设 依据空 = A.排序依据([], 函(x) { 返 x })
若 依据空.长度 == 0 { 示("PASS: 排序依据空数组") } 否 { 示("FAIL: 排序依据空数组") }

设 小数键 = [2.5, -1.5, 0.5, -1.5]
设 小数果 = A.排序依据(小数键, 函(x) { 返 x })
示("小数键: #{小数果[0]},#{小数果[1]},#{小数果[2]},#{小数果[3]}")
若 小数果[0] == -1.5 且 小数果[1] == -1.5 且 小数果[2] == 0.5 且 小数果[3] == 2.5 {
    示("PASS: 排序依据小数/负数键")
} 否 {
    示("FAIL: 排序依据小数/负数键")
}

设 取键次数 = [0]
设 取键 = 函(x) {
    取键次数[0] = 取键次数[0] + 1
    返 x % 97
}
设 取键源 = []
设 取键生成 = 0
当 取键生成 < 1200 {
    取键源.追加(取键生成 * 13 - 600)
    取键生成 = 取键生成 + 1
}
设 取键果 = A.排序依据(取键源, 取键)
示("1200元素取键次数: #{取键次数[0]}")
若 取键次数[0] == 1200 { 示("PASS: 排序依据每个元素只取键一次") } 否 { 示("FAIL: 取键次数不等于元素个数") }
若 取键果.长度 == 1200 { 示("PASS: 排序依据结果长度") } 否 { 示("FAIL: 排序依据结果长度错误") }

示("--- 201 数组排序升级 结束 ---")
