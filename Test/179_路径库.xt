// Test/179_路径库.xt
// 路径处理库（lib/路径/路径.xt）：拼接/规范化/取件/相对/文件名规则
// 说明：断言按平台分隔符构造期望值，Windows 与 Linux/macOS 均应全绿。
引 "../lib/路径/路径.xt" 予 P

设 失败数 = 0
设 分 = P.分隔符()
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

// 分隔符
断言("分隔符取值", 分 == "\\" 或 分 == "/")

// 拼接
断言("拼接普通", P.拼接("src", "main.xt") == "src" & 分 & "main.xt")
断言("拼接基带尾斜", P.拼接("src" & 分, "main.xt") == "src" & 分 & "main.xt")
断言("拼接空基", P.拼接("", "main.xt") == "main.xt")
断言("拼接空子", P.拼接("src", "") == "src")
断言("拼接绝对子", P.拼接("src", "C:/x") == "C:/x")
断言("连接", P.连接(["项目", "src", "main.xt"]) == "项目" & 分 & "src" & 分 & "main.xt")
断言("连接含空段", P.连接(["a", "", "b"]) == "a" & 分 & "b")
断言("连接空数组", P.连接([]) == "")

// 绝对与根
断言("绝对?盘符", P.绝对?("C:\\x"))
断言("绝对?根斜杠", P.绝对?("/x"))
断言("绝对?相对", 非 P.绝对?("x"))
断言("绝对?空", 非 P.绝对?(""))
断言("根盘符", P.根("C:\\a\\b") == "C:" & 分)
断言("根裸盘符", P.根("C:a") == "C:")
断言("根斜杠", P.根("/a") == 分)
断言("根相对", P.根("a") == "")

// 目录与文件名
断言("目录", P.目录("a" & 分 & "b.txt") == "a")
断言("目录根下", P.目录(分 & "a") == 分)
断言("目录无分隔", P.目录("a.txt") == "")
断言("文件名", P.文件名("a" & 分 & "b.txt") == "b.txt")
断言("文件名尾斜", P.文件名("a" & 分 & "b" & 分) == "")
断言("文件名无分隔", P.文件名("b.txt") == "b.txt")

// 扩展名与主名
断言("扩展名", P.扩展名("a" & 分 & "b.tar.gz") == ".gz")
断言("扩展名隐藏文件", P.扩展名(".gitignore") == "")
断言("扩展名点结尾", P.扩展名("a.") == "")
断言("扩展名无", P.扩展名("ab") == "")
断言("主名", P.主名("a" & 分 & "b.tar.gz") == "b.tar")
断言("主名无扩展", P.主名("ab") == "ab")
断言("去扩展名", P.去扩展名("a" & 分 & "b.txt") == "a" & 分 & "b")
断言("去扩展名无", P.去扩展名("a" & 分 & "b") == "a" & 分 & "b")
断言("换扩展名", P.换扩展名("a" & 分 & "b.txt", "md") == "a" & 分 & "b.md")
断言("换扩展名带点", P.换扩展名("a" & 分 & "b.txt", ".md") == "a" & 分 & "b.md")
断言("换扩展名清空", P.换扩展名("a" & 分 & "b.txt", "") == "a" & 分 & "b")

// 规范化
断言("规范化点点", P.规范化("a/./b/../c") == "a" & 分 & "c")
断言("规范化反斜杠", P.规范化("a\\b") == "a" & 分 & "b")
断言("规范化重复斜杠", P.规范化("a//b") == "a" & 分 & "b")
断言("规范化前导点点", P.规范化("..") == "..")
断言("规范化相对越界", P.规范化("a/../../b") == ".." & 分 & "b")
断言("规范化绝对越界", P.规范化("/../a") == 分 & "a")
断言("规范化空串", P.规范化("") == "")
断言("规范化点", P.规范化(".") == ".")
断言("规范化盘符", P.规范化("C:/项目/a.txt") == "C:" & 分 & "项目" & 分 & "a.txt")

// 相对与绝对
断言("相对子路径", P.相对("C:/项目/库/文本.xt", "C:/项目/示例") == ".." & 分 & "库" & 分 & "文本.xt")
断言("相对同目录", P.相对("C:/项目/示例/a", "C:/项目/示例") == "a")
断言("相对相同", P.相对("C:/项目", "C:/项目") == ".")
断言("相对跨盘", P.相对("D:/x", "C:/y") == "D:" & 分 & "x")
断言("绝对已绝对", P.绝对("C:/项目") == "C:" & 分 & "项目")

// 拆分
设 拆 = P.拆分("C:/项目/a.txt")
断言("拆分根", 拆["根"] == "C:" & 分)
断言("拆分目录", 拆["目录"] == "C:/项目")
断言("拆分文件名", 拆["文件名"] == "a.txt")
断言("拆分主名", 拆["主名"] == "a")
断言("拆分扩展名", 拆["扩展名"] == ".txt")

// 系统目录（只判形状，不判具体值，避免基线随机器漂移）
设 临时 = P.临时目录()
断言("临时目录非空", 临时 != "")
断言("临时目录无尾斜", 临时.字符数 == 1 或 非 临时.以结尾(分))
设 家 = P.家目录()
断言("家目录无尾斜", 家 == "" 或 家.字符数 == 1 或 非 家.以结尾(分))

// 文件名规则
断言("非法字符", 化(P.非法字符("a:b*c?")) == "[\":\", \"*\", \"?\"]")
断言("非法字符无", P.非法字符("abc.txt").长度 == 0)
断言("合法名", P.合法名?("a.txt"))
断言("合法名冒号", 非 P.合法名?("a:b"))
断言("合法名空", 非 P.合法名?(""))
断言("合法名点点", 非 P.合法名?(".."))
断言("合法名尾空格", 非 P.合法名?("a "))
断言("合法名尾点", 非 P.合法名?("a."))
断言("合法名保留设备", 非 P.合法名?("nul"))
断言("合法名保留设备带扩展", 非 P.合法名?("CON.txt"))
断言("合法名COM1", 非 P.合法名?("COM1"))
断言("合法名COM0", P.合法名?("COM0"))
断言("同名", P.同名?("C:/A/b.txt", "C:\\A\\b.txt"))
断言("同名不同", 非 P.同名?("C:/A/b.txt", "C:/A/c.txt"))

// 分隔符转换
断言("转斜杠", P.转斜杠("a\\b/c") == "a/b/c")
断言("转反斜杠", P.转反斜杠("a/b\\c") == "a\\b\\c")
断言("规范化分隔符", P.规范化分隔符("a/b\\c") == "a" & 分 & "b" & 分 & "c")

若 失败数 == 0 { 示("路径库 全绿") } 否 { 示("路径库 失败数: " & 字(失败数)) }
