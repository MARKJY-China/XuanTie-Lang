// Test/183_HTTP代理.xt
// 覆盖 HTTP CONNECT 代理(选项方式):求() 双参与 HTTP.流打开 共用 "代理" 选项。
//   A. 求 + 代理:发 CONNECT 目标正确、隧道内请求行正确
//   B. 流式 + 代理:同上,按行读回
//   C. 代理 407:明确报错且带状态码(不静默直连)
//   D. 非法代理地址(socks5://):明确报错(不支持 SOCKS5)
// 环境变量方式(HTTP_PROXY/HTTPS_PROXY/ALL_PROXY)依赖进程环境,由开发期手工验证,不进 CI。
引 "HTTP" 予 HTTP

示("--- 183_HTTP代理 开始 ---")
设 失败 = 0

// 假 CONNECT 代理:回 200 后把 CONNECT 行与隧道内请求行包进响应体
设 代理 = 听(19481, 函(流) {
    设 头 = ""
    当 真 {
        设 块 = 流.读(4096)
        若 块 == 空 { 断 }
        头 = 头 & 块
        若 头.包含?("\r\n\r\n") { 断 }
    }
    设 首行 = 头.分割("\r\n")[0]
    流.写("HTTP/1.1 200 Connection Established\r\n\r\n")
    设 请求 = ""
    当 真 {
        设 块 = 流.读(4096)
        若 块 == 空 { 断 }
        请求 = 请求 & 块
        若 请求.包含?("\r\n\r\n") { 断 }
    }
    设 请求行 = 请求.分割("\r\n")[0]
    设 体 = "CONNECT=" & 首行 & "|REQ=" & 请求行
    流.写("HTTP/1.1 200 OK\r\nContent-Length: " & 体.字节数.转字() & "\r\nConnection: close\r\n\r\n" & 体)
    流.关()
})
若 非 代理.成功 { 示("FAIL 0 假代理启动: " & 代理.错误) ; 失败 = 1 }

// 407 代理
设 拒 = 听(19482, 函(流) {
    设 头 = ""
    当 真 {
        设 块 = 流.读(4096)
        若 块 == 空 { 断 }
        头 = 头 & 块
        若 头.包含?("\r\n\r\n") { 断 }
    }
    流.写("HTTP/1.1 407 Proxy Authentication Required\r\nContent-Length: 0\r\n\r\n")
    流.关()
})
若 非 拒.成功 { 示("FAIL 0b 407 代理启动: " & 拒.错误) ; 失败 = 1 }
时.睡(100)

// A. 求 + 代理选项
设 a = 求("http://127.0.0.1:19483/x", {"代理": "http://127.0.0.1:19481"})
若 非 a.成功 {
    示("FAIL A1 " & a.错误)
    失败 = 1
} 否 {
    若 非 (a.值["体"].包含?("CONNECT 127.0.0.1:19483") 且 a.值["体"].包含?("GET /x")) {
        示("FAIL A2 求 未走代理: " & a.值["体"])
        失败 = 1
    }
}

// B. 流式 + 代理选项
设 b = HTTP.流打开("http://127.0.0.1:19483/y", {"方法": "GET", "代理": "http://127.0.0.1:19481"})
若 非 b.成功 {
    示("FAIL B1 " & b.错误)
    失败 = 1
} 否 {
    设 行 = HTTP.流读行(b.值, 3000)
    若 非 行.成功 {
        示("FAIL B2 " & 行.错误)
        失败 = 1
    } 否 {
        若 非 (行.值.包含?("CONNECT 127.0.0.1:19483") 且 行.值.包含?("GET /y")) {
            示("FAIL B3 流式 未走代理: " & 行.值)
            失败 = 1
        }
    }
    HTTP.流关(b.值)
}

// C. 407:明确失败且带状态码
设 c = 求("http://127.0.0.1:19483/z", {"代理": "http://127.0.0.1:19482"})
若 c.成功 {
    示("FAIL C1 407 竟然成功")
    失败 = 1
} 否 {
    若 非 c.错误.包含?("407") { 示("FAIL C2 错误未带 407: " & c.错误) ; 失败 = 1 }
}
设 c2 = HTTP.流打开("http://127.0.0.1:19483/w", {"方法": "GET", "代理": "http://127.0.0.1:19482"})
若 c2.成功 {
    示("FAIL C3 流式 407 竟然成功")
    失败 = 1
} 否 {
    若 非 c2.错误.包含?("407") { 示("FAIL C4 流式错误未带 407: " & c2.错误) ; 失败 = 1 }
}

// D. 非法代理地址
设 d = 求("http://127.0.0.1:19483/v", {"代理": "socks5://127.0.0.1:1"})
若 d.成功 {
    示("FAIL D1 非法代理竟然成功")
    失败 = 1
} 否 {
    若 非 d.错误.包含?("代理地址无效") { 示("FAIL D2 " & d.错误) ; 失败 = 1 }
}

若 失败 == 0 { 示("183 PASS") } 否 { 示("183 FAIL") ; 终 1 }
示("--- 183_HTTP代理 结束 ---")
