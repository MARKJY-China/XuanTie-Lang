// Test/131_关键字表达式位置回归.xt
// 保留字不得作标识符(见 124),但**关键字在表达式位置**必须继续可用——这条守住"禁止"不要越界:
//   整()/小数()/字() 类型转换、道() 建通道、造 型<整>() 泛型实例化、
//   此.字段 实例成员、结果 类型注解、{甲, 乙} 解构、以及 若/返/遍历 等语法关键字本身。
// 判定:全部输出正确且进程干净退出。

示("--- 131_关键字表达式位置回归 开始 ---")

// 1. 类型转换关键字(整/小数/字 都是保留字,但作为转换函数必须可用)
设 s = 整("42")
设 f = 小数("3.14")
设 t = 字(7)
若 s.成功 且 s.值 == 42 { 示("PASS: 整(\"42\") = " & s.值.转字()) } 否 { 示("FAIL: 整()") }
若 f.值 == 3.14 { 示("PASS: 小数(\"3.14\") = " & f.值.转字()) } 否 { 示("FAIL: 小数()") }
若 t == "7" { 示("PASS: 字(7) = " & t) } 否 { 示("FAIL: 字()") }

// 2. 道() 建通道(保留字作构造原语)
设 ch = 道(2)
ch.发("甲")
若 ch.收() == "甲" { 示("PASS: 道() 通道收发") } 否 { 示("FAIL: 道()") }

// 3. 型名含保留字? 不允许;但泛型实例化 造 型<整>() 必须可用
型 盒<T> {
    设 内容: T
    函 造(v: T) { 此.内容 = v }
    函 取() : T { 返 此.内容 }
}
设 b = 造 盒<整>(99)
若 b.取() == 99 { 示("PASS: 造 盒<整>() = " & b.取().转字()) } 否 { 示("FAIL: 泛型实例化") }

// 4. 此.成员 与 结果 类型注解
设 r = 整("abc")
若 非 r.成功 { 示("PASS: 结果 类型注解 + 判定失败") } 否 { 示("FAIL: 结果 判定") }

// 5. 解构(名字是普通标识符,不受保留字规则影响)
设 {甲, 乙} = {"甲": 1, "乙": 2}
若 甲 == 1 且 乙 == 2 { 示("PASS: 字典解构 = " & 甲.转字() & 乙.转字()) } 否 { 示("FAIL: 解构") }

// 6. 语法关键字本身:若/否/当/遍历/返/异步/等待
函 累加(n: 整) : 整 {
    设 和 = 0
    遍历 i 于 [1, 2, 3] {
        若 i <= n { 和 = 和 + i } 否 { 断 }
    }
    返 和
}
若 累加(2) == 3 { 示("PASS: 若/遍历/断/返 = " & 累加(2).转字()) } 否 { 示("FAIL: 控制流") }
设 tk = 异步 { 返 5 }
若 等待(tk) == 5 { 示("PASS: 异步/等待 = 5") } 否 { 示("FAIL: 异步") }

示("--- 131_关键字表达式位置回归 结束 ---")
