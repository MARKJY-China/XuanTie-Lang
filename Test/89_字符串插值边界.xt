// Test 89 — 字符串插值边界(全断言)
示("=== Test 89: 字符串插值边界 ===")
设 名 = "玄铁"
设 n = 7
设 s1 = "值=#{n}"
若 s1 == "值=7" { 示("PASS: 基本插值") } 否 { 示("FAIL: 基本插值 " & s1) }
设 s2 = "算=#{1 + 2 * 3}"
若 s2 == "算=7" { 示("PASS: 表达式插值") } 否 { 示("FAIL: 表达式插值 " & s2) }
设 s3 = "嵌#{名 & "铁"}尾"
若 s3 == "嵌玄铁铁尾" { 示("PASS: 拼接插值") } 否 { 示("FAIL: 拼接插值 " & s3) }
设 s4 = "#{n}#{n}#{n}"
若 s4 == "777" { 示("PASS: 连续插值") } 否 { 示("FAIL: 连续插值 " & s4) }
设 s5 = "无插值"
若 s5 == "无插值" { 示("PASS: 无插值原样") } 否 { 示("FAIL: 无插值原样") }
示("=== Test 89 完成 ===")
