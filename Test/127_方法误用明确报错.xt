// Test/127_方法误用明确报错.xt
// 覆盖"错类型对象误用方法"的三条路径——都必须**明确报错退出**,不得崩溃也不得静默:
//   ① 字符串用数组方法(如 s.找(...)):旧行为按 XTArray 布局读字符串 → 越界踩内存 → 段错误;
//   ② 字典用追加:编译器给 追加 做了运行时类型分派(数组/字节两分支),字典落到字节分支
//      → 旧行为静默返回(打印 null 后继续执行);现字节分支校验接收者类型 → 明确报错;
//   ③ 非字符串用字符串方法(如 数组.截取):原本已有明确报错,此处一并纳入守卫网。
// 判定:子进程各自报错且退出码非 0,提示文本含方法名与实际类型;父进程断言退出码与提示。
// 注:用父子进程模式(命令行参数判身份,无状态残留)——场景本身会 exit(1),不能在同一进程内验证。

外 函 xt_get_args(): 数组
外 函 xt_self_path(): 字

示("--- 127_方法误用明确报错 开始 ---")

设 _参 = xt_get_args()
设 _场景 = ""
遍历 _a 于 _参 {
    若 字(_a) == "--case1" { _场景 = "1" }
    若 字(_a) == "--case2" { _场景 = "2" }
    若 字(_a) == "--case3" { _场景 = "3" }
}

若 _场景 != "" {
    // ---- 子进程:执行会触发误用的语句(预期在运行时明确报错并退出) ----
    若 _场景 == "1" {
        设 s = "玄铁XuanTie"
        示(字(s.找("Xuan")))
    } 抑 _场景 == "2" {
        设 d = {"甲": 1}
        示(化(d.追加(1)))
    } 否 {
        设 a = [1, 2, 3]
        示(化(a.截取(0, 2)))     // 截取 由编译器按字符串方法分派 → 非字符串应报错
    }
    示("[子] FAIL: 未报错就继续执行了")
    终 0
}

函 跑场景(名, 标志, 期望类型词) {
    设 e = 执("\"" & xt_self_path() & "\" " & 标志)
    若 e.成功 {
        示("FAIL: " & 名 & " 子进程退出码 0(应非零)")
        返 空
    }
    若 e.错误.包含?(期望类型词) 且 e.错误.包含?("运行时错误") {
        示("PASS: " & 名 & " — " & e.错误.截取(0, 42))
    } 否 {
        示("FAIL: " & 名 & " 错误文本不含预期: " & e.错误.截取(0, 80))
    }
}

跑场景("字符串误用数组方法(找)", "--case1", "不是数组")
跑场景("字典误用追加", "--case2", "不是字节")
跑场景("数组误用字符串方法(截取)", "--case3", "字符串方法")

// 正路径:真数组的方法不受影响
设 a = [10, 20, 30]
若 字(a.找(20)) == "1" 且 字(a.含?(10)) == "真" { 示("PASS: 数组方法正常(找/含?)") } 否 { 示("FAIL: 数组方法异常") }

示("--- 127_方法误用明确报错 结束 ---")
