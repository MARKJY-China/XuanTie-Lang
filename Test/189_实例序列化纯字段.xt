// Test/189_实例序列化纯字段.xt
// issue #148:实例序列化为纯字段快照,方法/构造器不入 JSON;反序列化得到字段字典。
型 坐标点 {
    设 x = 0
    设 y = 0
    函 造(甲, 乙) { 此.x = 甲  此.y = 乙 }
    函 距原点() { 返 此.x * 此.x + 此.y * 此.y }
}
设 点 = 造 坐标点(1, 2)
设 j = 化(点)
示("有类型=" & 字(j.包含?("__类型__")))
示("无造=" & 字(非 j.包含?("造")))
示("无方法=" & 字(非 j.包含?("距原点")))
示("字段x=" & 字(解(j)["x"]))
示("方法=" & 字(点.距原点()))
