// Test/105_尝试捕捉.xt
// 尝试/捕捉在 XTC 原生编译下的真实捕获能力回归。
// 背景:旧实现 编译尝试捕捉 生成的 IR 尝试块末尾无条件跳过捕捉块(catch 标签全函数无引用),
// 捕捉是死代码,错误字典还是硬编码占位。修复:运行时 setjmp 处理器栈(xt_exc_begin/end/raise),
// 除零/参数类型错误在有活动尝试块时转为可捕捉异常(无尝试块保持旧行为:返0/报错退出)。
设 失败 = 0

// A. 整数除零被捕获,消息正确
设 抓住A = 假
尝试 {
    设 _x = 1 / 0
    示("FAIL A1: 除零后继续执行")
    失败 = 1
} 捕捉 (错误) {
    抓住A = 真
    若 错误["消息"] != "除数不能为零" { 示("FAIL A2 消息=" & 错误["消息"]) ; 失败 = 1 }
}
若 非 抓住A { 示("FAIL A3 除零未被捕获") ; 失败 = 1 }

// B. 无异常时捕捉块不执行,尝试块完整执行
设 触发B = 假
设 走完B = 假
尝试 {
    设 _y = 4 / 2
    走完B = 真
} 捕捉 {
    触发B = 真
}
若 触发B { 示("FAIL B1 无异常却捕捉") ; 失败 = 1 }
若 非 走完B { 示("FAIL B2 尝试块未走完") ; 失败 = 1 }

// C. 浮点除零同样可捕
设 抓住C = 假
尝试 {
    设 _f = 1.0 / 0.0
    失败 = 1
} 捕捉 {
    抓住C = 真
}
若 非 抓住C { 示("FAIL C1 浮点除零未捕获") ; 失败 = 1 }

// D. 嵌套:内层捕获,外层不兜
设 外层D = 假
设 内层D = 假
尝试 {
    尝试 {
        设 _z = 7 % 0
    } 捕捉 (内错) {
        内层D = 真
    }
} 捕捉 {
    外层D = 真
}
若 非 内层D { 示("FAIL D1 内层未捕获") ; 失败 = 1 }
若 外层D { 示("FAIL D2 内层已捕却冒到外层") ; 失败 = 1 }

// E. 内层未捕的故障冒泡到外层(除零发生在内层尝试块之外、外层尝试块之内)
设 外层E = 假
尝试 {
    设 _a = 1
    尝试 { 设 _b = 2 } 捕捉 { }
    设 _c = _a / (_a - 1)
    失败 = 1
} 捕捉 (外错) {
    外层E = 真
}
若 非 外层E { 示("FAIL E1 外层未兜住") ; 失败 = 1 }

// F. 捕捉块带不带错误变量两种形态
设 无参F = 假
尝试 { 设 _q = 9 / 0 } 捕捉 { 无参F = 真 }
若 非 无参F { 示("FAIL F1 无参捕捉") ; 失败 = 1 }

// G. 捕捉后程序状态正常(后续计算不受影响)
设 _g = 0
尝试 { _g = 1 / 0 } 捕捉 { }
若 _g != 0 { 示("FAIL G1 异常后状态污染") ; 失败 = 1 }
设 _h = 6 * 7
若 _h != 42 { 示("FAIL G2 捕捉后算术异常") ; 失败 = 1 }

// H. 注解参数类型错误在尝试块内可捕(无尝试块仍是报错退出,此路径不动)
函 严格(值: 整): 整 { 返 值 * 2 }
设 抓住H = 假
尝试 {
    设 _r = 严格("文本")
    失败 = 1
} 捕捉 {
    抓住H = 真
}
若 非 抓住H { 示("FAIL H1 参数类型错误未捕获") ; 失败 = 1 }

若 失败 == 0 { 示("105 PASS") } 否 { 终 1 }
