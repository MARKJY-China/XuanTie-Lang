// Test/210_异步并行尝试.xt
// issue #113 后续:尝试/捕捉在 异步/并行 块内可用,且异常状态按线程隔离。
// 覆盖:异步任务内 尝试 表达式 + 硬错误捕获;并行两个任务各自捕获,互不串扰。
示("--- 210_异步并行尝试 开始 ---")

// 1. 异步任务内:尝试表达式取值 + 成员硬错误捕获
设 异步任务 = 异步 {
    设 值 = 尝试 {
        设 x = 40
        x + 2
    } 捕捉 (e) {
        0
    }
    示("ASYNC_EXPR=" & 字(值))
    尝试 {
        设 无 = {"x": 1}["不存在"]
        示(无.长度)
    } 捕捉 (e) {
        若 字(e["消息"]).包含?("长度") { 示("PASS 210-1: 异步任务内捕获") } 否 { 示("FAIL 210-1: 消息异常") }
    }
}
等待(异步任务)

// 2. 并行两个任务:各自捕获硬错误,通过通道汇总;异常状态若全局串扰会丢事件
设 结果道 = 道(2)
并行 {
    {
        尝试 {
            设 空甲 = {"x": 1}["不存在"]
            示(空甲.长度)
        } 捕捉 (e) {
            结果道.发("甲")
        }
    }
    {
        尝试 {
            设 空乙 = {"x": 1}["不存在"]
            示(空乙.长度)
        } 捕捉 (e) {
            结果道.发("乙")
        }
    }
}
设 收1 = 结果道.收()
设 收2 = 结果道.收()
设 甲乙齐 = (收1 == "甲" 且 收2 == "乙") 或 (收1 == "乙" 且 收2 == "甲")
若 甲乙齐 { 示("PASS 210-2: 并行捕获互不串扰") } 否 { 示("FAIL 210-2: 收到 " & 字(收1) & "/" & 字(收2)) }

示("--- 210_异步并行尝试 结束 ---")
