// Test/154_系统处理.xt
// 批次四:系统处理(运行/剪辑板/屏幕/鼠标/系统类别/启动时间/INI配置项)。
// 信息框/鸣叫为交互项不进黄金断言(仅编译覆盖见其他用例)。
设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

// ---- 系统信息 ----
断言("操作系统类别", 系统.操作系统类别() == "windows")
断言("屏幕宽度正", 系统.取屏幕宽度() > 0)
断言("屏幕高度正", 系统.取屏幕高度() > 0)
设 _启 = 系统.取启动时间()
断言("启动时间正", _启 > 0)
设 _鼠 = 系统.取鼠标位置()
断言("鼠标位置结构", _鼠.含?("x") 且 _鼠.含?("y"))

// ---- 运行(启动不等待) ----
断言("运行成功", 系统.运行("cmd /c exit 0"))

// ---- 剪辑板(先存原值,测后还原) ----
设 _原板 = 系统.取剪辑板文本()
断言("置剪辑板", 系统.置剪辑板文本("玄铁批次四"))
断言("取剪辑板", 系统.取剪辑板文本() == "玄铁批次四")
断言("置剪辑板中文", 系统.置剪辑板文本("剪辑板中文√"))
断言("取剪辑板中文", 系统.取剪辑板文本() == "剪辑板中文√")
系统.置剪辑板文本(_原板)

// ---- INI 配置项 ----
文件.建目录("Test/binary")
设 _ini = "Test/binary/_b4.ini"
文件.删(_ini)
断言("写配置项新键", 系统.写配置项(_ini, "网络", "主机", "127.0.0.1").成功)
断言("读配置项", 系统.读配置项(_ini, "网络", "主机", "") == "127.0.0.1")
断言("写配置项改键", 系统.写配置项(_ini, "网络", "主机", "192.168.1.1").成功)
断言("读改后", 系统.读配置项(_ini, "网络", "主机", "") == "192.168.1.1")
断言("写配置项同节补键", 系统.写配置项(_ini, "网络", "端口", "8080").成功)
断言("读同节补键", 系统.读配置项(_ini, "网络", "端口", "") == "8080")
断言("原键未被破坏", 系统.读配置项(_ini, "网络", "主机", "") == "192.168.1.1")
断言("写配置项新节", 系统.写配置项(_ini, "界面", "标题", "玄铁").成功)
断言("读新节", 系统.读配置项(_ini, "界面", "标题", "") == "玄铁")
断言("旧节仍在", 系统.读配置项(_ini, "网络", "端口", "") == "8080")
断言("读不存在键返缺省", 系统.读配置项(_ini, "网络", "协议", "TCP") == "TCP")
断言("读不存在文件返缺省", 系统.读配置项("Test/binary/_b4_不存在.ini", "a", "b", "缺省值") == "缺省值")
文件.删(_ini)

若 失败数 == 0 { 示("批次四 全绿") } 否 { 示("批次四 失败数: " & 失败数) }
