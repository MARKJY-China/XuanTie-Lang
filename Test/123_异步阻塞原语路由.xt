// Test/123_异步阻塞原语路由.xt
// 验证: 异步块内含阻塞核心原语(执/求/输)时整块路由线程池。
// 旧行为把这类块编译为 fiber,而阻塞原语(C 侧全程阻塞)会独占调度器线程,
// 同进程其他 fiber/任务全部停摆——实测:两爬虫(求+发)+收集器,5 秒选超时被拉长到约 11 秒,
// 单请求从 400ms 拖到 12s+。本单元用 执(子进程,约 3 秒)×2 并行 + 主线程 选 收集:
//   修复后:两任务各占一个 worker 并行,约 3.2 秒双双到达(阈值 4500ms 内)
//   修复前:两块在调度器线程上串行阻塞,约 6 秒才收齐(超阈值)
// 判定用时间阈值而非仅计数——旧行为的计数最终也会齐,但被拖到串行时长。

示("--- 123_异步阻塞原语路由 开始 ---")

设 结果道 = 道(4)
设 睡命令 = "cmd /c ping -n 4 127.0.0.1 > nul"

设 t1 = 异步 {
    执(睡命令)
    结果道.发("甲")
}
设 t2 = 异步 {
    执(睡命令)
    结果道.发("乙")
}

设 起 = 时.毫秒()
设 收数 = 0
当 收数 < 2 {
    设 idx = 选([结果道], 6000)
    若 idx >= 0 {
        示("收到: " & 结果道.收())
        收数 = 收数 + 1
    } 否 {
        示("选 超时(收数=" & 字(收数) & ")")
        断
    }
}
设 耗 = 时.毫秒() - 起
若 收数 == 2 且 耗 < 4500 {
    示("PASS: 阻塞原语并行完成(耗时 " & 字(耗) & "ms)")
} 否 {
    示("FAIL: 收数=" & 字(收数) & " 耗时=" & 字(耗) & "ms(应 <4500ms:阻塞原语须在 worker 上并行)")
}

等待(t1)
等待(t2)
示("--- 123_异步阻塞原语路由 结束 ---")
