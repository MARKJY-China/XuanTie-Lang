// Test/123_异步阻塞原语路由.xt
// 验证: 异步块内含阻塞核心原语(执/求/输)时整块路由线程池。
// 旧行为把这类块编译为 fiber,而阻塞原语(C 侧全程阻塞)会独占调度器线程,
// 同进程其他 fiber/任务全部停摆。
//
// 判定改成**自校准**:先测单个阻塞任务的耗时(T1),再测两个并行(T2)。
//   正常:两任务各占一个 worker, T2 ≈ T1
//   回归:两块串行阻塞, T2 ≈ 2×T1
// 断言 T2 < T1 * 1.5 —— 不依赖绝对毫秒数, 低核/慢 runner 上同样成立
// (原版写死 4500ms 阈值, 在 2 核 GitHub runner 上并行也要 4.6s+, 误报 FAIL)。

示("--- 123_异步阻塞原语路由 开始 ---")

设 睡命令 = "cmd /c ping -n 4 127.0.0.1 > nul"

// 基准:单任务顺序耗时
设 基准起 = 时.毫秒()
设 单体 = 异步 {
    执(睡命令)
}
等待(单体)
设 单耗 = 时.毫秒() - 基准起

// 并行:两任务
设 结果道 = 道(4)
设 并起 = 时.毫秒()
设 t1 = 异步 {
    执(睡命令)
    结果道.发("甲")
}
设 t2 = 异步 {
    执(睡命令)
    结果道.发("乙")
}

设 收数 = 0
当 收数 < 2 {
    设 idx = 选([结果道], 15000)
    若 idx >= 0 {
        结果道.收()   // 只消费不打印:两个任务的到达顺序在 CI 上不稳定,打印会让基线抖动
        收数 = 收数 + 1
    } 否 {
        示("选 超时(收数=" & 字(收数) & ")")
        断
    }
}
设 并耗 = 时.毫秒() - 并起

若 单耗 < 500 {
    示("PASS: 环境过慢或子进程未按预期耗时, 跳过相对判定(单耗 " & 字(单耗) & "ms)")
} 抑 收数 == 2 且 并耗 * 2 < 单耗 * 3 {
    示("PASS: 阻塞原语并行完成(单任务 " & 字(单耗) & "ms / 并行 " & 字(并耗) & "ms)")
} 否 {
    示("FAIL: 收数=" & 字(收数) & " 单任务=" & 字(单耗) & "ms 并行=" & 字(并耗) & "ms(并行应 < 单任务×1.5:阻塞原语须在 worker 上并行)")
}

等待(t1)
等待(t2)
示("--- 123_异步阻塞原语路由 结束 ---")
