// Test 94 — 内存搅动猎手(S3 专项)
// 目标:在堆损坏检测器(xt_check_obj 全程在线)下用高 churn 形态逼出
// 双重释放/悬垂指针/泄漏失控。判定:全部 PASS 且进程干净退出。

示("=== Test 94: 内存搅动猎手 ===")

// 1. 嵌套结构创建即弃(每轮新建字典+数组,旧的失去引用)
设 i1 = 0
当 i1 < 3000 {
    设 临时 = {"名单": [i1, i1 + 1], "嵌": {"深": "值" & i1}}
    i1 = i1 + 1
}
示("PASS: 嵌套即弃 3000 轮")

// 2. 字符串拼接搅动(长链临时对象)
设 s2 = ""
设 i2 = 0
当 i2 < 800 {
    s2 = s2 & "段" & i2
    i2 = i2 + 1
}
若 s2.包含?("段799") { 示("PASS: 字符串长链搅动") } 否 { 示("FAIL: 字符串长链搅动") }

// 3. 数组反复覆写(旧值释放压力)
设 列3 = []
列3.追加("初始")
设 i3 = 0
当 i3 < 2000 {
    列3[0] = "新" & i3
    i3 = i3 + 1
}
若 列3[0].包含?("1999") { 示("PASS: 数组覆写搅动") } 否 { 示("FAIL: 数组覆写搅动") }

// 4. 字典高频增删
设 典4 = {}
设 i4 = 0
当 i4 < 1000 {
    典4["键" & (i4 % 50)] = i4
    i4 = i4 + 1
}
设 i4b = 0
当 i4b < 50 {
    典4.删("键" & i4b)
    i4b = i4b + 1
}
若 典4.长度 == 0 { 示("PASS: 字典增删清空") } 否 { 示("FAIL: 字典增删清空 剩=" & 典4.长度) }

// 5. 闭包捕获堆对象并密集调用
设 函列 = []
设 i5 = 0
当 i5 < 200 {
    设 载 = {"编号": i5}
    函列.追加(函() { 返 载["编号"] })
    i5 = i5 + 1
}
设 总和5 = 0
遍历 f 于 函列 { 总和5 = 总和5 + f() }
若 总和5 == 19900 { 示("PASS: 闭包捕获堆对象") } 否 { 示("FAIL: 闭包捕获堆对象 和=" & 总和5) }

// 6. 结果容器链式搅动
函 包装6(x) { 若 x >= 0 { 返 成功(x) } 返 失败("负") }
设 计6 = 0
设 i6 = 0
当 i6 < 1500 {
    设 r6 = 包装6(i6)
    若 r6.成功 { 计6 = 计6 + 1 }
    i6 = i6 + 1
}
若 计6 == 1500 { 示("PASS: 结果链搅动") } 否 { 示("FAIL: 结果链搅动") }

示("=== Test 94 完成 ===")
