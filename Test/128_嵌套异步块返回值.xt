// Test/128_嵌套异步块返回值.xt
// 覆盖"异步块内再起异步块"的返回值传递。
// 旧缺陷:内层若是**没有挂起点的纯计算块**(N=0),走线程池路径,而该路径没有清空外层
// fiber 状态机上下文 —— 内层 返 按 fiber 语义生成(xt_fiber_set_result + 引用外层状态
// 结构体字段的完成清理),产出 getelementptr 未定长类型的非法 IR,clang 报
// "base element of getelementptr must be sized" 直接失败(类型定义随外层 poll 落盘,
// 排在内层函数之后)。修复:线程池路径入体前清空 fiber 上下文,出体后恢复。
// 判定:四种嵌套形态都能编译并取回正确返回值(含字符串结果的属主/释放路径)。

示("--- 128_嵌套异步块返回值 开始 ---")

// 形态一:顶层嵌套,内层纯计算块
设 甲外层 = 异步 {
    设 甲内层 = 异步 { 返 5 }
    设 甲值 = 等待(甲内层)
    返 甲值 + 1
}
设 甲结果 = 等待(甲外层)
若 甲结果 == 6 { 示("PASS: 顶层嵌套纯块 = " & 字(甲结果)) } 否 { 示("FAIL: 顶层嵌套 = " & 字(甲结果)) }

// 形态二:函数内嵌套(外层块捕获函数局部)
函 函数内嵌套() {
    设 乙外层 = 异步 {
        设 乙内层 = 异步 { 返 41 }
        设 乙值 = 等待(乙内层)
        返 乙值 + 1
    }
    返 等待(乙外层)
}
设 乙结果 = 函数内嵌套()
若 乙结果 == 42 { 示("PASS: 函数内嵌套纯块 = " & 字(乙结果)) } 否 { 示("FAIL: 函数内嵌套 = " & 字(乙结果)) }

// 形态三:内层带挂起点(时.睡)→ 内层自身走 fiber 路径,须与形态一二同解
函 睡眠嵌套() {
    设 丙外层 = 异步 {
        设 丙内层 = 异步 { 时.睡(5) ; 返 "丙" }
        设 丙值 = 等待(丙内层)
        返 "甲" & 丙值
    }
    返 等待(丙外层)
}
设 丙结果 = 睡眠嵌套()
若 丙结果 == "甲丙" { 示("PASS: 睡眠内层嵌套 = " & 丙结果) } 否 { 示("FAIL: 睡眠内层嵌套 = " & 字(丙结果)) }

// 形态四:内层返回堆对象(字符串),跨任务边界传值 + 拼接
函 字串嵌套() {
    设 丁外层 = 异步 {
        设 丁内层 = 异步 { 返 "KEEPME_0123456789" }
        设 丁值 = 等待(丁内层)
        返 "[" & 丁值 & "]"
    }
    返 等待(丁外层)
}
设 丁结果 = 字串嵌套()
若 丁结果 == "[KEEPME_0123456789]" { 示("PASS: 字符串结果嵌套 = " & 丁结果) } 否 { 示("FAIL: 字符串结果嵌套 = " & 字(丁结果)) }

// 形态五:嵌套层内再嵌套一层(三层),纯块在内
函 三层嵌套() {
    设 戊外层 = 异步 {
        设 戊中层 = 异步 {
            设 戊内层 = 异步 { 返 7 }
            设 戊值 = 等待(戊内层)
            返 戊值 * 2
        }
        返 等待(戊中层) + 1
    }
    返 等待(戊外层)
}
设 戊结果 = 三层嵌套()
若 戊结果 == 15 { 示("PASS: 三层嵌套 = " & 字(戊结果)) } 否 { 示("FAIL: 三层嵌套 = " & 字(戊结果)) }

示("--- 128_嵌套异步块返回值 结束 ---")
