// Test 77 — 并发对抗性压力(调度器/通道/状态机的恶意形态)
// 目标:重复、交错、边界容量、快速创建销毁下的正确性

示("=== Test 77: 并发对抗性压力 ===")

// 1. 容量1通道的高频乒乓(满/空快速交替)
设 _乒道 = 道(1)
设 _乒回合 = 200
设 _乒生产者 = 异步 {
    设 i = 0
    当 i < _乒回合 { _乒道.发(i); i = i + 1 }
}
设 _乒消费者 = 异步 {
    设 got = 0
    设 s = 0
    当 got < _乒回合 {
        设 v = _乒道.收()
        s = s + v
        got = got + 1
    }
    若 s == 19900 { 示("PASS: 容量1乒乓") } 否 { 示("FAIL: 容量1乒乓 s=" & s) }
}
等待(_乒生产者)
等待(_乒消费者)

// 2. 快速创建销毁 fiber(每fiber仅一次睡眠即结束,考验槽位回收)
设 _ch总 = 0
设 k = 0
当 k < 500 {
    设 _短命 = 异步 { 时.睡(1); 返 1 }
    _ch总 = _ch总 + 等待(_短命)
    k = k + 1
}
若 _ch总 == 500 { 示("PASS: 500短命fiber") } 否 { 示("FAIL: 短命fiber " & _ch总) }

// 3. 多生产者单消费者乱序汇总
设 _汇道 = 道(64)
设 _生产者数 = 8
设 _每产 = 50
设 _任务们 = []
设 p = 0
当 p < _生产者数 {
    _任务们.追加(异步 {
        设 j = 0
        当 j < _每产 { _汇道.发(1); j = j + 1 }
    })
    p = p + 1
}
设 _收齐 = 异步 {
    设 c = 0
    设 总 = 0
    当 c < _生产者数 * _每产 {
        总 = 总 + _汇道.收()
        c = c + 1
    }
    若 总 == 400 { 示("PASS: 多生产者汇总") } 否 { 示("FAIL: 多生产者汇总 " & 总) }
}
遍历 t 于 _任务们 { 等待(t) }
等待(_收齐)

// 4. 选 超时与就绪交替
设 _选道 = 道(1)
设 _命中数 = 0
设 m = 0
当 m < 10 {
    若 m % 2 == 0 { _选道.发(m) }
    设 idx = 选([_选道], 100)
    若 idx == 0 {
        设 _ = _选道.收()
        _命中数 = _命中数 + 1
    }
    m = m + 1
}
若 _命中数 == 5 { 示("PASS: 选超时交替") } 否 { 示("FAIL: 选超时交替 " & _命中数) }

示("=== Test 77 完成 ===")
