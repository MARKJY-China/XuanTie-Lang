// Test/124_关键字名变量读取.xt
// 关键字名变量(变量名恰为类型关键字 整/字/道/字节/任务,遮蔽该关键字)的读取 ARC 纪律。
// 旧缺陷: 这五个关键字名读取分支裸 load 不 retain,与成员调用路径的前序释放相抵即引用计数下溢
//         → 对象被提前释放 → 悬垂读:实测 `设 道 = 道(4)` 后 `道.发(...)` 主线程段错误。
// 判定: 各用例输出正确且进程干净退出(段错误会以非零退出码被回归拦下)。

示("--- 124_关键字名变量读取 开始 ---")

// 1. 通道名 = 道(原崩溃用例)
设 道 = 道(4)
道.发("甲")
若 道.收() == "甲" { 示("PASS: 关键字名通道收发") } 否 { 示("FAIL: 关键字名通道收发") }

// 2. 字符串名 = 字
设 字 = "关键字名"
若 字 & "|尾" == "关键字名|尾" { 示("PASS: 关键字名字符串拼接") } 否 { 示("FAIL: 关键字名字符串拼接") }
设 _字长 = 字.长度
若 _字长 == 12 { 示("PASS: 关键字名字符串成员访问") } 否 { 示("FAIL: 字符串成员访问 长度=" & 字(_字长)) }

// 3. 整数名 = 整
设 整 = 42
若 整 + 1 == 43 { 示("PASS: 关键字名整数算术") } 否 { 示("FAIL: 关键字名整数算术") }

// 4. 字节名 = 字节
设 字节 = "abc"
若 字节.字节数 == 3 { 示("PASS: 关键字名字节成员访问") } 否 { 示("FAIL: 关键字名字节成员访问") }

// 5. 任务名 = 任务(异步句柄 + 等待;该路径含槽位清零,须无多持/双重释放)
设 任务 = 异步 { 返 "任务值" }
若 等待(任务) == "任务值" { 示("PASS: 关键字名任务等待") } 否 { 示("FAIL: 关键字名任务等待") }

// 6. 循环多轮读写(累计值确定性,暴露计数漂移)
设 计 = 0
设 轮 = 0
当 轮 < 200 {
    设 局部字 = "轮" & 字(轮)
    计 = 计 + 局部字.字节数
    轮 = 轮 + 1
}
若 计 == 1090 { 示("PASS: 循环多轮读写累计 1090") } 否 { 示("FAIL: 累计值 " & 字(计)) }

示("--- 124_关键字名变量读取 结束 ---")
