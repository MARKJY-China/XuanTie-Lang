// Test 92 — 控制流组合(断续嵌套,全断言)
示("=== Test 92: 控制流组合 ===")
设 命中 = []
设 i = 0
当 i < 10 {
    若 i % 2 == 0 { i = i + 1; 续 }
    若 i > 7 { 断 }
    命中.追加(i)
    i = i + 1
}
若 命中.长度 == 4 且 命中[0] == 1 且 命中[3] == 7 { 示("PASS: 断续组合") } 否 { 示("FAIL: 断续组合") }
设 外计 = 0
设 内计 = 0
设 a = 0
当 a < 3 {
    设 b = 0
    当 b < 3 {
        若 b == 1 { b = b + 1; 续 }
        内计 = 内计 + 1
        b = b + 1
    }
    外计 = 外计 + 1
    a = a + 1
}
若 外计 == 3 且 内计 == 6 { 示("PASS: 嵌套续") } 否 { 示("FAIL: 嵌套续 外=" & 外计 & " 内=" & 内计) }
设 总 = 0
遍历 x 于 [1, 2, 3] {
    遍历 y 于 [10, 20] {
        总 = 总 + x * y
    }
}
若 总 == 180 { 示("PASS: 嵌套遍历") } 否 { 示("FAIL: 嵌套遍历 " & 总) }
示("=== Test 92 完成 ===")
