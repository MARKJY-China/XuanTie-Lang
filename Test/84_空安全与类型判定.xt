// Test 84 — 空安全与类型判定(全断言)
示("=== Test 84: 空安全与类型判定 ===")
设 x = 空
若 x == 空 { 示("PASS: 空值判定") } 否 { 示("FAIL: 空值判定") }
设 y = 0
若 y != 空 { 示("PASS: 零非空") } 否 { 示("FAIL: 零被误判为空") }
设 z = 假
若 z != 空 { 示("PASS: 假非空") } 否 { 示("FAIL: 假被误判为空") }
设 _数检 = 5
匹配 _数检 {
    是 整 -> { 示("PASS: 匹配类型判定-整") }
    _ -> { 示("FAIL: 匹配类型判定-整") }
}
设 _文检 = "字"
匹配 _文检 {
    是 字 -> { 示("PASS: 匹配类型判定-字") }
    _ -> { 示("FAIL: 匹配类型判定-字") }
}
示("=== Test 84 完成 ===")
