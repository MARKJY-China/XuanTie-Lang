// Test/157_外函原生小数.xt
// issue #77 方案C:外 函 原生小数 = 原生 double ABI(libm/标准C库直通);
// 小数 = 装箱约定(xt_* 桥函数,经内建映射调用,行为不变)。
外 函 sin(x: 原生小数): 原生小数
外 函 cos(x: 原生小数): 原生小数
外 函 floor(x: 原生小数): 原生小数
外 函 pow(x: 原生小数, y: 原生小数): 原生小数
外 函 sqrt(x: 原生小数): 原生小数

设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}
函 近( a, b ) {
    若 a > b { 返 a - b < 0.0001 }
    返 b - a < 0.0001
}

// ---- 原生小数:libm 直通(issue #77 修复点,原运行即堆损坏) ----
断言("sin", 近(sin(1.0), 0.8415))
断言("cos", 近(cos(1.0), 0.5403))
断言("floor", floor(3.7) == 3.0)
断言("pow", 近(pow(2.0, 10.0), 1024.0))
断言("sqrt", 近(sqrt(16.0), 4.0))

// ---- 装箱约定不受影响:内建映射的数学命名空间照常 ----
断言("内建平方根", 近(数学.平方根(16.0), 4.0))
断言("内建正弦", 近(数学.正弦(1.0), 0.8415))
断言("内建取整", 数学.取整(3.7) == 3)

// ---- 原生小数参与玄铁表达式(装箱后可算术/比较/示) ----
设 和 = sin(0.0) + cos(0.0)
断言("原生结果可算术", 近(和, 1.0))
设 文本 = "sin(1)=" & sin(1.0)
断言("原生结果可拼接", 文本.长度 > 6)
断言("原生结果可比较", sin(0.5) > 0.4 且 sin(0.5) < 0.5)

若 失败数 == 0 { 示("157 全绿") } 否 { 示("157 失败数: " & 失败数) }
