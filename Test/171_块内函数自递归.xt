// Test/171_块内函数自递归.xt
// 现象:把函数定义在 循/若/块 内时，函数体内调用自己报「未知标识符 '斐'」——
// 顶层函数靠预扫描先注册符号，块内函数走不到预扫描，编译函数体时符号表里还没有自己。
// 修法:编译函数定义时先把自身登记进符号表/函数表再编译函数体。

示("--- 171 块内函数自递归 开始 ---")

// 1. 循环体内定义 + 自递归
循 {
    函 斐(n) {
        若 n < 2 { 返 n }
        返 斐(n - 1) + 斐(n - 2)
    }
    示("循环内 斐(10)=" & 字(斐(10)))
    断
}

// 2. 若块内定义 + 自递归
若 真 {
    函 阶(n) {
        若 n <= 1 { 返 1 }
        返 n * 阶(n - 1)
    }
    示("若块内 阶(5)=" & 字(阶(5)))
}

// 3. 嵌套两层块 + 互不干扰的重名函数
若 真 {
    若 真 {
        函 平方(n) { 返 n * n }
        函 四乘方(n) { 返 平方(平方(n)) }
        示("嵌套块 四乘方(3)=" & 字(四乘方(3)))
    }
}

示("--- 171 块内函数自递归 结束 ---")
