// Test/102_字符串取字节大索引.xt
// 字节(i)/字符(i) 回归:曾误对裸整数索引发 xt_release,索引值越过 4096(偶)即被当野指针解引用段错误。
// 触发门槛高(索引须>4096),常规测试打不到——自举攻坚 gdb 定位(runtime xt_check_obj)。
设 失败 = 0

设 s = ""
设 i = 0
当 i < 5000 { s = s & "ab" ; i = i + 1 }

设 总 = 0
设 j = 0
当 j < s.字节数 {
    总 = 总 + s.字节(j)
    j = j + 1
}
若 总 != 975000 { 示("FAIL: 字节求和应为975000, 实际 " & 总) ; 失败 = 1 }

若 s.字符(0) != "a" { 示("FAIL: 字符(0)应为a") ; 失败 = 1 }
若 s.字符(9999) != "b" { 示("FAIL: 字符(9999)应为b") ; 失败 = 1 }
若 s.字符数 != 10000 { 示("FAIL: 字符数应为10000") ; 失败 = 1 }

若 失败 == 0 { 示("102 PASS") } 否 { 终 1 }
