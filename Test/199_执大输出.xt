// Test/199_执大输出.xt
// issue #162:执() 输出必须线性累积(1MB 不应卡顿/爆内存)。
设 命令 = "yes x | head -c 1000000"
若 系统.操作系统类别() == "windows" {
    命令 = "powershell -NoProfile -Command \"[Console]::Write(('x' * 1000000))\""
}
设 起 = 时.毫秒()
设 果 = 执(命令)
示("成功=" & 字(果.成功))
示("长度=" & 字(果.值.字节数))
示("快速=" & 字(时.毫秒() - 起 < 15000))
