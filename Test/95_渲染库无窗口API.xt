// Test/95_渲染库无窗口API.xt
// 渲染库编译链路+无窗口运行时测试:引渲染→编译链接→调用不依赖窗口句柄的API
// 覆盖:铁铺包引用、渲染桥+libraylib.a 链接、随机数API正确性
引 "渲染" 予 R

设 全过 = 真
设 i = 0
当 i < 500 {
    设 v = R.随机(5, 9)
    若 v < 5 或 v > 9 { 全过 = 假 }
    i = i + 1
}
若 非 全过 {
    示("FAIL: 随机数越界")
    终 1
}
示("PASS: 无窗口随机API(500次范围断言)")

// 屏宽/屏高:无窗口时 raylib 返回 0——只断言调用不崩,不断言值
R.屏宽()
R.屏高()
示("PASS: 无窗口屏参调用不崩")
示("95 PASS")
