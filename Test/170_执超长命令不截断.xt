// Test/170_执超长命令不截断.xt
// issue #125:POSIX 分支曾用 char[2048] + snprintf 拼 "命令 2>&1"，超长命令被静默截断，
// 残废命令的执行结果不可预期。现改为按实际长度分配。
// 判据:把 2500 个填充字符放在命令中段，"170PASS" 放在末尾——若仍截断到 2048，末尾标记必丢。
示("--- 170 执超长命令不截断 开始 ---")

设 填充 = ""
设 i = 0
当 i < 2500 {
    填充 = 填充 & "a"
    i = i + 1
}

设 长命令 = "echo " & 填充 & " 170PASS"
设 执行结果 = 执(长命令)
若 执行结果.成功 且 执行结果.值.包含?("170PASS") {
    示("PASS 超长命令完整执行(长度 " & 字(长命令.长度) & " 字节)")
} 否 {
    示("FAIL 超长命令被截断或失败: " & 执行结果.值)
}

示("--- 170 执超长命令不截断 结束 ---")
