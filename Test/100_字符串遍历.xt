// Test/100_字符串遍历.xt
// 字符串遍历回归:遍历 c 于 字符串 = 按逻辑字符迭代(配合 xt_string_get_char 逻辑索引)。
// 曾是回归空洞:无单元覆盖字符串遍历;自举实测上界误用带标记字节数(2n+1),8 字节串迭代 17 次。
设 失败 = 0

设 s1 = "ab你好"
设 n = 0
遍历 c 于 s1 { n = n + 1 }
若 n != 4 { 示("FAIL: ab你好 应迭代4次(逻辑字符), 实际 " & n) ; 失败 = 1 }

设 s2 = "abc"
设 拼 = ""
遍历 c 于 s2 { 拼 = 拼 & c }
若 拼 != "abc" { 示("FAIL: 逐位拼接应为 abc, 实际 [" & 拼 & "]") ; 失败 = 1 }

设 s3 = ""
设 n3 = 0
遍历 c 于 s3 { n3 = n3 + 1 }
若 n3 != 0 { 示("FAIL: 空串应迭代0次, 实际 " & n3) ; 失败 = 1 }

设 s4 = "你"
设 m = 0
设 末次 = ""
遍历 c 于 s4 { m = m + 1 ; 末次 = c }
若 m != 1 { 示("FAIL: 单汉字应迭代1次, 实际 " & m) ; 失败 = 1 }
若 末次 != "你" { 示("FAIL: 迭代元素应为 你, 实际 [" & 末次 & "]") ; 失败 = 1 }

设 s5 = "a你b"
设 序 = ""
遍历 c 于 s5 { 序 = 序 & c & "|" }
若 序 != "a|你|b|" { 示("FAIL: 混合迭代序列应为 a|你|b|, 实际 [" & 序 & "]") ; 失败 = 1 }

若 失败 == 0 { 示("100 PASS") } 否 { 终 1 }
