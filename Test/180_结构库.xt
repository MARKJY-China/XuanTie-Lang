// Test/180_结构库.xt
// 数据结构库（lib/结构/结构.xt）：栈/队列/双端队列/链表/二叉堆/二叉搜索树/集合/LRU 缓存
引 "../lib/结构/结构.xt" 予 S

设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

// 栈
设 栈对象 = 造 S.栈()
断言("栈初始为空", 栈对象.空?())
断言("栈初始大小", 栈对象.大小() == 0)
断言("空栈取出失败", 非 栈对象.取出().成功)
断言("空栈查看失败", 非 栈对象.查看().成功)
断言("空栈取出原因", 栈对象.取出().错误 == "栈为空: 取出")
栈对象.压入(1)
栈对象.压入(2)
断言("栈大小", 栈对象.大小() == 2)
断言("栈查看不弹", 栈对象.查看().值 == 2)
断言("栈取出", 栈对象.取出().值 == 2)
断言("栈取出后大小", 栈对象.大小() == 1)
断言("栈到数组", 化(栈对象.到数组()) == "[1]")
栈对象.清空()
断言("栈清空", 栈对象.空?())

// 队列
设 队列对象 = 造 S.队列()
断言("队列初始为空", 队列对象.空?())
断言("空队出队失败", 非 队列对象.出队().成功)
断言("空队查看失败", 非 队列对象.查看头().成功)
队列对象.入队("a")
队列对象.入队("b")
断言("队列大小", 队列对象.大小() == 2)
断言("队查看头", 队列对象.查看头().值 == "a")
断言("出队1", 队列对象.出队().值 == "a")
断言("出队2", 队列对象.出队().值 == "b")
断言("出队后空", 队列对象.空?())
设 i = 0
当 i < 200 {
    队列对象.入队(i)
    i = i + 1
}
i = 0
当 i < 200 {
    队列对象.出队()
    i = i + 1
}
断言("队列大量进出后为空", 队列对象.空?())
队列对象.入队(9)
断言("队列压缩后到数组", 化(队列对象.到数组()) == "[9]")

// 双端队列
设 双端对象 = 造 S.双端队列()
断言("双端初始为空", 双端对象.空?())
断言("空双端头出失败", 非 双端对象.头出().成功)
断言("空双端尾出失败", 非 双端对象.尾出().成功)
双端对象.尾入(1)
双端对象.头入(0)
双端对象.尾入(2)
断言("双端到数组", 化(双端对象.到数组()) == "[0, 1, 2]")
断言("双端大小", 双端对象.大小() == 3)
断言("双端查看头", 双端对象.查看头().值 == 0)
断言("双端查看尾", 双端对象.查看尾().值 == 2)
断言("双端头出", 双端对象.头出().值 == 0)
断言("双端尾出", 双端对象.尾出().值 == 2)
断言("双端剩一个", 化(双端对象.到数组()) == "[1]")

// 链表
设 链表对象 = 造 S.链表()
断言("链表初始为空", 链表对象.空?())
断言("空链表查找失败", 非 链表对象.查找("x").成功)
链表对象.尾插("x")
链表对象.头插("y")
链表对象.尾插("z")
断言("链表到数组", 化(链表对象.到数组()) == "[\"y\", \"x\", \"z\"]")
断言("链表大小", 链表对象.大小() == 3)
断言("链表查找命中", 链表对象.查找("x").值 == "x")
断言("链表移出命中", 链表对象.移出("x"))
断言("链表移出不命中", 非 链表对象.移出("无"))
断言("链表移出后", 化(链表对象.到数组()) == "[\"y\", \"z\"]")
断言("链表移出后大小", 链表对象.大小() == 2)
链表对象.反转()
断言("链表反转", 化(链表对象.到数组()) == "[\"z\", \"y\"]")
链表对象.清空()
断言("链表清空", 链表对象.空?())

// 二叉堆：最小堆
设 堆对象 = 造 S.二叉堆(函(a, b) { 返 a - b })
断言("堆初始为空", 堆对象.空?())
断言("空堆取出失败", 非 堆对象.取出().成功)
断言("空堆查看失败", 非 堆对象.查看顶().成功)
堆对象.压入(5)
堆对象.压入(1)
堆对象.压入(3)
断言("堆查看顶", 堆对象.查看顶().值 == 1)
断言("堆大小", 堆对象.大小() == 3)
断言("最小堆序1", 堆对象.取出().值 == 1)
断言("最小堆序2", 堆对象.取出().值 == 3)
断言("最小堆序3", 堆对象.取出().值 == 5)
// 最大堆：比较函取反
设 大堆对象 = 造 S.二叉堆(函(a, b) { 返 b - a })
大堆对象.压入(5)
大堆对象.压入(1)
大堆对象.压入(9)
断言("最大堆取1", 大堆对象.取出().值 == 9)
断言("最大堆取2", 大堆对象.取出().值 == 5)
断言("最大堆取3", 大堆对象.取出().值 == 1)

// 二叉搜索树
设 树对象 = 造 S.二叉搜索树(函(a, b) { 返 a - b })
断言("树初始为空", 树对象.空?())
断言("空树查找失败", 非 树对象.查找(1).成功)
断言("空树最小失败", 非 树对象.最小().成功)
树对象.加入(5)
树对象.加入(3)
树对象.加入(8)
树对象.加入(3)
断言("树中序", 化(树对象.中序()) == "[3, 5, 8]")
断言("树大小去重", 树对象.大小() == 3)
断言("树高度", 树对象.高度() == 2)
断言("树查找命中", 树对象.查找(3).值 == 3)
断言("树查找未中", 非 树对象.查找(9).成功)
断言("树有?命中", 树对象.有?(8))
断言("树有?未中", 非 树对象.有?(9))
断言("树最小", 树对象.最小().值 == 3)
断言("树最大", 树对象.最大().值 == 8)
树对象.清空()
断言("树清空", 树对象.空?())

// 集合
设 集甲 = 造 S.集合()
设 集乙 = 造 S.集合()
断言("集合初始为空", 集甲.空?())
断言("集合移出不命中", 非 集甲.移出(1))
集甲.加入(1)
集甲.加入(2)
集甲.加入(2)
集乙.加入(2)
集乙.加入(3)
断言("集合大小去重", 集甲.大小() == 2)
断言("集合有?", 集甲.有?(2))
断言("集合无", 非 集甲.有?(9))
断言("集合移出命中", 集甲.移出(1))
断言("集合移出后大小", 集甲.大小() == 1)
设 并集 = 集甲.并(集乙)
设 交集 = 集甲.交(集乙)
设 差集 = 集甲.差(集乙)
断言("集合并长度", 并集.长度 == 2)
断言("集合交长度", 交集.长度 == 1)
断言("集合交内容", 交集[0] == 2)
断言("集合差内容", 差集.长度 == 0)
断言("集合子集", 集甲.子集?(集乙))
设 空集 = 造 S.集合()
断言("空集是子集", 空集.子集?(集乙))

// LRU 缓存
设 缓存对象 = 造 S.LRU缓存(2)
断言("缓存初始大小", 缓存对象.大小() == 0)
断言("缓存未命中", 非 缓存对象.取("a").成功)
缓存对象.放("a", 1)
缓存对象.放("b", 2)
断言("缓存键列表", 化(缓存对象.键列表()) == "[\"a\", \"b\"]")
断言("缓存命中", 缓存对象.取("a").值 == 1)
断言("缓存命中后顺序", 化(缓存对象.键列表()) == "[\"b\", \"a\"]")
缓存对象.放("c", 3)
断言("缓存淘汰", 非 缓存对象.有?("b"))
断言("缓存淘汰后大小", 缓存对象.大小() == 2)
断言("缓存淘汰后键", 化(缓存对象.键列表()) == "[\"a\", \"c\"]")
断言("缓存移出命中", 缓存对象.移出("a"))
断言("缓存移出后大小", 缓存对象.大小() == 1)
断言("缓存容量", 缓存对象.取容量() == 2)
缓存对象.清空()
断言("缓存清空", 缓存对象.大小() == 0)
设 小缓存 = 造 S.LRU缓存(0)
断言("容量零按一", 小缓存.取容量() == 1)

若 失败数 == 0 { 示("结构库 全绿") } 否 { 示("结构库 失败数: " & 字(失败数)) }

