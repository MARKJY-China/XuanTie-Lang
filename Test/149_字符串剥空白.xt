// Test/149_字符串剥空白.xt
// 覆盖字符串三件套 去首尾空格() / 去首空格() / 去尾空格() 的语义:
// - 只剥 ASCII 空白(空格 \t \n \r;runtime 判定集另含 \v \f,但本语言字面量写不出这两个转义)
// - 空串 / 纯空白 / 无可剥 三种边界:结果正确且不崩
// - 多字节安全:中文、emoji 与空白混排时按字节扫描不切坏 UTF-8(E7 8E 84 等全 ≥0x80)
// - 全角空格 U+3000 不在其列(明确边界,防"以为会剥全角"的误用)
// - 返回新串、原值不变(字符串不可变)

示("--- 149_字符串剥空白 开始 ---")

// ① 基本形态
示("首尾: [" & "  hi  ".去首尾空格() & "]")
示("仅首: [" & "  hi  ".去首空格() & "]")
示("仅尾: [" & "  hi  ".去尾空格() & "]")

// ② 混合 ASCII 空白(空格 \t \n \r —— 玄铁字符串字面量里确实可写的三种转义)
//    注:\v/\f/\0 **不是**本语言的转义(实测原样保留),故不进用例;runtime 的判定集
//    含 \v/\f,但语言层写不出来,这里只测可写的形态。
设 混 = "\t\r\n 玄铁 "
示("混合首尾: [" & 混.去首尾空格() & "]")
示("混合仅首: [" & 混.去首空格() & "]")
示("混合仅尾: [" & 混.去尾空格() & "] 长=" & 字(混.去尾空格().字符数))
示("纯制表换行: [" & "\t\n".去首尾空格() & "] 长=" & 字("\t\n".去首尾空格().字符数))
示("\\v 在字面量里不是控制字符: [" & "\v" & "] 长=" & 字("\v".字符数))

// ③ 中间空白必须保留
示("中间保留: [" & "  a b  c  ".去首尾空格() & "]")
示("中间保留仅首: [" & " a b ".去首空格() & "]")
示("中间保留仅尾: [" & " a b ".去尾空格() & "]")

// ④ 边界:空串 / 纯空白 / 无可剥
示("空串: [" & "".去首尾空格() & "] 长=" & 字("".去首尾空格().字符数))
示("纯空白: [" & "   ".去首尾空格() & "] 长=" & 字("   ".去首尾空格().字符数))
示("纯制表: [" & "\t\t".去首尾空格() & "] 长=" & 字("\t\t".去首尾空格().字符数))
示("无可剥: [" & "abc".去首尾空格() & "]")
示("仅左侧: [" & "  abc".去尾空格() & "]")
示("仅右侧: [" & "abc  ".去首空格() & "]")

// ⑤ 多字节安全:中文/emoji 与空白混排
示("中文: [" & "  玄铁  ".去首尾空格() & "] 长=" & 字("  玄铁  ".去首尾空格().字符数))
示("中文无空格: [" & "玄铁".去首尾空格() & "]")
示("emoji: [" & " 🚀 玄铁 🚀 ".去首尾空格() & "]")
示("emoji 仅尾: [" & "🚀 x".去尾空格() & "]")
示("emoji 仅首: [" & " x 🚀".去首空格() & "]")

// ⑥ 全角空格(U+3000)不在 ASCII 空白之列:明确不剥
示("全角不剥: [" & "　玄铁　".去首尾空格() & "] 长=" & 字("　玄铁　".去首尾空格().字符数))
示("全角先替换再剥: [" & "　玄铁　".替换("　", " ").去首尾空格() & "]")

// ⑦ 字符串不可变:原值不受影响
设 原 = "  keep  "
设 剥后 = 原.去首尾空格()
示("原值未变: [" & 原 & "] 剥后: [" & 剥后 & "]")

// ⑧ 链式与拼接
示("链式: [" & "  x  ".去首空格().去尾空格() & "]")
示("拼接: " & " a ".去首尾空格() & "-" & "  b  ".去首尾空格())
示("重复剥幂等: " & 字("  y  ".去首尾空格().去首尾空格() == "y"))

// ⑨ 与其他字符串方法协同
示("分割后逐段剥: " & "a,  b ,c".分割(",")[1].去首尾空格())
示("替换后剥: [" & "  a  ".替换("a", " b ").去首尾空格() & "]")

示("--- 149_字符串剥空白 结束 ---")
