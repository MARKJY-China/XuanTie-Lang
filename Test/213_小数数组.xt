// Test/213_小数数组.xt
// 小数数组:连续 double 缓冲的最小切片(声明/追加/下标读写/长度/函数参数与返回)。
示("--- 213_小数数组 开始 ---")

设 甲: 小数数组 = []
示("空长度: #{甲.长度}")

甲.追加(1.5)
甲.追加(2.5)
甲.追加(3.5)
示("追加后长度: #{甲.长度}")
示("甲[0]: #{甲[0]}")
示("甲[2]: #{甲[2]}")

甲[1] = 9.25
示("写入后甲[1]: #{甲[1]}")

设 总: 小数 = 0.0
设 i = 0
当 i < 甲.长度 {
    总 = 总 + 甲[i] * 2.0
    i = i + 1
}
示("循环求和: #{总}")

// 越界正向索引沿用数组约定:返回 空(数值语境为 0.0),不崩溃
示("越界读: #{甲[99]}")

// 整/布尔元素按数值转换
设 混合: 小数数组 = [1, 2.5, 真]
示("混合长度: #{混合.长度}")
示("混合[0]: #{混合[0]}")
示("混合[2]: #{混合[2]}")

// 重新赋值成新的小数数组字面量
甲 = [4.0, 5.0]
示("重赋值长度: #{甲.长度}")
示("重赋值甲[1]: #{甲[1]}")

// 含?/找 走通用数组方法(runtime 已按连续缓冲分支)
示("含? 5.0: #{甲.含?(5.0)}")
示("找 5.0: #{甲.找(5.0)}")
示("找 9.0: #{甲.找(9.0)}")

// 函数参数与返回值保持小数数组形态
示("求和函数: #{小数数组求和(甲)}")
设 乙 = 造小数数组()
示("返回长度: #{乙.长度}")
示("返回乙[2]: #{乙[2]}")

示("--- 213_小数数组 结束 ---")

函 小数数组求和(数据: 小数数组): 小数 {
    设 s: 小数 = 0.0
    设 j = 0
    当 j < 数据.长度 {
        s = s + 数据[j]
        j = j + 1
    }
    返 s
}

函 造小数数组(): 小数数组 {
    设 a: 小数数组 = []
    a.追加(7.5)
    a.追加(8.5)
    a.追加(9.5)
    返 a
}
