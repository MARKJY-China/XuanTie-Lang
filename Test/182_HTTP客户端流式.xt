// Test/182_HTTP客户端流式.xt
// 覆盖 lib/HTTP v1.1.0 客户端流式 API:
//   A. 本地服务 Content-Length 响应:状态码 / 响应头查询 / 按行读 / EOF
//   B. 本地服务 POST:请求体 + Content-Length 发送,回显一致
//   C. 裸 TCP chunked 慢速服务:分块解码 / 增量到达 / 0ms 超时语义 / EOF
//   D. 句柄不显式关闭时由 ARC 回收(进程应正常退出)
// https 真机链路不属于确定性回归(依赖外网),在开发期手工验证(见 docs/sessions)。
引 "HTTP" 予 HTTP

示("--- 182_HTTP客户端流式 开始 ---")
设 失败 = 0

// ---------- A. Content-Length ----------
设 甲 = HTTP.服务(19441, 函(请求) {
    若 请求["路径"] == "/echo" { 返 {"体": 请求["体"]} }
    返 {"状态码": 200, "头": {"Content-Type": "text/plain"}, "体": "一\n二\n"}
})
若 非 甲.成功 { 示("FAIL A0 本地服务启动失败: " & 甲.错误) ; 失败 = 1 }

设 a = HTTP.流打开("http://127.0.0.1:19441/", {"方法": "GET"})
若 非 a.成功 {
    示("FAIL A1 打开失败: " & a.错误)
    失败 = 1
} 否 {
    设 s = a.值
    若 HTTP.流状态码(s) != 200 { 示("FAIL A2 状态码=" & HTTP.流状态码(s).转字()) ; 失败 = 1 }
    设 类型 = HTTP.流头(s, "content-type")
    若 类型 != "text/plain" { 示("FAIL A3 Content-Type=" & 化(类型)) ; 失败 = 1 }
    设 l1 = HTTP.流读行(s, 3000)
    若 非 l1.成功 或 l1.值 != "一" { 示("FAIL A4 行1=" & 化(l1)) ; 失败 = 1 }
    设 l2 = HTTP.流读行(s, 3000)
    若 非 l2.成功 或 l2.值 != "二" { 示("FAIL A5 行2=" & 化(l2)) ; 失败 = 1 }
    设 l3 = HTTP.流读行(s, 3000)
    若 l3.成功 { 示("FAIL A6 多余数据: " & 化(l3.值)) ; 失败 = 1 }
    若 l3.错误 != "EOF" { 示("FAIL A7 结束原因=" & 化(l3.错误)) ; 失败 = 1 }
}

// ---------- B. POST 回显 ----------
设 b = HTTP.流打开("http://127.0.0.1:19441/echo", {
    "方法": "POST",
    "头": {"Content-Type": "application/json"},
    "体": "{\"标记\":\"玄铁流式\"}"
})
若 非 b.成功 {
    示("FAIL B1 打开失败: " & b.错误)
    失败 = 1
} 否 {
    设 sb = b.值
    设 全部 = ""
    当 真 {
        设 块 = HTTP.流读块(sb, 4096, 3000)
        若 非 块.成功 { 断 }
        全部 = 全部 & 块.值
    }
    若 全部 != "{\"标记\":\"玄铁流式\"}" { 示("FAIL B2 回显=" & 化(全部)) ; 失败 = 1 }
}

// ---------- C. chunked 慢速 + 增量 + 超时 ----------
设 乙 = 听(19442, 函(流) {
    设 原 = 流.读(65536)
    流.写("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n")
    流.写("6\r\nline1\n\r\n")
    时.睡(300)
    流.写("6\r\nline2\n\r\n")
    流.写("0\r\n\r\n")
    流.关()
})
若 非 乙.成功 { 示("FAIL C0 裸服务启动失败: " & 乙.错误) ; 失败 = 1 }

设 开始 = 时.毫秒()
设 c = HTTP.流打开("http://127.0.0.1:19442/", {"方法": "GET"})
若 非 c.成功 {
    示("FAIL C1 打开失败: " & c.错误)
    失败 = 1
} 否 {
    设 sc = c.值
    若 HTTP.流状态码(sc) != 200 { 示("FAIL C2 状态码=" & HTTP.流状态码(sc).转字()) ; 失败 = 1 }
    若 非 HTTP.流头(sc, "transfer-encoding").包含?("chunked") { 示("FAIL C3 未识别 chunked 头") ; 失败 = 1 }

    设 行1 = HTTP.流读行(sc, 3000)
    若 非 行1.成功 或 行1.值 != "line1" { 示("FAIL C4 首块=" & 化(行1.值) & " 原因=" & 化(行1.错误)) ; 失败 = 1 }
    设 首时刻 = 时.毫秒() - 开始

    设 零 = HTTP.流读行(sc, 0)
    若 零.成功 { 示("FAIL C5 0ms 竟然读到: " & 化(零.值)) ; 失败 = 1 }
    若 零.错误 != "超时" { 示("FAIL C6 0ms 错误=" & 化(零.错误)) ; 失败 = 1 }

    设 空块 = HTTP.流读块(sc, 100, 0)
    若 空块.成功 { 示("FAIL C6b 0ms 块竟然读到: " & 化(空块.值)) ; 失败 = 1 }
    若 空块.错误 != "暂无数据" { 示("FAIL C6c 0ms 块错误=" & 化(空块.错误)) ; 失败 = 1 }

    时.睡(400)
    设 行2 = HTTP.流读行(sc, 3000)
    若 非 行2.成功 或 行2.值 != "line2" { 示("FAIL C7 次块=" & 化(行2.值) & " 原因=" & 化(行2.错误)) ; 失败 = 1 }
    设 尾 = HTTP.流读行(sc, 3000)
    若 尾.成功 { 示("FAIL C8 尾多余: " & 化(尾.值)) ; 失败 = 1 }
    若 尾.错误 != "EOF" { 示("FAIL C9 尾原因=" & 化(尾.错误)) ; 失败 = 1 }

    设 总时刻 = 时.毫秒() - 开始
    若 首时刻 >= 总时刻 - 200 { 示("FAIL C10 非增量: 首=" & 首时刻.转字() & "ms 总=" & 总时刻.转字() & "ms") ; 失败 = 1 } 否 {
        示("PASS 增量: 首块 " & 首时刻.转字() & "ms, 全量 " & 总时刻.转字() & "ms")
    }
}

// ---------- D. 不显式关闭句柄,依赖 ARC 回收 ----------
// A/B/C 三个句柄都没有调用 流关:进程能正常走到这里并退出,即回收路径未崩。
示("PASS 句柄未显式关闭仍正常")

若 失败 == 0 { 示("182 PASS") } 否 { 示("182 FAIL") ; 终 1 }
示("--- 182_HTTP客户端流式 结束 ---")


