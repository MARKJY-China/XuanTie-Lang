// Test/168_分支重赋值汇合点.xt
// issue #121:局部变量在 若/抑/否 块内重赋值后，汇合点之后读取得固定垃圾值
//（反规格双精度，形如 7e-312），且分支未执行也一样。
// 根因:XTC 把分支内 `x = 1.0` 学到的 raw_f64 泄漏进全局变量类型表，
// 汇合后的 `x < 0.0` 被编译成原生 double 比较(bitcast 标签指针)、`返 x` 按 double 装箱。
// 修法:若语句在每个分支前后快照/恢复变量类型表，分支内类型只在分支内有效。

示("--- 168 分支重赋值汇合点 开始 ---")

// 1. 原始复现:分支内钳制，汇合后继续比较
函 试钳(v) {
    设 x = v
    若 x > 1.0 { x = 1.0 }
    若 x < 0.0 { x = 0.0 }
    返 x
}
示("钳(0.0)=" & 字(试钳(0.0)))
示("钳(3.0)=" & 字(试钳(3.0)))
示("钳(-2.0)=" & 字(试钳(-2.0)))

// 2. 分支未执行:不得污染汇合后的读取
函 不动(v) {
    设 x = v
    若 x > 100 { x = 100 }
    返 x
}
示("不动(7)=" & 字(不动(7)))

// 3. 兄弟分支互不影响:抑 分支不应继承 若 分支的类型细化
函 兄弟(v) {
    设 x = v
    若 x > 10 { x = 10 }
    抑 x > 5 { x = x + 1 }
    返 x
}
示("兄弟(20)=" & 字(兄弟(20)))
示("兄弟(7)=" & 字(兄弟(7)))
示("兄弟(1)=" & 字(兄弟(1)))

// 4. 否 分支里的重赋值
函 兜底(v) {
    设 x = v
    若 x > 0 { x = x + 1 } 否 { x = 0 }
    返 x
}
示("兜底(5)=" & 字(兜底(5)))
示("兜底(-5)=" & 字(兜底(-5)))

// 5. 分支重赋值后写进容器(此前垃圾值会被写进字典)
函 入表(v) {
    设 x = v
    若 x > 1 { x = 1 }
    设 d = {}
    d["x"] = x
    返 d
}
示("入表(9)=" & 字(入表(9)["x"]))

// 6. 嵌套若
函 嵌套(v) {
    设 x = v
    若 x > 0 {
        设 y = x
        若 y > 10 { x = 10 }
    }
    返 x
}
示("嵌套(99)=" & 字(嵌套(99)))
示("嵌套(3)=" & 字(嵌套(3)))

示("--- 168 分支重赋值汇合点 结束 ---")
