// Test/216_小数数组FFT.xt
// 小数数组 + 显式 整 局部变量的 8 点基 2 FFT:单位冲激的频谱应全为 1+0i。
示("--- 216_小数数组FFT 开始 ---")

设 N: 整 = 8
设 实: 小数数组 = []
设 虚: 小数数组 = []
设 余弦表: 小数数组 = []
设 正弦表: 小数数组 = []
设 i: 整 = 0
当 i < N {
    若 i == 0 {
        实.追加(1.0)
    } 否 {
        实.追加(0.0)
    }
    虚.追加(0.0)
    i = i + 1
}
i = 0
当 i < N / 2 {
    余弦表.追加(数学.余弦(2.0 * 数学.圆周率 * i / N))
    正弦表.追加(数学.正弦(2.0 * 数学.圆周率 * i / N))
    i = i + 1
}

fft8(实, 虚, 余弦表, 正弦表)

示("实[0]=#{实[0]}")
示("实[3]=#{实[3]}")
示("虚[3]=#{虚[3]}")
示("实[7]=#{实[7]}")
示("--- 216_小数数组FFT 结束 ---")

函 fft8(实: 小数数组, 虚: 小数数组, 余弦表: 小数数组, 正弦表: 小数数组) {
    设 n: 整 = 实.长度
    设 i: 整 = 1
    设 j: 整 = 0
    当 i < n {
        设 bit: 整 = n / 2
        当 (j 位与 bit) != 0 {
            j = j 异或 bit
            bit = bit / 2
        }
        j = j 异或 bit
        若 i < j {
            设 tr: 小数 = 实[i]
            实[i] = 实[j]
            实[j] = tr
            设 ti: 小数 = 虚[i]
            虚[i] = 虚[j]
            虚[j] = ti
        }
        i = i + 1
    }

    设 len: 整 = 2
    当 len <= n {
        设 half: 整 = len / 2
        设 step: 整 = n / len
        设 k: 整 = 0
        当 k < n {
            设 t: 整 = 0
            当 t < half {
                设 idx: 整 = k + t
                设 tw: 整 = t * step
                设 wr: 小数 = 余弦表[tw]
                设 wi: 小数 = -正弦表[tw]
                设 ur: 小数 = 实[idx]
                设 ui: 小数 = 虚[idx]
                设 vr0: 小数 = 实[idx + half]
                设 vi0: 小数 = 虚[idx + half]
                设 vr: 小数 = vr0 * wr - vi0 * wi
                设 vi: 小数 = vr0 * wi + vi0 * wr
                实[idx] = ur + vr
                虚[idx] = ui + vi
                实[idx + half] = ur - vr
                虚[idx + half] = ui - vi
                t = t + 1
            }
            k = k + len
        }
        len = len * 2
    }
}
