// Test/204_JSON契约三态.xt
// issue #146 v1 契约:三态反序列化必须能区分「空输入 / 非法 JSON / 合法 null」。
//   · 试解(文本): 结果(编译器内建,直接调用)
//     成功 .成功=真/.值=解析值(合法 null → .值=空,仍算成功),失败 .成功=假/.错误=原因文本;
//     原因前缀:"空输入" / "非法 JSON" / "数值越界"。
//   · 解(文本) 保持旧兼容契约:空串 / 非法 JSON / JSON null 一律返回 空(三者不可区分)。

设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

// A. 空输入(空串 / 仅空白)——失败且原因明确
设 空串果 = 试解("")
断言("空串失败", 非 空串果.成功)
断言("空串原因", 空串果.错误.包含?("空输入"))
设 空白果 = 试解("   ")
断言("空白失败", (非 空白果.成功) 且 空白果.错误.包含?("空输入"))

// B. 非法 JSON——失败且原因明确
设 坏对象果 = 试解("{坏")
断言("坏对象失败", 非 坏对象果.成功)
断言("坏对象原因", 坏对象果.错误.包含?("非法 JSON"))
设 坏数组果 = 试解("[1,]")
断言("坏数组失败", (非 坏数组果.成功) 且 坏数组果.错误.包含?("非法 JSON"))
设 尾垃圾果 = 试解("123abc")
断言("尾垃圾失败", (非 尾垃圾果.成功) 且 尾垃圾果.错误.包含?("非法 JSON"))

// C. 合法 null——成功且 .值 为空(与失败可区分)
设 null果 = 试解("null")
断言("null成功", null果.成功)
断言("null值为空", null果.值 == 空)
断言("null无错误", null果.错误 == 空)

// D. 成功值(含嵌套浮点)
设 数果 = 试解("3.14")
断言("数值成功", 数果.成功)
断言("数值正确", (数果.值 == 3.14) 且 (数果.值 是 小数))
设 嵌套果 = 试解("{\"k\": [1.5, true, null]}")
断言("嵌套成功", 嵌套果.成功)
断言("嵌套值", (嵌套果.值["k"][0] == 1.5) 且 (嵌套果.值["k"][1] == 真) 且 (嵌套果.值["k"][2] == 空))

// E. 数值越界也走失败态(不崩、不静默失真)
设 浮溢果 = 试解("1e400")
断言("浮点溢出失败", 非 浮溢果.成功)
断言("浮点溢出原因", 浮溢果.错误.包含?("数值越界"))
设 整溢果 = 试解("4611686018427387904")
断言("整溢出失败", (非 整溢果.成功) 且 整溢果.错误.包含?("数值越界"))

// F. 旧契约:解 对三者都返回 空(写死的兼容行为)
断言("解空串为空", 解("") == 空)
断言("解非法为空", 解("{坏") == 空)
断言("解null为空", 解("null") == 空)

若 失败数 == 0 { 示("204 PASS") } 否 { 示("204 失败数: " & 失败数) ; 终 1 }
