// Test/211_尝试产出.xt
// 增强 尝试 表达式:产出 expr 从最近一层尝试表达式返回(issue #113 后续)。
// 覆盖:循环/条件内提前产出、无产出块尾兜底、捕捉块产出、嵌套绑定最近层、
//       字符串/数组引用值、异步/并行内产出。
示("--- 211_尝试产出 开始 ---")

// 1. 循环内提前产出
函 找首个负数(列表: 数组): 整 {
    设 值 = 尝试 {
        遍历 x 于 列表 {
            若 x < 0 {
                产出 x
            }
        }
        产出 0
    } 捕捉 (e) {
        产出 -1
    }
    返 值
}
示("有负数=" & 字(找首个负数([3, 5, -7, 9])))
示("无负数=" & 字(找首个负数([1, 2, 3])))

// 2. 无产出的块尾表达式兜底
设 兜底 = 尝试 {
    设 x = 20
    x + 1
} 捕捉 (e) {
    0
}
示("兜底=" & 字(兜底))

// 3. 捕捉块产出
设 捕值 = 尝试 {
    设 无 = {"x": 1}["不存在"]
    示(无.长度)
} 捕捉 (e) {
    产出 99
}
示("捕值=" & 字(捕值))

// 4. 嵌套:产出绑定最近一层
设 内层 = 尝试 {
    设 内 = 尝试 {
        产出 1
    } 捕捉 (e) {
        产出 2
    }
    产出 内 + 10
} 捕捉 (e) {
    -1
}
示("内层=" & 字(内层))

// 5. 引用类型值:局部释放后产出仍有效
设 字符串值 = 尝试 {
    设 局部 = "你好"
    产出 局部
} 捕捉 (e) {
    产出 "失败"
}
示("字符串=" & 字符串值)
设 数组值 = 尝试 {
    产出 [1, 2, 3]
} 捕捉 (e) {
    产出 []
}
示("数组长度=" & 字(数组值.长度))

// 6. 异步/并行内产出
设 任务1 = 异步 {
    设 值 = 尝试 {
        遍历 x 于 [1, 2, 3] {
            若 x == 2 { 产出 x * 10 }
        }
        产出 0
    } 捕捉 (e) {
        产出 -1
    }
    示("异步=" & 字(值))
}
等待(任务1)
设 结果道 = 道(1)
并行 {
    {
        设 值 = 尝试 {
            产出 123
        } 捕捉 (e) {
            产出 0
        }
        结果道.发(值)
    }
}
示("并行=" & 字(结果道.收()))

示("--- 211_尝试产出 结束 ---")
