// Test/146_URL编解码与字节转换.xt
// 覆盖内置 URL编码/URL解码/字节到字符串 的语义正例:
// - RFC 3986:unreserved(A-Z a-z 0-9 - _ . ~)直通,其余按 UTF-8 字节转 %XX(大写)
// - 空格 → %20(不是 form 的 '+');解码时 '+' 原样保留(RFC 3986,不做 form 语义还原)
// - 空串往返一致;中文/特殊字符混合串往返一致;十六进制小写转义可解
// - 字节到字符串:手搭 UTF-8 字节序列还原中文(严格校验在 Test/147 覆盖)

示("--- 146_URL编解码与字节转换 开始 ---")

// ① 编码基本形态
示("编码中文: " & URL编码("玄铁"))
示("编码特殊: " & URL编码("a b&c=d/e+f~g"))
示("编码空串: [" & URL编码("") & "]")
示("编码直通: " & URL编码("AZaz09-_.~"))
示("编码百分号: " & URL编码("100%"))

// ② 解码基本形态
示("解码中文: " & URL解码("%E7%8E%84%E9%93%81"))
示("解码混合: " & URL解码("a%20b%26c%3Dd%2Fe+f~g"))
示("解码小写十六进制: " & URL解码("%e7%8e%84"))
示("解码空串: [" & URL解码("") & "]")

// ③ 往返一致
设 样本 = "玄铁 &a=/b 空格 100% + 波浪~"
设 往返 = URL解码(URL编码(样本))
示("往返一致: " & 往返)
示("往返判定: " & (往返 == 样本))

// ④ 字节到字符串:手搭 "玄铁" 的 UTF-8 字节(E7 8E 84 E9 93 81)
设 缓冲 = 字节(16)
缓冲.追加(231)
缓冲.追加(142)
缓冲.追加(132)
缓冲.追加(233)
缓冲.追加(147)
缓冲.追加(129)
设 文本 = 字节到字符串(缓冲)
示("字节转字符串: " & 文本)
示("与原字相等: " & (文本 == "玄铁"))

// ⑤ 组合:字节 → 字符串 → 编码
示("组合编码: " & URL编码(字节到字符串(缓冲)))

示("--- 146_URL编解码与字节转换 结束 ---")
