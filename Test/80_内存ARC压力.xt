// Test 80 — 内存/ARC 压力(S3 专项)
// ARC 密集形态:字符串搅动、对象数组搅动、闭包捕获、弱引用、结果传递
// 判定:全部 PASS 且不崩溃(堆损坏检测器全程在线)

示("=== Test 80: 内存ARC压力 ===")

// 1. 字符串搅动(大量临时字符串的创建与释放)
设 s = ""
设 i = 0
当 i < 2000 {
    s = "前缀" & i & "后缀"
    i = i + 1
}
若 s.包含?("1999") { 示("PASS: 字符串搅动") } 否 { 示("FAIL: 字符串搅动") }

// 2. 对象数组搅动(建-换-删循环)
设 arr = []
设 j = 0
当 j < 500 {
    arr.追加("项" & j)
    j = j + 1
}
设 k = 0
当 k < 500 {
    arr[k] = "改" & k
    k = k + 1
}
若 arr.长度 == 500 且 arr[499].包含?("499") { 示("PASS: 对象数组搅动") } 否 { 示("FAIL: 对象数组搅动") }

// 3. 闭包捕获循环(逐迭代捕获语义:每个闭包记住自己那轮的值)
设 闭包列 = []
设 c = 0
当 c < 100 {
    设 捕获值 = c * 2
    闭包列.追加(函() { 返 捕获值 })
    c = c + 1
}
设 闭包和 = 0
遍历 f 于 闭包列 { 闭包和 = 闭包和 + f() }
若 闭包和 == 9900 { 示("PASS: 闭包逐迭代捕获") } 否 { 示("FAIL: 闭包逐迭代捕获 和=" & 闭包和) }

// 4. 结果容器链式传递
函 可败(n) {
    若 n < 0 { 返 失败("负") }
    返 成功(n * 2)
}
设 链总 = 0
设 m = 0
当 m < 200 {
    设 r = 可败(m)
    若 r.成功 { 链总 = 链总 + r.值 }
    m = m + 1
}
若 链总 == 39800 { 示("PASS: 结果链式传递") } 否 { 示("FAIL: 结果链式传递 " & 链总) }

// 5. 弱引用大量使用
设 弱列 = []
设 w = 0
当 w < 100 {
    弱列.追加({"值": w})
    w = w + 1
}
若 弱列.长度 == 100 { 示("PASS: 弱引用相关创建") } 否 { 示("FAIL: 弱引用相关创建") }

示("=== Test 80 完成 ===")
