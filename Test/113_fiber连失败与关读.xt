// 105_fiber连失败与关读:连死端口得失败结果;连上后对端即关,读返回 空——fiber 均不得崩/挂死
示("--- 105_fiber连失败与关读 开始 ---")

听(19305, 函(流) {
    //  Accept 后立即关闭,不写任何数据
    流.关()
})

设 客 = 异步 {
    // 1. 连死端口(本机 19997 无监听)
    设 r1 = 连("127.0.0.1:19997")
    若 r1.成功 {
        示("FAIL: 死端口不应连上")
        r1.值.关()
    } 否 {
        示("PASS: 死端口连接被拒绝")
    }
    // 2. 连上后对端立即关闭:读 → 空
    设 r2 = 连("127.0.0.1:19305")
    若 非 r2.成功 { 示("FAIL: 正常端口连接失败") ; 返 空 }
    设 流 = r2.值
    设 数据 = 流.读()
    若 数据 == 空 {
        示("PASS: 对端关闭读返回空")
    } 否 {
        示("FAIL: 关闭后读到=#{数据}")
    }
    流.关()
    示("fiber 存活到终点")
}
等待(客)
示("--- 105_fiber连失败与关读 结束 ---")
