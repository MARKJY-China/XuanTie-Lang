// Test/202_JSON契约浮点序列化.xt
// issue #145 v1 契约:小数(XTFloat/REAL)序列化为合法 JSON 数字,采用最短可往返表示:
//   1~17 位有效数字内取能经 strtod 还原为同一 double 的最短串;整数值补 ".0"
//   (否则 1.0 化 成 "1",解 回来变成 整,类型丢失);整 仍按 i64 十进制精确输出。
// 非有限值(NaN/Inf)由 205/206 单独覆盖(化 会明确报错退出)。
设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

// 1. 基本小数:3.14 / 0.1 / 1.0
断言("化3.14", 化(3.14) == "3.14")
断言("化0.1", 化(0.1) == "0.1")
断言("化1.0", 化(1.0) == "1.0")
断言("化-2.5", 化(-2.5) == "-2.5")
断言("化1000.0", 化(1000.0) == "1000.0")

// 2. 最短表示必须能还原同一 double(精度闭环)
断言("化0.1+0.2", 化(0.1 + 0.2) == "0.30000000000000004")
断言("往返0.1+0.2", 解(化(0.1 + 0.2)) == 0.1 + 0.2)
断言("往返1/3", 解(化(1.0 / 3.0)) == 1.0 / 3.0)

// 3. 大整数不转 double(9007199254740993 = 2^53+1,double 无法精确表示)
断言("化大整数", 化(9007199254740993) == "9007199254740993")

// 4. 嵌套数组/字典浮点闭环(键序无关:经 解 回读后比较值)
断言("化嵌套数组", 化([1.5, 2.0, 3.14]) == "[1.5, 2.0, 3.14]")
设 内层 = {"深": 2000000.0}
设 外层 = {"组": [0.1, 内层]}
设 嵌套 = 解(化(外层))
断言("嵌套回读0.1", 嵌套["组"][0] == 0.1)
断言("嵌套回读2e6", 嵌套["组"][1]["深"] == 2000000.0)
断言("嵌套是小数", (嵌套["组"][0] 是 小数) 且 (嵌套["组"][1]["深"] 是 小数))

// 5. 缩进模式标量复用同一数字格式
断言("缩进小数", 化([1.5], "缩进") == "[\n  1.5\n]")

// 6. 同一对象多次序列化字节稳定(issue #147 稳定性子契约)
设 对象 = {"甲": 1.5, "乙": [0.25, 2]}
设 文本 = 化(对象)
断言("重复序列化", 化(对象) == 文本 且 化(对象) == 文本)

若 失败数 == 0 { 示("202 PASS") } 否 { 示("202 失败数: " & 失败数) ; 终 1 }
