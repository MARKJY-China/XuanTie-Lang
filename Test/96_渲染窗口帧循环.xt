// Test/96_渲染窗口帧循环.xt
// 窗口生命周期+帧循环+图形绘制链路:开窗→30帧绘制→自动关窗
// 覆盖:初始化窗口/开始绘图/清背景/绘矩形/绘圆/绘文字/结束绘图/关闭窗口
引 "渲染" 予 R

R.初始化窗口(320, 240, "96测试")
设 帧 = 0
当 非 R.窗口应关闭() {
    R.开始绘图()
    R.清背景(20, 20, 30, 255)
    R.绘矩形(10, 10, 50, 50, 200, 80, 80, 255)
    R.绘矩形线(70, 10, 50, 50, 80, 200, 80, 255)
    R.绘圆(160, 60, 25, 80, 80, 200, 255)
    R.绘圆线(220, 60, 25, 200, 200, 80, 255)
    R.绘直线(10, 100, 300, 100, 120, 120, 120, 255)
    R.绘文字("XuanTie", 10, 120, 20, 255, 255, 255, 255)
    R.结束绘图()
    帧 = 帧 + 1
    若 帧 >= 30 { 断 }
}
R.关闭窗口()
若 帧 != 30 {
    示("FAIL: 帧数不符 " & 帧)
    终 1
}
示("96 PASS")
