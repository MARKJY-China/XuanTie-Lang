// Test/101_逻辑短路重评.xt
// 逻辑 或/且 在循环内被重复求值的正确性回归。
// 曾是回归空洞:或/且结果槽位在函数入口一次性初始化,短路跳过分支时残留上趟求值,
// 循环第二趟起条件被误判(自举实测:词法器跳过空白 4 路或第二趟误判退出,幻影非法标记)。
设 失败 = 0

// A. 4 路或:第一趟经第3支路进体,第二趟第1支路为真必须继续
设 c = "\n"
设 步数 = 0
当 c == " " 或 c == "\t" 或 c == "\n" 或 c == "\r" {
    步数 = 步数 + 1
    若 步数 == 1 { c = " " }
    若 步数 == 2 { c = " " }
    若 步数 == 3 { c = "i" }
    若 步数 > 9 { 断 }
}
若 步数 != 3 或 c != "i" { 示("FAIL A: 或多路重评 步数=" & 步数 & " c=[" & c & "]") ; 失败 = 1 }

// B. 且:第一趟真真进体,第二趟 cond1 为假必须退出(不残留真)
设 y = 0
设 cnt = 0
当 y == 0 且 y < 2 {
    y = y + 1
    cnt = cnt + 1
    若 cnt > 9 { 断 }
}
若 cnt != 1 { 示("FAIL B: 且残留重评 cnt=" & cnt) ; 失败 = 1 }

// C. 或在循环里交替真假(覆盖残假→真方向)
设 d = "\n"
设 n2 = 0
当 d == " " 或 d == "\n" 或 d == "z" {
    n2 = n2 + 1
    若 n2 == 1 { d = "z" }
    若 n2 == 2 { d = " " }
    若 n2 == 3 { d = "q" }
    若 n2 > 9 { 断 }
}
若 n2 != 3 { 示("FAIL C: 或交替重评 n2=" & n2) ; 失败 = 1 }

若 失败 == 0 { 示("101 PASS") } 否 { 终 1 }
