// Test/106_是类型判断.xt
// 中缀 是 的双形态回归:类型判断(a 是 整 / a 是 "整")与值等价(a 是 1)。
// 背景:XTC 曾把 是 右侧硬解析为类型名标识符——值形态编译报错,类型形态落常量 0(静默错答)。
设 失败 = 0

// A. 类型判断·裸类型关键字
设 i = 42
设 f = 3.14
设 s = "玄铁"
设 b = 真
设 arr = [1, 2]
设 dic = {"k": 1}
若 非 (i 是 整) { 示("FAIL A1 整") ; 失败 = 1 }
若 非 (f 是 小数) { 示("FAIL A2 小数") ; 失败 = 1 }
若 非 (s 是 字) { 示("FAIL A3 字") ; 失败 = 1 }
若 非 (b 是 布尔) { 示("FAIL A4 布尔") ; 失败 = 1 }
若 非 (arr 是 数组) { 示("FAIL A5 数组") ; 失败 = 1 }
若 非 (dic 是 字典) { 示("FAIL A6 字典") ; 失败 = 1 }

// B. 类型判断·反向(不该中的不中)
若 i 是 小数 { 示("FAIL B1") ; 失败 = 1 }
若 f 是 整 { 示("FAIL B2") ; 失败 = 1 }
若 s 是 数组 { 示("FAIL B3") ; 失败 = 1 }
若 arr 是 字典 { 示("FAIL B4") ; 失败 = 1 }

// C. 类型判断·字符串形态与别名(GSC 兼容)
若 非 (i 是 "整") { 示("FAIL C1") ; 失败 = 1 }
若 非 (i 是 "整数") { 示("FAIL C2 别名") ; 失败 = 1 }
若 非 (s 是 "字符串") { 示("FAIL C3 别名") ; 失败 = 1 }
若 非 (f 是 "浮点") { 示("FAIL C4 别名") ; 失败 = 1 }

// D. 空 判断
设 n = 空
若 非 (n 是 空) { 示("FAIL D1 空") ; 失败 = 1 }
若 i 是 空 { 示("FAIL D2 非空误判") ; 失败 = 1 }

// E. 值等价(右侧非类型名 → 值比较)
若 非 (5 是 5) { 示("FAIL E1 整值") ; 失败 = 1 }
若 5 是 6 { 示("FAIL E2 不等误判") ; 失败 = 1 }
若 非 ("甲" 是 "甲") { 示("FAIL E3 字符串值") ; 失败 = 1 }
若 非 (1 是 1.0) { 示("FAIL E4 混合等价") ; 失败 = 1 }
若 1.5 是 1.6 { 示("FAIL E5 浮点不等") ; 失败 = 1 }

// F. 变量参与值等价
设 x = 10
设 y = 10
若 非 (x 是 y) { 示("FAIL F1 变量等价") ; 失败 = 1 }
设 z = 9
若 x 是 z { 示("FAIL F2 变量不等误判") ; 失败 = 1 }

// G. 在条件组合中使用
若 (i 是 整) 且 (f 是 小数) 且 非 (s 是 数组) {
    // 通过
} 否 {
    示("FAIL G1 条件组合") ; 失败 = 1
}

// H. 匹配 类型分支不受影响的回归
匹配 i {
    是 整 -> { }
    _ -> { 示("FAIL H1 匹配类型分支") ; 失败 = 1 }
}
匹配 s {
    是 字 -> { }
    _ -> { 示("FAIL H2 匹配类型分支") ; 失败 = 1 }
}

若 失败 == 0 { 示("106 PASS") } 否 { 终 1 }
