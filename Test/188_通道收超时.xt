// Test/188_通道收超时.xt
// issue #143:道.收(0)=非阻塞轮询,道.收(毫秒)=限时等待,超时返空。
设 道1 = 道(1)
设 t0 = 时.毫秒()
设 v0 = 道1.收(0)
设 e0 = 时.毫秒() - t0
示("收0空=" & 字(v0 == 空) & " 立即=" & 字(e0 < 200))
设 t1 = 时.毫秒()
设 v1 = 道1.收(200)
设 e1 = 时.毫秒() - t1
示("收200空=" & 字(v1 == 空) & " 限时=" & 字(e1 >= 150 且 e1 <= 2000))
道1.发("甲")
示("先发后收=" & 字(道1.收(0) == "甲"))
