// Test/227_字节预置与视图.xt
示("--- 227_字节预置与视图 开始 ---")
设 缓冲 = 字节预置(8)
示("预置长度=#{缓冲.字节数}")
示("写32=#{缓冲.写小端(0, 305419896, 4)}")
示("读32=#{缓冲.读小端(0, 4)}")
设 视 = 缓冲.视图(0, 4)
示("视长度=#{视.字节数}")
设 视2: 字节视图 = 缓冲.视图(0, 2)
示("视2长度=#{视2.字节数}")
示("是视图=#{视2 是 字节视图}")
示("视读32=#{视.读小端(0, 4)}")
示("视写小端=#{视.写小端(0, 4660, 2)}")
示("视读小端=#{视.读小端(0, 2)}")
示("视写=#{视.写字节(1, 0)}")
示("源[1]=#{缓冲.取字节(1)}")
缓冲.写字节(2, 99)
示("视[2]=#{视.取字节(2)}")
设 串源 = 到字节集("abcd")
设 串视 = 串源.视图(0, 2)
示("串视长度=#{串视.字节数}")
示("--- 227_字节预置与视图 结束 ---")
