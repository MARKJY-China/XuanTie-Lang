// Test/129_等待结果成员访问.xt
// 覆盖"对 等待 的结果直接接成员/方法访问"。
// 旧缺陷:成员调用的分派前置段为了拿接收者的静态类型做访问控制,先把接收者求值了一次
// (值当场释放),随后各分支又各自求值一次 —— 接收者被求值两遍。等待 是一次性操作:
// 第一遍把任务句柄消费掉并清零,第二遍拿到空句柄,结果静默变 空(实测 等待(t).转字() = 空);
// fiber 状态机路径更重:编译期 异步等待命中计数 被推进两次 → 状态标签越界 →
// 生成 "br ... label %空" 的非法 IR,clang 直接失败。
// 修复:分派前置段不再求值(只做纯查表的静态类型推断),接收者求值收敛到分支内唯一一次;
// 截取 分支改为自行求值(此前它复用前置段的值)。
// 判定:各语法位置都取回真实值,且带副作用的接收者只执行一次;访问控制仍然生效。

示("--- 129_等待结果成员访问 开始 ---")

// 位置一:非状态机路径,等待结果直接挂方法
设 甲任务 = 异步 { 时.睡(5) ; 返 "甲" }
设 甲字 = 等待(甲任务).转字()
若 甲字 == "甲" { 示("PASS: 顶层 等待(t).转字() = " & 甲字) } 否 { 示("FAIL: 顶层 等待(t).转字() = " & 字(甲字)) }

// 位置二:fiber 状态机内(旧行为:编译期就产出非法 IR)
函 机内成员访问() {
    设 乙任务 = 异步 { 时.睡(5) ; 返 20 }
    设 乙外层 = 异步 {
        设 乙字 = 等待(乙任务).转字()
        返 乙字
    }
    返 等待(乙外层)
}
设 乙字 = 机内成员访问()
若 乙字 == "20" { 示("PASS: fiber 内 等待(t).转字() = " & 乙字) } 否 { 示("FAIL: fiber 内 等待(t).转字() = " & 字(乙字)) }

// 位置三:接收者带副作用——只允许求值一次
设 取任务次数 = 0
函 取任务() {
    取任务次数 = 取任务次数 + 1
    返 异步 { 时.睡(5) ; 返 "丙" }
}
设 丙字 = 等待(取任务()).转字()
若 丙字 == "丙" 且 取任务次数 == 1 {
    示("PASS: 带副作用接收者只求值一次(次数=" & 字(取任务次数) & ")")
} 否 {
    示("FAIL: 接收者求值次数=" & 字(取任务次数) & " 结果=" & 字(丙字))
}

// 位置四:截取 分支(修复中改为自行求值)——普通字符串接收者结果不变
设 丁串 = "XuanTie"
设 丁片 = 丁串.截取(0, 4)
若 丁片 == "Xuan" { 示("PASS: 字符串 截取 = " & 丁片) } 否 { 示("FAIL: 字符串 截取 = " & 字(丁片)) }

// 位置五:截取 分支 + 带副作用接收者(接收者只求值一次)
设 取串次数 = 0
函 取串() {
    取串次数 = 取串次数 + 1
    返 "XuanTie"
}
设 戊片 = 取串().截取(4, 7)
若 戊片 == "Tie" 且 取串次数 == 1 {
    示("PASS: 截取 带副作用接收者一次求值(次数=" & 字(取串次数) & ")")
} 否 {
    示("FAIL: 截取 接收者求值次数=" & 字(取串次数) & " 结果=" & 字(戊片))
}

// 位置六:普通接收者的方法调用与成员读取不受影响(回归保护)
设 己表 = [1, 2, 3]
若 己表.长度 == 3 且 己表.含?(2) { 示("PASS: 普通接收者 长度/含? 正常") } 否 { 示("FAIL: 普通接收者") }

// 位置七:字典方法 + 转JSON 分支(其余分派分支的求值次数一致性)
设 庚典 = {"甲": 1}
设 庚字 = 庚典.转JSON()
若 庚字.含?("甲") { 示("PASS: 字典 转JSON = " & 庚字) } 否 { 示("FAIL: 字典 转JSON = " & 字(庚字)) }

示("--- 129_等待结果成员访问 结束 ---")
