// Test/121_等待线程池属主与清零.xt
// 验证 等待(线程池任务) 的结果属主分派与句柄槽位清零:
//   1. 函数内等待多轮——任务句柄被 等待 消费后,作用域退出不得二次释放(旧缺陷:堆损坏)
//   2. 堆结果(字符串)等待后经大搅动仍存活——任务析构连带释放 task->result 不得悬垂(旧缺陷)
//   3. 数组结果同理
//   4. 变量名恰为类型关键字(任务)——等待实参走类型关键字节点路径,槽位清零须覆盖
// 修复前实测(s3):第 4 项中途硬崩(双重释放堆损坏)。

示("--- 121_等待线程池属主与清零 开始 ---")

// 1. 函数内等待×50轮:槽位清零路径 + 结果内容逐轮核对
函 工(标签) {
    设 t = 异步 {
        时.睡(5)
        返 "R:" & 标签
    }
    设 r = 等待(t)
    返 r
}

设 全对 = 真
设 i = 0
当 i < 50 {
    设 r = 工("轮" & 字(i))
    若 r != "R:轮" & 字(i) {
        示("FAIL: 第" & 字(i) & "轮结果错: " & r)
        全对 = 假
    }
    i = i + 1
}
若 全对 { 示("PASS: 函数内等待×50轮结果全对") } 否 { 示("FAIL: 函数内等待有坏轮") }

// 2. 堆结果存活:等待后大搅动,字符串结果不得被堆重用破坏
设 t2 = 异步 { 返 "KEEPME_0123456789" }
设 r2 = 等待(t2)
设 j = 0
当 j < 800 {
    设 垃圾 = "搅动段" & 字(j * 7919)
    j = j + 1
}
若 r2 == "KEEPME_0123456789" { 示("PASS: 堆搅动后字符串结果存活") } 否 { 示("FAIL: 字符串结果被破坏: " & r2) }

// 3. 数组结果同理
设 t3 = 异步 { 返 [10, 20, 30] }
设 r3 = 等待(t3)
若 r3.长度 == 3 且 r3[2] == 30 { 示("PASS: 数组结果存活") } 否 { 示("FAIL: 数组结果坏") }

// 4. 变量名恰为类型关键字(任务):等待实参走类型关键字节点路径,槽位清零须覆盖
函 工关键名() {
    设 任务 = 异步 { 返 "KW" }
    设 r = 等待(任务)
    返 r
}
设 r4 = 工关键名()
若 r4 == "KW" { 示("PASS: 任务 关键字名变量等待") } 否 { 示("FAIL: 关键字名路径 r4=" & r4) }

示("--- 121_等待线程池属主与清零 结束 ---")
