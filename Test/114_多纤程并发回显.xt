// 106_多纤程并发回显:20 个 fiber 同时 连/写/读 同一服务器,全部成功且内容各自正确
示("--- 106_多纤程并发回显 开始 ---")

设 成功数 = 0

听(19306, 函(流) {
    设 数据 = 流.读()
    若 数据 != 空 {
        流.写("回:" & 数据)
    }
    流.关()
})

设 们 = []
设 i = 0
当 i < 20 {
    设 j = i
    们.追加(异步 {
        设 r = 连("127.0.0.1:19306")
        若 非 r.成功 { 返 空 }
        设 流 = r.值
        设 讯 = "纤" & j
        流.写(讯)
        设 回 = 流.读()
        若 回 == "回:" & 讯 { 成功数 = 成功数 + 1 }
        流.关()
    })
    i = i + 1
}
遍历 t 于 们 { 等待(t) }

若 成功数 == 20 {
    示("PASS: 20纤程并发回环全部正确")
} 否 {
    示("FAIL: 成功数=#{成功数}/20")
}
示("--- 106_多纤程并发回显 结束 ---")
