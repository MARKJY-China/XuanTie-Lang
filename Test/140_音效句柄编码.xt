// Test/140_音效句柄编码.xt
// issue #44:渲染桥的 XT_LoadSound / XT_LoadMusicStream 原先把 calloc 出来的 Sound*/Music*
// 裸指针直接当句柄返回 —— 那 LSB=0 且 >4096,玄铁侧 ARC 会按"堆对象"校验 magic,
// 读到的却是 raylib 结构体,于是加载任意 wav 都误报「堆损坏或非法指针访问」并退出。
// 现改为与纹理/字体一致的"槽位池 + XT_FROM_INT(槽号+1)",0 表示失败。
// 本用例走"文件缺失"路径,不需要音频设备、不需要窗口 —— 但恰好覆盖崩溃那条路径:
// 句柄要被 ARC 触碰(放进数组),旧实现到这里就会崩。
引 "渲染" 予 R

示("--- 140 音效/音乐句柄编码 开始 ---")
设 失败 = 0

// A. 加载不存在的音效:必须返回 0,而不是裸 C 指针
设 音效 = R.加载音效("__不存在的音效__.wav")
若 音效 != 0 {
    示("FAIL A1 缺失文件仍返回非 0 句柄=" & 化(音效))
    失败 = 1
} 否 {
    示("PASS A 缺失音效返回 0")
}

// B. 关键回归:句柄必须能安全进 ARC 容器(旧实现返回裸指针 → 此处崩)
设 表 = []
表.追加(音效)
若 表.长度 == 1 {
    示("PASS B 音效句柄可安全入容器(无 ARC 误判)")
} 否 {
    示("FAIL B1 容器长度=" & 化(表.长度))
    失败 = 1
}

// C. 音乐流同理
设 音乐 = R.加载音乐流("__不存在的音乐__.ogg")
若 音乐 != 0 {
    示("FAIL C1 缺失文件仍返回非 0 句柄=" & 化(音乐))
    失败 = 1
} 否 {
    示("PASS C 缺失音乐流返回 0")
}
设 表2 = []
表2.追加(音乐)
示("PASS C2 音乐句柄可安全入容器")

// D. 纹理解码失败同样返回 0(issue #44 评论第 2 条:旧实现句柄非 0 但尺寸为 0,调用方误判成功)
设 纹理 = R.加载纹理("__不存在的图__.png")
若 纹理 != 0 {
    示("FAIL D1 缺失图片仍返回非 0 句柄=" & 化(纹理))
    失败 = 1
} 否 {
    示("PASS D 缺失纹理返回 0")
}
若 R.量纹理宽(纹理) != 0 {
    示("FAIL D2 无效句柄竟报出宽度")
    失败 = 1
}

// E. 句柄编码:0 或 标记整数(LSB=1)
若 音效 != 0 且 音效 % 2 != 1 {
    示("FAIL E1 句柄不是标记整数: " & 化(音效))
    失败 = 1
} 否 {
    示("PASS E 句柄为 0 或标记整数")
}

若 失败 == 0 { 示("140 PASS") } 否 { 终 1 }
示("--- 140 音效/音乐句柄编码 结束 ---")
