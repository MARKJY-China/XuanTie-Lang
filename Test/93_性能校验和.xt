// Test 93 — 性能校验和(防「快而错」回归)
// 历史:v0.17.2 曾把此类循环误编译为几乎不执行,输出垃圾值且快得反常(9µs/1e7)。
// 本测试以精确校验和钉死正确性;耗时仅打印不断言(性能数值由人工/基准追踪)。
示("=== Test 93: 性能校验和 ===")
函 累加(n: 整): 整 {
    设 总和 = 0
    设 i = 0
    当 i < n {
        总和 = 总和 + i
        i = i + 1
    }
    返 总和
}
设 开始 = 时.微秒()
设 值 = 累加(1000000)
设 耗时 = 时.微秒() - 开始
若 值 == 499999500000 {
    示("PASS: 校验和正确")
} 否 {
    示("FAIL: 校验和错误 值=" & 值)
}
示("耗时: " & 耗时 & " 微秒")
示("=== Test 93 完成 ===")
