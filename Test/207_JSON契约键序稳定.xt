// Test/207_JSON契约键序稳定.xt
// issue #147 键序契约(v1,写死):
//   · 同一字典对象在**未被修改**的前提下,多次 化() 输出字节完全一致(稳定性契约);
//   · 键序由哈希表桶序决定,不保证与书写/插入顺序一致,也不承诺跨实现/跨版本一致;
//     不同插入顺序通常输出一致(桶位由哈希决定),但桶内冲突链顺序取决于插入顺序,
//     因此「同内容不同插入顺序输出一致」不是契约,只是当前实现的常见观察。
设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

// 1. 同一对象三连序列化字节稳定
设 甲 = {"zeta": 1, "alpha": 2, "mu": 3}
设 甲文 = 化(甲)
示("甲=" & 甲文)
断言("同对象稳定", 化(甲) == 甲文 且 化(甲) == 甲文)

// 2. 键序不保证书写顺序(当前实现为哈希桶序)
断言("键序非书写序", 甲文 != "{\"zeta\": 1, \"alpha\": 2, \"mu\": 3}")

// 3. 样本内不同插入顺序(无桶冲突)输出一致——常见观察,不升格为契约
设 乙 = {"mu": 3, "zeta": 1, "alpha": 2}
示("乙=" & 化(乙))
断言("样本内插入序无关", 化(乙) == 甲文)

// 4. 嵌套对象重复序列化同样稳定
设 内层 = {"b": 1.5, "a": [0.1, 2]}
设 深 = {"外层": 内层, "其他": 真}
断言("嵌套稳定", 化(深) == 化(深) 且 化(深) == 化(深))

// 5. 缩进模式同样稳定
断言("缩进稳定", 化(甲, "缩进") == 化(甲, "缩进"))

若 失败数 == 0 { 示("207 PASS") } 否 { 示("207 失败数: " & 失败数) ; 终 1 }
