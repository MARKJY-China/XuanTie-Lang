// 102_fiber网络回环:异步块内 连/写/读 全链路(方案三核心面)
// 覆盖:fiber 内非阻塞连接、写、读(带上限参数生效验证)、写返回值、多次读
// 写法纪律:切分语句独立成句;若-检查不含切分点(若内含切分会被多状态重发射,既有语义)
示("--- 102_fiber网络回环 开始 ---")

听(19301, 函(流) {
    设 数据 = 流.读()
    若 数据 != 空 {
        流.写("回:" & 数据)
    }
    流.关()
})

设 客 = 异步 {
    设 r = 连("127.0.0.1:19301")
    若 非 r.成功 { 示("FAIL: 连接失败") ; 返 空 }
    设 流 = r.值
    设 写果 = 流.写("你好玄铁网络回环测试")
    若 写果 { 示("PASS: 写返回真") } 否 { 示("FAIL: 写返回假") }
    // 读(16):上限必须生效(阻塞路径忽略参数会一次性返回全部)
    设 块1 = 流.读(16)
    若 块1 != 空 且 块1.字节数 <= 16 {
        示("PASS: 读上限生效 块1=#{块1.字节数}字节")
    } 否 {
        示("FAIL: 读上限未生效")
    }
    // 再读:取剩余部分(多次读同流)
    设 块2 = 流.读()
    若 块2 != 空 且 块2.字节数 > 0 {
        示("PASS: 二次读有数据 块2=#{块2.字节数}字节")
    } 否 {
        示("FAIL: 二次读为空")
    }
    设 全 = 块1 & 块2
    若 全 == "回:你好玄铁网络回环测试" {
        示("PASS: 回环内容完整")
    } 否 {
        示("FAIL: 内容=[#{全}]")
    }
    流.关()
}
等待(客)
示("--- 102_fiber网络回环 结束 ---")
