// Test/151_核心库扩充批次一.xt
// 批次一(对标易语言核心支持库):时间日期结构化/文本/数学/文件系统。
// 全部确定性断言(时间用 指定→部分 往返,文件用自带临时件并清理)。
外 函 xt_cwd(): 字
设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}
函 近( a, b ) {
    若 a > b { 返 a - b < 0.0001 }
    返 b - a < 0.0001
}

// ---- 数学扩充 ----
断言("取符号正", 数学.取符号(3.5) == 1)
断言("取符号负", 数学.取符号(-2) == -1)
断言("取符号零", 数学.取符号(0) == 0)
断言("正切", 近(数学.正切(1.0), 1.5574))
断言("反正弦", 近(数学.反正弦(0.5), 0.5236))
断言("反余弦", 近(数学.反余弦(0.5), 1.0472))
断言("反正切", 近(数学.反正切(1.0), 0.7854))
断言("自然对数", 近(数学.自然对数(数学.自然常数), 1.0))
断言("反对数", 近(数学.反对数(1.0), 数学.自然常数))
设 _rf = 数学.随机小数()
断言("随机小数范围", _rf >= 0.0 且 _rf < 1.0)

// ---- 时间日期结构化 ----
设 _戳 = 时.指定(2024, 3, 15, 10, 30, 45)
设 _部 = 时.部分(_戳)
断言("部分年", _部["年"] == 2024)
断言("部分月", _部["月"] == 3)
断言("部分日", _部["日"] == 15)
断言("部分时分秒", _部["时"] == 10 且 _部["分"] == 30 且 _部["秒"] == 45)
断言("星期范围", _部["星期"] >= 1 且 _部["星期"] <= 7)
设 _格 = 时.格式(_戳, "%Y-%m-%d %H:%M:%S")
断言("格式化", _格.成功 且 _格.值 == "2024-03-15 10:30:45")
设 _戳2 = 时.指定(2024, 3, 15, 10, 31, 15)
断言("间隔30秒", 时.间隔(_戳2, _戳) == 30.0)
设 _往返 = 时.指定(_部["年"], _部["月"], _部["日"], _部["时"], _部["分"], _部["秒"])
断言("指定部分往返", _往返 == _戳)

// ---- 文本扩充 ----
断言("寻找中文", "你好玄铁世界".寻找("玄铁") == 2)
断言("寻找不到", "abc".寻找("z") == -1)
断言("寻找起始", "aXbXc".寻找("X", 2) == 3)
断言("倒找", "aXbXc".倒找("X") == 3)
断言("倒找不到", "abc".倒找("z") == -1)
断言("到大写", "Abc玄e".到大写() == "ABC玄E")
断言("到小写", "AbC玄E".到小写() == "abc玄e")
断言("重复", "ab".重复(3) == "ababab")
断言("重复零次", "ab".重复(0) == "")

// ---- 文件系统扩充 ----
设 _基 = "Test/binary/_b1_tmp"
// 环境自清:CI 干净检出无 Test/binary(不被 git 跟踪),先补父目录;
// 并清理上轮可能的残留(崩溃中断时),全部忽略结果
文件.建目录("Test/binary")
文件.删(_基 & "/a.txt")
文件.删(_基 & "/c.txt")
文件.删目录(_基)
设 _r1 = 文件.建目录(_基)
断言("建目录", _r1.成功)
设 _r2 = 文件.写(_基 & "/a.txt", "玄铁批次一")
断言("写文件", _r2.成功)
设 _r3 = 文件.复制(_基 & "/a.txt", _基 & "/b.txt")
断言("复制", _r3.成功)
设 _r4 = 文件.读(_基 & "/b.txt")
断言("复制内容一致", _r4.成功 且 _r4.值 == "玄铁批次一")
设 _r5 = 文件.尺寸(_基 & "/a.txt")
断言("尺寸", _r5.成功 且 _r5.值 == 15)
设 _r6 = 文件.修改时间(_基 & "/a.txt")
断言("修改时间有效", _r6.成功 且 _r6.值 > 1000000000)
设 _r7 = 文件.移动(_基 & "/b.txt", _基 & "/c.txt")
断言("移动更名", _r7.成功 且 文件.存在?(_基 & "/c.txt"))
断言("移动后源消失", 非 文件.存在?(_基 & "/b.txt"))
文件.删(_基 & "/a.txt")
文件.删(_基 & "/c.txt")
设 _r8 = 文件.删目录(_基)
断言("删目录", _r8.成功)
设 _r9 = 文件.建目录(_基)
设 _原目 = xt_cwd()
文件.改目录(_基)
设 _cwd含 = xt_cwd().包含?("_b1_tmp")
文件.改目录(_原目)
文件.删目录(_基)
断言("改目录往返", _r9.成功 且 _cwd含 且 xt_cwd() == _原目)

若 失败数 == 0 { 示("批次一 全绿") } 否 { 示("批次一 失败数: " & 失败数) }
