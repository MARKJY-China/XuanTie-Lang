// 103_fiber读挂起不卡调度:fiber 读 park 期间,调度器必须继续驱动其他 fiber(方案三核心承诺)
// 设计:服务端两次应答各延迟 300ms;8 个工人 fiber 各睡 150ms。
// 若读挂起卡死调度线程,工人们在第一次应答到达前不可能完成;判定窗口 150ms vs 300ms,确定性分离。
示("--- 103_fiber读挂起不卡调度 开始 ---")

设 完成数 = 0

听(19303, 函(流) {
    设 问 = 流.读()
    时.睡(300)
    流.写("一")
    时.睡(300)
    流.写("二")
    流.关()
})

设 客 = 异步 {
    设 r = 连("127.0.0.1:19303")
    若 非 r.成功 { 示("FAIL: 连接失败") ; 返 空 }
    设 流 = r.值
    流.写("问")
    设 一 = 流.读()
    // 第一次应答到达时(~300ms):150ms 的工人们应已全部完成
    若 完成数 == 8 {
        示("PASS: 读挂起期间调度器活跃(工人8/8)")
    } 否 {
        示("FAIL: 调度器疑似被卡死(工人#{完成数}/8)")
    }
    设 二 = 流.读()
    若 二 == "二" { 示("PASS: 二次应答正确") } 否 { 示("FAIL: 二次应答=#{二}") }
    流.关()
}

设 工人们 = []
设 i = 0
当 i < 8 {
    工人们.追加(异步 {
        时.睡(150)
        完成数 = 完成数 + 1
    })
    i = i + 1
}

等待(客)
遍历 t 于 工人们 { 等待(t) }
示("--- 103_fiber读挂起不卡调度 结束 ---")
