// Test/136_除模语义与快慢路径.xt
// 背景:3258029 因"裸 sdiv/srem 遇零是 UB,而 select 挡不住(两侧都求值)"把整数除/模一律改走运行时,
//       代价是每轮多出字符串构造+字典查找+引用计数:实测 1e6 轮取模 19.9ms → 140.9ms(7.1×)、
//       分支 146ms → 759ms(5.2×)。本次改为**控制流**守卫:P 快路径上先判除数是否为零,
//       为零则跳到运行时调用(保留除零返 0 / 有活跃尝试块可捕捉 / 浮点混合提升三套既有约定),
//       非零才执行原生 sdiv/srem。本用例逐条钉住这些语义,防快路径回归成"快而错"。
// 判定:纯语义断言(不打印耗时,避免 golden 抖动);任一断言失败即 FAIL 并终 1。
设 失败 = 0

// A. 字面量零除数:LLVM 会把 icmp 折叠为真,慢路径成为唯一路径
若 5 % 0 != 0 { 示("FAIL A1 字面量取模零除 得=" & 化(5 % 0)) ; 失败 = 1 }
若 5 / 0 != 0 { 示("FAIL A2 字面量整除零除 得=" & 化(5 / 0)) ; 失败 = 1 }

// B. 变量零除数:走新加的动态分支(除数为零 → 运行时),无尝试块时返 0
设 除数零 = 0
设 被除 = 5
若 被除 % 除数零 != 0 { 示("FAIL B1 变量取模零除 得=" & 化(被除 % 除数零)) ; 失败 = 1 }
若 被除 / 除数零 != 0 { 示("FAIL B2 变量整除零除 得=" & 化(被除 / 除数零)) ; 失败 = 1 }

// C. 变量零除数在有活跃尝试块时可捕捉(消息与既有约定一致)
设 抓住 = 假
尝试 {
    设 _c = 被除 % 除数零
    示("FAIL C1 变量零除后继续执行")
    失败 = 1
} 捕捉 (错误) {
    抓住 = 真
    若 错误["消息"] != "除数不能为零" { 示("FAIL C2 消息=" & 错误["消息"]) ; 失败 = 1 }
}
若 非 抓住 { 示("FAIL C3 变量零除未被捕获") ; 失败 = 1 }

// D. 快路径(非零除数)的算术结果:负数遵循 C 语义(向零截断)
若 7 % 3 != 1 { 示("FAIL D1 7%3=" & 化(7 % 3)) ; 失败 = 1 }
若 -7 % 3 != -1 { 示("FAIL D2 -7%3=" & 化(-7 % 3)) ; 失败 = 1 }
若 7 / -2 != -3 { 示("FAIL D3 7/-2=" & 化(7 / -2)) ; 失败 = 1 }
若 -7 / 2 != -3 { 示("FAIL D4 -7/2=" & 化(-7 / 2)) ; 失败 = 1 }

// E. 浮点混合提升仍走运行时,结果正确
若 (1.5 % 1.0) != 0.5 { 示("FAIL E1 浮点取模 得=" & 化(1.5 % 1.0)) ; 失败 = 1 }
若 (5 % 2.0) != 1.0 { 示("FAIL E2 浮点混合取模 得=" & 化(5 % 2.0)) ; 失败 = 1 }
若 (5.5 / 2) != 2.75 { 示("FAIL E3 浮点混合除 得=" & 化(5.5 / 2)) ; 失败 = 1 }

// F. 循环内快路径的不变式:对被除数与多个除数,商×除数+余数 == 原值
设 甲 = 0
当 甲 < 3000 {
    设 除数表 = [1, 3, 7, 1000]
    设 乙 = 0
    当 乙 < 4 {
        设 d = 除数表[乙]
        设 q = 甲 / d
        设 r = 甲 % d
        若 q * d + r != 甲 {
            示("FAIL F1 不变式破了 甲=" & 化(甲) & " d=" & 化(d) & " q=" & 化(q) & " r=" & 化(r))
            失败 = 1
            断
        }
        乙 = 乙 + 1
    }
    甲 = 甲 + 1
}

// G. 循环内取模的校验和(与 93 同风格:钉住"快而错")
设 和 = 0
设 i = 0
当 i < 1000 {
    和 = 和 + (i % 7)
    i = i + 1
}
若 和 != 2997 { 示("FAIL G1 取模校验和=" & 化(和)) ; 失败 = 1 }

若 失败 == 0 { 示("136 PASS") } 否 { 终 1 }
