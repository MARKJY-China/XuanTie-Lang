// Test/218_字节扩容大缓冲.xt
// #174:字节(0) 扩容 + 跨缓冲逐字节追加,旧实现 capacity=0 时 realloc(0) 后写,必崩。
示("--- 218_字节扩容大缓冲 开始 ---")

设 甲 = 字节(0)
设 i = 0
当 i < 300000 {
    甲.追加(65)
    i = i + 1
}
示("甲长度=#{甲.字节数}")

设 乙 = 字节(0)
i = 0
当 i < 200000 {
    乙.追加(66)
    i = i + 1
}
示("乙长度=#{乙.字节数}")

i = 0
当 i < 乙.字节数 {
    甲.追加(乙.取字节(i))
    i = i + 1
}
示("合并长度=#{甲.字节数}")
示("--- 218_字节扩容大缓冲 结束 ---")
