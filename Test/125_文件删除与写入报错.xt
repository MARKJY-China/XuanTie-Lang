// Test/125_文件删除与写入报错.xt
// 覆盖两处铁律修复:
//   ① 文件.写 不再忽略 fwrite/fflush/fclose 结果——写入失败/路径非法必须报错(旧实现静默报成功);
//   ② 新增 文件.删(路径):带重试的删除,失败必带系统错误码返回错误(旧做法 执("cmd /c del …")
//      有两个坑:路径里的正斜杠会被 cmd 当开关前缀(实测 "Invalid switch"),且失败常被忽略而静默不删)。
// 判定:各用例行为与预期一致且进程干净退出。

示("--- 125_文件删除与写入报错 开始 ---")

// ① 正常写入与读取
设 路径 = "temp/_t125.txt"
设 w = 文件.写(路径, "玄铁删除测试")
若 w.成功 { 示("PASS: 写入成功") } 否 { 示("FAIL: 写入失败 " & w.错误) }
若 文件.存在?(路径) { 示("PASS: 写入后存在") } 否 { 示("FAIL: 写入后不存在") }

// ② 正常删除(带重试路径)
设 d = 文件.删(路径)
若 d.成功 { 示("PASS: 删除成功") } 否 { 示("FAIL: 删除失败 " & d.错误) }
若 非 文件.存在?(路径) { 示("PASS: 删除后不存在") } 否 { 示("FAIL: 删除后仍存在") }

// ③ 删不存在的文件:必须报错(不静默),错误里带尝试次数与系统错误码
设 d2 = 文件.删("temp/_t125_不存在.txt")
若 非 d2.成功 { 示("PASS: 删不存在文件报错 — " & d2.错误) } 否 { 示("FAIL: 删不存在文件竟然成功") }

// ④ 刚写完立即删(此前 执-del 场景的替代路径,重试机制覆盖瞬时占用)
文件.写("temp/_t125b.txt", "x")
设 d3 = 文件.删("temp/_t125b.txt")
若 d3.成功 { 示("PASS: 写后立即删成功") } 否 { 示("FAIL: 写后立即删失败 " & d3.错误) }

// ⑤ 写入非法路径必须报错(旧实现只判 fopen 失败;此处同时验证错误文本非空)
设 w2 = 文件.写("Z:/_不存在的盘_/x.txt", "x")
若 非 w2.成功 且 w2.错误.字节数 > 0 {
    示("PASS: 非法路径写入报错 — " & w2.错误)
} 否 {
    示("FAIL: 非法路径写入未报错")
}

// ⑥ 编译期清理助手改用的多路径删除:连删两个存在的文件
文件.写("temp/_t125c.txt", "x")
文件.写("temp/_t125d.txt", "x")
设 r1 = 文件.删("temp/_t125c.txt")
设 r2 = 文件.删("temp/_t125d.txt")
若 r1.成功 且 r2.成功 且 非 文件.存在?("temp/_t125c.txt") 且 非 文件.存在?("temp/_t125d.txt") {
    示("PASS: 连续多文件删除")
} 否 {
    示("FAIL: 连续多文件删除")
}

示("--- 125_文件删除与写入报错 结束 ---")
