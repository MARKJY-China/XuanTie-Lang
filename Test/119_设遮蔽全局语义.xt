// 119_设遮蔽全局语义:函数内 设 与全局同名时新建遮蔽局部,不穿透写全局(P0 修复)
// 旧行为:函数内 设 X 静默覆写全局 X(模块函数可污染调用方全局,实测致 UI 库闪退)
示("--- 119_设遮蔽全局语义 开始 ---")

设 计分 = 0
设 甲 = 1
设 乙 = "全局乙"

函 遮蔽写() {
    设 甲 = 999
    若 甲 == 999 { 示("PASS: 遮蔽内读局部") } 否 { 示("FAIL: 遮蔽内甲=#{甲}") }
}

函 裸赋值写全局() {
    甲 = 42
}

函 兄弟块() {
    若 真 {
        设 甲 = 100
        若 甲 == 100 { 示("PASS: 块1遮蔽") } 否 { 示("FAIL: 块1甲=#{甲}") }
    }
    若 真 {
        设 甲 = 200
        若 甲 == 200 { 示("PASS: 块2遮蔽") } 否 { 示("FAIL: 块2甲=#{甲}") }
    }
    // 两层弹完后全局恢复可见(此刻全局为裸赋值后的 42)
    若 甲 == 42 { 示("PASS: 弹层恢复全局可见") } 否 { 示("FAIL: 函数尾甲=#{甲}") }
}

函 遮蔽不污染() {
    设 乙 = "局部乙"
    若 乙 == "局部乙" { 示("PASS: 遮蔽写生效") } 否 { 示("FAIL: 遮蔽内乙=#{乙}") }
}

函 他函数仍见全局() {
    若 乙 == "全局乙" { 示("PASS: 他函数见全局") } 否 { 示("FAIL: 他函数乙=#{乙}") }
}

遮蔽写()
若 甲 == 1 { 示("PASS: 遮蔽写不污染全局") ; 计分 = 计分 + 1 } 否 { 示("FAIL: 遮蔽写后全局甲=#{甲}") }
裸赋值写全局()
若 甲 == 42 { 示("PASS: 裸赋值写全局") ; 计分 = 计分 + 1 } 否 { 示("FAIL: 裸赋值后全局甲=#{甲}") }
兄弟块()
遮蔽不污染()
若 乙 == "全局乙" { 示("PASS: 遮蔽写不污染乙") ; 计分 = 计分 + 1 } 否 { 示("FAIL: 全局乙=#{乙}") }
他函数仍见全局()

若 计分 == 3 {
    示("PASS: 119 全组通过")
} 否 {
    示("FAIL: 计分 #{计分}/3")
}
示("--- 119_设遮蔽全局语义 结束 ---")
