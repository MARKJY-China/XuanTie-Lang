// Test 83 — 位运算矩阵(全断言)
示("=== Test 83: 位运算矩阵 ===")
若 (12 位与 10) == 8 { 示("PASS: 位与") } 否 { 示("FAIL: 位与") }
若 (12 位或 10) == 14 { 示("PASS: 位或") } 否 { 示("FAIL: 位或") }
若 (12 异或 10) == 6 { 示("PASS: 异或") } 否 { 示("FAIL: 异或") }
若 (1 左移 4) == 16 { 示("PASS: 左移") } 否 { 示("FAIL: 左移") }
若 (256 右移 4) == 16 { 示("PASS: 右移") } 否 { 示("FAIL: 右移") }
设 _掩码 = 255
若 (_掩码 位与 305419896) == 120 { 示("PASS: 掩码截取") } 否 { 示("FAIL: 掩码截取") }
示("=== Test 83 完成 ===")
