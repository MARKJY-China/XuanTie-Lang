// Test/126_数学常量命名对齐.xt
// 背景:同一语言两套后端各认一套数学常量名——GSC(LLVM/tie 后端,PR#25)用 圆周率/自然常数,
//       XTC 用 PI/E,互相都报"未知标识符"。现以 GSC 命名为准统一(PI/E 保留为兼容别名,
//       examples/数学/数学测试.xt 与 GUIDE/05 模块系统.md 仍在用它们)。
// 附带修复的既有缺陷:裸访问(不带括号)曾走"跨模块变量"分支,emit `load i64, i64* @xt_math_pi`
//       ——把函数代码当数据读,打印出指针样垃圾值(实测 π/e 打印同一个数);现先于符号表查询分流为函数调用。
// 判定:各写法取值正确且进程干净退出。

示("--- 126_数学常量命名对齐 开始 ---")

// ① 统一命名(GSC 口径):裸访问
若 字(数学.圆周率) == "3.14159" { 示("PASS: 裸 数学.圆周率") } 否 { 示("FAIL: 裸 数学.圆周率 值=" & 字(数学.圆周率)) }
若 字(数学.自然常数) == "2.71828" { 示("PASS: 裸 数学.自然常数") } 否 { 示("FAIL: 裸 数学.自然常数 值=" & 字(数学.自然常数)) }

// ② 统一命名:调用形式
若 字(数学.圆周率()) == "3.14159" { 示("PASS: 调用 数学.圆周率()") } 否 { 示("FAIL: 调用 数学.圆周率() 值=" & 字(数学.圆周率())) }

// ③ 参与算术(验证是数值而非指针/垃圾)
设 半圈 = 数学.圆周率
若 字(半圈 * 2.0) == "6.28319" { 示("PASS: 圆周率参与算术") } 否 { 示("FAIL: 圆周率算术 值=" & 字(半圈 * 2.0)) }

// ④ 兼容别名(仓库内 examples 与 GUIDE 仍在用)
若 字(数学.PI) == "3.14159" { 示("PASS: 别名 数学.PI") } 否 { 示("FAIL: 别名 数学.PI 值=" & 字(数学.PI)) }
若 字(数学.E) == "2.71828" { 示("PASS: 别名 数学.E") } 否 { 示("FAIL: 别名 数学.E 值=" & 字(数学.E)) }

// ⑤ 同组其余数学函数抽查(确认对齐未破坏既有符号)
若 字(数学.平方根(16)) == "4" { 示("PASS: 数学.平方根") } 否 { 示("FAIL: 平方根 值=" & 字(数学.平方根(16))) }
若 字(数学.绝对值(-7)) == "7" { 示("PASS: 数学.绝对值") } 否 { 示("FAIL: 绝对值 值=" & 字(数学.绝对值(-7))) }

示("--- 126_数学常量命名对齐 结束 ---")
