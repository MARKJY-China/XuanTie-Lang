// 104_fiber大块收发:fiber 内写 100KB(触发多次部分发送+可写等待),内容逐字节完整
示("--- 104_fiber大块收发 开始 ---")

设 总量 = 100000

听(19304, 函(流) {
    设 全 = ""
    当 全.字节数 < 总量 {
        设 块 = 流.读()
        若 块 == 空 { 断 }
        全 = 全 & 块
    }
    流.写("收齐:" & 全.字节数)
    流.关()
})

设 客 = 异步 {
    设 r = 连("127.0.0.1:19304")
    若 非 r.成功 { 示("FAIL: 连接失败") ; 返 空 }
    设 流 = r.值
    设 大 = ""
    当 大.字节数 < 总量 {
        大 = 大 & "0123456789"
    }
    设 写果 = 流.写(大)
    若 写果 { 示("PASS: 大块写完成") } 否 { 示("FAIL: 大块写失败") }
    设 答 = 流.读()
    若 答 == "收齐:100000" {
        示("PASS: 服务端收齐100000字节")
    } 否 {
        示("FAIL: 应答=#{答}")
    }
    流.关()
}
等待(客)
示("--- 104_fiber大块收发 结束 ---")
