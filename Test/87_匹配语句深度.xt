// Test 87 — 匹配语句深度(全断言)
示("=== Test 87: 匹配语句深度 ===")
函 判(v) {
    匹配 v {
        0 -> { 返 "零" }
        1 -> { 返 "一" }
        _ -> { 返 "其他" }
    }
}
若 判(0) == "零" 且 判(1) == "一" 且 判(9) == "其他" { 示("PASS: 值匹配") } 否 { 示("FAIL: 值匹配") }
函 类判(v) {
    匹配 v {
        是 整 -> { 返 "整数" }
        是 字 -> { 返 "字符串" }
        _ -> { 返 "未知" }
    }
}
若 类判(5) == "整数" 且 类判("s") == "字符串" { 示("PASS: 类型匹配") } 否 { 示("FAIL: 类型匹配") }
设 _嵌 = 0
匹配 3 {
    3 -> {
        匹配 "内" {
            "内" -> { _嵌 = 1 }
            _ -> { _嵌 = 2 }
        }
    }
    _ -> { _嵌 = 3 }
}
若 _嵌 == 1 { 示("PASS: 嵌套匹配") } 否 { 示("FAIL: 嵌套匹配") }
示("=== Test 87 完成 ===")
