// Test/67_无栈状态机全覆盖.xt
// 无栈状态机全愿景标准示例——涵盖多等待、嵌套、通道、选择等全部模式
//
// 状态：此文件为规范/蓝图。标记 "MVP" 的测试当前可编译运行；
//       标记 "P2" 的测试依赖多等待（Phase 3）；
//       标记 "P3" 的测试依赖通道选择（Phase 4）。
//
// 编译（当前仅 MVP 部分可通过）：玄铁.exe tie Test/67_无栈状态机全覆盖.xt

示("=== 67_无栈状态机全覆盖 开始 ===")

// ================================================================
// 第一部分：MVP — 单等待（当前可用）
// ================================================================
示("--- [MVP] 单等待基础 ---")

// [MVP] 异步块内一个等待，且等待为最后语句
设 _mvp_inner = 异步 { 时.睡(100); 示("  MVP内部完成") }
设 _mvp_outer = 异步 {
    示("  MVP外部开始等待")
    等待(_mvp_inner)
}
等待(_mvp_outer)
// 预期输出顺序：
//   MVP外部开始等待
//   MVP内部完成
//   (outer 状态机恢复→DONE→main 继续)
示("PASS: MVP单等待")

// ================================================================
// 第二部分：P2 — 多等待（编译异步 需支持多状态编号）
// ================================================================
示("--- [P2] 多等待 ---")

// [P2] 异步块内两个等待，代码在等待之间和之后继续执行
// 预期输出顺序：步骤1开始 → 任务A完成 → 步骤2开始 → 任务B完成 → 全部步骤完成
设 _p2_任务A = 异步 { 时.睡(100); 示("  任务A完成") }
设 _p2_任务B = 异步 { 时.睡(200); 示("  任务B完成") }

设 _p2_多等待 = 异步 {
    示("  步骤1开始")
    等待(_p2_任务A)
    示("  步骤2开始")
    等待(_p2_任务B)
    示("  全部步骤完成")
}
等待(_p2_多等待)
示("PASS: P2多等待")

// ================================================================
// 第三部分：P2 — 代码在等待后恢复执行
// ================================================================
示("--- [P2] 等待后代码恢复 ---")

// [P2] 等待完成后，状态机从下一状态继续执行后续代码，且 返 值可被 等待 取回
设 _p2_产生数据 = 异步 { 时.睡(100); 示("  数据就绪") }
设 _p2_流水线 = 异步 {
    示("  阶段A: 获取数据")
    等待(_p2_产生数据)
    示("  阶段B: 处理数据 → 结果=42")
    示("  阶段C: 完成")
    返 42
}
设 _p2_流水线结果 = 等待(_p2_流水线)
示("PASS: P2等待后代码恢复，结果=" & _p2_流水线结果)

// ================================================================
// 第四部分：P2 — 嵌套异步（异步内定义异步）
// ================================================================
示("--- [P2] 嵌套异步 ---")

// [P2] 外层状态机等待内层异步任务，内层 返 值可取回
设 _p2_嵌套 = 异步 {
    示("  外层开始")
    设 _inner = 异步 { 时.睡(100); 示("  内层完成"); 返 99 }
    设 _嵌套值 = 等待(_inner)
    示("  外层恢复，内层返=" & _嵌套值)
}
等待(_p2_嵌套)
示("PASS: P2嵌套异步")

// ================================================================
// 第五部分：P2 — 循环中的等待
// ================================================================
示("--- [P2] 循环中等待 ---")

// [P2] 每次迭代等待一个异步任务(循环内挂起 → 整块路由线程池,阻塞语义天然正确)
设 _p2_循环 = 异步 {
    遍历 i 于 [0, 1, 2] {
        示("  迭代 " & i & " 开始")
        设 _lt = 异步 { 时.睡(50) }
        等待(_lt)
        示("  迭代 " & i & " 完成")
     }
}
等待(_p2_循环)
示("PASS: P2循环中等待")

// ================================================================
// 第六部分：P2 — 条件分支中的等待
// ================================================================
示("--- [P2] 条件分支中等待 ---")

// [P2] 不同分支等待不同任务
设 _p2_分支 = 异步 {
    若 真 {
        设 _ta = 异步 { 时.睡(100) }
        等待(_ta)
        示("  真分支完成")
     } 否 {
        设 _tb = 异步 { 时.睡(200) }
        等待(_tb)
        示("  假分支完成")
     }
}
等待(_p2_分支)
示("PASS: P2条件分支中等待")

// ================================================================
// 第七部分：P3 — 通道 + 状态机
// ================================================================
示("--- [P3] 通道+状态机 ---")

// [P3] 状态机通过通道收发消息（阻塞 收 挂起，发 后唤醒恢复）
设 _p3_通道 = 道(10)
设 _p3_消费者 = 异步 {
    示("  消费者: 等待消息...")
    设 _msg = _p3_通道.收()
    示("  消费者: 收到 " & _msg)
}
设 _p3_生产者 = 异步 {
    时.睡(100)
    _p3_通道.发("你好")
    示("  生产者: 发送完成")
}
等待(_p3_生产者)
等待(_p3_消费者)
示("PASS: P3通道+状态机")

// ================================================================
// 第八部分：P3 — 选择（select）多个通道/任务
// ================================================================
示("--- [P3] 选择(select) ---")

// [P3] fiber 内 选(通道数组, 超时) 等待最先就绪的通道
设 _p3_快道 = 道(1)
设 _p3_慢道 = 道(1)
设 _p3_发快 = 异步 { 时.睡(100); _p3_快道.发("快") }
设 _p3_发慢 = 异步 { 时.睡(500); _p3_慢道.发("慢") }
设 _p3_select = 异步 {
    设 _idx = 选([_p3_快道, _p3_慢道], 2000)
    若 _idx == 0 { 示("  选中快的: " & _p3_快道.收()) }
    若 _idx == 1 { 示("  选中慢的: " & _p3_慢道.收()) }
}
等待(_p3_select)
示("PASS: P3选择")

// ================================================================
// 第九部分：P3 — 生产者-消费者流水线
// ================================================================
示("--- [P3] 生产者-消费者流水线 ---")

// [P3] 循环内 发/收(路由线程池,阻塞收发自同步)
设 _p3_队列 = 道(5)

设 _p3_生产 = 异步 {
    遍历 i 于 [0, 1, 2, 3, 4] {
        时.睡(50)
        _p3_队列.发(i)
        示("  生产: " & i)
     }
}

设 _p3_消费 = 异步 {
    遍历 j 于 [0, 1, 2, 3, 4] {
        设 _item = _p3_队列.收()
        示("  消费: " & _item)
     }
}

设 _p3_prod = 异步 { 等待(_p3_生产) }
设 _p3_cons = 异步 { 等待(_p3_消费) }
等待(_p3_prod)
等待(_p3_cons)
示("PASS: P3生产者消费者流水线")

// ================================================================
// 第十部分：P3 — 扇出/扇入（fan-out/fan-in）
// ================================================================
示("--- [P3] 扇出/扇入 ---")

// [P3] 循环内创建任务+循环内等待(路由线程池);不同耗时乱序完成,全部收齐
设 _p3_处理项 = [10, 20, 30, 40, 50]

设 _p3_fanout = 异步 {
    设 _workers = []
    遍历 item 于 _p3_处理项 {
        设 _w = 异步 {
            时.睡(item)
            示("  处理: " & item)
            返 item * 2
        }
        _workers.追加(_w)
    }
    设 _总 = 0
    遍历 _w 于 _workers {
        设 _wr = 等待(_w)
        若 _wr != 空 { _总 = _总 + _wr }
    }
    示("  所有worker完成,结果和=" & _总)
}
等待(_p3_fanout)
示("PASS: P3扇出扇入")

// ================================================================
// 第十一部分：P3 — 超时模式
// ================================================================
示("--- [P3] 超时模式 ---")

// [P3] 选(通道, 超时毫秒) 实现带超时的通道等待：超时返回 -1
设 _p3_超时空道 = 道(1)
设 _p3_慢发 = 异步 { 时.睡(5000); _p3_超时空道.发("太慢") }
设 _p3_超时检查 = 异步 {
    设 _tidx = 选([_p3_超时空道], 1000)
    若 _tidx == -1 { 示("  超时! 等待取消") }
    若 _tidx >= 0 { 示("  收到: " & _p3_超时空道.收()) }
}
等待(_p3_超时检查)
示("PASS: P3超时模式")

// ================================================================
// 第十二部分：P3 — 重试模式
// ================================================================
示("--- [P3] 重试模式 ---")

// [P3] 当循环内等待+结果判定重试(路由线程池)
设 _p3_重试 = 异步 {
    设 _attempt = 0
    设 _成功 = 假
    当 _attempt < 3 且 非 _成功 {
        _attempt = _attempt + 1
        示("  尝试 " & _attempt & "/3")
        设 _rt = 异步 { 时.睡(50); 返 1 }
        设 _rr = 等待(_rt)
        若 _rr == 1 { _成功 = 真 }
    }
    若 _成功 { 示("  重试成功") } 否 { 示("  全部重试失败") }
}
等待(_p3_重试)
示("PASS: P3重试模式")

// ================================================================
// 第十三部分：P3 — 并行块内使用状态机
// ================================================================
示("--- [P3] 并行块+状态机 ---")

// [P3] 并行块中每个分支可以是状态机（含 等待 切分）
设 _p3_并行 = 并行 {
    异步 {
        设 _pa = 异步 { 时.睡(200); 示("  分支1完成") }
        等待(_pa)
    }
    异步 {
        设 _pb = 异步 { 时.睡(100); 示("  分支2完成") }
        等待(_pb)
    }
    异步 {
        时.睡(300)
        示("  分支3完成")
    }
}
等待(_p3_并行)
示("PASS: P3并行块+状态机")

// ================================================================
// 第十四部分：P3 — 全场景压力测试
// ================================================================
示("--- [P3] 全场景压力 ---")

// [P3] 大量状态机任务并发运行，逐个等待完成
设 _p3_任务数 = 50
设 _p3_全部 = []
设 _p3_k = 0
当 _p3_k < _p3_任务数 {
    设 _inner = 异步 { 时.睡(_p3_k % 10) }
    设 _outer = 异步 { 等待(_inner) }
    _p3_全部.追加(_outer)
    _p3_k = _p3_k + 1
}
遍历 _t 于 _p3_全部 { 等待(_t) }
示("PASS: P3全场景压力 " & _p3_任务数 & "个状态机")

示("=== 67_无栈状态机全覆盖 结束 ===")
