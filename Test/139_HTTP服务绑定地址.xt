// Test/139_HTTP服务绑定地址.xt
// 背景:lib/HTTP 的 服务 内部两参调用 听, 而 听 的默认已改绑回环;故 服务 现在仅本机,
// 对外必须走新增的 服务绑定(端口, 处理函, 绑定地址)。同时 服务/服务绑定 改为返回 听 的结果容器
// ——此前 服务 丢弃返回值, 端口被占或地址非法时起不来也没人说。
// 本用例是该库的首条测试(此前零覆盖),钉住:两参服务本机可用、服务绑定可显式对外、非法地址明确失败。
引 "HTTP" 予 HTTP

示("--- 139_HTTP服务绑定地址 开始 ---")
设 失败 = 0

// A. 两参 服务:仅本机,本机请求应通
设 甲 = HTTP.服务(19411, 函(请求) {
    返 {"体": "甲:" & 请求["路径"]}
})
若 非 甲.成功 { 示("FAIL A1 两参服务启动失败: " & 甲.错误) ; 失败 = 1 }
设 求甲 = 求("http://127.0.0.1:19411/甲")
若 非 求甲.成功 { 示("FAIL A2 请求失败: " & 求甲.错误) ; 失败 = 1 } 否 {
    若 求甲.值 == "甲:/甲" { 示("PASS A 两参服务可用(仅本机)") } 否 { 示("FAIL A3 体=" & 化(求甲.值)) ; 失败 = 1 }
}

// B. 服务绑定 显式 "0.0.0.0":对外形态,本机经回环仍应可达
设 乙 = HTTP.服务绑定(19412, 函(请求) {
    返 {"体": "乙:" & 请求["路径"]}
}, "0.0.0.0")
若 非 乙.成功 { 示("FAIL B1 服务绑定启动失败: " & 乙.错误) ; 失败 = 1 }
设 求乙 = 求("http://127.0.0.1:19412/乙")
若 非 求乙.成功 { 示("FAIL B2 请求失败: " & 求乙.错误) ; 失败 = 1 } 否 {
    若 求乙.值 == "乙:/乙" { 示("PASS B 服务绑定 0.0.0.0 可用") } 否 { 示("FAIL B3 体=" & 化(求乙.值)) ; 失败 = 1 }
}

// C. 非法绑定地址:必须返回失败结果(而不是静默起来一个对外服务,也不是丢弃返回值)
设 丙 = HTTP.服务绑定(19413, 函(请求) { 返 {"体": "丙"} }, "300.300.300.300")
若 丙.成功 { 示("FAIL C1 非法地址竟然启动成功(静默回退?)") ; 失败 = 1 } 否 {
    若 丙.错误 == "" { 示("FAIL C2 失败但错误消息为空") ; 失败 = 1 } 否 { 示("PASS C 非法地址明确失败: " & 丙.错误) }
}

若 失败 == 0 { 示("139 PASS") } 否 { 终 1 }
示("--- 139_HTTP服务绑定地址 结束 ---")
