// 120_遍历遮蔽全局语义:遍历变量/索引变量遇同名全局时新建遮蔽局部,不穿透写全局(P0 延伸)
// 旧行为:遍历 X 遇全局 X 直接复用全局槽位,循环会穿透写全局(与 设 的旧穿透同类)
示("--- 120_遍历遮蔽全局语义 开始 ---")

设 计分 = 0
设 甲 = 1
设 乙 = "全局乙"

函 循环遮蔽() {
    遍历 甲 于 [10, 20, 30] {
        // 甲 为遮蔽局部,循环体写入不影响全局
    }
    // 循环后同层:甲 读遮蔽局部(末值 30),全局在函数尾弹层后恢复
    若 甲 == 30 { 示("PASS: 循环变量遮蔽") ; 计分 = 计分 + 1 } 否 { 示("FAIL: 循环后甲=#{甲}") }
}

函 索引遮蔽() {
    设 末索引 = -1
    遍历 值, 乙 于 [7, 8, 9] {
        末索引 = 乙
    }
    若 乙 == 2 且 末索引 == 2 { 示("PASS: 索引变量遮蔽") ; 计分 = 计分 + 1 } 否 { 示("FAIL: 索引乙=#{乙} 末=#{末索引}") }
}

函 他函数见全局() {
    若 甲 == 1 且 乙 == "全局乙" { 示("PASS: 他函数见全局") ; 计分 = 计分 + 1 } 否 { 示("FAIL: 他函数甲=#{甲} 乙=#{乙}") }
}

循环遮蔽()
索引遮蔽()
他函数见全局()

若 甲 == 1 { 示("PASS: 循环不污染全局甲") ; 计分 = 计分 + 1 } 否 { 示("FAIL: 全局甲=#{甲}") }
若 乙 == "全局乙" { 示("PASS: 索引不污染全局乙") ; 计分 = 计分 + 1 } 否 { 示("FAIL: 全局乙=#{乙}") }

若 计分 == 5 {
    示("PASS: 120 全组通过")
} 否 {
    示("FAIL: 计分 #{计分}/5")
}
示("--- 120_遍历遮蔽全局语义 结束 ---")
