// Test/203_JSON契约浮点反序列化.xt
// issue #145 v1 契约:JSON 小数 token(含 . / e / E)用 strtod 保真,不再 atoll 截断;
// 纯整数 token 仍走 i64 精确解析(大整数不转 double)。
设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

// 1. 基础小数
断言("解3.14", 解("3.14") == 3.14)
断言("解3.14是小数", 解("3.14") 是 小数)
断言("解0.1", 解("0.1") == 0.1)
断言("解0.1是小数", 解("0.1") 是 小数)
断言("解-1.5", 解("-1.5") == -1.5)

// 2. 科学计数法
断言("解1e3", 解("1e3") == 1000.0)
断言("解1e3是小数", 解("1e3") 是 小数)
断言("解2e6", 解("2e6") == 2000000.0)
断言("解2e6是小数", 解("2e6") 是 小数)
断言("解负指数", 解("2.5e-2") == 0.025)
断言("解大写E", 解("-1.5E2") == -150.0)

// 3. 大整数保真(2^53+1;若被转 double 会变 9007199254740992)
断言("解大整数", 解("9007199254740993") == 9007199254740993)
断言("解大整数是整", 解("9007199254740993") 是 整)
断言("大整数非double", 化(解("9007199254740993")) == "9007199254740993")

// 4. 嵌套数组/字典
设 嵌 = 解("[1.5, {\"k\": 2.25}, 3e2]")
断言("嵌套数组浮点", 嵌[0] == 1.5)
断言("嵌套字典浮点", 嵌[1]["k"] == 2.25)
断言("嵌套科学计数", 嵌[2] == 300.0)
断言("嵌套类型", (嵌[0] 是 小数) 且 (嵌[2] 是 小数))

// 5. 解→化 闭环(输出格式见 202)
断言("闭环3.14", 化(解("3.14")) == "3.14")
断言("闭环0.1", 化(解("0.1")) == "0.1")
断言("闭环1e3", 化(解("1e3")) == "1000.0")
断言("闭环2e6", 化(解("2e6")) == "2000000.0")
断言("闭环混合数组", 化(解("[1, 2.5]")) == "[1, 2.5]")

若 失败数 == 0 { 示("203 PASS") } 否 { 示("203 失败数: " & 失败数) ; 终 1 }
