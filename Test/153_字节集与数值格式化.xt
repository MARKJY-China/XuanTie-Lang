// Test/153_字节集与数值格式化.xt
// 批次三:字节集扩展(到字节集/截取/寻找/倒找/替换/取字节/写字节/到十六进制/分割/长度)
// 与数值格式化(到十六进制/到八进制/千分位/到大写金额)。
设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

// ---- 字节集 ----
设 _b = 到字节集("玄铁AB")
断言("到字节集长度", _b.长度 == 8)
断言("截取", 字节到字符串(_b.截取(6, 8)) == "AB")
断言("截取到尾", 字节到字符串(_b.截取(6)) == "AB")
断言("截取中文", 字节到字符串(_b.截取(0, 6)) == "玄铁")
断言("寻找", _b.寻找(到字节集("AB")) == 6)
设 _b找 = 到字节集("aXbXc")
断言("寻找起始", _b找.寻找(到字节集("X"), 2) == 3)
断言("寻找到尾外", _b.寻找(到字节集("A"), 7) == -1)
断言("寻找不到", _b.寻找(到字节集("ZZ")) == -1)
设 _b2 = 到字节集("aXbXc")
断言("倒找", _b2.倒找(到字节集("X")) == 3)
断言("倒找不到", _b2.倒找(到字节集("Z")) == -1)
断言("替换", 字节到字符串(_b.替换(到字节集("AB"), 到字节集("XY"))) == "玄铁XY")
断言("取字节", _b.取字节(0) == 231)
断言("取字节越界", _b.取字节(99) == -1)
设 _w = 到字节集("AB")
断言("写字节", _w.写字节(0, 90))
断言("写字节生效", _w.取字节(0) == 90)
断言("写字节越界", 非 _w.写字节(9, 1))
断言("到十六进制", _b.到十六进制() == "E78E84E993814142")
断言("到十六进制空", 到字节集("").到十六进制() == "")
设 _sp = 到字节集("a,b,,c").分割(44)
断言("分割段数", _sp.长度 == 4)
断言("分割保留空段", 字节到字符串(_sp[2]) == "")
断言("分割内容", 字节到字符串(_sp[0]) == "a" 且 字节到字符串(_sp[3]) == "c")
// 双类型共存:字符串同名方法不受影响
断言("字符串截取依旧", "玄铁XuanTie".截取(2, 6) == "Xuan")
断言("字符串寻找依旧", "你好玄铁".寻找("玄铁") == 2)
断言("字符串替换依旧", "a-b".替换("-", "+") == "a+b")
断言("字符串分割依旧", "a,b".分割(",").长度 == 2)

// ---- 数值格式化 ----
断言("到十六进制", 数学.到十六进制(255) == "FF")
断言("到十六进制负", 数学.到十六进制(-255) == "-FF")
断言("到十六进制零", 数学.到十六进制(0) == "0")
断言("到八进制", 数学.到八进制(8) == "10")
断言("到八进制负", 数学.到八进制(-8) == "-10")
断言("千分位整", 数学.千分位(1234567, 0) == "1,234,567")
断言("千分位小数", 数学.千分位(1234.5, 2) == "1,234.50")
断言("千分位负", 数学.千分位(-1234567.891, 2) == "-1,234,567.89")
断言("千分位舍入", 数学.千分位(0.999, 2) == "1.00")
断言("大写整数", 数学.到大写金额(12345) == "壹万贰仟叁佰肆拾伍元整")
断言("大写万内零", 数学.到大写金额(10020030) == "壹仟零贰万零叁拾元整")
断言("大写跨级零", 数学.到大写金额(100001000) == "壹亿零壹仟元整")
断言("大写零分补零", 数学.到大写金额(1.05) == "壹元零伍分")
断言("大写纯分", 数学.到大写金额(0.05) == "零元伍分")
断言("大写纯角", 数学.到大写金额(0.5) == "零元伍角")
断言("大写角分", 数学.到大写金额(1.55) == "壹元伍角伍分")
断言("大写零", 数学.到大写金额(0) == "零元整")
断言("大写负", 数学.到大写金额(-12.5) == "负壹拾贰元伍角")
断言("大写进位", 数学.到大写金额(0.999) == "壹元整")
断言("大写拾", 数学.到大写金额(10) == "壹拾元整")

若 失败数 == 0 { 示("批次三 全绿") } 否 { 示("批次三 失败数: " & 失败数) }
