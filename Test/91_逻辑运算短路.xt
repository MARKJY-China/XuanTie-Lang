// Test 91 — 逻辑运算短路(全断言)
示("=== Test 91: 逻辑运算短路 ===")
设 副作用 = 0
函 标记(v) {
    副作用 = 副作用 + 1
    返 v
}
设 _r1 = 假 且 标记(真)
若 副作用 == 0 { 示("PASS: 且短路") } 否 { 示("FAIL: 且短路 副作用=" & 副作用) }
设 _r2 = 真 或 标记(真)
若 副作用 == 0 { 示("PASS: 或短路") } 否 { 示("FAIL: 或短路 副作用=" & 副作用) }
设 _r3 = 真 且 标记(真)
若 副作用 == 1 { 示("PASS: 且继续") } 否 { 示("FAIL: 且继续") }
设 _r4 = 假 或 标记(假)
若 副作用 == 2 { 示("PASS: 或继续") } 否 { 示("FAIL: 或继续") }
若 _r1 == 假 且 _r2 == 真 且 _r3 == 真 且 _r4 == 假 { 示("PASS: 短路结果值") } 否 { 示("FAIL: 短路结果值") }
示("=== Test 91 完成 ===")
