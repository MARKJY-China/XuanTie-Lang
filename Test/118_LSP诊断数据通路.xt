// 118_LSP诊断数据通路:LSP 服务器依赖的「纯分析」路径——
// 词法/语法分析模块独立可用、结构化诊断(错误结构列表/警告结构列表)行列正确。
// 同时覆盖两枚曾发编译器 Bug 的回归:型实例 !=空 双重释放、!= 双重否定。
引 "../xuantie_compiler/词法.xt"
引 "../xuantie_compiler/语法分析.xt"

示("--- 118_LSP诊断数据通路 开始 ---")

// 1. 坏代码产出结构化错误
设 词法 = 造 词法分析器("示(\"你好\"\n设 x = 1\n")
设 解析 = 造 语法分析器(词法)
设 _树 = 解析.解析程序()
若 解析.错误结构列表.长度 > 0 {
    设 首 = 解析.错误结构列表[0]
    若 首["行"] == 2 且 首["列"] >= 1 且 首["消息"].包含?("右圆括号") {
        示("PASS: 结构化错误行列正确")
    } 否 {
        设 _行 = 首["行"]
        设 _列 = 首["列"]
        示("FAIL: 行=#{_行} 列=#{_列}")
    }
} 否 {
    示("FAIL: 坏代码无错误记录")
}

// 2. 好代码零错误
设 词法2 = 造 词法分析器("设 x = 1\n示(x)\n")
设 解析2 = 造 语法分析器(词法2)
设 _树2 = 解析2.解析程序()
若 解析2.错误结构列表.长度 == 0 {
    示("PASS: 好代码零错误")
} 否 {
    示("FAIL: 好代码误报 #{解析2.错误结构列表.长度} 条")
}

// 3. 回归:型实例 ==空/!=空 判定(双重释放+双重否定曾致崩/结果反转)
设 t = 造 标记("等于", "=", 1, 1)
设 判空 = (t == 空)
设 判非空 = (t != 空)
若 判空 == 假 且 判非空 == 真 {
    示("PASS: 实例空判定正确")
} 否 {
    示("FAIL: ==空=#{判空} !=空=#{判非空}")
}

// 4. 回归:裸函数名作值入容器(曾存裸代码地址致崩)
函 哑(v) { 返 v }
设 函盒 = {"回调": 哑}
设 调 = 函盒["回调"](7)
若 调 == 7 {
    示("PASS: 函数字典值可调")
} 否 {
    示("FAIL: 函数字典值调用失败")
}

示("--- 118_LSP诊断数据通路 结束 ---")
