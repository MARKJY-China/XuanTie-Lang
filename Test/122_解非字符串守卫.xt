// Test/122_解非字符串守卫.xt
// 验证 解() 对非字符串输入的显式报错守卫(自执行双子进程模式,经命令行参数区分身份):
//   父进程以 --child 重启自身;子进程即以 结果容器(文件.读 的返回值)喂 解,
//   预期:子进程 exit 1 + stderr 提示「解 只接受字符串」(旧缺陷:直接段错误 0xC0000005,捕捉 无法兜住)。
//   父进程断言子进程退出码与提示内容;另验正路径(合法 JSON 基础类型)不受守卫影响。
// 注:解 为简化实现,仅支持字符串/数字/布尔/空,不支持 {} 与 []。
// 设计纪律:身份判定用**命令行参数**(无状态、无残留);历史上用标记文件做握手,一次中断留下的
//          残留文件会让后续运行全部误判为子进程(本地据此录出错基线,CI 才暴露),故弃用。

外 函 xt_get_args(): 数组
外 函 xt_self_path(): 字

示("--- 122_解非字符串守卫 开始 ---")

设 参 = xt_get_args()
设 是子进程 = 假
遍历 _a 于 参 {
    若 字(_a) == "--child" { 是子进程 = 真 }
}

若 是子进程 {
    // ---- 子进程身份:触发守卫(exit(1),不会走任何清理路径) ----
    示("[子] 即将触发守卫")
    设 r = 文件.读("temp/_不存在的文件_守卫.json")
    设 坏 = 解(r)
    示("[子] FAIL: 守卫未触发 坏=" & 字(坏))
    终 0
}

// ---- 父进程身份 ----
设 e = 执("\"" & xt_self_path() & "\" --child")
若 e.成功 {
    示("FAIL: 子进程异常退出码 0(守卫应 exit 1)")
} 否 {
    若 e.错误.包含?("退出码: 1") 且 e.错误.包含?("解 只接受字符串") {
        示("PASS: 守卫触发(子进程退出码 1 + 提示)")
    } 否 {
        示("FAIL: 子进程错误信息不含预期内容: " & e.错误)
    }
}

// 正路径:合法输入不受守卫影响
设 n = 解("42")
若 n == 42 { 示("PASS: 解合法数字正常") } 否 { 示("FAIL: 解合法数字异常") }
设 s = 解("\"玄铁\"")
若 s == "玄铁" { 示("PASS: 解合法字符串正常") } 否 { 示("FAIL: 解合法字符串异常") }

示("--- 122_解非字符串守卫 结束 ---")
