// Test/137_听绑定地址.xt
// 背景:旧实现 听 一律绑 INADDR_ANY,且没有绑定地址参数——服务在开发机上随手一跑就对整个
// 局域网开门,而默认值不可见、没人会去审计。现改为:2 参形态绑回环 127.0.0.1,
// 3 参形态 听(端口, 处理函, 绑定地址) 显式指定,对外必须写 "0.0.0.0"。
// 本用例钉住四种情形:默认回环可用、显式回环可用、显式对外可用、非法地址明确失败(不崩不静默)。
示("--- 137_听绑定地址 开始 ---")
设 失败 = 0

函 起服务(端口: 整, 址: 字): 结果 {
    返 听(端口, 函(流) {
        设 数据 = 流.读()
        若 数据 != 空 { 流.写("回:" & 数据) }
        流.关()
    }, 址)
}

// A. 两参形态:默认绑回环,本机连得上
设 甲 = 听(19401, 函(流) {
    设 数据 = 流.读()
    若 数据 != 空 { 流.写("A:" & 数据) }
    流.关()
})
若 非 甲.成功 { 示("FAIL A1 默认监听失败: " & 甲.错误) ; 失败 = 1 }
设 连甲 = 连("127.0.0.1:19401")
若 非 连甲.成功 { 示("FAIL A2 默认回环连不上: " & 连甲.错误) ; 失败 = 1 } 否 {
    设 流 = 连甲.值
    设 _ = 流.写("甲")
    设 收 = 流.读()
    若 收 == "A:甲" { 示("PASS A 默认绑回环可用") } 否 { 示("FAIL A3 回显=" & 化(收)) ; 失败 = 1 }
    流.关()
}

// B. 三参形态:显式 "127.0.0.1"
设 乙 = 起服务(19402, "127.0.0.1")
若 非 乙.成功 { 示("FAIL B1 显式回环监听失败: " & 乙.错误) ; 失败 = 1 }
设 连乙 = 连("127.0.0.1:19402")
若 非 连乙.成功 { 示("FAIL B2 显式回环连不上: " & 连乙.错误) ; 失败 = 1 } 否 {
    设 流 = 连乙.值
    设 _ = 流.写("乙")
    设 收 = 流.读()
    若 收 == "回:乙" { 示("PASS B 显式回环可用") } 否 { 示("FAIL B3 回显=" & 化(收)) ; 失败 = 1 }
    流.关()
}

// C. 三参形态:显式 "0.0.0.0"(对外监听)。本机经回环仍应可达——证明显式对外是通的
设 丙 = 起服务(19403, "0.0.0.0")
若 非 丙.成功 { 示("FAIL C1 对外监听失败: " & 丙.错误) ; 失败 = 1 }
设 连丙 = 连("127.0.0.1:19403")
若 非 连丙.成功 { 示("FAIL C2 对外监听本机连不上: " & 连丙.错误) ; 失败 = 1 } 否 {
    设 流 = 连丙.值
    设 _ = 流.写("丙")
    设 收 = 流.读()
    若 收 == "回:丙" { 示("PASS C 显式 0.0.0.0 可用") } 否 { 示("FAIL C3 回显=" & 化(收)) ; 失败 = 1 }
    流.关()
}

// D. 非法绑定地址:必须返回失败结果,不得崩溃、不得静默回退成对外
设 丁 = 起服务(19404, "300.300.300.300")
若 丁.成功 { 示("FAIL D1 非法地址竟然监听成功(静默回退?)") ; 失败 = 1 } 否 {
    若 丁.错误 == "" { 示("FAIL D2 失败但错误消息为空") ; 失败 = 1 }
    否 { 示("PASS D 非法地址明确失败: " & 丁.错误) }
}

// E. 非字符串绑定地址:同样必须明确失败(不静默回退)
设 戊 = 起服务(19405, 12345)
若 戊.成功 { 示("FAIL E1 非字符串地址竟然监听成功") ; 失败 = 1 } 否 {
    示("PASS E 非字符串地址明确失败")
}

若 失败 == 0 { 示("137 PASS") } 否 { 终 1 }
示("--- 137_听绑定地址 结束 ---")
