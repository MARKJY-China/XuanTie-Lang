// Test/97_UI库帧循环.xt
// UI库编译链路(菱形引入:应用引UI+渲染,UI又引渲染)+手动帧循环20帧自动关窗
// 覆盖:造状态/列/文本/按钮/态取/态设/刷新 全链;点击回调代码路径编译覆盖(无人点击不触发)
引 "UI" 予 UI
引 "渲染" 予 R

设 状态 = UI.造状态({"计数": 0})
R.初始化窗口(400, 300, "97测试")
设 帧 = 0
当 非 R.窗口应关闭?() {
    R.开始绘图()
    UI.刷新(状态, 函(s) {
        返 UI.列([
            UI.文本("UI帧循环测试", {"字号": 24}),
            UI.文本("静态第二行", {"字号": 16}),
            UI.按钮("点我 +1", {"点击": 函() {
                UI.态设(s, "计数", UI.态取(s, "计数") + 1)
            }})
        ], {"内边距": UI.全边(16), "间距": 8})
    }, 0, 0, 400, 300)
    R.结束绘图()
    帧 = 帧 + 1
    若 帧 >= 20 { 断 }
}
R.关闭窗口()
若 帧 != 20 {
    示("FAIL: 帧数不符 " & 帧)
    终 1
}
若 UI.态取(状态, "计数") != 0 {
    示("FAIL: 无人点击计数应仍0")
    终 1
}
示("97 PASS")
