// Test/144_未知标识符提示文案.xt
// 断言编译器对未知标识符给出的相近关键字提示(issue #46)。
// 为什么单独一条:141/142/143 三个样例是"期望编译失败"用例,基线里只有 compile_ok=False,
// **钉不住提示文案** —— 把提示删掉它们照样通过。本用例由自己调用链顶编译器、检查输出文本,
// 才真正锁定这个功能。同类先例:Test/29、Test/79、Test/118 都是诊断类用例。
//
// 依赖约定:runner 以项目根为 CWD 运行用例,故以下用相对路径;编译器路径取链顶产物
// (CI 与本地都是 build/xtc_s4.exe)。本用例只在 Windows 回归里跑(CI 回归本身仅 Windows)。
设 失败 = 0

// 执 在命令失败时把输出放进 .错误,成功时放进 .值 —— 两边都取
函 命令输出(命令行) {
    设 果 = 执(命令行)
    若 果.成功 { 返 果.值 }
    返 果.错误
}

// A. 语句位置 否则 → 提示『否』
// 注意路径用反斜杠:执 走 cmd,而 cmd 会把正斜杠当参数分隔符 → "build/xtc_s4.exe" 被当成
// 运行 "build" + 参数 "/xtc_s4.exe"(实测退出码 9009)。项目里 文件.删 当年踩过同一个坑。
设 甲 = 命令输出("build\\xtc_s4.exe 铁 \"Test\\141_未知标识符提示相近关键字.xt\" -sc \"temp\\hint141.exe\"")
若 甲.包含?("是否想用『否』") {
    示("PASS A 否则 → 提示『否』")
} 否 {
    示("FAIL A 未给出预期提示,输出=" & 甲)
    失败 = 1
}

// B. 反向匹配:名字比关键字短(等 → 等待)
设 乙 = 命令输出("build\\xtc_s4.exe 铁 \"Test\\142_未知标识符反向匹配提示.xt\" -sc \"temp\\hint142.exe\"")
若 乙.包含?("是否想用『等待』") {
    示("PASS B 等 → 提示『等待』(反向匹配)")
} 否 {
    示("FAIL B 未给出预期提示,输出=" & 乙)
    失败 = 1
}

// C. 防误伤:长名字含单字关键字(是否为空)不得被提示
设 丙 = 命令输出("build\\xtc_s4.exe 铁 \"Test\\143_未知标识符提示防误伤.xt\" -sc \"temp\\hint143.exe\"")
若 丙.包含?("是否想用") {
    示("FAIL C1 长名字被误提示,输出=" & 丙)
    失败 = 1
} 否 {
    若 丙.包含?("未知标识符") { 示("PASS C 长名字不提示(守卫生效)") } 否 { 示("FAIL C2 报错缺失,输出=" & 丙) ; 失败 = 1 }
}

// D. 关键字当变量名 → 定向提示(与 A/B/C 同源:都是 AI 代写时最常见的语法误用)
设 丁 = 命令输出("build\\xtc_s4.exe 铁 \"Test\\145_关键字作变量名.xt\" -sc \"temp\\hint145.exe\"")
若 丁.包含?("是玄铁语言的关键字") {
    示("PASS D 关键字作变量名 → 定向提示")
} 否 {
    示("FAIL D 未给出定向提示,输出=" & 丁)
    失败 = 1
}

若 失败 == 0 { 示("144 PASS") } 否 { 终 1 }
