// Test 86 — 解构赋值(全断言)
示("=== Test 86: 解构赋值 ===")
设 [a, b, c] = [1, 2, 3]
若 a == 1 且 b == 2 且 c == 3 { 示("PASS: 数组解构") } 否 { 示("FAIL: 数组解构") }
设 [x, ...余] = [10, 20, 30, 40]
若 x == 10 且 余.长度 == 3 { 示("PASS: 剩余解构") } 否 { 示("FAIL: 剩余解构") }
设 {名, 值} = {"名": "玄铁", "值": 100}
若 名 == "玄铁" 且 值 == 100 { 示("PASS: 字典解构") } 否 { 示("FAIL: 字典解构") }
设 [p, q] = [5, 6]
设 和 = p + q
若 和 == 11 { 示("PASS: 解构后运算") } 否 { 示("FAIL: 解构后运算") }
示("=== Test 86 完成 ===")
