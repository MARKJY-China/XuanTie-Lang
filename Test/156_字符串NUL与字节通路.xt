// Test/156_字符串NUL与字节通路.xt
// issue #80:内嵌 NUL 的字符串,字符索引层(字符数/截取/寻找/倒找)按长度工作不再截断;
// 字节索引层(字节集 API)是二进制解析的可靠通路,两层语义一致(同一位置同一数值)。
设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

// 构造 "ab\0cd"(经字节集写字节,字节到字符串 严格 UTF-8 校验可通过:0x00 是合法单字节)
设 b = 到字节集("ab")
b.追加(0)
b.追加(99)
b.追加(100)
设 s = 字节到字符串(b)

// ---- 字符索引层 NUL 安全(issue #80 修复点) ----
断言("字节数按长度", s.字节数 == 5)
断言("字符数不截断", s.字符数 == 5)
断言("截取不截断", 到字节集(s.截取(0, 5)).到十六进制() == "6162006364")
断言("截取跨NUL中段", 到字节集(s.截取(2, 4)).到十六进制() == "0063")
断言("寻找跨NUL", s.寻找("c") == 3)
断言("倒找跨NUL", s.倒找("c") == 3)
断言("倒找NUL自身", s.倒找("a") == 0)
断言("寻找NUL后内容", s.寻找("d") == 4)

// ---- 字节索引层(二进制可靠通路,与字符层一致) ----
设 bs = 到字节集(s)
断言("字节集长度", bs.长度 == 5)
断言("字节集寻找一致", bs.寻找(到字节集("c")) == 3)
断言("字节集截取一致", bs.截取(2, 4).到十六进制() == "0063")
断言("字节集取字节", bs.取字节(2) == 0)

// ---- 常规串无回归 ----
设 n = "玄铁XuanTie"
断言("常规字符数", n.字符数 == 9)
断言("常规截取", n.截取(2, 6) == "Xuan")
断言("常规寻找", n.寻找("Tie") == 6)
断言("常规倒找", "aXbXc".倒找("X") == 3)
断言("空子串寻找", "abc".寻找("") == 0)

若 失败数 == 0 { 示("156 全绿") } 否 { 示("156 失败数: " & 失败数) }
