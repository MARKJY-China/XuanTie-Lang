// Test/155_SQLite数据库.xt
// 批次五:SQLite 支持库(铁铺包;[原生] 对象链接机制首航)。
// 内存库(:memory:)全程确定性:建表/带参写入/查询/类型映射/事务/回滚/错误路径/关闭。
引 "SQLite" 予 数据库

设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

// ---- 打开与建表 ----
设 开 = 数据库.打开(":memory:")
断言("打开内存库", 开.成功)
设 库 = 开.值
设 建 = 数据库.执行(库, "CREATE TABLE 用户 (id INTEGER PRIMARY KEY, 名 TEXT, 分 REAL, 备注 BLOB)")
断言("建表", 建.成功)

// ---- 带参写入(类型:整/字/小数/字节/空) ----
设 _备 = 到字节集("AB")
设 插1 = 数据库.执行带参(库, "INSERT INTO 用户 (名, 分, 备注) VALUES (?, ?, ?)", ["玄铁", 98.5, _备])
断言("带参写入1", 插1.成功 且 插1.值 == 1)
设 插2 = 数据库.执行带参(库, "INSERT INTO 用户 (名, 分, 备注) VALUES (?, ?, ?)", ["问号盒", 60, 空])
断言("带参写入2空值", 插2.成功 且 插2.值 == 1)
设 插3 = 数据库.执行带参(库, "INSERT INTO 用户 (名, 分, 备注) VALUES (?, ?, ?)", ["布尔控", 88, 真])
断言("带参写入3布尔", 插3.成功)

// ---- 查询与类型映射 ----
设 查 = 数据库.查询(库, "SELECT id, 名, 分, 备注 FROM 用户 ORDER BY id")
断言("查询成功", 查.成功)
断言("查询行数", 查.值.长度 == 3)
设 行1 = 查.值[0]
断言("行1整数列", 行1["id"] == 1)
断言("行1文本列", 行1["名"] == "玄铁")
断言("行1浮点列", 行1["分"] > 98.4 且 行1["分"] < 98.6)
断言("行1字节列", 行1["备注"].到十六进制() == "4142")
设 行2 = 查.值[1]
断言("行2空列", 行2["备注"] == 空)

// ---- 带参查询 ----
设 查2 = 数据库.查询带参(库, "SELECT 名 FROM 用户 WHERE 分 > ? ORDER BY 分", [90])
断言("带参查询行数", 查2.成功 且 查2.值.长度 == 1)
断言("带参查询内容", 查2.值[0]["名"] == "玄铁")

// ---- 聚合与更新 ----
设 查3 = 数据库.查询(库, "SELECT COUNT(*) AS 总数, SUM(分) AS 总分 FROM 用户")
断言("聚合计数", 查3.值[0]["总数"] == 3)
设 改 = 数据库.执行带参(库, "UPDATE 用户 SET 分 = ? WHERE 名 = ?", [100, "问号盒"])
断言("更新影响行数", 改.成功 且 改.值 == 1)
设 查4 = 数据库.查询带参(库, "SELECT 分 FROM 用户 WHERE 名 = ?", ["问号盒"])
断言("更新生效", 查4.值[0]["分"] == 100)

// ---- 事务提交 ----
设 库2开 = 数据库.打开(":memory:")
设 库2 = 库2开.值
数据库.执行(库2, "CREATE TABLE t (v INTEGER)")
断言("开始事务", 数据库.开始事务(库2).成功)
数据库.执行(库2, "INSERT INTO t VALUES (1)")
断言("提交事务", 数据库.提交事务(库2).成功)
断言("事务提交可见", 数据库.查询(库2, "SELECT COUNT(*) AS n FROM t").值[0]["n"] == 1)

// ---- 事务回滚 ----
断言("开始事务2", 数据库.开始事务(库2).成功)
数据库.执行(库2, "INSERT INTO t VALUES (2)")
断言("回滚事务", 数据库.回滚事务(库2).成功)
断言("回滚不可见", 数据库.查询(库2, "SELECT COUNT(*) AS n FROM t").值[0]["n"] == 1)

// ---- 错误路径(结果容器,不炸程序) ----
设 坏 = 数据库.执行(库, "SELEC 1")
断言("语法错误容器", 非 坏.成功)
断言("错误消息非空", 数据库.错误消息(库).长度 > 0)
断言("坏句柄执行", 非 数据库.执行带参(库, "INSERT INTO 用户 (名) VALUES (?)", ["x", "y"]).成功)

// ---- 关闭 ----
断言("关闭", 数据库.关闭(库).成功)
断言("关闭幂等", 数据库.关闭(库).成功)
断言("关后用失效", 非 数据库.查询(库, "SELECT 1").成功)
数据库.关闭(库2)

// ---- GC 自动关闭(不显式关闭,依赖 ARC 回收) ----
设 库3 = 数据库.打开(":memory:").值
断言("GC句柄可用", 数据库.执行(库3, "CREATE TABLE g (v INTEGER)").成功)

若 失败数 == 0 { 示("批次五 全绿") } 否 { 示("批次五 失败数: " & 失败数) }
