// Test/181_库内造类与字段函数.xt
// 编译器缺陷回归：
//   ① 被别名引入的库内，类方法/工厂函数实例化本模块的型（此前报「未定义的型」）；
//   ② 类字段里存放的函数被调用时，不得把接收者塞成第一个实参（此前 函(a,b) 收到 (接收者, a)）。
引 "./_mod_库内造类.xt" 予 辅助

设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

// ① 库内实例化
断言("库内类方法造另一类", 辅助.建乙().取() == 1)
断言("库内工厂造类", 辅助.建甲(7).取() == 7)
断言("库外造库内类", (造 辅助.甲(9)).取() == 9)

// ② 类字段函数调用：二参应原样到达
型 持函 {
    设 比较

    函 造(比较函) { 此.比较 = 比较函 }

    函 调字面量() { 返 此.比较(4, 6) }

    函 调变量() {
        设 x = 10
        设 y = 3
        返 此.比较(x, y)
    }
}

设 持有 = 造 持函(函(a, b) { 返 a - b })
断言("字段函数字面量实参", 持有.调字面量() == -2)
断言("字段函数变量实参", 持有.调变量() == 7)

// ③ 字段函数经局部变量中转（两种写法结果必须一致）
型 转调器 {
    设 变换

    函 造(变换函) { 此.变换 = 变换函 }

    函 直调() { 返 此.变换(21) }

    函 中转() {
        设 f = 此.变换
        返 f(21)
    }
}
设 转调 = 造 转调器(函(n) { 返 n * 2 })
断言("字段函数直调", 转调.直调() == 42)
断言("字段函数中转", 转调.中转() == 42)

若 失败数 == 0 { 示("缺陷回归 全绿") } 否 { 示("缺陷回归 失败数: " & 字(失败数)) }
