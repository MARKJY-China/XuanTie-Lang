// Test/103_浮点算术.xt
// 浮点 + - * / % 与整/浮混合提升的正确性回归。
// 背景:XTC 浮点算术曾先天未实现——中缀运算落原始 i64 指令路径,对装箱浮点指针做
// 指针算术产出垃圾值(git 全历史无 fmul;0.17.2 旧版同症)。
// 修复:非全 raw_i64 的算术中缀改走运行时数值分派(xt_sub/mul/div/mod 内含浮点分派)。
// 注:所选值均可二进制精确表示,故可用 == 判等。
设 失败 = 0

// A. 纯浮点四则
若 0.5 + 0.25 != 0.75 { 示("FAIL A1 加") ; 失败 = 1 }
若 1.5 - 0.25 != 1.25 { 示("FAIL A2 减") ; 失败 = 1 }
若 0.5 * 0.5 != 0.25 { 示("FAIL A3 乘") ; 失败 = 1 }
若 2.0 * 0.5 != 1.0 { 示("FAIL A4 乘整值") ; 失败 = 1 }
若 1.0 / 4.0 != 0.25 { 示("FAIL A5 除") ; 失败 = 1 }
若 10.0 / 4.0 != 2.5 { 示("FAIL A6 除") ; 失败 = 1 }

// B. 整/浮混合提升(结果应为浮点)
若 2 * 0.5 != 1.0 { 示("FAIL B1 整乘浮") ; 失败 = 1 }
若 0.5 * 2 != 1.0 { 示("FAIL B2 浮乘整") ; 失败 = 1 }
若 1 + 0.5 != 1.5 { 示("FAIL B3 整加浮") ; 失败 = 1 }
若 3 - 0.5 != 2.5 { 示("FAIL B4 整减浮") ; 失败 = 1 }
若 7 / 2.0 != 3.5 { 示("FAIL B5 整除浮") ; 失败 = 1 }

// C. 浮点模(fmod;GSC 对浮点模报错,XTC 支持——有意分歧)
若 5.5 % 2.0 != 1.5 { 示("FAIL C1 浮点模") ; 失败 = 1 }
若 7.5 % 2.5 != 0.0 { 示("FAIL C2 浮点模整除") ; 失败 = 1 }

// D. 单目负号
设 _a = 0.5
若 -_a != -0.5 { 示("FAIL D1 变量负号") ; 失败 = 1 }
若 -(1.5) != -1.5 { 示("FAIL D2 括号负号") ; 失败 = 1 }
若 --2.5 != 2.5 { 示("FAIL D3 双重负号") ; 失败 = 1 }
若 -0.5 + 1.0 != 0.5 { 示("FAIL D4 负号参与运算") ; 失败 = 1 }

// E. 优先级与括号
若 1.0 + 2.0 * 3.0 != 7.0 { 示("FAIL E1 优先级") ; 失败 = 1 }
若 (1.0 + 2.0) * 3.0 != 9.0 { 示("FAIL E2 括号") ; 失败 = 1 }

// F. 变量链(值经变量传递后仍为浮点)
设 链 = 0.5 * 2
设 链2 = 链 + 0.5
若 链2 != 1.5 { 示("FAIL F1 链式") ; 失败 = 1 }

// G. 注解小数函数(原生 double 签名 + 装箱互转)
函 圆面积(半径: 小数): 小数 {
    返 3.14159 * 半径 * 半径
}
设 _面 = 圆面积(2.0)
若 _面 < 12.5663 或 _面 > 12.5664 { 示("FAIL G1 注解函数 面=" & 字(_面)) ; 失败 = 1 }

// H. 循环累加
设 计 = 0.0
设 i = 0
当 i < 10 {
    计 = 计 + 0.25
    i = i + 1
}
若 计 != 2.5 { 示("FAIL H1 循环累加 计=" & 字(计)) ; 失败 = 1 }

// I. 除零约定(XTC:返 0,与整数路径一致;与 GSC 报错有意分歧)
若 1.0 / 0.0 != 0.0 { 示("FAIL I1 浮点除零") ; 失败 = 1 }
若 5.5 % 0.0 != 0.0 { 示("FAIL I2 浮点模零") ; 失败 = 1 }

// J. 整数路径回归(改动后整数语义不得变)
若 7 / 2 != 3 { 示("FAIL J1 整除") ; 失败 = 1 }
若 7 % 2 != 1 { 示("FAIL J2 整模") ; 失败 = 1 }
若 6 * 7 != 42 { 示("FAIL J3 整乘") ; 失败 = 1 }
若 10 - 4 != 6 { 示("FAIL J4 整减") ; 失败 = 1 }

若 失败 == 0 { 示("103 PASS") } 否 { 终 1 }
