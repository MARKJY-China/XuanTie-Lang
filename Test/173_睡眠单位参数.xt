// Test/173_睡眠单位参数.xt
// issue #132:时.睡(时间, 单位?) —— 单位支持 "秒"/"毫秒"/"微秒",缺省毫秒。
// 只断言"至少睡够/没睡"这类布尔量,避免把机器抖动写进基线。
设 起 = 时.毫秒()
时.睡(50)
设 毫 = 时.毫秒() - 起
设 起2 = 时.毫秒()
时.睡(50000, "微秒")
设 微 = 时.毫秒() - 起2
设 起3 = 时.毫秒()
时.睡(0, "秒")
设 零 = 时.毫秒() - 起3
示("缺省毫秒睡够: " & 字(毫 >= 40))
示("微秒单位睡够: " & 字(微 >= 40))
示("零秒立即返回: " & 字(零 < 40))