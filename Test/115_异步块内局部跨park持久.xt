// 107_异步块内局部跨park持久(L1回归):fiber 内 设 的局部变量在切分点挂起唤醒后必须保持原值
// 历史Bug:局部变量存于 poll 局部 alloca,每次 poll 重建为 0,park 后读回 空
示("--- 107_异步块内局部跨park持久 开始 ---")

设 ch = 道(10)
设 p = 异步 {
    时.睡(150)
    ch.发(99)
}
设 t = 异步 {
    设 x = 5
    设 名 = "玄铁"
    设 v = ch.收()
    // park 唤醒后:x/名 必须仍为 5/"玄铁"
    若 x == 5 且 名 == "玄铁" 且 v == 99 {
        示("PASS: 块内局部跨park保持")
    } 否 {
        示("FAIL: x=#{x} 名=#{名} v=#{v}")
    }
}
等待(t)
等待(p)
示("--- 107_异步块内局部跨park持久 结束 ---")
