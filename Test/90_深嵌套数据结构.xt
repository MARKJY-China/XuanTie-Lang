// Test 90 — 深嵌套数据结构(全断言)
示("=== Test 90: 深嵌套数据结构 ===")
设 数据 = {
    "名单": ["甲", "乙", "丙"],
    "属性": {"等级": 5, "标签": ["勇", "智"]},
    "表": [{"id": 1}, {"id": 2}]
}
若 数据["名单"][2] == "丙" { 示("PASS: 字典套数组") } 否 { 示("FAIL: 字典套数组") }
若 数据["属性"]["标签"][1] == "智" { 示("PASS: 三层嵌套") } 否 { 示("FAIL: 三层嵌套") }
若 数据["表"][1]["id"] == 2 { 示("PASS: 数组套字典") } 否 { 示("FAIL: 数组套字典") }
设 矩阵 = [[1, 2], [3, 4]]
若 矩阵[1][0] == 3 { 示("PASS: 二维数组") } 否 { 示("FAIL: 二维数组") }
数据["属性"]["新增"] = 真
若 数据["属性"]["新增"] == 真 { 示("PASS: 嵌套写入") } 否 { 示("FAIL: 嵌套写入") }
示("=== Test 90 完成 ===")
