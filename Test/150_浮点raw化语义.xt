// Test/150_浮点raw化语义.xt
// P3 raw_f64(浮点裸位存储)语义钉死:raw 快路径/粘性槽位/边界装箱/除零约定/捕获边界。
// 背景:小数字面量与浮点变量以 raw_f64 裸位(bitcast double↔i64)存储与运算,
// 仅在示/容器/调用/返回/拼接/捕获等边界装箱——本清单逐项验证语义与装箱时代一致。
设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

// 1. 浮点累加(raw 快路径 + 粘性槽位)
设 和 = 0.0
设 i = 0
当 i < 1000 {
    和 = 和 + 0.5
    i = i + 1
}
断言("浮点累加1e3==500", 和 == 500.0)

// 2. 小数字面量装箱边界(示/字符串)
设 半 = 1.5
断言("字面量比较", 半 > 1.4 且 半 < 1.6)
断言("字面量相等", 半 == 1.5)

// 3. 注解小数
设 率: 小数 = 0.25
率 = 率 * 4.0
断言("注解小数乘", 率 == 1.0)

// 4. 整浮混合(整字面量 sitofp)
设 混 = 1.5 + 2
断言("整浮混合", 混 == 3.5)

// 5. 除零约定:无尝试块返 0.0
设 零除 = 1.5 / 0.0
断言("浮点除零返0", 零除 == 0.0)
设 零模 = 5.5 % 0.0
断言("浮点模零返0", 零模 == 0.0)

// 6. 除零可捕捉
设 捕获到 = 假
尝试 {
    设 _t = 1.5 / 0.0
    设 _u = _t + 1.0
} 捕捉 错 {
    捕获到 = 真
}
断言("浮点除零可捕捉", 捕获到)

// 7. 函数边界装箱(参数/返回)
函 加倍( x ) {
    返 x * 2.0
}
断言("函数返回浮点", 加倍(0.75) == 1.5)

函 加一( x: 小数 ) {
    返 x + 1.0
}
断言("注解参数", 加一(0.5) == 1.5)

// 8. 前缀负号
设 负 = -1.5
断言("前缀负号", 负 == 0.0 - 1.5)
设 负二 = -负
断言("双重负号", 负二 == 1.5)

// 9. 字符串拼接(装箱边界)
设 文 = "值=" & 1.5
断言("浮点拼接", 文 == "值=1.5")

// 10. 布尔语境(行为修正:非零即真)
设 真浮 = 0.5
若 真浮 { 断言("浮点真值", 真) } 否 { 断言("浮点真值", 假) }
设 零浮 = 0.0
若 零浮 { 断言("零浮为假", 假) } 否 { 断言("零浮为假", 真) }

// 11. 容器装箱(数组/字典元素必须是对象)
设 组 = [1.5, 2.5]
设 元和 = 组[0] + 组[1]
断言("数组元素浮点和", 元和 == 4.0)
设 典 = {"pi": 3.0}
断言("字典元素浮点", 典["pi"] == 3.0)

// 12. 闭包捕获浮点
设 外浮 = 2.5
设 取外 = 函() { 返 外浮 * 2.0 }
断言("闭包捕获浮点", 取外() == 5.0)

// 13. 若表达式汇聚
设 择 = 若 1.5 > 1.0 { 9.5 } 否 { 0.5 }
断言("若表达式汇聚", 择 == 9.5)

// 14. 减除混合优先级
设 算 = 1.0 + 2.0 * 3.0 - 4.0 / 2.0
断言("混合四则", 算 == 5.0)

// 15. 浮点变量赋整值(粘性:仍为浮点语义)
设 粘 = 1.5
粘 = 2
断言("浮点粘整值", 粘 > 1.9 且 粘 < 2.1)

// 16. 异步捕获浮点(装箱边界)
设 异浮 = 3.25
设 异道 = 异步 {
    返 异浮 + 1.0
}
设 异果 = 等待(异道)
断言("异步捕获浮点", 异果 == 4.25)

若 失败数 == 0 { 示("P3 冒烟全绿") } 否 { 示("P3 冒烟失败数: " & 失败数) }
