// Test 81 — 字符串方法矩阵(全断言)
示("=== Test 81: 字符串方法矩阵 ===")
设 s = "玄铁语言 XuanTie"
设 _切 = s.截取(0, 2)
若 _切 == "玄铁" { 示("PASS: 截取") } 否 { 示("FAIL: 截取=" & _切) }
设 _替 = s.替换("玄铁", "黑铁")
若 _替.包含?("黑铁") { 示("PASS: 替换") } 否 { 示("FAIL: 替换") }
设 _分 = "a,b,c".分割(",")
若 _分.长度 == 3 且 _分[1] == "b" { 示("PASS: 分割") } 否 { 示("FAIL: 分割") }
若 s.包含?("Xuan") 且 非 s.包含?("yy") { 示("PASS: 包含判定") } 否 { 示("FAIL: 包含判定") }
设 _空判 = ""
若 _空判.字节数 == 0 { 示("PASS: 空串字节数") } 否 { 示("FAIL: 空串字节数") }
设 _拼 = "A" & 1 & "B" & 真
若 _拼 == "A1B真" { 示("PASS: 混合拼接") } 否 { 示("FAIL: 混合拼接=" & _拼) }
示("=== Test 81 完成 ===")
