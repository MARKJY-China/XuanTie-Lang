// Test/104_浮点比较与转换.xt
// 浮点比较(含整/浮混合)、字()/整()/小数() 转换、字符串拼接的回归。
// 比较底层走 xt_compare(_xt_as_double 数值统一提取);转换走 整/小数 内建。
设 失败 = 0

// A. 纯浮点比较六运算符
若 非 (0.5 > 0.2) { 示("FAIL A1 >") ; 失败 = 1 }
若 0.1 < 0.05 { 示("FAIL A2 <") ; 失败 = 1 }
若 非 (0.5 >= 0.5) { 示("FAIL A3 >=") ; 失败 = 1 }
若 0.5 <= 0.4 { 示("FAIL A4 <=") ; 失败 = 1 }
若 非 (1.5 == 1.5) { 示("FAIL A5 ==") ; 失败 = 1 }
若 非 (1.5 != 1.6) { 示("FAIL A6 !=") ; 失败 = 1 }

// B. 整/浮混合比较(数值相等即等)
若 非 (2 > 1.5) { 示("FAIL B1 整>浮") ; 失败 = 1 }
若 1 < 0.5 { 示("FAIL B2 整<浮") ; 失败 = 1 }
若 非 (1.0 == 1) { 示("FAIL B3 浮等整") ; 失败 = 1 }
若 非 (0.0 == 0) { 示("FAIL B4 零等") ; 失败 = 1 }
若 2.5 <= 2 { 示("FAIL B5 浮<=整") ; 失败 = 1 }
若 非 (3 >= 2.5) { 示("FAIL B6 整>=浮") ; 失败 = 1 }

// C. 变量参与的比较(装箱值经变量传递)
设 x = 3.14
设 y = 2.71
若 非 (x > y) { 示("FAIL C1 变量>") ; 失败 = 1 }
若 x < y { 示("FAIL C2 变量<") ; 失败 = 1 }
若 非 (x == 3.14) { 示("FAIL C3 变量==") ; 失败 = 1 }

// D. 字() 打印格式
若 字(0.25) != "0.25" { 示("FAIL D1 字(0.25)=" & 字(0.25)) ; 失败 = 1 }
若 字(2.5) != "2.5" { 示("FAIL D2 字(2.5)=" & 字(2.5)) ; 失败 = 1 }
若 字(-0.5) != "-0.5" { 示("FAIL D3 字(-0.5)=" & 字(-0.5)) ; 失败 = 1 }
// 整数值浮点打印不带小数点(与 GSC 的 Float.Inspect 对齐)
若 字(2.0) != "2" { 示("FAIL D4 字(2.0)=" & 字(2.0)) ; 失败 = 1 }

// E. 整()/小数() 显式转换
若 整(3.7).值 != 3 { 示("FAIL E1 整(3.7)") ; 失败 = 1 }
若 整(-3.7).值 != -3 { 示("FAIL E2 整(-3.7)") ; 失败 = 1 }
若 小数(5).值 != 5.0 { 示("FAIL E3 小数(5)") ; 失败 = 1 }
若 非 整(2.9).成功 { 示("FAIL E4 整()成功标志") ; 失败 = 1 }

// F. 字符串拼接(& 与 插值)
若 "pi=" & 3.14 != "pi=3.14" { 示("FAIL F1 &拼接") ; 失败 = 1 }
设 插 = "值=#{0.5}"
若 插 != "值=0.5" { 示("FAIL F2 插值: " & 插) ; 失败 = 1 }

// G. 条件语句中的浮点比较
设 过 = 假
若 0.9 > 0.1 且 0.1 < 0.2 { 过 = 真 }
若 非 过 { 示("FAIL G1 条件组合") ; 失败 = 1 }

// H. 浮点数组/字典存取(装箱通用性)
设 组 = [1.5, 2.5, 3.5]
若 组[0] + 组[1] + 组[2] != 7.5 { 示("FAIL H1 数组") ; 失败 = 1 }
设 典 = {"价": 9.9}
若 典["价"] * 2 != 19.8 { 示("FAIL H2 字典") ; 失败 = 1 }

若 失败 == 0 { 示("104 PASS") } 否 { 终 1 }
