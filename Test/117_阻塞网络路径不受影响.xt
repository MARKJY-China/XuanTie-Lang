// 109_阻塞网络路径不受影响:主线程(非fiber)的 连/写/读 保持阻塞语义,行为与方案三之前一致
示("--- 109_阻塞网络路径 开始 ---")

听(19309, 函(流) {
    设 数据 = 流.读()
    若 数据 != 空 {
        流.写("堵回:" & 数据)
    }
    流.关()
})

// 主线程直连:无 异步 块,全程阻塞
设 r = 连("127.0.0.1:19309")
若 r.成功 {
    设 流 = r.值
    流.写("主线程")
    设 回 = 流.读()
    若 回 == "堵回:主线程" {
        示("PASS: 阻塞回环正确")
    } 否 {
        示("FAIL: 回=#{回}")
    }
    流.关()
} 否 {
    示("FAIL: 阻塞连接失败")
}
示("--- 109_阻塞网络路径 结束 ---")
