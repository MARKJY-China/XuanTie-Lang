// Issue #136:子进程 stdin 分次写入、二进制透传、显式 EOF、幂等关闭/等待与退出码。
外 函 xt_self_path(): 字
外 函 xt_get_args(): 数组
外 函 xt_stdin_read_n(n: 整): 字

设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

文件.建目录("Test/binary")
设 _路径 = "Test/binary/_issue136_pipe.bin"
文件.删(_路径)

设 _参数 = xt_get_args()
若 _参数.长度 > 1 且 _参数[1] == "--pipe-child" {
    设 _收 = xt_stdin_read_n(11)
    设 _存 = 文件.写(_路径, _收)
    若 _存.成功 { 终 0 }
    终 2
}

设 _命令 = ""
若 执("cmd /c exit 0").成功 {
    _命令 = "\"" & xt_self_path() & "\" --pipe-child"
} 否 {
    _命令 = "'" & xt_self_path() & "' --pipe-child"
}

设 _开 = 进程.启动(_命令)
断言("启动子进程", _开.成功)
若 非 _开.成功 { 示(_开.错误) ; 终 1 }
设 _子 = _开.值
设 _首 = 到字节集("ABCD")
_首.写字节(0, 0)
_首.写字节(1, 10)
_首.写字节(2, 13)
_首.写字节(3, 255)
设 _次 = 到字节集("WXYZ")
_次.写字节(0, 255)
_次.写字节(1, 13)
_次.写字节(2, 10)
_次.写字节(3, 0)
断言("第一次写原始字节", 进程.写(_子, _首).成功)
断言("第二次写原始字节", 进程.写(_子, _次).成功)
断言("写入文本片段", 进程.写(_子, "尾").成功)
断言("刷新输入", 进程.刷新(_子).成功)
断言("关闭输入", 进程.关闭输入(_子).成功)
断言("关闭输入幂等", 进程.关闭输入(_子).成功)
断言("关闭后写入被拒绝", 非 进程.写(_子, "X").成功)
设 _完 = 进程.等退出(_子)
断言("等待成功", _完.成功)
断言("零退出码", _完.值 == 0)
断言("等待幂等", 进程.等退出(_子).成功 且 进程.等退出(_子).值 == 0)

设 _读 = 文件.读(_路径)
断言("二进制逐次拼接", _读.成功 且 _读.值.字节数 == 11)
若 _读.成功 {
    设 _b = 到字节集(_读.值)
    断言("NUL原样保留", _b.取字节(0) == 0 且 _b.取字节(7) == 0)
    断言("换行不转换", _b.取字节(1) == 10 且 _b.取字节(6) == 10)
    断言("非ASCII字节原样保留", _b.取字节(3) == 255 且 _b.取字节(4) == 255)
    断言("回车原样保留", _b.取字节(2) == 13 且 _b.取字节(5) == 13)
}

设 _非正常 = 进程.启动("cmd /c exit 7")
若 非 _非正常.成功 { _非正常 = 进程.启动("sh -c 'exit 7'") }
若 _非正常.成功 {
    设 _非正常完 = 进程.等退出(_非正常.值)
    断言("非零退出也属于等待成功", _非正常完.成功)
    断言("返回实际非零退出码", _非正常完.值 == 7)
}
设 _异步命令 = "sh -c 'exit 0'"
若 执("cmd /c exit 0").成功 { _异步命令 = "cmd /c exit 0" }
设 _异步任务 = 异步 {
    设 _异开 = 进程.启动(_异步命令)
    若 _异开.成功 {
        设 _异完 = 进程.等退出(_异开.值)
        若 _异完.成功 { 返 _异完.值 }
    }
    返 -1
}
设 _完成码 = 等待(_异步任务)
断言("异步子进程等待", _完成码 == 0)

断言("空命令明确失败", 非 进程.启动("").成功)
断言("不是进程句柄", 非 进程.刷新(123).成功)
断言("写入类型明确失败", 非 进程.写(_子, 123).成功)

文件.删(_路径)
若 失败数 == 0 { 示("子进程标准输入 全绿") } 否 { 示("子进程标准输入 失败数: " & 失败数) }
