// Test/75_调度特性功能验证.xt
// 专项验证 P9c-P12 各阶段特性：带明确 PASS/FAIL 断言

示("=== Test 75: 调度特性功能验证 ===")

// ----------------------------------------------------------
// P10+P11: 时.睡不截断后续代码 + body不重复执行
// ----------------------------------------------------------
示("[验证1] 分段编译+await point")
设 v1ch = 道(2)
// 关键：时.睡(10) 在 发(100) 之前，睡完必须继续执行发(100)
// 如果分段编译失败，发(100)永不执行
设 v1send = 异步 { 时.睡(10); v1ch.发(100); 时.睡(10); v1ch.发(200) }
等待(v1send)
设 v1sum = v1ch.收() + v1ch.收()
若 v1sum == 300 { 示("PASS: 验证1 时睡不截断 发 (sum=300)") } 否 { 示("FAIL: sum=" & v1sum.转字() & " (预期300)") }

// ----------------------------------------------------------
// P11: body 代码不重复执行
// ----------------------------------------------------------
示("[验证2] body不重复执行")
设 v2count = 0
设 v2task = 异步 { v2count = v2count + 1; 时.睡(5); v2count = v2count + 1 }
等待(v2task)
若 v2count == 2 { 示("PASS: 验证2 count=2 (每个语句执行一次)") } 否 { 示("FAIL: count=" & v2count.转字() & " (重复了)") }

// ----------------------------------------------------------
// P12: 多worker并发——50 fiber 各睡 10ms，总耗时 < 150ms
// ----------------------------------------------------------
示("[验证3] 多worker真并发")
设 v3ch = 道(60)
设 v3tasks = []
设 v3i = 0
当 v3i < 50 {
    设 v3t = 异步 { 时.睡(10); v3ch.发(1) }
    v3tasks.追加(v3t)
    v3i = v3i + 1
}
设 v3start = 时.毫秒()
遍历 v3t 于 v3tasks { 等待(v3t) }
设 v3elapsed = 时.毫秒() - v3start
设 v3count = 0; 设 v3j = 0; 当 v3j < 50 { v3count = v3count + v3ch.收(); v3j = v3j + 1 }
若 v3count == 50 且 v3elapsed < 80 {
    示("PASS: 验证3 50并发耗时" & v3elapsed.转字() & "ms (并发有效)")
} 否 {
    示("FAIL: count=" & v3count.转字() & " elapsed=" & v3elapsed.转字() & "ms")
}

// ----------------------------------------------------------
// Post-P12: fiber 直接创建
// ----------------------------------------------------------
示("[验证4] fiber直接创建")
设 v4ch = 道(1)
设 v4task = 异步 { v4ch.发("direct") }
等待(v4task)
设 v4result = v4ch.收()
若 v4result == "direct" { 示("PASS: 验证4") } 否 { 示("FAIL") }

// ----------------------------------------------------------
// P9d: 通道非阻塞 + fiber wake
// ----------------------------------------------------------
示("[验证5] 通道收发完整性")
设 v5ch = 道(4)
设 v5s1 = 异步 { v5ch.发(1) }; 设 v5s2 = 异步 { v5ch.发(2) }
设 v5s3 = 异步 { v5ch.发(3) }; 设 v5s4 = 异步 { v5ch.发(4) }
等待(v5s1);等待(v5s2);等待(v5s3);等待(v5s4)
设 v5sum = v5ch.收() + v5ch.收() + v5ch.收() + v5ch.收()
若 v5sum == 10 { 示("PASS: 验证5 sum=10") } 否 { 示("FAIL: sum=" & v5sum.转字()) }

示("=== Test 75: 全部验证完成 ===")
