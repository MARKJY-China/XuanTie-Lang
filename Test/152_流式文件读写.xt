// Test/152_流式文件读写.xt
// 批次二:流式文件读写(XTFile 句柄)。打开/读一行/读全部/读字节/写文本/写行/
// 移动位置/取位置/取长度/到文件尾/尾?/刷新/关闭,含模式守卫与 GC 自动关闭。
// 字节账:写行("第一行玄铁")=16B,写文本("第二行")=9B,写文本("尾巴")=6B,共 31B。
设 失败数 = 0
函 断言(名, 条件) {
    若 条件 { 示("PASS " & 名) } 否 { 示("FAIL " & 名) ; 失败数 = 失败数 + 1 }
}

设 _路径 = "Test/binary/_b2_stream.txt"
设 _路径2 = "Test/binary/_b2_guard.txt"
// 环境自清:CI 干净检出无 Test/binary(不被 git 跟踪),先补父目录
文件.建目录("Test/binary")
文件.删(_路径)   // 清理上轮残留(不存在则失败,忽略)
文件.删(_路径2)

// ---- 写入(写文本/写行) ----
设 _开 = 文件.打开(_路径, "写")
断言("打开写", _开.成功)
设 _h = _开.值
断言("写行", _h.写行("第一行玄铁").成功)
断言("写文本", _h.写文本("第二行").成功)
断言("写文本2", _h.写文本("尾巴").成功)
断言("取位置写入后", _h.取位置().值 == 31)
断言("刷新", _h.刷新().成功)
断言("关闭", _h.关闭().成功)
断言("关闭幂等", _h.关闭().成功)

// ---- 逐行读 ----
设 _开2 = 文件.打开(_路径, "读")
断言("打开读", _开2.成功)
设 _r = _开2.值
设 _l1 = _r.读一行()
断言("读一行1", _l1.成功 且 _l1.值 == "第一行玄铁")
设 _l2 = _r.读一行()
断言("读一行2", _l2.成功 且 _l2.值 == "第二行尾巴")
设 _l3 = _r.读一行()
断言("读一行到尾", 非 _l3.成功)
断言("尾?", _r.尾?())
_r.关闭()

// ---- 位置与长度 ----
设 _开3 = 文件.打开(_路径, "读")
设 _g = _开3.值
断言("取长度", _g.取长度().值 == 31)
断言("移动位置", _g.移动位置(16).成功)
断言("取位置", _g.取位置().值 == 16)
设 _半 = _g.读全部()
断言("读全部自当前", _半.成功 且 _半.值 == "第二行尾巴")
断言("到文件尾", _g.到文件尾().成功)
断言("尾后位置", _g.取位置().值 == 31)
_g.关闭()

// ---- 读字节(二进制,可含NUL;写行只落 \n) ----
设 _开4 = 文件.打开(_路径, "读")
设 _b = _开4.值
设 _头3 = _b.读字节(3)
断言("读字节", _头3.成功 且 _头3.值 == "第")
断言("读字节短读", _b.读字节(100).值 == "一行玄铁\n第二行尾巴")
_b.关闭()

// ---- 追加模式 ----
设 _开5 = 文件.打开(_路径, "追加")
断言("打开追加", _开5.成功)
_开5.值.写行("第三行")
_开5.值.关闭()
设 _全 = 文件.读(_路径)
断言("追加生效", _全.成功 且 _全.值 == "第一行玄铁\n第二行尾巴第三行\n")

// ---- 读写模式与移动覆写 ----
设 _开6 = 文件.打开(_路径, "读写")
断言("打开读写", _开6.成功)
设 _rw = _开6.值
_rw.移动位置(0)
_rw.写文本("第壹行")
_rw.关闭()
设 _全2 = 文件.读(_路径)
断言("移动覆写", _全2.成功 且 _全2.值.截取(0, 3) == "第壹行")

// ---- GC 自动关闭(不显式关闭,依赖 ARC 回收) ----
设 _开9 = 文件.打开(_路径, "读")
设 _弃 = _开9.值
断言("GC句柄可读", _弃.读一行().成功)

// ---- 模式守卫(写模式会截断,用独立刮擦件) ----
设 _开7 = 文件.打开(_路径, "读")
设 _ro = _开7.值
断言("只读不可写", 非 _ro.写文本("x").成功)
_ro.关闭()
设 _开8 = 文件.打开(_路径2, "写")
设 _wo = _开8.值
断言("只写不可读", 非 _wo.读一行().成功)
_wo.关闭()

// ---- 坏路径/坏模式 ----
断言("打开不存在", 非 文件.打开("Test/binary/_b2_不存在.txt", "读").成功)
断言("模式无效", 非 文件.打开(_路径, "飞").成功)

文件.删(_路径)
文件.删(_路径2)
若 失败数 == 0 { 示("批次二 全绿") } 否 { 示("批次二 失败数: " & 失败数) }
