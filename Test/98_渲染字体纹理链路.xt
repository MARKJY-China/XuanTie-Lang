// Test/98_渲染字体纹理链路.xt
// 字体与纹理资源链路:TTF加载/精确测量/绘制/释放 + PNG纹理加载/绘制/释放
// 覆盖:加载字体/量字体文字/绘字体文字/释字体/加载纹理/绘纹理/释纹理(运行CWD=项目根,assets可用)
引 "渲染" 予 R

R.初始化窗口(360, 240, "98测试")

设 字体 = R.加载字体("assets/HarmonyOS_Sans_SC_Regular.ttf", 24)
若 字体 == 0 {
    示("FAIL: 字体加载失败")
    终 1
}
设 宽 = R.量字体文字(字体, "玄铁渲染冒烟", 24, 1)
若 宽 <= 0 {
    示("FAIL: 字体测量宽度为0")
    终 1
}

设 纹 = R.加载纹理("assets/xuantie_logo_dark_256px.png")
若 纹 == 0 {
    示("FAIL: 纹理加载失败")
    终 1
}

设 帧 = 0
当 非 R.窗口应关闭() {
    R.开始绘图()
    R.清背景(30, 30, 40, 255)
    R.绘字体文字(字体, "玄铁渲染冒烟", 20, 20, 24, 1, 255, 255, 255, 255)
    R.绘纹理(纹, 40, 70, 255, 255, 255, 255)
    R.结束绘图()
    帧 = 帧 + 1
    若 帧 >= 15 { 断 }
}
R.释纹理(纹)
R.释字体(字体)
R.关闭窗口()
若 帧 != 15 {
    示("FAIL: 帧数不符 " & 帧)
    终 1
}
示("98 PASS")
