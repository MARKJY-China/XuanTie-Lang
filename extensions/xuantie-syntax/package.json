{
    "name": "xuantie-syntax",
    "displayName": "玄铁 (XuanTie)",
    "description": "玄铁编程语言的VSCode插件。支持完善的语法高亮、代码片段补全、关键字提示等功能。",
    "version": "2.2.2",
    "publisher": "xuantie",
    "icon": "icon.ico",
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:xuantie"
    ],
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "xuantie",
                "aliases": [
                    "XuanTie",
                    "玄铁"
                ],
                "extensions": [
                    ".xt"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icon.ico",
                    "dark": "./icon.ico"
                }
            }
        ],
        "grammars": [
            {
                "language": "xuantie",
                "scopeName": "source.xt",
                "path": "./syntaxes/xuantie.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "玄铁语言配置",
            "properties": {
                "xuantie.enableSnippets": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否开启玄铁关键字的代码片段补全。关闭时（默认），拼音补全仅插入关键字本身。"
                },
                "xuantie.lspPort": {
                    "type": "number",
                    "default": 20807,
                    "description": "玄铁 LSP 服务器(xt_lsp.exe)的 TCP 回环端口。仅 lspTransport=tcp 时生效。"
                },
                "xuantie.lspTransport": {
                    "type": "string",
                    "enum": [
                        "stdio",
                        "tcp"
                    ],
                    "default": "stdio",
                    "description": "LSP 传输方式:stdio(推荐,插件直接拉起 xt_lsp 子进程,每窗口独立);tcp(开发调试,连接 127.0.0.1:20807 上手动启动的 xt_lsp --tcp)。"
                },
                "xuantie.lspServerPath": {
                    "type": "string",
                    "default": "",
                    "description": "xt_lsp.exe 的路径。留空则使用扩展自带 server/xt_lsp.exe。"
                },
                "xuantie.xtcPath": {
                    "type": "string",
                    "default": "",
                    "description": "xtc.exe(玄铁编译器)的路径,用于保存文件时的语义级诊断(xtc --检查)。留空则自动探测 xt_lsp.exe 同目录,再退到 PATH。"
                }
            }
        }
    }
}
