{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "XuanTie",
	"scopeName": "source.xt",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#properties"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#brackets"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.xt",
					"match": "//.*$"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.xt",
					"match": "(?<![\\p{L}\\p{N}_?])(若|抑|否|当|循|遍历|于|断|续|返|尝试|捕捉|异步|等待|并行|引|予|接着|且|或|非|是|匹配|终)(?![\\p{L}\\p{N}_?])"
				},
				{
					"name": "storage.type.xt",
					"match": "(?<![\\p{L}\\p{N}_?])(设|常|型|函|造|公|私|护|承|口|变量|常量|函数|外|覆|弱)(?![\\p{L}\\p{N}_?])"
				},
				{
					"name": "storage.type.primitive.xt",
					"match": "(?<![\\p{L}\\p{N}_?])(整|小数|字|布尔|空|数组|字典|字节|结果|任务|字符串|整数|逻辑)(?![\\p{L}\\p{N}_?])"
				},
				{
					"name": "support.function.xt",
					"match": "(?<![\\p{L}\\p{N}_?])(示|化|解|求|听|连|执|道|输|成功|失败|打印)(?![\\p{L}\\p{N}_?])"
				},
				{
					"name": "support.class.xt",
					"match": "(?<![\\p{L}\\p{N}_?])(文件|网络|字符串|数学|时|系统|时间)(?![\\p{L}\\p{N}_?])"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"name": "entity.name.function.xt",
					"match": "([\\p{L}_][\\p{L}\\p{N}_]*\\??)\\s*(?=\\()"
				}
			]
		},
		"properties": {
			"patterns": [
				{
					"name": "variable.other.property.xt",
					"match": "(?<=\\.)([\\p{L}_][\\p{L}\\p{N}_]*\\??)"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"name": "variable.other.readwrite.xt",
					"match": "([\\p{L}_][\\p{L}\\p{N}_]*\\??)"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.xt",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.xt",
							"match": "\\\\."
						},
						{
							"name": "meta.embedded.line.xt",
							"begin": "#\\{",
							"beginCaptures": {
								"0": {
									"name": "punctuation.definition.template-expression.begin.xt"
								}
							},
							"end": "\\}",
							"endCaptures": {
								"0": {
									"name": "punctuation.definition.template-expression.end.xt"
								}
							},
							"patterns": [
								{
									"include": "$self"
								}
							]
						}
					]
				},
				{
					"name": "string.quoted.double.chinese.xt",
					"begin": "“",
					"end": "”",
					"patterns": [
						{
							"name": "constant.character.escape.xt",
							"match": "\\\\."
						},
						{
							"name": "meta.embedded.line.xt",
							"begin": "#\\{",
							"beginCaptures": {
								"0": {
									"name": "punctuation.definition.template-expression.begin.xt"
								}
							},
							"end": "\\}",
							"endCaptures": {
								"0": {
									"name": "punctuation.definition.template-expression.end.xt"
								}
							},
							"patterns": [
								{
									"include": "$self"
								}
							]
						}
					]
				}
			]
		},
		"numbers": {
			"name": "constant.numeric.xt",
			"match": "\\b\\d+(\\.\\d+)?\\b"
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.xt",
					"match": "(?<![\\p{L}\\p{N}_?])(真|假|空|此)(?![\\p{L}\\p{N}_?])"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.assignment.xt",
					"match": "="
				},
				{
					"name": "keyword.operator.comparison.xt",
					"match": "(==|!=|<=|>=|<|>)"
				},
					{
					"name": "keyword.operator.comparison.xt",
					"match": "(?<![\\p{L}\\p{N}_?])(等于)(?![\\p{L}\\p{N}_?])"
				},
				{
					"name": "keyword.operator.arithmetic.xt",
					"match": "(\\+|\\-|\\*|/|%)"
				},
				{
					"name": "keyword.operator.logical.xt",
					"match": "(&|\\|)"
				},
					{
					"name": "keyword.operator.logical.xt",
					"match": "(?<![\\p{L}\\p{N}_?])(且|或|非|是)(?![\\p{L}\\p{N}_?])"
				},
				{
					"name": "keyword.operator.bitwise.xt",
					"match": "(?<![\\p{L}\\p{N}_?])(位与|位或|异或|左移|右移|取反)(?![\\p{L}\\p{N}_?])"
				},
				{
					"name": "keyword.operator.other.xt",
					"match": "(\\.|\\?|->)"
				}
			]
		},
		"brackets": {
			"patterns": [
				{
					"name": "punctuation.bracket.xt",
					"match": "(\\{|\\}|\\[|\\]|\\(|\\))"
				}
			]
		}
	}
}
