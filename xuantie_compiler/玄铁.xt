// xuantie_compiler/入口.xt
// 玄铁自举编译器 - 入口程序

引 "词法.xt"
引 "抽象语法树.xt"
引 "语法分析.xt"

引 "编译.xt"

// 引入运行时 FFI
外 函 xt_arena_new(大小: 整): 整
外 函 xt_arena_use(池: 整): 整
外 函 xt_arena_destroy(池: 整): 整
外 函 xt_get_args(): 数组
外 函 xt_get_temp_path(): 字
外 函 xt_self_path(): 字

// FNV-1a 32 位内容指纹:确定性构建的临时文件命名依据——同内容同名(覆盖写无碍),
// 异内容不撞名;替代原先 时.毫秒() 时间戳(会经 -g 调试信息渗入产物,破坏字节级复现)
函 指纹of(文本) {
    设 h = 2166136261
    设 i = 0
    当 i < 文本.字节数 {
        设 t = (h 异或 文本.字节(i)) * 16777619
        h = t 位与 4294967295
        i = i + 1
    }
    返 h
}

// 从起始目录向上逐级查找 玄铁.配置.toml(找到即项目根,类似 go.mod);找不到返 ""
// 注意:全程用 字符数(字符索引)而非 字节数——中文目录名下字节数!=字符数,混用会死循环
函 查找配置文件(起始目录) {
    设 查 = 起始目录
    循 {
        设 试 = 查 & "玄铁.配置.toml"
        若 文件.存在?(试) { 返 试 }
        若 查 == "" { 返 "" }
        // 去掉末级目录(兼容 \ 与 /)
        设 去尾 = 查
        设 尾字 = 去尾.截取(去尾.字符数 - 1, 去尾.字符数)
        若 尾字 == "\\" 或 尾字 == "/" { 去尾 = 去尾.截取(0, 去尾.字符数 - 1) }
        设 再斜 = -1
        设 i = 去尾.字符数 - 1
        当 i >= 0 {
            设 c = 去尾.截取(i, i + 1)
            若 c == "\\" 或 c == "/" { 再斜 = i ; 断 }
            i = i - 1
        }
        若 再斜 < 0 { 返 "" }
        查 = 去尾.截取(0, 再斜 + 1)
    }
    返 ""
}

// 解析配置里的数组值:["W001","隐式类型"] → ["W001","隐式类型"]
函 解析配置数组(串) {
    设 出 = []
    设 体 = 串.替换("[", "").替换("]", "")
    遍历 项 于 体.分割(",") {
        设 净 = 项.替换(" ", "").替换("\t", "")
        若 净 != "" { 出.追加(净) }
    }
    返 出
}

函 解析配置(内容) {
    设 配置结果 = {}
    设 行列表 = 内容.分割("\n")
    遍历 原始行 于 行列表 {
        设 行 = 原始行.替换("\r", "")
        // 跳过空行、注释、节标题
        若 行 == "" 或 行.截取(0,1) == "#" 或 行.截取(0,1) == "[" { 续 }
        若 非 行.包含?("=") { 续 }
        // 找到 = 的位置
        设 等号位 = 0
        设 ci = 0
        当 ci < 行.字节数 { 若 行.截取(ci, ci+1) == "=" { 等号位 = ci ; 断 } ; ci = ci + 1 }
        // 提取键和值（去除=左右的空格）
        设 键 = 行.截取(0, 等号位).替换(" ", "").替换("\t", "")
        设 值 = 行.截取(等号位 + 1, 行.字节数).替换(" ", "").替换("\t", "").替换("\"", "").替换("\"", "")
        若 键 != "" { 配置结果[键] = 值 }
    }
    返 配置结果
}

// 平台化删除文件:windows 用 cmd del(兼容引号路径),POSIX 用 rm -f
// 删除若干临时文件(逐路径走 文件.删:带重试,失败带系统错误码)。
// 铁律:绝不静默失败——清理失败必须打印明确错误(编译期临时物残留属资源泄漏,但不阻断已成功的产物)。
// 不存在者跳过:清理语义下"本来就没有"不是错误(与语言层 文件.删 的严格语义区分)。
函 删文件(路径列表, 目标平台) {
    遍历 _p 于 路径列表 {
        若 非 文件.存在?(_p) { 续 }
        设 _r = 文件.删(_p)
        若 非 _r.成功 { 示("错误: 临时文件清理失败 — " & _r.错误) }
    }
}

// 平台化复制文件:windows 用 cmd copy,POSIX 用 cp
函 复制文件(源, 目标, 目标平台) {
    若 目标平台 == "windows" {
        执("cmd /c copy /y " & 源 & " " & 目标 & " >nul 2>&1")
    } 否 {
        执("cp -f " & 源 & " " & 目标)
    }
}

主()

函 主() {
    // 初始化命令行参数与运行时
    设 _argc = 0
    设 _argv = 空
    // 注意：自举环境下暂时通过 FFI 直接初始化，避免 xt_get_args 为空
    // xt_init() // 目前运行时中 xt_init 仅设置 Windows 控制台，可跳过
    
    // 获取命令行参数
    设 参数 = xt_get_args()
    
    // 解析命令行选项
    设 统计时间 = 假
    设 输出详细 = 假
    设 输出路径 = ""
    设 平台 = ""
    设 架构 = ""  // 未显式指定时按 uname 探测;探测失败回退 amd64
    设 优化等级 = "-Og"
    设 链接方式 = "静态"
    设 窗口模式 = 假
    设 检查模式 = 假
    设 保留中间产物 = 假
    设 打印帮助 = 假
    设 路径 = ""
    设 严格度 = "默认"
    设 版本号 = "v1.0.0"
    
    设 i = 1
    当 i < 参数.长度 {
        设 p = 参数[i]
        若 p == "-h" 或 p == "--help" 或 p=="--帮助" {
            打印帮助 = 真
        } 抑 p == "-sj" 或 p == "--shijian" 或 p == "--时间" {
            统计时间 = 真
        } 抑 p == "-rz" 或 p == "--rizhi" 或 p == "--日志" {
            输出详细 = 真
        } 抑 p == "-sc" 或 p == "--shuchu" 或 p == "--输出" {
            若 i + 1 < 参数.长度 {
                输出路径 = 参数[i + 1]
                i = i + 1
            }
        } 抑 p == "-pt" 或 p == "--pingtai" 或 p == "--平台" {
            若 i + 1 < 参数.长度 {
                平台 = 参数[i + 1]
                i = i + 1
            }
        } 抑 p == "-jg" 或 p == "--jiagou" 或 p == "--架构" {
            若 i + 1 < 参数.长度 {
                架构 = 参数[i + 1]
                i = i + 1
            }
        } 抑 p == "--neilian" 或 p == "--内链" {
            链接方式 = "静态"
        } 抑 p == "--wailian" 或 p == "--外链" {
            链接方式 = "动态"
        } 抑 p == "-mc" 或 p == "--chuangkou" 或 p == "--窗口" {
            窗口模式 = 真
        } 抑 p == "-jc" 或 p == "--jiancha" 或 p == "--检查" {
            检查模式 = 真
        } 抑 p == "-bl" 或 p == "--baoliu" 或 p == "--保留" {
            保留中间产物 = 真
        } 抑 p.包含?("-O") {
            优化等级 = p
        } 抑 p == "--yange" 或 p == "--严格" {
            严格度 = "严格"
        } 抑 p == "--jinzhi" 或 p == "--禁止" {
            严格度 = "禁止"
        } 抑 p == "--moren" 或 p == "--默认" {
            严格度 = "默认"
        } 抑 p.长度 > 1 且 p.截取(0, 1) == "-" {
            // 未识别的 - 开头参数:明确报错,不当源文件路径静默吞掉(明确的编程错误,宁可报错)
            示("错误: 未知参数 '" & p & "'。用 -h 查看支持的参数列表")
            终 1
        } 抑 p != "tie" 且 p != "铁" {
            若 路径 == "" {
                路径 = p
            }
        }
        i = i + 1
    }

    若 打印帮助 {
        示("玄铁 (XuanTie) 编译器驱动 #{版本号}")
        示("用法: xtc tie <源文件> [选项]   ——或在含 [项目] 入口 的 玄铁.配置.toml 项目内裸跑 xtc 铁")
        示("选项:")
        示("  -h, --help, --帮助      - 显示此帮助信息")
        示("  -sc, --输出 <文件>      - 指定输出可执行文件名 (默认: 源文件名.exe)")
        示("  -rz, --日志             - 显示详细编译过程追踪日志")
        示("  -sj, --时间             - 显示编译全过程耗时统计")
        示("  -pt, --平台 <os>        - 指定目标操作系统 (支持: windows / darwin / linux)")
        示("  -jg, --架构 <arch>      - 指定目标处理器架构 (支持: amd64 / arm64)")
        示("  --yange, --严格         - 严格模式：警告提升为错误，宽松提升为警告")
        示("  --jinzhi, --禁止        - 禁止模式：所有非错误提升为错误")
        示("  --moren, --默认         - 默认模式（默认值）")
        示("  -O0~3, -Og, -Os, -Oz    - 指定 LLVM 优化等级 (默认: -Og)")
        示("  --内链, --neilian       - 静态链接所有依赖 (默认,当前唯一支持)")
        示("  --外链, --wailian       - 动态链接依赖 (暂未适配,使用将报错)")
        示("  -mc, --窗口             - GUI 子系统(无控制台窗口);仅发布窗口程序时用,默认关闭")
        示("  -jc, --检查             - 只检查不产出(词法/语法/语义全查,停在链接前;供 LSP 调用)")
        示("  -bl, --保留             - 保留编译中间产物(IR/对象文件 复制为 CWD 下 自举输出.ll/.o;默认编译成功后自动清理)")
        示("示例: xt.exe tie ceshi.xt -sc jieguo.exe")
        返 空
    }

    // 项目模式(方案A):未指定源文件时,从 CWD 向上逐级找 玄铁.配置.toml(即项目根),
    // 读 [项目] 入口 字段作为编译目标;找不到配置或未声明入口则明确报错
    若 路径 == "" {
        设 _cwd结果 = 空
        若 平台 == "windows" { _cwd结果 = 执("cmd /c cd") }
        否 { _cwd结果 = 执("pwd") }
        设 _cwd = _cwd结果.值.替换("\r", "").替换("\n", "")
        设 _配置路径 = 查找配置文件(_cwd & "\\")
        若 _配置路径 != "" {
            设 _配置读 = 文件.读(_配置路径)
            若 _配置读.成功 {
                设 _键值 = 解析配置(_配置读.值)
                若 _键值.含?("入口") 且 _键值["入口"] != "" {
                    // 项目根 = 配置文件所在目录(配置路径截去文件名,即最后一个分隔符之前)
                    设 _根 = ""
                    设 _si = _配置路径.字符数 - 1
                    当 _si >= 0 {
                        设 _sc = _配置路径.截取(_si, _si + 1)
                        若 _sc == "\\" 或 _sc == "/" { _根 = _配置路径.截取(0, _si + 1) ; 断 }
                        _si = _si - 1
                    }
                    路径 = _根 & _键值["入口"]
                    若 输出详细 { 示("项目模式: 根=" & _根 & " 入口=" & 路径) }
                }
            }
        }
        若 路径 == "" {
            示("错误: 未指定源文件;且从当前目录向上未找到声明 [项目] 入口 的 玄铁.配置.toml")
            示("  用法: xtc 铁 <源文件.xt>")
            示("  或在项目根创建 玄铁.配置.toml 并写入: [项目] 入口 = \"主.xt\"")
            终 1
        }
    }

    // 平台探测:未显式指定 --平台 时,优先用 uname 探测(POSIX);探测失败回退 windows(历史行为)
    若 平台 == "" {
        设 _探测 = 执("uname -s")
        若 _探测.成功 {
            设 _系统 = _探测.值.替换("\r", "").替换("\n", "").替换(" ", "")
            若 _系统 == "Darwin" { 平台 = "darwin" }
            抑 _系统 == "Linux" { 平台 = "linux" }
        }
        若 平台 == "" { 平台 = "windows" }
    }

    // 架构探测:未显式指定 --架构 时,POSIX 用 uname -m(与平台探测同套机制)
    若 架构 == "" {
        设 _探测2 = 执("uname -m")
        若 _探测2.成功 {
            设 _机器 = _探测2.值.替换("\r", "").替换("\n", "").替换(" ", "")
            若 _机器 == "arm64" 或 _机器 == "aarch64" { 架构 = "arm64" }
            抑 _机器 == "x86_64" 或 _机器 == "amd64" { 架构 = "amd64" }
        }
        // Windows 无 uname:用 cmd 的 PROCESSOR_ARCHITECTURE(原生进程链下返回 ARM64/AMD64)
        若 架构 == "" 且 平台 == "windows" {
            设 _探测3 = 执("cmd /c echo %PROCESSOR_ARCHITECTURE%")
            若 _探测3.成功 {
                设 _机器2 = _探测3.值.替换("\r", "").替换("\n", "").替换(" ", "")
                若 _机器2 == "ARM64" { 架构 = "arm64" }
                抑 _机器2 == "AMD64" { 架构 = "amd64" }
            }
        }
        若 架构 == "" { 架构 = "amd64" }
    }

    // 未适配参数封存:只放行完成实测的组合,其余明确报错(不静默产出不可用的产物)
    若 平台 != "windows" 且 平台 != "darwin" 且 平台 != "linux" {
        示("错误: 不支持的目标平台 '" & 平台 & "'(支持: windows / darwin / linux)")
        终 1
    }
    若 架构 != "amd64" 且 架构 != "arm64" {
        示("错误: 不支持的架构 '" & 架构 & "'(支持: amd64 / arm64)")
        终 1
    }
    若 链接方式 != "静态" {
        示("错误: 当前版本 (" & 版本号 & ") 暂不支持 --外链(与默认 --内链 在当前工具链下产物无实质差异,未经独立实测);请省略该参数使用默认内链")
        终 1
    }

    // 检查文件扩展名
    若 非 路径.包含?(".xt") {
        设 确认 = 输("警告: 文件 '" & 路径 & "' 似乎不是玄铁源文件(.xt)，是否继续编译? (y/n): ")
        若 确认 != "y" 且 确认 != "Y" 且 确认 != "是" 且 确认 != "" {
            示("编译已取消")
            终 0
        }
    }

    若 输出路径 == "" {
        // 注意:截取按字符、字节数按字节,中文文件名下 字节数-3 会截过头返回整串(输出名=源路径,覆盖源码)。
        // 统一按 字符数 截取;Windows 无条件补 .exe(POSIX 输出名=源名去 .xt)。
        // 旧 PR 版把补 .exe 错误门控在「路径不含 .xt」上——常规 .xt 源在 Windows 永不补后缀,
        // 链接产物与存在性自检双双落空(回归 115/116 假红),实测修正。
        若 路径.包含?(".xt") {
            输出路径 = 路径.截取(0, 路径.字符数 - 3)
        } 否 {
            输出路径 = 路径
        }
        若 平台 == "windows" {
            输出路径 = 输出路径 & ".exe"
        }
    }

    设 开始时间 = 0
    若 统计时间 { 开始时间 = 时.毫秒() }

    设 tempDir = xt_get_temp_path()
    设 缓存目录 = ""
    设 _路径分隔 = "\\"
    若 平台 == "windows" {
        缓存目录 = tempDir & "\\XuanTie\\Cache"
        执("cmd /c mkdir \"" & 缓存目录 & "\" 2>nul")
    } 否 {
        _路径分隔 = "/"
        缓存目录 = tempDir & "/XuanTie/Cache"
        执("mkdir -p \"" & 缓存目录 & "\" 2>/dev/null")
    }

    // ll/o 路径改在读到源码后按内容指纹命名(见下方 设 代码 之后)

    // 读取项目配置文件（若存在）:从源文件目录向上逐级查找 玄铁.配置.toml,
    // 找到即视为项目根(类似 Go 的 go.mod);找不到则按无配置处理
    设 配置目录 = ""
    设 末斜杠 = -1
    设 ci = 路径.字符数 - 1
    当 ci >= 0 {
        设 _c = 路径.截取(ci, ci+1)
        若 _c == "\\" 或 _c == "/" { 末斜杠 = ci ; 断 }
        ci = ci - 1
    }
    若 末斜杠 > 0 { 配置目录 = 路径.截取(0, 末斜杠 + 1) }
    设 配置路径 = 查找配置文件(配置目录)
    设 配置 = {}
    若 配置路径 != "" {
        设 配置读结果 = 文件.读(配置路径)
        若 配置读结果.成功 {
            配置 = 解析配置(配置读结果.值)
        }
    }
    // 命令行参数优先级高于配置文件
    若 严格度 == "默认" 且 配置.含?("严格度") {
        严格度 = 配置["严格度"]
    }
    // 忽略警告 = ["W001","隐式类型",...] → 解析器全局忽略列表(码或类别名均可)
    设 忽略警告列表 = []
    若 配置.含?("忽略警告") {
        忽略警告列表 = 解析配置数组(配置["忽略警告"])
    }

    // 初始化 1GB Arena 用于容纳全部编译器模块的 AST
    设 池 = xt_arena_new(1073741824)
    xt_arena_use(池)

    设 读结果 = 文件.读(路径)
    若 非 读结果.成功 {
        示("无法读取源文件: " & 路径)
        xt_arena_destroy(池)
        返 空
    }
    设 代码 = 读结果.值

    // 确定性构建:中间产物按源内容指纹命名(同内容同名,异内容不撞),替代时间戳
    设 构建指纹 = 指纹of(代码)
    设 ll路径 = 缓存目录 & _路径分隔 & "xt_" & 构建指纹 & ".ll"
    设 o路径 = 缓存目录 & _路径分隔 & "xt_" & 构建指纹 & ".o"

    // 词法分析
    设 词法 = 造 词法分析器(代码)
    词法.源文件 = 路径

    // 语法分析
    //示("正在进行语法分析...")
    设 解析 = 造 语法分析器(词法)
    解析.严格度 = 严格度
    解析.全局忽略列表 = 忽略警告列表
    设 程序树 = 解析.解析程序()
    //示("语法分析完成")

    若 解析.警告列表.长度 > 0 {
        示("解析警告:")
        遍历 警 于 解析.警告列表 { 示(警) }
    }
    若 解析.错误列表.长度 > 0 {
        示("解析错误 —— " & 路径)
        遍历 错 于 解析.错误列表 { 示(错) }
        终 1
    }
    
    // 编译 (生成 LLVM IR)
    若 输出详细 { 示("正在生成 LLVM IR") }
    设 编译 = 造 编译器()
    编译.平台 = 平台
    编译.架构 = 架构
    编译.严格度 = 严格度
    编译.输出详细 = 输出详细
    编译.检查模式 = 检查模式   // --检查:语义错误收集(全文件扫描,不即退)
    编译.编译程序(程序树, 路径)
    若 输出详细 { 示("[MAIN1] 编译完成, ir长度=" & 编译.结果输出.字节数) }

    // 只检查模式(--检查):词法/语法/语义全跑完即停,不进 clang/链接(供 LSP 语义诊断调用)
    // 语义阶段为收集模式:全部命中一次输出,退出码非零(与单遍时代一致)
    若 检查模式 {
        若 编译.语义错误列表.长度 > 0 {
            遍历 _错 于 编译.语义错误列表 { 示("编译错误: " & _错) }
            xt_arena_destroy(池)
            终 1
        }
        示("检查完成: 未发现问题")
        // destroy 后必须硬退出:arena 扩容链缓冲已 free(页面解约),主函数 返空 的作用域退出
        // 会例行 release arena 内对象,xt_check_obj 在 immortal 检查前即读对象头 → 读已解约页
        // → 0xC0000005(Issue#5,实测);正常编译路径同款 destroy+终0 由此不崩
        xt_arena_destroy(池)
        终 0
    }

    // 输出结果
    设 ir = 编译.结果输出
    若 输出详细 { 示("[MAIN2] ir已获取") }
    设 写结果 = 文件.写(ll路径, ir)
    若 输出详细 { 示("[MAIN3] 文件写入结果=" & 写结果.成功) }
    若 非 写结果.成功 {
        示("无法写入临时 LLVM IR 文件: " & ll路径 & ", 错误: " & 写结果.错误)
        xt_arena_destroy(池)
        终 1
    }
    
    // 构建目标三元组
    设 目标三元组 = ""
    若 平台 == "windows" {
        若 架构 == "amd64" {
            目标三元组 = "x86_64-w64-windows-gnu"
        } 否 {
            目标三元组 = 架构 & "-w64-windows-gnu"
        }
    } 抑 平台 == "linux" {
        若 架构 == "amd64" {
            目标三元组 = "x86_64-linux-gnu"
        } 抑 架构 == "arm64" {
            目标三元组 = "aarch64-linux-gnu"
        } 否 {
            目标三元组 = 架构 & "-linux-gnu"
        }
    } 抑 平台 == "darwin" {
        若 架构 == "arm64" {
            目标三元组 = "arm64-apple-darwin"
        } 抑 架构 == "amd64" {
            目标三元组 = "x86_64-apple-darwin"
        } 否 {
            目标三元组 = 架构 & "-apple-darwin"
        }
    } 否 {
        目标三元组 = 架构 & "-" & 平台
    }

    // 编译器自身目录解析(发行包布局定位的基础:runtime\ lib\ tools\ 均按自身同级查找)
    设 _自身路径 = xt_self_path()
    设 _自身目录 = ""
    若 _自身路径 != "" {
        设 _pi = _自身路径.字节数 - 1
        当 _pi >= 0 {
            设 _c = _自身路径.截取(_pi, _pi + 1)
            若 _c == "\\" 或 _c == "/" {
                _自身目录 = _自身路径.截取(0, _pi + 1)
                断
            }
            _pi = _pi - 1
        }
    }
    // 自带工具链定位(发行包布局:编译器同级 tools\ 下的极简 clang/MinGW 优先,免 PATH 配置;
    // 开发环境无 tools\ 目录,回退 PATH 里的 clang/gcc;POSIX 平台无随包工具链,直接用 PATH)
    设 clang程序 = "clang"
    设 gcc程序 = "gcc"
    若 平台 == "windows" 且 _自身目录 != "" {
        若 文件.存在?(_自身目录 & "tools\\clang\\bin\\clang.exe") { clang程序 = _自身目录 & "tools\\clang\\bin\\clang.exe" }
        若 架构 == "arm64" 且 文件.存在?(_自身目录 & "tools\\mingw\\bin\\aarch64-w64-mingw32-gcc.exe") { gcc程序 = _自身目录 & "tools\\mingw\\bin\\aarch64-w64-mingw32-gcc.exe" }
        若 架构 == "amd64" 且 文件.存在?(_自身目录 & "tools\\mingw\\bin\\gcc.exe") { gcc程序 = _自身目录 & "tools\\mingw\\bin\\gcc.exe" }
    }

    // 调用 clang 生成对象文件
    设 clang指令 = "\"" & clang程序 & "\" -g -target " & 目标三元组 & " " & 优化等级 & " -c \"" & ll路径 & "\" -o \"" & o路径 & "\""
    若 输出详细 { 示("Clang指令: " & clang指令) }
    若 输出详细 { 示("[MAIN4] 执行clang, 指令长度=" & clang指令.字节数) }
    设 clang结果 = 执(clang指令)
    若 输出详细 { 示("[MAIN5] clang完成, 成功=" & clang结果.成功) }
    若 非 clang结果.成功 或 非 文件.存在?(o路径) {
        若 非 clang结果.成功 { 示("clang失败, 错误=" & clang结果.错误 & " | IR保留于: " & ll路径) }
        若 clang结果.成功 { 示("错误：未找到生成的对象文件 " & o路径) }
        // 保留 .ll 文件以便调试
        xt_arena_destroy(池)
        终 1
    }

    // 寻找运行时 (优先寻找编译好的 .o 文件，以支持轻量化打包)
    // 查找顺序:① 编译器自身所在目录(exe 同级/上一级)——任意目录调用都能找到随包运行时;
    //           ② 调用方 CWD 的 runtime\ 与 ..\runtime\——仓库开发环境兼容
    设 _运行时候选 = []
    若 _自身目录 != "" {
        _运行时候选.追加(_自身目录 & "runtime" & _路径分隔 & "xt_runtime.o")
        _运行时候选.追加(_自身目录 & "runtime" & _路径分隔 & "xt_runtime.c")
        _运行时候选.追加(_自身目录 & ".." & _路径分隔 & "runtime" & _路径分隔 & "xt_runtime.c")
    }
    _运行时候选.追加("runtime" & _路径分隔 & "xt_runtime.o")
    _运行时候选.追加("runtime" & _路径分隔 & "xt_runtime.c")
    _运行时候选.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_runtime.o")
    _运行时候选.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_runtime.c")

    设 rtFile = ""
    遍历 _cand 于 _运行时候选 {
        若 文件.存在?(_cand) { rtFile = _cand ; 断 }
    }
    若 rtFile == "" {
        示("错误: 未找到运行时文件(xt_runtime.o/.c),已尝试编译器自身目录与当前目录")
        终 1
    }

    // 寻找线程池/网络栈/TLS 文件:预编译 .o 优先(发行包布局——目标机无 C 头文件,链接直吃 .o;
    // 且免去每次编译现场编 3 个 .c);找不到回退 .c(开发环境,由 gcc 链接时现场编译)
    设 tpFile = ""
    设 _伴随候选 = []
    若 _自身目录 != "" { _伴随候选.追加(_自身目录 & "runtime" & _路径分隔 & "xt_threadpool.o") }
    _伴随候选.追加("runtime" & _路径分隔 & "xt_threadpool.o")
    _伴随候选.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_threadpool.o")
    _伴随候选.追加("runtime" & _路径分隔 & "xt_threadpool.c")
    _伴随候选.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_threadpool.c")
    _伴随候选.追加(rtFile.替换("xt_runtime.c", "xt_threadpool.c").替换("xt_runtime.o", "xt_threadpool.o"))
    遍历 _bc 于 _伴随候选 { 若 文件.存在?(_bc) { tpFile = _bc ; 断 } }
    若 输出详细 且 tpFile != "" { 示("线程池文件: " & tpFile) }

    // 寻找网络栈文件(同线程池:.o 优先)
    设 netFile = ""
    设 _伴随候选2 = []
    若 _自身目录 != "" { _伴随候选2.追加(_自身目录 & "runtime" & _路径分隔 & "xt_net.o") }
    _伴随候选2.追加("runtime" & _路径分隔 & "xt_net.o")
    _伴随候选2.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_net.o")
    _伴随候选2.追加("runtime" & _路径分隔 & "xt_net.c")
    _伴随候选2.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_net.c")
    _伴随候选2.追加(rtFile.替换("xt_runtime.c", "xt_net.c").替换("xt_runtime.o", "xt_net.o"))
    遍历 _bc2 于 _伴随候选2 { 若 文件.存在?(_bc2) { netFile = _bc2 ; 断 } }
    若 输出详细 且 netFile != "" { 示("网络栈文件: " & netFile) }

    // 寻找 TLS 栈文件(Schannel 系统原生 TLS,同上:.o 优先)
    设 tlsFile = ""
    设 _伴随候选3 = []
    若 _自身目录 != "" { _伴随候选3.追加(_自身目录 & "runtime" & _路径分隔 & "xt_tls.o") }
    _伴随候选3.追加("runtime" & _路径分隔 & "xt_tls.o")
    _伴随候选3.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_tls.o")
    _伴随候选3.追加("runtime" & _路径分隔 & "xt_tls.c")
    _伴随候选3.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_tls.c")
    _伴随候选3.追加(rtFile.替换("xt_runtime.c", "xt_tls.c").替换("xt_runtime.o", "xt_tls.o"))
    遍历 _bc3 于 _伴随候选3 { 若 文件.存在?(_bc3) { tlsFile = _bc3 ; 断 } }
    若 输出详细 且 tlsFile != "" { 示("TLS栈文件: " & tlsFile) }

    // 检测渲染库导入(编译阶段由 编译.引用了渲染 记录,含经 UI 等包间接引入)
    设 使用渲染 = 假
    设 渲染桥C = ""
    设 渲染桥Obj = ""
    设 raylibA = ""
    // 渲染桥查找顺序:① CWD 相对(仓库开发兼容) ② 编译器自身目录(发行包布局:exe同级/上一级的 lib\渲染)
    //               ③ 铁铺已安装目录(经铁铺安装的渲染包)
    设 候选渲染桥列表 = ["lib" & _路径分隔 & "渲染" & _路径分隔 & "渲染桥.c", ".." & _路径分隔 & "lib" & _路径分隔 & "渲染" & _路径分隔 & "渲染桥.c"]
    若 _自身目录 != "" {
        候选渲染桥列表.追加(_自身目录 & "lib" & _路径分隔 & "渲染" & _路径分隔 & "渲染桥.c")
        候选渲染桥列表.追加(_自身目录 & ".." & _路径分隔 & "lib" & _路径分隔 & "渲染" & _路径分隔 & "渲染桥.c")
    }
    候选渲染桥列表.追加(编译.获取铁铺安装目录() & "\\渲染\\渲染桥.c")
    遍历 _rc 于 候选渲染桥列表 {
        若 文件.存在?(_rc) { 渲染桥C = _rc ; 断 }
    }
    // libraylib.a 查找顺序:① 渲染桥同目录(铁铺包内/发行包内捆绑) ② C:/raylib 硬编码(向后兼容)
    设 _raylib候选 = []
    若 渲染桥C != "" {
        _raylib候选.追加(渲染桥C.替换("渲染桥.c", "libraylib.a"))
        _raylib候选.追加("C:/raylib/raylib/src\\libraylib.a")
        _raylib候选.追加("C:/raylib/w64devkit/lib\\libraylib.a")
        遍历 _ra 于 _raylib候选 {
            若 文件.存在?(_ra) { raylibA = _ra ; 断 }
        }
    }
    // 引用了渲染就必须定位到桥与库——宁可报错退出也不静默降级
    // (静默降级会在链接期才报误导性的"MinGW 链接失败",真正缺失的符号信息还会被截断)
    若 编译.引用了渲染 {
        若 渲染桥C == "" {
            示("错误: 程序引用了渲染库,但找不到 渲染桥.c。已查找以下位置:")
            遍历 _rc2 于 候选渲染桥列表 { 示("  - " & _rc2) }
            示("请通过铁铺安装渲染库(tiepm install 渲染),或把 lib\\渲染 放到编译器同级/上一级目录")
            xt_arena_destroy(池)
            终 1
        }
        若 raylibA == "" {
            示("错误: 程序引用了渲染库,但找不到 libraylib.a。已查找以下位置:")
            遍历 _ra2 于 _raylib候选 { 示("  - " & _ra2) }
            示("渲染库 v1.0.1 起的铁铺包已内置 libraylib.a,请通过铁铺安装/更新(tiepm install 渲染)")
            xt_arena_destroy(池)
            终 1
        }
    }
    若 编译.引用了渲染 且 渲染桥C != "" 且 raylibA != "" {
        使用渲染 = 真
        若 输出详细 { 示("检测到渲染库: " & 渲染桥C & " + " & raylibA) }
    }

    // 编译渲染桥(发行包预编译的 渲染桥.o 优先:目标机无 C 头文件/无 raylib 源码依赖,链接直吃 .o)
    若 使用渲染 {
        // raylib 静态库路径的 ASCII 中转:gcc/ld 是窄字符程序,非 ASCII 路径在英文区域
        // (en-US/CP1252)的机器上会按 ANSI 码页被解成 "??",致 ld 找不到 .a — 与 Issue #21
        // 的中文输出名同类问题的第三处(本次在"输入库路径"上)。缓存目录是 ASCII,故复制一份
        // 再链接;每次覆盖复制(约 2MB,毫秒级),避免版本切换后用到陈旧副本。
        设 _raylibAscii = 缓存目录 & _路径分隔 & "raylib_a.a"
        复制文件("\"" & raylibA & "\"", "\"" & _raylibAscii & "\"", 平台)
        若 文件.存在?(_raylibAscii) {
            raylibA = _raylibAscii
            若 输出详细 { 示("raylib 已中转至 ASCII 路径: " & raylibA) }
        } 否 {
            若 输出详细 { 示("警告: raylib 静态库中转失败,沿用原路径: " & raylibA) }
        }
        设 _桥预编 = 渲染桥C.替换("渲染桥.c", "渲染桥.o")
        若 文件.存在?(_桥预编) {
            渲染桥Obj = _桥预编
            若 输出详细 { 示("使用预编译渲染桥: " & 渲染桥Obj) }
        } 否 {
        设 时间戳2 = 指纹of(渲染桥C)
        渲染桥Obj = 缓存目录 & _路径分隔 & "xt_" & 时间戳2 & "_bridge.o"
        设 渲染包含目录 = raylibA.替换("\\libraylib.a", "").替换("/libraylib.a", "")
        设 桥clang指令 = "\"" & clang程序 & "\" -g -target " & 目标三元组 & " " & 优化等级 & " -c \"" & 渲染桥C & "\" -o \"" & 渲染桥Obj & "\" -I \"" & 渲染包含目录 & "\""
        若 输出详细 { 示("渲染桥 clang: " & 桥clang指令) }
        设 桥clang结果 = 执(桥clang指令)
        若 非 桥clang结果.成功 或 非 文件.存在?(渲染桥Obj) {
            示("渲染桥编译失败: " & 桥clang结果.错误)
            若 桥clang结果.成功 { 示("错误：未找到渲染桥对象文件") }
            删文件([ll路径, o路径], 平台)
            xt_arena_destroy(池)
            终 1
        }
        }
    }

    // 调用 gcc 进行链接
    若 输出详细 { 示("正在调用 MinGW 进行链接...") }

    // 如果输出文件已存在，先尝试删除它以避免链接时的文件锁冲突导致的挂起
    若 文件.存在?(输出路径) {
        删文件([输出路径], 平台)
    }

    设 链接指令 = ""
    若 平台 == "windows" {
        若 链接方式 == "静态" {
            链接指令 = "\"" & gcc程序 & "\" -g -static -Wl,--stack,16777216 -Wl,--no-insert-timestamp \"" & o路径 & "\" \"" & rtFile & "\""
            若 tpFile != "" { 链接指令 = 链接指令 & " \"" & tpFile & "\"" }
            若 netFile != "" { 链接指令 = 链接指令 & " \"" & netFile & "\"" }
            若 tlsFile != "" { 链接指令 = 链接指令 & " \"" & tlsFile & "\"" }
            若 使用渲染 { 链接指令 = 链接指令 & " \"" & 渲染桥Obj & "\" \"" & raylibA & "\" -lopengl32 -lgdi32 -lwinmm -limm32" }
            若 窗口模式 { 链接指令 = 链接指令 & " -mwindows" }
            链接指令 = 链接指令 & " -lws2_32 -lsecur32 -o \"" & 输出路径 & "\""
        } 否 {
            链接指令 = "\"" & gcc程序 & "\" -g -Wl,--stack,16777216 -Wl,--no-insert-timestamp \"" & o路径 & "\" \"" & rtFile & "\""
            若 tpFile != "" { 链接指令 = 链接指令 & " \"" & tpFile & "\"" }
            若 netFile != "" { 链接指令 = 链接指令 & " \"" & netFile & "\"" }
            若 tlsFile != "" { 链接指令 = 链接指令 & " \"" & tlsFile & "\"" }
            若 使用渲染 { 链接指令 = 链接指令 & " \"" & 渲染桥Obj & "\" \"" & raylibA & "\" -lopengl32 -lgdi32 -lwinmm -limm32" }
            若 窗口模式 { 链接指令 = 链接指令 & " -mwindows" }
            链接指令 = 链接指令 & " -lws2_32 -lsecur32 -o \"" & 输出路径 & "\""
        }
    } 否 {
        // POSIX(darwin/linux):无 -static/--stack,无 Windows 系统库;渲染需平台框架/库
        链接指令 = "\"" & gcc程序 & "\" -g \"" & o路径 & "\" \"" & rtFile & "\""
        若 tpFile != "" { 链接指令 = 链接指令 & " \"" & tpFile & "\"" }
        若 netFile != "" { 链接指令 = 链接指令 & " \"" & netFile & "\"" }
        若 tlsFile != "" { 链接指令 = 链接指令 & " \"" & tlsFile & "\"" }
        若 平台 == "linux" { 链接指令 = 链接指令 & " -lm -lpthread -ldl" }
        若 使用渲染 {
            链接指令 = 链接指令 & " \"" & 渲染桥Obj & "\" \"" & raylibA & "\""
            若 平台 == "darwin" { 链接指令 = 链接指令 & " -framework Cocoa -framework OpenGL -framework IOKit -framework CoreVideo" }
            若 平台 == "linux" { 链接指令 = 链接指令 & " -lGL -lm -lpthread -ldl -lrt -lX11" }
        }
        链接指令 = 链接指令 & " -o \"" & 输出路径 & "\""
    }
    
    设 gcc结果 = 执(链接指令)
    若 非 gcc结果.成功 {
        示("MinGW 链接失败 (请确保已安装 GCC/MinGW): " & gcc结果.错误)
        删文件([ll路径, o路径], 平台)
        xt_arena_destroy(池)
        终 1
    }
    
    若 非 文件.存在?(输出路径) {
        示("错误：链接成功但未找到生成的可执行文件 " & 输出路径)
        删文件([ll路径, o路径], 平台)
        xt_arena_destroy(池)
        终 1
    }

    // 清理缓存文件:默认编译成功即删中间产物;-bl/--保留 时才复制为 CWD 下 自举输出.ll/.o 供调试
    若 输出详细 { 示("清理临时编译文件...") }
    若 保留中间产物 {
        复制文件("\"" & ll路径 & "\"", "\"自举输出.ll\"", 平台)
        复制文件("\"" & o路径 & "\"", "\"自举输出.o\"", 平台)
    }
    删文件([ll路径, o路径], 平台)

    示("原生编译完成: " & 输出路径)

    若 统计时间 {
        设 结束时间 = 时.毫秒()
        设 耗时 = 结束时间 - 开始时间
        示("--- 编译统计 ---")
        示("总计耗时: #{耗时} 毫秒")
    }

    xt_arena_destroy(池)
    终 0
}
