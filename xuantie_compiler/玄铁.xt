// xuantie_compiler/入口.xt
// 玄铁自举编译器 - 入口程序

引 "词法.xt"
引 "抽象语法树.xt"
引 "语法分析.xt"

引 "编译.xt"

// 引入运行时 FFI
外 函 xt_arena_new(大小: 整): 整
外 函 xt_arena_use(池: 整): 整
外 函 xt_arena_destroy(池: 整): 整
外 函 xt_get_args(): 数组
外 函 xt_run_inherit_exit(可执行: 字, 参数表: 数组, 清理路径: 字)   // 继承控制台运行→清理→按退出码结束本进程(跑/pao 用)
外 函 xt_get_temp_path(): 字
外 函 xt_self_path(): 字
外 函 xt_cwd(): 字   // runtime 内建:取当前工作目录绝对路径(项目模式定位项目根用;语义同 pwd,不再 spawn 子进程)

// FNV-1a 32 位内容指纹:确定性构建的临时文件命名依据——同内容同名(覆盖写无碍),
// 异内容不撞名;替代原先 时.毫秒() 时间戳(会经 -g 调试信息渗入产物,破坏字节级复现)
函 指纹of(文本) {
    设 h = 2166136261
    设 i = 0
    当 i < 文本.字节数 {
        设 t = (h 异或 文本.字节(i)) * 16777619
        h = t 位与 4294967295
        i = i + 1
    }
    返 h
}

// 从起始目录向上逐级查找 玄铁.配置.toml(找到即项目根,类似 go.mod);找不到返 ""
// 注意:全程用 字符数(字符索引)而非 字节数——中文目录名下字节数!=字符数,混用会死循环
// 入参可以是"目录"或"带尾分隔符的目录":本函数自己补分隔符。
// (曾隐式要求调用方必须带尾分隔符——查 & "玄铁.配置.toml" 直接串接;项目模式改成
//  传 xt_cwd() 的裸目录后,试路径变成 "...\pmverify玄铁.配置.toml",查找全程落空且
//  报"未找到配置文件"。契约放在被调方,调用方就不必记得补,也不会有人硬编码 "\")
函 查找配置文件(起始目录) {
    设 查 = 起始目录
    若 查 != "" {
        设 尾 = 查.截取(查.字符数 - 1, 查.字符数)
        // 分隔符按路径自身判定:原先硬编码 "\\" 的写法在 POSIX 上拼出
        // "…/proj\\玄铁.配置.toml",项目根自身的配置永远命中不了;
        // 子目录之所以"能用",是因为爬升到上一级时拼的正是路径里原有的 "/"。
        设 _分 = "\\"
        若 查.包含?("/") 且 非 查.包含?("\\") { _分 = "/" }
        若 尾 != "\\" 且 尾 != "/" { 查 = 查 & _分 }
    }
    循 {
        设 试 = 查 & "玄铁.配置.toml"
        若 文件.存在?(试) { 返 试 }
        若 查 == "" { 返 "" }
        // 去掉末级目录(兼容 \ 与 /)
        设 去尾 = 查
        设 尾字 = 去尾.截取(去尾.字符数 - 1, 去尾.字符数)
        若 尾字 == "\\" 或 尾字 == "/" { 去尾 = 去尾.截取(0, 去尾.字符数 - 1) }
        设 再斜 = -1
        设 i = 去尾.字符数 - 1
        当 i >= 0 {
            设 c = 去尾.截取(i, i + 1)
            若 c == "\\" 或 c == "/" { 再斜 = i ; 断 }
            i = i - 1
        }
        若 再斜 < 0 { 返 "" }
        查 = 去尾.截取(0, 再斜 + 1)
    }
    返 ""
}

// 解析配置里的数组值:["W001","隐式类型"] → ["W001","隐式类型"]
函 解析配置数组(串) {
    设 出 = []
    设 体 = 串.替换("[", "").替换("]", "")
    遍历 项 于 体.分割(",") {
        设 净 = 项.替换(" ", "").替换("\t", "")
        若 净 != "" { 出.追加(净) }
    }
    返 出
}

函 解析配置(内容) {
    设 配置结果 = {}
    设 行列表 = 内容.分割("\n")
    设 当前节 = ""
    遍历 原始行 于 行列表 {
        设 行 = 原始行.替换("\r", "")
        // 节标题:记录当前节,同时保留节名限定键(如 「原生.源」)——issue #123 项目级原生 C 源
        若 行.截取(0,1) == "[" {
            设 _节体 = 行.替换("[", "").替换("]", "").替换(" ", "").替换("\t", "")
            当前节 = _节体
            续
        }
        // 跳过空行、注释
        若 行 == "" 或 行.截取(0,1) == "#" { 续 }
        若 非 行.包含?("=") { 续 }
        // 找到 = 的位置
        设 等号位 = 0
        设 ci = 0
        当 ci < 行.字节数 { 若 行.截取(ci, ci+1) == "=" { 等号位 = ci ; 断 } ; ci = ci + 1 }
        // 提取键和值（去除=左右的空格）
        设 键 = 行.截取(0, 等号位).替换(" ", "").替换("\t", "")
        设 值 = 行.截取(等号位 + 1, 行.字节数).替换(" ", "").替换("\t", "").替换("\"", "").替换("\"", "")
        若 键 != "" {
            配置结果[键] = 值
            // 节限定键:同名键在不同节里不冲突(旧代码仍用裸键,行为不变)
            若 当前节 != "" { 配置结果[当前节 & "." & 键] = 值 }
        }
    }
    返 配置结果
}

// 平台化删除文件:windows 用 cmd del(兼容引号路径),POSIX 用 rm -f
// 删除若干临时文件(逐路径走 文件.删:带重试,失败带系统错误码)。
// 铁律:绝不静默失败——清理失败必须打印明确错误(编译期临时物残留属资源泄漏,但不阻断已成功的产物)。
// 不存在者跳过:清理语义下"本来就没有"不是错误(与语言层 文件.删 的严格语义区分)。
函 删文件(路径列表, 目标平台) {
    遍历 _p 于 路径列表 {
        若 非 文件.存在?(_p) { 续 }
        设 _r = 文件.删(_p)
        若 非 _r.成功 { 示("错误: 临时文件清理失败 — " & _r.错误) }
    }
}

// 平台化复制文件:windows 用 cmd copy,POSIX 用 cp
函 复制文件(源, 目标, 目标平台) {
    若 目标平台 == "windows" {
        执("cmd /c copy /y " & 源 & " " & 目标 & " >nul 2>&1")
    } 否 {
        执("cp -f " & 源 & " " & 目标)
    }
}

// 编译器自身目录(含末尾分隔符):runtime/、lib/、tools/、MANIFEST.txt 均按此同级查找。
// 发行包里编译器被移到任意目录后,一切配套资源都靠它定位;取不到时返空串,调用方据此回退。
函 自身目录() {
    设 _路径 = xt_self_path()
    若 _路径 == "" { 返 "" }
    设 _i = _路径.字节数 - 1
    当 _i >= 0 {
        设 _c = _路径.截取(_i, _i + 1)
        若 _c == "\\" 或 _c == "/" {
            返 _路径.截取(0, _i + 1)
        }
        _i = _i - 1
    }
    返 ""
}

// ── 自更新:xtc 升级 / xtc sj(下载官方发行包 → 校验 → 原地覆盖)──────────────
// 只认官方发行包(tar.gz);--国内 改走 Gitee 镜像(需该仓有同名 release 资产)。
函 升级资产名(平台, 架构) {
    若 平台 == "darwin" {
        若 架构 == "arm64" { 返 "darwin_arm64" }
        返 ""
    }
    若 平台 == "linux" {
        若 架构 == "arm64" { 返 "linux_arm64" }
        返 "linux_x86_64"
    }
    若 平台 == "windows" {
        若 架构 == "arm64" { 返 "windows_arm64" }
        返 "windows_amd64"
    }
    返 ""
}

函 升级分隔(平台) {
    若 平台 == "windows" { 返 "\\" }
    返 "/"
}

函 升级清目录(平台, 路径) {
    若 平台 == "windows" {
        执("cmd /c rmdir /s /q \"" & 路径 & "\" >nul 2>&1")
    } 否 {
        执("rm -rf \"" & 路径 & "\" >/dev/null 2>&1")
    }
}

// 建目录/移动走 shell:GSC(种子编译器)尚未注册 文件.建目录/文件.移动,
// 驱动源码必须同时能被 GSC 编译,故这里不依赖那两个新 API。
函 升级建目录(平台, 路径) {
    若 平台 == "windows" { 返 执("cmd /c mkdir \"" & 路径 & "\" >nul 2>&1") }
    返 执("mkdir -p \"" & 路径 & "\"")
}

函 升级移动(平台, 源, 目标) {
    若 平台 == "windows" { 返 执("cmd /c move /y \"" & 源 & "\" \"" & 目标 & "\" >nul 2>&1") }
    返 执("mv -f \"" & 源 & "\" \"" & 目标 & "\"")
}

// 从 release JSON 里取 "tag_name"(GitHub 的 JSON 在冒号后带空格,Gitee 不带,故按结构解析)
函 升级解析标签(体) {
    设 _i = 体.寻找("\"tag_name\"")
    若 _i < 0 { 返 "" }
    设 _冒 = 体.寻找(":", _i)
    若 _冒 < 0 { 返 "" }
    设 _引 = 体.寻找("\"", _冒)
    若 _引 < 0 { 返 "" }
    设 _起 = _引 + 1
    设 _尾 = 体.寻找("\"", _起)
    若 _尾 < 0 { 返 "" }
    返 体.截取(_起, _尾)
}

// 取最新版本号(含 v 前缀);失败返空串,由调用方明确报错。
// 注:不走 `curl -w "%{...}"` —— 执 在 Windows 下经批处理层,% 号会破坏命令。
函 升级最新版本(平台, 国内) {
    若 国内 {
        设 _r = 执("curl -sSL --max-time 25 \"https://gitee.com/api/v5/repos/MARKJY-China/XuanTie-Lang/releases/latest\"")
        若 非 _r.成功 { 返 "" }
        返 升级解析标签(_r.值)
    }
    设 _r2 = 执("curl -sSL --max-time 25 \"https://api.github.com/repos/MARKJY-China/XuanTie-Lang/releases/latest\"")
    若 非 _r2.成功 { 返 "" }
    返 升级解析标签(_r2.值)
}

函 升级下载地址(国内, 版本, 资产) {
    设 _文 = "xuantie_" & 版本 & "_" & 资产 & ".tar.gz"
    若 国内 {
        返 "https://gitee.com/MARKJY-China/XuanTie-Lang/releases/download/" & 版本 & "/" & _文
    }
    返 "https://github.com/MARKJY-China/XuanTie-Lang/releases/download/" & 版本 & "/" & _文
}

// 原地覆盖:先重命名正在运行的 xtc(Windows 允许改名运行中的 exe),再整树复制。
函 升级覆盖(平台, 新目录, 安装目录) {
    若 平台 == "windows" {
        设 _旧 = 安装目录 & "xtc.exe.old"
        若 文件.存在?(_旧) { 执("cmd /c del /f /q \"" & _旧 & "\" >nul 2>&1") }
        设 _移 = 升级移动(平台, 安装目录 & "xtc.exe", _旧)
        若 非 _移.成功 {
            示("错误: 无法重命名当前 xtc.exe(可能被占用): " & _移.值)
            返 假
        }
        设 _复 = 执("powershell -NoProfile -Command \"Copy-Item -Path '" & 新目录 & "\\*' -Destination '" & 安装目录 & "' -Recurse -Force\"")
        若 非 _复.成功 {
            示("错误: 覆盖安装目录失败: " & _复.值)
            返 假
        }
        执("cmd /c del /f /q \"" & _旧 & "\" >nul 2>&1")
        返 真
    }
    设 _旧2 = 安装目录 & "xtc.old"
    若 文件.存在?(_旧2) { 文件.删(_旧2) }
    设 _移2 = 升级移动(平台, 安装目录 & "xtc", _旧2)
    若 非 _移2.成功 {
        示("错误: 无法移动当前 xtc: " & _移2.值)
        返 假
    }
    设 _复2 = 执("cp -Rf \"" & 新目录 & "/.\" \"" & 安装目录 & "/\"")
    若 非 _复2.成功 {
        示("错误: 覆盖安装目录失败: " & _复2.值)
        返 假
    }
    执("rm -f \"" & _旧2 & "\" >/dev/null 2>&1")
    返 真
}

// 国内升级源:文档站 API 返回 latest.json(平台 → ROS 下载链接 + sha256)
函 升级拉取国内清单(源) {
    设 _r = 执("curl -sSL --max-time 20 \"" & 源 & "\"")
    若 非 _r.成功 { 返 "" }
    返 _r.值
}

// 返回 0 表示成功(仅检查也算成功)。
函 执行升级(平台, 架构, 只检查, 国内, 强制, 目标目录, 当前版本, 源) {
    设 _资产 = 升级资产名(平台, 架构)
    若 _资产 == "" {
        示("错误: 平台 " & 平台 & "/" & 架构 & " 暂无官方发行包")
        返 1
    }
    设 _最新 = ""
    设 _地址 = ""
    若 国内 {
        示("检查更新(来源: " & 源 & ")…")
        设 _清单 = 升级拉取国内清单(源)
        若 _清单 == "" {
            示("错误: 无法获取 latest.json(" & 源 & ")")
            返 1
        }
        设 _数 = 解(_清单)
        若 _数 == 空 或 非 _数.包含?("version") 或 非 _数.包含?("platforms") {
            示("错误: latest.json 格式不正确(需含 version / platforms)")
            返 1
        }
        _最新 = 字(_数["version"])
        设 _台表 = _数["platforms"]
        若 非 _台表.包含?(_资产) {
            示("错误: latest.json 中没有该平台的发行包(" & _资产 & ")")
            返 1
        }
        设 _项 = _台表[_资产]
        若 非 _项.包含?("url") {
            示("错误: latest.json 的 " & _资产 & " 缺少 url")
            返 1
        }
        _地址 = 字(_项["url"])
    } 否 {
        示("检查更新(来源: GitHub)…")
        _最新 = 升级最新版本(平台, 假)
        若 _最新 == "" {
            示("错误: 无法获取最新版本(GitHub API 不可达)")
            示("  提示: 中国大陆网络请使用 --国内(文档站 + 雨云 ROS)")
            返 1
        }
        _地址 = 升级下载地址(假, _最新, _资产)
    }
    示("当前版本: " & 当前版本 & "    最新版本: " & _最新)
    若 只检查 { 返 0 }
    若 _最新 == 当前版本 且 非 强制 {
        示("已是最新版本;要强制重装请加 --强制")
        返 0
    }
    设 _安装 = 目标目录
    若 _安装 == "" { _安装 = 自身目录() }
    若 _安装 == "" {
        示("错误: 无法定位安装目录,请用 --目录 指定")
        返 1
    }
    设 _尾字 = _安装.截取(_安装.字符数 - 1, _安装.字符数)
    若 _尾字 != "\\" 且 _尾字 != "/" { _安装 = _安装 & 升级分隔(平台) }
    设 _分 = 升级分隔(平台)
    设 _临时 = _安装 & ".update"
    升级清目录(平台, _临时)
    设 _建 = 升级建目录(平台, _临时)
    若 非 _建.成功 {
        示("错误: 无法创建临时目录 " & _临时 & ": " & _建.错误)
        返 1
    }
    设 _压缩 = _临时 & _分 & "pkg.tar.gz"
    示("下载: " & _地址)
    设 _下 = 执("curl -fL --retry 2 --max-time 300 -o \"" & _压缩 & "\" \"" & _地址 & "\"")
    若 非 _下.成功 {
        示("错误: 下载失败: " & _下.值 & _下.错误)
        若 非 国内 { 示("  提示: 中国大陆网络可能无法直连 GitHub 资产,请改用 --国内(文档站 latest.json + 雨云 ROS)") }
        升级清目录(平台, _临时)
        返 1
    }
    设 _解 = 执("tar -xzf \"" & _压缩 & "\" -C \"" & _临时 & "\"")
    若 非 _解.成功 {
        示("错误: 解压失败: " & _解.值)
        升级清目录(平台, _临时)
        返 1
    }
    设 _新 = _临时 & _分 & "XuanTie"
    设 _可 = _新 & _分 & "xtc"
    若 平台 == "windows" { _可 = _可 & ".exe" }
    若 非 文件.存在?(_可) {
        示("错误: 解压后未找到 xtc(" & _可 & ")")
        升级清目录(平台, _临时)
        返 1
    }
    设 _验 = 执("\"" & _可 & "\" -V")
    若 非 _验.成功 或 非 _验.值.包含?(_最新) {
        示("错误: 新版本自检失败(" & _验.值 & ");未改动安装目录")
        升级清目录(平台, _临时)
        返 1
    }
    示("覆盖安装目录: " & _安装)
    若 非 升级覆盖(平台, _新, _安装) {
        升级清目录(平台, _临时)
        返 1
    }
    升级清目录(平台, _临时)
    设 _新可 = _安装 & "xtc"
    若 平台 == "windows" { _新可 = _新可 & ".exe" }
    设 _末 = 执("\"" & _新可 & "\" -V")
    若 _末.成功 { 示("升级完成: " & _末.值.去首尾空格()) } 否 { 示("升级完成,但版本自检失败: " & _末.值) }
    返 0
}

主()

函 主() {
    // 初始化命令行参数与运行时
    设 _argc = 0
    设 _argv = 空
    // 注意：自举环境下暂时通过 FFI 直接初始化，避免 xt_get_args 为空
    // xt_init() // 目前运行时中 xt_init 仅设置 Windows 控制台，可跳过
    
    // 获取命令行参数
    设 参数 = xt_get_args()
    
    // 解析命令行选项
    设 统计时间 = 假
    设 输出详细 = 假
    设 输出路径 = ""
    设 平台 = ""
    设 平台显式 = 假  // issue #105:区分「用户显式 -pt」与「宿主自动探测」——后者恒等于宿主，不需要交叉编译检查
    设 架构 = ""  // 未显式指定时按 uname 探测;探测失败回退 amd64
    设 优化等级 = "-Og"
    设 链接方式 = "静态"
    设 窗口模式 = 假
    设 检查模式 = 假
    设 保留中间产物 = 假
    设 打印帮助 = 假
    设 路径 = ""
    设 严格度 = "默认"
    设 跑模式 = 假            // pao/跑:编译后立即运行(go run 语义)
    设 程序参数 = []           // `--` 之后的参数原样透传给被运行的程序
    设 收程序参数 = 假
    设 版本号 = "v1.0-rc.4"
    设 升级模式 = 假
    设 升级只检查 = 假
    设 升级国内 = 假
    设 升级强制 = 假
    设 升级目标 = ""
    设 升级源 = "https://xuantie.markjy.com/api/latest.json"
    
    设 i = 1
    当 i < 参数.长度 {
        设 p = 参数[i]
        若 收程序参数 {
            程序参数.追加(p)          // `--` 之后一律是程序参数,不再当编译器选项
            i = i + 1
            续
        }
        若 p == "--" { 收程序参数 = 真 }
        抑 p == "pao" 或 p == "跑" { 跑模式 = 真 }
        抑 p == "升级" 或 p == "sj" { 升级模式 = 真 }
        抑 p == "--检查" { 升级只检查 = 真 }
        抑 p == "--国内" { 升级国内 = 真 }
        抑 p == "--强制" { 升级强制 = 真 }
        抑 p == "--源" {
            若 i + 1 < 参数.长度 {
                升级源 = 参数[i + 1]
                i = i + 1
            }
        }
        抑 p == "--目录" {
            若 i + 1 < 参数.长度 {
                升级目标 = 参数[i + 1]
                i = i + 1
            }
        }
        抑 p == "-V" 或 p == "--version" 或 p == "--版本" {
            // 自更新/工具链管理器(tiepm/xtl)需要稳定的版本查询入口;与 -h 首行同格式
            示("玄铁 (XuanTie) 编译器驱动 " & 版本号)
            终 0
        }
        抑 p == "-h" 或 p == "--help" 或 p=="--帮助" {
            打印帮助 = 真
        } 抑 p == "-sj" 或 p == "--shijian" 或 p == "--时间" {
            统计时间 = 真
        } 抑 p == "-rz" 或 p == "--rizhi" 或 p == "--日志" {
            输出详细 = 真
        } 抑 p == "-sc" 或 p == "--shuchu" 或 p == "--输出" {
            若 i + 1 < 参数.长度 {
                输出路径 = 参数[i + 1]
                i = i + 1
            }
        } 抑 p == "-pt" 或 p == "--pingtai" 或 p == "--平台" {
            若 i + 1 < 参数.长度 {
                平台 = 参数[i + 1]
                平台显式 = 真
                i = i + 1
            }
        } 抑 p == "-jg" 或 p == "--jiagou" 或 p == "--架构" {
            若 i + 1 < 参数.长度 {
                架构 = 参数[i + 1]
                i = i + 1
            }
        } 抑 p == "--neilian" 或 p == "--内链" {
            链接方式 = "静态"
        } 抑 p == "--wailian" 或 p == "--外链" {
            链接方式 = "动态"
        } 抑 p == "-mc" 或 p == "--chuangkou" 或 p == "--窗口" {
            窗口模式 = 真
        } 抑 p == "-jc" 或 p == "--jiancha" 或 p == "--检查" {
            检查模式 = 真
        } 抑 p == "-bl" 或 p == "--baoliu" 或 p == "--保留" {
            保留中间产物 = 真
        } 抑 p.包含?("-O") {
            优化等级 = p
        } 抑 p == "--yange" 或 p == "--严格" {
            严格度 = "严格"
        } 抑 p == "--jinzhi" 或 p == "--禁止" {
            严格度 = "禁止"
        } 抑 p == "--moren" 或 p == "--默认" {
            严格度 = "默认"
        } 抑 p.长度 > 1 且 p.截取(0, 1) == "-" {
            // 未识别的 - 开头参数:明确报错,不当源文件路径静默吞掉(明确的编程错误,宁可报错)
            示("错误: 未知参数 '" & p & "'。用 -h 查看支持的参数列表")
            终 1
        } 抑 p != "tie" 且 p != "铁" 且 p != "pao" 且 p != "跑" {
            若 路径 == "" {
                路径 = p
            }
        }
        i = i + 1
    }

    若 打印帮助 {
        示("玄铁 (XuanTie) 编译器驱动 #{版本号}")
        示("用法: xtc tie <源文件> [选项]   ——或在含 [项目] 入口 的 玄铁.配置.toml 项目内裸跑 xtc 铁")
        示("选项:")
        示("  -h, --help, --帮助      - 显示此帮助信息")
        示("  -sc, --输出 <文件>      - 指定输出可执行文件名 (默认: 源文件名.exe)")
        示("  -rz, --日志             - 显示详细编译过程追踪日志")
        示("  -sj, --时间             - 显示编译全过程耗时统计")
        示("  -pt, --平台 <os>        - 指定目标操作系统 (支持: windows / darwin / linux)")
        示("  -jg, --架构 <arch>      - 指定目标处理器架构 (支持: amd64 / arm64)")
        示("  --yange, --严格         - 严格模式：警告提升为错误，宽松提升为警告")
        示("  --jinzhi, --禁止        - 禁止模式：所有非错误提升为错误")
        示("  --moren, --默认         - 默认模式（默认值）")
        示("  -O0~3, -Og, -Os, -Oz    - 指定 LLVM 优化等级 (默认: -Og)")
        示("  --内链, --neilian       - 静态链接所有依赖 (默认,当前唯一支持)")
        示("  --外链, --wailian       - 动态链接依赖 (暂未适配,使用将报错)")
        示("  -mc, --窗口             - GUI 子系统(无控制台窗口);仅发布窗口程序时用,默认关闭")
        示("  -jc, --检查             - 只检查不产出(词法/语法/语义全查,停在链接前;供 LSP 调用)")
        示("  -bl, --保留             - 保留编译中间产物(IR/对象文件 复制为 CWD 下 自举输出.ll/.o;默认编译成功后自动清理)")
        示("  pao, 跑                 - 编译后立即运行(语义同 go run / cargo run):临时产物落缓存目录、跑完清理、退出码透传")
        示("  升级, sj                - 自更新:下载官方发行包并原地覆盖安装(可加 --检查 / --国内 / --强制 / --目录 <dir>)")
        示("  --国内                  - 升级时改走 Gitee 镜像(不用 GitHub)")
        示("  --                      - 之后的参数原样传给被运行的程序(仅 pao/跑 下有意义)")
        示("示例: xtc pao ceshi.xt -- 甲 乙   (编译后运行,并把 甲 乙 作为程序参数)")
        示("示例: xt.exe tie ceshi.xt -sc jieguo.exe")

        // 构建指纹:发行包内 MANIFEST.txt 的 [编译器自述] 段由驱动原样打印(不做解析)。
        // 存在意义:版本号是源码里的常量、不随提交移动,单凭它无法回答"这个二进制是否对应那份源码";
        // 有了这段,任何第三方敲一次 -h 就能核对提交哈希与自举链指纹,不必猜。
        设 _自目录 = 自身目录()
        设 _清单路径 = _自目录 & "MANIFEST.txt"
        若 _自目录 != "" 且 文件.存在?(_清单路径) {
            设 _清单读 = 文件.读(_清单路径)
            设 _已打印 = 假
            若 _清单读.成功 {
                设 _清单行 = _清单读.值.分割("\n")
                设 _自述中 = 假
                设 _j = 0
                当 _j < _清单行.长度 {
                    设 _行 = _清单行[_j].替换("\r", "")
                    // 闭合标记必须先判:它是开盘标记的超串,顺序反了就永远断不了
                    若 _行.包含?("[/编译器自述]") { 断 }
                    抑 _行.包含?("[编译器自述]") { _自述中 = 真 }
                    抑 _自述中 且 _行 != "" {
                        若 非 _已打印 {
                            示("构建信息(随包 MANIFEST.txt):")
                            _已打印 = 真
                        }
                        示("  " & _行)
                    }
                    _j = _j + 1
                }
            }
            // 清单在、但没能取出自述段:不许静默——格式坏了就说格式坏了
            若 非 _已打印 { 示("构建信息: MANIFEST.txt 在,但取不到「编译器自述」段(清单格式异常)") }
        } 否 {
            示("构建信息: 无(此为裸可执行文件,未随发行包携带 MANIFEST.txt)")
        }
        返 空
    }

    // 平台探测:未显式指定 --平台 时,优先用 uname 探测(POSIX);探测失败回退 windows(历史行为)
    若 平台 == "" {
        设 _探测 = 执("uname -s")
        若 _探测.成功 {
            设 _系统 = _探测.值.替换("\r", "").替换("\n", "").替换(" ", "")
            若 _系统 == "Darwin" { 平台 = "darwin" }
            抑 _系统 == "Linux" { 平台 = "linux" }
        }
        若 平台 == "" { 平台 = "windows" }
    }

    // issue #105:显式 -pt 只允许等于宿主平台。
    // 本编译器不做交叉编译：临时目录分隔符、自带工具链选择、运行时目标文件都按宿主决定，
    // 宿主≠目标时只会产出「POSIX 临时路径 + Windows 反斜杠」这类损坏路径和误导性报错。
    // 按「宁可报错，也不静默」直接拒绝，而不是继续生成半损坏产物。
    若 平台显式 {
        设 宿主平台 = ""
        设 _宿主探测 = 执("uname -s")
        若 _宿主探测.成功 {
            设 _宿主系统 = _宿主探测.值.替换("\r", "").替换("\n", "").替换(" ", "")
            若 _宿主系统 == "Darwin" { 宿主平台 = "darwin" }
            抑 _宿主系统 == "Linux" { 宿主平台 = "linux" }
        }
        若 宿主平台 == "" { 宿主平台 = "windows" }
        若 平台 != 宿主平台 {
            示("错误: -pt " & 平台 & " 与当前宿主平台 " & 宿主平台 & " 不一致")
            示("      本编译器只做本机原生构建，不支持交叉编译。")
            示("      请到 " & 平台 & " 机器上构建，或去掉 -pt 让编译器按宿主自动选择。")
            终 1
        }
    }

    // 架构探测:未显式指定 --架构 时,POSIX 用 uname -m(与平台探测同套机制)
    若 架构 == "" {
        设 _探测2 = 执("uname -m")
        若 _探测2.成功 {
            设 _机器 = _探测2.值.替换("\r", "").替换("\n", "").替换(" ", "")
            若 _机器 == "arm64" 或 _机器 == "aarch64" { 架构 = "arm64" }
            抑 _机器 == "x86_64" 或 _机器 == "amd64" { 架构 = "amd64" }
        }
        // Windows 无 uname:用 cmd 的 PROCESSOR_ARCHITECTURE(原生进程链下返回 ARM64/AMD64)
        若 架构 == "" 且 平台 == "windows" {
            设 _探测3 = 执("cmd /c echo %PROCESSOR_ARCHITECTURE%")
            若 _探测3.成功 {
                设 _机器2 = _探测3.值.替换("\r", "").替换("\n", "").替换(" ", "")
                若 _机器2 == "ARM64" { 架构 = "arm64" }
                抑 _机器2 == "AMD64" { 架构 = "amd64" }
            }
        }
        若 架构 == "" { 架构 = "amd64" }
    }

    // 自更新:平台/架构探测完成后再执行(要按宿主选发行包)
    若 升级模式 {
        设 _升级码 = 执行升级(平台, 架构, 升级只检查, 升级国内, 升级强制, 升级目标, 版本号, 升级源)
        若 _升级码 != 0 { 终 1 }
        终 0
    }

    // 项目模式(方案A):未指定源文件时,从 CWD 向上逐级找 玄铁.配置.toml(即项目根),
    // 读 [项目] 入口 字段作为编译目标;找不到配置或未声明入口则明确报错
    若 路径 == "" {
        // CWD 由 runtime 内建 xt_cwd() 直接问操作系统(GetCurrentDirectoryW / getcwd)。
        // 此处曾写成 执("cmd /c cd")/执("pwd") 二选一,且选路依赖的 平台 在下面才探测到——
        // Windows 上必然选中不存在的 pwd,失败被忽略,读出的空值被拼成 "空\玄铁.配置.toml",
        // 于是"取不到 CWD"被伪装成"未找到配置文件"。与平台无关的内建既消掉子进程也消掉这个出错点。
        设 _cwd结果 = xt_cwd()
        若 _cwd结果 == "" {
            示("错误: 无法获取当前工作目录(xt_cwd 返回空)")
            终 1
        }
        设 _cwd = _cwd结果
        // 起点直接给目录本身(不带尾分隔符):分隔符由 查找配置文件 自己补,避免调用方硬编码 "\\"(POSIX 上非法)
        设 _配置路径 = 查找配置文件(_cwd)
        若 _配置路径 != "" {
            设 _配置读 = 文件.读(_配置路径)
            若 _配置读.成功 {
                设 _键值 = 解析配置(_配置读.值)
                若 _键值.含?("入口") 且 _键值["入口"] != "" {
                    // 项目根 = 配置文件所在目录(配置路径截去文件名,即最后一个分隔符之前)
                    设 _根 = ""
                    设 _si = _配置路径.字符数 - 1
                    当 _si >= 0 {
                        设 _sc = _配置路径.截取(_si, _si + 1)
                        若 _sc == "\\" 或 _sc == "/" { _根 = _配置路径.截取(0, _si + 1) ; 断 }
                        _si = _si - 1
                    }
                    路径 = _根 & _键值["入口"]
                    若 输出详细 { 示("项目模式: 根=" & _根 & " 入口=" & 路径) }
                }
            }
        }
        若 路径 == "" {
            示("错误: 未指定源文件;且从当前目录向上未找到声明 [项目] 入口 的 玄铁.配置.toml")
            示("  用法: xtc 铁 <源文件.xt>")
            示("  或在项目根创建 玄铁.配置.toml 并写入: [项目] 入口 = \"主.xt\"")
            终 1
        }
    }

    // 未适配参数封存:只放行完成实测的组合,其余明确报错(不静默产出不可用的产物)
    若 平台 != "windows" 且 平台 != "darwin" 且 平台 != "linux" {
        示("错误: 不支持的目标平台 '" & 平台 & "'(支持: windows / darwin / linux)")
        终 1
    }
    若 架构 != "amd64" 且 架构 != "arm64" {
        示("错误: 不支持的架构 '" & 架构 & "'(支持: amd64 / arm64)")
        终 1
    }
    若 链接方式 != "静态" {
        示("错误: 当前版本 (" & 版本号 & ") 暂不支持 --外链(与默认 --内链 在当前工具链下产物无实质差异,未经独立实测);请省略该参数使用默认内链")
        终 1
    }

    // 检查文件扩展名
    若 非 路径.包含?(".xt") {
        设 确认 = 输("警告: 文件 '" & 路径 & "' 似乎不是玄铁源文件(.xt)，是否继续编译? (y/n): ")
        若 确认 != "y" 且 确认 != "Y" 且 确认 != "是" 且 确认 != "" {
            示("编译已取消")
            终 0
        }
    }

    设 输出路径为默认 = 假
    若 输出路径 == "" 且 非 跑模式 {
        输出路径为默认 = 真
        // 注意:截取按字符、字节数按字节,中文文件名下 字节数-3 会截过头返回整串(输出名=源路径,覆盖源码)。
        // 统一按 字符数 截取;Windows 无条件补 .exe(POSIX 输出名=源名去 .xt)。
        // 旧 PR 版把补 .exe 错误门控在「路径不含 .xt」上——常规 .xt 源在 Windows 永不补后缀,
        // 链接产物与存在性自检双双落空(回归 115/116 假红),实测修正。
        若 路径.包含?(".xt") {
            输出路径 = 路径.截取(0, 路径.字符数 - 3)
        } 否 {
            输出路径 = 路径
        }
        若 平台 == "windows" {
            输出路径 = 输出路径 & ".exe"
        }
    }

    // issue #83:macOS 上可执行文件名含非 ASCII 会让 GLFW/CoreFoundation 在 _glfwInitCocoa 里崩
    // (SIGTRAP,退出码 133),且 cp 改名成 ASCII 即正常。根治要改 GLFW 或做 exec 重定向,当前先给出可操作警告。
    // 判据:字节数 != 字符数 即含非 ASCII(纯 ASCII 两者相等)。
    若 平台 == "darwin" 且 输出路径 != "" {
        若 输出路径.字节数 != 输出路径.字符数 {
            示("警告: macOS 上可执行文件名含非 ASCII 字符,启动可能在 GLFW 初始化阶段崩溃(SIGTRAP, issue #83)")
            示("      规避:用 -sc 指定 ASCII 产物名,例如 -sc app")
        }
    }

    设 开始时间 = 0
    若 统计时间 { 开始时间 = 时.毫秒() }

    设 tempDir = xt_get_temp_path()
    设 缓存目录 = ""
    设 _路径分隔 = "\\"
    若 平台 == "windows" {
        缓存目录 = tempDir & "\\XuanTie\\Cache"
        执("cmd /c mkdir \"" & 缓存目录 & "\" 2>nul")
    } 否 {
        _路径分隔 = "/"
        缓存目录 = tempDir & "/XuanTie/Cache"
        执("mkdir -p \"" & 缓存目录 & "\" 2>/dev/null")
    }

    设 临时产物需清理 = 假
    若 跑模式 且 输出路径 == "" {
        // 取源文件基名(去目录、去 .xt):路径可能带 \ 或 /,两段都剥一次
        设 _基名 = 路径
        若 _基名.包含?("\\") { 设 _段1 = _基名.分割("\\") ; _基名 = _段1[_段1.长度 - 1] }
        若 _基名.包含?("/") { 设 _段2 = _基名.分割("/") ; _基名 = _段2[_段2.长度 - 1] }
        若 _基名.包含?(".xt") { _基名 = _基名.截取(0, _基名.字符数 - 3) }
        // 产物名必须**纯 ASCII**:非 ASCII 输出路径经 MinGW 的 gcc/ld 时按 ANSI 码页解 argv,
        // 在 en-US runner 上中文被打成 '?' → ld: cannot open output file ...\?_pao_probe.exe
        // (CI 实测,与 Issue #21 同源)。故把基名过滤成 ASCII,非 ASCII 字符一律换 _。
        设 _安全名 = ""
        设 _ci = 0
        当 _ci < _基名.字符数 {
            设 _c = _基名.截取(_ci, _ci + 1)
            若 (_c >= "a" 且 _c <= "z") 或 (_c >= "A" 且 _c <= "Z") 或 (_c >= "0" 且 _c <= "9") 或 _c == "_" {
                _安全名 = _安全名 & _c
            } 否 {
                _安全名 = _安全名 & "_"
            }
            _ci = _ci + 1
        }
        若 _安全名 == "" { _安全名 = "out" }
        输出路径 = 缓存目录 & _路径分隔 & "pao_" & _安全名
        若 平台 == "windows" { 输出路径 = 输出路径 & ".exe" }
        临时产物需清理 = 真     // 只清理我们自己挑的缓存产物;-sc 指定的用户产物不动
    }

    // ll/o 路径改在读到源码后按内容指纹命名(见下方 设 代码 之后)

    // 读取项目配置文件（若存在）:从源文件目录向上逐级查找 玄铁.配置.toml,
    // 找到即视为项目根(类似 Go 的 go.mod);找不到则按无配置处理
    设 配置目录 = ""
    设 末斜杠 = -1
    设 ci = 路径.字符数 - 1
    当 ci >= 0 {
        设 _c = 路径.截取(ci, ci+1)
        若 _c == "\\" 或 _c == "/" { 末斜杠 = ci ; 断 }
        ci = ci - 1
    }
    若 末斜杠 > 0 { 配置目录 = 路径.截取(0, 末斜杠 + 1) }
    设 配置路径 = 查找配置文件(配置目录)
    设 配置 = {}
    若 配置路径 != "" {
        设 配置读结果 = 文件.读(配置路径)
        若 配置读结果.成功 {
            配置 = 解析配置(配置读结果.值)
        }
    }
    // 命令行参数优先级高于配置文件
    若 严格度 == "默认" 且 配置.含?("严格度") {
        严格度 = 配置["严格度"]
    }

    // issue #123:项目根 + 项目级原生 C 源声明
    //   玄铁.配置.toml:
    //     [原生]
    //     源 = ["桥.c", "子目录/其他.c"]
    // 相对路径按项目根(配置文件所在目录)解析;编译/链接在下方链接段统一处理。
    设 项目根 = ""
    若 配置路径 != "" {
        设 _pi = 配置路径.字符数 - 1
        当 _pi >= 0 {
            设 _pc = 配置路径.截取(_pi, _pi + 1)
            若 _pc == "\\" 或 _pc == "/" { 项目根 = 配置路径.截取(0, _pi + 1) ; 断 }
            _pi = _pi - 1
        }
    }
    // 配置路径可能是裸文件名(源文件也在 CWD、CWD 就是项目根):补成 CWD 绝对前缀,
    // 否则 项目根 为空 → 原生 C 源按相对路径编译、-I 为空,换目录调用就找不到文件。
    若 项目根 == "" { 项目根 = xt_cwd() & _路径分隔 }
    设 项目原生源 = []
    若 配置.含?("原生.源") { 项目原生源 = 解析配置数组(配置["原生.源"]) }
    // 忽略警告 = ["W001","隐式类型",...] → 解析器全局忽略列表(码或类别名均可)
    设 忽略警告列表 = []
    若 配置.含?("忽略警告") {
        忽略警告列表 = 解析配置数组(配置["忽略警告"])
    }

    // 初始化 1GB Arena 用于容纳全部编译器模块的 AST
    设 池 = xt_arena_new(1073741824)
    xt_arena_use(池)

    设 读结果 = 文件.读(路径)
    若 非 读结果.成功 {
        示("无法读取源文件: " & 路径)
        xt_arena_destroy(池)
        // destroy 后必须硬退出(同下方 -jc 路径的既有注释):arena 扩容链缓冲已解约页面,
        // 主函数 返空 走作用域退出会例行 release arena 内对象,xt_check_obj 在 immortal 检查前
        // 即读对象头 → 读已解约页 → 0xC0000005(Issue#5)。此处曾写 返 空:实测该分支
        // 打印完"无法读取源文件"后即以访问违例(-1073741819)终止,把干净的退出码 1 变成崩溃码。
        终 1
    }
    设 代码 = 读结果.值

    // 源文件编码体检(issue:GBK/ANSI 文件会报成「未知标识符」「未闭合的字符串字面量」,误导排查)
    设 _坏偏移 = UTF8非法偏移(代码)
    若 _坏偏移 >= 0 {
        示("错误: 源文件不是 UTF-8 编码(首个非法字节偏移 " & 字(_坏偏移) & ")")
        示("  提示: GBK/ANSI 编码请先另存为 UTF-8(记事本/VS Code 均可导出 UTF-8)")
        xt_arena_destroy(池)
        终 1
    }

    // 确定性构建:中间产物按源内容指纹命名(同内容同名,异内容不撞),替代时间戳
    设 构建指纹 = 指纹of(代码)
    设 ll路径 = 缓存目录 & _路径分隔 & "xt_" & 构建指纹 & ".ll"
    设 o路径 = 缓存目录 & _路径分隔 & "xt_" & 构建指纹 & ".o"

    // 词法分析
    设 词法 = 造 词法分析器(代码)
    词法.源文件 = 路径

    // 语法分析
    //示("正在进行语法分析...")
    设 解析 = 造 语法分析器(词法)
    解析.严格度 = 严格度
    解析.全局忽略列表 = 忽略警告列表
    设 程序树 = 解析.解析程序()
    //示("语法分析完成")

    若 解析.警告列表.长度 > 0 {
        示("解析警告:")
        遍历 警 于 解析.警告列表 { 示(警) }
    }
    若 解析.错误列表.长度 > 0 {
        示("解析错误 —— " & 路径)
        遍历 错 于 解析.错误列表 { 示(错) }
        终 1
    }
    
    // 编译 (生成 LLVM IR)
    若 输出详细 { 示("正在生成 LLVM IR") }
    设 编译 = 造 编译器()
    编译.平台 = 平台
    编译.架构 = 架构
    编译.严格度 = 严格度
    编译.输出详细 = 输出详细
    编译.检查模式 = 检查模式   // --检查:语义错误收集(全文件扫描,不即退)
    编译.编译程序(程序树, 路径)
    若 输出详细 { 示("[MAIN1] 编译完成, ir长度=" & 编译.结果输出.字节数) }

    // 只检查模式(--检查):词法/语法/语义全跑完即停,不进 clang/链接(供 LSP 语义诊断调用)
    // 语义阶段为收集模式:全部命中一次输出,退出码非零(与单遍时代一致)
    若 检查模式 {
        若 编译.语义错误列表.长度 > 0 {
            遍历 _错 于 编译.语义错误列表 { 示("编译错误: " & _错) }
            xt_arena_destroy(池)
            终 1
        }
        示("检查完成: 未发现问题")
        // destroy 后必须硬退出:arena 扩容链缓冲已 free(页面解约),主函数 返空 的作用域退出
        // 会例行 release arena 内对象,xt_check_obj 在 immortal 检查前即读对象头 → 读已解约页
        // → 0xC0000005(Issue#5,实测);正常编译路径同款 destroy+终0 由此不崩
        xt_arena_destroy(池)
        终 0
    }

    // 输出结果
    设 ir = 编译.结果输出
    若 输出详细 { 示("[MAIN2] ir已获取") }
    设 写结果 = 文件.写(ll路径, ir)
    若 输出详细 { 示("[MAIN3] 文件写入结果=" & 写结果.成功) }
    若 非 写结果.成功 {
        示("无法写入临时 LLVM IR 文件: " & ll路径 & ", 错误: " & 写结果.错误)
        xt_arena_destroy(池)
        终 1
    }
    
    // 构建目标三元组
    设 目标三元组 = ""
    若 平台 == "windows" {
        若 架构 == "amd64" {
            目标三元组 = "x86_64-w64-windows-gnu"
        } 否 {
            目标三元组 = 架构 & "-w64-windows-gnu"
        }
    } 抑 平台 == "linux" {
        若 架构 == "amd64" {
            目标三元组 = "x86_64-linux-gnu"
        } 抑 架构 == "arm64" {
            目标三元组 = "aarch64-linux-gnu"
        } 否 {
            目标三元组 = 架构 & "-linux-gnu"
        }
    } 抑 平台 == "darwin" {
        若 架构 == "arm64" {
            目标三元组 = "arm64-apple-darwin"
        } 抑 架构 == "amd64" {
            目标三元组 = "x86_64-apple-darwin"
        } 否 {
            目标三元组 = 架构 & "-apple-darwin"
        }
    } 否 {
        目标三元组 = 架构 & "-" & 平台
    }

    // 编译器自身目录解析(发行包布局定位的基础):runtime\ lib\ tools\ MANIFEST.txt 均按自身同级查找
    设 _自身目录 = 自身目录()
    // 自带工具链定位(发行包布局:编译器同级 tools\ 下的极简 clang/MinGW 优先,免 PATH 配置;
    // 开发环境无 tools\ 目录,回退 PATH 里的 clang/gcc;POSIX 平台无随包工具链,直接用 PATH)
    设 clang程序 = "clang"
    设 gcc程序 = "gcc"
    若 平台 == "windows" 且 _自身目录 != "" {
        若 文件.存在?(_自身目录 & "tools\\clang\\bin\\clang.exe") { clang程序 = _自身目录 & "tools\\clang\\bin\\clang.exe" }
        若 架构 == "arm64" 且 文件.存在?(_自身目录 & "tools\\mingw\\bin\\aarch64-w64-mingw32-gcc.exe") { gcc程序 = _自身目录 & "tools\\mingw\\bin\\aarch64-w64-mingw32-gcc.exe" }
        若 架构 == "amd64" 且 文件.存在?(_自身目录 & "tools\\mingw\\bin\\gcc.exe") { gcc程序 = _自身目录 & "tools\\mingw\\bin\\gcc.exe" }
    }

    // 调用 clang 生成对象文件
    设 clang指令 = "\"" & clang程序 & "\" -g -target " & 目标三元组 & " " & 优化等级 & " -c \"" & ll路径 & "\" -o \"" & o路径 & "\""
    若 输出详细 { 示("Clang指令: " & clang指令) }
    若 输出详细 { 示("[MAIN4] 执行clang, 指令长度=" & clang指令.字节数) }
    设 clang结果 = 执(clang指令)
    若 输出详细 { 示("[MAIN5] clang完成, 成功=" & clang结果.成功) }
    若 非 clang结果.成功 或 非 文件.存在?(o路径) {
        若 非 clang结果.成功 { 示("clang失败, 错误=" & clang结果.错误 & " | IR保留于: " & ll路径) }
        若 clang结果.成功 { 示("错误：未找到生成的对象文件 " & o路径) }
        // 保留 .ll 文件以便调试
        xt_arena_destroy(池)
        终 1
    }

    // 寻找运行时 (优先寻找编译好的 .o 文件，以支持轻量化打包)
    // 查找顺序:① 编译器自身所在目录(exe 同级/上一级)——任意目录调用都能找到随包运行时;
    //           ② 调用方 CWD 的 runtime\ 与 ..\runtime\——仓库开发环境兼容
    设 _运行时候选 = []
    若 _自身目录 != "" {
        _运行时候选.追加(_自身目录 & "runtime" & _路径分隔 & "xt_runtime.o")
        _运行时候选.追加(_自身目录 & "runtime" & _路径分隔 & "xt_runtime.c")
        _运行时候选.追加(_自身目录 & ".." & _路径分隔 & "runtime" & _路径分隔 & "xt_runtime.c")
    }
    _运行时候选.追加("runtime" & _路径分隔 & "xt_runtime.o")
    _运行时候选.追加("runtime" & _路径分隔 & "xt_runtime.c")
    _运行时候选.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_runtime.o")
    _运行时候选.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_runtime.c")

    设 rtFile = ""
    遍历 _cand 于 _运行时候选 {
        若 文件.存在?(_cand) { rtFile = _cand ; 断 }
    }
    若 rtFile == "" {
        示("错误: 未找到运行时文件(xt_runtime.o/.c),已尝试编译器自身目录与当前目录")
        终 1
    }

    // 寻找线程池/网络栈/TLS 文件:预编译 .o 优先(发行包布局——目标机无 C 头文件,链接直吃 .o;
    // 且免去每次编译现场编 3 个 .c);找不到回退 .c(开发环境,由 gcc 链接时现场编译)
    设 tpFile = ""
    设 _伴随候选 = []
    若 _自身目录 != "" { _伴随候选.追加(_自身目录 & "runtime" & _路径分隔 & "xt_threadpool.o") }
    _伴随候选.追加("runtime" & _路径分隔 & "xt_threadpool.o")
    _伴随候选.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_threadpool.o")
    _伴随候选.追加("runtime" & _路径分隔 & "xt_threadpool.c")
    _伴随候选.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_threadpool.c")
    _伴随候选.追加(rtFile.替换("xt_runtime.c", "xt_threadpool.c").替换("xt_runtime.o", "xt_threadpool.o"))
    遍历 _bc 于 _伴随候选 { 若 文件.存在?(_bc) { tpFile = _bc ; 断 } }
    若 输出详细 且 tpFile != "" { 示("线程池文件: " & tpFile) }

    // 寻找网络栈文件(同线程池:.o 优先)
    设 netFile = ""
    设 _伴随候选2 = []
    若 _自身目录 != "" { _伴随候选2.追加(_自身目录 & "runtime" & _路径分隔 & "xt_net.o") }
    _伴随候选2.追加("runtime" & _路径分隔 & "xt_net.o")
    _伴随候选2.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_net.o")
    _伴随候选2.追加("runtime" & _路径分隔 & "xt_net.c")
    _伴随候选2.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_net.c")
    _伴随候选2.追加(rtFile.替换("xt_runtime.c", "xt_net.c").替换("xt_runtime.o", "xt_net.o"))
    遍历 _bc2 于 _伴随候选2 { 若 文件.存在?(_bc2) { netFile = _bc2 ; 断 } }
    若 输出详细 且 netFile != "" { 示("网络栈文件: " & netFile) }

    // 寻找 TLS 栈文件(Schannel 系统原生 TLS,同上:.o 优先)
    设 tlsFile = ""
    设 _伴随候选3 = []
    若 _自身目录 != "" { _伴随候选3.追加(_自身目录 & "runtime" & _路径分隔 & "xt_tls.o") }
    _伴随候选3.追加("runtime" & _路径分隔 & "xt_tls.o")
    _伴随候选3.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_tls.o")
    _伴随候选3.追加("runtime" & _路径分隔 & "xt_tls.c")
    _伴随候选3.追加(".." & _路径分隔 & "runtime" & _路径分隔 & "xt_tls.c")
    _伴随候选3.追加(rtFile.替换("xt_runtime.c", "xt_tls.c").替换("xt_runtime.o", "xt_tls.o"))
    遍历 _bc3 于 _伴随候选3 { 若 文件.存在?(_bc3) { tlsFile = _bc3 ; 断 } }
    若 输出详细 且 tlsFile != "" { 示("TLS栈文件: " & tlsFile) }

    // 检测渲染库导入(编译阶段由 编译.引用了渲染 记录,含经 UI 等包间接引入)
    设 使用渲染 = 假
    设 渲染桥C = ""
    设 渲染桥Obj = ""
    设 raylibA = ""
    // 渲染桥查找顺序:① CWD 相对(仓库/项目开发兼容) ② 铁铺已安装目录(显式安装的依赖优先于内置缓存,issue #45)
    //               ③ 编译器自身目录(发行包布局:exe同级/上一级的 lib\渲染,兜底)
    设 候选渲染桥列表 = ["lib" & _路径分隔 & "渲染" & _路径分隔 & "渲染桥.c", ".." & _路径分隔 & "lib" & _路径分隔 & "渲染" & _路径分隔 & "渲染桥.c"]
    候选渲染桥列表.追加(编译.获取铁铺安装目录() & _路径分隔 & "渲染" & _路径分隔 & "渲染桥.c")
    若 _自身目录 != "" {
        候选渲染桥列表.追加(_自身目录 & "lib" & _路径分隔 & "渲染" & _路径分隔 & "渲染桥.c")
        候选渲染桥列表.追加(_自身目录 & ".." & _路径分隔 & "lib" & _路径分隔 & "渲染" & _路径分隔 & "渲染桥.c")
    }
    遍历 _rc 于 候选渲染桥列表 {
        若 文件.存在?(_rc) { 渲染桥C = _rc ; 断 }
    }
    // libraylib.a 查找顺序:① 渲染桥同目录(铁铺包内/发行包内捆绑) ② C:/raylib 硬编码(向后兼容)
    设 _raylib候选 = []
    若 渲染桥C != "" {
        // 平台化:darwin/linux 优先平台专属库(Windows MinGW 版 .a 无法被 darwin ld 链接);
        // 找不到平台库时报明确错误(见下方 raylibA == "" 分支),不再静默带错库进链接
        若 平台 == "darwin" { _raylib候选.追加(渲染桥C.替换("渲染桥.c", "libraylib.darwin-" & 架构 & ".a")) }
        若 平台 == "linux" { _raylib候选.追加(渲染桥C.替换("渲染桥.c", "libraylib.linux-" & 架构 & ".a")) }
        _raylib候选.追加(渲染桥C.替换("渲染桥.c", "libraylib.a"))
        _raylib候选.追加("C:/raylib/raylib/src\\libraylib.a")
        _raylib候选.追加("C:/raylib/w64devkit/lib\\libraylib.a")
        遍历 _ra 于 _raylib候选 {
            若 文件.存在?(_ra) { raylibA = _ra ; 断 }
        }
    }
    // 引用了渲染就必须定位到桥与库——宁可报错退出也不静默降级
    // (静默降级会在链接期才报误导性的"MinGW 链接失败",真正缺失的符号信息还会被截断)
    若 编译.引用了渲染 {
        若 渲染桥C == "" {
            示("错误: 程序引用了渲染库,但找不到 渲染桥.c。已查找以下位置:")
            遍历 _rc2 于 候选渲染桥列表 { 示("  - " & _rc2) }
            示("请通过铁铺安装渲染库(tiepm install 渲染),或把 lib\\渲染 放到编译器同级/上一级目录")
            xt_arena_destroy(池)
            终 1
        }
        若 raylibA == "" {
            示("错误: 程序引用了渲染库,但找不到 libraylib.a。已查找以下位置:")
            遍历 _ra2 于 _raylib候选 { 示("  - " & _ra2) }
            示("渲染库 v1.0.1 起的铁铺包已内置 libraylib.a,请通过铁铺安装/更新(tiepm install 渲染)")
            xt_arena_destroy(池)
            终 1
        }
    }
    若 编译.引用了渲染 且 渲染桥C != "" 且 raylibA != "" {
        使用渲染 = 真
        若 输出详细 { 示("检测到渲染库: " & 渲染桥C & " + " & raylibA) }
    }

    // 编译渲染桥(发行包预编译的 渲染桥.o 优先:目标机无 C 头文件/无 raylib 源码依赖,链接直吃 .o)
    若 使用渲染 {
        // raylib 静态库路径的 ASCII 中转:gcc/ld 是窄字符程序,非 ASCII 路径在英文区域
        // (en-US/CP1252)的机器上会按 ANSI 码页被解成 "??",致 ld 找不到 .a — 与 Issue #21
        // 的中文输出名同类问题的第三处(本次在"输入库路径"上)。缓存目录是 ASCII,故复制一份
        // 再链接;每次覆盖复制(约 2MB,毫秒级),避免版本切换后用到陈旧副本。
        设 _raylibAscii = 缓存目录 & _路径分隔 & "raylib_a.a"
        复制文件("\"" & raylibA & "\"", "\"" & _raylibAscii & "\"", 平台)
        若 文件.存在?(_raylibAscii) {
            raylibA = _raylibAscii
            若 输出详细 { 示("raylib 已中转至 ASCII 路径: " & raylibA) }
        } 否 {
            若 输出详细 { 示("警告: raylib 静态库中转失败,沿用原路径: " & raylibA) }
        }
        设 _桥预编 = 渲染桥C.替换("渲染桥.c", "渲染桥.o")
        设 _用预编 = 假
        若 文件.存在?(_桥预编) {
            // issue #67:预编译 .o 只在"不比 .c 旧"时才算数。此前只看 .o 是否存在,
            // 结果只改 .c 的补丁被静默忽略(issue #45 的未完成部分)。
            // 时间取不到一律当作旧 —— 宁可多编一次,也不静默用旧桥。
            设 _桥c时 = 文件.修改时间(渲染桥C)
            设 _桥o时 = 文件.修改时间(_桥预编)
            设 _桥c秒 = 0
            设 _桥o秒 = 0
            若 _桥c时.成功 { _桥c秒 = _桥c时.值 }
            若 _桥o时.成功 { _桥o秒 = _桥o时.值 }
            若 _桥c时.成功 且 _桥o时.成功 且 _桥o秒 >= _桥c秒 {
                _用预编 = 真
                渲染桥Obj = _桥预编
                若 输出详细 { 示("使用预编译渲染桥: " & 渲染桥Obj) }
            } 否 {
                示("提示: 渲染桥 .o 比 .c 旧(或时间取不到),改为现场编译 .c,避免补丁被静默忽略")
            }
        }
        若 非 _用预编 {
        设 时间戳2 = 指纹of(渲染桥C)
        渲染桥Obj = 缓存目录 & _路径分隔 & "xt_" & 时间戳2 & "_bridge.o"
        设 渲染包含目录 = 渲染桥C.替换("\\渲染桥.c", "").替换("/渲染桥.c", "")
        设 桥clang指令 = "\"" & clang程序 & "\" -g -target " & 目标三元组 & " " & 优化等级 & " -c \"" & 渲染桥C & "\" -o \"" & 渲染桥Obj & "\" -I \"" & 渲染包含目录 & "\""
        若 输出详细 { 示("渲染桥 clang: " & 桥clang指令) }
        设 桥clang结果 = 执(桥clang指令)
        若 非 桥clang结果.成功 或 非 文件.存在?(渲染桥Obj) {
            示("渲染桥编译失败: " & 桥clang结果.错误)
            若 桥clang结果.成功 { 示("错误：未找到渲染桥对象文件") }
            若 保留中间产物 {
                复制文件("\"" & ll路径 & "\"", "\"自举输出.ll\"", 平台)
                复制文件("\"" & o路径 & "\"", "\"自举输出.o\"", 平台)
            }
            删文件([ll路径, o路径], 平台)
            xt_arena_destroy(池)
            终 1
        }
        }
    }

    // 调用 gcc 进行链接
    若 输出详细 { 示("正在调用 MinGW 进行链接...") }

    // 如果输出文件已存在，先尝试删除它以避免链接时的文件锁冲突导致的挂起
    若 文件.存在?(输出路径) {
        删文件([输出路径], 平台)
    }

    // 通用原生对象链接(tiepm.toml [原生] 对象;渲染桥是历史特判,此为其通用化通道)。
    // 缺失即明确报错(宁报错不静默降级);非 ASCII 路径经缓存目录中转(gcc/ld 窄字符不认中文路径)。
    设 _原生链接串 = ""
    遍历 _nd 于 编译.原生对象表 {
        遍历 _对象名 于 编译.原生对象表[_nd] {
            设 _npath = _nd & _路径分隔 & _对象名
            若 非 文件.存在?(_npath) {
                示("错误: 模块声明的原生对象不存在: " & _npath)
                示("  该模块目录的 tiepm.toml [原生] 对象列表引用了缺失文件,请重新安装该包")
                xt_arena_destroy(池)
                终 1
            }
            设 _nAscii = 缓存目录 & _路径分隔 & "xt_native_" & 指纹of(_npath) & ".o"
            复制文件("\"" & _npath & "\"", "\"" & _nAscii & "\"", 平台)
            若 文件.存在?(_nAscii) {
                _原生链接串 = _原生链接串 & " \"" & _nAscii & "\""
            } 否 {
                _原生链接串 = _原生链接串 & " \"" & _npath & "\""
            }
        }
    }

    // issue #123:项目级原生 C 源 —— 按 玄铁.配置.toml 的 [原生] 源 = [...] 现编现链。
    // 每份 .c 用与渲染桥相同的 clang 参数编译进 ASCII 缓存目录(名字带内容指纹,源改即重编);
    // 相对路径按项目根解析,缺文件/编译失败一律明确报错退出(不静默跳过)。
    遍历 _pp 于 项目原生源 {
        设 _pp绝对 = _pp
        设 _是绝对 = 假
        若 _pp.字符数 >= 2 且 _pp.截取(1, 2) == ":" { _是绝对 = 真 }
        若 _pp.字符数 >= 1 且 _pp.截取(0, 1) == "/" { _是绝对 = 真 }
        若 非 _是绝对 { _pp绝对 = 项目根 & _pp }
        若 非 文件.存在?(_pp绝对) {
            示("错误: 玄铁.配置.toml [原生] 源 声明的 C 文件不存在: " & _pp绝对)
            xt_arena_destroy(池)
            终 1
        }
        设 _pp目 = ""
        设 _pj = _pp绝对.字符数 - 1
        当 _pj >= 0 {
            设 _pcj = _pp绝对.截取(_pj, _pj + 1)
            若 _pcj == "\\" 或 _pcj == "/" { _pp目 = _pp绝对.截取(0, _pj + 1) ; 断 }
            _pj = _pj - 1
        }
        设 _ppObj = 缓存目录 & _路径分隔 & "xt_native_src_" & 指纹of(_pp绝对) & ".o"
        设 _ppCmd = "\"" & clang程序 & "\" -g -target " & 目标三元组 & " " & 优化等级 & " -c \"" & _pp绝对 & "\" -o \"" & _ppObj & "\" -I \"" & _pp目 & "\""
        若 输出详细 { 示("项目原生 C 源 clang: " & _ppCmd) }
        设 _ppR = 执(_ppCmd)
        若 非 _ppR.成功 或 非 文件.存在?(_ppObj) {
            示("错误: 项目原生 C 源编译失败: " & _pp绝对)
            示("  " & _ppR.错误)
            xt_arena_destroy(池)
            终 1
        }
        _原生链接串 = _原生链接串 & " \"" & _ppObj & "\""
    }

    设 链接指令 = ""
    若 平台 == "windows" {
        若 链接方式 == "静态" {
            链接指令 = "\"" & gcc程序 & "\" -g -static -Wl,--stack,16777216 -Wl,--no-insert-timestamp \"" & o路径 & "\" \"" & rtFile & "\""
            若 tpFile != "" { 链接指令 = 链接指令 & " \"" & tpFile & "\"" }
            若 netFile != "" { 链接指令 = 链接指令 & " \"" & netFile & "\"" }
            若 tlsFile != "" { 链接指令 = 链接指令 & " \"" & tlsFile & "\"" }
            若 使用渲染 { 链接指令 = 链接指令 & " \"" & 渲染桥Obj & "\" \"" & raylibA & "\" -lopengl32 -lgdi32 -lwinmm -limm32" }
            链接指令 = 链接指令 & _原生链接串
            若 窗口模式 { 链接指令 = 链接指令 & " -mwindows" }
            链接指令 = 链接指令 & " -lws2_32 -lsecur32 -o \"" & 输出路径 & "\""
        } 否 {
            链接指令 = "\"" & gcc程序 & "\" -g -Wl,--stack,16777216 -Wl,--no-insert-timestamp \"" & o路径 & "\" \"" & rtFile & "\""
            若 tpFile != "" { 链接指令 = 链接指令 & " \"" & tpFile & "\"" }
            若 netFile != "" { 链接指令 = 链接指令 & " \"" & netFile & "\"" }
            若 tlsFile != "" { 链接指令 = 链接指令 & " \"" & tlsFile & "\"" }
            若 使用渲染 { 链接指令 = 链接指令 & " \"" & 渲染桥Obj & "\" \"" & raylibA & "\" -lopengl32 -lgdi32 -lwinmm -limm32" }
            链接指令 = 链接指令 & _原生链接串
            若 窗口模式 { 链接指令 = 链接指令 & " -mwindows" }
            链接指令 = 链接指令 & " -lws2_32 -lsecur32 -o \"" & 输出路径 & "\""
        }
    } 否 {
        // POSIX(darwin/linux):无 -static/--stack,无 Windows 系统库;渲染需平台框架/库
        // issue #39: darwin 渲染程序是非 bundle 裸可执行,默认产物名=源文件名时产物名与源码文本
        // 字样重叠 → glfwInit→CFBundle 路径解析崩溃(Trace/BPT trap 5, exit 133)。darwin+渲染+
        // 未显式 -o 时默认产物名改用英文固定名与源码解耦;显式 -o 尊重用户选择;非渲染程序
        // (自举/CLI,无 glfwInit)不受影响。
        若 平台 == "darwin" 且 使用渲染 且 输出路径为默认 {
            输出路径 = "xtl-app"
        }
        链接指令 = "\"" & gcc程序 & "\" -g \"" & o路径 & "\" \"" & rtFile & "\""
        若 tpFile != "" { 链接指令 = 链接指令 & " \"" & tpFile & "\"" }
        若 netFile != "" { 链接指令 = 链接指令 & " \"" & netFile & "\"" }
        若 tlsFile != "" { 链接指令 = 链接指令 & " \"" & tlsFile & "\"" }
        若 平台 == "linux" { 链接指令 = 链接指令 & " -lm -lpthread -ldl" }
        链接指令 = 链接指令 & _原生链接串
        若 使用渲染 {
            链接指令 = 链接指令 & " \"" & 渲染桥Obj & "\" \"" & raylibA & "\""
            若 平台 == "darwin" { 链接指令 = 链接指令 & " -framework Cocoa -framework OpenGL -framework IOKit -framework CoreVideo" }
            若 平台 == "linux" { 链接指令 = 链接指令 & " -lGL -lm -lpthread -ldl -lrt -lX11" }
        }
        链接指令 = 链接指令 & " -o \"" & 输出路径 & "\""
    }
    
    设 gcc结果 = 执(链接指令)

    // 自愈:链接期"缺符号"(undefined reference)的典型成因是随包预编译运行时比正在编译的源码旧——
    // 已发布的老编译器带着老的 runtime .o(候选顺序里 .o 优先于 .c)去编译新源码,而新源码引用了
    // 运行时新符号,老 .o 与包内老 .c 都不含该符号,但 CWD/上级的同名 .c 正是同一份新源码。
    // 故按运行时候选顺序依次换源重链;候选里的 .c 由 gcc 在链接时现编,不必额外调用 clang。
    // 成功即采用该指令并继续(不再报错);全部失败则退回原指令,走下面的失败分支如实报错。
    设 自愈已尝试 = 假
    若 非 gcc结果.成功 且 gcc结果.错误.包含?("undefined reference") {
        设 _自愈次数 = 0
        遍历 _换源 于 _运行时候选 {
            若 _自愈次数 >= 4 { 断 }
            若 _换源 == rtFile 或 非 文件.存在?(_换源) { 续 }
            设 _试指令 = 链接指令.替换("\"" & rtFile & "\"", "\"" & _换源 & "\"")
            若 _试指令 == 链接指令 { 续 }
            设 _试结果 = 执(_试指令)
            _自愈次数 = _自愈次数 + 1
            自愈已尝试 = 真
            若 _试结果.成功 {
                链接指令 = _试指令
                gcc结果 = _试结果
                示("自愈: 改用 「" & _换源 & "」 链接成功(原 「" & rtFile & "」 缺所需运行时符号)")
                断
            }
        }
    }

    若 非 gcc结果.成功 {
        若 平台 == "windows" {
            示("MinGW 链接失败 (请确保已安装 GCC/MinGW): " & gcc结果.错误)
        } 否 {
            示("链接失败 (请确保已安装 clang/gcc): " & gcc结果.错误)
        }
        若 自愈已尝试 {
            示("提示: 已按运行时候选换源重链(自愈)仍失败 —— 随包运行时可能整体陈旧,请更新编译器发行包,或把本仓库 runtime/ 放在源码同级/上一级")
        }
        // 诊断:链接失败一律保留中间产物。此前只有 -bl/--保留 才保留,失败者拿不到 .ll/.o,
        // 也就无法手工重链定位真因;同时把可直接复制的链接命令打出来,不必再靠猜。
        复制文件("\"" & ll路径 & "\"", "\"自举输出.ll\"", 平台)
        复制文件("\"" & o路径 & "\"", "\"自举输出.o\"", 平台)
        示("中间产物已保留: 自举输出.ll / 自举输出.o(当前目录),缓存副本 " & ll路径 & " 亦保留")
        示("可手工重试的链接命令: " & 链接指令)
        xt_arena_destroy(池)
        终 1
    }
    
    若 非 文件.存在?(输出路径) {
        示("错误：链接成功但未找到生成的可执行文件 " & 输出路径)
        删文件([ll路径, o路径], 平台)
        xt_arena_destroy(池)
        终 1
    }

    // 清理缓存文件:默认编译成功即删中间产物;-bl/--保留 时才复制为 CWD 下 自举输出.ll/.o 供调试
    若 输出详细 { 示("清理临时编译文件...") }
    若 保留中间产物 {
        复制文件("\"" & ll路径 & "\"", "\"自举输出.ll\"", 平台)
        复制文件("\"" & o路径 & "\"", "\"自举输出.o\"", 平台)
    }
    删文件([ll路径, o路径], 平台)

    若 跑模式 {
        // 对齐 go run:不打印"编译完成"这类噪声,直接运行并透传退出码
        设 _清理 = ""
        若 临时产物需清理 { _清理 = 输出路径 }
        若 统计时间 {
            示("--- 编译统计 ---")
            示("总计耗时: #{(时.毫秒() - 开始时间)} 毫秒")
        }
        // 运行→清理→按退出码收场,全部在运行时内完成(xt_run_inherit_exit 不返回)。
        // 不经 终 <变量>:解析层只认数字字面量,终 码 会被静默忽略退成 0。
        xt_run_inherit_exit(输出路径, 程序参数, _清理)
        终 1   // 兜底:理论上到不了(上一行必定结束进程)
    }

    示("原生编译完成: " & 输出路径)

    若 统计时间 {
        设 结束时间 = 时.毫秒()
        设 耗时 = 结束时间 - 开始时间
        示("--- 编译统计 ---")
        示("总计耗时: #{耗时} 毫秒")
    }

    xt_arena_destroy(池)
    终 0
}
