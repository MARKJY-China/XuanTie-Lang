# 句读:源码/测试/文档入库;build 产物除外(其下 *.exe 已被全局规则覆盖)
!/句读/
/句读/build/
!/句读/tests/
!/句读/tests/**
!/句读/**/*.py
!/句读/CLAUDE.md

# 性能基准:跑分器与对照语料必须入库(第 37 行 *.py 会连 run.py 一起挡掉,
# 首次提交时 bench/run.py 与 bench/cases/python_bench.py 因此被静默跳过)
!/bench/**/*.py
# vendor 源码被 test* 规则误伤的单文件白名单(DSH 内核构建输入)
!ide/vendor/dsh/packages/dsh-tools/src/testing.ts

!/lib/SQLite/*.o
# 独立契约仓库(嵌套 git 仓库,不得被主仓库当子模块/裸目录吸收)
/xt-ecosystem/
# 会话日志属本地工作记录,不入库(跨会话交接写进契约或正式文档)
/docs/sessions/
# API 参考为 tools/gen-api.mjs 的生成物,不入库(离线包会带上)
/GUIDE/API/
