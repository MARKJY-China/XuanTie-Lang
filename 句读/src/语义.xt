// 语义.xt —— 名表解析 + 静态检查 + 玄名分配
// 职责:① 虚指预检(块级名表,块内重立遮蔽外者,块终即灭);
//       ② 受之实参位裸名三态标注:键态 0=值 / 1=键文直书(未立而收者标册) / 2=双态(已立,运行时判);
//       ③ 止须在循中;诀唯立于卷之顶层;诀体内唯见诀名与己参;
//       ④ 为每一名分配唯一场名 jd_名_N(避玄铁关键字与内建撞名),诀盒为 jd_诀名。
// 名之提示(型词)取声明所书或初值显然型,赋值不改标;提示仅用于键态裁决。
// 宿主约束:遍历变量落全局槽,而本器诸走法互相递归——凡列队行走一律用索引式当循环(局部计数按帧隔离)。

型 语义器 {
    设 源行们 = []
    设 卷名 = ""
    设 层 = []        // 作用域栈;每层 {名: [场名, 提示]}
    设 诀名们 = {}    // 诀名 → 场名(jd_诀名)
    设 场 = 0         // 场名计数
    设 循深 = 0
    设 诀深 = 0

    函 造(源行们参, 卷名参) {
        此.源行们 = 源行们参
        此.卷名 = 卷名参
        此.层 = []
        此.诀名们 = {}
        此.场 = 0
        此.循深 = 0
        此.诀深 = 0
    }

    函 译错(类目, 消息, 行) {
        报译错(类目, 消息, 行, 此.源行们, 此.卷名)
    }

    函 新场名(名) {
        此.场 = 此.场 + 1
        返 "jd_" & 名 & "_" & 字(此.场)
    }

    // 收诀名(先行一遍,许先呼后立)
    函 收诀名(句们) {
        设 i = 0
        设 n = 句们.长度
        当 i < n {
            设 节 = 句们[i]
            若 节["类"] == "诀定义" {
                若 此.诀名们.包含?(节["名"]) {
                    此.译错("文法之失", "名「" & 节["名"] & "」已立,不得重立。", 节["行"])
                }
                此.诀名们[节["名"]] = "jd_诀" & 节["名"]
            }
            i = i + 1
        }
    }

    函 查名(名) {
        设 i = 此.层.长度 - 1
        当 i >= 0 {
            若 此.层[i].包含?(名) {
                返 此.层[i][名]
            }
            i = i - 1
        }
        若 此.诀名们.包含?(名) {
            返 [此.诀名们[名], "诀"]
        }
        返 空
    }

    函 已立?(名) {
        设 r = 此.查名(名)
        若 r == 空 { 返 假 }
        返 真
    }

    // 立名于当前层;同层重立为文法之失(可遮外层与诀名)
    函 立名(名, 提示, 行) {
        设 顶 = 此.层[此.层.长度 - 1]
        若 顶.包含?(名) {
            此.译错("文法之失", "名「" & 名 & "」已立于本块,不得重立。", 行)
        }
        设 场名 = 此.新场名(名)
        顶[名] = [场名, 提示]
        返 场名
    }

    函 推型(节) {
        设 类 = 节["类"]
        若 类 == "数" { 返 "数" }
        若 类 == "文" { 返 "文" }
        若 类 == "列值" { 返 "列" }
        若 类 == "然" { 返 "然否" }
        若 类 == "空值" { 返 "空" }
        若 类 == "名" {
            设 r = 此.查名(节["名"])
            若 r == 空 { 返 "" }
            返 r[1]
        }
        返 ""
    }

    // —— 语句遍历 ——

    函 走句们(句们, 新层) {
        若 新层 {
            此.层.追加({})
        }
        设 i = 0
        设 n = 句们.长度
        当 i < n {
            此.走句(句们[i])
            i = i + 1
        }
        若 新层 {
            此.层.删(此.层.长度 - 1)
        }
    }

    函 走句(节) {
        设 类 = 节["类"]
        若 类 == "声明" {
            设 提示 = 节["型词"]
            若 提示 == "" {
                设 提示 = 此.推型(节["值"])
            }
            此.走表达式(节["值"])
            设 场名 = 此.立名(节["名"], 提示, 节["行"])
            节["玄名"] = 场名
            返
        }
        若 类 == "赋值" {
            此.走赋值目标(节["目标"])
            此.走表达式(节["值"])
            返
        }
        若 类 == "输出" {
            此.走表达式(节["值"])
            返
        }
        若 类 == "条件" {
            设 枝们 = 节["枝"]
            设 i = 0
            设 n = 枝们.长度
            当 i < n {
                此.走表达式(枝们[i]["当"])
                此.走句们(枝们[i]["体"], 真)
                i = i + 1
            }
            若 节["否则"].长度 > 0 {
                此.走句们(节["否则"], 真)
            }
            返
        }
        若 类 == "循环" {
            若 节["当型"] {
                此.走表达式(节["条件"])
            } 否 {
                此.走表达式(节["列"])
            }
            此.层.追加({})
            此.循深 = 此.循深 + 1
            若 非 节["当型"] {
                设 场名 = 此.立名(节["名"], "", 节["行"])
                节["元玄名"] = 场名
            }
            设 体 = 节["体"]
            设 i = 0
            设 n = 体.长度
            当 i < n {
                此.走句(体[i])
                i = i + 1
            }
            此.循深 = 此.循深 - 1
            此.层.删(此.层.长度 - 1)
            返
        }
        若 类 == "止句" {
            若 此.循深 == 0 {
                此.译错("文法之失", "「止」不在任何循中。", 节["行"])
            }
            返
        }
        若 类 == "故曰" {
            此.走表达式(节["值"])
            返
        }
        若 类 == "受句" {
            此.译错("文法之失", "「受」引参之句唯居于诀体之首。", 节["行"])
            返
        }
        若 类 == "诀定义" {
            若 此.层.长度 > 1 或 此.诀深 > 0 {
                此.译错("文法之失", "诀「" & 节["名"] & "」唯立于卷之顶层。", 节["行"])
            }
            此.走诀体(节)
            返
        }
        若 类 == "表达式语句" {
            此.走表达式(节["值"])
            返
        }
        此.译错("文法之失", "未识之句类「" & 类 & "」。", 节["行"])
    }

    // 诀体:唯见诀名与己参(卷之变量不入诀)
    函 走诀体(节) {
        设 存层 = 此.层
        设 存循 = 此.循深
        设 基 = {}
        此.层 = [基]
        此.循深 = 0
        此.诀深 = 此.诀深 + 1
        若 节["口诀"] {
            // 规则之名共享诀级一域:同名重缚复用其玄名(逐规则重缚其值)
            此.层.追加({})
            设 规们 = 节["规则"]
            设 i = 0
            设 n = 规们.长度
            当 i < n {
                此.走规则(规们[i])
                i = i + 1
            }
            此.层.删(此.层.长度 - 1)
        } 否 {
            若 节["参"] != "" {
                设 参场 = 此.新场名(节["参"])
                节["参玄名"] = 参场
                基[节["参"]] = [参场, ""]
            }
            设 体 = 节["体"]
            设 i = 0
            设 n = 体.长度
            当 i < n {
                此.走句(体[i])
                i = i + 1
            }
        }
        此.诀深 = 此.诀深 - 1
        此.层 = 存层
        此.循深 = 存循
    }

    // 规则:模式之名缚于诀级共享域(同名重缚复用玄名);守卫与动作于缚后求值
    函 缚规则名(名, 行) {
        设 顶 = 此.层[此.层.长度 - 1]
        若 顶.包含?(名) {
            返 顶[名][0]
        }
        设 场名 = 此.新场名(名)
        顶[名] = [场名, ""]
        返 场名
    }

    函 走规则(规) {
        设 模式 = 规["模式"]
        若 规["兜底"] {
            此.走表达式(规["动作"])
            返
        }
        若 模式["类"] == "名" {
            设 场名 = 此.缚规则名(模式["名"], 规["行"])
            模式["玄名"] = 场名
        }
        若 模式["类"] == "列值" {
            设 项们 = 模式["元"]
            设 i = 0
            设 n = 项们.长度
            当 i < n {
                若 项们[i]["类"] == "名" {
                    设 场名 = 此.缚规则名(项们[i]["名"], 规["行"])
                    项们[i]["玄名"] = 场名
                }
                i = i + 1
            }
        }
        若 规["当"]["类"] != "空值" {
            此.走表达式(规["当"])
        }
        此.走表达式(规["动作"])
    }

    // —— 表达式遍历 ——

    函 走表达式(节) {
        设 类 = 节["类"]
        若 类 == "名" {
            设 r = 此.查名(节["名"])
            若 r == 空 {
                此.译错("虚指之失", "名「" & 节["名"] & "」未立。", 节["行"])
            }
            节["玄名"] = r[0]
            返
        }
        若 类 == "列值" {
            设 元们 = 节["元"]
            设 i = 0
            设 n = 元们.长度
            当 i < n {
                此.走表达式(元们[i])
                i = i + 1
            }
            返
        }
        若 类 == "尊名" {
            若 节["实"]["类"] != "空值" {
                此.走表达式(节["实"])
            }
            返
        }
        若 类 == "受用" {
            此.走表达式(节["收"])
            此.走受实(节["收"], 节["实"])
            返
        }
        若 类 == "二元" {
            此.走表达式(节["左"])
            此.走表达式(节["右"])
            返
        }
        若 类 == "一元" {
            此.走表达式(节["子"])
            返
        }
        返
    }

    // 受之实参位裸名三态
    函 走受实(收节, 实节) {
        若 实节["类"] != "名" {
            此.走表达式(实节)
            实节["键态"] = 0
            返
        }
        设 收提示 = ""
        若 收节["类"] == "名" {
            设 r = 此.查名(收节["名"])
            若 r == 空 {
                // 收者虚指已由走表达式(收节)报出;此处只兜底
                实节["键态"] = 0
                此.走表达式(实节)
                返
            }
            设 收提示 = r[1]
        }
        设 实立 = 此.已立?(实节["名"])
        若 收提示 == "册" {
            若 实立 {
                设 rr = 此.查名(实节["名"])
                实节["键态"] = 2
                实节["玄名"] = rr[0]
            } 否 {
                实节["键态"] = 1
            }
            返
        }
        若 实立 {
            设 rr = 此.查名(实节["名"])
            实节["键态"] = 2
            实节["玄名"] = rr[0]
            返
        }
        此.译错("虚指之失", "名「" & 实节["名"] & "」未立。", 实节["行"])
    }

    // 赋值目标:名须已立;受用目标之收者须已立,实参静态定键态(标册→键文,余→值)
    函 走赋值目标(节) {
        若 节["类"] == "名" {
            设 r = 此.查名(节["名"])
            若 r == 空 {
                // 纳于未立之名者立之(计划书试一五所本);唯本块立,不越层
                设 场名 = 此.立名(节["名"], "", 节["行"])
                节["玄名"] = 场名
                节["新立"] = 真
                返
            }
            节["玄名"] = r[0]
            返
        }
        若 节["类"] == "受用" {
            设 r = 此.查名(节["收"]["名"])
            若 r == 空 {
                此.译错("虚指之失", "名「" & 节["收"]["名"] & "」未立。", 节["行"])
            }
            节["收"]["玄名"] = r[0]
            设 实节 = 节["实"]
            若 实节["类"] == "名" {
                若 r[1] == "册" {
                    若 此.已立?(实节["名"]) {
                        设 rr = 此.查名(实节["名"])
                        实节["键态"] = 2
                        实节["玄名"] = rr[0]
                    } 否 {
                        实节["键态"] = 1
                    }
                    返
                }
                设 rr = 此.查名(实节["名"])
                若 rr == 空 {
                    此.译错("虚指之失", "名「" & 实节["名"] & "」未立。", 实节["行"])
                }
                实节["键态"] = 0
                实节["玄名"] = rr[0]
                返
            }
            此.走表达式(实节)
            实节["键态"] = 0
            返
        }
        此.译错("文法之失", "赋值目标唯名或应用式。", 节["行"])
    }

    // 主入口:先收诀名,后行走(诀体自带净域)
    函 行(句们) {
        此.层 = [{}]
        此.收诀名(句们)
        设 i = 0
        设 n = 句们.长度
        当 i < n {
            此.走句(句们[i])
            i = i + 1
        }
    }
}
