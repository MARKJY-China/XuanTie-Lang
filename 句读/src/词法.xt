// 词法.xt —— 句读词法器
// 管线:逐字扫描 → 全半角归一(括内/串内不归一) → 最长匹配切词 → 饰号丢弃 →
//       句终/续行判定(行末为运算符/未阖开括/顿号/续行者,次行续之) → 批注丢弃。
// 标记 = [类型串, 值串, 行整, 数性整];数性=1 表此名形之文恰为合规数词(列表元素位按数解)。
// 引 报译错(抽象树.xt)、解数词(词数.xt)。

函 是数词字(c) {
    若 c == "〇" 或 c == "零" { 返 真 }
    若 c == "一" 或 c == "二" 或 c == "三" 或 c == "四" 或 c == "五" { 返 真 }
    若 c == "六" 或 c == "七" 或 c == "八" 或 c == "九" { 返 真 }
    若 c == "十" 或 c == "百" 或 c == "千" { 返 真 }
    返 假
}

// 归一:全角符号折为规范形(仅括外/串外调用)
函 归一符(c) {
    若 c == "　" { 返 " " }
    匹配 c {
        "，" -> { 返 "," }
        "、" -> { 返 "," }
        "。" -> { 返 "." }
        "：" -> { 返 ":" }
        "？" -> { 返 "?" }
        "！" -> { 返 "!" }
        "「" -> { 返 "[" }
        "」" -> { 返 "]" }
        "《" -> { 返 "<" }
        "》" -> { 返 ">" }
        _ -> { 返 c }
    }
}

// 拼音逃生舱表:词 → 标记类型(批 之 pi 在主循环特判为注)
函 拼音标记(词) {
    匹配 词 {
        "zhe" -> { 返 "者" }
        "ye" -> { 返 "也" }
        "ruo" -> { 返 "若" }
        "ze" -> { 返 "则" }
        "buran" -> { 返 "不然" }
        "buranruo" -> { 返 "不然若" }
        "xun" -> { 返 "循" }
        "shou" -> { 返 "受" }
        "guyue" -> { 返 "故曰" }
        "na" -> { 返 "纳" }
        "yu" -> { 返 "于" }
        "jue" -> { 返 "诀" }
        "jian" -> { 返 "见" }
        "dang" -> { 返 "当" }
        "zhi" -> { 返 "止" }
        "shu" -> { 返 "书" }
        "num" -> { 返 "型数" }
        "wen" -> { 返 "型文" }
        "lie" -> { 返 "型列" }
        "ce" -> { 返 "型册" }
        "ranfou" -> { 返 "型然否" }
        "ran" -> { 返 "然" }
        "fou" -> { 返 "否" }
        "kong" -> { 返 "空" }
        "jia" -> { 返 "加" }
        "cheng" -> { 返 "乘" }
        "chu" -> { 返 "除" }
        "fei" -> { 返 "非" }
        "qie" -> { 返 "且" }
        "huo" -> { 返 "或" }
        "dayu" -> { 返 "大于" }
        "xiaoyu" -> { 返 "小于" }
        "dengyu" -> { 返 "等于" }
        "budayu" -> { 返 "不大于" }
        "buxiaoyu" -> { 返 "不小于" }
        "budengyu" -> { 返 "不等于" }
        "fu" -> { 返 "负" }
        _ -> { 返 "" }
    }
}

// 尊名内容归一(问/签/度 或 wen/qian/du)
函 尊名归一(词) {
    匹配 词 {
        "问" -> { 返 "问" }
        "签" -> { 返 "签" }
        "度" -> { 返 "度" }
        "wen" -> { 返 "问" }
        "qian" -> { 返 "签" }
        "du" -> { 返 "度" }
        _ -> { 返 "" }
    }
}

// 复合词最长匹配:在 c 起处试三字词、二字词,返回 [词长, 标记类型];无则 [0, ""]
函 复合词(c, c2, c3) {
    设 三 = c & c2 & c3
    匹配 三 {
        "不然若" -> { 返 [3, "不然若"] }
        "不大于" -> { 返 [3, "不大于"] }
        "不小于" -> { 返 [3, "不小于"] }
        "不等于" -> { 返 [3, "不等于"] }
        _ -> { }
    }
    设 二 = c & c2
    匹配 二 {
        "不然" -> { 返 [2, "不然"] }
        "故曰" -> { 返 [2, "故曰"] }
        "然否" -> { 返 [2, "型然否"] }
        "大于" -> { 返 [2, "大于"] }
        "小于" -> { 返 [2, "小于"] }
        "等于" -> { 返 [2, "等于"] }
        _ -> { }
    }
    返 [0, ""]
}

函 单字词(c) {
    匹配 c {
        "者" -> { 返 "者" }
        "也" -> { 返 "也" }
        "若" -> { 返 "若" }
        "则" -> { 返 "则" }
        "循" -> { 返 "循" }
        "受" -> { 返 "受" }
        "纳" -> { 返 "纳" }
        "于" -> { 返 "于" }
        "诀" -> { 返 "诀" }
        "见" -> { 返 "见" }
        "当" -> { 返 "当" }
        "止" -> { 返 "止" }
        "书" -> { 返 "书" }
        "加" -> { 返 "加" }
        "减" -> { 返 "减" }
        "乘" -> { 返 "乘" }
        "除" -> { 返 "除" }
        "余" -> { 返 "余" }
        "且" -> { 返 "且" }
        "或" -> { 返 "或" }
        "非" -> { 返 "非" }
        "负" -> { 返 "负" }
        "然" -> { 返 "然" }
        "否" -> { 返 "否" }
        "空" -> { 返 "空" }
        "数" -> { 返 "型数" }
        "文" -> { 返 "型文" }
        "列" -> { 返 "型列" }
        "册" -> { 返 "型册" }
        _ -> { 返 "" }
    }
}

// 名内禁字:凡结构符与空白不得入名(汉字、字母、数字、下划线可用)
函 名禁字(c) {
    若 c == " " 或 c == "\t" 或 c == "\n" { 返 真 }
    设 形 = 归一符(c)
    匹配 形 {
        "," -> { 返 真 }
        "." -> { 返 真 }
        ";" -> { 返 真 }
        ":" -> { 返 真 }
        "?" -> { 返 真 }
        "!" -> { 返 真 }
        "[" -> { 返 真 }
        "]" -> { 返 真 }
        "<" -> { 返 真 }
        ">" -> { 返 真 }
        _ -> { }
    }
    若 c == "…" 或 c == "……" { 返 真 }
    若 c == "(" 或 c == ")" 或 c == "{" 或 c == "}" { 返 真 }
    若 c == "\"" 或 c == "'" 或 c == "\\" { 返 真 }
    若 c == "+" 或 c == "-" 或 c == "*" 或 c == "/" 或 c == "%" 或 c == "=" { 返 真 }
    若 c == "&" 或 c == "|" 或 c == "^" 或 c == "~" 或 c == "#" 或 c == "$" 或 c == "@" { 返 真 }
    返 假
}

型 词法器 {
    设 源字 = []
    设 位置 = 0
    设 总长 = 0
    设 行 = 1
    设 源行们 = []
    设 卷名 = ""

    函 造(源文, 源行们参, 卷名参) {
        此.源字 = 源文.分割("")
        此.总长 = 此.源字.长度
        此.位置 = 0
        此.行 = 1
        此.源行们 = 源行们参
        此.卷名 = 卷名参
    }

    函 现字() {
        若 此.位置 < 此.总长 { 返 此.源字[此.位置] }
        返 "终止"
    }

    函 望字(偏) {
        若 此.位置 + 偏 < 此.总长 { 返 此.源字[此.位置 + 偏] }
        返 "终止"
    }

    函 进() {
        若 此.位置 < 此.总长 {
            若 此.源字[此.位置] == "\n" { 此.行 = 此.行 + 1 }
            此.位置 = 此.位置 + 1
        }
    }

    函 译错(消息, 行) {
        报译错("文法之失", 消息, 行, 此.源行们, 此.卷名)
    }

    // 掠至行末(批注)
    函 掠至行末() {
        当 此.现字() != "\n" 且 此.现字() != "终止" {
            此.进()
        }
    }

    // 文字面量扫描:起位指向开括(「或[),开形与阖形须同制。
    // 规则:内层成对括号可嵌;平衡后首个独立阖括须成双(」」/]])方阖。
    // 返回 [是否成功, 内容, 止位(阖毕之后)]
    函 掠文面(起位) {
        设 开符 = 此.源字[起位]
        设 阖符 = "]"
        若 开符 == "「" { 设 阖符 = "」" }
        设 i = 起位 + 2
        设 深 = 0
        设 已出 = ""
        当 i < 此.总长 {
            设 c = 此.源字[i]
            若 c == "\n" {
                返 [假, "", i]
            }
            若 c == 开符 {
                深 = 深 + 1
                i = i + 1
            } 抑 c == 阖符 {
                若 深 > 0 {
                    深 = 深 - 1
                    i = i + 1
                } 否 {
                    若 i + 1 < 此.总长 且 此.源字[i + 1] == 阖符 {
                        设 n = i - 起位 - 2
                        已出 = 此.取段(起位 + 2, n)
                        返 [真, 已出, i + 2]
                    }
                    返 [假, "", i]
                }
            } 否 {
                i = i + 1
            }
        }
        返 [假, "", i]
    }

    函 取段(起, 长) {
        设 s = ""
        设 i = 0
        当 i < 长 {
            s = s & 此.源字[起 + i]
            i = i + 1
        }
        返 s
    }

    // 括内掠视:自 开括后一位 起平扫,遇串面则整串跳过(不计深),
    // 返回 [内文, 阖括位];未阖返回 ["", -1]。
    函 掠括内(起位) {
        设 i = 起位 + 1
        设 深 = 1
        当 i < 此.总长 {
            设 c = 此.源字[i]
            若 c == "[" 或 c == "「" {
                若 i + 1 < 此.总长 且 (此.源字[i + 1] == "[" 或 此.源字[i + 1] == "「") {
                    设 r = 此.掠文面(i)
                    若 非 r[0] { 返 ["", -1] }
                    i = r[2]
                    续
                }
                深 = 深 + 1
                i = i + 1
            } 抑 c == "]" 或 c == "」" {
                深 = 深 - 1
                若 深 == 0 {
                    返 [此.取段(起位 + 1, i - 起位 - 1), i]
                }
                i = i + 1
            } 否 {
                i = i + 1
            }
        }
        返 ["", -1]
    }

    函 名合规(串) {
        若 串 == "" { 返 假 }
        遍历 c 于 串.分割("") {
            若 名禁字(c) { 返 假 }
        }
        返 真
    }

    // 末标记是否容续行(行末为运算符/顿号/开括/续行号者次行续之)
    函 末可续(标记们) {
        设 n = 标记们.长度
        若 n == 0 { 返 假 }
        设 t = 标记们[n - 1][0]
        匹配 t {
            "加" -> { 返 真 }
            "减" -> { 返 真 }
            "乘" -> { 返 真 }
            "除" -> { 返 真 }
            "余" -> { 返 真 }
            "大于" -> { 返 真 }
            "小于" -> { 返 真 }
            "等于" -> { 返 真 }
            "不大于" -> { 返 真 }
            "不小于" -> { 返 真 }
            "不等于" -> { 返 真 }
            "且" -> { 返 真 }
            "或" -> { 返 真 }
            "非" -> { 返 真 }
            "负" -> { 返 真 }
            "受" -> { 返 真 }
            "故曰" -> { 返 真 }
            "逗" -> { 返 真 }
            "开" -> { 返 真 }
            "续行" -> { 返 真 }
            _ -> { 返 假 }
        }
    }

    函 全部标记() {
        设 标记们 = []
        设 括深 = 0
        循 {
            // 跳空白
            循 {
                设 c = 归一符(此.现字())
                若 c == " " 或 c == "\t" 或 c == ":" 或 c == "?" {
                    此.进()
                } 否 {
                    断
                }
            }
            设 c = 归一符(此.现字())
            若 c == "终止" { 断 }

            // 批注三形:批 / // / 行首 pi
            若 c == "批" { 此.掠至行末() ; 续 }
            若 c == "/" {
                若 归一符(此.望字(1)) == "/" { 此.掠至行末() ; 续 }
                // 单斜线即除号
                标记们.追加(["除", "", 此.行, 0])
                此.进()
                续
            }

            // ASCII 运算符:+ - * % == && ||(单 = & | 为文法之失)
            若 c == "+" {
                标记们.追加(["加", "", 此.行, 0])
                此.进()
                续
            }
            若 c == "-" {
                标记们.追加(["减", "", 此.行, 0])
                此.进()
                续
            }
            若 c == "*" {
                标记们.追加(["乘", "", 此.行, 0])
                此.进()
                续
            }
            若 c == "%" {
                标记们.追加(["余", "", 此.行, 0])
                此.进()
                续
            }
            若 c == "=" {
                若 归一符(此.望字(1)) == "=" {
                    标记们.追加(["等于", "", 此.行, 0])
                    此.进()
                    此.进()
                    续
                }
                此.译错("句读无赋值符,纳…于…是赋。", 此.行)
            }
            若 c == "&" {
                若 归一符(此.望字(1)) == "&" {
                    标记们.追加(["且", "", 此.行, 0])
                    此.进()
                    此.进()
                    续
                }
                此.译错("未识之符「&」(且须双书 &&)。", 此.行)
            }
            若 c == "|" {
                若 归一符(此.望字(1)) == "|" {
                    标记们.追加(["或", "", 此.行, 0])
                    此.进()
                    此.进()
                    续
                }
                此.译错("未识之符「|」(或须双书 ||)。", 此.行)
            }

            // 句终:换行(视续行条件)/ 。 / ;
            若 c == "\n" {
                若 括深 > 0 或 此.末可续(标记们) {
                    此.进()
                    续
                }
                标记们.追加(["句终", "", 此.行, 0])
                此.进()
                续
            }
            若 c == "." {
                若 归一符(此.望字(1)) == "." {
                    标记们.追加(["续行", "", 此.行, 0])
                    此.进()
                    此.进()
                    续
                }
                标记们.追加(["句终", "", 此.行, 0])
                此.进()
                续
            }
            若 c == ";" {
                标记们.追加(["句终", "", 此.行, 0])
                此.进()
                续
            }
            若 c == "…" {
                若 此.望字(1) == "…" {
                    标记们.追加(["续行", "", 此.行, 0])
                    此.进()
                    此.进()
                    续
                }
                此.译错("续行号须双书(……)。", 此.行)
            }

            // 顿号/读号
            若 c == "," {
                标记们.追加(["逗", "", 此.行, 0])
                此.进()
                续
            }

            // 非
            若 c == "!" {
                标记们.追加(["非", "", 此.行, 0])
                此.进()
                续
            }

            // 括与串面:先试串面,试扫失败即回退开括路径(列「「甲」、…」非串)
            若 c == "[" {
                若 归一符(此.望字(1)) == "[" {
                    设 r = 此.掠文面(此.位置)
                    若 r[0] {
                        标记们.追加(["文面", r[1], 此.行, 0])
                        设 跳 = r[2] - 此.位置
                        设 k = 0
                        当 k < 跳 { 此.进() ; k = k + 1 }
                        续
                    }
                    // 非串:落开括路径(未阖之错由掠括内报)
                }
                设 内 = 此.掠括内(此.位置)
                若 内[1] < 0 {
                    此.译错("括未阖。", 此.行)
                }
                若 此.名合规(内[0]) {
                    设 数性 = 0
                    设 试 = 解数词(内[0])
                    若 试[0] { 设 数性 = 1 }
                    标记们.追加(["名", 内[0], 此.行, 数性])
                    设 跳名 = 内[1] + 1 - 此.位置
                    设 k = 0
                    当 k < 跳名 { 此.进() ; k = k + 1 }
                } 否 {
                    括深 = 括深 + 1
                    标记们.追加(["开", "", 此.行, 0])
                    此.进()
                }
                续
            }
            若 c == "]" {
                若 括深 <= 0 {
                    此.译错("括未开而阖。", 此.行)
                }
                括深 = 括深 - 1
                标记们.追加(["阖", "", 此.行, 0])
                此.进()
                续
            }

            // 尊名《…》
            若 c == "<" {
                设 i = 此.位置 + 1
                设 内容 = ""
                设 已阖 = 假
                当 i < 此.总长 {
                    设 cc = 归一符(此.源字[i])
                    若 cc == ">" { 已阖 = 真 ; 断 }
                    若 cc == "\n" { 断 }
                    内容 = 内容 & cc
                    i = i + 1
                }
                若 非 已阖 {
                    此.译错("尊名未阖。", 此.行)
                }
                设 尊 = 尊名归一(内容)
                若 尊 == "" {
                    此.译错("未识之尊名《" & 内容 & "》(v0.1 仅问、签、度)。", 此.行)
                }
                标记们.追加(["尊名", 尊, 此.行, 0])
                设 跳 = i + 1 - 此.位置
                设 k = 0
                当 k < 跳 { 此.进() ; k = k + 1 }
                续
            }
            若 c == ">" {
                此.译错("尊括未开而阖。", 此.行)
            }

            // 阿拉伯数字串
            若 c == "0" 或 c == "1" 或 c == "2" 或 c == "3" 或 c == "4" 或 c == "5" 或 c == "6" 或 c == "7" 或 c == "8" 或 c == "9" {
                设 s = ""
                当 真 {
                    设 cc = 归一符(此.现字())
                    若 cc == "0" 或 cc == "1" 或 cc == "2" 或 cc == "3" 或 cc == "4" 或 cc == "5" 或 cc == "6" 或 cc == "7" 或 cc == "8" 或 cc == "9" {
                        s = s & cc
                        此.进()
                    } 否 {
                        断
                    }
                }
                标记们.追加(["数", s, 此.行, 0])
                续
            }

            // 汉字数词串(含负前缀)
            若 是数词字(c) 或 (c == "负" 且 是数词字(归一符(此.望字(1)))) {
                设 s = ""
                当 真 {
                    设 cc = 此.现字()
                    若 是数词字(cc) 或 (s == "" 且 cc == "负") {
                        s = s & cc
                        此.进()
                    } 否 {
                        断
                    }
                }
                设 试 = 解数词(s)
                若 非 试[0] {
                    此.译错("数词之形不合规:「" & s & "」。", 此.行)
                }
                标记们.追加(["数", 字(试[1]), 此.行, 0])
                续
            }

            // 拼音词
            若 此.是小写字母(c) {
                设 s = ""
                当 真 {
                    设 cc = 此.现字()
                    若 此.是小写字母(cc) {
                        s = s & cc
                        此.进()
                    } 否 {
                        断
                    }
                }
                若 s == "pi" {
                    此.掠至行末()
                    续
                }
                设 标 = 拼音标记(s)
                若 标 == "" {
                    此.译错("未识之词「" & s & "」。", 此.行)
                }
                标记们.追加([标, "", 此.行, 0])
                续
            }

            // 复合词 → 单字词
            设 c2 = 此.望字(1)
            设 c3 = 此.望字(2)
            设 复 = 复合词(c, c2, c3)
            若 复[0] > 0 {
                标记们.追加([复[1], "", 此.行, 0])
                设 k = 0
                当 k < 复[0] { 此.进() ; k = k + 1 }
                续
            }
            设 单 = 单字词(c)
            若 单 != "" {
                标记们.追加([单, "", 此.行, 0])
                此.进()
                续
            }

            此.译错("未识之字「" & c & "」。", 此.行)
        }
        标记们.追加(["卷终", "", 此.行, 0])
        返 标记们
    }

    函 是小写字母(c) {
        若 c == "a" 或 c == "b" 或 c == "c" 或 c == "d" 或 c == "e" 或 c == "f" 或 c == "g" 或 c == "h" 或 c == "i" 或 c == "j" { 返 真 }
        若 c == "k" 或 c == "l" 或 c == "m" 或 c == "n" 或 c == "o" 或 c == "p" 或 c == "q" 或 c == "r" 或 c == "s" 或 c == "t" { 返 真 }
        若 c == "u" 或 c == "v" 或 c == "w" 或 c == "x" 或 c == "y" 或 c == "z" { 返 真 }
        返 假
    }
}
