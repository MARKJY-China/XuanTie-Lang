// 词数.xt —— 数词解析(直书体/命位体/负前缀)
// 转译器(词法期验数词)与 jd_runtime(《问》读入判数)共用,单源防漂移。
// 输入:规范汉字串(〇零一二三四五六七八九十百千负)或 ASCII 数字串。
// 输出:[是否合规, 数值]——不合规时首元为假,不抛错(调用方决定报什么错)。

函 数值字(c) {
    匹配 c {
        "〇" -> { 返 0 }
        "零" -> { 返 0 }
        "一" -> { 返 1 }
        "二" -> { 返 2 }
        "三" -> { 返 3 }
        "四" -> { 返 4 }
        "五" -> { 返 5 }
        "六" -> { 返 6 }
        "七" -> { 返 7 }
        "八" -> { 返 8 }
        "九" -> { 返 9 }
        _ -> { 返 -1 }
    }
}

函 是位词(c) {
    若 c == "十" 或 c == "百" 或 c == "千" { 返 真 }
    返 假
}

// 判 ASCII 数字串(供词法器识别阿拉伯逃生舱)
函 是数字串(s) {
    若 s == "" { 返 假 }
    遍历 c 于 s.分割("") {
        设 v = 数值字(c)
        若 v < 0 {
            若 c == "0" 或 c == "1" 或 c == "2" 或 c == "3" 或 c == "4" 或 c == "5" 或 c == "6" 或 c == "7" 或 c == "8" 或 c == "9" {
                续
            }
            返 假
        }
    }
    返 真
}

// 主入口:解数词(串) → [真, n] / [假, 0]
函 解数词(串) {
    设 字们 = 串.分割("")
    设 n = 字们.长度
    若 n == 0 { 返 [假, 0] }
    设 负号 = 假
    设 起 = 0
    若 字们[0] == "负" {
        负号 = 真
        起 = 1
        若 n == 1 { 返 [假, 0] }
    }
    // 先察全串:有无位词 → 定直书/命位之体
    设 有位 = 假
    设 i = 起
    当 i < n {
        若 是位词(字们[i]) { 有位 = 真 }
        i = i + 1
    }
    设 值 = 0
    若 非 有位 {
        // 直书体:每字一码,逐位拼接
        设 位权 = 1
        i = n - 1
        当 i >= 起 {
            设 d = 数值字(字们[i])
            若 d < 0 { 返 [假, 0] }
            值 = 值 + d * 位权
            位权 = 位权 * 10
            i = i - 1
        }
    } 否 {
        // 命位体:数字暂记,位词结账;零可作垫字
        设 暂 = 0
        设 前为数字 = 假
        i = 起
        当 i < n {
            设 c = 字们[i]
            设 d = 数值字(c)
            若 d >= 0 {
                // 命位体中,数字串唯二合法:位词后起头、零垫之后续
                若 前为数字 且 暂 != 0 { 返 [假, 0] }
                暂 = 暂 * 10 + d
                前为数字 = 真
            } 抑 是位词(c) {
                设 底 = 暂
                若 底 == 0 { 底 = 1 }
                若 c == "十" { 值 = 值 + 底 * 10 }
                若 c == "百" { 值 = 值 + 底 * 100 }
                若 c == "千" { 值 = 值 + 底 * 1000 }
                暂 = 0
                前为数字 = 假
            } 否 {
                返 [假, 0]
            }
            i = i + 1
        }
        值 = 值 + 暂
        若 值 > 9999 { 返 [假, 0] }
    }
    若 负号 { 值 = 0 - 值 }
    返 [真, 值]
}
