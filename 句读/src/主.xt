// 主.xt —— 句读→玄铁 转译器入口
// 用法: jdt <源.jd> [-o 出.xt]
// 卷名 = 源文件名去目录去扩展;错误四字段之卷名与生成码之 jd_卷名 皆取之。
// 管线:读卷 → 词法 → 语法 → 语义 → 生成 → 写卷;任何一期之错即四字段报出、退出码一。

引 "./词数.xt"
引 "./抽象树.xt"
引 "./词法.xt"
引 "./语法.xt"
引 "./语义.xt"
引 "./生成.xt"
引 "../runtime/jd_runtime.xt"

外 函 xt_get_args(): 数组

函 基名(路径) {
    设 们 = 路径.分割("/")
    设 末 = 们[们.长度 - 1]
    设 们2 = 末.分割("\\")
    末 = 们2[们2.长度 - 1]
    设 n = 末.字符数
    若 n >= 3 {
        若 末.截取(n - 3, n) == ".jd" {
            返 末.截取(0, n - 3)
        }
    }
    返 末
}

函 默认出卷(路径) {
    设 n = 路径.字符数
    若 n >= 3 {
        若 路径.截取(n - 3, n) == ".jd" {
            返 路径.截取(0, n - 3) & ".xt"
        }
    }
    返 路径 & ".xt"
}

函 主() {
    设 参数 = xt_get_args()
    若 参数.长度 < 2 {
        示("用法: jdt <源.jd> [-o 出.xt]")
        终(1)
    }
    设 输入 = 参数[1]
    设 输出 = ""
    设 i = 2
    当 i + 1 < 参数.长度 + 1 {
        若 i + 1 < 参数.长度 且 参数[i] == "-o" {
            设 输出 = 参数[i + 1]
            i = i + 2
            续
        }
        i = i + 1
    }
    设 卷名 = 基名(输入)
    设 读 = 文件.读(输入)
    若 非 读.成功 {
        示("【文法之失】卷「" & 卷名 & "」第一行:源卷不可读(" & 读.错误 & ")。")
        终(1)
    }
    设 源文 = 读.值
    源文 = 源文.替换("\r\n", "\n")
    源文 = 源文.替换("\r", "\n")
    设 行们 = 源文.分割("\n")
    设 词 = 造 词法器(源文, 行们, 卷名)
    设 标记们 = 词.全部标记()
    设 法 = 造 语法器(标记们, 行们, 卷名)
    设 句们 = 法.解程序()
    设 义 = 造 语义器(行们, 卷名)
    义.行(句们)
    设 生 = 造 生成器(卷名)
    设 码 = 生.生成(句们, 行们)
    若 输出 == "" {
        设 输出 = 默认出卷(输入)
    }
    设 写 = 文件.写(输出, 码)
    若 非 写.成功 {
        示("【文法之失】卷「" & 卷名 & "」第一行:生成码不可写(" & 写.错误 & ")。")
        终(1)
    }
}

主()
