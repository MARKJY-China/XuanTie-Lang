// 生成.xt —— 代码生成:AST → 玄铁源码(模板拼接)
// 契约:生成物恒居 句读/build/,首行 引 "../runtime/jd_runtime.xt";
//       语义器已注齐 玄名/键态/元玄名/参玄名,此处纯机械映射,不复议名。
// 口诀静态展开:每口诀译为一玄铁函数,体内万次熔断循环,规则按序展开为若链;
//       非止规则以 v 更新(文模式施最左置换)后续(复自首条)。
// 缩进以级计(一级四格);凡列队行走一律索引式当循环(遍历变量落全局槽,本器递归,不可用)。

型 生成器 {
    设 卷名 = ""
    设 出 = []
    设 规缚 = {}     // 本口诀已缚之名 → 真(首现用设,复现用赋值)

    函 造(卷名参) {
        此.卷名 = 卷名参
        此.出 = []
        此.规缚 = {}
    }

    函 行(文) {
        此.出.追加(文)
    }

    函 空格(n) {
        设 s = ""
        设 i = 0
        当 i < n {
            s = s & "    "
            i = i + 1
        }
        返 s
    }

    // —— 字面量安全化:玄铁串面转义 + # 拆字(避 #{ 插值)——
    函 串面值(s) {
        设 字们 = s.分割("")
        设 n = 字们.长度
        设 r = "\""
        设 i = 0
        当 i < n {
            设 c = 字们[i]
            若 c == "\\" {
                r = r & "\\\\"
                i = i + 1
            } 抑 c == "\"" {
                r = r & "\\\""
                i = i + 1
            } 抑 c == "\n" {
                r = r & "\\n"
                i = i + 1
            } 抑 c == "\r" {
                r = r & "\\r"
                i = i + 1
            } 抑 c == "\t" {
                r = r & "\\t"
                i = i + 1
            } 抑 c == "#" {
                若 i + 1 < n 且 字们[i + 1] == "{" {
                    r = r & "\" & 字(\"#\") & \""
                }
                r = r & "#"
                i = i + 1
            } 否 {
                r = r & c
                i = i + 1
            }
        }
        返 r & "\""
    }

    函 接逗(们) {
        设 r = ""
        设 首 = 真
        设 i = 0
        设 n = 们.长度
        当 i < n {
            若 首 {
                设 首 = 假
            } 否 {
                r = r & ", "
            }
            r = r & 们[i]
            i = i + 1
        }
        返 r
    }

    函 诀函名(名) {
        返 "jd_" & 名 & "_诀"
    }

    函 诀场名(名) {
        返 "jd_诀" & 名
    }

    // —— 程序 ——

    函 生成(句们, 源行们) {
        此.行("引 \"../runtime/jd_runtime.xt\"")
        此.行("")
        此.行("设 jd_卷名 = " & 此.串面值(此.卷名))
        设 源面 = []
        设 i = 0
        设 n = 源行们.长度
        当 i < n {
            源面.追加(此.串面值(源行们[i]))
            i = i + 1
        }
        此.行("jd_源行 = [" & 此.接逗(源面) & "]")
        此.行("")
        i = 0
        当 i < 句们.长度 {
            若 句们[i]["类"] == "诀定义" {
                此.生成诀(句们[i])
            }
            i = i + 1
        }
        i = 0
        当 i < 句们.长度 {
            若 句们[i]["类"] == "诀定义" {
                此.行("设 " & 此.诀场名(句们[i]["名"]) & " = 诀盒(" & 此.诀函名(句们[i]["名"]) & ", " & 此.串面值(句们[i]["名"]) & ")")
            }
            i = i + 1
        }
        此.行("")
        i = 0
        当 i < 句们.长度 {
            若 句们[i]["类"] != "诀定义" {
                此.生成句(句们[i])
            }
            i = i + 1
        }
        设 文 = ""
        i = 0
        当 i < 此.出.长度 {
            文 = 文 & 此.出[i] & "\n"
            i = i + 1
        }
        返 文
    }

    // —— 诀 ——

    函 生成诀(节) {
        设 名 = 节["名"]
        此.规缚 = {}
        若 节["口诀"] {
            此.行("函 " & 此.诀函名(名) & "(受入) {")
            此.行("    设 v = 受入")
            此.行("    设 熔 = 0")
            此.行("    循 {")
            此.行("        熔 = 熔 + 1")
            此.行("        若 熔 > 10000 { 报错(\"循环之失\", \"口诀「" & 名 & "」递归触发逾万次。\", " & 字(节["行"]) & ") }")
            设 规们 = 节["规则"]
            设 i = 0
            设 n = 规们.长度
            当 i < n {
                此.生成规则(规们[i])
                i = i + 1
            }
            此.行("        返 v")
            此.行("    }")
            此.行("}")
            此.行("")
        } 否 {
            此.行("函 " & 此.诀函名(名) & "(受入) {")
            若 节["参"] != "" {
                此.行("    设 " & 节["参玄名"] & " = 受入")
            }
            设 体 = 节["体"]
            设 i = 0
            设 n = 体.长度
            当 i < n {
                此.生成句(体[i])
                i = i + 1
            }
            此.行("    返 空盒()")
            此.行("}")
            此.行("")
        }
    }

    // 规则展开(居熔断循环内,基级为 2)
    函 生成规则(规) {
        设 行s = 字(规["行"])
        若 规["兜底"] {
            此.生成动作(规, 2, "")
            返
        }
        设 模式 = 规["模式"]
        设 类 = 模式["类"]
        若 类 == "名" {
            若 此.规缚.包含?(模式["玄名"]) {
                此.行(此.空格(2) & 模式["玄名"] & " = v")
            } 否 {
                此.规缚[模式["玄名"]] = 真
                此.行(此.空格(2) & "设 " & 模式["玄名"] & " = v")
            }
            此.生成守卫动作(规, 行s, 2, "")
            返
        }
        若 类 == "数" {
            此.行(此.空格(2) & "若 v.型码 == 0 {")
            此.行(此.空格(3) & "若 v.数值 == " & 模式["值"] & " {")
            此.生成守卫动作(规, 行s, 4, "")
            此.行(此.空格(3) & "}")
            此.行(此.空格(2) & "}")
            返
        }
        若 类 == "文" {
            此.行(此.空格(2) & "若 v.型码 == 1 {")
            此.行(此.空格(3) & "若 v.文值.包含?(" & 此.串面值(模式["值"]) & ") {")
            此.生成守卫动作(规, 行s, 4, 此.串面值(模式["值"]))
            此.行(此.空格(3) & "}")
            此.行(此.空格(2) & "}")
            返
        }
        // 列模式:缚名于前,字面量逐项嵌验
        设 元们 = 模式["元"]
        设 n元 = 元们.长度
        设 字面数 = 0
        设 i = 0
        当 i < n元 {
            若 元们[i]["类"] != "名" {
                设 字面数 = 字面数 + 1
            }
            i = i + 1
        }
        此.行(此.空格(2) & "若 v.型码 == 2 {")
        此.行(此.空格(3) & "若 v.列值.长度 == " & 字(n元) & " {")
        i = 0
        当 i < n元 {
            若 元们[i]["类"] == "名" {
                若 此.规缚.包含?(元们[i]["玄名"]) {
                    此.行(此.空格(4) & 元们[i]["玄名"] & " = v.列值[" & 字(i) & "]")
                } 否 {
                    此.规缚[元们[i]["玄名"]] = 真
                    此.行(此.空格(4) & "设 " & 元们[i]["玄名"] & " = v.列值[" & 字(i) & "]")
                }
            }
            i = i + 1
        }
        i = 0
        当 i < n元 {
            若 元们[i]["类"] != "名" {
                此.行(此.空格(4) & "若 盒真(盒等(v.列值[" & 字(i) & "], " & 此.字面盒(元们[i]) & "), " & 行s & ") {")
            }
            i = i + 1
        }
        此.生成守卫动作(规, 行s, 4 + 字面数, "")
        i = n元
        当 i > 0 {
            i = i - 1
            若 元们[i]["类"] != "名" {
                此.行(此.空格(4) & "}")
            }
        }
        此.行(此.空格(3) & "}")
        此.行(此.空格(2) & "}")
        返
    }

    // 守卫(当)与动作:基级为守卫若所在层级
    函 生成守卫动作(规, 行s, 基级, 文模式串) {
        若 规["当"]["类"] != "空值" {
            此.行(此.空格(基级) & "若 盒真(" & 此.生成表达式(规["当"]) & ", " & 行s & ") {")
            此.生成动作(规, 基级 + 1, 文模式串)
            此.行(此.空格(基级) & "}")
        } 否 {
            此.生成动作(规, 基级, 文模式串)
        }
    }

    // 动作:止 → 返;文模式非止 → 最左置换后续;余者更新后续
    函 生成动作(规, 级, 文模式串) {
        设 缩 = 此.空格(级)
        设 动 = 此.生成表达式(规["动作"])
        若 规["止"] {
            此.行(缩 & "返 " & 动)
            返
        }
        若 文模式串 != "" {
            此.行(缩 & "v = 文盒(文最左置换(v.文值, " & 文模式串 & ", 书形(" & 动 & ")))")
        } 否 {
            此.行(缩 & "v = " & 动)
        }
        此.行(缩 & "续")
    }

    函 字面盒(节) {
        设 类 = 节["类"]
        若 类 == "数" {
            返 "数盒(" & 节["值"] & ")"
        }
        若 类 == "文" {
            返 "文盒(" & 此.串面值(节["值"]) & ")"
        }
        返 "空盒()"
    }

    // —— 语句 ——

    函 生成句(节) {
        设 类 = 节["类"]
        若 类 == "声明" {
            设 型词 = 节["型词"]
            若 型词 != "" {
                此.行("设 " & 节["玄名"] & " = " & 此.默认盒(型词))
            } 否 {
                此.行("设 " & 节["玄名"] & " = " & 此.生成表达式(节["值"]))
            }
            返
        }
        若 类 == "赋值" {
            设 目 = 节["目标"]
            若 目["类"] == "名" {
                若 目["新立"] {
                    此.行("设 " & 目["玄名"] & " = " & 此.生成表达式(节["值"]))
                } 否 {
                    此.行(目["玄名"] & " = " & 此.生成表达式(节["值"]))
                }
                返
            }
            设 收 = 此.生成表达式(目["收"])
            设 实节 = 目["实"]
            设 实码 = ""
            若 实节["键态"] == 1 {
                设 实码 = "文盒(" & 此.串面值(实节["名"]) & ")"
            } 否 {
                设 实码 = 此.生成表达式(实节)
            }
            此.行("纳受盒(" & 收 & ", " & 实码 & ", " & 此.生成表达式(节["值"]) & ", " & 字(节["行"]) & ")")
            返
        }
        若 类 == "输出" {
            此.行("书盒(" & 此.生成表达式(节["值"]) & ")")
            返
        }
        若 类 == "条件" {
            设 枝们 = 节["枝"]
            设 i = 0
            设 n = 枝们.长度
            当 i < n {
                若 i == 0 {
                    此.行("若 盒真(" & 此.生成表达式(枝们[i]["当"]) & ", " & 字(节["行"]) & ") {")
                } 否 {
                    此.行("} 抑 盒真(" & 此.生成表达式(枝们[i]["当"]) & ", " & 字(节["行"]) & ") {")
                }
                设 体 = 枝们[i]["体"]
                设 k = 0
                设 kn = 体.长度
                当 k < kn {
                    此.生成句(体[k])
                    k = k + 1
                }
                i = i + 1
            }
            若 节["否则"].长度 > 0 {
                此.行("} 否 {")
                设 体 = 节["否则"]
                设 k = 0
                设 kn = 体.长度
                当 k < kn {
                    此.生成句(体[k])
                    k = k + 1
                }
            }
            此.行("}")
            返
        }
        若 类 == "循环" {
            若 节["当型"] {
                此.行("当 盒真(" & 此.生成表达式(节["条件"]) & ", " & 字(节["行"]) & ") {")
            } 否 {
                此.行("遍历 " & 节["元玄名"] & " 于 列元(" & 此.生成表达式(节["列"]) & ", " & 字(节["行"]) & ") {")
            }
            设 体 = 节["体"]
            设 i = 0
            设 n = 体.长度
            当 i < n {
                此.生成句(体[i])
                i = i + 1
            }
            此.行("}")
            返
        }
        若 类 == "止句" {
            此.行("断")
            返
        }
        若 类 == "故曰" {
            此.行("返 " & 此.生成表达式(节["值"]))
            返
        }
        若 类 == "表达式语句" {
            此.行(此.生成表达式(节["值"]))
            返
        }
        返
    }

    函 默认盒(型词) {
        匹配 型词 {
            "数" -> { 返 "数盒(0)" }
            "文" -> { 返 "文盒(\"\")" }
            "列" -> { 返 "列盒([])" }
            "册" -> { 返 "册盒()" }
            "然否" -> { 返 "然盒(假)" }
            _ -> { 返 "空盒()" }
        }
    }

    // —— 表达式 ——

    函 生成表达式(节) {
        设 类 = 节["类"]
        若 类 == "数" {
            返 "数盒(" & 节["值"] & ")"
        }
        若 类 == "文" {
            返 "文盒(" & 此.串面值(节["值"]) & ")"
        }
        若 类 == "名" {
            返 节["玄名"]
        }
        若 类 == "然" {
            若 节["真"] {
                返 "然盒(真)"
            }
            返 "然盒(假)"
        }
        若 类 == "空值" {
            返 "空盒()"
        }
        若 类 == "列值" {
            设 元码 = []
            设 元们 = 节["元"]
            设 i = 0
            设 n = 元们.长度
            当 i < n {
                元码.追加(此.生成表达式(元们[i]))
                i = i + 1
            }
            返 "列盒([" & 此.接逗(元码) & "])"
        }
        若 类 == "尊名" {
            设 行s = 字(节["行"])
            若 节["名"] == "问" {
                返 "问盒()"
            }
            若 节["名"] == "签" {
                返 "签盒(" & 此.生成表达式(节["实"]) & ", " & 行s & ")"
            }
            返 "度盒(" & 此.生成表达式(节["实"]) & ", " & 行s & ")"
        }
        若 类 == "受用" {
            设 行s = 字(节["行"])
            设 收 = 此.生成表达式(节["收"])
            设 实节 = 节["实"]
            若 实节["键态"] == 1 {
                返 "受盒(" & 收 & ", 文盒(" & 此.串面值(实节["名"]) & "), " & 行s & ")"
            }
            若 实节["键态"] == 2 {
                返 "受盒二义(" & 收 & ", " & 此.串面值(实节["名"]) & ", " & 此.生成表达式(实节) & ", " & 行s & ")"
            }
            返 "受盒(" & 收 & ", " & 此.生成表达式(实节) & ", " & 行s & ")"
        }
        若 类 == "二元" {
            设 行s = 字(节["行"])
            设 L = 此.生成表达式(节["左"])
            设 R = 此.生成表达式(节["右"])
            设 运 = 节["运算"]
            若 运 == "加" { 返 "盒加(" & L & ", " & R & ", " & 行s & ")" }
            若 运 == "减" { 返 "盒减(" & L & ", " & R & ", " & 行s & ")" }
            若 运 == "乘" { 返 "盒乘(" & L & ", " & R & ", " & 行s & ")" }
            若 运 == "除" { 返 "盒除(" & L & ", " & R & ", " & 行s & ")" }
            若 运 == "余" { 返 "盒余(" & L & ", " & R & ", " & 行s & ")" }
            若 运 == "且" { 返 "盒且(" & L & ", " & R & ", " & 行s & ")" }
            若 运 == "或" { 返 "盒或(" & L & ", " & R & ", " & 行s & ")" }
            若 运 == "等于" { 返 "盒等(" & L & ", " & R & ")" }
            若 运 == "大于" { 返 "盒小(" & R & ", " & L & ", " & 行s & ")" }
            若 运 == "小于" { 返 "盒小(" & L & ", " & R & ", " & 行s & ")" }
            若 运 == "不小于" { 返 "盒非(盒小(" & L & ", " & R & ", " & 行s & "), " & 行s & ")" }
            若 运 == "不大于" { 返 "盒非(盒小(" & R & ", " & L & ", " & 行s & "), " & 行s & ")" }
            返 "盒非(盒等(" & L & ", " & R & "), " & 行s & ")"
        }
        若 类 == "一元" {
            设 行s = 字(节["行"])
            设 子 = 此.生成表达式(节["子"])
            若 节["运算"] == "非" {
                返 "盒非(" & 子 & ", " & 行s & ")"
            }
            返 "盒负(" & 子 & ", " & 行s & ")"
        }
        返 "空盒()"
    }
}
