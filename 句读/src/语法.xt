// 语法.xt —— 句读语法器(递归下降出 AST)
// 两枢机保证无前瞻回溯:受必取原子;也字两处不相混(声明之也随句阖,块终之也独居语句之首)。
// 块阖之词(也/不然/不然若)兼有句终之效:语句后遇之即止,不吞。
// 表达式七级:受应用 > 非/负 > 乘除余 > 加减 > 比较 > 且 > 或;同级左结合;无成组符。

型 语法器 {
    设 标记们 = []
    设 位 = 0
    设 总数 = 0
    设 源行们 = []
    设 卷名 = ""
    设 诀深 = 0
    设 诀首态 = 0   // 0 非诀体;1 诀体待首句;2 首句已过

    函 造(标记们参, 源行们参, 卷名参) {
        此.标记们 = 标记们参
        此.总数 = 标记们参.长度
        此.位 = 0
        此.源行们 = 源行们参
        此.卷名 = 卷名参
        此.诀深 = 0
    }

    函 现() {
        若 此.位 < 此.总数 { 返 此.标记们[此.位] }
        返 此.标记们[此.总数 - 1]
    }

    函 类() {
        返 此.现()[0]
    }

    函 望类(偏) {
        若 此.位 + 偏 < 此.总数 { 返 此.标记们[此.位 + 偏][0] }
        返 "卷终"
    }

    函 进() {
        若 此.位 < 此.总数 - 1 { 此.位 = 此.位 + 1 }
    }

    函 行() {
        返 此.现()[2]
    }

    函 译错(消息) {
        报译错("文法之失", 消息, 此.行(), 此.源行们, 此.卷名)
    }

    函 望(类型, 何物) {
        若 此.类() != 类型 {
            此.译错("期望" & 何物 & ",今得「" & 此.类() & "」。")
        }
        设 t = 此.现()
        此.进()
        返 t
    }

    // 跳句终与读号(饰号)
    函 跳句终() {
        当 真 {
            设 t = 此.类()
            若 t == "句终" 或 t == "逗" {
                此.进()
            } 否 {
                断
            }
        }
    }

    // 语句后之句尾:吞句终(可带饰号),也/不然/不然若/卷终 留予调用方
    函 收句尾() {
        此.跳句终()
    }

    // —— 程序 ——

    函 解程序() {
        设 句们 = []
        此.跳句终()
        当 此.类() != "卷终" {
            句们.追加(此.解语句())
            此.跳句终()
        }
        返 句们
    }

    // —— 语句 ——

    函 解语句() {
        此.跳句终()
        设 t = 此.类()
        匹配 t {
            "名" -> { 返 此.解名首句() }
            "纳" -> { 返 此.解赋值() }
            "书" -> {
                设 行 = 此.行()
                此.进()
                设 e = 此.解表达式()
                此.收句尾()
                返 输出节(e, 行)
            }
            "若" -> { 返 此.解条件() }
            "循" -> { 返 此.解循环() }
            "受" -> { 返 此.解受句() }
            "故曰" -> { 返 此.解故曰() }
            "止" -> {
                设 行 = 此.行()
                此.进()
                此.收句尾()
                返 止句节(行)
            }
            "见" -> { 此.译错("「见」唯居于口诀体之首。") }
            "不然" -> { 此.译错("「不然」须居若块之末或口诀之末。") }
            "不然若" -> { 此.译错("「不然若」须承若块。") }
            "诀" -> { 此.译错("「诀」须随「名者,诀也」之声明。") }
            _ -> {
                设 行 = 此.行()
                设 e = 此.解表达式()
                此.收句尾()
                返 表语句节(e, 行)
            }
        }
    }

    // 名首句:声明(名者,…)或表达式语句(裸名起头)
    函 解名首句() {
        若 此.望类(1) == "者" {
            返 此.解声明()
        }
        设 行 = 此.行()
        设 e = 此.解表达式()
        此.收句尾()
        返 表语句节(e, 行)
    }

    函 解声明() {
        设 名t = 此.望("名", "名引")
        设 行 = 名t[2]
        此.望("者", "「者」")
        此.跳句终()
        设 t = 此.类()
        // 型声明:型词紧跟也(型列之后若非也,则为列字面量,落表达式)
        若 (t == "型数" 或 t == "型文" 或 t == "型列" 或 t == "型册" 或 t == "型然否" 或 t == "空") 且 此.望类(1) == "也" {
            设 型词 = "数"
            匹配 t {
                "型数" -> { 设 型词 = "数" }
                "型文" -> { 设 型词 = "文" }
                "型列" -> { 设 型词 = "列" }
                "型册" -> { 设 型词 = "册" }
                "型然否" -> { 设 型词 = "然否" }
                _ -> { 设 型词 = "空" }
            }
            此.进()
            此.进()
            此.收句尾()
            返 声明节(名t[1], 空值节(行), 型词, 行)
        }
        若 t == "诀" {
            若 此.望类(1) != "也" {
                此.译错("「诀也」之后不得有他词。")
            }
            此.进()
            此.进()
            返 此.解诀体(名t[1], 行)
        }
        // 值声明
        设 e = 此.解表达式()
        此.望("也", "声明之「也」")
        此.收句尾()
        返 声明节(名t[1], e, "", 行)
    }

    // 诀体:首词见 → 口诀体;余皆直述体。以语句首之「也」阖。
    函 解诀体(名, 行) {
        此.诀深 = 此.诀深 + 1
        此.跳句终()
        设 口诀体 = 假
        若 此.类() == "见" {
            设 口诀体 = 真
        }
        设 体 = []
        设 规则 = []
        设 参名 = ""
        若 口诀体 {
            当 此.类() == "见" {
                规则.追加(此.解规则())
                此.跳句终()
            }
            若 此.类() == "不然" {
                规则.追加(此.解不然规则())
                此.跳句终()
            }
            此.望("也", "口诀体末之「也」")
        } 否 {
            设 首句 = 真
            当 真 {
                此.跳句终()
                若 此.类() == "也" {
                    此.进()
                    断
                }
                若 此.类() == "卷终" {
                    此.译错("诀体未阖,缺「也」。")
                }
                若 首句 {
                    此.诀首态 = 1
                    // 首句得为受引参之句:提参名,不入体
                    若 此.类() == "受" {
                        此.望("受", "「受」")
                        设 名t = 此.望("名", "参名")
                        参名 = 名t[1]
                        此.收句尾()
                        此.诀首态 = 2
                        首句 = 假
                        续
                    }
                }
                体.追加(此.解语句())
                此.诀首态 = 2
                首句 = 假
            }
        }
        此.诀深 = 此.诀深 - 1
        此.诀首态 = 0
        返 诀定义节(名, 体, 规则, 参名, 口诀体, 行)
    }

    // 规则:见 模式 (当 表达式)? 则 动作 (止)? 
    函 解规则() {
        设 行 = 此.行()
        此.望("见", "「见」")
        设 模式 = 此.解模式()
        设 当节 = 空值节(行)
        若 此.类() == "当" {
            此.进()
            设 当节 = 此.解表达式()
        }
        此.跳句终()
        此.望("则", "规则之「则」")
        设 动作 = 此.解表达式()
        设 止 = 假
        若 此.类() == "止" {
            此.进()
            设 止 = 真
        }
        此.收句尾()
        返 规则节(模式, 当节, 动作, 止, 假, 行)
    }

    // 兜底规则:不然 (则)? 动作 (止)? ——必居末位,不得带当
    函 解不然规则() {
        设 行 = 此.行()
        此.望("不然", "「不然」")
        若 此.类() == "当" {
            此.译错("兜底规则恒中,不得带「当」。")
        }
        若 此.类() == "则" {
            此.进()
        }
        设 动作 = 此.解表达式()
        设 止 = 假
        若 此.类() == "止" {
            此.进()
            设 止 = 真
        }
        此.收句尾()
        返 规则节(空值节(行), 空值节(行), 动作, 止, 真, 行)
    }

    // 模式四形:名/数/文/列(列之项唯名与字面量)
    函 解模式() {
        设 t = 此.类()
        设 行 = 此.行()
        若 t == "名" {
            设 名t = 此.望("名", "模式名")
            返 名节(名t[1], 行)
        }
        若 t == "数" {
            设 数t = 此.望("数", "模式之数")
            返 数节(数t[1], 行)
        }
        若 t == "文面" {
            设 文t = 此.望("文面", "模式之文")
            返 文节(文t[1], 行)
        }
        若 t == "型列" {
            此.进()
            此.望("开", "列模式之开括")
            设 元们 = []
            此.跳句终()
            当 此.类() != "阖" {
                设 et = 此.类()
                若 et == "名" {
                    设 名t = 此.望("名", "列模式之项")
                    元们.追加(名节(名t[1], 名t[2]))
                } 抑 et == "数" {
                    设 数t = 此.望("数", "列模式之项")
                    元们.追加(数节(数t[1], 数t[2]))
                } 抑 et == "文面" {
                    设 文t = 此.望("文面", "列模式之项")
                    元们.追加(文节(文t[1], 文t[2]))
                } 否 {
                    此.译错("列模式之项唯名与字面量。")
                }
                若 此.类() == "逗" {
                    此.进()
                    此.跳句终()
                }
            }
            此.望("阖", "列模式之阖括")
            返 列值节(元们, 行)
        }
        此.译错("模式唯名、数、文、列四形。")
        返 空值节(行)
    }

    函 解赋值() {
        设 行 = 此.行()
        此.望("纳", "「纳」")
        设 e = 此.解表达式()
        此.望("于", "「于」")
        设 目标 = 此.解目标()
        此.收句尾()
        返 赋值节(目标, e, 行)
    }

    // 赋值目标:名 或 名受原子
    函 解目标() {
        设 名t = 此.望("名", "赋值目标之名")
        设 行 = 名t[2]
        若 此.类() == "受" {
            此.进()
            设 实 = 此.解原子()
            返 受用节(名节(名t[1], 行), 实, 行)
        }
        返 名节(名t[1], 行)
    }

    函 解条件() {
        设 行 = 此.行()
        此.望("若", "「若」")
        设 d = 条件节(行)
        设 条 = 此.解表达式()
        此.望("则", "「则」")
        d["枝"].追加({"当": 条, "体": 此.解块()})
        当 此.类() == "不然若" {
            此.进()
            设 条2 = 此.解表达式()
            此.望("则", "「则」")
            d["枝"].追加({"当": 条2, "体": 此.解块()})
        }
        若 此.类() == "不然" {
            此.进()
            d["否则"] = 此.解块()
        }
        此.望("也", "若块末之「也」")
        此.收句尾()
        返 d
    }

    // 块:则后有句终(或空)→ 多句块,至语句首之也;否则单句,其后当有也
    函 解块() {
        设 句们 = []
        设 t = 此.类()
        若 t == "句终" 或 t == "逗" {
            此.跳句终()
            当 真 {
                此.跳句终()
                若 此.类() == "也" {
                    断
                }
                若 此.类() == "卷终" {
                    此.译错("块未阖,缺「也」。")
                }
                句们.追加(此.解语句())
            }
            返 句们
        }
        若 t == "也" {
            此.译错("块中无句。")
        }
        句们.追加(此.解语句())
        返 句们
    }

    函 解循环() {
        设 行 = 此.行()
        此.望("循", "「循」")
        // 二形之辨在「于」:循 名 于 列 → 遍历;余者当型
        若 此.类() == "名" 且 此.望类(1) == "于" {
            设 名t = 此.望("名", "遍历之名")
            此.望("于", "「于」")
            设 列e = 此.解表达式()
            设 体 = 此.解块()
            此.望("也", "循块末之「也」")
            此.收句尾()
            返 循环节(假, 名t[1], 空值节(行), 列e, 体, 行)
        }
        设 条 = 此.解表达式()
        设 体 = 此.解块()
        此.望("也", "循块末之「也」")
        此.收句尾()
        返 循环节(真, "", 条, 空值节(行), 体, 行)
    }

    函 解受句() {
        若 此.诀深 == 0 或 此.诀首态 != 1 {
            此.译错("「受」引参之句唯居于诀体之首。")
        }
        设 行 = 此.行()
        此.望("受", "「受」")
        设 名t = 此.望("名", "参名")
        此.收句尾()
        返 受句节(名t[1], 行)
    }

    函 解故曰() {
        若 此.诀深 == 0 {
            此.译错("「故曰」越诀,不得居于诀体之外。")
        }
        设 行 = 此.行()
        此.望("故曰", "「故曰」")
        设 e = 此.解表达式()
        此.收句尾()
        返 故曰节(e, 行)
    }

    // —— 表达式(七级) ——

    函 解表达式() {
        返 此.解或()
    }

    函 解或() {
        设 左 = 此.解且()
        当 此.类() == "或" {
            设 行 = 此.行()
            此.进()
            设 右 = 此.解且()
            设 左 = 二元节("或", 左, 右, 行)
        }
        返 左
    }

    函 解且() {
        设 左 = 此.解比较()
        当 此.类() == "且" {
            设 行 = 此.行()
            此.进()
            设 右 = 此.解比较()
            设 左 = 二元节("且", 左, 右, 行)
        }
        返 左
    }

    函 解比较() {
        设 左 = 此.解加减()
        当 此.类() == "大于" 或 此.类() == "小于" 或 此.类() == "等于" 或 此.类() == "不大于" 或 此.类() == "不小于" 或 此.类() == "不等于" {
            设 行 = 此.行()
            设 运 = 此.类()
            此.进()
            设 右 = 此.解加减()
            设 左 = 二元节(运, 左, 右, 行)
        }
        返 左
    }

    函 解加减() {
        设 左 = 此.解乘除()
        当 此.类() == "加" 或 此.类() == "减" {
            设 行 = 此.行()
            设 运 = 此.类()
            此.进()
            设 右 = 此.解乘除()
            设 左 = 二元节(运, 左, 右, 行)
        }
        返 左
    }

    函 解乘除() {
        设 左 = 此.解一元()
        当 此.类() == "乘" 或 此.类() == "除" 或 此.类() == "余" {
            设 行 = 此.行()
            设 运 = 此.类()
            此.进()
            设 右 = 此.解一元()
            设 左 = 二元节(运, 左, 右, 行)
        }
        返 左
    }

    函 解一元() {
        设 t = 此.类()
        设 行 = 此.行()
        若 t == "非" {
            此.进()
            返 一元节("非", 此.解一元(), 行)
        }
        // 前缀位之负:汉字「负」或 ASCII 减号皆作一元负
        若 t == "负" 或 t == "减" {
            此.进()
            返 一元节("负", 此.解一元(), 行)
        }
        返 此.解受链()
    }

    // 受链:原子 (受 原子)*,左结合
    函 解受链() {
        设 左 = 此.解原子()
        当 此.类() == "受" {
            设 行 = 此.行()
            此.进()
            设 实 = 此.解原子()
            设 左 = 受用节(左, 实, 行)
        }
        返 左
    }

    函 解原子() {
        设 t = 此.类()
        设 行 = 此.行()
        若 t == "数" {
            设 数t = 此.望("数", "数")
            返 数节(数t[1], 行)
        }
        若 t == "文面" {
           设 文t = 此.望("文面", "文")
            返 文节(文t[1], 行)
        }
        若 t == "名" {
            设 名t = 此.望("名", "名")
            返 名节(名t[1], 行)
        }
        若 t == "然" {
            此.进()
            返 然节(真, 行)
        }
        若 t == "否" {
            此.进()
            返 然节(假, 行)
        }
        若 t == "空" {
            此.进()
            返 空值节(行)
        }
        若 t == "尊名" {
            设 尊t = 此.望("尊名", "尊名")
            设 尊 = 尊t[1]
            若 此.类() == "受" {
                若 尊 == "问" {
                    此.译错("《问》不受参。")
                }
                此.进()
                设 实 = 此.解原子()
                返 尊名节(尊, 实, 行)
            }
            若 尊 != "问" {
                此.译错("《" & 尊 & "》必受一原子之参。")
            }
            返 尊名节(尊, 空值节(行), 行)
        }
        若 t == "型列" {
            此.进()
            // 单元素之列:词法器已并作一名/文面之记(列「三」、列「「文」」)
            设 单类 = 此.类()
            若 单类 == "名" 或 单类 == "文面" 或 单类 == "数" {
                设 单t = 此.现()
                设 元节 = 空值节(行)
                若 单类 == "名" {
                    若 单t[3] == 1 {
                        设 试 = 解数词(单t[1])
                        设 元节 = 数节(字(试[1]), 单t[2])
                    } 否 {
                        设 元节 = 名节(单t[1], 单t[2])
                    }
                } 抑 单类 == "文面" {
                    设 元节 = 文节(单t[1], 单t[2])
                } 否 {
                    设 元节 = 数节(单t[1], 单t[2])
                }
                此.进()
                返 列值节([元节], 行)
            }
            此.望("开", "列字面量之开括")
            设 元们 = []
            此.跳句终()
            当 此.类() != "阖" {
                元们.追加(此.解列元())
                若 此.类() == "逗" {
                    此.进()
                    此.跳句终()
                } 否 {
                    断
                }
            }
            此.望("阖", "列字面量之阖括")
            返 列值节(元们, 行)
        }
        若 t == "开" {
            此.译错("括不入式:名以引立,列以「列」起。")
        }
        此.译错("不成原子:「" & t & "」。")
        返 空值节(行)
    }

    // 列元素:名形而数性者按数解(「三」于列内为数,余处为名)
    函 解列元() {
        设 t = 此.类()
        若 t == "名" {
            设 名t = 此.现()
            若 名t[3] == 1 {
                此.进()
                设 试 = 解数词(名t[1])
                返 数节(字(试[1]), 名t[2])
            }
        }
        返 此.解表达式()
    }
}
