// 抽象树.xt —— AST 节点构造辅助 + 转译期错误报告
// 节点皆扁平字典:{"类": 串, "行": 整, ...各构造专属键}
// 表达式节点类:数/文/名/列值/然/否/空值/尊名/受用/二元/一元
// 语句节点类:声明/赋值/输出/条件/循环/受句/故曰/止句/诀定义/规则/表达式语句

函 造节(类, 行) {
    返 {"类": 类, "行": 行}
}

函 声明节(名, 值节, 型词, 行) {
    设 d = 造节("声明", 行)
    d["名"] = 名
    d["值"] = 值节
    d["型词"] = 型词
    返 d
}

函 赋值节(目标节, 值节, 行) {
    设 d = 造节("赋值", 行)
    d["目标"] = 目标节
    d["值"] = 值节
    返 d
}

函 输出节(值节, 行) {
    设 d = 造节("输出", 行)
    d["值"] = 值节
    返 d
}

函 条件节(行) {
    设 d = 造节("条件", 行)
    d["枝"] = []
    d["否则"] = []
    返 d
}

函 循环节(当型, 名, 条件参, 列节, 体, 行) {
    设 d = 造节("循环", 行)
    d["当型"] = 当型
    d["名"] = 名
    d["条件"] = 条件参
    d["列"] = 列节
    d["体"] = 体
    返 d
}

函 受句节(名, 行) {
    设 d = 造节("受句", 行)
    d["名"] = 名
    返 d
}

函 故曰节(值节, 行) {
    设 d = 造节("故曰", 行)
    d["值"] = 值节
    返 d
}

函 止句节(行) {
    返 造节("止句", 行)
}

函 诀定义节(名, 体, 规则, 参名, 口诀体, 行) {
    设 d = 造节("诀定义", 行)
    d["名"] = 名
    d["体"] = 体
    d["规则"] = 规则
    d["参"] = 参名
    d["口诀"] = 口诀体
    返 d
}

函 表语句节(值节, 行) {
    设 d = 造节("表达式语句", 行)
    d["值"] = 值节
    返 d
}

// —— 表达式节点 ——

函 名节(名, 行) {
    设 d = 造节("名", 行)
    d["名"] = 名
    返 d
}

函 数节(值, 行) {
    设 d = 造节("数", 行)
    d["值"] = 值
    返 d
}

函 文节(值, 行) {
    设 d = 造节("文", 行)
    d["值"] = 值
    返 d
}

函 列值节(元们, 行) {
    设 d = 造节("列值", 行)
    d["元"] = 元们
    返 d
}

函 然节(布尔值, 行) {
    设 d = 造节("然", 行)
    d["真"] = 布尔值
    返 d
}

函 空值节(行) {
    返 造节("空值", 行)
}

函 尊名节(名, 实节, 行) {
    设 d = 造节("尊名", 行)
    d["名"] = 名
    d["实"] = 实节
    返 d
}

函 受用节(收节, 实节, 行) {
    设 d = 造节("受用", 行)
    d["收"] = 收节
    d["实"] = 实节
    返 d
}

函 二元节(运算, 左节, 右节, 行) {
    设 d = 造节("二元", 行)
    d["运算"] = 运算
    d["左"] = 左节
    d["右"] = 右节
    返 d
}

函 一元节(运算, 子节, 行) {
    设 d = 造节("一元", 行)
    d["运算"] = 运算
    d["子"] = 子节
    返 d
}

// 口诀规则节点:模式为表达式形节点(名节/数节/文节/列值节),带 "当" 守卫与 "止"
函 规则节(模式节, 当节, 动作节, 止, 兜底, 行) {
    设 d = 造节("规则", 行)
    d["模式"] = 模式节
    d["当"] = 当节
    d["动作"] = 动作节
    d["止"] = 止
    d["兜底"] = 兜底
    返 d
}

// —— 转译期错误报告(四字段:类目/卷名/行号/原文)——
// 行号用汉字数词;消息内数字用阿拉伯数字;冒号与括号皆半角;下划线每字一～。
函 报译错(类目, 消息, 行, 源行们, 卷名) {
    设 源 = ""
    若 行 >= 1 且 行 <= 源行们.长度 {
        设 源 = 源行们[行 - 1]
    }
    设 线 = ""
    遍历 c 于 源.分割("") {
        线 = 线 & "～"
    }
    示("【" & 类目 & "】卷「" & 卷名 & "」第" & 转中文(行) & "行:" & 消息)
    示("　" & 源)
    示("　" & 线)
    终(1)
    返 ""
}

// 转译期警告(v0.1 亦走标准输出,前缀「警」以别于错误)
函 报译警(消息) {
    示("「警」" & 消息)
}
