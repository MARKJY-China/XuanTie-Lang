// jd_runtime.xt —— 句读动态值运行时(由生成码经 引 "../runtime/jd_runtime.xt" 载入)
// 句读值 = 盒(带型码之联合体);运算全经此分派;错误全中文四字段,打印后以退出码一终。
// 生成码契约:顶层设 jd_卷名(串)与 jd_源行(串数组,每行一条,一基由报错方减一取)。
// 宿主缺陷规避:凡调字段所存之诀,先存局部变量再呼(对象.字段(实参) 直呼有误)。

引 "../src/词数.xt"

设 jd_卷名 = ""
设 jd_源行 = []

型 盒 {
    设 型码 = 0
    设 数值 = 0
    设 文值 = ""
    设 列值 = []
    设 册值 = {}
    设 然值 = 假
    设 诀值 = 空
    设 诀名 = ""

    函 造() { }
}

函 数盒(v) {
    设 b = 造 盒()
    b.型码 = 0
    b.数值 = v
    返 b
}

函 文盒(s) {
    设 b = 造 盒()
    b.型码 = 1
    b.文值 = s
    返 b
}

函 列盒(们) {
    设 b = 造 盒()
    b.型码 = 2
    b.列值 = 们
    返 b
}

函 然盒(布尔值) {
    设 b = 造 盒()
    b.型码 = 4
    b.然值 = 布尔值
    返 b
}

函 册盒() {
    设 b = 造 盒()
    b.型码 = 3
    b.册值 = {}
    返 b
}

函 空盒() {
    设 b = 造 盒()
    b.型码 = 5
    返 b
}

函 诀盒(体函, 名) {
    设 b = 造 盒()
    b.型码 = 6
    b.诀值 = 体函
    b.诀名 = 名
    返 b
}

函 型名(b) {
    匹配 b.型码 {
        0 -> { 返 "数" }
        1 -> { 返 "文" }
        2 -> { 返 "列" }
        3 -> { 返 "册" }
        4 -> { 返 "然否" }
        5 -> { 返 "空" }
        _ -> { 返 "诀" }
    }
}

// 汉字数词(行号用);1–9999,书面正式读法
函 转中文(n) {
    若 n <= 0 { 返 "〇" }
    设 字表 = ["〇", "一", "二", "三", "四", "五", "六", "七", "八", "九"]
    设 出 = ""
    设 千 = n / 1000
    设 余 = n % 1000
    若 千 > 0 {
        出 = 出 & 字表[千] & "千"
        若 余 > 0 且 余 < 100 { 出 = 出 & "零" }
    }
    设 百 = 余 / 100
    余 = 余 % 100
    若 百 > 0 {
        出 = 出 & 字表[百] & "百"
        若 余 > 0 且 余 < 10 { 出 = 出 & "零" }
    }
    设 十 = 余 / 10
    设 个 = 余 % 10
    若 十 > 0 {
        若 十 == 1 且 千 == 0 且 百 == 0 {
            出 = 出 & "十"
        } 否 {
            出 = 出 & 字表[十] & "十"
        }
    }
    若 个 > 0 {
        出 = 出 & 字表[个]
    }
    若 出 == "" { 出 = "〇" }
    返 出
}

// 运行期错误:四字段打印后退出码一终
函 报错(类目, 消息, 行) {
    设 源 = ""
    若 行 >= 1 且 行 <= jd_源行.长度 {
        设 源 = jd_源行[行 - 1]
    }
    设 线 = ""
    遍历 c 于 源.分割("") {
        线 = 线 & "～"
    }
    示("【" & 类目 & "】卷「" & jd_卷名 & "」第" & 转中文(行) & "行:" & 消息)
    示("　" & 源)
    示("　" & 线)
    终(1)
}

// 书形化
函 书形(b) {
    若 b.型码 == 0 { 返 字(b.数值) }
    若 b.型码 == 1 { 返 b.文值 }
    若 b.型码 == 4 {
        若 b.然值 { 返 "然" }
        返 "否"
    }
    若 b.型码 == 5 { 返 "空" }
    若 b.型码 == 2 {
        设 s = "列「"
        设 首 = 真
        设 i = 0
        设 n = b.列值.长度
        当 i < n {
            若 首 {
                设 首 = 假
            } 否 {
                s = s & "、"
            }
            s = s & 书形(b.列值[i])
            i = i + 1
        }
        返 s & "」"
    }
    若 b.型码 == 3 { 返 "册(" & 字(b.册值.大小) & "键)" }
    返 "诀「" & b.诀名 & "」"
}

函 书盒(b) {
    示(书形(b))
}

// 等于:异类恒否;诀以名等价;列逐项;册键值逐对
函 盒等(a, b) {
    若 a.型码 != b.型码 { 返 然盒(假) }
    若 a.型码 == 0 { 返 然盒(a.数值 == b.数值) }
    若 a.型码 == 1 { 返 然盒(a.文值 == b.文值) }
    若 a.型码 == 4 { 返 然盒(a.然值 == b.然值) }
    若 a.型码 == 5 { 返 然盒(真) }
    若 a.型码 == 6 { 返 然盒(a.诀名 == b.诀名) }
    若 a.型码 == 2 {
        若 a.列值.长度 != b.列值.长度 { 返 然盒(假) }
        设 i = 0
        当 i < a.列值.长度 {
            设 r = 盒等(a.列值[i], b.列值[i])
            若 非 r.然值 { 返 然盒(假) }
            i = i + 1
        }
        返 然盒(真)
    }
    若 a.册值.大小 != b.册值.大小 { 返 然盒(假) }
    设 键们 = a.册值.键()
    设 i = 0
    设 n = 键们.长度
    当 i < n {
        若 非 b.册值.包含?(键们[i]) { 返 然盒(假) }
        设 r = 盒等(a.册值[键们[i]], b.册值[键们[i]])
        若 非 r.然值 { 返 然盒(假) }
        i = i + 1
    }
    返 然盒(真)
}

// 大小比较:数与数、文与文;异类相报
函 盒小(a, b, 行) {
    若 a.型码 == 0 且 b.型码 == 0 { 返 然盒(a.数值 < b.数值) }
    若 a.型码 == 1 且 b.型码 == 1 { 返 然盒(a.文值 < b.文值) }
    报错("异类之失", "大小比较不可施于「" & 型名(a) & "」与「" & 型名(b) & "」。", 行)
    返 空盒()
}

// 加:数+数;文+任意(左文);列+列;余者异类之失
函 盒加(a, b, 行) {
    若 a.型码 == 0 且 b.型码 == 0 { 返 数盒(a.数值 + b.数值) }
    若 a.型码 == 1 { 返 文盒(a.文值 & 书形(b)) }
    若 a.型码 == 2 且 b.型码 == 2 {
        设 们 = []
        设 i = 0
        设 n = a.列值.长度
        当 i < n {
            们.追加(a.列值[i])
            i = i + 1
        }
        i = 0
        n = b.列值.长度
        当 i < n {
            们.追加(b.列值[i])
            i = i + 1
        }
        返 列盒(们)
    }
    报错("异类之失", "「加」不可施于「" & 型名(a) & "」与「" & 型名(b) & "」。", 行)
    返 空盒()
}

// 减乘除余:唯数可施;除零余零报零除之失
函 盒减(a, b, 行) {
    若 a.型码 != 0 或 b.型码 != 0 {
        报错("异类之失", "「减」不可施于「" & 型名(a) & "」与「" & 型名(b) & "」。", 行)
    }
    返 数盒(a.数值 - b.数值)
}

函 盒乘(a, b, 行) {
    若 a.型码 != 0 或 b.型码 != 0 {
        报错("异类之失", "「乘」不可施于「" & 型名(a) & "」与「" & 型名(b) & "」。", 行)
    }
    返 数盒(a.数值 * b.数值)
}

函 盒除(a, b, 行) {
    若 a.型码 != 0 或 b.型码 != 0 {
        报错("异类之失", "「除」不可施于「" & 型名(a) & "」与「" & 型名(b) & "」。", 行)
    }
    若 b.数值 == 0 {
        报错("零除之失", "「除」不可施于零。", 行)
    }
    返 数盒(a.数值 / b.数值)
}

函 盒余(a, b, 行) {
    若 a.型码 != 0 或 b.型码 != 0 {
        报错("异类之失", "「余」不可施于「" & 型名(a) & "」与「" & 型名(b) & "」。", 行)
    }
    若 b.数值 == 0 {
        报错("零除之失", "「余」不可施于零。", 行)
    }
    返 数盒(a.数值 % b.数值)
}

// 且或非负:唯数可负,唯然否可逻辑
函 盒且(a, b, 行) {
    若 a.型码 != 4 或 b.型码 != 4 {
        报错("异类之失", "「且」不可施于「" & 型名(a) & "」与「" & 型名(b) & "」。", 行)
    }
    返 然盒(a.然值 且 b.然值)
}

函 盒或(a, b, 行) {
    若 a.型码 != 4 或 b.型码 != 4 {
        报错("异类之失", "「或」不可施于「" & 型名(a) & "」与「" & 型名(b) & "」。", 行)
    }
    返 然盒(a.然值 或 b.然值)
}

函 盒非(a, 行) {
    若 a.型码 != 4 {
        报错("异类之失", "「非」不可施于「" & 型名(a) & "」。", 行)
    }
    返 然盒(非 a.然值)
}

函 盒负(a, 行) {
    若 a.型码 != 0 {
        报错("异类之失", "「负」不可施于「" & 型名(a) & "」。", 行)
    }
    返 数盒(0 - a.数值)
}

// 条件求值:必为然否
函 盒真(b, 行) {
    若 b.型码 != 4 {
        报错("异类之失", "条件必为然否,今得「" & 型名(b) & "」。", 行)
    }
    返 b.然值
}

// 受之三解:诀→调用;册→查簿(无键得空);列→一基索引。余者异类之失。
函 受盒(a, b, 行) {
    若 a.型码 == 6 {
        设 目标 = a.诀值
        返 目标(b)
    }
    若 a.型码 == 3 {
        若 b.型码 != 1 {
            报错("异类之失", "册键必文,今得「" & 型名(b) & "」。", 行)
        }
        若 a.册值.包含?(b.文值) {
            返 a.册值[b.文值]
        }
        返 空盒()
    }
    若 a.型码 == 2 {
        若 b.型码 != 0 {
            报错("异类之失", "列指必数,今得「" & 型名(b) & "」。", 行)
        }
        若 b.数值 < 1 或 b.数值 > a.列值.长度 {
            报错("逾界之失", "列无第" & 字(b.数值) & "位(共" & 字(a.列值.长度) & "位)。", 行)
        }
        返 a.列值[b.数值 - 1]
    }
    报错("异类之失", "「受」不可施于「" & 型名(a) & "」。", 行)
    返 空盒()
}

// 受之双态实参:收者为册则作键文,否则取变量之值
函 受盒二义(a, 键文, 值盒, 行) {
    若 a.型码 == 3 {
        返 受盒(a, 文盒(键文), 行)
    }
    返 受盒(a, 值盒, 行)
}

// 赋值目标为应用式:册→设键;列→按指;余者异类之失
函 纳受盒(a, b, 值, 行) {
    若 a.型码 == 3 {
        若 b.型码 != 1 {
            报错("异类之失", "册键必文,今得「" & 型名(b) & "」。", 行)
        }
        a.册值[b.文值] = 值
        返 值
    }
    若 a.型码 == 2 {
        若 b.型码 != 0 {
            报错("异类之失", "列指必数,今得「" & 型名(b) & "」。", 行)
        }
        若 b.数值 < 1 或 b.数值 > a.列值.长度 {
            报错("逾界之失", "列无第" & 字(b.数值) & "位(共" & 字(a.列值.长度) & "位)。", 行)
        }
        a.列值[b.数值 - 1] = 值
        返 值
    }
    报错("异类之失", "「纳于」不可施于「" & 型名(a) & "」之受位。", 行)
    返 值
}

// 遍历之列:实参必列
函 列元(a, 行) {
    若 a.型码 != 2 {
        报错("异类之失", "「循于」必施于列,今得「" & 型名(a) & "」。", 行)
    }
    返 a.列值
}

// 《度》:文字符数/列元数/册键数
函 度盒(a, 行) {
    若 a.型码 == 1 { 返 数盒(a.文值.字符数) }
    若 a.型码 == 2 { 返 数盒(a.列值.长度) }
    若 a.型码 == 3 { 返 数盒(a.册值.大小) }
    报错("异类之失", "「度」不可施于「" & 型名(a) & "」。", 行)
    返 空盒()
}

// 《问》:读一行,合数词则为数,否则为文;输入尽得空文。
// 阿拉伯数字串视同直书体(规范 §一 数之逃生舱)。
函 问盒() {
    设 s = 输("")
    若 s == "" { 返 文盒("") }
    设 字们 = s.分割("")
    设 是阿 = 真
    设 i = 0
    设 n = 字们.长度
    当 i < n {
        设 c = 字们[i]
        若 c != "0" 且 c != "1" 且 c != "2" 且 c != "3" 且 c != "4" 且 c != "5" 且 c != "6" 且 c != "7" 且 c != "8" 且 c != "9" {
            设 是阿 = 假
        }
        i = i + 1
    }
    若 是阿 {
        若 n > 0 且 n < 19 {
            返 数盒(整(s).值)
        }
        返 文盒(s)
    }
    设 试 = 解数词(s)
    若 试[0] { 返 数盒(试[1]) }
    返 文盒(s)
}

// 《签》:一至该数闭区间之随机整数
函 签盒(a, 行) {
    若 a.型码 != 0 {
        报错("异类之失", "「签」必受数,今得「" & 型名(a) & "」。", 行)
    }
    若 a.数值 < 1 {
        报错("逾界之失", "「签」受之数当不小于一,今得" & 字(a.数值) & "。", 行)
    }
    返 数盒(数学.随机(a.数值) + 1)
}

// 文之最左命中置换(Markov 重写之核)
函 文最左置换(源, 模式, 置换) {
    设 n = 源.字符数
    设 m = 模式.字符数
    若 m == 0 或 m > n { 返 源 }
    设 i = 0
    当 i <= n - m {
        若 源.截取(i, i + m) == 模式 {
            返 源.截取(0, i) & 置换 & 源.截取(i + m, n)
        }
        i = i + 1
    }
    返 源
}
