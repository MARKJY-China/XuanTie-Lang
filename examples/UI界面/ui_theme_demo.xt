引 "UI" 予 UI
引 "渲染" 予 R

设 状态 = UI.造状态({"计数": 0})

UI.应用(状态, 函(s) {
    返 UI.列([
        UI.文本("玄铁UI·新主题演示", {"字号": 26}),
        UI.文本("默认字体零配置中文显示", {"字号": 16, "字色": UI.色彩["浅灰"]}),
        UI.文本("诊断:鼠按下=" & R.鼠标按下?(0), {"字号": 18, "字色": UI.色彩["绿"]}),
        UI.按钮("点我 +1", {
            "悬底色": UI.色16("#ffffff"),
            "悬字色": UI.色16("#000000"),
            "按字色": UI.色16("#5dbe30"),
            "按底色": UI.色(255, 60, 60, 255), 
            "点击": 函() {
                UI.态设(s, "计数", UI.态取(s, "计数") + 1)
            }
        }),
        UI.按钮("第二个按钮", {"点击": 函() { }}),
        UI.文本("计数: 见下方", {"字号": 18}),
        UI.文本("当前: " & UI.态取(s, "计数"), {"字号": 12, "字色": UI.色彩["黄"]})
    ], {"内边距": UI.全边(24), "间距": 14})
}, {"宽": 520, "高": 420, "标题": "玄铁UI新主题演示"})



设 A:字 = "abc"