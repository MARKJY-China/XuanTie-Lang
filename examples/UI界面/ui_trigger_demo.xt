// 触发模式与禁用态演示(含首按延迟)
引 "UI" 予 UI
引 "渲染" 予 R

设 状态 = UI.造状态({"计数": 0})

UI.应用(状态, 函(s) {
    返 UI.列([
        UI.文本("触发模式与禁用演示", {"字号": 24}),
        UI.按钮("点击(按下+松开才发) +1", {
            "点击": 函() {
                UI.态设(s, "计数", UI.态取(s, "计数") + 1)
            }
        }),
        UI.按钮("按下即发 +10", {
            "触发": "按下",
            "点击": 函() {
                UI.态设(s, "计数", UI.态取(s, "计数") + 10)
            }
        }),
        UI.按钮("按住连发 +100", {
            "触发": "按住",
            "点击": 函() {
                UI.态设(s, "计数", UI.态取(s, "计数") + 100)
            }
        }),
        UI.按钮("首按延迟500ms才连发 +500", {
            "触发": "按住",
            "首按延迟": 500,
            "点击": 函() {
                UI.态设(s, "计数", UI.态取(s, "计数") + 500)
            }
        }),
        UI.按钮("单击+1,长按400ms连发+50", {
            "首按延迟": 400,
            "连发间隔": 200,
            "点击": 函() {
                UI.态设(s, "计数", UI.态取(s, "计数") + 1)
            }
        }),
        UI.按钮("禁用按钮(灰色不可点)", {"禁用": 真, "点击": 函() { }}),
        UI.文本("当前: " & UI.态取(s, "计数"), {"字号": 22, "字色": UI.色彩["黄"]})
    ], {"内边距": UI.全边(24), "间距": 14})
}, {"宽": 620, "高": 560, "标题": "玄铁UI触发模式演示"})
