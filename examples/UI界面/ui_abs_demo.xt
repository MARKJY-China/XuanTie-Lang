// 绝对布局容器演示(人工复验用,不进回归)
// 验证点:
//  1. 绝对容器内子节点按 x/y 直摆(相对容器内容区左上角),不走 flex
//  2. 容器自身可带底色/圆角,可用 弹性 占满列剩余高度
//  3. 绝对容器内按钮交互正常(悬浮/点击/按住连发)
//  4. x/y 越界子节点会画出容器外(绝对布局不做裁剪,预期行为)
引 "UI" 予 UI
引 "渲染" 予 R

设 状态 = UI.造状态({"计数": 0})
R.初始化窗口(560, 420, "绝对布局演示")
当 非 R.窗口应关闭?() {
    R.开始绘图()
    UI.刷新(状态, 函(s) {
        返 UI.列([
            UI.文本("绝对布局:子节点按 x/y 直摆", {"字号": 20}),
            UI.绝对([
                UI.文本("左上 (16,12)", {"x": 16, "y": 12, "字号": 16, "字色": UI.色彩["浅灰"]}),
                UI.矩形({"x": 16, "y": 48, "宽": 120, "高": 64, "颜色": UI.色16("#3B82F6"), "圆角": 8}),
                UI.按钮("中部 +1", {"x": 220, "y": 110, "点击": 函() {
                    UI.态设(s, "计数", UI.态取(s, "计数") + 1)
                }}),
                UI.文本("计数:", {"x": 220, "y": 180, "字号": 14, "字色": UI.色彩["灰"]}),
                UI.文本("当前 " & UI.态取(s, "计数"), {"x": 220, "y": 202, "字号": 22, "字色": UI.色彩["黄"]}),
                UI.按钮("右下 按住连发+10", {"x": 340, "y": 260, "触发": "按住", "首按延迟": 300, "连发间隔": 100, "点击": 函() {
                    UI.态设(s, "计数", UI.态取(s, "计数") + 10)
                }})
            ], {"弹性": 1, "底色": UI.色16("#1E2430"), "圆角": 10})
        ], {"内边距": UI.全边(14), "间距": 10})
    }, 0, 0, 560, 420)
    R.结束绘图()
}
R.关闭窗口()
