// examples/UI功能总览.xt
// UI 库当前版本全功能演示(人工验收用):
//   容器: 列/行/叠/绝对/空白/弹性   控件: 文本/按钮/矩形
//   选项: 宽高/x y/弹性/主轴叉轴对齐/间距/内外边距/字号/字色(颜色别名)/底色/圆角/边框/可视
//   三态: 悬底色/按底色/悬字色/按字色   禁用: 禁用/禁底色/禁字色
//   触发: 点击/按下/按住 + 首按延迟 + 连发间隔
//   颜色: 色()/色16()/色彩预设   状态: 造状态/态取/态设/态观/态设批
//   窗口: 可调整(拖拽边缘改尺寸,界面跟随)   字体: 默认鸿蒙零配置
引 "UI" 予 UI
引 "渲染" 予 R

设 状态 = UI.造状态({"计数": 0, "显附录": 真, "事件": "暂无"})

// 态观:订阅 计数 变化,更新事件栏(回调无参,用 态取 读最新值)
UI.态观(状态, "计数", 函() {
    UI.态设(状态, "事件", "计数 → " & UI.态取(状态, "计数"))
})

R.初始化窗口(940, 760, "玄铁 UI 功能总览")
R.设窗口可调整(真)

当 非 R.窗口应关闭() {
    设 宽 = R.取屏幕宽()
    设 高 = R.取屏幕高()
    R.开始绘图()
    R.清背景(24, 24, 32, 255)
    UI.刷新(状态, 函(s) {
        返 UI.列([
            // ── 标题区(文本/字号/字色/色16) ──
            UI.文本("玄铁 UI 功能总览", {"字号": 26, "字色": UI.色彩["主题"]}),
            UI.文本("默认鸿蒙字体零配置 | 窗口可拖拽边缘改大小(" & 宽 & "x" & 高 & ")", {"字号": 13, "字色": UI.色彩["灰"]}),

            // ── 触发模式行(点击/按下即发/按住连发/禁用) ──
            UI.行([
                UI.按钮("点击 +1", {"点击": 函() {
                    UI.态设(s, "计数", UI.态取(s, "计数") + 1)
                }}),
                UI.按钮("按下即发 +10", {"触发": "按下", "点击": 函() {
                    UI.态设(s, "计数", UI.态取(s, "计数") + 10)
                }}),
                UI.按钮("按住连发 +100", {"触发": "按住", "首按延迟": 300, "连发间隔": 100, "点击": 函() {
                    UI.态设(s, "计数", UI.态取(s, "计数") + 100)
                }}),
                UI.按钮("禁用示例", {"禁用": 真, "禁底色": UI.色16("#3A3A3A"), "禁字色": UI.色16("#777777")})
            ], {"间距": 10}),

            // ── 三态配色 + 圆角边框行 ──
            UI.行([
                UI.按钮("三态配色(悬/按试试)", {
                    "底色": UI.色16("#3B82F6"), "悬底色": UI.色16("#60A5FA"), "按底色": UI.色16("#1D4ED8"),
                    "悬字色": UI.色彩["黄"], "按字色": UI.色彩["强调"],
                    "圆角": 12, "点击": 函() { UI.态设(s, "事件", "三态按钮被点击") }
                }),
                UI.按钮("圆角+描边", {
                    "底色": UI.色16("#1E2430"), "圆角": 16,
                    "边框色": UI.色彩["强调"], "边框宽": 2,
                    "点击": 函() { UI.态设(s, "事件", "描边按钮被点击") }
                }),
                UI.矩形({"宽": 90, "高": 40, "颜色": UI.色16("#8B5CF6"), "圆角": 8, "边框色": UI.色彩["白"], "边框宽": 1})
            ], {"间距": 10, "叉轴对齐": UI.叉中}),

            // ── 容器对比行:叠 / 绝对(弹性均分剩余宽) ──
            UI.行([
                UI.叠([
                    UI.矩形({"宽": 220, "高": 110, "颜色": UI.色16("#2D3748"), "圆角": 10}),
                    UI.列([
                        UI.文本("叠容器", {"字号": 15, "字色": UI.色彩["黄"]}),
                        UI.文本("子项层层相叠", {"字号": 12, "字色": UI.色彩["浅灰"]})
                    ], {"内边距": UI.四边(10, 12, 0, 12), "间距": 4})
                ], {"弹性": 1}),
                UI.绝对([
                    UI.文本("绝对容器", {"x": 10, "y": 8, "字号": 15, "字色": UI.色彩["黄"]}),
                    UI.文本("子项按 x/y 直摆", {"x": 10, "y": 30, "字号": 12, "字色": UI.色彩["浅灰"]}),
                    UI.按钮("角落 +5", {"x": 110, "y": 58, "字号": 13, "点击": 函() {
                        UI.态设(s, "计数", UI.态取(s, "计数") + 5)
                    }})
                ], {"弹性": 1, "底色": UI.色16("#1E2430"), "圆角": 10})
            ], {"间距": 12}),

            // ── 主轴对齐演示(对齐间:两端对齐均分) ──
            UI.行([
                UI.文本("对齐间", {"字号": 13, "字色": UI.色彩["灰"]}),
                UI.矩形({"宽": 40, "高": 16, "颜色": UI.色彩["红"], "圆角": 4}),
                UI.矩形({"宽": 40, "高": 16, "颜色": UI.色彩["绿"], "圆角": 4}),
                UI.矩形({"宽": 40, "高": 16, "颜色": UI.色彩["蓝"], "圆角": 4})
            ], {"主轴对齐": UI.对齐间, "叉轴对齐": UI.叉中}),

            // ── 弹性占位 + 功能按钮行 ──
            UI.行([
                UI.按钮("附录显示开关", {"点击": 函() {
                    UI.态设(s, "显附录", 非 UI.态取(s, "显附录"))
                }}),
                UI.弹性(1, {}),
                UI.按钮("重置(态设批)", {"点击": 函() {
                    UI.态设批(s, {"计数": 0, "事件": "已批量重置"})
                }})
            ], {"间距": 10}),

            // ── 附录(可视开关控制) ──
            UI.文本("附录:空白占位 + 外边距 演示文本(可被开关隐藏)", {
                "字号": 13, "字色": UI.色彩["浅灰"],
                "可视": UI.态取(s, "显附录"), "外边距": UI.四边(6, 0, 0, 0)
            }),

            // ── 状态栏(弹性:1 顶到底部之上) ──
            UI.弹性(1, {}),
            UI.行([
                UI.文本("事件: " & UI.态取(s, "事件"), {"字号": 14, "字色": UI.色彩["灰"]}),
                UI.弹性(1, {}),
                UI.文本("当前: " & UI.态取(s, "计数"), {"字号": 22, "字色": UI.色彩["黄"]})
            ], {"叉轴对齐": UI.叉中})
        ], {"内边距": UI.全边(16), "间距": 12})
    }, 0, 0, 宽, 高)
    R.结束绘图()
}
R.关闭窗口()
示("UI功能总览 正常退出")
