{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XuanTie Foundry",
  "version": "0.4.0",
  "identifier": "com.markjy.xuantie-foundry",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "玄铁铸造厂",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  }
}
