// 玄铁环境自检探针(IDE 自动生成与运行,请勿手工修改)
// 输出格式统一为 [自检] 键=值,IDE 解析后注入 AI 上下文
示("[自检] 编译运行=OK")

// 字符串与插值
示("[自检] 插值=#{1 + 1}")

// 数组与长度
设 行 = [1, 2, 3]
示("[自检] 数组长度=#{行.长度}")

// 数组元素字段引用回写(期望 9)
型 盒 {
    设 值 = 0
    函 造(v) {
        此.值 = v
    }
}
设 群 = []
设 i = 0
当 i < 2 {
    群.追加(造 盒(i))
    i = i + 1
}
设 a = 群[0]
a.值 = 9
示("[自检] 元素字段回写=#{群[0].值}")

// 遍历变量写回(期望 10,2)
遍历 e 于 群 {
    e.值 = e.值 + 1
}
示("[自检] 遍历写回=#{群[0].值},#{群[1].值}")

// 删(期望 1)
群.删(0)
示("[自检] 删后长度=#{群.长度}")

// 下标写(期望 77)
行[1] = 77
示("[自检] 下标写=#{行[1]}")

// 抑分支(期望 命中)
设 x = 5
若 x < 3 { 示("[自检] 抑分支=错") } 抑 x < 10 { 示("[自检] 抑分支=命中") } 否 { 示("[自检] 抑分支=错2") }

// 数学.取整=向下取整(floor):取整(2.7)=2,取整(-2.7)=-3(实测语义)
示("[自检] 取整=#{数学.取整(2.7)},#{数学.取整(-2.7)}")

// 顶层变量函数内写回(期望 2)
设 计数 = 0
函 加() {
    计数 = 计数 + 1
}
加()
加()
示("[自检] 顶层写回=#{计数}")

示("[自检] 完成=全部执行完毕")
