// 2D 游戏:马里奥风格平台跳跃(矩形/圆形精灵,无素材)
引 "渲染" 予 R

R.初始化窗口(960, 540, "玄铁 2D 平台跳跃")
R.设置目标帧率(60)
R.设ESC关闭(真)

设 玩家x: 小数 = 120.0
设 玩家y: 小数 = 420.0
设 速度x: 小数 = 0.0
设 速度y: 小数 = 0.0
设 在地面: 布尔 = 真
设 分数: 整 = 0

// 金币位置
设 金币们: 数组 = [
    {"x": 320.0, "y": 360.0},
    {"x": 400.0, "y": 360.0},
    {"x": 480.0, "y": 360.0},
    {"x": 680.0, "y": 300.0},
    {"x": 740.0, "y": 300.0}
]
设 已收: 数组 = [假, 假, 假, 假, 假]

当 非 R.窗口应关闭?() {
    设 dt: 小数 = R.取帧时间()
    若 dt > 0.05 { dt = 0.05 }

    // 左右移动
    设 方向: 小数 = 0.0
    若 R.键按下?(R.键左) 或 R.键按下?(R.键A) { 方向 = -1.0 }
    若 R.键按下?(R.键右) 或 R.键按下?(R.键D) { 方向 = 1.0 }
    速度x = 方向 * 280.0
    玩家x = 玩家x + 速度x * dt
    若 玩家x < 0.0 { 玩家x = 0.0 }
    若 玩家x > 928.0 { 玩家x = 928.0 }

    // 跳跃/重力
    若 (R.键刚按下?(R.键空格) 或 R.键刚按下?(R.键上) 或 R.键刚按下?(R.键W)) 且 在地面 {
        速度y = -650.0
        在地面 = 假
    }
    速度y = 速度y + 1800.0 * dt
    玩家y = 玩家y + 速度y * dt

    // 落地检测:地面
    在地面 = 假
    若 玩家y + 48.0 >= 500.0 {
        玩家y = 452.0
        速度y = 0.0
        在地面 = 真
    }
    // 平台(360..540 顶部 360)
    若 速度y >= 0.0 且 玩家y + 48.0 >= 360.0 且 玩家y + 48.0 <= 378.0 且 玩家x + 32.0 > 360.0 且 玩家x < 540.0 {
        玩家y = 312.0
        速度y = 0.0
        在地面 = 真
    }
    // 平台(620..780 顶部 300)
    若 速度y >= 0.0 且 玩家y + 48.0 >= 300.0 且 玩家y + 48.0 <= 318.0 且 玩家x + 32.0 > 620.0 且 玩家x < 780.0 {
        玩家y = 252.0
        速度y = 0.0
        在地面 = 真
    }

    // 收集金币
    设 i: 整 = 0
    当 i < 金币们.长度 {
        设 金 = 金币们[i]
        若 非 已收[i] 且 玩家x + 32.0 > 金["x"] - 14.0 且 玩家x < 金["x"] + 14.0 且 玩家y + 48.0 > 金["y"] - 14.0 且 玩家y < 金["y"] + 14.0 {
            已收[i] = 真
            分数 = 分数 + 1
        }
        i = i + 1
    }

    // 绘制
    R.开始绘图()
    R.清背景(92, 172, 255, 255)

    // 远山与云
    R.绘圆(160.0, 120.0, 55.0, 255, 255, 255, 230)
    R.绘圆(220.0, 120.0, 70.0, 255, 255, 255, 230)
    R.绘圆(285.0, 120.0, 50.0, 255, 255, 255, 230)
    R.绘三角(0.0, 300.0, 170.0, 150.0, 340.0, 300.0, 46, 125, 50, 255)
    R.绘三角(250.0, 300.0, 470.0, 120.0, 690.0, 300.0, 46, 125, 50, 255)

    // 地面与平台
    R.绘矩形(0.0, 500.0, 960.0, 40.0, 96, 56, 30, 255)
    R.绘矩形(0.0, 500.0, 960.0, 8.0, 70, 180, 60, 255)
    R.绘矩形(360.0, 360.0, 180.0, 18.0, 150, 85, 38, 255)
    R.绘矩形(620.0, 300.0, 160.0, 18.0, 150, 85, 38, 255)

    // 金币
    i = 0
    当 i < 金币们.长度 {
        若 非 已收[i] {
            R.绘圆(金币们[i]["x"], 金币们[i]["y"], 12.0, 255, 215, 40, 255)
            R.绘圆线(金币们[i]["x"], 金币们[i]["y"], 12.0, 255, 170, 20, 255)
        }
        i = i + 1
    }

    // 终点旗
    R.绘矩形(900.0, 330.0, 5.0, 170.0, 230, 230, 230, 255)
    R.绘三角(905.0, 330.0, 905.0, 390.0, 960.0, 360.0, 240, 60, 60, 255)

    // 玩家:帽子/脸/衣服/裤子/鞋,全部矩形+圆形
    R.绘矩形(玩家x, 玩家y, 32.0, 9.0, 220, 35, 35, 255)
    R.绘圆(玩家x + 16.0, 玩家y + 20.0, 14.0, 255, 210, 160, 255)
    R.绘矩形(玩家x + 8.0, 玩家y + 18.0, 4.0, 4.0, 40, 40, 40, 255)
    R.绘矩形(玩家x + 20.0, 玩家y + 18.0, 4.0, 4.0, 40, 40, 40, 255)
    R.绘矩形(玩家x + 5.0, 玩家y + 30.0, 22.0, 12.0, 220, 35, 35, 255)
    R.绘矩形(玩家x + 8.0, 玩家y + 38.0, 16.0, 8.0, 40, 80, 190, 255)
    R.绘矩形(玩家x + 2.0, 玩家y + 44.0, 12.0, 4.0, 70, 45, 30, 255)
    R.绘矩形(玩家x + 18.0, 玩家y + 44.0, 12.0, 4.0, 70, 45, 30, 255)

    R.绘文字("分数: " & 字(分数) & " / 5", 24.0, 22.0, 22, 255, 255, 255, 255)
    R.绘文字("← → / A D 移动    空格 / W / ↑ 跳跃", 24.0, 50.0, 15, 245, 245, 245, 255)
    若 分数 >= 5 {
        R.绘文字("全部金币到手!到达旗杆即通关", 250.0, 220.0, 24, 255, 255, 150, 255)
    }

    R.结束绘图()
}

R.关闭窗口()
