// 局域网即时通讯 Shell 工具(同一程序可选服务端/客户端)
示("=== 玄铁局域网 IM Shell ===")
示("1 = 开房(服务端,端口 7777)")
示("2 = 加入(客户端)")
示("输入『退出』结束。")

设 客户端集: 数组 = []
设 聊天流 = 空

函 广播(内容: 字, 来源) {
    遍历 客 于 客户端集 {
        若 客 != 来源 { 客.写(内容) }
    }
}

函 接收循环() {
    循 {
        设 行 = 聊天流.读()
        若 行 == 空 { 示("[系统] 对方已断开"); 断 }
        示("[对方] " & 行)
    }
}

函 开房() {
    设 服务 = 听(7777, 函(流) {
        客户端集.追加(流)
        示("[系统] 有客户端接入")
        流.写("[系统] 欢迎来到玄铁 IM,输入消息开始聊天\n")
        循 {
            设 行 = 流.读()
            若 行 == 空 { 断 }
            示("[客户端] " & 行)
            广播("[客户端] " & 行 & "\n", 流)
        }
        广播("[系统] 客户端离开\n", 流)
        流.关()
    }, "0.0.0.0")
    若 非 服务.成功 { 示("监听失败: " & 服务.错误); 返 空 }
    示("[系统] 服务端已监听 0.0.0.0:7777")
    循 {
        设 行 = 输("服务端> ")
        若 行 == "退出" { 断 }
        广播("[服务端] " & 行 & "\n", 空)
    }
}

函 加入() {
    设 地址 = 输("服务端 IP (默认 127.0.0.1): ")
    若 地址 == "" { 地址 = "127.0.0.1" }
    设 连接结果 = 连(地址 & ":7777")
    若 非 连接结果.成功 { 示("连接失败: " & 连接结果.错误); 返 空 }
    聊天流 = 连接结果.值
    示("[系统] 已连接,输入消息开始聊天")
    异步 { 接收循环() }
    循 {
        设 行 = 输("我> ")
        若 行 == "退出" { 聊天流.关(); 断 }
        聊天流.写(行 & "\n")
    }
}

设 角色 = 输("请选择 1/2: ")
若 角色 == "1" { 开房() } 否 { 加入() }
示("已退出 IM。")
