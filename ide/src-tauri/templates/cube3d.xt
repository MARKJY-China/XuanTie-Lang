// 3D 立方体:运行后看到缓慢自转、上下浮动的立方体
引 "渲染" 予 R

R.初始化窗口(960, 640, "玄铁 3D 立方体")
R.设置目标帧率(60)
R.设ESC关闭(真)

设 角度: 小数 = 0.0
设 时间: 小数 = 0.0

当 非 R.窗口应关闭?() {
    设 dt: 小数 = R.取帧时间()
    时间 = 时间 + dt
    角度 = 角度 + dt * 45.0
    设 浮动: 小数 = 0.35 * 数学.正弦(时间 * 1.6)

    R.开始绘图()
    R.清背景(14, 18, 30, 255)
    R.设置相机3D(0.0, 1.8, 5.2, 0.0, 浮动, 0.0, 45.0)
    R.进入3D()
    R.推矩阵()
    R.旋转3D(角度, 0.45, 1.0, 0.25)
    R.绘立方体(0.0, 浮动, 0.0, 1.7, 1.7, 1.7, 255, 145, 40, 255)
    R.绘立方体线(0.0, 浮动, 0.0, 1.72, 1.72, 1.72, 255, 235, 180, 255)
    R.弹矩阵()
    R.退出3D()
    R.绘文字("玄铁 3D · 立方体自动旋转", 24, 22, 20, 255, 255, 255, 255)
    R.绘文字("ESC 关闭窗口", 24, 50, 16, 180, 190, 210, 255)
    R.结束绘图()
}

R.关闭窗口()
