// 铁铺命令行入口 — 玄铁官方包管理器 CLI
// 用法:铁铺 <命令> [参数]
//   铁铺 安装 <包名> [版本约束]   安装铁器(自动解析传递依赖)
//   铁铺 列表                   列出已安装的铁器
//   铁铺 搜索 <关键词>           在远程索引中搜索铁器
//   铁铺 发布                   发布当前目录的铁器(需已登录令牌,见 读取API密钥)
//   铁铺 清理                   清理下载缓存

引 "./核心.xt" 予 核心

外 函 xt_get_args(): 数组

函 打印用法() {
    示("tiepm — 玄铁官方包管理器")
    示("用法:")
    示("  tiepm install <包名> [版本约束]   安装铁器(自动解析传递依赖)")
    示("  tiepm list                      列出已安装的铁器")
    示("  tiepm search <关键词>           在远程索引中搜索铁器")
    示("  tiepm publish                   发布当前目录的铁器")
    示("  tiepm clean                     清理下载缓存")
    示("(中文别名: 安装/列表/搜索/发布/清理)")
}

函 搜索铁器(关键词) {
    设 索引 = 核心.获取远程索引()
    若 索引 == 空 {
        示("[铁铺] 无法获取远程索引,请检查网络或铁铺站点状态")
        返 空
    }
    设 命中数 = 0
    遍历 包名 于 索引 {
        若 包名.包含?(关键词) {
            设 版本表 = 索引[包名]
            设 最新 = ""
            遍历 版号 于 版本表 { 最新 = 版号 }
            设 简介 = ""
            若 最新 != "" {
                设 节 = 版本表[最新]
                若 节.含?("描述") { 简介 = 节["描述"] }
            }
            示("  " & 包名 & " (" & 最新 & ")  " & 简介)
            命中数 = 命中数 + 1
        }
    }
    若 命中数 == 0 { 示("[铁铺] 未找到匹配 '" & 关键词 & "' 的铁器") }
}

设 参数 = xt_get_args()
若 参数.长度 < 2 {
    打印用法()
} 否 {
    设 命令 = 参数[1]
    核心.初始化()
    若 命令 == "安装" 或 命令 == "install" {
        若 参数.长度 < 3 {
            示("[tiepm] 用法: tiepm install <包名> [版本约束]")
        } 否 {
            设 约束 = 若 参数.长度 >= 4 { 参数[3] } 否 { "" }
            设 成败 = 核心.安装包带依赖(参数[2], 约束)
            // 失败必须以非零退出码收场:脚本/CI 靠退出码判成败,只打印不退出等于静默放行
            若 成败.成功 { 示("[tiepm] 安装完成") } 否 { 示("[tiepm] 安装失败") 终 1 }
        }
    } 抑 命令 == "列表" 或 命令 == "list" {
        核心.列表已安装()
    } 抑 命令 == "搜索" 或 命令 == "search" {
        若 参数.长度 < 3 {
            示("[tiepm] 用法: tiepm search <关键词>")
        } 否 {
            搜索铁器(参数[2])
        }
    } 抑 命令 == "发布" 或 命令 == "publish" {
        核心.发布包()
    } 抑 命令 == "清理" 或 命令 == "clean" {
        核心.清理缓存()
    } 否 {
        示("[tiepm] 未知命令: " & 命令)
        打印用法()
    }
}
