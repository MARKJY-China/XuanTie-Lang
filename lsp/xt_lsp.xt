// lsp/xt_lsp.xt — 玄铁 LSP 服务器(P1:诊断同步)
// 传输:TCP 回环(开发期);帧格式 Content-Length(字节数) 头 + \r\n\r\n + JSON 体。
// 架构:听 每连接一线程,协议循环就在连接线程里跑(阻塞上下文);
//   帧的精确取体用 读足(N)(恰好 N 字节,绝无 读 尽力而为导致的黏包/截断问题)。

引 "../xuantie_compiler/词法.xt"
引 "../xuantie_compiler/语法分析.xt"

外 函 xt_self_path(): 字   // runtime 内建:取自身可执行文件绝对路径(探测同目录 xtc.exe 用)

设 文档表 = {}          // uri -> 文档全文
设 路径表 = {}          // uri -> 真实磁盘路径(客户端 _fsPath 旁路,中文路径免 URI 解码)
设 用户目录 = ""        // USERPROFILE(惰性首取)
设 编译器路径 = ""      // xtc 路径(initialize 时解析)

// 读一帧:头部逐字节(纯 ASCII,短),体按 Content-Length 精确读取
函 读一帧(流) {
    设 头 = ""
    循 {
        设 c = 流.读足(1)
        若 c == 空 { 返 空 }
        头 = 头 & c
        若 头.长度 >= 4 {
            若 头.截取(头.长度 - 4, 头.长度) == "\r\n\r\n" { 断 }
        }
    }
    设 体长 = -1
    遍历 行 于 头.分割("\r\n") {
        若 行.包含?("Content-Length") {
            设 kv = 行.分割(":")
            若 kv.长度 > 1 {
                设 转 = 整(kv[1])
                若 转.成功 { 体长 = 转.值 }
            }
        }
    }
    若 体长 < 0 { 返 空 }
    返 流.读足(体长)
}

函 写帧(流, 载荷) {
    流.写("Content-Length: " & 载荷.字节数 & "\r\n\r\n" & 载荷)
}

// 分析+发布诊断,并同步刷新符号缓存(P2 补全/悬停用)
// 行列转换:玄铁 行/列 均 1 起;LSP 0 起。列为字符列,对 BMP 字符(含中文)恰等于 UTF-16 单元数
// 额外诊断:保存级语义诊断等外部来源的诊断数组,合并进本次发布(didOpen/didChange 传 [])
函 发布诊断(流, uri, 文本, 额外诊断) {
    设 词法 = 造 词法分析器(文本)
    设 解析 = 造 语法分析器(词法)
    解析.严格度 = "默认"
    // 项目配置:忽略警告列表同时作用于解析器警告与服务器自产诊断
    设 忽略列表 = 取忽略列表(uri)
    解析.全局忽略列表 = 忽略列表
    设 _树 = 解析.解析程序()
    设 诊断们 = []
    遍历 错 于 解析.错误结构列表 {
        设 行号 = 错["行"] - 1
        设 列号 = 错["列"] - 1
        若 行号 < 0 { 行号 = 0 }
        若 列号 < 0 { 列号 = 0 }
        诊断们.追加({
            "range": {"start": {"line": 行号, "character": 列号}, "end": {"line": 行号, "character": 列号 + 1}},
            "severity": 1,
            "source": "xtc",
            "message": 错["消息"]
        })
    }
    遍历 警 于 解析.警告结构列表 {
        设 警行 = 警["行"] - 1
        设 警列 = 警["列"] - 1
        若 警行 < 0 { 警行 = 0 }
        若 警列 < 0 { 警列 = 0 }
        诊断们.追加({
            "range": {"start": {"line": 警行, "character": 警列}, "end": {"line": 警行, "character": 警列 + 1}},
            "severity": 2,
            "source": "xtc",
            "message": "[" & 警["码"] & "] " & 警["消息"]
        })
    }
    // P2:同步刷新符号缓存(供补全/悬停)
    设 _符号 = 收集符号(_树)
    符号缓存[uri] = _符号
    // W001 建议级诊断:未标注类型的变量声明给黄色提醒(建议静态强类型标注)
    // 配置 忽略警告=["W001"] 时跳过
    设 _忽略W001 = 忽略列表.含?("W001")
    若 非 _忽略W001 {
        设 _未标注 = []
        遍历 _顶 于 _树.程序语句列表 { 收集未标注声明(_顶, _未标注) }
        遍历 _未 于 _未标注 {
            设 _w行 = _未["行"] - 1
            设 _w列 = _未["列"] - 1
            若 _w行 < 0 { _w行 = 0 }
            若 _w列 < 0 { _w列 = 0 }
            诊断们.追加({
                "range": {"start": {"line": _w行, "character": _w列}, "end": {"line": _w行, "character": _w列 + 1}},
                "severity": 2,
                "source": "xtc",
                "message": "[W001] 变量 '" & _未["名"] & "' 未标注类型,建议显式标注(如 : 整/: 字)以启用静态强类型检查"
            })
        }
    }
    // 引 模块:存在性诊断 + 成员符号缓存(供 R. 补全)
    遍历 符 于 _符号 {
        若 符["类别"] == "引" {
            设 候选 = 解析引路径(符["签名"], uri)
            若 非 文件.存在?(候选) {
                设 引行 = 符["行"] - 1
                设 引列 = 符["列"] - 1
                若 引行 < 0 { 引行 = 0 }
                若 引列 < 0 { 引列 = 0 }
                诊断们.追加({
                    "range": {"start": {"line": 引行, "character": 引列}, "end": {"line": 引行, "character": 引列 + 1}},
                    "severity": 1,
                    "source": "xtc",
                    "message": "无法解析的引用 '" & 符["签名"] & "'(文件不存在;铁铺包请先 铁铺 安装)"
                })
            } 否 {
                // 模块符号按磁盘路径缓存:同一模块只解析一次(此前每击键重解析,
                // 大模块(如 渲染)导致补全慢 2 秒,实测抓获)
                设 缓存键 = uri & "|" & 符["名"]
                若 非 模块符号缓存.含?(缓存键) {
                    模块符号缓存[缓存键] = 取模块符号(符["签名"], uri)
                    模块路径缓存[缓存键] = 解析引路径(符["签名"], uri)
                }
            }
        }
    }
    // 合并外部诊断(P4 语义诊断:didSave 时 xtc --检查 子进程产出的语义错误)
    遍历 _额 于 额外诊断 { 诊断们.追加(_额) }
    写帧(流, 化({"jsonrpc": "2.0", "method": "textDocument/publishDiagnostics",
        "params": {"uri": uri, "diagnostics": 诊断们}}))
}

// ============ P4:保存级语义诊断(xtc --检查 子进程) ============
// didSave 时以 编译器路径 对磁盘文件跑全量检查(词法→语法→语义,停在 clang 前),
// 解析输出中的错误行(格式:编译错误: [<路径> 行:X, 列:Y] 消息),与解析诊断合并发布。
// 注意:编译器单遍报错模型,一次只报首个错误;被 引 库文件内的错误行列对本 uri 无意义,过滤只收主文件。
函 发布语义诊断(流, uri) {
    设 语义诊断 = []
    设 文件路径 = ""
    若 路径表.含?(uri) { 文件路径 = 路径表[uri] }
    若 文件路径 == "" 且 uri.包含?("file:///") {
        文件路径 = uri.替换("file:///", "").替换("/", "\\")
    }
    若 文件路径 != "" 且 编译器路径 != "" 且 文件.存在?(编译器路径) {
        设 出 = 执("\"" & 编译器路径 & "\" 铁 \"" & 文件路径 & "\" --检查")
        // 执 的契约:退出码非 0 时 stdout 包进错误消息("执行失败 (退出码: N). 输出: <stdout>")
        设 全文 = ""
        若 出.成功 { 全文 = 出.值 } 否 { 全文 = 出.错误 }
        遍历 行 于 全文.分割("\n") {
            若 非 行.包含?("行:") { 续 }
            若 非 行.包含?("列:") { 续 }
            若 非 行.包含?("]") { 续 }
            若 非 行.包含?("[" & 文件路径 & " 行:") { 续 }
            设 段行 = 行.分割("行:")
            若 段行.长度 < 2 { 续 }
            设 段列 = 段行[1].分割("列:")
            若 段列.长度 < 2 { 续 }
            设 行号串 = 段行[1].分割(",")[0].替换(" ", "")
            设 列号串 = 段列[1].分割("]")[0].替换(" ", "")
            设 转行 = 整(行号串)
            设 转列 = 整(列号串)
            若 非 转行.成功 { 续 }
            若 非 转列.成功 { 续 }
            // 消息 = 首个 "]" 之后全部(消息自身可能含 "]",逐段拼回)
            设 段括 = 行.分割("]")
            设 消息 = ""
            设 _i = 1
            当 _i < 段括.长度 {
                若 _i > 1 { 消息 = 消息 & "]" }
                消息 = 消息 & 段括[_i]
                _i = _i + 1
            }
            设 级 = 1
            若 非 行.包含?("错误") { 级 = 2 }
            设 行号 = 转行.值 - 1
            设 列号 = 转列.值 - 1
            若 行号 < 0 { 行号 = 0 }
            若 列号 < 0 { 列号 = 0 }
            语义诊断.追加({
                "range": {"start": {"line": 行号, "character": 列号}, "end": {"line": 行号, "character": 列号 + 1}},
                "severity": 级,
                "source": "xtc",
                "message": 消息
            })
        }
    }
    设 文本 = ""
    若 文档表.含?(uri) { 文本 = 文档表[uri] }
    发布诊断(流, uri, 文本, 语义诊断)
}

// ============ 配置文件(玄铁.配置.toml)支持:向上查找 + 忽略警告 ============

// 从文档目录向上逐级查找 玄铁.配置.toml(找到即项目根);找不到返 ""
// 全程用 字符数(字符索引),中文目录名安全
函 查找配置文件(起始目录) {
    设 查 = 起始目录
    循 {
        设 试 = 查 & "玄铁.配置.toml"
        若 文件.存在?(试) { 返 试 }
        若 查 == "" { 返 "" }
        设 去尾 = 查
        设 尾字 = 去尾.截取(去尾.字符数 - 1, 去尾.字符数)
        若 尾字 == "\\" 或 尾字 == "/" { 去尾 = 去尾.截取(0, 去尾.字符数 - 1) }
        设 再斜 = -1
        设 i = 去尾.字符数 - 1
        当 i >= 0 {
            设 c = 去尾.截取(i, i + 1)
            若 c == "\\" 或 c == "/" { 再斜 = i ; 断 }
            i = i - 1
        }
        若 再斜 < 0 { 返 "" }
        查 = 去尾.截取(0, 再斜 + 1)
    }
    返 ""
}

函 解析配置数组(串) {
    设 出 = []
    设 体 = 串.替换("[", "").替换("]", "")
    遍历 项 于 体.分割(",") {
        设 净 = 项.替换(" ", "").替换("\t", "")
        若 净 != "" { 出.追加(净) }
    }
    返 出
}

函 解析配置文本(内容) {
    设 配置结果 = {}
    设 行列表 = 内容.分割("\n")
    遍历 原始行 于 行列表 {
        设 行 = 原始行.替换("\r", "")
        若 行 == "" { 续 }
        设 首 = 行.截取(0, 1)
        若 首 == "#" 或 首 == "[" { 续 }
        若 非 行.包含?("=") { 续 }
        设 等号位 = 0
        设 ci = 0
        当 ci < 行.字符数 { 若 行.截取(ci, ci+1) == "=" { 等号位 = ci ; 断 } ; ci = ci + 1 }
        设 键 = 行.截取(0, 等号位).替换(" ", "").替换("\t", "")
        设 值 = 行.截取(等号位 + 1, 行.字符数).替换(" ", "").替换("\t", "").替换("\"", "")
        若 键 != "" { 配置结果[键] = 值 }
    }
    返 配置结果
}

// 读取文档生效的忽略列表(含项目配置;无配置返 [])
函 取忽略列表(uri) {
    设 目录 = ""
    若 路径表.含?(uri) {
        设 _p = 路径表[uri]
        设 _i = _p.字符数 - 1
        当 _i >= 0 {
            设 _c = _p.截取(_i, _i + 1)
            若 _c == "\\" 或 _c == "/" { 目录 = _p.截取(0, _i + 1) ; 断 }
            _i = _i - 1
        }
    } 否 {
        目录 = 文档目录(uri)
    }
    设 配置路径 = 查找配置文件(目录)
    若 配置路径 == "" { 返 [] }
    设 读果 = 文件.读(配置路径)
    若 非 读果.成功 { 返 [] }
    设 配置 = 解析配置文本(读果.值)
    若 配置.含?("忽略警告") { 返 解析配置数组(配置["忽略警告"]) }
    返 []
}

// 类型关键字表(补全带类型图标 + 悬停文档)
设 类型文档 = {
    "整": "整数类型:`设 n: 整 = 42`;转换用 `整(x)`(返回 结果)",
    "小数": "浮点类型:`设 f: 小数 = 3.14`;转换用 `小数(x)`(返回 结果)",
    "字": "字符串类型:`设 s: 字 = \"文\"`;转换用 `字(x)`",
    "布尔": "布尔类型(真/假):`设 b: 布尔 = 真`",
    "数组": "动态数组:`设 a: 数组 = [1,2,3]`",
    "字典": "键值字典:`设 d: 字典 = {\"k\": 1}`",
    "字节": "字节流类型(二进制数据)",
    "结果": "结果容器(成功/失败):`结果<值>`;用 .成功/.值/.错误 判定拆包",
    "任务": "异步任务句柄(异步 {} 的返回)"
}

// ============ P2:符号收集/补全/悬停 ============

// 关键字文档表(hover 悬停说明 + completion 补全 detail 共用)
设 关键字文档 = {
    "设": "声明变量:`设 名 = 值`",
    "常": "声明常量:`常 名 = 值`",
    "函": "声明函数:`函 名(参数) { ... }`",
    "型": "声明类型:`型 名 { 设 字段; 函 方法() {} }`",
    "造": "实例化类型:`造 型名(构造参数)`",
    "若": "条件分支:`若 条件 {} 抑 条件 {} 否 {}`",
    "当": "条件循环:`当 (条件) { ... }`",
    "循": "无限循环:`循 { ... }`(配 断 退出)",
    "遍历": "遍历容器:`遍历 元素 于 容器 { ... }`",
    "断": "跳出当前循环",
    "续": "跳过本次迭代",
    "返": "从函数返回:`返 表达式`",
    "匹配": "模式匹配:`匹配 值 { 模式 -> { ... } _ -> {} }`",
    "异步": "创建异步任务(自动路由 fiber/线程池):`异步 { ... }`",
    "等待": "等待异步任务并取回结果:`等待(任务)`",
    "并行": "并行执行多个块:`并行 { {a}, {b} }`",
    "道": "创建通道:`道(容量)`",
    "选": "多通道选择:`选([通道数组], 超时毫秒)`",
    "收": "通道接收(状态机内为挂起点)",
    "发": "通道发送(状态机内为挂起点)",
    "引": "引入模块:`引 \"路径.xt\" 予 别名`",
    "予": "模块别名(配 引 使用)",
    "示": "打印输出:`示(内容)`",
    "输": "读取一行输入:`输(提示)`",
    "求": "HTTP 请求:`求(url)` 或 `求(url, 选项)`",
    "连": "TCP 连接:`连(\"主机:端口\")` 返回 结果(fiber 内为挂起点)",
    "听": "TCP 监听:`听(端口, 函(流) {...})`",
    "执": "执行系统命令,返回 结果",
    "化": "JSON 序列化:`化(对象)`",
    "解": "JSON 反序列化:`解(字符串)`",
    "尝试": "异常捕获:`尝试 { ... } 捕捉 (错) { ... }`",
    "终": "立即终止进程:`终 退出码`",
    "真": "布尔真", "假": "布尔假", "空": "空值",
    "此": "型方法内的当前实例",
    "公": "公开可见性修饰", "私": "私有可见性修饰", "护": "保护可见性修饰",
    "承": "型继承:`型 子 承 父 {}`",
    "覆": "方法重写修饰",
    "弱": "弱引用修饰:`弱 设 名 = ...`(不持有所有权,对象释放后自动归零)"
}

// 收集文档顶层符号(函/型/设/常)与模块别名(引),供补全与悬停
函 收集符号(程序树) {
    设 符号们 = []
    若 程序树 == 空 { 返 符号们 }
    遍历 语句 于 程序树.程序语句列表 {
        若 语句.节点类别 == "函数定义" {
            设 签 = "函 " & 语句.函数名 & "(…)"
            符号们.追加({"名": 语句.函数名, "类别": "函", "行": 语句.节点行, "列": 语句.节点列, "签名": 签})
        }
        若 语句.节点类别 == "型定义" {
            符号们.追加({"名": 语句.类型名称, "类别": "型", "行": 语句.节点行, "列": 语句.节点列, "签名": "型 " & 语句.类型名称})
        }
        若 语句.节点类别 == "变量声明" {
            若 语句.是解构 == 假 {
                符号们.追加({"名": 语句.声明名称, "类别": "设", "行": 语句.节点行, "列": 语句.节点列, "签名": "设 " & 语句.声明名称})
            }
        }
        若 语句.节点类别 == "表达式语句" {
            设 _e = 语句.语句表达式
            若 _e.节点类别 == "引入" {
                设 _空间名 = _e.别名
                若 _空间名 == "" {
                    // 无 予 别名:命名空间取模块文件名本体(去目录与 .xt)
                    _空间名 = _e.路径
                    若 _空间名.包含?("/") {
                        设 _段集 = _空间名.分割("/")
                        _空间名 = _段集[_段集.长度 - 1]
                    }
                    若 _空间名.包含?("\\") {
                        设 _段集2 = _空间名.分割("\\")
                        _空间名 = _段集2[_段集2.长度 - 1]
                    }
                    _空间名 = _空间名.替换(".xt", "")
                }
                若 _空间名 != "" {
                    符号们.追加({"名": _空间名, "类别": "引", "行": _e.节点行, "列": _e.节点列, "签名": _e.路径})
                }
            }
        }
    }
    返 符号们
}

// 文档符号缓存:uri -> 符号数组
设 符号缓存 = {}

// 补全:关键字 + 内建 + 文档符号;别名. 触发模块成员补全
// sortText 约定:0_=关键字(置顶) 1_=函 2_=型 3_=设 —— 客户端按此排序
// 函数类候选带 insertText 代码片段:补全括号且光标落括号内($0)
函 处理补全(流, 消息) {
    设 uri = 消息["params"]["textDocument"]["uri"]
    设 位 = 消息["params"]["position"]
    设 项们 = []

    // 检测「别名.」上下文:当前行光标前的文本以 某别名. 结尾
    设 模块别名 = ""
    若 文档表.含?(uri) {
        设 行们 = 文档表[uri].分割("\n")
        设 行号0 = 位["line"]
        若 行号0 < 行们.长度 {
            设 行前 = 行们[行号0]
            设 列止 = 位["character"]
            若 列止 > 行前.字符数 { 列止 = 行前.字符数 }
            设 前缀 = 行前.截取(0, 列止)
            若 符号缓存.含?(uri) {
                遍历 符 于 符号缓存[uri] {
                    若 符["类别"] == "引" {
                        设 探 = 符["名"] & "."
                        若 前缀.长度 >= 探.字符数 {
                            若 前缀.截取(前缀.字符数 - 探.字符数, 前缀.字符数) == 探 {
                                模块别名 = 符["名"]
                            }
                        }
                    }
                }
            }
        }
    }

    // 别名. 分支:返回模块成员符号
    若 模块别名 != "" {
        设 缓存键 = uri & "|" & 模块别名
        若 模块符号缓存.含?(缓存键) {
            遍历 符 于 模块符号缓存[缓存键] {
                若 符["类别"] == "引" { 续 }
                设 种 = 6
                若 符["类别"] == "函" { 种 = 3 }
                若 符["类别"] == "型" { 种 = 7 }
                设 项 = {"label": 符["名"], "kind": 种, "detail": 模块别名 & " 模块成员", "sortText": "1_" & 符["名"]}
                若 符["类别"] == "函" {
                    项["insertText"] = 符["名"] & "($0)"
                    项["insertTextFormat"] = 2
                }
                项们.追加(项)
            }
        }
        写帧(流, 化({"jsonrpc": "2.0", "id": 消息["id"], "result": 项们}))
        返 空
    }

    遍历 键 于 关键字文档.键() {
        设 _项 = {"label": 键, "kind": 14, "detail": 关键字文档[键], "sortText": "0_" & 键}
        // 调用型关键字带括号片段:选中即 名() 且光标入括号
        若 键 == "示" 或 键 == "输" 或 键 == "求" 或 键 == "连" 或 键 == "执" 或 键 == "化" 或 键 == "解" 或 键 == "道" 或 键 == "选" 或 键 == "等待" {
            _项["insertText"] = 键 & "($0)"
            _项["insertTextFormat"] = 2
        }
        项们.追加(_项)
    }
    // 类型关键字(kind 22=结构型图标,置顶同关键字层)
    遍历 型键 于 类型文档.键() {
        项们.追加({"label": 型键, "kind": 22, "detail": 类型文档[型键], "sortText": "0_" & 型键})
    }
    若 符号缓存.含?(uri) {
        遍历 符 于 符号缓存[uri] {
            设 种 = 6
            设 序 = "3_"
            若 符["类别"] == "函" { 种 = 3 ; 序 = "1_" }
            若 符["类别"] == "型" { 种 = 7 ; 序 = "2_" }
            若 符["类别"] == "引" {
                // 库名/别名本身也进补全(kind=Module 9),排在符号之后
                项们.追加({"label": 符["名"], "kind": 9, "detail": "引入模块: " & 符["签名"], "sortText": "4_" & 符["名"]})
                续
            }
            设 项2 = {"label": 符["名"], "kind": 种, "detail": 符["签名"], "sortText": 序 & 符["名"]}
            若 符["类别"] == "函" {
                项2["insertText"] = 符["名"] & "($0)"
                项2["insertTextFormat"] = 2
            }
            项们.追加(项2)
        }
    }
    写帧(流, 化({"jsonrpc": "2.0", "id": 消息["id"], "result": 项们}))
}

// P3:跳转定义——返回符号声明处 Location
函 处理定义(流, 消息) {
    设 uri = 消息["params"]["textDocument"]["uri"]
    设 位 = 消息["params"]["position"]
    设 目标行 = 位["line"] + 1
    设 目标列 = 位["character"] + 1
    设 答复 = 空
    若 文档表.含?(uri) 且 符号缓存.含?(uri) {
        设 文本 = 文档表[uri]
        设 词法 = 造 词法分析器(文本)
        设 命中 = ""
        设 命中起 = 0
        循 {
            设 t = 词法.读标记()
            若 t.标记类型 == "结束" { 断 }
            若 t.标记行 == 目标行 {
                设 起 = t.标记列
                设 止 = 起 + t.标记字面量.字符数
                若 目标列 >= 起 且 目标列 < 止 {
                    命中 = t.标记字面量
                    命中起 = 起
                    断
                }
            }
        }
        若 命中 != "" {
            // 库成员跳转:命中标记前若是 别名. → 跳到库源码对应位置
            设 前文行 = ""
            设 _行集 = 文本.分割("\n")
            若 目标行 - 1 < _行集.长度 { 前文行 = _行集[目标行 - 1] }
            设 前别 = ""
            若 前文行 != "" {
                前别 = 取前置别名(前文行, 命中起, uri)
            }
            若 前别 != "" {
                设 _键 = uri & "|" & 前别
                若 模块符号缓存.含?(_键) {
                    遍历 符 于 模块符号缓存[_键] {
                        若 符["名"] == 命中 且 符["类别"] != "引" {
                            设 行0 = 符["行"] - 1
                            设 列0 = 符["列"] - 1
                            若 行0 < 0 { 行0 = 0 }
                            若 列0 < 0 { 列0 = 0 }
                            答复 = {"uri": 路径转URI(模块路径缓存[_键]), "range": {"start": {"line": 行0, "character": 列0}, "end": {"line": 行0, "character": 列0 + 命中.字符数}}}
                        }
                    }
                }
            }
            // 本文档符号跳转
            若 答复 == 空 {
                遍历 符 于 符号缓存[uri] {
                    若 符["名"] == 命中 且 符["类别"] != "引" {
                        设 行0 = 符["行"] - 1
                        设 列0 = 符["列"] - 1
                        若 行0 < 0 { 行0 = 0 }
                        若 列0 < 0 { 列0 = 0 }
                        答复 = {"uri": uri, "range": {"start": {"line": 行0, "character": 列0}, "end": {"line": 行0, "character": 列0 + 命中.字符数}}}
                    }
                }
            }
        }
    }
    写帧(流, 化({"jsonrpc": "2.0", "id": 消息["id"], "result": 答复}))
}

// P3:文档符号(大纲/ Ctrl+Shift+O)
函 处理文档符号(流, 消息) {
    设 uri = 消息["params"]["textDocument"]["uri"]
    设 项们 = []
    若 符号缓存.含?(uri) {
        遍历 符 于 符号缓存[uri] {
            若 符["类别"] == "引" { 续 }
            设 种 = 13
            若 符["类别"] == "函" { 种 = 12 }
            若 符["类别"] == "型" { 种 = 5 }
            设 行0 = 符["行"] - 1
            设 列0 = 符["列"] - 1
            若 行0 < 0 { 行0 = 0 }
            若 列0 < 0 { 列0 = 0 }
            设 名长 = 符["名"].字符数
            项们.追加({
                "name": 符["名"],
                "kind": 种,
                "location": {"uri": uri, "range": {"start": {"line": 行0, "character": 列0}, "end": {"line": 行0, "character": 列0 + 名长}}}
            })
        }
    }
    写帧(流, 化({"jsonrpc": "2.0", "id": 消息["id"], "result": 项们}))
}

// 从文档文本中提取声明处的定义代码块(函/型:按花括号平衡;设/常:单行;上限 40 行)
// 注:花括号计数不区分字符串内括号——预览级近似,够用
函 取定义块(文本, 起始行) {
    设 行们 = 文本.分割("\n")
    设 出 = ""
    设 深度 = 0
    设 见过开 = 假
    设 i = 起始行 - 1
    设 计 = 0
    当 i < 行们.长度 且 计 < 40 {
        设 行 = 行们[i]
        出 = 出 & 行 & "\n"
        设 j = 0
        当 j < 行.字符数 {
            设 c = 行.截取(j, j + 1)
            若 c == "{" { 深度 = 深度 + 1 ; 见过开 = 真 }
            若 c == "}" { 深度 = 深度 - 1 }
            j = j + 1
        }
        计 = 计 + 1
        i = i + 1
        若 见过开 且 深度 <= 0 { 断 }
        若 非 见过开 { 断 }
    }
    返 出
}

// file:/// URI → 本机路径(处理盘符与常见转义)
函 uri转路径(uri) {
    设 p = uri
    若 p.包含?("file:///") { p = p.替换("file:///", "") }
    p = p.替换("%3A", ":").替换("%20", " ").替换("%28", "(").替换("%29", ")")
    返 p
}

// 磁盘路径 → file:/// URI(跳转定义给客户端用;中文段 percent 编码)
函 路径转URI(路径) {
    设 p = 路径.替换("\\", "/").替换(":", "%3A")
    设 出 = ""
    设 i = 0
    当 i < p.字符数 {
        设 c = p.截取(i, i + 1)
        若 c.字节数 > 1 {
            // 多字节字符:逐字节百分号编码
            设 b = 0
            当 b < c.字节数 {
                出 = 出 & "%" & 转十六大写(c.字节(b))
                b = b + 1
            }
        } 否 {
            出 = 出 & c
        }
        i = i + 1
    }
    返 "file:///" & 出
}

// 字节值(0-255) → 两位大写十六进制串
函 转十六大写(值) {
    设 字集 = "0123456789ABCDEF"
    设 高 = 值 / 16
    设 低 = 值 - 高 * 16
    返 字集.截取(高, 高 + 1) & 字集.截取(低, 低 + 1)
}

// 取「别名.」前置:若 行前文本 在 起列(1起,标记起点) 之前以 某引入别名. 结尾,返回别名,否则 ""
函 取前置别名(行前, 起列, uri) {
    若 非 符号缓存.含?(uri) { 返 "" }
    设 前文 = 行前.截取(0, 起列 - 1)
    设 命中别名 = ""
    遍历 符 于 符号缓存[uri] {
        若 符["类别"] == "引" {
            设 探 = 符["名"] & "."
            若 前文.字符数 >= 探.字符数 {
                若 前文.截取(前文.字符数 - 探.字符数, 前文.字符数) == 探 {
                    命中别名 = 符["名"]
                }
            }
        }
    }
    返 命中别名
}

// 取文档所在目录(带末尾 /)
函 文档目录(uri) {
    设 p = uri转路径(uri)
    设 i = p.长度 - 1
    当 i >= 0 {
        设 c = p.截取(i, i + 1)
        若 c == "/" 或 c == "\\" { 返 p.截取(0, i + 1) }
        i = i - 1
    }
    返 ""
}

// 递归收集未标注类型的变量声明(W001 建议级诊断:提醒静态强类型标注)
函 收集未标注声明(节点, 集) {
    若 节点 == 空 { 返 空 }
    设 类 = 节点.节点类别
    若 类 == "变量声明" {
        若 节点.注解类型 == "" {
            集.追加({"行": 节点.节点行, "列": 节点.节点列, "名": 节点.声明名称})
        }
        返 空
    }
    若 类 == "块" { 遍历 _s 于 节点.块语句列表 { 收集未标注声明(_s, 集) } ; 返 空 }
    若 类 == "若语句" {
        收集未标注声明(节点.若结果块, 集)
        遍历 _b 于 节点.抑分支列表 { 收集未标注声明(_b[1], 集) }
        若 节点.若否则块 != 空 { 收集未标注声明(节点.若否则块, 集) }
        返 空
    }
    若 类 == "当语句" 或 类 == "无限循环" { 收集未标注声明(节点.循环块, 集) ; 返 空 }
    若 类 == "遍历循环" { 收集未标注声明(节点.循环块, 集) ; 返 空 }
    若 类 == "函数定义" { 收集未标注声明(节点.函数体块, 集) ; 返 空 }
    若 类 == "型定义" {
        遍历 _属 于 节点.属性列表 { 收集未标注声明(_属, 集) }
        遍历 _方 于 节点.方法列表 { 收集未标注声明(_方, 集) }
        返 空
    }
    若 类 == "尝试捕捉" {
        收集未标注声明(节点.尝试块, 集)
        若 节点.捕捉块 != 空 { 收集未标注声明(节点.捕捉块, 集) }
        返 空
    }
    返 空
}

// 模块别名悬停:读模块文件首部连续 // 注释块作为库说明
函 取模块文档(模块路径, uri) {
    设 候选 = 解析引路径(模块路径, uri)
    设 读果 = 文件.读(候选)
    若 非 读果.成功 { 返 "**模块 " & 模块路径 & "**\n\n(模块文件不可读: " & 候选 & ")" }
    设 行们 = 读果.值.分割("\n")
    设 说明 = ""
    设 i = 0
    当 i < 行们.长度 {
        设 行 = 行们[i]
        若 行.长度 >= 2 且 行.截取(0, 2) == "//" {
            说明 = 说明 & 行 & "\n"
        } 否 {
            若 行.长度 > 0 { 断 }
        }
        i = i + 1
    }
    若 说明 == "" { 返 "**模块 " & 模块路径 & "**(无首部注释说明)" }
    返 "**模块 " & 模块路径 & "**\n\n" & 说明
}

// 铁铺裸包名判定(与编译器一致:不含点/斜杠)
函 是裸包名(路径) {
    若 路径.包含?(".") { 返 假 }
    若 路径.包含?("/") { 返 假 }
    若 路径.包含?("\\") { 返 假 }
    返 真
}

// 引 路径 → 磁盘路径(相对路径按文档目录;裸包名按铁铺安装目录)
函 解析引路径(模块路径, uri) {
    若 是裸包名(模块路径) {
        若 用户目录 == "" {
            设 环 = 执("cmd /c echo %USERPROFILE%")
            若 环.成功 { 用户目录 = 环.值.替换("\r", "").替换("\n", "").替换(" ", "") }
        }
        返 用户目录 & "\\.tiepm\\已安装\\" & 模块路径 & "\\" & 模块路径 & ".xt"
    }
    设 候选 = 模块路径
    若 非 候选.包含?(".xt") { 候选 = 候选 & ".xt" }
    返 文档目录(uri) & 候选
}

// 解析模块文件,收集其顶层公开符号(函/型/设)
函 取模块符号(模块路径, uri) {
    设 候选 = 解析引路径(模块路径, uri)
    设 读果 = 文件.读(候选)
    若 非 读果.成功 { 返 [] }
    // 缓存模块全文与磁盘路径(悬停预览/跳转定义用)
    模块文本缓存[候选] = 读果.值
    设 词法 = 造 词法分析器(读果.值)
    设 解析 = 造 语法分析器(词法)
    设 树 = 解析.解析程序()
    返 收集符号(树)
}

// 模块符号缓存:uri|别名 -> 符号数组
设 模块符号缓存 = {}
// 模块文本缓存:磁盘路径 -> 模块全文
设 模块文本缓存 = {}
// 模块磁盘路径缓存:uri|别名 -> 磁盘路径(跳转定义用)
设 模块路径缓存 = {}

// 悬停:重词法,定位光标处标记,返回说明
// 优先级:模块别名(库说明) > 文档符号(定义代码块预览) > 关键字(用法文档)
函 处理悬停(流, 消息) {
    设 uri = 消息["params"]["textDocument"]["uri"]
    设 位 = 消息["params"]["position"]
    设 目标行 = 位["line"] + 1
    设 目标列 = 位["character"] + 1
    设 答复 = 空
    若 文档表.含?(uri) {
        设 文本 = 文档表[uri]
        设 词法 = 造 词法分析器(文本)
        设 命中 = ""
        设 命中起 = 0
        循 {
            设 t = 词法.读标记()
            若 t.标记类型 == "结束" { 断 }
            若 t.标记行 == 目标行 {
                设 起 = t.标记列
                设 止 = 起 + t.标记字面量.字符数
                若 目标列 >= 起 且 目标列 < 止 {
                    命中 = t.标记字面量
                    命中起 = 起
                    断
                }
            }
        }
        若 命中 != "" {
            设 已答 = 假
            // 0. 库成员悬停:命中标记前若是 别名. → 显示该成员的库内定义代码块预览
            设 前文行 = ""
            设 _行集 = 文本.分割("\n")
            若 目标行 - 1 < _行集.长度 { 前文行 = _行集[目标行 - 1] }
            若 前文行 != "" {
                设 _前别 = 取前置别名(前文行, 命中起, uri)
                若 _前别 != "" {
                    设 _键 = uri & "|" & _前别
                    若 模块符号缓存.含?(_键) {
                        遍历 符 于 模块符号缓存[_键] {
                            若 符["名"] == 命中 且 符["类别"] != "引" {
                                设 _模文 = 模块文本缓存[模块路径缓存[_键]]
                                设 _块 = 取定义块(_模文, 符["行"])
                                答复 = "**" & _前别 & "." & 符["名"] & "** —— " & 符["类别"] & ",库内第 " & 符["行"] & " 行\n\n```xuantie\n" & _块 & "```"
                                已答 = 真
                            }
                        }
                    }
                }
            }
            // 1. 文档符号:模块别名 → 库说明;函/型/设 → 定义代码块预览
            若 非 已答 {
                若 符号缓存.含?(uri) {
                    遍历 符 于 符号缓存[uri] {
                        若 符["名"] == 命中 {
                            若 符["类别"] == "引" {
                                答复 = 取模块文档(符["签名"], uri)
                                已答 = 真
                            } 否 {
                                设 块 = 取定义块(文本, 符["行"])
                                答复 = "**" & 符["签名"] & "** —— 声明于第 " & 符["行"] & " 行\n\n```xuantie\n" & 块 & "```"
                                已答 = 真
                            }
                        }
                    }
                }
            }
            // 2. 关键字用法文档(含类型关键字)
            若 非 已答 {
                若 关键字文档.含?(命中) {
                    答复 = "**" & 命中 & "** —— " & 关键字文档[命中]
                } 否 {
                    若 类型文档.含?(命中) {
                        答复 = "**" & 命中 & "** —— " & 类型文档[命中]
                    }
                }
            }
        }
    }
    若 答复 == 空 {
        写帧(流, 化({"jsonrpc": "2.0", "id": 消息["id"], "result": 空}))
    } 否 {
        写帧(流, 化({"jsonrpc": "2.0", "id": 消息["id"], "result": {"contents": {"kind": "markdown", "value": 答复}}}))
    }
}

// 协议主循环(连接线程内,阻塞)
函 跑协议(流) {
    循 {
        设 体 = 读一帧(流)
        若 体 == 空 { 断 }
        设 消息 = 解(体)
        若 消息 == 空 { 续 }
        设 方法 = ""
        若 消息.含?("method") { 方法 = 消息["method"] }
        设 有id = 消息.含?("id")

        若 方法 == "initialize" {
            // 解析编译器路径:客户端 _xtcPath > xt_lsp 自身同目录 xtc.exe > PATH 里的 xtc
            若 消息["params"].含?("_xtcPath") {
                编译器路径 = 消息["params"]["_xtcPath"]
            }
            若 编译器路径 == "" {
                设 _自 = xt_self_path()
                若 _自 != "" {
                    设 _目 = ""
                    设 _i = _自.字符数 - 1
                    当 _i >= 0 {
                        设 _c = _自.截取(_i, _i + 1)
                        若 _c == "\\" 或 _c == "/" { _目 = _自.截取(0, _i + 1) ; 断 }
                        _i = _i - 1
                    }
                    若 _目 != "" 且 文件.存在?(_目 & "xtc.exe") { 编译器路径 = _目 & "xtc.exe" }
                }
            }
            若 编译器路径 == "" { 编译器路径 = "xtc" }
            写帧(流, 化({"jsonrpc": "2.0", "id": 消息["id"], "result": {
                "capabilities": {
                    "textDocumentSync": {"openClose": 真, "change": 1, "save": 真},
                    "completionProvider": {"resolveProvider": 假},
                    "hoverProvider": 真,
                    "definitionProvider": 真,
                    "documentSymbolProvider": 真
                },
                "serverInfo": {"name": "xt_lsp", "version": "v1.0-rc"}}}))
        } 抑 方法 == "shutdown" {
            若 有id { 写帧(流, 化({"jsonrpc": "2.0", "id": 消息["id"], "result": 空})) }
        } 抑 方法 == "exit" {
            流.关()
            终 0
        } 抑 方法 == "textDocument/completion" {
            处理补全(流, 消息)
        } 抑 方法 == "textDocument/hover" {
            处理悬停(流, 消息)
        } 抑 方法 == "textDocument/definition" {
            处理定义(流, 消息)
        } 抑 方法 == "textDocument/documentSymbol" {
            处理文档符号(流, 消息)
        } 抑 方法 == "textDocument/didOpen" {
            设 文档 = 消息["params"]["textDocument"]
            设 uri = 文档["uri"]
            文档表[uri] = 文档["text"]
            若 消息["params"].含?("_fsPath") { 路径表[uri] = 消息["params"]["_fsPath"] }
            发布诊断(流, uri, 文档表[uri], [])
        } 抑 方法 == "textDocument/didChange" {
            设 参2 = 消息["params"]
            设 uri2 = 参2["textDocument"]["uri"]
            若 参2.含?("_fsPath") { 路径表[uri2] = 参2["_fsPath"] }
            设 变更 = 参2["contentChanges"]
            若 变更.长度 > 0 {
                文档表[uri2] = 变更[0]["text"]
                发布诊断(流, uri2, 文档表[uri2], [])
            }
        } 抑 方法 == "textDocument/didSave" {
            // P4:保存级权威诊断 = 解析诊断 + xtc --检查 语义诊断
            设 参4 = 消息["params"]
            设 uri4 = 参4["textDocument"]["uri"]
            若 参4.含?("_fsPath") { 路径表[uri4] = 参4["_fsPath"] }
            发布语义诊断(流, uri4)
        } 抑 方法 == "textDocument/didClose" {
            设 uri3 = 消息["params"]["textDocument"]["uri"]
            文档表[uri3] = ""
            写帧(流, 化({"jsonrpc": "2.0", "method": "textDocument/publishDiagnostics",
                "params": {"uri": uri3, "diagnostics": []}}))
        } 否 {
            // 未知请求给空结果(宽容),通知直接忽略
            若 有id { 写帧(流, 化({"jsonrpc": "2.0", "id": 消息["id"], "result": 空})) }
        }
    }
    流.关()
}

听(20807, 函(流) {
    跑协议(流)
})
示("xt_lsp 已就绪,监听 127.0.0.1:20807 (LSP/TCP)")
循 { 时.睡(1000) }
