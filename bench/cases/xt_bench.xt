函 空函数(): 整 { 返 0 }

函 测_空函数调用(): 整 {
    设 开始1 = 时.微秒()
    设 i1 = 0
    当 i1 < 1000000 {
        空函数()
        i1 = i1 + 1
    }
    示("空函数调用1e6: #{(时.微秒() - 开始1)} 微秒")
    返 0
}

函 测_字符串拼接(): 整 {
    设 开始2 = 时.微秒()
    设 s2 = ""
    设 i2 = 0
    当 i2 < 100000 {
        s2 = s2 + "a"
        i2 = i2 + 1
    }
    示("字符串拼接1e5: #{(时.微秒() - 开始2)} 微秒 (len=#{s2.长度})")
    返 0
}

函 测_列表添加(): 整 {
    设 开始3 = 时.微秒()
    设 列表3 = []
    设 i3 = 0
    当 i3 < 100000 {
        列表3.追加(i3)
        i3 = i3 + 1
    }
    示("列表添加1e5: #{(时.微秒() - 开始3)} 微秒 (len=#{列表3.长度})")
    返 0
}

函 测_字典(): 整 {
    设 开始5 = 时.微秒()
    设 字典5 = {}
    设 i5 = 0
    当 i5 < 10000 {
        字典5["键" & i5] = i5
        i5 = i5 + 1
    }
    示("字典插入1e4: #{(时.微秒() - 开始5)} 微秒")
    返 0
}

函 测_浮点(): 整 {
    设 开始6 = 时.微秒()
    设 f6 = 0.0
    设 i6 = 0
    当 i6 < 1000000 {
        f6 = f6 + 1.5
        i6 = i6 + 1
    }
    示("浮点累加1e6: #{(时.微秒() - 开始6)} 微秒 (f=#{f6})")
    返 0
}

函 测_乘模(): 整 {
    设 开始7 = 时.微秒()
    设 r7 = 0
    设 i7 = 0
    当 i7 < 1000000 {
        r7 = (r7 * 7 + 13) % 1000003
        i7 = i7 + 1
    }
    示("乘模1e6: #{(时.微秒() - 开始7)} 微秒 (r=#{r7})")
    返 0
}

函 测_分支(): 整 {
    设 开始8 = 时.微秒()
    设 c8 = 0
    设 i8 = 0
    当 i8 < 10000000 {
        若 i8 % 2 == 0 { c8 = c8 + 1 } 否 { c8 = c8 - 1 }
        i8 = i8 + 1
    }
    示("分支1e7: #{(时.微秒() - 开始8)} 微秒 (c=#{c8})")
    返 0
}

函 测_嵌套(): 整 {
    设 开始9 = 时.微秒()
    设 n9 = 0
    设 a9 = 0
    当 a9 < 1000 {
        设 b9 = 0
        当 b9 < 1000 {
            n9 = n9 + 1
            b9 = b9 + 1
        }
        a9 = a9 + 1
    }
    示("嵌套循环1e6: #{(时.微秒() - 开始9)} 微秒 (n=#{n9})")
    返 0
}

测_空函数调用()
测_字符串拼接()
测_列表添加()
测_字典()
测_浮点()
测_乘模()
测_分支()
测_嵌套()
// —— 以下 fib30 用例由 bench/ 追加(2026-09-27):历史表里的 fib30 行来自另一处探针,
//    原语料不含此项,为使后续快照与对照语言逐项对齐,在此补齐(循环体与对照实现同构)。
函 测_fib30(): 整 {
    设 开始10 = 时.微秒()
    设 f10 = fib30(30)
    示("fib30递归: #{(时.微秒() - 开始10)} 微秒 (f=#{f10})")
    返 0
}

函 fib30(n: 整): 整 {
    若 n < 2 { 返 n }
    返 fib30(n - 1) + fib30(n - 2)
}

测_fib30()
