// 4096 点 FFT 的 C 内核路径:玄铁负责数据/计时,C 只跑蝶形内核。
// 这是显式性能路线;普通 小数数组 仍走安全检查。
外 函 xt_fft4096_f64(实: 小数数组, 虚: 小数数组, 余弦表: 小数数组,
                    正弦表: 小数数组, n: 整): 整

设 N: 整 = 4096
设 实: 小数数组 = []
设 虚: 小数数组 = []
设 余弦表: 小数数组 = []
设 正弦表: 小数数组 = []

设 i: 整 = 0
当 i < N {
    实.追加(数学.正弦(2.0 * 数学.圆周率 * i / N))
    虚.追加(0.0)
    i = i + 1
}
i = 0
当 i < N / 2 {
    余弦表.追加(数学.余弦(2.0 * 数学.圆周率 * i / N))
    正弦表.追加(数学.正弦(2.0 * 数学.圆周率 * i / N))
    i = i + 1
}

xt_fft4096_f64(实, 虚, 余弦表, 正弦表)
设 始: 整 = 时.微秒()
设 轮: 整 = 0
当 轮 < 100 {
    xt_fft4096_f64(实, 虚, 余弦表, 正弦表)
    轮 = 轮 + 1
}
设 单次: 整 = (时.微秒() - 始) / 100
示("FFT4096: #{单次} 微秒 (校验 #{实[1]})")
